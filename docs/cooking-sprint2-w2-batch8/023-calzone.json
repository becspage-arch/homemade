      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the dough: dissolve the yeast in 325ml warm water. Mix with flour, salt and oil. Knead for 8 to 10 minutes. Divide into 2 balls. Cover and prove for 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 220C. Put a baking sheet on the top shelf to heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Wilt the spinach in a dry pan. Squeeze all the moisture out in a clean cloth. Chop roughly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the ricotta, mozzarella, spinach and meat in a bowl. Season with black pepper. The filling should be well-seasoned but not wet."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stretch each dough ball into a circle about 30cm wide. Place the filling on one half, leaving a 2cm border. Fold the dough over and crimp the edge firmly to seal. Cut a small slit in the top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Brush the top with olive oil. Slide onto the hot baking sheet. Bake for 16 to 18 minutes until deep golden brown. Rest for 3 minutes before cutting."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Calzone burst open during baking",
              "cause": "Edge not sealed firmly, or overfilled",
              "fix": "Press and crimp the edge very firmly. Use less filling next time. The steam vent also helps prevent splitting."
            },
            {
              "symptom": "Inside is watery and wet",
              "cause": "Filling ingredients were too wet",
              "fix": "Squeeze the spinach completely dry before using. Drain the mozzarella on kitchen paper for 30 minutes."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Calzone is from Naples. It was designed to be eaten by hand. The filling varies -- prosciutto and mozzarella is classic. Ricotta and spinach is the vegetarian standard. Both are excellent."
          }
        ]
      }
    ]
  }
