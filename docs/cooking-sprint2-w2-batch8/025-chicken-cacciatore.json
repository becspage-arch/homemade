      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season the chicken thighs well on both sides. Heat the oil in a large heavy pan over medium-high heat. Brown the chicken skin-side down for 6 to 8 minutes until the skin is golden and releases easily. Turn and brown the other side for 3 minutes. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce the heat to medium. Add the onion and peppers. Cook for 8 minutes until softened. Add the garlic and cook for 1 more minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the wine. Scrape up the browned bits from the bottom. Let it bubble for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tinned tomatoes, olives, capers, rosemary and bay leaves. Stir well. Season."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the chicken to the pan, skin-side up. The sauce should come halfway up the chicken. Bring to a gentle simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and cook over low heat for 35 to 40 minutes until the chicken is tender and pulling away from the bone. Remove the lid for the last 10 minutes to reduce the sauce."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the rosemary and bay leaves. Taste and adjust the seasoning. Serve with bread, polenta or roasted potatoes."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Chicken skin is soft and pale",
              "cause": "Pan not hot enough, or chicken moved too soon",
              "fix": "Always preheat the pan before adding the chicken. Let the skin cook undisturbed for 6 to 8 minutes -- it will release on its own when it is ready."
            },
            {
              "symptom": "Sauce is too watery",
              "cause": "Lid left on throughout, or tinned tomatoes too thin",
              "fix": "Remove the lid for the last 10 to 15 minutes. Let it reduce uncovered until thick enough to coat a spoon."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cacciatore is comfort food all over central and southern Italy. It varies by region -- some add rosemary, some do not. Olives and capers are the Sicilian touch. Serve it with whatever bread you have."
          }
        ]
      }
    ]
  }
