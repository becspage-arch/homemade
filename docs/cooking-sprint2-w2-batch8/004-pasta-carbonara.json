  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Take the pan completely off the heat before adding the egg mixture. Residual heat is enough to cook the eggs gently. Direct flame turns them into scrambled eggs."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
