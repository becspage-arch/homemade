      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a bowl, whisk together the eggs, extra yolks, and all the grated cheese. Add the cracked pepper. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the bacon in a cold wide pan and set over medium heat. Cook for 8 to 10 minutes until golden and the fat has rendered. Remove from the heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the pasta in a large pan of well-salted water until al dente. Reserve at least 300ml of pasta water before draining."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain the pasta. Return the bacon pan to low heat. Add the pasta and toss for 1 minute to coat in the fat. Remove the pan from the heat entirely."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour 3 tablespoons of pasta water into the egg mixture and whisk quickly. This raises the temperature of the eggs gradually."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the egg mixture over the pasta off the heat. Toss constantly for 2 minutes. Add more pasta water a splash at a time until the sauce is silky and coats the pasta."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve immediately in warm bowls. Add extra cracked pepper on top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Eggs have scrambled",
              "cause": "Pan was too hot when the egg mixture went in",
              "fix": "Remove from heat fully next time. Scrambled carbonara is not salvageable -- it still tastes good but is not silky."
            },
            {
              "symptom": "Sauce is too thick and claggy",
              "cause": "Not enough pasta water added",
              "fix": "Add more warm pasta water a tablespoon at a time and keep tossing briskly."
            },
            {
              "symptom": "Sauce is thin and runny",
              "cause": "Too much water or pan too cool",
              "fix": "Toss over very low heat for another minute. The sauce will tighten as it warms gently."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Carbonara is Roman and relatively modern. It was probably made popular in the 1940s or 1950s. No cream, no peas, no onion -- these are British adaptations. The Roman version needs only five ingredients."
          }
        ]
      }
    ]
  }
