      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the chilli, garlic, lemon zest and juice, rosemary and olive oil. Season well with salt and pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rub the marinade all over the chicken, getting under the skin where you can. Put in a dish, cover and refrigerate for at least 4 hours, ideally overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from the fridge 1 hour before cooking. Bring to room temperature."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a grill to high. Cook the chicken skin-side up for 20 minutes. Flip and cook skin-side down for another 15 minutes. If using an oven, roast at 200C for 40 minutes skin-side up, then grill on high for 5 minutes to char."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The chicken is done when the juices run clear from the thigh. Rest for 10 minutes before carving."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve with a simple green salad and grilled bread to mop up the juices."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Skin is pale and not charred",
              "cause": "Heat not high enough, or chicken too far from the grill element",
              "fix": "Move the chicken closer to the grill. For the last 3 to 5 minutes, the skin should be blistering and dark."
            },
            {
              "symptom": "Breast meat is dry",
              "cause": "Overcooked on the breast side",
              "fix": "Cook the chicken skin-side up for most of the time. The breast should register 72C on a thermometer. Rest for 10 minutes -- this redistributes the juices."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pollo alla diavola is a summer dish from central Italy. It is at its best on a charcoal grill. The chilli and lemon marinade cuts through the richness of the skin. Serve it very simply."
          }
        ]
      }
    ]
  }
