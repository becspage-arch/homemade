      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil in a wide pan over medium heat. Add the garlic and cook for 1 minute until pale golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the nduja. Stir it into the oil and press it down. Let it melt and dissolve into the fat for about 2 minutes. It will turn the oil deep red."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the tinned tomatoes. Add chilli flakes if you want more heat. Season lightly with salt. Simmer for 12 to 15 minutes until thick and rich."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the pasta in well-salted boiling water until al dente. Reserve a mug of pasta water. Drain."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toss the pasta through the sauce over medium heat. Add a splash of pasta water to loosen if needed. Serve with Parmesan if you like."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Sauce is too spicy to eat",
              "cause": "Nduja is very chilli-heavy",
              "fix": "Add a spoonful of mascarpone or double cream to the sauce to dial down the heat. A splash of pasta water and more sauce also helps."
            },
            {
              "symptom": "Sauce tastes flat despite the nduja",
              "cause": "Tomatoes need longer reduction",
              "fix": "Simmer for 5 more minutes uncovered. The flavour concentrates as the liquid reduces."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nduja comes from Spilinga in Calabria, the southernmost part of mainland Italy. It is one of the most assertive flavours in Italian cooking. A little goes a very long way."
          }
        ]
      }
    ]
  }
