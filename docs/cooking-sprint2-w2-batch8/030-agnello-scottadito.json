      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the garlic, rosemary, lemon zest, lemon juice and olive oil in a large bowl. Add the lamb cutlets. Toss well to coat. Cover and refrigerate for at least 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the lamb from the fridge 30 minutes before cooking. Shake off excess marinade. Pat dry with kitchen paper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a cast-iron griddle pan or heavy frying pan over the highest heat for 5 minutes until very hot. Add no oil -- the marinade provides enough."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the lamb cutlets. Season with salt. Do not move them for 3 minutes. Flip and cook for 3 more minutes for pink and juicy. Add 1 minute per side for more well-done."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rest on a warm plate for 5 minutes. Serve immediately with lemon wedges and a green salad."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Lamb is grey and steamed rather than charred",
              "cause": "Pan not hot enough, or too many cutlets in the pan at once",
              "fix": "Cook in batches of 4 or fewer. The pan must be smoking hot before the lamb goes in."
            },
            {
              "symptom": "Cutlets are tough and well-done",
              "cause": "Left on too long",
              "fix": "Lamb cutlets are thin and cook very fast. 3 minutes per side for pink is usually exactly right."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Scottadito is the Easter lamb dish of Rome. Spring lamb is sweeter and more delicate than older meat. Eat them with your fingers while they are still sizzling. That is the point."
          }
        ]
      }
    ]
  }
