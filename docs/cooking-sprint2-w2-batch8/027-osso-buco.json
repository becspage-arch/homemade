      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 160C. Tie each piece of shin with kitchen string to help it hold its shape. Season well. Dust lightly in flour on both sides."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a heavy ovenproof pan over high heat. Sear the shin pieces for 4 to 5 minutes per side until deeply browned. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce the heat. Add the onion, carrot and celery. Cook in the residual fat for 8 minutes until soft. Add the wine and cook for 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tomatoes, stock and bay leaves. Return the meat to the pan. The liquid should come halfway up the meat. Bring to a simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and braise in the oven for 1.5 to 2 hours until the meat is very tender and starting to fall from the bone."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the lemon zest, garlic and parsley together to make the gremolata. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the string. Taste the sauce and adjust the seasoning. Serve each piece of shin with sauce spooned over. Scatter gremolata on top. Serve with risotto Milanese or polenta."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Meat is not tender after 2 hours",
              "cause": "Shin was very thick or oven not even enough",
              "fix": "Return to the oven for another 30 to 45 minutes. Beef shin in particular can take up to 3 hours. It is done when a fork slides in with no resistance."
            },
            {
              "symptom": "Sauce is thin",
              "cause": "Too much liquid added or lid not tight",
              "fix": "Remove the meat and reduce the sauce on the hob over high heat until it is thick and glossy, then return the meat."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Osso buco is Milan's most famous dish. It is always paired with saffron risotto. The gremolata is added at the table, not during cooking. Eat the marrow from the bone with a small spoon."
          }
        ]
      }
    ]
  }
