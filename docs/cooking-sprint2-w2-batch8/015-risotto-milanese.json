      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Steep the saffron in 3 tablespoons of warm stock in a small bowl for at least 10 minutes. It will turn the liquid deep orange."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil and half the butter in a wide, heavy pan over medium-low heat. Add the onion and cook gently for 8 minutes until very soft and translucent. Do not let it colour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the rice. Stir and toast for 2 minutes until each grain looks translucent at the edges. Pour in the wine. Stir constantly until it is fully absorbed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the saffron liquid and stir until absorbed. Then begin adding the hot stock a ladle at a time, stirring after each addition. Add the next ladle only when the last has been absorbed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Continue for about 18 to 20 minutes. The rice should be tender but with a very slight bite in the centre. The texture should be loose and flowing, not stiff."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from the heat. Add the cold butter cubes and the Parmesan. Beat vigorously with a wooden spoon for 2 minutes. This is the mantecatura -- it makes the risotto creamy and glossy. Rest for 2 minutes before serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Risotto is stiff and stodgy",
              "cause": "Not enough stock added, or overcooked",
              "fix": "Loosen with a splash of hot stock and toss quickly. Risotto should flow when you shake the bowl."
            },
            {
              "symptom": "Rice is crunchy in the centre",
              "cause": "Not cooked long enough",
              "fix": "Add another ladle of stock and cook for 2 to 3 more minutes. Taste regularly toward the end."
            },
            {
              "symptom": "Saffron colour is very pale",
              "cause": "Not steeped long enough",
              "fix": "Steep the saffron for at least 10 minutes in warm (not boiling) liquid before adding."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Risotto Milanese is the pride of Milan. It is traditionally served alongside braised veal shin (osso buco). On its own, it is a complete meal. The saffron is non-negotiable -- it defines the dish."
          }
        ]
      }
    ]
  }
