      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil in a wide pan over medium heat. Add the garlic and chilli flakes. Cook for 1 to 2 minutes until the garlic is pale golden. Watch closely -- it burns quickly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the tinned tomatoes. Crush them with a spoon. Season with salt. Raise the heat to high and cook for 12 to 15 minutes until the sauce has thickened and deepened in colour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the sauce cooks, boil the pasta in well-salted water until al dente. Reserve a mug of pasta water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain the pasta. Add it to the sauce and toss over medium heat for 1 to 2 minutes. Add a splash of pasta water to help the sauce cling."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter over parsley if using. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Sauce tastes bitter",
              "cause": "Garlic was overcooked and turned brown",
              "fix": "Start again with new garlic -- burnt garlic cannot be fixed. Keep the heat moderate."
            },
            {
              "symptom": "Sauce is too thin",
              "cause": "Not cooked long enough at high heat",
              "fix": "Simmer for a few more minutes uncovered until reduced. The sauce should cling to the pasta, not pool at the bottom."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Arrabbiata is from Rome. It is the simplest Italian pasta sauce to make well. The heat level is up to you -- purists use a lot of chilli. It should actually be hot to earn the name."
          }
        ]
      }
    ]
  }
