      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large pan over medium heat. Add the bacon if using and cook for 3 minutes. Add the onion, carrot and celery. Cook for 8 minutes until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and rosemary. Cook for 1 minute. Add the tomatoes if using and cook for 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained beans and the stock. Add the Parmesan rind if you have one. Bring to a simmer and cook for 15 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove about a third of the beans with a ladle. Mash them with a fork or blend them until smooth. Stir back into the pot. This makes the soup thick and creamy."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring back to a steady simmer. Add the pasta and cook until tender, about 8 minutes. Stir often so the pasta does not stick to the bottom."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the Parmesan rind. Season well. The soup should be very thick -- almost stew-like. Loosen with a little hot water if needed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve in deep bowls with grated Parmesan and a drizzle of good olive oil."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Pasta has absorbed all the liquid",
              "cause": "Pasta was left too long in the soup",
              "fix": "Add hot water or stock and stir well. The pasta keeps absorbing as it sits -- serve promptly."
            },
            {
              "symptom": "Soup is thin",
              "cause": "Not enough beans were mashed",
              "fix": "Mash or blend more beans and stir back in. Simmer uncovered for a few more minutes."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pasta e fagioli is found all over Italy. It has always been peasant food -- cheap, filling and nourishing. Neapolitan versions use tomato; northern versions keep it pale and creamy. Both are good."
          }
        ]
      }
    ]
  }
