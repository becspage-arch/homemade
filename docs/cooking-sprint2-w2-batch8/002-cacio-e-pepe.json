  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use starchy pasta water and keep the heat low. If the pan is too hot, the cheese will clump instead of forming a cream. Move fast once the pasta goes in."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "pasta-dried",
              "amount": 400,
              "unit": "g",
              "prepNote": "tonnarelli, spaghetti or rigatoni",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "parmesan",
              "amount": 120,
              "unit": "g",
              "prepNote": "use Pecorino Romano or a mix of Pecorino and Parmesan, finely grated",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "black-pepper",
              "amount": 2,
              "unit": "tsp",
              "prepNote": "whole peppercorns, coarsely cracked",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "salt-table",
              "amount": null,
              "unit": "to taste",
              "prepNote": "for the pasta water",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toast the cracked pepper in a dry wide pan over medium heat for 1 minute until fragrant. Add a ladleful of water to the pan and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the pasta in well-salted boiling water, but use less water than usual. This makes the starch content higher. Cook until 2 minutes before al dente."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the pasta cooks, mix the grated cheese with 4 tablespoons of cold water in a bowl. Stir into a thick paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scoop out at least 300ml of pasta water. Return the pepper pan to medium-low heat. Add a ladleful of pasta water and let it reduce slightly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer the slightly undercooked pasta into the pepper pan using tongs. Toss well. Add more pasta water a splash at a time to keep it moving. Cook for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the pan from the heat. Wait 30 seconds. Add the cheese paste and toss rapidly. The heat from the pasta melts the cheese into a silky cream. Add more pasta water to loosen if needed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve immediately in warm bowls. Finish with extra cracked pepper."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Cheese has clumped",
              "cause": "Pan was too hot when the cheese was added",
              "fix": "Take the pan fully off the heat and add a little cold water. Toss vigorously. The clumps often smooth out."
            },
            {
              "symptom": "Sauce is thin and watery",
              "cause": "Too much pasta water added at once",
              "fix": "Toss over low heat for another minute to reduce. The sauce thickens as water evaporates."
            },
            {
              "symptom": "Pasta is sticky and stodgy",
              "cause": "Not enough water used during tossing",
              "fix": "Add pasta water in small amounts and keep tossing. The pasta should stay glossy, not gluey."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cacio e Pepe is from Rome. It is one of the four classic Roman pasta dishes. Shepherds made it with aged cheese they could carry for weeks. It has no cream and needs no cream."
          }
        ]
      }
    ]
  }
