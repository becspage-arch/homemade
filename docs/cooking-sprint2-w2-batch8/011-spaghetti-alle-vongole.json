      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the clams in a bowl of cold salted water for 20 minutes to purge. Drain and rinse well. Discard any that are open and do not close when tapped."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the spaghetti in well-salted boiling water. Pull it out 2 minutes before it is done. Reserve 300ml of pasta water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil in a large wide pan over medium heat. Add the garlic and chilli flakes. Cook for 1 minute until the garlic is pale golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Increase the heat to high. Add the clams. Pour in the wine. Cover the pan. Steam for 3 to 4 minutes until most clams have opened. Discard any that remain closed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained pasta to the clam pan. Toss over medium heat, adding pasta water as needed. Cook for the remaining 2 minutes until the pasta is just done and has absorbed some of the juices."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the parsley and a squeeze of lemon if using. Toss once more. Serve immediately in warm bowls."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Clams are very gritty",
              "cause": "Not purged long enough or not rinsed",
              "fix": "Always purge in cold salted water for at least 20 minutes. Rinse again before cooking."
            },
            {
              "symptom": "Sauce is too salty",
              "cause": "Clam liquor is naturally salty",
              "fix": "Do not salt the pasta water heavily when cooking vongole. Taste the sauce before adding any salt at all."
            },
            {
              "symptom": "Some clams did not open",
              "cause": "Dead clams before cooking, or steam was not hot enough",
              "fix": "Discard any that remain firmly shut after cooking. They are not safe to eat."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Vongole is the pasta of the Neapolitan waterfront. It is eaten at lunch in small trattorias near the port. The white version is the purer of the two. No cheese ever goes near it."
          }
        ]
      }
    ]
  }
