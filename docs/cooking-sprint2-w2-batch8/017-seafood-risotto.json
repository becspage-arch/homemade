      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Steam the mussels in a covered pan with a splash of white wine over high heat for 3 to 4 minutes. Discard any that do not open. Remove the meat from most shells, keeping a few for garnish. Strain the cooking liquid and add it to the hot fish stock."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil in a wide, heavy pan over medium-low heat. Add the onion and cook for 8 minutes until soft. Add the garlic and cook for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the rice and toast for 2 minutes. Pour in the remaining wine. Stir until fully absorbed. Add the saffron and its liquid."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the hot stock a ladle at a time, stirring constantly. Add the tomatoes at this point if using. Continue for 16 to 18 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "When the rice has 3 minutes of cooking left, stir in the prawns. Cook until they are just pink and opaque. Stir in the mussel meat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from the heat. Stir in 2 tablespoons of olive oil (no butter -- this is a seafood risotto). Add the parsley and toss. Serve immediately with the reserved mussels in shells on top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Prawns are rubbery and tough",
              "cause": "Added too early or left too long in the heat",
              "fix": "Prawns need 2 to 3 minutes only. Add them with 3 minutes left in the cooking time and pull the pan off the heat as soon as they are pink."
            },
            {
              "symptom": "Risotto lacks depth of flavour",
              "cause": "Mussel cooking liquor not used",
              "fix": "Always add the strained shellfish liquid to the stock. It is the most flavoursome part of the dish."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Seafood risotto is a coastal dish from Venice to Sicily. Each port has its own version. The rule everywhere is no cheese. The sea flavour should come from the shellfish, not from dairy."
          }
        ]
      }
    ]
  }
