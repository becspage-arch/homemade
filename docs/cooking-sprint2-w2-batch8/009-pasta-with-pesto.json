    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Never heat pesto in the pan. The basil turns black and bitter. Add it to the warm pasta off the heat. A spoon of pasta water is the key to a silky, saucy finish."
          }
        ]
      },
