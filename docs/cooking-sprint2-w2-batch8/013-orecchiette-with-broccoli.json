      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring a large pan of well-salted water to the boil. Add the broccoli and cook for 3 minutes until just tender. Scoop it out with a slotted spoon. Keep the water boiling."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drop the pasta into the same water. Cook until al dente. Reserve a mug of pasta water before draining."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the pasta cooks, heat the olive oil in a wide pan over medium heat. Add the anchovies and stir. They will melt into the oil in about 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and chilli flakes. Cook for 1 minute until the garlic is golden. Add the cooked broccoli. Toss to coat. Crush some pieces lightly with the back of a spoon."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain the pasta and add it to the broccoli pan. Toss over medium heat, adding pasta water to make it saucy. Taste and adjust the salt (the anchovies are salty)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve in bowls with Parmesan if you like, though many Pugliese cooks skip cheese with this dish."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Dish tastes very fishy",
              "cause": "Anchovies not fully melted, or too many used",
              "fix": "Make sure the anchovies dissolve completely in the hot oil. Start with 4 fillets next time if you prefer a milder result."
            },
            {
              "symptom": "Broccoli is mushy",
              "cause": "Overcooked in the pasta water",
              "fix": "Blanch for 3 minutes only and remove promptly. It will continue to soften when tossed in the hot pan."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Orecchiette is the pasta of Puglia, the heel of Italy. The authentic dish uses cime di rapa -- a bitter green that is hard to find outside Italy. Broccoli is the common and very good substitute."
          }
        ]
      }
    ]
  }
