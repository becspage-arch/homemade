        "content": [
          {
            "type": "text",
            "text": "A ginger loaf with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "stem-ginger"
                }
              }
            ],
            "text": "crystallised ginger"
          },
          {
            "type": "text",
            "text": " is one of the most satisfying bakes in the British repertoire. The treacle and golden syrup make the loaf sticky, dark, and fudge-like at the centre. The pieces of crystallised ginger give bursts of intense hot-sweet flavour through each slice."
          }
        ]
