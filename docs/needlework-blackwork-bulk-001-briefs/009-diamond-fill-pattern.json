  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "The diamond " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "fill-pattern" } }], "text": "fill pattern" },
          { "type": "text", "text": " is eight stitches arranged in a repeating diamond on " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "evenweave" } }], "text": "evenweave" },
          { "type": "text", "text": ". Two strands of black stranded cotton on 28-count evenweave. Finished chart size: 40 by 40 stitches (approximately 7 by 7 cm)." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            { "name": "28-count evenweave or linen", "qty": "20 by 20 cm" },
            { "name": "DMC 310 black stranded cotton", "qty": "1 skein" },
            { "name": "Tapestry needle size 26", "qty": "1" },
            { "name": "Embroidery hoop 10 cm", "qty": "1" },
            { "name": "Embroidery scissors", "qty": "1" }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Working method" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Work this fill using " },
          { "type": "text", "marks": [{ "type": "techniqueLink", "attrs": { "techniqueSlug": "holbein-stitch", "label": "Holbein stitch" } }], "text": "Holbein stitch" },
          { "type": "text", "text": " for a reversible result. The diamond repeat is four units wide and four units tall. Two strands on 28-count. Work outward from the centre of the fabric area, starting from the centre mark identified when " },
          { "type": "text", "marks": [{ "type": "techniqueLink", "attrs": { "techniqueSlug": "reading-a-counted-chart", "label": "reading a counted chart" } }], "text": "reading a counted chart" },
          { "type": "text", "text": "." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Chart" }]
