      "slug": "holbein-stitch",
      "term": "Holbein stitch",
      "definition": "Double-running stitch worked along a counted path so the thread looks identical on both sides of the fabric."
    },
    {
      "slug": "evenweave",
      "term": "Evenweave",
      "definition": "Fabric woven with the same number of threads per centimetre in both directions."
    },
    {
      "slug": "sampler",
      "term": "Sampler",
      "definition": "A piece of embroidery worked to record and practice multiple patterns or stitches, traditionally used to preserve design knowledge."
    }
