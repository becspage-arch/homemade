      "slug": "holbein-stitch",
      "term": "Holbein stitch",
      "definition": "Double-running stitch worked along a counted path so the thread looks identical on both sides of the fabric."
    },
    {
      "slug": "evenweave",
      "term": "Evenweave",
      "definition": "Fabric woven with the same number of threads per centimetre in both directions."
    },
    {
      "slug": "fill-pattern",
      "term": "Fill pattern",
      "definition": "A small repeating geometric unit worked inside an outline shape in blackwork."
    }
  ],
