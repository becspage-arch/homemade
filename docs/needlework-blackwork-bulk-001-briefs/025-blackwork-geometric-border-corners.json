            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "evenweave"
                }
              }
            ],
            "text": "evenweave"
          },
          {
            "type": "text",
            "text": ". Corner unit is 12 by 12 stitches (approximately 11 mm) on 28-count evenweave."
          }
        ]
      },
