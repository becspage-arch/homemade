      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the yeast into the warm milk with a pinch of sugar. Leave 5 minutes. Combine flour, sugar, salt (1 tsp), spices, and orange zest. Rub in the butter."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the yeast mixture and egg to the flour. Mix to a soft dough. Knead for 8 minutes. Add the currants and knead to distribute. Cover and prove 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide into 12 equal pieces. Shape each into a smooth ball. Place on lined baking sheets with a little space between each. Cover and prove 30 to 45 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 200C. Mix the cross paste flour with water to a thick, pipeable consistency. Pipe a cross over each bun."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 18 to 20 minutes until golden. Brush immediately with the warm honey glaze. Eat warm or toasted with butter."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Cross paste runs off during baking",
              "cause": "Paste was too thin.",
              "fix": "The paste should be thick enough to hold a ribbon when piped. Add flour a teaspoon at a time until it is firm."
            },
            {
              "symptom": "Buns are dry after a day",
              "cause": "Hot cross buns stale quickly.",
              "fix": "Toast them. Split and toast each half -- they come back to life completely."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hot cross buns are eaten on Good Friday across Britain and Ireland. The spiced, fruited bun goes back centuries, and the cross has both Christian symbolism and older marking traditions. Supermarket versions are now available year-round, but homemade ones are in a different class -- softer, more fragrant, and far less sweet."
          }
        ]
      }
    ]
  }
