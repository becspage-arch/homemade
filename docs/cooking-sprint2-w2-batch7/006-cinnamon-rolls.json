      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dissolve the yeast in the warm milk with a pinch of sugar. Leave 5 minutes. Add the melted butter, eggs, and remaining sugar. Mix in the flour and salt to form a soft dough."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Knead for 8 minutes until smooth. Place in a greased bowl, cover, and prove for 1 hour until doubled."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll the dough into a rectangle roughly 40 x 30cm. Spread the softened butter over the surface. Mix the brown sugar and cinnamon and scatter evenly over the butter."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll up tightly from the long edge. Cut into 12 equal rounds. Arrange cut-side up in a greased deep baking tin. Cover and prove for 30 to 45 minutes until puffed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake at 190C for 22 to 25 minutes until golden. Beat the cream cheese with the icing sugar until smooth. Spread over the hot rolls."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Rolls unravel during baking",
              "cause": "Rolled too loosely, or the log was not rolled tight enough.",
              "fix": "Roll the dough into a firm, tight cylinder. Press the seam down onto the board before cutting."
            },
            {
              "symptom": "Centres are doughy",
              "cause": "Rolls were too closely packed or oven temperature was too high, causing the outside to set before the inside cooked.",
              "fix": "Leave a small gap between each roll. Check the oven temperature with a thermometer."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The cinnamon roll has Swedish roots. The kanelbulle is eaten across Scandinavia and has its own dedicated day each October. American settlers brought their version, making it larger and richer. Today it is a Saturday morning staple across North America and a fixture in British cafes."
          }
        ]
      }
    ]
  }
