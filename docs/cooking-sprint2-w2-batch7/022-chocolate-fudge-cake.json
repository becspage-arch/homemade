      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 180C. Grease and line two 20cm round tins."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Sift together the flour, cocoa, baking powder, bicarb, sugar, and a pinch of salt. In a jug, whisk together the eggs, oil, milk, and vanilla. Add the wet ingredients to the dry and mix until smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in 150ml of just-boiled water or hot coffee and stir to combine. The batter will be very thin. Divide evenly between the tins."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 30 to 35 minutes until a skewer comes out clean. Cool in the tins for 10 minutes before turning out. Leave to cool fully."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the ganache: heat the cream until just below boiling. Pour over the broken chocolate. Leave for 2 minutes, then stir until smooth. Cool until spreadable (about 30 minutes). Sandwich and coat the cake."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Ganache is too runny to spread",
              "cause": "Not cooled enough.",
              "fix": "Leave at room temperature until it holds a ribbon when stirred -- about 30 to 45 minutes. Speed it up by placing in the fridge for 10 minutes."
            },
            {
              "symptom": "Cake layers are very domed and difficult to sandwich",
              "cause": "Common with very liquid batters. The dome can be levelled.",
              "fix": "Use a serrated knife to trim the dome flat before sandwiching. Keep the trimmings for a cook's treat."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chocolate fudge cake is the chocolate cake of British cafes, birthdays, and bake sales. It is richer and more intensely flavoured than a chocolate sponge. The ganache finish is borrowed from French patisserie but has been fully absorbed into British baking culture. It is the kind of cake people request for their birthday."
          }
        ]
      }
    ]
  }
