    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Do not overwork this dough. Mix it until it just comes together, then shape and bake immediately. The more you handle it, the tougher the loaf will be. The cross cut into the top is traditional -- it helps the bread cook through the centre."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 1,
          "items": [
            {
              "ingredientSlug": "plain-flour",
              "unit": "g",
              "prepNote": null,
              "amount": 450,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "bicarbonate-of-soda",
              "unit": "tsp",
              "prepNote": null,
              "amount": 1,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "salt-table",
              "unit": "tsp",
              "prepNote": null,
