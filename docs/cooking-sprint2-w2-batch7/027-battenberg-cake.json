      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 180C. Divide a 20cm square tin in half with a foil divider, or prepare two small loaf tins. Grease and line both sections."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Beat all the sponge ingredients together until smooth. Divide the batter in half. Leave one half plain and colour the other with a few drops of pink food colouring."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour each batter into its section. Bake for 25 to 30 minutes until a skewer comes out clean. Cool completely."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Trim each sponge to an identical square cross-section. Cut each lengthways into two long rectangles. You now have four equal bars -- two pink, two plain. Sandwich them in a checkerboard pattern using the warm apricot jam."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll the marzipan into a rectangle large enough to wrap the cake. Brush the outside of the assembled cake with jam. Wrap in the marzipan, seam underneath. Trim the ends neatly to reveal the pattern."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Checkerboard pattern is uneven when cut",
              "cause": "The sponge rectangles were not trimmed to equal size.",
              "fix": "Take the time to measure and trim precisely. A 1mm difference will show. Use a ruler."
            },
            {
              "symptom": "Marzipan tears when rolling",
              "cause": "Too cold or not kneaded before rolling.",
              "fix": "Knead the marzipan briefly until pliable. Dust the surface lightly with icing sugar to prevent sticking."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Battenberg cake is a British original. It became famous as an afternoon tea cake and remains a standard in British supermarkets and bakeries. The checkerboard is its signature -- slicing through and revealing the perfect pink-and-yellow grid is one of the more satisfying moments in baking."
          }
        ]
      }
    ]
  }
