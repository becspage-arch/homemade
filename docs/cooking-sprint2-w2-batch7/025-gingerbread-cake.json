      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 160C. Grease and line a 20 x 30cm baking tin (or a 23cm square tin for a deeper cake)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Sift the flour, bicarb, and spices into a large bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the butter, golden syrup, treacle, and brown sugar together in a saucepan over low heat. Stir until the sugar dissolves. Remove from heat and cool for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Beat the eggs into the milk. Pour the treacle mixture and the milk mixture into the flour. Beat to a smooth, thin batter."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour into the tin. Bake for 40 to 45 minutes until just set -- a skewer should come out with just a few moist crumbs. Cool completely in the tin before cutting."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Top has sunk in the middle",
              "cause": "Too much bicarb, or opened the oven too early.",
              "fix": "Level your teaspoon carefully. Do not open the oven before 35 minutes."
            },
            {
              "symptom": "Cake seems underdone but is browning on top",
              "cause": "Dark batters containing treacle colour quickly before the inside is cooked.",
              "fix": "Cover loosely with foil and continue baking. Test with a skewer -- a few sticky crumbs are fine, wet batter is not."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Gingerbread has been made in Britain since at least the 15th century, when it was formed into shapes and sold at fairs. The sticky, treacly traybake version is associated with the north of England and Scotland. Parkin -- a northern variation made with oatmeal -- is eaten on Bonfire Night. This version is a simpler everyday gingerbread with a longer shelf life than most cakes."
          }
        ]
      }
    ]
  }
