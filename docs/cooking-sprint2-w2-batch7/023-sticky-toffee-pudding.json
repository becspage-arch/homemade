      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour 200ml boiling water over the chopped dates and bicarb. Stir and leave for 10 minutes to soften. Mash or blend to a rough paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 180C. Grease a 23cm square or round baking tin. Beat the butter and caster sugar together until pale. Beat in the eggs, one at a time."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fold in the flour and baking powder, then stir in the date paste. Pour into the prepared tin. Bake for 35 to 40 minutes until risen and a skewer comes out clean."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the sponge bakes, make the sauce: melt the butter and brown sugar together in a saucepan. Add the cream and stir over medium heat for 3 to 4 minutes until thickened and glossy."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour half the sauce over the hot sponge as soon as it comes out of the oven. Return to the oven for 5 minutes. Serve in portions with the remaining warm sauce poured over."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Sponge is very dense",
              "cause": "Dates were not properly softened before adding.",
              "fix": "The date paste should be smooth and wet. If dates are still chunky they will make the batter heavy."
            },
            {
              "symptom": "Sauce has crystallised and is grainy",
              "cause": "Sugar was stirred before it dissolved, or heat was too high.",
              "fix": "Keep the heat at medium and stir only once the sugar has dissolved into the butter. Do not rush it."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sticky toffee pudding is one of Britain's great puddings. It became famous through the restaurant menus of the 1980s and 90s and has never left. It is the pudding most frequently cited as a national favourite. It is winter food -- warming, rich, and unashamedly indulgent."
          }
        ]
      }
    ]
  }
