      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 150C. Grease and double-line a deep 20cm round tin with baking paper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Beat the butter and brown sugar together for 4 minutes until pale. Beat in the eggs, one at a time."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fold in the flour, baking powder, spices, orange and lemon zest, and milk. Stir in the currants and sultanas."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon into the tin and level the top. Arrange the blanched almond halves over the surface in concentric circles."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 1 hour 45 minutes to 2 hours until a skewer inserted in the centre comes out clean. If the top is browning too quickly, cover with foil. Cool in the tin completely before removing."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Almonds on top are burnt",
              "cause": "Oven too hot, or no protective foil used.",
              "fix": "At 150C this should not happen, but if your oven runs hot, tent loosely with foil after the first hour."
            },
            {
              "symptom": "Cake is dry",
              "cause": "Over-baked -- fruit cakes dry out quickly once past their point.",
              "fix": "Test from 1 hour 45 minutes onwards. Remove as soon as the skewer is clean."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dundee cake is one of Scotland's most distinctive contributions to British baking. It sits between an everyday fruit cake and a ceremonial Christmas cake in richness. It is cut in thick slices and eaten with butter or strong tea. The almond-decorated top is its most recognisable feature -- it appears on no other British cake in quite the same way."
          }
        ]
      }
    ]
  }
