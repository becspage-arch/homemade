      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 180C. Grease and line a 900g loaf tin."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mash the ripe bananas in a large bowl. Add the melted butter, sugar, beaten eggs, vanilla, and cinnamon. Stir to combine."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the flour, baking powder, and bicarbonate of soda. Fold together until just combined. Stop as soon as you can no longer see dry flour -- do not over-mix."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour into the prepared tin. Bake for 55 to 60 minutes until a skewer inserted in the centre comes out clean. If the top is browning too quickly, lay a sheet of foil loosely over the tin."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cool in the tin for 10 minutes, then turn out onto a wire rack. Leave for at least 30 minutes before slicing."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Loaf is gummy in the centre",
              "cause": "Under-baked. Banana bread takes longer than expected because the wet batter is dense.",
              "fix": "Test with a skewer deep in the centre. If it comes out wet, give it 10 more minutes. Cover the top with foil if it is already dark."
            },
            {
              "symptom": "Banana flavour is weak",
              "cause": "Bananas were not ripe enough.",
              "fix": "The bananas must be very ripe -- deep brown or black skins. Yellow or slightly speckled bananas will give a pale, starchy result."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Banana bread is a product of American quick bread traditions and became widely popular in Britain from the 1990s onwards, partly through cafe culture. It is one of the most searched-for baking recipes online. It is the thing people make when they have bananas going black on the counter, and the result always surprises anyone who expects it to taste like effort."
          }
        ]
      }
    ]
  }
