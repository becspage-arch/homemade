        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 180C. Line two large baking sheets."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the butter, brown sugar, and golden syrup together in a saucepan over low heat. Stir until the sugar dissolves. Leave to cool for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Sift the flour, bicarb, ginger, and cinnamon into a bowl. Pour in the melted mixture and stir to a stiff dough."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll into balls the size of a large marble (about 12g each). Place on the lined sheets with plenty of space between each. Flatten slightly with your fingers."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 12 to 14 minutes until spread and just firm at the edges. They will look underdone -- this is correct. Leave on the tray for 5 minutes to harden before moving to a rack."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Biscuits are soft and chewy rather than hard",
              "cause": "Over-baked and then gone past the snap stage, or cooled too quickly.",
              "fix": "Ginger nuts harden as they cool. Leave them on the hot tray for 5 minutes before moving -- this extra time finishes the bake through residual heat."
            },
            {
              "symptom": "Biscuits spread into each other",
              "cause": "Balls were too large, or placed too close together.",
              "fix": "Keep balls small -- they spread to roughly double their raw size. Leave at least 5cm between each."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ginger nuts are one of the most familiar biscuits in Britain. They appear in every biscuit tin, every office kitchen, and at every builders' tea break. The snap and the heat of real ginger are what distinguish a proper ginger nut from an inferior imitation. They are made for dunking and are engineered to resist briefly before giving way."
          }
        ]
      }
    ]
  }
