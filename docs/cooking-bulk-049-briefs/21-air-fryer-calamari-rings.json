        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Coat the squid"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pat the {{squid}} rings completely dry with paper towel. Mix {{plain-flour}} of flour with {{paprika-smoked}} of smoked paprika, {{garlic-powder}} of garlic powder, and {{sea-salt-fine}} of salt in a shallow bowl. Spread {{breadcrumbs-panko}} of panko in a second bowl. Toss the rings in the seasoned flour, shake off the excess, then press into the panko to coat all over."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Cook"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Preheat the air fryer to 200°C. Spray the basket with cooking oil. Lay the coated rings in a single layer ,  do not overlap. Spray the tops generously with oil. Cook for 4 minutes, flip, spray again, and cook for a further 3-4 minutes until the coating is golden and crisp. Serve immediately with lemon wedges."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Troubleshooting"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "heading": "Common problems",
          "intro": null,
          "items": [
            {
              "symptom": "Coating comes off in the basket",
              "cause": "Squid too wet before coating.",
              "fix": "Dry the rings aggressively. Wet squid produces steam which lifts the coating away from the surface."
            },
            {
              "symptom": "Coating pale and soft",
              "cause": "Not enough oil spray, or too many rings in the basket.",
              "fix": "Spray generously both before and after placing in the basket. Cook in a single layer with space between rings."
            },
            {
              "symptom": "Squid rubbery and tough",
              "cause": "Overcooked.",
              "fix": "Pull at 8 minutes maximum. Squid goes from tender to tough very fast. Once the coating is golden, the squid is done."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Air-fryer calamari is a good starter for a fish supper or part of a sharing plate with aioli and other fried things. Eat immediately while the coating is still crisp. It does not reheat well."
          }
        ]
      }
    ]
  }
