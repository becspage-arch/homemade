      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Prepare the berries"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Preheat the oven to 190°C. Combine all the berries in a bowl with the sugar, lemon juice, and cornflour. Toss gently, if using frozen berries, they do not need thawing first. Tip into a greased 1.5-litre baking dish."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the cobbler batter"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Combine the flour, sugar, and baking powder in a bowl. Add the cold butter and rub in with your fingertips to give coarse breadcrumbs. Whisk the milk, egg, and vanilla together, then stir into the flour mixture until just combined. The batter will be thick and rough."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Top and bake"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Drop large spoonfuls of batter over the fruit, leaving some fruit exposed between the mounds. Bake at 190°C for 30 to 35 minutes, the cobbler is ready when the topping is deep golden and a skewer inserted in the thickest part comes out clean. The berry sauce will be bubbling at the edges. Leave to settle for 5 minutes and serve with cream or vanilla ice cream."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The berry sauce is too liquid",
              "cause": "Frozen berries released more juice than the cornflour could absorb.",
              "fix": "Increase the cornflour to 2 teaspoons next time. The sauce will still be looser than fresh-berry versions, which is fine, it soaks into the cobbler and makes each serving rich and saucy."
            },
            {
              "symptom": "The cobbler topping is not cooked through in the centre",
              "cause": "The spoonfuls were too large and thick.",
              "fix": "Drop in smaller amounts and flatten slightly with the back of the spoon. Return to the oven if underdone, tenting with foil if the top is already brown."
            },
            {
              "symptom": "The berries are too tart",
              "cause": "The fruit was very sharp, or frozen berries gave less sugar than fresh.",
              "fix": "Add 1 to 2 extra tablespoons of sugar to the filling. Taste the fruit before adding to the dish."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Storage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Keeps in the fridge for 2 days, covered. Reheat in the oven at 180°C for 15 minutes. The topping softens in storage but the flavour improves slightly as the berry sauce permeates the crust."
          }
        ]
      }
    ]
  }
