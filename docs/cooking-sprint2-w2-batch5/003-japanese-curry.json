            { "ingredientSlug": "vegetable-oil", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "salt-table", "amount": null, "unit": "to taste", "prepNote": null, "isOptional": false, "groupLabel": null }
