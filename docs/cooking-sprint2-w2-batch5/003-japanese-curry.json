    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Japanese curry has its own character. It is sweeter and less spiced than South Asian curries, with a thick sauce that coats the rice. Most Japanese households use pre-made curry roux blocks -- a shortcut worth taking. This recipe builds a similar result from scratch using pantry spices."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "chicken-thigh", "amount": 600, "unit": "g", "prepNote": "cut into bite-sized pieces", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "carrot", "amount": 2, "unit": "medium", "prepNote": "cut into chunks", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "potato", "amount": 3, "unit": "medium", "prepNote": "peeled and cut into chunks", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 2, "unit": "large", "prepNote": "sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "stock-chicken", "amount": 600, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cinnamon-ground", "amount": 1, "unit": "tsp", "prepNote": "use 2 tbsp Japanese curry roux blocks if available -- they replace the spices and a little flour", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cumin-ground", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "turmeric-ground", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
