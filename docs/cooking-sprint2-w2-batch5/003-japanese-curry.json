      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [{ "type": "text", "text": "Heat the oil in a large saucepan over medium heat. Fry the onion for 10 minutes until soft and starting to brown." }]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [{ "type": "text", "text": "Add the chicken pieces. Cook for 5 minutes, stirring, until sealed on all sides." }]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [{ "type": "text", "text": "Stir in the cumin, turmeric, and cinnamon. Cook for 1 minute." }]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [{ "type": "text", "text": "Add the carrots, potatoes, stock, and soy sauce. Bring to a boil, then reduce to a simmer. Cook for 20 minutes until the vegetables are tender." }]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [{ "type": "text", "text": "Mix the flour with a splash of cold water to a smooth paste. Stir into the curry to thicken. Simmer for 5 more minutes. Season with salt." }]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [{ "type": "text", "text": "Serve over steamed rice." }]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Curry is too thin",
              "cause": "Not enough flour or not enough simmering time",
              "fix": "Mix 1 tablespoon of plain flour with a little cold water and stir it in. Simmer uncovered for 5 more minutes to thicken."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Where this dish lives" }]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Japanese curry is comfort food. It is mild and sweet compared to Indian curries. Most Japanese households keep a box of curry roux in the cupboard. The dish is served on a plate with rice alongside, not mixed together. It is popular with children and adults alike."
          }
        ]
      }
