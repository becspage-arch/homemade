      "slug": "trace",
      "term": "Trace",
      "definition": "The point at which a cold-process soap batter thickens enough to hold a faint trail drizzled on its surface, when botanicals and fragrance are added and the batter is ready to pour."
    },
    {
      "slug": "saponification",
      "term": "Saponification",
      "definition": "The chemical reaction between fat and sodium hydroxide that produces soap. Each oil has its own SAP value dictating how much lye is needed."
    },
    {
      "slug": "superfat",
      "term": "Superfat",
      "definition": "The percentage of oil left unsaponified in the finished bar, which adds a conditioning quality. This recipe uses 5%."
    }
  ],
