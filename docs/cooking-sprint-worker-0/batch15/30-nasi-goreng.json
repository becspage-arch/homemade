      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the soy sauce and sugar together in a small bowl and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over high heat. Add the shallots, garlic, and chilli. Stir-fry for 2 minutes until softened and fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chicken. Stir-fry for 4 to 5 minutes until cooked through and lightly browned."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cold rice. Break up any clumps and press it against the hot wok. Stir-fry for 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour over the soy sauce mixture and the fish sauce. Toss to coat all the rice evenly. Cook for a further 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve topped with spring onion and bean sprouts. A fried egg on top is traditional."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The rice is clumping.",
              "solution": "The rice was too wet or too freshly cooked. Day-old fridge-cold rice fries cleanly. Break clumps apart with your hands before it goes into the wok."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The rice is sticking to the wok.",
              "solution": "The wok was not hot enough before the oil went in. Get it smoking first. Add a little more oil around the edge of the wok."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The colour is pale.",
              "solution": "Add more of the soy and sugar mixture. Nasi goreng should be a deep brown. A splash more fish sauce also deepens the colour."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nasi goreng is eaten across Indonesia at all hours. It is a common breakfast dish made from leftover rice. It is sold from street carts and eaten in homes and restaurants alike. The dish is also widely eaten in Malaysia, Singapore, and the Netherlands, which colonised Indonesia for centuries."
          }
        ]
      }
    ]
  }
