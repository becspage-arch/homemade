    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nasi goreng",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nasi-goreng"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " gets its distinctive dark colour and sweet-savoury depth from "
          },
          {
            "type": "text",
            "text": "kecap manis ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "kecap-manis"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". Use rice that was cooked the day before and kept in the fridge. Freshly cooked rice steams rather than fries. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cook the rice in batches if your wok is small. Crowding the wok makes the rice clump and steam instead of fry."
          }
        ]
      },
