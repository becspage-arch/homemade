  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Doenjang jjigae is built around "
          },
          {
            "type": "text",
            "text": "doenjang ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "doenjang"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", a deeply savoury fermented paste that dissolves into the broth and gives the stew its characteristic flavour. Serve with a bowl of steamed rice. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Traditional recipes use "
          },
          {
            "type": "text",
            "text": "anchovy stock",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "anchovy-stock"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " as the base. This recipe uses a combination of water and miso paste as a practical substitute that gives a similar umami depth."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
