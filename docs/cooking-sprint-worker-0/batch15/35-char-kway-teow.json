      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the soy sauce, oyster sauce, and sesame oil together in a small bowl. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the wok over the highest heat possible until smoking. Add the oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and chilli. Stir for 20 seconds. Add the prawns and cook for 2 minutes until just pink."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the noodles. Spread them in the wok and leave for 30 seconds. Toss and leave again. Repeat twice to build colour on the noodles."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cabbage and bean sprouts. Pour over the sauce. Toss everything together for 1 to 2 minutes until the vegetables are just wilted."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and adjust. Serve immediately topped with spring onion."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The noodles are sticking to the wok.",
              "solution": "Use more oil and make sure the wok is properly hot before the noodles go in. Separate fresh noodles completely by hand before cooking."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "There is no char on the noodles.",
              "solution": "The heat is too low. Cook in two batches if your hob cannot get the wok hot enough with a full portion in it."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The dish is too wet.",
              "solution": "The bean sprouts or cabbage released water. Cook in smaller batches, and add the vegetables last so they spend minimal time in the pan."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Char kway teow is one of the most beloved hawker dishes in Malaysia and Singapore. It has Teochew Chinese roots and was originally sold by fishermen, farmers, and labourers as a cheap energy-dense meal. In Penang, it is considered a point of local pride. Each hawker has their own version of the sauce and the add-ins."
          }
        ]
      }
    ]
  }
