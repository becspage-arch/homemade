      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok or large saucepan over medium heat. Add the lemongrass and ginger. Stir for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the green curry paste. Fry for 2 minutes, stirring constantly, until fragrant and the paste darkens slightly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the coconut milk and stock. Stir to combine. Bring to a simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chicken. Cook for 10 minutes. Add the aubergine and bamboo shoots. Cook for a further 8 minutes until everything is tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the fish sauce, sugar, and lime juice. Taste and adjust."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the lemongrass stalks. Serve over steamed jasmine rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The curry is too hot.",
              "solution": "Use less curry paste next time. Adding more coconut milk also reduces the heat level in the finished dish."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The aubergine is mushy.",
              "solution": "It cooked too long. Add it later in the process and check after 6 minutes rather than 8."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The sauce is watery.",
              "solution": "Simmer uncovered for 5 more minutes to reduce. The coconut milk will thicken as the water evaporates."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Green curry is found across Thailand and is one of the dishes most associated with Thai cooking abroad. It is typically served with jasmine rice. The heat level varies by region and cook. Many home cooks in Thailand use jarred paste and add fresh aromatics on top."
          }
        ]
      }
    ]
  }
