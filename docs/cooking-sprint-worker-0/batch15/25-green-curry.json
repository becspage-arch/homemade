    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thai green curry gets its colour from the green chilli paste and its richness from "
          },
          {
            "type": "text",
            "text": "coconut milk ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "coconut-milk"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". Frying the "
          },
          {
            "type": "text",
            "text": "green curry paste",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "green-curry-paste"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in the pan first deepens the flavour before the liquid goes in. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Lemongrass",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "lemongrass"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " added at the start gives the broth an extra layer of fragrance. Remove the stalks before serving."
          }
        ]
      },
