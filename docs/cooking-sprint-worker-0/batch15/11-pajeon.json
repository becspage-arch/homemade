      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the dipping sauce ingredients together and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk the flour, cornflour, egg, and cold water together until just combined. A few lumps are fine. Do not overmix or the pancake will be tough."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 2 tablespoons of vegetable oil in a 30 cm frying pan over medium-high heat. Pour in half the batter and spread to the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lay half the spring onions across the batter in a single layer, pressing them in gently. Cook for 4 to 5 minutes until the bottom is golden and the edges look set."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Flip the pancake carefully using a wide spatula. Press down gently. Add another tablespoon of oil around the edges and cook for a further 3 to 4 minutes until the second side is equally crisp."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slide onto a board and cut into pieces. Repeat with the remaining batter. Serve hot with the dipping sauce."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Pancake is soft rather than crisp",
              "fix": "Use more oil and a higher heat. The oil needs to sizzle when the batter hits the pan. Also make sure the batter is cold when it goes in."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Pancake is falling apart when flipped",
              "fix": "Wait until the edges are fully set and the centre looks mostly cooked through before flipping. Shaking the pan gently first helps loosen it."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Batter is too thick",
              "fix": "Add water 1 tablespoon at a time until it pours smoothly. It should coat the back of a spoon but pour off easily."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pajeon is eaten as a snack, side dish, or light meal in Korea. There is a well-known saying that the sound of rain hitting a roof sounds like pajeon sizzling in oil. This has made it a dish strongly associated with rainy days. It is sold at markets and made at home across all regions of Korea."
          }
        ]
      }
    ]
  }
