            "text": "makgeolli",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "makgeolli"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " rice wine in the batter for a lighter texture. Sparkling water works as a substitute."
          }
        ]
      },
