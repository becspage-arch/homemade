  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kimchi is Korea's most iconic preserved food. It starts with salted cabbage that is coated in a spiced paste and left to ferment at room temperature before moving to the fridge. This batch serves 8 as a side dish."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fermentation takes at least 24 hours at room temperature. Most people prefer kimchi after 48 hours, when the flavour is more developed. Taste it each day and refrigerate when it reaches your preferred level of sourness."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 8,
          "items": [
            {
              "ingredientSlug": "cabbage-white",
              "amount": 1,
              "unit": "whole",
              "prepNote": "about 1 kg, cut into quarters then 5 cm pieces",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "spring-onion",
              "amount": 6,
              "unit": "whole",
              "prepNote": "cut into 3 cm lengths",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "carrot",
              "amount": 1,
              "unit": "whole",
              "prepNote": "cut into thin matchsticks",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "garlic",
              "amount": 8,
              "unit": "cloves",
              "prepNote": "finely grated",
              "isOptional": false,
              "groupLabel": null
            },
