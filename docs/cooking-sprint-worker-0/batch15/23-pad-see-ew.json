      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the soy sauce, oyster sauce, fish sauce, and sugar together in a small bowl. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the wok over the highest heat possible until it starts to smoke. Add the oil and swirl to coat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic. Stir for 20 seconds. Add the chicken and cook for 3 to 4 minutes, pressing it against the wok."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the noodles. Leave them undisturbed for 30 seconds. Toss. Leave again for 30 seconds. Repeat twice."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cabbage. Pour over the sauce. Toss everything together for 1 to 2 minutes until the cabbage is just wilted."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and adjust with more soy or oyster sauce. Serve immediately on warm plates."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The noodles are sticking together.",
              "solution": "Toss them with a teaspoon of oil after soaking. Fresh noodles should be separated gently by hand before they go in the wok."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "There is no charred flavour.",
              "solution": "The wok was not hot enough. Get it smoking before adding any oil. Cook in two batches if needed so the pan stays hot."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The noodles are soggy.",
              "solution": "Too much sauce or the noodles were wet. Drain them well. Add sauce in stages and taste as you go rather than adding it all at once."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pad see ew is a Thai street food staple sold at noodle stalls across Bangkok and beyond. It has Chinese-Thai roots and is closely related to Chinese chow fun. The dish is simpler than pad thai and faster to make. Most home cooks in Thailand keep the ingredients on hand for a quick weeknight dinner."
          }
        ]
      }
    ]
  }
