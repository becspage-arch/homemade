  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Tom yum goong is one of the most recognisable soups in Thai cooking. It uses " },
          { "type": "text", "text": "lemongrass", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "lemongrass" } }] },
          { "type": "text", "text": " and " },
          { "type": "text", "text": "galangal", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "galangal" } }] },
          { "type": "text", "text": " to build a broth that is hot, sour, and fragrant all at once. Serves 4." }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Fish sauce", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "fish-sauce" } }] },
          { "type": "text", "text": " and lime juice do the seasoning work. Add them at the end so the flavour stays bright." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "chicken-stock", "amount": 1000, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "lemongrass", "amount": 3, "unit": "stalks", "prepNote": "bruised and cut into 5cm lengths", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "ginger-fresh", "amount": 30, "unit": "g", "prepNote": "sliced (use in place of galangal)", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chilli-red", "amount": 3, "unit": null, "prepNote": "halved lengthways", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "mushrooms-chestnut", "amount": 150, "unit": "g", "prepNote": "halved", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "prawns-raw", "amount": 400, "unit": "g", "prepNote": "peeled and deveined", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "fish-sauce", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "lime", "amount": 2, "unit": null, "prepNote": "juiced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "spring-onion", "amount": 3, "unit": null, "prepNote": "sliced", "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour the stock into a large saucepan and bring to a boil over medium-high heat." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the lemongrass, ginger, and chilli. Simmer for 5 minutes to infuse the broth." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the mushrooms. Cook for 3 minutes until just tender." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the prawns. Cook for 2 to 3 minutes until they turn pink and curl. Do not overcook." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from the heat. Stir in the fish sauce and lime juice. Taste and adjust." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Ladle into bowls. Top with spring onion. Serve immediately." }] }]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The broth tastes flat.",
              "solution": "Add more lime juice first, then a little more fish sauce. The balance of sour and salty is what makes tom yum work."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The prawns are rubbery.",
              "solution": "They cooked too long. Prawns need only 2 to 3 minutes in simmering broth. Pull the pan off the heat the moment they curl."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The soup is too spicy.",
              "solution": "Remove the chilli halves before serving. Next time, deseed the chillies or use fewer."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Where this dish lives" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Tom yum is eaten all over Thailand, from home kitchens to roadside stalls. It is often served with steamed jasmine rice on the side. The aromatics in the bowl are not meant to be eaten. They are there to flavour the broth. Leftovers keep in the fridge for one day." }
        ]
      }
    ]
  }
