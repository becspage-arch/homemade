      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the dipping sauce ingredients together. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk the flour, cornflour, eggs, and cold water to a smooth batter. Stir the seafood into the batter."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 2.5 tablespoons of vegetable oil in a 30 cm frying pan over high heat until shimmering. Pour in half the batter and spread quickly to the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange half the spring onions across the surface, pressing them in lightly. Cook for 4 to 5 minutes until the base is deep golden and crisp."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Flip the pancake carefully using a wide spatula. Add the remaining oil around the edge of the pan. Cook for a further 4 minutes, pressing down, until the second side is equally crisp and the seafood is cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slide onto a board and cut into pieces. Repeat with the remaining batter. Serve hot with the dipping sauce."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Seafood is releasing water into the batter",
              "fix": "Pat the seafood dry before mixing into the batter. Excess moisture makes the pancake steam rather than fry."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Pancake is too thick in the centre",
              "fix": "Spread the batter thinner across the pan. Haemul pajeon should be no more than 1 cm thick to cook through evenly."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Squid is rubbery",
              "fix": "Cook on a high heat for the full time on each side. Squid is either cooked quickly at high heat or low and slow. Medium heat makes it tough."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Haemul pajeon is a popular dish in Korean seafood restaurants and at home. The Dongrae neighbourhood of Busan has a long history of elaborate seafood pajeon. It is eaten as a snack, a starter, or a drinking food alongside beer or makgeolli rice wine. The pancake is often brought to the table whole and torn apart by hand."
          }
        ]
      }
    ]
  }
