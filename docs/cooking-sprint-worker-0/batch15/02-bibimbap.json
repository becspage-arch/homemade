      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the gochujang sauce ingredients together in a small bowl. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blanch the spinach in boiling water for 30 seconds. Drain, squeeze dry, and toss with half the garlic, 1 tsp sesame oil, and 1 tsp soy sauce. Blanch the bean sprouts for 2 minutes, drain, and toss with the same seasonings."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a little vegetable oil in a frying pan over medium heat. Cook the carrot matchsticks for 2 minutes, season lightly, and remove. Repeat with the courgette, then the mushrooms, adding a little garlic to each batch."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the eggs in vegetable oil over medium heat until the whites are set but the yolks are still runny. Season lightly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the hot cooked rice between four bowls. Arrange each vegetable in a separate section on top of the rice. Place a fried egg in the centre."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drizzle with the gochujang sauce and sesame oil. Scatter sesame seeds over the top. Serve immediately and mix the contents of the bowl together at the table before eating."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Vegetables are releasing too much water",
              "fix": "Cook each vegetable separately over high heat and avoid overcrowding the pan. Press moisture out of the spinach and bean sprouts before seasoning."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Sauce is too spicy",
              "fix": "Add more sesame oil and a little extra sugar to balance the heat. Start with 1 tablespoon of gochujang and increase to taste."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Rice is sticking together in clumps",
              "fix": "Use freshly cooked short-grain rice and fluff it gently with a fork before adding to the bowls. Day-old rice tends to clump more."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bibimbap is a everyday Korean dish found in homes, school canteens, and restaurants. Jeonju city is famous for its version, which includes raw beef and a traditional stone bowl. The stone bowl is heated until sizzling hot so the rice at the bottom crisps up. Home cooks use regular bowls with equally good results."
          }
        ]
      }
    ]
  }
