      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over medium-high heat. Add the red curry paste and fry for 2 minutes, stirring, until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the coconut milk and stock. Stir to combine and bring to a simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the aubergine and tofu. Cook for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the courgette, red pepper, and bamboo shoots. Cook for a further 5 to 6 minutes until the vegetables are tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the fish sauce (or soy sauce), sugar, and lime juice. Taste and adjust."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve immediately over steamed jasmine rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The tofu is falling apart.",
              "solution": "Press the tofu for at least 20 minutes before cooking to remove excess moisture. Firm tofu holds better than silken."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The sauce is too thin.",
              "solution": "Simmer uncovered for 5 extra minutes. Alternatively, use only 100ml of stock rather than 150ml next time."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The curry lacks heat.",
              "solution": "Add a pinch of chilli flakes or use more curry paste. The heat level of jarred pastes varies by brand."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Red curry is eaten throughout Thailand and is one of the most replicated Thai dishes abroad. The vegetable version is popular with vegetarians and vegans who want the flavour of Thai curry without meat. Aubergine and bamboo shoots are the traditional vegetable additions."
          }
        ]
      }
    ]
  }
