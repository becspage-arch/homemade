      "slug": "nori",
      "term": "Nori",
      "definition": "Dried and pressed sheets of seaweed used in East Asian cooking. The sheets are toasted to bring out a nutty, umami flavour before rolling."
    },
    {
      "slug": "gim",
      "term": "Gim",
      "definition": "The Korean word for dried seaweed sheets, equivalent to nori. In gimbap, the gim is the outer wrapper that holds the rice and fillings."
    }
