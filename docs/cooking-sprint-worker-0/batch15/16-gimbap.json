      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the rice is still warm, stir through the sesame oil and sesame seeds. Spread on a tray to cool to room temperature. Do not refrigerate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Prepare all the fillings. Beat the eggs with a pinch of fine seasoning and cook in a lightly oiled pan over medium heat as thin omelettes. Cut into strips. Set out all fillings on the work surface."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lay a sheet of nori on a clean surface, shiny side down. Spread about 150 g of the seasoned rice in an even layer, leaving a 3 cm border at the far edge."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange the fillings in a horizontal line across the centre of the rice. Do not overfill. Tightly roll from the near edge, pressing firmly as you go. Press the far edge against the roll to seal."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Brush the outside of each roll with a thin coat of sesame oil. This gives a glossy surface and prevents it sticking. Repeat with the remaining rolls."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Use a sharp knife to slice each roll into 8 rounds. Wipe the blade between cuts for clean edges. Serve immediately or wrap tightly for a picnic."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Roll is falling apart when sliced",
              "fix": "The roll was not pressed tightly enough. Use firm, even pressure throughout the rolling. A bamboo mat helps apply even pressure."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Nori is tearing",
              "fix": "Make sure the nori is dry. A damp filling will soften the nori before the roll is complete. Squeeze all wet fillings such as spinach very well."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Rice is too sticky to spread",
              "fix": "Wet your hands or a spatula with cold water before spreading. Rice at room temperature spreads more easily than warm rice."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Gimbap is packed into Korean lunchboxes for school and work. It appears at every picnic, sports day, and hiking trip. Gimbap shops are common on Korean high streets and serve dozens of different fillings. The rolls are eaten at room temperature, never cold from the fridge."
          }
        ]
      }
    ]
  }
