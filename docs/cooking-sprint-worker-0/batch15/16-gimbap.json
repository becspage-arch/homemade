  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Gimbap is wrapped in sheets of "
          },
          {
            "type": "text",
            "text": "nori ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nori"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", called "
          },
          {
            "type": "text",
            "text": "gim",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "gim"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in Korean. The rice is seasoned with sesame oil rather than vinegar, which gives it a nutty, savoury flavour. Makes 4 rolls."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The fillings can be varied. This version uses egg, carrot, spinach, and cucumber. Beef strips or fish cake are common additions. Keep all fillings cool before rolling."
          }
        ]
      },
