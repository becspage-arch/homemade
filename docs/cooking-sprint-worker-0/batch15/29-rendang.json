      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the shallots, garlic, ginger, chillies, turmeric, coriander, and cumin with a splash of water into a smooth paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a dutch oven over medium heat. Add the paste, cinnamon, and cloves. Fry for 5 minutes, stirring, until the paste is fragrant and darkened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the beef and lemongrass stalks. Stir to coat the beef in the paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the coconut milk. Bring to a simmer. Cook uncovered over low heat for 90 minutes, stirring occasionally."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the sugar and tamarind paste. Continue to cook for another 40 to 50 minutes, stirring more frequently as the liquid reduces. The paste will darken and begin to fry the beef as the oil separates."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The rendang is ready when the beef is coated in a dry, dark paste with no liquid remaining. Serve with steamed rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The paste is catching on the bottom of the pan.",
              "solution": "Lower the heat and stir more frequently. Add a splash of water if needed. The final stage requires constant attention."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The beef is still tough at 2 hours.",
              "solution": "Shin needs more time. Add 100ml of water and continue cooking. Every piece of beef is different."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The flavour is one-dimensional.",
              "solution": "Add more tamarind paste for sourness and a pinch more sugar for balance. Taste before serving and adjust both."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rendang comes from the Minangkabau people of West Sumatra. It is made for weddings, religious celebrations, and important guests. The long cooking time was originally a preservation method in the tropical heat. It is now eaten across Indonesia and Malaysia and is one of the most recognised dishes in Southeast Asian cooking."
          }
        ]
      }
    ]
  }
