      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the vegetable oil in a medium saucepan over medium heat. Add the chilli flakes and cook, stirring, for 1 minute until fragrant and the oil turns red. Do not let them burn."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and onion. Cook for 2 minutes. If using pork mince, add it now and cook, breaking it up, until no longer pink, about 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the chicken stock. Add the fish sauce and soy sauce. Bring to a boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the silken tofu in large spoonfuls. If using prawns, add them now. Simmer for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Crack one egg directly into the stew. Cover and cook for 2 minutes until the white is just set but the yolk is still runny. For individual servings, use one small pot per person and crack one egg into each."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the spring onion and drizzle sesame oil over the top. Serve immediately with steamed rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Tofu is breaking up too much",
              "fix": "Add it in large spoonfuls and do not stir once it is in the pot. Let it break up naturally as the stew simmers."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Broth is not red enough",
              "fix": "Bloom the chilli flakes in oil for a full minute before adding any liquid. The oil carries the colour into the broth."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Egg is fully cooked through",
              "fix": "Reduce the heat to a gentle simmer before adding the egg. Cover immediately and check after 2 minutes."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sundubu jjigae is eaten throughout Korea, especially in winter. Restaurants serve it in earthenware pots that retain heat and keep the stew bubbling at the table. The dish is popular for lunch and dinner and is often served as a set meal with rice and small side dishes."
          }
        ]
      }
    ]
  }
