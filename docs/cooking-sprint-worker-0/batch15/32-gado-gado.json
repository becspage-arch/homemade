      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the peanut sauce. Blend the peanuts, garlic, chilli, coconut milk, lime juice, soy sauce, and sugar until smooth. Add warm water to loosen if too thick. Taste and adjust."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil the potatoes until tender. Drain and slice."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blanch the carrot batons in boiling water for 2 minutes. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blanch the cabbage for 1 minute. Remove and drain well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the tofu cubes in a little oil until golden on all sides. Drain on paper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange the vegetables, bean sprouts, and tofu on a large platter. Pour the peanut sauce over the top and serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The peanut sauce is too thick.",
              "solution": "Add warm water one tablespoon at a time, blending between additions, until it pours easily."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The sauce lacks punch.",
              "solution": "Add more lime juice and chilli. Then taste again. The sauce should be bold before you pour it over the relatively plain vegetables."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The tofu is soft and not crisp.",
              "solution": "Press the tofu for at least 20 minutes to remove moisture. Fry in hot oil and do not move the pieces until a crust forms."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Gado-gado is one of Indonesia's national dishes. It is sold at street stalls, in warungs, and in restaurants across the country. The peanut sauce recipe varies by region and by family. The dish is naturally plant-based and filling enough to serve as a main meal without any meat."
          }
        ]
      }
    ]
  }
