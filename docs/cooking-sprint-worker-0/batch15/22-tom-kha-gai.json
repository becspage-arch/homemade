    "content": [
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Tom kha gai is a fragrant Thai soup that balances the richness of " },
          { "type": "text", "text": "coconut milk", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "coconut-milk" } }] },
          { "type": "text", "text": " with the brightness of " },
          { "type": "text", "text": "lemongrass", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "lemongrass" } }] },
          { "type": "text", "text": " and ginger. It comes together in under 30 minutes. Serves 4." }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Fish sauce", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "fish-sauce" } }] },
          { "type": "text", "text": " and lime juice go in at the end. This keeps the broth tasting fresh rather than cooked-down." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
