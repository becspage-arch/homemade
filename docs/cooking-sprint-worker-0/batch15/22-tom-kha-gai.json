        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "chicken-stock", "amount": 500, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "coconut-milk", "amount": 400, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
