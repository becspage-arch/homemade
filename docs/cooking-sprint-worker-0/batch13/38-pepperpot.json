      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a little oil in the dutch oven over high heat. Brown the beef shin in batches using tongs, turning on all sides. Remove and set aside. Brown the bacon briefly in the same pot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the onion and garlic in the residual fat over medium heat for 5 minutes. Add the dark-brown sugar and let it caramelise for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return all the meat to the pot. Add the treacle, malt vinegar, allspice, cinnamon stick, thyme and whole scotch bonnets. Pour in the water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a simmer, cover and cook over very low heat for 2.5 to 3 hours until the beef is completely tender and the sauce is dark and thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the scotch bonnets, cinnamon stick and thyme. Taste and adjust seasoning. Serve with bread, rice or roti."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The pepperpot tastes too bitter.",
              "solution": "The treacle was too much or the sugar did not balance it. Add a little more dark-brown sugar, stir well and simmer for 5 more minutes."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The sauce is not dark enough.",
              "solution": "Make sure you caramelised the sugar fully before adding the liquid. The treacle also contributes colour; do not reduce the amount."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The beef is still tough after 3 hours.",
              "solution": "Continue cooking. Some beef shin can take up to 4 hours depending on the animal. The pot is very forgiving of extra cooking time."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pepperpot is Guyana's national dish and Christmas food. It is eaten on Christmas morning with homemade bread. The pot is kept on the stove for days and refreshed with new meat each morning. It is food that belongs to a specific culture and carries deep family significance in Guyanese households."
          }
        ]
      }
    ]
  }
