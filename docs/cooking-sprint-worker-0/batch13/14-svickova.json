    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The distinguishing step is to "
          },
          {
            "type": "text",
            "text": "puree",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "puree-sauce"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " all the braising vegetables with the cooking liquid into a velvety sauce, then finish with double cream. Traditional recipes also call for "
          },
          {
            "type": "text",
            "text": "lard basting",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "lard-baste"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " but this simplified version produces excellent results without special equipment. Serves 6."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Serve with Czech bread dumplings (knedliky), a spoonful of cranberry sauce, and a slice of lemon on the plate."
          }
        ]
      },
