  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The technique at the heart of the dish is "
          },
          {
            "type": "text",
            "text": "strudel stretching ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "strudel-stretch"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ": pulling the rested dough until it is paper-thin over a large floured cloth. "
          },
          {
            "type": "text",
            "text": "Toasted breadcrumbs",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "toasted-breadcrumbs-strudel"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " scattered over the filling absorb moisture from the apple and keep the pastry from going soggy. Serves 6."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The dough is delicate but forgiving. Small tears can be patched; they will not show after rolling."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
