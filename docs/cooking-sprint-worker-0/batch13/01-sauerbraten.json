      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the vinegar, wine, water, onion, carrot, celery, bay leaves, peppercorns, and allspice in a large bowl or container. Submerge the beef completely. Cover and refrigerate for 2 to 3 days, turning the meat once a day."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lift the beef from the marinade. Pat it dry with kitchen paper. Strain the marinade and keep the liquid. Discard the solids."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a dutch oven over high heat. Brown the beef on all sides until deeply coloured, about 10 minutes total. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the reserved marinade liquid and the beef stock. Return the beef to the pot. Bring to a simmer, cover tightly, and transfer to the oven at 160C. Braise for 2.5 to 3 hours until the meat is very tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lift out the beef and rest it for 15 minutes. Strain the braising liquid into a saucepan. Add the dark brown sugar and mustard. Simmer over medium heat for 10 to 15 minutes until the sauce coats the back of a spoon. Slice the beef and serve with the sauce."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Sauce is too sour"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add more dark brown sugar a teaspoon at a time, tasting as you go."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Beef is tough after braising"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return it to the pot and braise for another 30 minutes. Shin needs full collagen breakdown to become tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Sauce is too thin"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer uncovered at medium-high for a few more minutes until it thickens to your liking."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sauerbraten is eaten across Germany and is especially tied to the Rhine and Rhineland regions. It turns up on Sunday tables and at family celebrations. The word means 'sour roast', which tells you everything about the technique. It is comfort food that rewards patience."
          }
        ]
      }
    ]
