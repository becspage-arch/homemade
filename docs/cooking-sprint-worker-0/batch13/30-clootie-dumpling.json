  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Clootie dumpling is a "
          },
          {
            "type": "text",
            "text": "steamed pudding",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "steamed-pudding"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in the oldest sense: a rich mixture of flour, fruit, spice and butter wrapped in a "
          },
          {
            "type": "text",
            "text": "clootie",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "clootie"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and suspended in boiling water for three hours. The skin that forms where the cloth touches the pudding is the most prized part, smoky and dark from the heat."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use a large square of cotton or linen cloth, not synthetic fabric. Dip it in boiling water and flour it before wrapping the pudding so a good skin forms during cooking. The finished dumpling can be served hot or sliced cold and fried in butter."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 8,
          "items": [
            {
              "ingredientSlug": "plain-flour",
              "amount": 200,
              "unit": "g",
              "prepNote": "plus extra for the cloth",
              "isOptional": false,
              "groupLabel": null
            },
