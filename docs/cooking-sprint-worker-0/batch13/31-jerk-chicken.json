      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the scotch bonnet, spring onion, garlic, ginger, allspice, cinnamon, thyme, soy sauce, oil and lime juice in the food processor. You want a coarse paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Score the chicken thighs through the skin to the bone. Rub the jerk paste all over the chicken and into the cuts. Cover and refrigerate for at least 8 hours, ideally overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Take the chicken out of the fridge 30 minutes before cooking. Heat the griddle pan over high heat until very hot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Grill the chicken skin-side down for 10 minutes until the skin is charred and releases easily. Turn and grill for another 8 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Check the internal temperature with the instant-read thermometer; it should read 74°C at the thickest part. Rest for 5 minutes before serving with rice and peas."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The chicken is charring on the outside but raw inside.",
              "solution": "Reduce the heat to medium after the initial sear. Alternatively, finish in a 180°C oven for 15 to 20 minutes after grilling both sides."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The jerk paste is not sticking to the chicken.",
              "solution": "Score the chicken more deeply and press the paste into the cuts firmly. The cuts also help the marinade penetrate to the bone."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The chicken is not spicy enough.",
              "solution": "Leave the seeds in the scotch bonnets next time. The seeds and the white pith hold most of the heat."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Jerk chicken is eaten all over Jamaica, cooked over wood and pimento branches at roadside stalls called jerk centres. Boston Bay in Portland parish is considered the home of jerk. In the UK, it is a staple of Caribbean takeaways and the Notting Hill Carnival. It is always served with rice and peas."
          }
        ]
      }
    ]
  }
