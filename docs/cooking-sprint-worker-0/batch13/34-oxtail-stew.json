      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a little oil in the dutch oven over high heat. Scatter in the dark-brown sugar and let it caramelise for 30 seconds, then add the oxtail pieces using tongs. Brown on all sides for 8 to 10 minutes in batches. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In the same pot, cook the onion and garlic over medium heat for 5 minutes. Add the tomato puree and cook for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the oxtail to the pot. Add the carrot, scotch bonnet, thyme, allspice, soy sauce and beef stock. Bring to a simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover tightly and cook over the lowest heat for 2.5 to 3 hours until the meat is completely tender and pulling from the bone. Check every 45 minutes and add a splash of water if the liquid reduces too much."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained beans in the last 20 minutes of cooking. Remove the scotch bonnet and thyme sprigs. Season and serve with rice and peas."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The meat is still chewy after 3 hours.",
              "solution": "Oxtail is variable in size and age. Give it another 30 to 45 minutes. It is done when the meat pulls away from the bone with no resistance."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The sauce is too thin.",
              "solution": "Remove the oxtail and reduce the sauce over medium heat without the lid for 10 to 15 minutes until it coats a spoon."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The dish is too fatty.",
              "solution": "Make it the day before. Refrigerate overnight and lift off the solid fat that rises to the surface. Reheat gently before serving."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Oxtail stew is Sunday-best food across Jamaica and other Caribbean islands. In the UK it is a Caribbean restaurant staple, served with rice and peas and fried plantain. Dedicated oxtail cooks guard their recipes closely. The dish rewards patience and is worth every hour of cooking."
          }
        ]
      }
    ]
