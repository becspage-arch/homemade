              "amount": 2,
              "unit": "tbsp",
              "prepNote": "or to taste",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk the cornmeal into the cold water in the medium saucepan until there are no lumps. This is important: adding cornmeal to hot liquid causes instant lumping."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the coconut milk, cinnamon stick, ground cinnamon and vanilla extract. Place over medium heat and stir continuously with the whisk as the mixture warms."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Once the porridge begins to thicken (after 8 to 10 minutes), reduce the heat to low. Stir frequently to prevent the base catching."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Continue cooking for another 8 to 10 minutes until the porridge is thick, smooth and pulls away slightly from the sides of the pan."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the cinnamon stick. Stir in the honey and taste for sweetness. Serve immediately in warm bowls."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The porridge has lumps in it.",
              "solution": "The cornmeal was added to warm liquid. Whisk vigorously and the lumps will often break down over heat. Next time mix the cornmeal into cold liquid before turning on the heat."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The porridge is catching on the bottom of the pan.",
              "solution": "Reduce the heat further. Once the porridge thickens it needs very low heat and frequent stirring. A heavy-based pan helps distribute heat more evenly."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The porridge thickened too quickly and is too stiff.",
              "solution": "Add a splash of hot water or more coconut milk and stir vigorously until the porridge loosens to the right consistency."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cornmeal porridge is a weekday breakfast across Jamaica and other Caribbean islands. Street vendors sell it in styrofoam cups to early commuters. It is school-morning food and the kind of thing Caribbean grandmothers are associated with making. Nutmeg is a common addition in some households."
          }
        ]
      }
    ]
  }
