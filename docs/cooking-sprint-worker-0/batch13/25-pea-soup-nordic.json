      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rinse the peas in cold water and pick out any stones. If using dried split peas, no soaking is required."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put the peas, bacon, onion, carrot, thyme and bay leaves into the stockpot. Cover with the water and bring to a boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Skim off any foam that rises to the surface. Reduce the heat to a low simmer, cover and cook for 75 to 90 minutes until the peas have broken down into a thick, almost smooth soup."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the bacon and slice or shred it. Discard the thyme sprigs and bay leaves. Return the bacon to the pot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and season. Ladle into bowls and serve with a spoonful of mustard alongside."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The peas are not breaking down after 90 minutes.",
              "solution": "Some older dried peas take longer. Continue simmering and check every 15 minutes. Old peas from a pack that has been open a long time may never fully dissolve."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The soup is too thick.",
              "solution": "Add more water a ladleful at a time, stirring as you go, until you reach the consistency you want."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The soup lacks depth.",
              "solution": "The bacon is doing most of the flavour work. Use proper smoked bacon with a strong smoke flavour, not unsmoked back bacon."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Swedish pea soup is a Thursday institution across the whole country. Schools, military canteens and restaurants all serve it on Thursdays. Thin pancakes with jam follow it as dessert, making the meal complete. The tradition dates back to Catholic fasting laws and outlasted the religion by centuries."
          }
        ]
      }
    ]
  }
