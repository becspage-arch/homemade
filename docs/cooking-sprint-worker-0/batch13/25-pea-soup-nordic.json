  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": ""
          },
          {
            "type": "text",
            "text": "Ärtsoppa",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "artsoppa"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " is a thick, sustaining soup built around "
          },
          {
            "type": "text",
            "text": "yellow peas",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "yellow-pea"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and smoked bacon. The peas dissolve slowly into a velvety broth during the long simmer. Smoked bacon adds depth without overpowering the clean, earthy pea flavour."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you cannot find dried yellow split peas, dried green split peas work in exactly the same way. This recipe uses black-eyed peas as the listed substitute; adjust if you source yellow split peas directly. Serve with a spoonful of mustard stirred into each bowl."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
