      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the butter in a large saucepan over medium heat. Add the diced bacon and cook for 3 to 4 minutes until it releases its fat and starts to colour. Add the onion, leek, and carrot. Cook, stirring, for 8 minutes until softened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the diced potato, stock, bay leaves, and thyme. Bring to a boil, then reduce to a gentle simmer. Cook uncovered for 20 minutes until the potato is completely tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the bay leaves and thyme stalks. Scoop out about half the soup into a blender and blitz until smooth. Return the blended portion to the pot and stir to combine."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and adjust seasoning. Stir in the chopped parsley."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle into bowls and top with a dollop of sour cream if using."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Soup is too thick"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in a splash of extra stock or water and warm through. The soup thickens further on standing."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Potato is still firm after 20 minutes"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The dice was too large. Give it another 5 to 10 minutes and check again. Aim for 2cm cubes next time."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Soup tastes flat"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The bacon gives the base flavour, so make sure it coloured properly at the start. A splash of white wine vinegar at the end also brightens a flat potato soup."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Potato soup is on every family table in Germany, especially in autumn and winter. It is inexpensive, filling, and deeply satisfying. Recipes vary by region: some add cream, others vinegar, some include tiny sausages. This version is the everyday base that most home cooks know."
          }
        ]
      }
    ]
