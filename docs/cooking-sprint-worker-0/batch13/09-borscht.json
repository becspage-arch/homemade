  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The key to vivid borscht is to use "
          },
          {
            "type": "text",
            "text": "raw beetroot",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "beetroot-borscht"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " rather than pre-cooked, and to add a splash of vinegar near the end to set the colour and sharpen the flavour. Serves 6."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A spoonful of "
          },
          {
            "type": "text",
            "text": "sour cream",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "smetana"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " stirred in at the table is traditional and transforms the soup into something richer and more complex."
          }
        ]
      },
      {
