  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The two elements here need different treatment: the "
          },
          {
            "type": "text",
            "text": "sauerkraut",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "sauerkraut-term"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " braises gently in the pan with onion and white wine while the sausages grill separately until well-coloured and cooked through. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use jarred or bagged sauerkraut, well drained. The "
          },
          {
            "type": "text",
            "text": "caraway",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "caraway"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " seeds are traditional and add the characteristic German warmth."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "sausages-pork",
              "amount": 8,
