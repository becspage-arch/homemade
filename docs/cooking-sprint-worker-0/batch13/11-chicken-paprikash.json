  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The recipe turns on two key points: adding "
          },
          {
            "type": "text",
            "text": "Hungarian sweet paprika",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "paprikash-paprika"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " off the heat so it blooms without burning, and "
          },
          {
            "type": "text",
            "text": "tempering",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "off-heat-cream"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " the sour cream to prevent splitting. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bone-in chicken thighs work best here. They stay juicy through the long braise and flavour the sauce better than breast meat."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
