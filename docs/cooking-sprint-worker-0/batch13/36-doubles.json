      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the bara dough: mix the flour with a pinch of baking powder and enough warm water to bring it together into a soft dough. Knead for 5 minutes. Cover and rest for 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the channa: fry the onion in a little oil for 5 minutes, add the garlic, scotch bonnet and spices and cook for 1 minute. Add the chickpeas and 100ml water. Simmer for 15 minutes, mashing some chickpeas as they cook to thicken the mixture. Add the vinegar, season and keep warm."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the bara dough into 16 equal pieces. Use oiled hands to press each piece into a thin disc about 10cm across."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the vegetable oil in the large frying pan to 180°C. Fry the bara discs one at a time for 30 to 45 seconds per side until puffed and lightly golden. Drain on paper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Assemble immediately: place a spoonful of channa on one bara and top with a second. Serve with hot sauce if you like more heat."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The bara is not puffing when fried.",
              "solution": "The oil is not hot enough or the dough is too thick. Press the discs thinner and check the oil temperature with a thermometer."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The bara is very oily.",
              "solution": "The oil temperature was too low. Cold oil soaks into the dough before the surface seals. Make sure the oil is at 180°C before frying."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "The channa is too wet and soaks into the bara.",
              "solution": "Continue simmering the channa without a lid until most of the liquid has evaporated. The filling should be thick and spoonable, not saucy."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Doubles are Trinidad's most popular street food. Vendors sell them from carts from early morning and they sell out fast. Eating doubles is a daily ritual for many Trinidadians. In the UK they appear at Caribbean food events and a small number of specialist restaurants."
          }
        ]
      }
    ]
  }
