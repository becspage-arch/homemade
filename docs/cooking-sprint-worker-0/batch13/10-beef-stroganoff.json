  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The critical technique is the "
          },
          {
            "type": "text",
            "text": "high-heat sear",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "stir-fry-motion"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " for the beef strips: work in small batches in a very hot pan so the beef browns rather than steams. The "
          },
          {
            "type": "text",
            "text": "sour cream sauce",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "sour-cream-sauce"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " goes in off the heat to prevent splitting. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use beef sirloin or a tender cut. Slice it thinly against the grain for the most tender result."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
