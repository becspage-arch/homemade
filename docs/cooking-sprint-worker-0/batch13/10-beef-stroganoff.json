      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil and half the butter in a large frying pan over high heat until smoking. Sear the beef strips in two or three batches, 1 to 2 minutes per batch. Do not crowd the pan. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce the heat to medium. Add the remaining butter. Cook the onion for 5 minutes until softened. Add the garlic and cook for 1 minute. Add the sliced mushrooms and cook for 5 to 6 minutes until golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the beef stock. Bring to a simmer and cook for 2 minutes. Stir in the mustard and paprika."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the pan from the heat. Stir in the sour cream until smooth and combined. Return the beef and any resting juices. Return briefly to a very low heat for 1 to 2 minutes just to warm through. Do not boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter over the chopped parsley and serve with egg noodles or rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Sour cream splits and looks grainy"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The pan was too hot when you added the cream. Always take the pan off the heat before stirring in the sour cream, and never let the sauce boil after adding it."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Beef is chewy and tough"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slice more thinly, cut strictly against the grain, and keep the sear time very short. Sirloin goes from rare to overcooked in seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Mushrooms are wet and not browning"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "You crowded the pan. Cook in a single layer and resist stirring for the first 2 to 3 minutes so they can colour properly."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Beef Stroganoff was created in nineteenth-century Russia and named after the Stroganov family of St Petersburg. It was adopted enthusiastically across Europe and became a restaurant standard by the mid-twentieth century. The dish is quick enough for a weeknight but refined enough to serve at a dinner party."
          }
        ]
      }
    ]
  }
