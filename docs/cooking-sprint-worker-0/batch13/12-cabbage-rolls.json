      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring a large pot of water to a boil. Core the cabbage and add it whole to the water. As the outer leaves soften, peel them off with tongs. You need 12 to 16 large leaves. Blanch until just pliable, about 2 minutes each. Set aside to cool."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the pork mince, uncooked rice, grated onion, garlic, egg, paprika, and seasoning together in a bowl until well combined."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the sauce: cook the diced onion in oil for 8 minutes. Add the garlic and tomato puree and cook for 1 minute. Add the tinned tomatoes and bay leaves. Simmer for 10 minutes. Season."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place 2 to 3 tablespoons of filling at the base of each cabbage leaf. Fold in the sides and roll up firmly. Arrange the rolls seam-side down in a baking tin."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the tomato sauce over the rolls. Cover tightly with foil and bake at 170C for 75 to 90 minutes until the filling is cooked through and the rice is tender. Serve with sour cream."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Rolls unroll during cooking"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll them tightly with the seam underneath, nestled against each other in the tin so they hold their shape. A toothpick through each roll also helps."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Rice is still firm after 90 minutes"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and return to the oven for another 20 minutes. Make sure the sauce is surrounding the rolls and the tin is tightly covered."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Cabbage leaves tear when rolling"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blanch for longer. The leaves need to be fully pliable. Use a sharp knife to shave down any thick central ribs before rolling."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stuffed cabbage rolls are made across Poland, Ukraine, Hungary, Romania, and the Balkans under many names. Each country has its own filling and sauce. This version follows the Polish and Ukrainian tradition of tomato sauce and pork. They appear at Christmas, family celebrations, and weekday dinners in equal measure."
          }
        ]
      }
    ]
  }
