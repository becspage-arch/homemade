      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make a quick anchovy stock: simmer 8 dried anchovies in 600ml of water for 10 minutes. Strain and discard the anchovies."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the sesame oil in a small saucepan over medium heat. Add the garlic and gochugaru. Stir for 30 seconds until fragrant and the oil turns deep red."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the anchovy stock. Add the soy sauce and fish sauce. Bring to a boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Gently spoon in the silken tofu in large pieces. If using kimchi, add it now. Simmer for 5 minutes without stirring."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Crack an egg directly into each portion just before serving. The residual heat from the boiling stew will cook the egg gently. Scatter spring onions over the top and serve immediately with steamed rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Tofu dissolved into the broth",
              "cause": "The stew was stirred after adding the tofu",
              "fix": "Silken tofu breaks apart very easily. Once it is in the pot, do not stir. Shake the pan gently if needed and ladle broth over the top."
            },
            {
              "symptom": "Stew is not spicy enough",
              "cause": "The gochugaru was added directly to liquid rather than bloomed in oil",
              "fix": "Always cook the gochugaru in oil for 30 seconds before adding stock. This deepens the colour and flavour significantly."
            },
            {
              "symptom": "Egg cooked too firm",
              "cause": "The egg was added too early and the stew was too hot",
              "fix": "Add the egg right before serving and let it sit in the hot stew for 1 to 2 minutes off the heat. The yolk should remain slightly runny."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sundubu jjigae is a comfort dish. It is eaten year-round. Korean families cook it on weeknights. It is warming in cold weather. Restaurants serve it in stone bowls that stay hot. At home, a regular pot is fine. It is always eaten with rice."
          }
        ]
      }
    ]
  }
