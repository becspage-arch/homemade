    {
      "slug": "glass-noodles",
      "term": "Glass noodles",
      "definition": "Translucent noodles made from sweet potato starch, also called dangmyeon in Korean. They are soaked in boiling water until soft then stir-fried. They have a chewy, springy texture and absorb the flavours of whatever they are cooked with."
    },
    {
      "slug": "sesame-oil-finish",
      "term": "Finishing with sesame oil",
      "definition": "Adding sesame oil at the end of cooking rather than at the start. Because toasted sesame oil has a low smoke point and a delicate flavour, it is stirred in off the heat to preserve its nutty aroma."
    }
  ],
