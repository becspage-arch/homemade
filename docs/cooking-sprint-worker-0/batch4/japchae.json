      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Soak the glass noodles in boiling water for 8 minutes until pliable but still slightly firm. Drain, rinse with cold water, and cut into roughly 20cm lengths with scissors."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the sauce: mix 4 tbsp soy sauce, 2 tbsp sesame oil, 2 tbsp sugar, and garlic together. Divide roughly in half. Use one half to marinate the beef for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blanch the spinach for 30 seconds, drain, squeeze dry, and season with 1 tsp soy sauce and a few drops of sesame oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a wok over high heat, stir-fry the carrots for 2 minutes in a little oil and salt. Do the same with the courgette, then the mushrooms, setting each aside as you go."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir-fry the marinated beef over high heat for 3 minutes until cooked through. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained noodles to the wok with the remaining sauce. Toss over medium heat for 2 minutes until the noodles absorb the sauce."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add all the cooked vegetables and beef back to the wok. Toss everything together over high heat for 2 minutes. Remove from the heat and stir in 1 tbsp sesame oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to a serving platter. Scatter sesame seeds and spring onions over the top. Serve warm or at room temperature."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Noodles clump together",
              "cause": "They were drained and left to sit too long before stir-frying",
              "fix": "Toss the drained noodles with a few drops of sesame oil immediately after draining to stop them sticking."
            },
            {
              "symptom": "Dish tastes bland",
              "cause": "The sauce was not fully absorbed by the noodles",
              "fix": "Add the sauce to the noodles while the wok is still hot and toss for at least 2 minutes to let the noodles absorb the flavour."
            },
            {
              "symptom": "Vegetables are soggy",
              "cause": "Each vegetable was not cooked separately on high heat",
              "fix": "Cook each vegetable in a hot, lightly oiled wok separately. Do not add liquid. High heat and short cooking time keeps them firm."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Japchae appears at Korean celebrations. It is served at birthdays and holidays. It is also eaten as a side dish. It is common to make a large batch. It tastes good warm or at room temperature."
          }
        ]
      }
    ]
  }
