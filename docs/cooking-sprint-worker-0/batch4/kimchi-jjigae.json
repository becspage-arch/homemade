        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a saucepan over medium-high heat. Add the pork belly and cook, stirring, for 5 minutes until it starts to brown and the fat renders."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and gochugaru to the pork. Stir for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the kimchi including all its juice. Stir to coat with the pork fat. Cook for 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add 600ml of water, the gochujang, and soy sauce. Bring to a boil, then reduce to a steady simmer. Cook for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tofu and spring onions. Simmer for 5 more minutes. Stir in the sesame oil off the heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve hot from the pot with bowls of steamed rice on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Stew tastes flat and acidic without depth",
              "cause": "The kimchi used was too fresh",
              "fix": "Use kimchi that has been fermenting for at least a month. If yours is fresh, let it sit at room temperature for an extra day before using it in the stew."
            },
            {
              "symptom": "Broth is too watery",
              "cause": "The stew was not simmered long enough",
              "fix": "Simmer uncovered for the full 20 minutes so the liquid reduces and the kimchi breaks down into the broth."
            },
            {
              "symptom": "Pork is tough",
              "cause": "Pork belly pieces were too thick and not cooked long enough",
              "fix": "Cut pieces no thicker than 3cm. Simmer for a full 20 minutes. The fat in pork belly will soften with time."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kimchi jjigae is a Korean home staple. It is made when the kimchi in the jar gets very sour. Every Korean family makes it slightly differently. Some use tuna instead of pork. Some add more tofu. It is always eaten with rice."
          }
        ]
      }
    ]
  }
}