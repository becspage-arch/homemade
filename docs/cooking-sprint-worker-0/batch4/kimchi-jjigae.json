  "glossaryTerms": [
    {
      "slug": "kimchi-ripe",
      "term": "Ripe kimchi",
      "definition": "Kimchi that has fermented for several weeks or months until it has developed a strong sour flavour and softened texture. Ripe kimchi is preferable for cooking as it breaks down in the stew and gives the broth a deep, tangy complexity that fresh kimchi cannot achieve."
    },
    {
      "slug": "doenjang-jjigae-kimchi",
      "term": "Gochugaru",
      "definition": "Korean red chilli flakes used in kimchi jjigae to add heat and colour beyond what the kimchi provides. The amount used can be adjusted depending on how spicy the kimchi already is."
    }
  ],
  "techniqueSlugs": [],
