              "amount": 400,
              "unit": "g",
              "prepNote": "well-fermented, roughly chopped",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "pork-belly",
              "amount": 250,
              "unit": "g",
              "prepNote": "cut into 3cm pieces",
