      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Beat the eggs in a large bowl until the yolks and whites are fully combined. Add the turmeric and a pinch of black pepper. Stir briefly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chopped parsley, coriander, fenugreek leaves, spring onion, walnuts and barberries to the egg mixture. Stir everything together until completely combined. The mixture should be far more green than yellow."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in the frying pan over medium heat. Pour in the herb and egg mixture. Spread it out evenly with a spatula. Cook over medium-low heat for 8 minutes until the edges are fully set and the top has lost most of its rawness."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "To flip: place a large flat plate over the pan. Invert the kuku onto the plate, then slide it back into the pan, browned side up. Alternatively, place under a medium grill for 3 to 4 minutes to set the top without flipping."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook for a further 5 minutes until the second side is golden and the centre is firm. Slide onto a board and cut into wedges. Serve warm or at room temperature with yoghurt and flatbread."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Kuku stuck when flipping",
              "solution": "Make sure the edges are fully cooked and have pulled away from the pan before attempting the flip. Use a non-stick pan and ensure it is well oiled before adding the mixture."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Centre is raw but edges are brown",
              "solution": "The heat is too high. Lower it and cover the pan with a lid for the final 3 to 4 minutes to allow steam to cook the centre through."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Kuku tastes bland",
              "solution": "Season the egg mixture generously before cooking. The large quantity of herbs dilutes seasoning. Fenugreek leaves add bitterness; ensure they are included as they carry much of the flavour."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kuku Sabzi is the Nowruz dish. It is eaten at the Persian New Year table every March as a symbol of spring and renewal. The green colour represents the new season. It is also a common everyday lunch across Iran, made quickly and eaten cold from the fridge. Outside Iran it is becoming well known as a naturally gluten-free protein-rich dish."
          }
        ]
      }
    ]
  }
