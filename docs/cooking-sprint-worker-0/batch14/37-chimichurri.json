    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "chimichurri"
                }
              }
            ],
            "text": "Chimichurri"
          },
          {
            "type": "text",
            "text": " is made by hand rather than in a blender. Chopping the parsley by knife and then pounding the garlic in a pestle and mortar gives a rougher, more textured sauce that has better body and doesn't turn bitter from a machine's heat."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use only the parsley leaves, not the stems. The stems are too bitter here. Flat-leaf parsley is much more flavourful than curly parsley for this recipe."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
