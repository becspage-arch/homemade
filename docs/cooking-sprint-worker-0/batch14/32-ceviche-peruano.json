  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Peruvian ceviche marinates the fish in lime juice for only 15 minutes, leaving the centre semi-translucent and silky. The sharp, intensely flavoured liquid left in the bowl is called "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "leche-de-tigre"
                }
              }
            ],
            "text": "Leche de Tigre "
          },
          {
            "type": "text",
            "text": ". It is drunk from a shot glass in Peru. Do not waste it."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use the freshest fish you can find. Sea bass is ideal. Ask your fishmonger for sashimi-grade if available."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "sea-bass",
              "amount": 500,
              "unit": "g",
              "prepNote": "skinless fillets, cut into 2 cm cubes",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "lime",
              "amount": 6,
              "unit": "whole",
              "prepNote": "juice only",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "lemon",
              "amount": 1,
              "unit": "whole",
              "prepNote": "juice only",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "chilli-red",
              "amount": 1,
              "unit": "whole",
              "prepNote": "deseeded, finely sliced",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "onion",
              "amount": 1,
              "unit": "large",
              "prepNote": "red onion, very thinly sliced into half-moons",
              "isOptional": false,
              "groupLabel": null
            },
