  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This is "
          },
          {
            "type": "text",
            "text": "fesenjan ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fesenjan"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", one of the great Persian khoresh dishes. Ground walnuts are toasted and simmered with "
          },
          {
            "type": "text",
            "text": "pomegranate molasses",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "pomegranate-molasses"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " until the sauce becomes thick, dark and intensely flavoured. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The balance of sweet to sour is personal. Taste the sauce at the 45-minute mark and adjust with more molasses or a pinch of sugar. Every Iranian cook has their own preferred ratio."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
