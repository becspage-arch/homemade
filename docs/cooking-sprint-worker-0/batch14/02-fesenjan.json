      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toast the walnuts in a dry frying pan over medium heat for 3 to 4 minutes, stirring constantly, until lightly golden and fragrant. Leave to cool completely. Blitz in the food processor until very finely ground, like coarse sand."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in the dutch oven over medium-high heat. Season the chicken and brown on all sides, about 4 minutes per side. Remove and set aside. Drain excess fat, leaving about 1 tablespoon in the pot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onions in the same pot over medium heat for 12 minutes until soft and golden. Add the turmeric and cinnamon, stir for 1 minute. Add the ground walnuts and stir for 2 minutes until they smell nutty."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the stock and stir until combined. Add the pomegranate molasses and saffron water. Bring to a gentle simmer, then nestle the browned chicken pieces into the sauce. The sauce should come halfway up the chicken."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and simmer on very low heat for 60 minutes, turning chicken once halfway through. Remove the lid and cook for a further 20 minutes to thicken the sauce. Taste and balance sweet and sour with sugar or more molasses. Serve over rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Sauce is grainy or lumpy",
              "solution": "The walnuts need to be ground very finely. If the sauce feels grainy, use a stick blender to smooth it out before adding the chicken."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Sauce is too sour",
              "solution": "Add caster sugar a teaspoon at a time, stirring and tasting after each addition. A small amount changes the balance significantly."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Sauce is too thin after an hour",
              "solution": "Remove the lid and increase heat to a steady simmer for 15 to 20 minutes. The walnut oils thicken the sauce as moisture evaporates."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fesenjan comes from the Caspian coastal region of Iran, where walnuts and pomegranates both grow abundantly. It is a celebration dish, often served at weddings and Nowruz feasts. Duck is the traditional meat in older recipes. Chicken became common in the twentieth century as the dish spread across Iran. The dark, almost purple sauce is unlike anything else in Persian cooking."
          }
        ]
      }
    ]
  }
