      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 2 tablespoons of oil in the dutch oven over medium-high heat. Brown the lamb in batches, turning to colour all sides. Remove and set aside. Do not crowd the pan or the meat will steam rather than brown."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the remaining oil to the same pot. Fry the onions over medium heat for 15 minutes until deeply golden. Add the turmeric and stir for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a separate frying pan, heat 1 tablespoon of oil and fry the parsley, coriander and fenugreek leaves over medium-high heat. Stir continuously for 10 to 12 minutes until the herbs are very dark green, almost black, and completely dry. This step is essential."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the lamb to the pot with the onions. Add the fried herbs, kidney beans, lemon juice, dried chilli and stock. Stir to combine. Bring to a boil then reduce to a very low simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and cook for 2 hours, stirring every 30 minutes. The stew should thicken to a dark, almost glossy consistency. Taste and adjust with more lemon juice if needed. Serve over plain white rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Stew tastes bitter",
              "solution": "The herbs may have been under-fried. They need to be very dark and completely dry. A small amount of bitterness mellows over time, so cook for longer before adjusting."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Lamb is still tough after 2 hours",
              "solution": "Lamb shoulder needs low, consistent heat. Turn the heat down further and cook for another 30 to 45 minutes. The meat should pull apart easily when done."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Stew is too watery",
              "solution": "Remove the lid for the final 20 minutes of cooking and increase heat slightly. This allows excess liquid to evaporate and the stew to thicken."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ghormeh Sabzi is served at celebrations and family gatherings across Iran. It appears at Nowruz, the Persian New Year, held in March. Every family has its own herb ratio. Some add dried limes for extra tartness. The dish is older than written record and has changed very little over centuries."
          }
        ]
      }
    ]
  }
