      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the butter in a medium saucepan over medium heat. Add the grated onion and cook for 10 minutes, stirring regularly, until the onion is very soft and just starting to colour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic, ginger, chilli flakes, paprika, cumin and turmeric. Stir for 2 minutes over medium heat until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the water and bring to a gentle simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slowly whisk in the chickpea flour a little at a time to avoid lumps. Stir continuously as you add it."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer over low heat for 8 minutes, stirring often, until the stew is thick and smooth. Add more water if it becomes too stiff. Serve hot over injera."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Lumps forming when adding the chickpea flour"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Sieve the flour first and add it in a slow, steady stream while whisking constantly. If lumps form, push the stew through a sieve and return to the pan."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Stew is too thick to pour"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add hot water a little at a time and stir over low heat. Shiro should pour slowly off a spoon, similar to thick porridge."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Raw flour taste remains"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer for longer. Chickpea flour needs at least 8 minutes of cooking to lose its raw taste. Keep the heat low and stir to prevent it sticking to the base."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Shiro Wat is eaten across Ethiopia and Eritrea. It appears on fasting days when meat is forbidden. Street vendors sell it from large clay pots over charcoal. It is one of the most affordable and widespread foods in the country. Chickpeas have been grown in Ethiopia for centuries."
          }
        ]
      }
    ]
  }
