      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rinse the rice in cold water until the water runs clear. Drain well for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the dashi, soy sauce, mirin and sake in a medium saucepan. Add the rice and stir once to distribute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange the mushrooms, carrot, bamboo shoots and chicken pieces on top of the rice in a single layer. Do not stir."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover with a tight-fitting lid. Bring to a boil over medium-high heat. As soon as you hear it boiling, reduce the heat to very low and cook for 12 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Turn the heat off and leave to steam, lid on, for 10 minutes. Fluff gently with a rice paddle or spatula from the bottom up, mixing in the toppings. Scatter with spring onion and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rice is mushy on top and crunchy at the bottom",
              "cause": "Heat was uneven or the lid was lifted during cooking",
              "fix": "Use the lowest possible heat setting after reducing. Never lift the lid until the full resting time is done."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rice is too salty",
              "cause": "Soy sauce amount was too high for the volume of rice",
              "fix": "Scale the soy sauce down to 2 tbsp and use more plain dashi to make up the liquid volume."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rice sticks to the bottom of the pan",
              "cause": "Heat was not reduced quickly enough after coming to the boil",
              "fix": "Turn the heat to its absolute lowest the moment you hear the boil. A heat diffuser helps on gas hobs."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Takikomi gohan is a dish of the Japanese seasons. Autumn versions use chestnuts and mushrooms. Spring brings bamboo shoots and peas. It is considered everyday home cooking across the country. The one-pot method produces a full meal with almost no hands-on time. Japanese families serve it alongside miso soup and simple pickles."
          }
        ]
      }
    ]
  }
