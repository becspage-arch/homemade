  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "In "
          },
          {
            "type": "text",
            "text": "takikomi gohan ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "takikomi-gohan"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", rice cooks in seasoned "
          },
          {
            "type": "text",
            "text": "dashi",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dashi"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " instead of plain water, giving every grain of rice the flavour of the broth. The toppings are laid on top of the uncooked rice and steam alongside it. Nothing is fried or pre-cooked. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Do not stir the rice during cooking. Let the toppings sit on the surface undisturbed so the steam cooks them evenly."
          }
        ]
      },
