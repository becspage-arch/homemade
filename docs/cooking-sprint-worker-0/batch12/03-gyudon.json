      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the dashi, soy sauce, mirin, sake and sugar in a wide frying pan. Bring to a simmer over medium heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the sliced onion and cook for 5 to 7 minutes until very soft and translucent."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the beef slices to the pan, separating them as you go. Simmer for 2 to 3 minutes until the beef is just cooked through. Skim any foam from the surface."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon the hot rice into bowls. Ladle the beef, onion and broth over the top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Top with spring onion and sesame seeds if using. Serve straight away."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Beef is chewy and tough",
              "cause": "Beef was sliced too thick or cooked too long",
              "fix": "Slice as thin as possible and cook only 2 to 3 minutes. Thin slices cook almost instantly."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth is too thin and watery",
              "cause": "Onion released too much water before the broth reduced",
              "fix": "Simmer the broth for 2 extra minutes after the beef is cooked to concentrate it."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dish tastes flat without enough depth",
              "cause": "Dashi was skipped or a poor quality one was used",
              "fix": "Use a good dashi. Even dashi powder in water is far better than plain water."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Gyudon is Japan's go-to fast meal. Chains like Yoshinoya and Matsuya serve it around the clock. Home cooks love it because the whole dish is ready in 20 minutes. The sweet-savoury broth soaks into the rice underneath. It is a very easy entry point into Japanese rice bowl cooking."
          }
        ]
      }
    ]
  }
