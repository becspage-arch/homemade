      "slug": "takoyaki-pan",
      "term": "Takoyaki pan",
      "definition": "A cast-iron or non-stick pan with round hemispherical moulds used to cook takoyaki balls. Each mould is about 4 cm in diameter."
    },
    {
      "slug": "tenkasu",
      "term": "Tenkasu",
      "definition": "Crispy tempura batter scraps stirred into takoyaki batter to add texture and a light crunch inside the balls."
    }
