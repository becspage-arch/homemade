      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk together the flour, dashi, eggs, and soy sauce in a large jug until smooth with no lumps. The batter should be thin and pourable."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the takoyaki pan over medium-high heat. Brush each cavity generously with oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the batter into each cavity until it overflows slightly. Drop one cube of octopus, a pinch of spring onion, and a little ginger into each cavity."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook for 2 to 3 minutes until the edges are set. Use a skewer or chopstick to rotate each ball a quarter turn, folding the raw top batter inward. Continue rotating every minute until a complete golden sphere forms, about 6 to 8 minutes total."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to a plate. Mix soy sauce and mirin as a quick sauce and drizzle over. Top with bonito flakes and shredded nori. Eat while hot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Balls are not round, they have a flat side",
              "cause": "The batter was not rotated frequently enough while cooking.",
              "fix": "Rotate each ball every 30 to 60 seconds once the outer shell has set."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Batter is sticking in the pan",
              "cause": "Not enough oil was used to coat the cavities.",
              "fix": "Brush oil generously before each batch and reheat the pan before pouring in the batter."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Inside is still liquid after the outside is golden",
              "cause": "The heat is too high and the outside is cooking too fast.",
              "fix": "Reduce heat to medium and allow more time for the inside to cook through."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Takoyaki is Osaka street food at its most playful. Stalls set up their griddles at festivals and serve the balls in cardboard trays with toppings. The skill of spinning the balls in the pan looks effortless when an expert does it. At home, the first batch is always a bit rough. By the third batch, you have the rhythm."
          }
        ]
      }
    ]
  }
