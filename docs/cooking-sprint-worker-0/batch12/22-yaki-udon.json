      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the soy sauce, mirin, sake, and sesame oil in a small bowl. Rinse the udon noodles in hot water, then drain well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the wok over the highest heat until smoking. Add the oil, then the pork belly. Cook for 2 minutes, stirring, until the pork is golden and cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the carrot, shiitake mushrooms, and cabbage. Stir-fry for 2 minutes until slightly softened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained udon noodles to the wok. Use tongs to toss them with the pork and vegetables for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the sauce over everything. Toss for 1 minute over high heat until the noodles are glossy and coated. Add the spring onion, toss once, and divide between bowls. Scatter over bonito flakes if using."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Noodles are sticking and tearing",
              "cause": "The noodles were not loosened before adding to the hot wok.",
              "fix": "Always rinse vacuum-packed udon in hot water and shake off excess before they go into the wok."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Vegetables are soggy",
              "cause": "Too much moisture in the wok from undrained noodles or crowded vegetables.",
              "fix": "Drain the noodles thoroughly and stir-fry vegetables in batches if your wok is small."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce is too salty",
              "cause": "Light soy sauce varies in saltiness between brands.",
              "fix": "Add the sauce in stages, tasting as you go, and finish with a few drops of mirin to balance."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Yaki udon was born out of post-war scarcity in Fukuoka. Soba noodles ran out and a cook used udon instead. The thick noodles worked so well that the dish stuck. Today it is a home-cooking staple across Japan. It takes less than 15 minutes and uses whatever is in the fridge."
          }
        ]
      }
    ]
  }
