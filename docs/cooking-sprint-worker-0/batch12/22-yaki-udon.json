    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Yaki udon uses pre-cooked "
          },
          {
            "type": "text",
            "text": "udon",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "udon"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " noodles stir-fried with pork belly, cabbage, and "
          },
          {
            "type": "text",
            "text": "shiitake",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "shiitake"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " mushrooms over high heat. The thick noodles hold their bite and absorb the sauce beautifully. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fresh vacuum-packed udon noodles work best here and need no pre-boiling, just a quick rinse in hot water to separate them before they go into the wok."
          }
        ]
      },
