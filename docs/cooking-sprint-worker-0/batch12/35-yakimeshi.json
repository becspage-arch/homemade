      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the wok over the highest heat until smoking. Add 2 tablespoons of oil. If using pork belly, add it now and fry for 2 minutes until crisp."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cold rice to the wok. Break up any clumps with a spatula. Stir-fry for 2 minutes until the grains are separate and starting to toast."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Push the rice to the side. Add the remaining tablespoon of oil. Pour in the beaten eggs. Let them set for 10 seconds, then scramble quickly. Toss the egg through the rice before it fully sets."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the sake and soy sauce. Toss vigorously for 1 minute until everything is evenly coated and slightly golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the spring onion and bean sprouts. Toss for 30 seconds. Drizzle over the sesame oil, toss once more, and serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rice is sticky and clumping",
              "cause": "The rice was not cold enough or was not separated before going in the wok.",
              "fix": "Spread rice on a tray and freeze for 20 minutes if you only have freshly cooked rice. Press it apart with dry hands before frying."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Egg is overcooked and rubbery",
              "cause": "The eggs were scrambled fully before mixing with the rice.",
              "fix": "Add eggs to the hottest part of the wok and fold them into the rice while still slightly wet."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Fried rice is steaming rather than frying",
              "cause": "Too much moisture in the pan or the wok was not hot enough.",
              "fix": "Preheat the wok until a drop of water explodes on contact, and cook in small batches."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Yakimeshi is Japan's answer to the universal question of what to do with leftover rice. Chinese stir-fry technique merged with Japanese seasoning to create a dish that is entirely its own. Ramen shops serve it as a side. Convenience stores sell cold versions. Home cooks make it without a recipe. It is the kind of dish that improves with practice and a hotter hob."
          }
        ]
      }
    ]
  }
}
