      "term": "Chahan",
      "definition": "The Japanese-Chinese term for fried rice (Chinese: chao fan), often used interchangeably with yakimeshi. Both refer to Japanese-style stir-fried rice dishes."
    },
    {
      "slug": "wok-frying",
      "term": "Wok frying",
      "definition": "The technique of cooking over very high heat in a wok, tossing ingredients constantly to prevent steaming and to build a lightly charred, smoky flavour."
    }
  ],
