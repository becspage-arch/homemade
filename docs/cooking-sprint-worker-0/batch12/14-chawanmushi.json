  "glossaryTerms": [
    {
      "slug": "chawanmushi",
      "term": "Chawanmushi",
      "definition": "A Japanese steamed savoury egg custard cooked in small cups. The ratio of egg to dashi determines the texture: too much egg makes it rubbery, too little and it will not set."
    },
    {
      "slug": "dashi",
      "term": "Dashi",
      "definition": "Japanese stock made from kombu and bonito flakes. It provides the savoury depth in the custard. The ratio for chawanmushi is roughly 3 parts dashi to 1 part egg by volume."
    },
    {
      "slug": "kaiseki",
      "term": "Kaiseki",
      "definition": "A traditional Japanese multi-course meal of highly refined seasonal dishes. Chawanmushi often appears as one of the savoury courses."
    }
  ],
