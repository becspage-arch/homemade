  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Oyakodon is the classic Japanese "
          },
          {
            "type": "text",
            "text": "donburi",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "donburi"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " that comes together in one pan. Chicken thigh and onion simmer briefly in a "
          },
          {
            "type": "text",
            "text": "dashi",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dashi"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and soy broth before beaten eggs are poured in and cooked until just set. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The eggs should be slightly underdone when you take the pan off the heat. They will carry over cook as you spoon the mixture over hot rice."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "short-grain-rice",
              "amount": 400,
              "unit": "g",
              "prepNote": "cooked",
              "isOptional": false,
              "groupLabel": "To serve"
            },
            {
