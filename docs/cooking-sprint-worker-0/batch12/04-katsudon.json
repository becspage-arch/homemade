      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Coat each pork chop in flour, then dip in beaten egg, then press into panko breadcrumbs on both sides. Set aside on a plate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a deep frying pan to 180C. Fry the cutlets for 3 to 4 minutes per side until deep golden and cooked through. Drain on a rack and slice into strips."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a separate frying pan, combine the dashi, soy sauce, mirin and sugar. Bring to a simmer. Add the onion and cook for 4 minutes until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lay the sliced cutlet in the broth. Pour the lightly beaten egg evenly over the top. Cover and cook for 1 minute until the egg is just set."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon rice into bowls. Slide the cutlet and egg mixture over the rice, spooning extra broth around the sides. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Coating falls off in the oil",
              "cause": "Flour was not pressed firmly or the egg coating was too thick",
              "fix": "Press the flour firmly into the pork before dipping. Shake off excess egg before pressing into panko."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Panko coating is greasy",
              "cause": "Oil was not hot enough when the cutlet went in",
              "fix": "Check the oil is at 180C before frying. Use a thermometer or test with a pinch of panko."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Egg in the bowl is rubbery",
              "cause": "Egg was overcooked in the broth",
              "fix": "Pour the egg over and cover for no more than 1 minute. The egg should still look slightly wet."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Katsudon is a comfort food icon in Japan. Students eat it before exams for luck, as the word 'katsu' sounds like the Japanese word for 'to win'. It is served in tonkatsu restaurants and home kitchens alike. The dish turns a simple fried cutlet into a full one-bowl meal. It is the kind of food that feels like a reward."
          }
        ]
      }
    ]
  }
