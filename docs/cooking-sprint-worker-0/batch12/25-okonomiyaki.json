      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk the flour, dashi, and eggs together in a large bowl until smooth. Stir in the grated potato if using. Fold in the shredded cabbage and spring onion. The batter will be very thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a tablespoon of oil in a 26 cm frying pan over medium-high heat. Spoon in half the batter and spread to a round about 2 cm thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lay half the pork belly strips across the top of the batter. Cook for 5 minutes until the base is deep golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Flip carefully using a wide spatula. Cook for another 5 minutes until the pork is golden and caramelised and the pancake is cooked through. Keep warm while you cook the second pancake."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the soy sauce and mirin for a quick okonomi sauce. Drizzle over the pancakes in a zigzag pattern. Top with bonito flakes and shredded nori. Serve cut into wedges."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pancake falls apart when flipping",
              "cause": "The base was not cooked long enough or the batter was too wet.",
              "fix": "Wait until the edges look set and the base releases cleanly from the pan before attempting to flip."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Inside is raw after the outside is browned",
              "cause": "The heat was too high and the pancake is too thick.",
              "fix": "Reduce heat to medium and cover with a lid for the last 3 minutes to steam the inside through."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Batter is too runny",
              "cause": "The cabbage released water into the batter as it sat.",
              "fix": "Add a tablespoon of flour and mix through to tighten the batter before cooking."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Okonomiyaki is Osaka's most beloved street food and home-cooked comfort dish. The name translates loosely as 'cook what you like.' Hiroshima has its own version where the layers are stacked rather than mixed. Both cities argue about which one is better. Home cooks keep it simple with pork, cabbage, and whatever is in the fridge."
          }
        ]
      }
    ]
  }
