  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Okonomiyaki uses a thick "
          },
          {
            "type": "text",
            "text": "okonomiyaki batter",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "okonomiyaki-batter"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " mixed with loads of shredded cabbage and topped with thin pork belly slices before being fried on both sides until cooked through. "
          },
          {
            "type": "text",
            "text": "Nagaimo",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nagaimo"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " adds lift to the batter; grated potato works well as a substitute. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cook one pancake at a time so you can flip it cleanly with a wide spatula. The outside should be deep golden and the inside cooked through but still moist."
          }
        ]
      },
      {
