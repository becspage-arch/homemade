      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the soy sauce, mirin, and sesame oil in a small bowl and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the wok over the highest heat until smoking. Add the vegetable oil, then add the pork belly slices. Stir-fry for 2 minutes until browned."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the carrot and cabbage. Toss constantly for 2 minutes until just softened at the edges but still with some crunch."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the pre-cooked yakisoba noodles directly to the wok. Use tongs to loosen and toss them through the pork and vegetables for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the sauce over the noodles. Toss for 1 minute until everything is coated and smells slightly smoky. Add the spring onion and bean sprouts, toss once more, and serve immediately topped with bonito flakes and nori."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Noodles are clumping together",
              "cause": "The noodles went in cold and the wok lost heat.",
              "fix": "Rinse pre-cooked noodles in hot water just before adding them so they separate easily."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dish is watery",
              "cause": "Too many vegetables released liquid at once.",
              "fix": "Cook the cabbage and carrot in a single layer first so moisture evaporates before you add the noodles."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "No charred flavour",
              "cause": "The wok was not hot enough before adding ingredients.",
              "fix": "Preheat the wok until a drop of water evaporates in under a second, then add the oil."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Yakisoba is the smell of Japanese summer festivals. Iron griddles line the stalls and cooks work fast with two spatulas. The noodles are wheat-based, not buckwheat, despite the name. Every region has its own sauce tweaks. It is sold at convenience stores cold, but it is best eaten hot off the wok."
          }
        ]
      }
    ]
  }
