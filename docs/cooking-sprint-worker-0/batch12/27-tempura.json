    {
      "slug": "tempura-batter",
      "term": "Tempura batter",
      "definition": "A thin, ice-cold batter made from cold water, egg yolk, and plain flour with minimal mixing. Lumps are intentional and create the characteristic lacey texture when fried."
    },
    {
      "slug": "tentsuyu",
      "term": "Tentsuyu",
      "definition": "The dipping sauce served with tempura, made from dashi, soy sauce, and mirin, often with grated daikon on the side."
    }
  ],
