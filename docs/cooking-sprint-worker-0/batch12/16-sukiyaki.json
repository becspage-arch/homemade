      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the soy sauce, mirin, sake, sugar and water in a small jug. Stir until the sugar dissolves. This is your warishita sauce."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange all the beef slices, tofu, mushrooms, leek, spring onion and cabbage on a large plate for the table."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a cast iron skillet or shallow pot over medium-high heat at the table or on the hob. Pour in half the warishita sauce."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add vegetables and tofu to the pan. Lay a few beef slices on top. Simmer for 3 to 4 minutes until the beef is just cooked and the vegetables are tender. Each diner takes what they want."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Keep adding ingredients and warishita sauce as the pot empties. Each diner dips cooked pieces in their individual bowl of beaten raw egg before eating."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce becomes too thick and sticky",
              "cause": "The sugar in the warishita sauce reduced too much",
              "fix": "Add a splash of water and stir to loosen. Top up with extra dashi or water as the pot cooks."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Beef is tough and overcooked",
              "cause": "Sliced too thick or left in the pot too long",
              "fix": "Use wafer-thin slices and dip-and-take after just 1 to 2 minutes in the sauce."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce tastes too sweet",
              "cause": "Too much sugar was added",
              "fix": "Balance with more soy sauce and a splash of sake. The ratio should be savoury-forward with a round sweetness."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sukiyaki is Japanese celebration food, eaten at New Year and family gatherings. The table-cooking aspect makes it social and festive. Dipping cooked meat in raw egg sounds unusual but the egg tempers the heat and enriches each mouthful. Restaurant sukiyaki in Japan uses premium wagyu beef and the whole experience is ceremonial. Home sukiyaki is relaxed and communal."
          }
        ]
      }
    ]
  }
