  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sukiyaki is one of Japan's great "
          },
          {
            "type": "text",
            "text": "nabe",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nabe"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " hot pot dishes. The "
          },
          {
            "type": "text",
            "text": "warishita",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "warishita"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " sauce is poured into a hot cast iron pan and the vegetables and beef go in together. Each diner takes pieces from the pan and dips them in a small bowl of raw beaten egg before eating. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use the best thinly sliced beef you can find. Marbled beef melts in the mouth in a way that lean beef cannot match in this dish."
          }
        ]
      },
