      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the ponzu: mix rice vinegar and soy sauce in a small bowl. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine dashi, soy sauce, mirin, sake, and kombu in the Dutch oven. Bring to a simmer over medium heat on the hob. Remove the kombu just before it boils."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange all the prepared ingredients on a large platter or in small bowls around the table."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the pot in the centre of the table over a portable burner or trivet. Add the denser vegetables first: carrot, leek, and cabbage. Simmer for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Let everyone add tofu, mushrooms, spring onion, and chicken to the pot as they like. Lift out cooked ingredients with chopsticks and dip in ponzu before eating."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth becomes too salty as the meal goes on",
              "cause": "Evaporation concentrates the seasoning.",
              "fix": "Top up with plain dashi or water whenever the broth level drops below halfway."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Tofu is falling apart when lifted out",
              "cause": "Firm tofu was not used or it was cooked too long.",
              "fix": "Use firm tofu and lift it gently with a slotted spoon after just 2 to 3 minutes in the broth."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth is cloudy and murky",
              "cause": "Too many ingredients were added at once or the heat was too high.",
              "fix": "Keep the broth at a gentle simmer and skim any foam from the surface every few minutes."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nabe is how Japanese families eat together in winter. The pot sits in the centre of the table and everyone reaches in at their own pace. There are dozens of regional nabe styles across Japan. This simple version is the base that all of them grow from. The broth that is left at the end of the meal is often the best part."
          }
        ]
      }
    ]
  }
