  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Agedashi tofu requires good "
          },
          {
            "type": "text",
            "text": "dashi",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dashi"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and careful handling of the "
          },
          {
            "type": "text",
            "text": "silken tofu ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "silken-tofu"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". The tofu must be pressed dry before coating in "
          },
          {
            "type": "text",
            "text": "cornflour",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "cornflour"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " or the coating will slide off in the oil. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Press the silken tofu gently between two plates lined with kitchen paper for 15 minutes before frying. This is a critical step that should not be skipped."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
