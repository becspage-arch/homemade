      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Line a plate with two layers of kitchen paper. Place the tofu pieces on top and cover with more paper. Rest a second plate on top and leave for 15 minutes to press out moisture."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the dashi, soy sauce and mirin in a small saucepan. Warm over low heat until steaming. Do not boil. Keep warm."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a medium saucepan to 180C. Dust each tofu piece gently in cornflour, shaking off the excess very carefully."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lower the tofu into the oil using a slotted spoon. Fry for 2 to 3 minutes until the coating is lightly golden. Remove carefully and drain on a rack."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place two pieces of fried tofu in each shallow bowl. Pour the warm broth around the base. Top with spring onion, sesame seeds and chilli if using. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Coating slides off the tofu in the oil",
              "cause": "Tofu was not pressed dry enough before coating",
              "fix": "Press for a full 15 minutes with weight on top. Pat again with dry kitchen paper just before coating."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Tofu breaks apart when frying",
              "cause": "Silken tofu is very delicate and was handled roughly",
              "fix": "Use a wide slotted spoon to lower the tofu in. Do not move it once it is in the oil. Let it fry undisturbed."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Coating is thick and doughy",
              "cause": "Too much cornflour was used or not shaken off",
              "fix": "Coat lightly. Shake off all excess cornflour so only a thin dusting clings to the surface."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Agedashi tofu is one of the most ordered starters at izakaya restaurants across Japan. It showcases how Japanese cooking turns simple ingredients into something elegant. The dish requires care but not skill. Once you have pressed and fried the tofu a few times the process becomes very natural."
          }
        ]
      }
    ]
  }
