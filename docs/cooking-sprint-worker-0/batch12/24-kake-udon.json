              "amount": 1,
              "unit": "tsp",
              "prepNote": null,
              "isOptional": true,
              "groupLabel": "to serve"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring a large pot of water to the boil. Cook the udon noodles according to the packet, usually 2 to 3 minutes for fresh or 8 to 10 for dried. Drain in a colander."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the noodles cook, combine the dashi stock, soy sauce, and mirin in a medium saucepan. Heat over medium heat until just simmering. Taste and adjust the soy or mirin."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rinse the drained noodles briefly under hot water to remove surface starch, then divide between four deep bowls."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle the hot broth over the noodles, filling each bowl generously."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Top each bowl with sliced spring onion, nori strips, and sesame seeds. Serve immediately while the broth is steaming hot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth tastes flat",
              "cause": "The dashi was too weak or the seasoning was underpowered.",
              "fix": "Add soy sauce a teaspoon at a time until the broth has a clear, savoury backbone."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Noodles are bloated and soft",
              "cause": "They were left in the hot broth too long before serving.",
              "fix": "Serve immediately once the broth is poured. Udon swells fast in hot liquid."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth looks cloudy",
              "cause": "The dashi was boiled vigorously or bonito flakes were squeezed when straining.",
              "fix": "Keep dashi at a gentle simmer and let the flakes sink before straining without pressing."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kake udon is the starting point for all hot udon dishes in Japan. The broth colour changes as you move west toward Osaka and Kyoto. Eastern Japan uses a darker, saltier soy base while the west prefers a paler, lighter broth. At its simplest it is just noodles, broth, and spring onion. Everything else is a topping added on top of that idea."
          }
        ]
      }
    ]
  }
}
