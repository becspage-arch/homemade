  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kake udon is hot udon noodles served in a bowl of steaming "
          },
          {
            "type": "text",
            "text": "kake broth",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "kake-broth"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " made from "
          },
          {
            "type": "text",
            "text": "dashi ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dashi"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", soy sauce, and mirin. Toppings like sliced spring onion, tempura scraps, or a soft-poached egg are added at the table. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The broth is the whole point here. Taste it carefully before serving and adjust the seasoning so it is savoury and slightly sweet with a clean, sea-like finish from the dashi."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "chicken-stock",
