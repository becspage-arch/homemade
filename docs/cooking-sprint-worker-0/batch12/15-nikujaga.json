  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Unlike a Western stew, "
          },
          {
            "type": "text",
            "text": "nikujaga",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nikujaga"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " does not need long cooking. The broth is light, made from "
          },
          {
            "type": "text",
            "text": "dashi ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dashi"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", sweetened with mirin and mildly seasoned with soy sauce. The potatoes take about 20 minutes to cook through. Thinly sliced beef needs almost no cooking at all. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cut the potatoes into large chunks so they hold their shape rather than dissolving into the broth."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
