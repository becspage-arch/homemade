    {
      "slug": "nikujaga",
      "term": "Nikujaga",
      "definition": "A Japanese stew of meat and potato. The name combines 'niku' (meat) and 'jaga' (from jagaimo, potato). It is considered one of Japan's great comfort foods."
    }
