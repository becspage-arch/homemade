      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the tsuyu: combine dashi, soy sauce, and mirin in a small saucepan. Bring to a simmer, add the bonito flakes, and cook for 2 minutes. Strain through a sieve, cool, and refrigerate until cold."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the soba noodles in a large pot of unsalted boiling water according to the packet instructions, usually 4 to 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain through a colander and rinse under cold running water for 1 minute, rubbing the noodles gently to remove surface starch."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer the noodles to a bowl of iced water for 2 minutes to chill completely. Drain well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the noodles between plates or a bamboo tray. Serve with small bowls of cold tsuyu alongside sliced spring onion, nori strips, and sesame seeds for each person to add."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Noodles are soft and mushy",
              "cause": "They were overcooked or not rinsed fast enough after draining.",
              "fix": "Rinse under cold water the moment they are drained, and have the iced water ready before you start cooking."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Tsuyu is too strong",
              "cause": "The dashi-to-soy ratio is concentrated for dipping, not drinking.",
              "fix": "Dilute with a little cold water or extra dashi until it tastes right to you."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Noodles are clumping on the plate",
              "cause": "They were not drained well enough after the ice bath.",
              "fix": "Shake the colander firmly and pat dry with a clean tea towel before plating."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cold soba is summer food in Japan. The dish is ordered at soba shops where speed and simplicity are the whole point. Buckwheat gives the noodles a nutty, slightly mineral flavour that wheat cannot replicate. Eating them takes a certain rhythm: dip, lift, slurp. The slurping is expected."
          }
        ]
      }
    ]
  }
}
