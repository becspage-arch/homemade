  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sunomono uses "
          },
          {
            "type": "text",
            "text": "salting cucumber",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "salting-cucumber"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " to remove excess water so the dressing is not diluted. The cucumber is then dressed in "
          },
          {
            "type": "text",
            "text": "sanbaizu ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "sanbaizu"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", a simple three-part vinegar dressing that is sharp, sweet, and lightly savoury. Serves 4 as a side."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Squeeze every drop of water from the salted cucumber before dressing it. This is the step that makes the difference between a watery salad and a crisp, well-dressed one."
          }
        ]
      },
      {
        "type": "heading",
