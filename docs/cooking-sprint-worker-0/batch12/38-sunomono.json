      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slice the cucumbers into very thin rounds, about 2 mm thick, using a sharp knife or mandoline. Place in a colander and toss with a small pinch of seasoning. Leave to drain for 15 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer the cucumber to a clean tea towel and squeeze firmly to remove as much moisture as possible. Transfer to a bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk together the rice vinegar, mirin, soy sauce, sugar, and sesame oil in a small bowl until the sugar has dissolved."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the dressing over the cucumber. Add the grated ginger and cooked prawns if using. Toss gently to coat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Refrigerate for 15 to 30 minutes before serving. Divide into small individual dishes and scatter over sesame seeds."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Salad is watery",
              "cause": "The cucumber was not squeezed firmly enough after salting.",
              "fix": "Wrap the salted cucumber in a clean cloth and wring it as tightly as you can before adding the dressing."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dressing is too sharp",
              "cause": "The vinegar is overpowering the other flavours.",
              "fix": "Add an extra teaspoon of mirin or a small pinch of sugar to soften the acidity."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Cucumber slices are uneven and some are too thick",
              "cause": "The cucumber was sliced by hand without a guide.",
              "fix": "Use a mandoline set to 2 mm for even, paper-thin slices throughout."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sunomono appears at both ends of the Japanese dining spectrum. It is served as a small dish in formal kaiseki restaurants and made at home in minutes as a quick side. The vinegar-sweet-salty balance is fundamental to Japanese cooking. Prawns, crab, or wakame seaweed can be added depending on the season and what is available. The cucumber version is the one that never goes out of fashion."
          }
        ]
      }
    ]
  }
