      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring a small pot of water to the boil. Simmer the carrot and potato pieces for 5 minutes, then drain. This removes any bitterness and helps them hold their shape in the long braise."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the dashi, soy sauce, mirin, and sake in a large Dutch oven. Add the kombu if using. Bring to a gentle simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the carrot, potato, and tofu to the broth. Simmer uncovered over low heat for 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the hard-boiled eggs to the pot. Continue simmering for another 20 to 30 minutes until the vegetables are very tender and have taken on colour from the broth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste the broth and adjust seasoning. Serve in deep bowls with a ladle of broth. Offer miso paste on the side for dipping the ingredients."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Tofu is breaking apart in the pot",
              "cause": "The broth was boiling too vigorously.",
              "fix": "Keep oden at a bare simmer. The liquid should only occasionally bubble at the surface."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth tastes bland after an hour",
              "cause": "The simmering time diluted the seasoning.",
              "fix": "Add a tablespoon of soy sauce and taste again. The broth concentrates but also needs freshening."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Eggs are not absorbing the broth colour",
              "cause": "The eggs were added too late or the shell was left on too long after peeling.",
              "fix": "Score the peeled eggs lightly with a knife so the broth can penetrate, and simmer for at least 30 minutes."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Oden is Japan's winter street food and convenience store comfort dish. Every 7-Eleven in Japan sells it from October through March in a heated glass tank by the checkout. Each region uses different ingredients. Kanto-style uses a darker soy broth while Kansai keeps it light and pale. The dish is slow, patient cooking in a country that also invented instant noodles."
          }
        ]
      }
    ]
  }
