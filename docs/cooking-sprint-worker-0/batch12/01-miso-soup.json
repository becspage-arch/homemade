  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Miso soup is built on a quick "
          },
          {
            "type": "text",
            "text": "dashi",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dashi"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " broth that takes just minutes to make. You dissolve "
          },
          {
            "type": "text",
            "text": "miso",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "miso"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " paste into the warm stock off the heat so the paste stays alive and flavourful. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Never boil the soup after adding miso. Boiling kills the beneficial cultures and dulls the flavour."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "chicken-stock",
              "amount": 800,
              "unit": "ml",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "miso-white",
              "amount": 3,
              "unit": "tbsp",
              "prepNote": "white or mixed",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "tofu-silken",
              "amount": 150,
              "unit": "g",
              "prepNote": "cut into 1cm cubes",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "spring-onion",
              "amount": 2,
              "unit": null,
              "prepNote": "thinly sliced",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "nori",
              "amount": 1,
              "unit": "sheet",
              "prepNote": "cut into small strips",
              "isOptional": true,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the dashi stock into a medium saucepan and set over medium heat. Warm until just steaming but not boiling."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the silken tofu cubes and warm gently for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the pan from the heat. Place the miso paste in a small sieve or ladle, lower it into the broth and stir until fully dissolved. Do not return the pan to the heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle into bowls. Scatter spring onion slices over the top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add nori strips if using. Serve immediately while hot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Soup tastes flat",
              "cause": "Miso was boiled which kills its flavour compounds",
              "fix": "Add miso off the heat. Taste and stir in a little more miso if needed."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Tofu crumbles in the pot",
              "cause": "Silken tofu is fragile and breaks when stirred vigorously",
              "fix": "Add tofu gently and do not stir after adding. Just let it warm through."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Soup is too salty",
              "cause": "Miso paste varies in saltiness by brand and type",
              "fix": "Start with 2 tbsp, taste, and add more if needed. Red miso is saltier than white."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Miso soup appears at virtually every Japanese meal. It is eaten at breakfast alongside rice and pickles. It also bookends dinner on the Japanese table. The soup changes with the seasons and the cook's pantry. It is one of the simplest and most satisfying things to learn to make."
          }
        ]
      }
    ]
  }
}
