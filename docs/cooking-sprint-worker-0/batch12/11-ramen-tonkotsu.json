  "glossaryTerms": [
    {
      "slug": "tonkotsu",
      "term": "Tonkotsu",
      "definition": "A style of ramen broth made by boiling pork bones at a hard rolling boil for many hours. The vigorous boil emulsifies the fat and collagen to create a thick, milky white soup."
    },
    {
      "slug": "tare",
      "term": "Tare",
      "definition": "A concentrated seasoning sauce added to ramen broth at the point of serving. It provides the salt and depth that the mild tonkotsu broth needs."
    },
    {
      "slug": "chashu",
      "term": "Chashu",
      "definition": "Braised pork belly rolled and tied, then sliced to top ramen bowls. The same pork belly cooked in the broth can be sliced as chashu."
    }
  ],
