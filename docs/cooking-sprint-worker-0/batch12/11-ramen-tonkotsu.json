      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the pork belly in a stockpot with the garlic, ginger and spring onion. Cover with the water. Bring to a hard rolling boil over high heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Maintain a hard boil, not just a simmer, for 3 hours. Top up with boiling water as needed to keep the pork submerged. The broth should look milky and white after about 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the pork belly and set aside. Strain the broth through a colander into a clean pot, discarding the solids. You should have about 1.2 litres."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the tare ingredients together. Taste and adjust. Cook ramen or egg noodles according to the packet. Slice the cooked pork belly into 1cm rounds. Halve the soft-boiled eggs."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon 1 to 2 tbsp tare into each bowl. Ladle in the hot broth. Add the noodles, pork slices and egg. Top with spring onion, sesame seeds and nori if using. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth is clear not milky",
              "cause": "The boil was too gentle. Only a hard rolling boil emulsifies the fat.",
              "fix": "Keep the heat on high for the full 3 hours. A simmer will never produce the characteristic milky tonkotsu broth."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth tastes bland",
              "cause": "Tare was under-seasoned or not enough was added to the bowl",
              "fix": "Add tare 1 tbsp at a time and taste. The broth itself is mild; the tare is where the salt and depth come from."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pork is dry and stringy after 3 hours",
              "cause": "Pork belly was too lean or the water level dropped and the pork was exposed",
              "fix": "Use a fatty piece of pork belly. Keep the pork fully submerged throughout the cooking time."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tonkotsu ramen comes from Fukuoka in southern Japan. The city is famous for its tiny ramen counters where bowls are served fast and refills of noodles are expected. Home cooks rarely make it because of the time involved, but it is very achievable over a weekend. The leftover broth freezes perfectly. You do the hard work once and eat ramen for weeks."
          }
        ]
      }
    ]
  }
}
