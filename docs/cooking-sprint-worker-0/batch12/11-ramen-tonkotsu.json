    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Authentic "
          },
          {
            "type": "text",
            "text": "tonkotsu",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tonkotsu"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " broth requires a full rolling boil for at least 3 hours. This home version uses pork belly instead of bones to get a rich, gelatinous broth that is achievable without specialist ingredients. The "
          },
          {
            "type": "text",
            "text": "tare",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tare"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " is added separately to each bowl so everyone can season to taste. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The pork belly that simmered in the broth becomes "
          },
          {
            "type": "text",
            "text": "chashu ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "chashu"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ": slice it and lay it on top of each bowl. Nothing is wasted."
          }
        ]
      },
