      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt butter and oil together in a large heavy pan over medium-low heat. Add onions and a pinch of salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the onions slowly, stirring every 5 minutes, for 45-60 minutes until deep amber brown. Do not raise the heat to speed this up."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic, thyme, and bay leaf. Cook 2 minutes more."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the wine, let it bubble and reduce by half, about 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add stock, bring to a simmer, and cook gently for 20 minutes. Season well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toast the baguette slices under the grill until golden on both sides."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle soup into oven-proof bowls. Float 2 croutons on each. Pile Gruyere generously on top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place under a hot grill for 3-5 minutes until cheese is bubbling and starting to brown. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Onions are still pale after 30 minutes",
              "cause": "Heat too low or pan too small for the volume",
              "fix": "Raise to medium and stir more frequently, spreading onions in a wider pan if possible"
            },
            {
              "symptom": "Soup tastes bitter",
              "cause": "Onions caught and burned on the bottom",
              "fix": "Add a splash of water to deglaze burned patches and reduce heat immediately"
            },
            {
              "symptom": "Cheese falls off the crouton into the soup",
              "cause": "Crouton not stiff enough or cheese piled too high",
              "fix": "Toast bread more firmly first and press cheese down lightly before grilling"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "French onion soup has been a staple of Paris markets and brasseries for centuries. It was originally a cheap workers' dish made from surplus onions and day-old bread. The Gruyere-topped version became iconic in the 19th-century Parisian brasserie scene. Today it appears on menus worldwide as a benchmark of French bistro cooking."
          }
        ]
      }
    ]
  }
