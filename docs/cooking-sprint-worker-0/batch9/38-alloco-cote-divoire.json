              "amount": 2,
              "unit": "tbsp",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": "Sauce"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the sauce: heat 2 tablespoons oil in a small pan. Fry onion for 5 minutes. Add tomatoes and chilli, cook for 10-15 minutes until thick. Season with salt. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the frying oil in a deep saucepan to 180C, or until a piece of plantain sizzles immediately and rises to the surface."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Working in batches, lower the plantain slices into the hot oil. Do not crowd the pan."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry for 3-4 minutes until deep golden on the underside. Turn with tongs and fry another 2-3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain on kitchen paper. Season with a tiny pinch of salt. Serve immediately with the tomato sauce on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Plantain is soggy and greasy",
              "cause": "Oil temperature too low when plantain went in",
              "fix": "Test with a small piece first and wait for oil to recover between batches"
            },
            {
              "symptom": "Plantain burns on the outside before cooking through",
              "cause": "Oil too hot or slices too thick",
              "fix": "Cut slices no thicker than 1.5cm and maintain oil at 180C"
            },
            {
              "symptom": "Sauce is very watery",
              "cause": "Tomatoes not cooked down enough",
              "fix": "Cook the sauce for the full 15 minutes until it looks thick and jammy before removing from heat"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Alloco is the defining street food of Cote d'Ivoire and is sold at roadside stalls called allocodromes throughout Abidjan and across the country. Vendors fry plantain over charcoal in large pans and serve it in paper bags with the sauce spooned over or on the side. It is often eaten alongside grilled fish or with fried eggs. Alloco is also widely eaten in Burkina Faso and neighbouring countries under the same name."
          }
        ]
      }
    ]
  }
}
