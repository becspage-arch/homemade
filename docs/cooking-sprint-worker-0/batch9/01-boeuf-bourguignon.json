      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat your oven to 160C. Pat the beef dry, season with salt and pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil in the dutch oven over high heat. Brown the beef in batches, 2-3 minutes per side. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the lardons in the same pot until golden. Add onion and carrot, cook 5 minutes until softened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the garlic and tomato puree. Cook 1 minute. Scatter over the flour and stir to coat everything."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the wine and stock. Stir well to lift any browned bits from the bottom. Return the beef and add thyme and bay leaves."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a simmer, cover, and transfer to the oven. Cook for 2 hours until the beef is very tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "30 minutes before the end, fry the shallots and mushrooms in butter until golden. Stir into the pot for the last 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove bay leaves and thyme. Taste for seasoning. Rest 10 minutes before serving with crusty bread or mashed potato."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Sauce is thin and watery",
              "cause": "Not enough flour or lid left ajar letting steam escape",
              "fix": "Remove lid for last 30 minutes to reduce, or stir in a teaspoon of cornflour mixed with cold water"
            },
            {
              "symptom": "Beef is still tough after 2 hours",
              "cause": "Braising temperature too low or beef cut was too lean",
              "fix": "Return to oven for another 30-45 minutes checking every 15 minutes"
            },
            {
              "symptom": "Sauce tastes harsh and acidic",
              "cause": "Wine was not cooked long enough or is too tannic",
              "fix": "Add a pinch of sugar and continue cooking another 20 minutes uncovered"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Boeuf bourguignon comes from the Burgundy region of eastern France, where both the beef and the wine are prized. It started as a way to make tough, working cuts tender through long slow cooking. Today it is one of the most celebrated dishes in French home cooking. It tastes even better reheated the next day when the flavours have had time to settle."
          }
        ]
      }
    ]
  }
