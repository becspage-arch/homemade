      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 2 tablespoons of oil in a large heavy pan over medium heat. Add the aubergine with a pinch of salt and cook for 10 minutes, stirring occasionally, until golden. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the remaining oil and cook the courgette for 5 minutes until lightly coloured. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In the same pan, cook the onion over medium-low heat for 8 minutes until soft. Add the peppers and cook another 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and cook for 2 minutes. Add the tomatoes, thyme, and bay leaves."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the aubergine and courgette to the pan. Stir everything together gently."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce heat to low, cover partially, and cook for 20 minutes until the vegetables are tender and the liquid has reduced."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove bay leaves and thyme. Season well. Scatter with parsley and serve warm or at room temperature."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Vegetables are watery and stewed rather than silky",
              "cause": "Too much heat or pan too crowded",
              "fix": "Cook in a wider pan in batches and keep the heat at medium-low throughout"
            },
            {
              "symptom": "Aubergine is bitter",
              "cause": "Not cooked long enough in the first stage",
              "fix": "Give aubergine a full 10 minutes in the oil before adding anything else"
            },
            {
              "symptom": "Dish tastes flat and mild",
              "cause": "Not enough seasoning or garlic cooked too briefly",
              "fix": "Season generously at the end and add a small drizzle of good olive oil before serving"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ratatouille is the hallmark vegetable dish of Provence in the south of France. It was originally a peasant stew made from summer surplus vegetables. The name comes from the French verb touiller, meaning to toss or stir. It is served warm, at room temperature, and even cold, and is equally good as a side dish or eaten on toast the next day."
          }
        ]
      }
    ]
  }
