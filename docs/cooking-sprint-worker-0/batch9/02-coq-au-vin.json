      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oven to 160C. Season chicken thighs with salt and pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in the dutch oven over medium-high heat. Brown chicken skin-side down for 8 minutes until deep golden. Turn and brown 3 minutes more. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add lardons to the pot and fry until crisp. Add shallots and cook 5 minutes until starting to colour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in garlic, tomato puree, and flour. Cook 1 minute, stirring constantly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in wine and stock, scraping up any browned bits. Add thyme and bay leaves. Return chicken to pot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a simmer, cover, and cook in the oven for 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add mushrooms and butter. Return to oven uncovered for 20 minutes to reduce the sauce slightly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove herbs, check seasoning, and scatter with parsley. Serve with mashed potato or crusty bread."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Chicken skin is soft and pale",
              "cause": "Not enough heat or pan too crowded during browning",
              "fix": "Brown in batches over high heat to get proper colour"
            },
            {
              "symptom": "Sauce is too thin",
              "cause": "Lid kept on during final stage",
              "fix": "Remove lid and cook uncovered at 180C for 10-15 minutes to reduce"
            },
            {
              "symptom": "Shallots are mushy",
              "cause": "Added too early in the braise",
              "fix": "Next time add shallots in the final 30 minutes only"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Coq au vin is rooted in the farmhouse cooking of rural France, where a tough old rooster would be simmered in wine to make it edible. Modern versions use chicken thighs, which are far more forgiving. The dish became famous internationally through French cooking teachers in the 1960s. It is now a staple of French bistros worldwide."
          }
        ]
      }
    ]
  }
