      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put the beef in a large pot and cover with cold water by about 5cm. Bring slowly to the boil over medium heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "As the water heats, grey foam will rise to the surface. Skim it off regularly with a ladle or large spoon for the first 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the onion, garlic, thyme, bay leaves, peppercorns, and salt. Reduce to the gentlest possible simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook for 2 hours, skimming occasionally. The beef should be almost tender when prodded with a skewer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the carrots, leek, celery, and potatoes. Cook for another 40-45 minutes until all the vegetables are tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lift out the meat and vegetables. Strain the broth through a sieve. Taste and season."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve the broth first as a soup with toasted bread, then the meat and vegetables as the main course with mustard and cornichons."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Broth is cloudy and grey",
              "cause": "Heat too high or foam not skimmed in the first 20 minutes",
              "fix": "Nothing will fix a cloudy broth once set; next time start with cold water and skim methodically"
            },
            {
              "symptom": "Beef is stringy and tough after 2 hours",
              "cause": "Simmer too vigorous",
              "fix": "Reduce heat further and give it another 30-45 minutes - shin needs time to break down"
            },
            {
              "symptom": "Vegetables have disintegrated",
              "cause": "Added too early in the cooking",
              "fix": "Add vegetables only in the last 45 minutes so they stay tender but intact"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pot-au-feu is sometimes called the national dish of France. The name means pot on the fire. It has been the central meal of the French peasant kitchen for centuries, a way of making an entire dinner from a single pot over the fire. The tradition of serving the broth first as soup and the meat and vegetables as a second course is still followed in French homes today."
          }
        ]
      }
    ]
  }
