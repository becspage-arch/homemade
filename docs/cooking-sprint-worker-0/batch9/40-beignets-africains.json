      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk together the flour, sugar, and salt in a large bowl. Make a well in the centre."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Beat the eggs, milk, and vanilla together. Pour gradually into the flour, whisking until you have a smooth, thick batter with no lumps."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and rest the batter for 1 hour at room temperature."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a deep saucepan to 175C. Test with a small drop of batter: it should sizzle, puff, and rise within 3 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drop heaped tablespoons of batter into the oil in batches. Do not crowd. Fry for 2-3 minutes until golden on the underside, then turn and fry another 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain on kitchen paper. Dust with icing sugar if using. Serve hot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Fritters are raw inside despite golden outside",
              "cause": "Oil too hot, cooking the outside before the centre sets",
              "fix": "Reduce temperature to 170C and fry slightly longer so heat can reach the centre"
            },
            {
              "symptom": "Fritters do not puff and are flat and dense",
              "cause": "Batter not rested or baking powder missing",
              "fix": "Rest batter for the full hour and add half a teaspoon of baking powder to the dry ingredients"
            },
            {
              "symptom": "Fritters are very greasy",
              "cause": "Oil temperature too low or pan too crowded",
              "fix": "Maintain oil at 175C throughout and fry in small batches, letting oil recover between each"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Beignets are eaten throughout francophone West Africa as a morning street food, sold hot from vats of oil at market stalls and roadside carts alongside cups of instant coffee or sweet tea. They are particularly popular in Cote d'Ivoire, Cameroon, Senegal, and Burkina Faso. The sweet version eaten for breakfast is distinct from savoury bean-based fritters like akara. In their simplest form they are just flour, egg, and a little sugar, fried fast and eaten immediately."
          }
        ]
      }
    ]
  }
