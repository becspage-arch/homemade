      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Steep the saffron in 3 tablespoons of warm water and set aside for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat olive oil in a large pot over medium heat. Cook the onion and fennel for 8 minutes until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic and cook 2 minutes. Add tomatoes, thyme, bay, and chilli flakes if using. Cook 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the wine and let it bubble for 2 minutes. Add the stock and saffron with its soaking water. Bring to a simmer and cook for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season the broth well. Add the cod and simmer gently for 4 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the mussels and prawns. Cover and cook 3-4 minutes until mussels have opened and prawns are pink. Discard any mussels that remain closed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle into deep bowls. Serve with toasted baguette slices and rouille on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Fish is overcooked and falling apart",
              "cause": "Added too early or broth was boiling rather than simmering",
              "fix": "Reduce to a gentle simmer before adding fish, and check after 3 minutes"
            },
            {
              "symptom": "Broth is pale and lacks colour",
              "cause": "Saffron not steeped long enough or too little used",
              "fix": "Steep saffron for a full 10 minutes and use a generous pinch"
            },
            {
              "symptom": "Some mussels did not open",
              "cause": "They were dead before cooking",
              "fix": "Discard any that remain shut after 5 minutes of cooking - they are not safe to eat"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bouillabaisse is the signature dish of Marseille. It started as a fisherman's stew using unsold catch. The rouille and croutons are served on the side, not stirred in. Families in Marseille argue over the correct fish. Saffron is not optional."
          }
        ]
      }
    ]
