      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring a pan of salted water to the boil. Lower in the eggs gently and cook for 7 minutes. Transfer to cold water and peel when cool."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In the same boiling water, blanch the asparagus for 2-3 minutes until just tender. Drain and cool under cold running water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the dressing by whisking together the olive oil, lemon juice, mustard, garlic, salt and pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Halve the eggs. Arrange the asparagus, tomatoes, and eggs on a large plate or platter."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter over the olives, anchovies if using, and capers."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon the dressing over just before serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Egg yolks are fully hard and chalky",
              "cause": "Cooked too long or not put in cold water quickly enough",
              "fix": "7 minutes precisely from boiling, then straight into cold water"
            },
            {
              "symptom": "Asparagus is limp and dull green",
              "cause": "Overcooked or not cooled in cold water",
              "fix": "Two minutes in boiling water then immediately into iced water stops cooking and sets the colour"
            },
            {
              "symptom": "Dressing is too sharp",
              "cause": "Too much lemon or not enough oil",
              "fix": "Add more olive oil a tablespoon at a time and whisk again"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nicoise salad is from Nice on the French Riviera. The original had only raw vegetables, not cooked ones. The tuna and hard-boiled egg came later. French families make it at home all summer. Use the best tuna you can find. Good olive oil matters here."
          }
        ]
      }
    ]
  }
