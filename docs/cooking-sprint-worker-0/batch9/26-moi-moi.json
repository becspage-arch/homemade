      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Peel the soaked beans by rubbing in a bowl of water and skimming off the skins. Drain well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the beans with the red pepper, onion, chilli, oil, and salt. Add water gradually, blending to a smooth, pourable batter. Use about 300-400ml water total."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste the batter and season well. Stir in maggi seasoning if using."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Prepare 6 large squares of doubled foil. Ladle batter into each, filling halfway. Add a piece of egg and some flaked fish to each, then cover with more batter."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fold the foil into tight parcels, sealing the edges well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place parcels in a steamer over boiling water. Steam for 40-45 minutes until the moi moi is firm and set."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rest 10 minutes before unwrapping. Serve warm with jollof rice, ogi, or on its own."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Moi moi is still liquid in the centre after 45 minutes",
              "cause": "Batter too thin or steamer not hot enough",
              "fix": "Ensure the water is at a rolling boil throughout and use less water in the batter next time"
            },
            {
              "symptom": "Moi moi is rubbery and dense",
              "cause": "Too much oil or over-blended batter",
              "fix": "Reduce oil slightly and blend just until smooth, not excessively"
            },
            {
              "symptom": "Batter leaks out of the parcels",
              "cause": "Foil not sealed tightly enough",
              "fix": "Double the foil and fold each edge over twice to create a watertight seal"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Moi moi is a cornerstone of Nigerian cuisine eaten across all ethnic groups. It is served at parties alongside jollof rice, at breakfast with pap, and sold by street vendors throughout the day. The traditional wrapping is uma leaves or banana leaves, which impart a distinct flavour, but foil is the practical home alternative. It is one of the most protein-rich traditional dishes in West African cooking."
          }
        ]
      }
    ]
  }
}
