      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rub the cold butter into the flour and salt until the mixture looks like breadcrumbs. Add the beaten egg and bring together into a dough. Do not overwork it. Wrap and chill for 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oven to 190C. Roll pastry out on a floured surface and line a 23cm tart tin. Prick the base with a fork, line with baking paper, fill with baking beans, and blind bake for 15 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the paper and beans. Return to the oven for 5 minutes until the base looks dry and pale golden. Reduce oven to 180C."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the lardons in a dry pan over medium heat until golden. Drain on kitchen paper and scatter over the pastry base."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk together the eggs, creme fraiche, double cream, pepper, and nutmeg. Pour over the lardons. Scatter Gruyere on top if using."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 25-30 minutes until the filling is just set with a slight wobble in the centre. Rest 15 minutes before cutting."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Pastry has shrunk away from the sides of the tin",
              "cause": "Pastry was too warm when lining the tin or was stretched rather than draped",
              "fix": "Chill the lined tin before blind baking and always let pastry rest into the tin rather than pressing"
            },
            {
              "symptom": "Filling is rubbery and has cracks across the top",
              "cause": "Oven too hot or cooked too long",
              "fix": "Pull it out when there is still a slight wobble and let carry-over heat finish it"
            },
            {
              "symptom": "Soggy bottom under the filling",
              "cause": "Pastry not blind baked long enough",
              "fix": "Blind bake until the base is visibly dry, not just time-based"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Quiche Lorraine comes from the Lorraine region in northeast France, close to the German border. The original version contained only cream, eggs, and smoked bacon with no cheese. Cheese was added later and became a popular variation. The dish spread worldwide after the Second World War and is now a cornerstone of French home cooking and cafe lunch menus."
          }
        ]
      }
    ]
  }
