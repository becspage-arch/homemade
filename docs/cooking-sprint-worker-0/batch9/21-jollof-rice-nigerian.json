      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the tinned tomatoes, red pepper, chilli, and half the onion into a smooth puree."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a large heavy pot over medium-high heat. Add the sliced onion and fry for 5 minutes until starting to colour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tomato puree and stir fry for 2 minutes. Pour in the blended tomato mixture and cook over high heat for 20-25 minutes, stirring regularly, until the sauce is thick, reduced, and the oil floats on top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add thyme, bay leaves, salt, and pepper. Stir in the stock."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the washed rice and stir to combine. The liquid should just cover the rice. Bring to the boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce to a low simmer, cover tightly with foil and a lid, and cook for 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce heat to the lowest setting and cook for a further 10-15 minutes. Rest 10 minutes before opening. Fluff gently and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Rice is still crunchy after 30 minutes",
              "cause": "Not enough liquid or lid not sealed tightly",
              "fix": "Add a splash more stock or water, reseal with foil and lid, and cook another 10-15 minutes"
            },
            {
              "symptom": "Rice is mushy and wet",
              "cause": "Too much liquid used or heat too high",
              "fix": "Remove lid and increase heat briefly to evaporate excess moisture"
            },
            {
              "symptom": "Sauce tastes raw and acidic",
              "cause": "Tomato blend not cooked down long enough in the first stage",
              "fix": "Cook the tomato sauce until the raw tomato smell is completely gone before adding rice"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Jollof rice is one of the most hotly debated dishes in West Africa, with Nigeria and Ghana holding rival claims to the best version. The Nigerian version is known for its bold tomato flavour and the smoky base that forms when the rice catches at the bottom of the pot. It is the centrepiece of Nigerian parties, weddings, and celebrations and is measured by guests as a mark of the cook's skill."
          }
        ]
      }
    ]
  }
