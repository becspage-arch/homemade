      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil the potatoes until tender. Drain and set aside warm."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the cod, garlic, thyme, and bay leaf in a pan. Cover with cold water and bring gently to a simmer. Poach for 10-12 minutes until the fish just flakes. Drain, reserving a little of the liquid."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove skin and any bones from the fish. Flake the flesh into a bowl. Squeeze out the poached garlic cloves from their skins and add to the fish."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the warm potato. Mash or use a food processor to begin combining everything."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "With the motor running or while beating vigorously, add the warm olive oil in a slow, steady stream, alternating with splashes of warm milk."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the lemon juice. Season with pepper. The brandade should be creamy and spreadable. Add a little poaching liquid if too thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve warm with toasted baguette. Or spread in a baking dish, scatter with breadcrumbs and olive oil, and grill until golden."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Brandade is grainy and will not come together",
              "cause": "Oil added too fast or potato was too cold",
              "fix": "Keep both oil and milk warm throughout and add oil in a very thin drizzle"
            },
            {
              "symptom": "Tastes too fishy and intense",
              "cause": "Cod not desalted long enough or fish overcooked",
              "fix": "Soak salted cod longer, changing the water twice a day, and poach gently until just flaking"
            },
            {
              "symptom": "Mixture is very stiff and heavy",
              "cause": "Too much potato or too little oil and milk",
              "fix": "Add more warm milk and olive oil a tablespoon at a time until the texture loosens"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Brandade de morue is the signature dish of Nimes in the Languedoc region of southern France. Dried salt cod was an important preserved food throughout the Catholic world where no meat was eaten on Fridays, and Provence developed some of its most creative preparations. The version with potato is distinctively French. Served as a spread on toast or grilled under cheese, it appears in restaurants and homes across the south of France."
          }
        ]
      }
    ]
  }
