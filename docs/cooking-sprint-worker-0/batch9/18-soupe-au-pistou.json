      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil in a large pot over medium heat. Add leek, carrot, and celery. Cook for 8 minutes until softened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tomatoes and thyme. Cook 5 minutes more."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the stock and bring to a simmer. Add courgette and beans. Season with salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer for 20 minutes until all the vegetables are tender. Check seasoning."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the soup cooks, make the pistou: pound the garlic and salt in a pestle and mortar to a paste. Add basil leaves a handful at a time, pounding as you go. Stir in the olive oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle soup into bowls and stir a large spoonful of pistou into each. Pass more pistou at the table."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Pistou is brown and has lost its colour",
              "cause": "Basil oxidised from being made too far ahead or blended at high speed",
              "fix": "Make pistou just before serving and use a pestle and mortar rather than a blender"
            },
            {
              "symptom": "Soup is bland and watery",
              "cause": "Not enough salt or stock quality was poor",
              "fix": "Season generously and add a parmesan rind to the simmering soup for extra depth"
            },
            {
              "symptom": "Vegetables are mushy",
              "cause": "Cooked too long or added all at the same time",
              "fix": "Add harder vegetables first and courgette last, simmering only until just tender"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Soupe au pistou is the summer soup of Provence and Nice in southern France. It closely resembles Italian minestrone, which makes sense given the proximity to the Italian border and the shared Ligurian culinary tradition. The pistou is the Provencal cousin of Genoese pesto, without the pine nuts. It is made throughout the south of France in summer when basil is at its most abundant."
          }
        ]
      }
    ]
  }
