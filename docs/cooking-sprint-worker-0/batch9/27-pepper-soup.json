      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season the chicken with salt and half the black pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a large pot over medium heat. Add onion and fry 5 minutes. Add garlic, ginger, and whole chillies. Cook 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chicken and turn to coat in the aromatics. Cook 3-4 minutes until sealed on all sides."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the stock, ground coriander, allspice, and remaining black pepper. Bring to the boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce to a steady simmer and cook for 35 minutes until chicken is tender and falling from the bone."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and adjust salt and pepper. The broth should be boldly seasoned."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle into bowls with a piece of chicken. Scatter coriander on top. Serve with agidi, bread, or white rice on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Soup has no heat or depth of flavour",
              "cause": "Too little black pepper or chilli, or spices added too close to the end",
              "fix": "Add spices at the start so they have time to infuse the broth; season boldly and taste again"
            },
            {
              "symptom": "Broth is cloudy and muddy looking",
              "cause": "Stock simmered too fast or chicken added without skimming",
              "fix": "Skim the surface in the first 10 minutes and maintain a gentle simmer throughout"
            },
            {
              "symptom": "Chicken is dry and stringy",
              "cause": "Overcooked or heat too high",
              "fix": "Reduce heat to the lowest steady simmer and check at 30 minutes rather than 40"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pepper soup is eaten all over Nigeria. It is served after childbirth, as a remedy for colds, and at celebrations. The spice blend varies by region. Goat, chicken, and catfish are all common. Serve it very hot."
          }
        ]
      }
    ]
  }
