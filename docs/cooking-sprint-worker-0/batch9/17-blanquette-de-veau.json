      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put the veal in a large pan and cover with cold water. Bring to the boil over medium heat. Drain and rinse the veal under cold water. This blanching removes impurities."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return veal to the pan with the carrot, onion, thyme, bay leaves, and salt. Cover with fresh cold water and bring to a gentle simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook at a very gentle simmer for 1 hour, skimming any foam. Add mushrooms in the last 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lift out the veal and vegetables with a slotted spoon and set aside. Reserve 500ml of the poaching liquid."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the sauce: melt butter in a medium pan, stir in flour, cook 1 minute. Gradually whisk in the 500ml poaching liquid until smooth. Simmer 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Beat together the egg yolks and cream. Remove the sauce from the heat and stir in the cream mixture and lemon juice. Do not let it boil again."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the veal and vegetables to the sauce. Warm gently over very low heat for 5 minutes without boiling. Season and serve with rice or boiled potatoes."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Sauce has curdled with grainy yellow lumps",
              "cause": "Sauce got too hot after the egg yolk and cream were added",
              "fix": "Once the liaison is added the sauce must never boil - keep on very low heat only"
            },
            {
              "symptom": "Sauce is very thin",
              "cause": "Not enough flour in the roux or too much poaching liquid",
              "fix": "Mix a small knob of butter with equal flour and whisk into the simmering sauce to thicken"
            },
            {
              "symptom": "Veal is tough",
              "cause": "Simmered too fast or not long enough",
              "fix": "Return to a gentle simmer for another 20-30 minutes - veal shin needs patience"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Blanquette de veau is one of the defining dishes of bourgeois French cooking, the everyday refined cooking of the French middle class. It appears in the earliest French cookbooks and remains a staple of family Sunday lunches across France. The deliberate avoidance of browning is what defines the dish and distinguishes it from a braise. It is served with rice or boiled potato and a simple green salad."
          }
        ]
      }
    ]
  }
