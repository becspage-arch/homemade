      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the chilli and half the onion with a splash of stock into a smooth paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the palm oil in a large pot over medium heat. Fry the diced onion for 5 minutes until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the ground egusi seeds and fry in the oil for 10-15 minutes, stirring frequently, until golden and fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the blended chilli paste and fry together for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the stock, dried shrimp, iru if using, and smoked fish. Stir well. Simmer for 15 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the spinach and stir through. Cook for 3-5 minutes until wilted. Season with salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve with eba, pounded yam, or rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Soup is grainy and tastes raw",
              "cause": "Egusi not fried long enough in the oil",
              "fix": "Fry egusi for a full 15 minutes, stirring regularly, until it smells nutty and turns golden"
            },
            {
              "symptom": "Soup is very bitter",
              "cause": "Palm oil quality or too much iru",
              "fix": "Use fresh red palm oil from a reliable source and reduce iru to half a teaspoon"
            },
            {
              "symptom": "Soup is too thick and stiff",
              "cause": "Too much egusi for the liquid",
              "fix": "Add more stock or water a ladleful at a time until the consistency is right"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Egusi soup is eaten throughout Nigeria and across much of West and Central Africa, with each region having its own variation in technique and accompaniments. The Yoruba, Igbo, and Edo peoples of Nigeria all have distinct versions. It is served alongside fufu, eba, or pounded yam and is considered a staple of West African home cooking. The melon seeds provide protein and body, making it a nutritionally complete dish."
          }
        ]
      }
    ]
  }
