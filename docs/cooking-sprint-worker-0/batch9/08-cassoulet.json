      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oven to 160C. Season duck legs with salt and pepper. Brown skin-side down in the dutch oven over high heat for 8 minutes. Turn and brown 3 minutes. Remove."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Brown the sausages in the same pot until golden all over, about 6 minutes. Remove. Add lardons and fry until crisp. Remove."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the onion in the remaining fat over medium heat for 8 minutes until soft. Add garlic and tomato puree, cook 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add tinned tomatoes and stock. Stir well. Return the lardons to the pot. Add thyme and bay leaves."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the beans. Nestle the duck legs and sausages into the beans. Scatter breadcrumbs over the top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to the oven uncovered. After 45 minutes, push the crust down into the beans. Repeat every 45 minutes for 3 hours total."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rest 15 minutes before serving. Serve straight from the pot at the table."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Beans are dry and the cassoulet has absorbed all the liquid",
              "cause": "Oven too hot or not enough stock",
              "fix": "Add a ladle of hot water or stock and push the crust down before returning to the oven"
            },
            {
              "symptom": "Breadcrumb crust is not forming",
              "cause": "Too much liquid or oven temperature too low",
              "fix": "Remove the lid if you used one and increase temperature to 180C for the last 30 minutes"
            },
            {
              "symptom": "Duck legs are still tough after 3 hours",
              "cause": "Temperature dropped or duck was not browned first",
              "fix": "Return to oven for another 30 minutes covered with foil to keep moisture in"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cassoulet comes from the Languedoc region of southern France and is fiercely claimed by three towns: Castelnaudary, Carcassonne, and Toulouse. Each has its own recipe and each believes the others are wrong. The dish takes its name from the cassole, the shallow earthenware pot it is traditionally cooked in. It is the kind of dish that rewards patience and tastes better the second time you heat it up."
          }
        ]
      }
    ]
  }
