      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season beef with salt and pepper. Heat oil over high heat in a dutch oven. Brown beef in batches until deep brown on all sides. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce heat to medium. Add onion and cook 5 minutes until soft. Add garlic and chilli, cook 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add tomato puree and stir fry for 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return beef to the pot. Add stock and bay leaves. Bring to a simmer, cover, and cook for 40 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the peanut butter gradually, a few tablespoons at a time, ensuring each addition is fully stirred in before adding more."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the sweet potato chunks. Simmer uncovered for 20-25 minutes until the sweet potato is tender and the sauce has thickened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season and serve with white rice or couscous."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Peanut butter has formed oily lumps that will not dissolve",
              "cause": "Added to boiling liquid too quickly",
              "fix": "Stir the peanut butter with a ladleful of warm sauce to loosen it before adding it back to the pot"
            },
            {
              "symptom": "Sauce is very oily on the surface",
              "cause": "Oil from the peanut butter has separated",
              "fix": "Stir vigorously over medium heat and add a little water to bring it back together"
            },
            {
              "symptom": "Beef is still tough after 40 minutes",
              "cause": "Heat too low during the first braise",
              "fix": "Ensure the pot maintains a steady simmer throughout and continue for another 20-30 minutes"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mafe is considered the national dish of Mali and is eaten widely across Senegal, Guinea, and the broader Sahel region of West Africa. It is closely related to the groundnut soups of Ghana and Nigeria but tends to be thicker and less broth-like. In Senegal it is served with attieke or rice; in Mali it accompanies toh, a millet porridge. The peanut is central to the cuisines of all the Sahel nations and mafe is its most famous expression."
          }
        ]
      }
    ]
  }
