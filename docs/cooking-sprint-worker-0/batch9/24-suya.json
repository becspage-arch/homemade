      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix together all the yaji spice ingredients with the oil to form a paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Coat the beef slices thoroughly in the spice paste. Thread onto skewers. Refrigerate for at least 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a griddle pan or cast iron skillet over the highest heat until smoking hot. If using wooden skewers, soak them in water for 30 minutes first."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Grill the skewers for 3-4 minutes per side until charred in places and cooked through. Do not move them too early or they will not char."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rest 5 minutes. Serve on a board with raw onion, tomato, and extra chilli."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Beef is grey and steamed rather than charred",
              "cause": "Pan not hot enough or too many skewers in the pan at once",
              "fix": "Use a very hot dry pan and cook in batches, leaving space between each skewer"
            },
            {
              "symptom": "Spice rub falls off during cooking",
              "cause": "Not enough oil in the marinade or beef surface was wet",
              "fix": "Pat beef dry before coating and add a little more oil to help the rub adhere"
            },
            {
              "symptom": "Beef is tough and chewy",
              "cause": "Sliced too thick or cut with the grain rather than across it",
              "fix": "Slice no more than 5mm thick and always cut perpendicular to the direction of the muscle fibres"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Suya originated with the Hausa people of northern Nigeria and spread throughout West Africa and beyond. It is one of the most popular street foods in Nigeria, sold by mai suya vendors who grill over charcoal by the roadside at night. The peanut and spice rub is the defining element of authentic suya. Today it is found at Nigerian restaurants worldwide and has gained fans far beyond its home region."
          }
        ]
      }
    ]
  }
