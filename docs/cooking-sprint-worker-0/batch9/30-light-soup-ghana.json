      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season the chicken with salt and pepper. Heat oil in a large pot over medium-high heat. Brown the chicken all over, about 5 minutes. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a blender, blend the tomatoes, onion, garlic, and ginger into a smooth puree."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the blended mixture into the pot. Cook over medium heat for 10-15 minutes until slightly reduced."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the chicken to the pot. Add the whole chilli (or blended if you want more heat) and stock."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a simmer and cook gently for 35 minutes until the chicken is tender and the broth is fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and season well. Remove the whole chilli if used. Serve with fufu, rice balls, or boiled rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Soup is too hot and only tastes of chilli",
              "cause": "Scotch bonnet was blended in or broken during cooking",
              "fix": "Next time add it whole, then taste and decide whether to break it in at the end"
            },
            {
              "symptom": "Broth lacks depth and tastes thin",
              "cause": "Stock was weak or tomato not reduced enough",
              "fix": "Use a good quality stock and cook the tomato blend for at least 15 minutes before adding it"
            },
            {
              "symptom": "Chicken is overcooked and dry",
              "cause": "Simmered too hard or too long",
              "fix": "Keep at a gentle simmer and check at 30 minutes; bone-in thighs need less time than you think"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Light soup is eaten throughout Ghana at every meal of the day. It is the soup most closely associated with fufu, the pounded cassava and plantain dough eaten by tearing pieces and dipping into the broth. It is made with chicken, goat, fish, or any combination. Ghanaian households keep a pot of it on the hob and it is considered the most fundamental expression of Ghanaian home cooking."
          }
        ]
      }
    ]
  }
