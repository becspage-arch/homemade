      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the palm oil in a large pan over medium heat. Add the onion and cook for 5 minutes until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic and chilli. Cook for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chopped tomatoes and cook for 8-10 minutes until broken down and the palm oil shows through on the surface."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the flaked smoked fish and stir through. Cook for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the spinach in batches, stirring each addition in until wilted before adding more."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and cook for 10 minutes over low heat, stirring occasionally. Season with salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve with boiled yam, boiled plantain, or rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Stew tastes very bitter",
              "cause": "Palm oil overheated or smoked fish too strong",
              "fix": "Use fresh palm oil and do not let it smoke; add a pinch of sugar to balance if bitter"
            },
            {
              "symptom": "Stew is very watery",
              "cause": "Spinach released too much water",
              "fix": "Cook uncovered over medium heat for the last 10 minutes to evaporate excess liquid"
            },
            {
              "symptom": "Stew lacks depth and tastes flat",
              "cause": "Not enough smoked fish or seasoning",
              "fix": "Add a tablespoon of dried shrimp alongside the smoked fish for extra umami"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kontomire stew is one of the oldest and most nutritious dishes in Ghanaian cooking. Cocoyam leaves are among the most widely grown leafy vegetables in Ghana and form the base of several traditional stews. The stew is eaten across all regions and by all ethnicities. It is particularly associated with Ashanti cooking from central Ghana and is served at everyday family meals as well as at formal occasions."
          }
        ]
      }
    ]
  }
