      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season chicken with salt and pepper. Heat oil over medium-high heat in a large pot. Brown the chicken in batches until golden. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In the same pot, fry the onion for 5 minutes. Add garlic and ginger, cook 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the blended tomatoes and chilli. Cook over medium-high heat for 15 minutes, stirring, until the sauce thickens and the oil separates."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the peanut butter a few tablespoons at a time. Make sure each addition is fully mixed in before adding more."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the stock gradually, stirring to blend everything together smoothly. Return the chicken to the pot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a simmer, cover partially, and cook for 35-40 minutes until the chicken is very tender and the sauce is thick. Season to taste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve with rice or boiled plantain."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Peanut butter has formed lumps and will not dissolve",
              "cause": "Added to boiling hot liquid all at once",
              "fix": "Mix peanut butter with a ladle of warm soup first in a bowl, then stir that back into the pot"
            },
            {
              "symptom": "Soup is very thick and heavy",
              "cause": "Too much peanut butter or not enough stock",
              "fix": "Add more stock a cup at a time and simmer 5 minutes to incorporate"
            },
            {
              "symptom": "Soup tastes raw and sharp from the tomatoes",
              "cause": "Tomato not cooked long enough before adding stock",
              "fix": "Cook the tomato sauce until it visibly reduces and the oil floats to the surface before proceeding"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Peanut soup is eaten across West Africa. Every country has its own version. In Ghana it is often made with chicken. In Nigeria it can include goat. The peanut butter thickens the broth as it cooks. Serve it with rice or fufu."
          }
        ]
      }
    ]
  }
