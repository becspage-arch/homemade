      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix together the lemon juice, mustard, garlic, chilli, oil, and salt. Coat the chicken thoroughly. Marinate in the fridge for at least 4 hours or overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the chicken from the marinade and reserve the marinade."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a cast-iron skillet or griddle over high heat until very hot. Grill the chicken for 4-5 minutes per side until charred in spots. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a large pot, heat 2 tablespoons of groundnut oil over medium-low heat. Add all the sliced onions with a pinch of salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the onions slowly for 30-40 minutes until deeply golden and sweet, stirring every 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the reserved marinade, stock, and bay leaves to the onions. Stir and bring to a simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the grilled chicken, cover, and simmer for 25 minutes until fully cooked through. Season with pepper. Serve with rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Sauce is very sharp and acidic",
              "cause": "Onions not caramelised enough or too much lemon",
              "fix": "Ensure onions are fully caramelised and golden before adding any liquid"
            },
            {
              "symptom": "Chicken is dry after simmering",
              "cause": "Simmered at too high a heat for too long",
              "fix": "Use a gentle simmer with the lid on, checking at 20 minutes"
            },
            {
              "symptom": "No char or smokiness on the chicken",
              "cause": "Pan not hot enough when grilling",
              "fix": "Get the pan smoking hot before adding the chicken and do not move it for the first 4 minutes"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Yassa comes from the Casamance region of Senegal. It is a dish of the Diola people. The long marinade in lemon and onion is what defines it. Serve it with white rice. Leftovers keep well in the fridge for two days."
          }
        ]
      }
    ]
  }
