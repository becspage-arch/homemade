      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "If using dry attieke, steam it according to packet instructions for 10-15 minutes until fluffy. If pre-prepared, warm gently and fluff with a fork."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season the fish with lemon juice, garlic, salt, and 1 tablespoon of oil. Leave for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 2 tablespoons oil in a heavy frying pan over very high heat until smoking. Add the fish and do not move it for 4-5 minutes. Turn and cook the other side for 3-4 minutes. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For the sauce: heat 2 tablespoons oil in a small pan over medium heat. Fry the diced onion for 5 minutes. Add diced tomatoes and chilli, cook for 10 minutes until softened and sauce-like. Add lemon juice and season."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve attieke in a large bowl or plate. Top with the grilled fish. Spoon the tomato sauce over. Pile raw sliced onion on top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Fish sticks and tears when turned",
              "cause": "Pan not hot enough or fish moved too early",
              "fix": "Use very high heat and only attempt to turn when the fish releases naturally from the pan"
            },
            {
              "symptom": "Attieke is dry and clumped",
              "cause": "Not enough steam or too much time between cooking and serving",
              "fix": "Fluff with a fork and add a splash of water before reheating"
            },
            {
              "symptom": "Sauce is very watery",
              "cause": "Tomatoes not cooked down long enough",
              "fix": "Cook the sauce for at least 15 minutes over medium heat until most of the liquid has evaporated"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Attieke poisson is eaten every day in Cote d'Ivoire. Attieke is fermented cassava couscous. It is made by women's cooperatives and sold in plastic bags at markets. The fish is grilled, not fried. Eat it at room temperature with raw onion and chilli."
          }
        ]
      }
    ]
  }
