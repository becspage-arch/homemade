      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scoop the avocado flesh into a blender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the condensed milk and coconut milk. Blend for 30 seconds until completely smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and adjust . add more condensed milk if you want it sweeter, or more coconut milk if too thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fill 2 tall glasses with crushed ice. Pour the avocado mixture over the ice."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve immediately with a wide straw. Stir before drinking as the ice will dilute the top slightly."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The smoothie is lumpy instead of smooth.",
              "cause": "The avocado was not ripe enough.",
              "fix": "Use only very ripe avocados. Blend for a full minute on high speed. If still lumpy, pass through a sieve."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The smoothie turns brown after a few minutes.",
              "cause": "Avocado oxidises quickly when exposed to air.",
              "fix": "Serve immediately after blending. Add a tiny squeeze of lime juice before blending to slow the browning."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The drink is too sweet.",
              "cause": "Too much condensed milk was used.",
              "fix": "Add a little more coconut milk and reduce the condensed milk. Taste before serving and dilute to your preference."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Avocado smoothies are a staple of juice bars and fruit stalls across southern Vietnam. "
          },
          {
            "type": "text",
            "text": "Vietnam is a large avocado producer and the fruit is used in both sweet and savoury cooking. "
          },
          {
            "type": "text",
            "text": "The Vietnamese approach of treating avocado as a sweet ingredient surprises many Western visitors. "
          },
          {
            "type": "text",
            "text": "Sinh tố stalls sell dozens of varieties of blended fruit drinks throughout the day and into the evening. "
          },
          {
            "type": "text",
            "text": "The avocado version is one of the most popular choices."
          }
        ]
      }
    ]
  }
