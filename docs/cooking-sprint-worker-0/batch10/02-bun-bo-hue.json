      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blanch the bones and ribs: cover with cold water, bring to a boil for 5 minutes, then drain and rinse. This removes impurities and keeps the broth clear."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the bones, ribs, and brisket to the stockpot. Add the bruised lemongrass, charred shallots, charred ginger, and 3 litres of water. Bring to a boil, then reduce to a steady simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer for 1 hour 30 minutes, skimming any foam. Remove the brisket when tender. Continue simmering the bones for a further 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the annatto oil: warm the vegetable oil in a small saucepan over medium-low heat. Add the annatto seeds and fry for 2 minutes until the oil turns deep orange. Strain and discard the seeds. Add the garlic and chilli to the coloured oil and cook for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Strain the broth through a sieve. Return to the pot and stir in the annatto oil, fish sauce, and sugar. Season to taste. Keep at a simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slice the brisket and the meat from the ribs thinly. Cook the noodles according to packet instructions and divide between 4 bowls."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Top with sliced brisket and rib meat. Ladle the boiling broth over the top. Serve with bean sprouts, spring onion, coriander, and lime wedges on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Broth lacks colour",
              "cause": "The annatto seeds were not fried long enough, or the oil was too hot and the seeds burned.",
              "fix": "Fry annatto seeds on medium-low heat for 2 minutes. The oil should turn a vivid orange, not brown."
            },
            {
              "symptom": "Too spicy",
              "cause": "The chilli quantity was too high for your heat preference.",
              "fix": "Reduce chilli to half or add it as a table garnish so people can control the heat themselves."
            },
            {
              "symptom": "Broth is greasy",
              "cause": "The pork ribs released a lot of fat during simmering.",
              "fix": "Refrigerate the broth overnight and lift off the solidified fat cap before reheating."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bun bo Hue comes from the city of Hue in central Vietnam. Hue was the capital of the Nguyen dynasty for over a century. The food from Hue is known for being bold, spicy, and more complex than dishes from the north or south. This soup is much spicier than pho and uses lemongrass as its main scent. People in Hue are proud of their version and consider it very different from Hanoi-style noodle soups. It is common to eat it for breakfast in Hue."
          }
        ]
      }
    ]
  }
