      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the vegetable oil in a small pan over low heat. Add the annatto seeds and cook for 2 minutes until the oil turns deep orange. Strain and discard the seeds. Keep the coloured oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 2 tbsp of the annatto oil in a large pan. Fry the shallots, garlic, and lemongrass for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the sliced pork and cook for 3 minutes until sealed. Add the chicken stock and fish sauce. Simmer for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the prawns in the last 3 minutes of cooking until just pink. Remove the lemongrass."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the rice noodles according to the packet. Drain and toss with a pinch of ground turmeric."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the noodles between 4 bowls. Top with slices of pork and a few prawns. Ladle just 3 to 4 tablespoons of the concentrated broth over each bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter with crushed peanuts, bean sprouts, and fresh herbs. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The broth tastes too salty with only a few tablespoons.",
              "cause": "The broth was not seasoned for the small-volume serving style.",
              "fix": "For mì quảng, the broth should be slightly less salty than a soup broth. You will add more fish sauce at the table if needed."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The annatto oil does not colour properly.",
              "cause": "The oil was too hot and the seeds burnt rather than infusing.",
              "fix": "Use low heat. The oil should turn orange in 2 minutes without the seeds turning black. If they turn dark, start again."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The noodles clump together.",
              "cause": "They were drained and left to sit without tossing.",
              "fix": "Toss the cooked noodles with a splash of oil as soon as they are drained to prevent sticking."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mì quảng comes from Quảng Nam province in central Vietnam. "
          },
          {
            "type": "text",
            "text": "It is deeply associated with the area around Hội An and Da Nang. "
          },
          {
            "type": "text",
            "text": "Central Vietnamese cooking is known for being more intensely flavoured than the north or south. "
          },
          {
            "type": "text",
            "text": "The dish is eaten as a full meal any time of day, often for breakfast. "
          },
          {
            "type": "text",
            "text": "Visitors to Hội An often list mì quảng as one of the highlights of the food there."
          }
        ]
      }
    ]
  }
