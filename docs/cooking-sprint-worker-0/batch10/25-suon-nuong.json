  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sườn nướng are pork ribs soaked in a fragrant "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "lemongrass-marinade"
                }
              }
            ],
            "text": "lemongrass marinade "
          },
          {
            "type": "text",
            "text": "before being grilled until caramelised and sticky. "
          },
          {
            "type": "text",
            "text": "Serve them with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nuoc-cham-ribs"
                }
              }
            ],
            "text": "nước chấm "
          },
          {
            "type": "text",
            "text": "and steamed rice. "
          },
          {
            "type": "text",
            "text": "This recipe serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ask your butcher to cut the ribs into individual pieces. Single ribs grill faster and more evenly than a whole rack."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
