      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the lemongrass, garlic, shallots, fish sauce, soy sauce, sugar, sesame oil, and vegetable oil in a large bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the pork ribs and turn to coat thoroughly. Cover and refrigerate for at least 2 hours, ideally overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the ribs from the fridge 30 minutes before cooking to come to room temperature."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a griddle pan to medium-high. Grill the ribs for 6 to 8 minutes per side until caramelised and cooked through. Work in batches."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rest the ribs for 5 minutes before serving."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the dipping sauce by mixing fish sauce, lime juice, sugar, chilli, and 3 tbsp of water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve the ribs with steamed rice, fresh herbs, and the dipping sauce on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The ribs are charred on the outside but raw at the bone.",
              "cause": "The heat was too high and they cooked too fast.",
              "fix": "Use medium rather than high heat. Cover with a lid or foil for the first 5 minutes to cook through before finishing uncovered."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The marinade burns before a crust forms.",
              "cause": "The sugar content is high and caramelises quickly on hot metal.",
              "fix": "Wipe excess marinade off the ribs before grilling. The marinade on the surface is enough to caramelise without burning."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The ribs are tough and difficult to bite off the bone.",
              "cause": "The ribs were not marinated long enough.",
              "fix": "Marinate for a minimum of 2 hours. An overnight marinade also breaks down the muscle fibres slightly."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Grilled pork ribs are a popular street food across Vietnam. "
          },
          {
            "type": "text",
            "text": "They are sold at outdoor markets and barbecue stalls throughout the country. "
          },
          {
            "type": "text",
            "text": "The lemongrass-heavy marinade is characteristic of Vietnamese grilling traditions. "
          },
          {
            "type": "text",
            "text": "In Ho Chi Minh City, ribs are a common takeaway food sold wrapped in paper. "
          },
          {
            "type": "text",
            "text": "They are eaten at home as part of a family dinner alongside rice and vegetables."
          }
        ]
      }
    ]
  }
