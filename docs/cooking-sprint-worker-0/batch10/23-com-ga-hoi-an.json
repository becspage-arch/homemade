      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the chicken in a stockpot and cover with cold water. Add the ginger, 2 halved shallots, and fish sauce. Bring to the boil and skim."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce to the lowest possible simmer. Poach for 45 to 50 minutes until cooked through. Remove the chicken and rest for 15 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Strain the poaching broth. Reserve 500 ml for the rice. Keep the rest warm for serving."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a saucepan. Fry the 2 sliced shallots until golden. Add the turmeric and the dry rice. Stir to coat for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the 500 ml of reserved broth. Bring to the boil, then reduce to the lowest heat, cover, and cook for 15 minutes until the rice is done."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Tear or slice the chicken into pieces. Mix the herb salad with the daikon and dressing ingredients."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve the yellow rice topped with chicken and herb salad. Pour a small bowl of warm broth on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The chicken is dry and stringy.",
              "cause": "The water was at a rolling boil rather than a gentle poach.",
              "fix": "Poach at the lowest possible simmer - the water should barely move. High heat toughens the protein."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The rice is stodgy and lacks flavour.",
              "cause": "Plain water was used instead of the poaching broth.",
              "fix": "Always cook the rice in the poaching broth. This is what gives cơm gà its distinctive flavour."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The herb salad wilts before serving.",
              "cause": "It was dressed too far in advance.",
              "fix": "Toss the herb salad with the dressing only at the moment of serving."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cơm gà Hội An is one of the signature dishes of the ancient trading town of Hội An. "
          },
          {
            "type": "text",
            "text": "The town was a major port and trading hub for centuries, and the food shows many outside influences. "
          },
          {
            "type": "text",
            "text": "The dish is related to Hainanese chicken rice but is distinctly Vietnamese in character. "
          },
          {
            "type": "text",
            "text": "In Hội An, small restaurants serve it from the early morning as a breakfast meal. "
          },
          {
            "type": "text",
            "text": "It is one of the three dishes every visitor to Hội An is told they must eat."
          }
        ]
      }
    ]
  }
