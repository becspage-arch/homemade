      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cơm gà Hội An is chicken rice made with the poaching broth cooked into the "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "com-ga-rice"
                }
              }
            ],
            "text": "cơm gà rice "
          },
          {
            "type": "text",
            "text": ". "
          },
          {
            "type": "text",
            "text": "The dish is served with a bright herb salad using "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "rau-ram"
                }
              }
            ],
            "text": "rau răm "
          },
          {
            "type": "text",
            "text": "and green mango. "
          },
          {
            "type": "text",
            "text": "This recipe serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Do not rush the poaching. Low heat and patience gives you tender, juicy chicken and a clear, rich broth."
          }
        ]
      },
