  "glossaryTerms": [
    {
      "slug": "kho-technique",
      "term": "Kho",
      "definition": "A Vietnamese braising technique where meat or fish is cooked slowly in a small amount of liquid with fish sauce and caramel until the sauce reduces and coats the protein. The result is intensely flavoured and almost dry."
    },
    {
      "slug": "nuoc-mau",
      "term": "Nước màu",
      "definition": "Vietnamese caramel sauce made by cooking sugar until it turns a deep amber. It gives kho dishes their characteristic dark colour and slight bitterness."
    }
  ],
  "techniqueSlugs": [],
