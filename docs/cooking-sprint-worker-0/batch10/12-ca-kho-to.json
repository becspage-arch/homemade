  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cá kho tộ uses the "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "kho-technique"
                }
              }
            ],
            "text": "kho "
          },
          {
            "type": "text",
            "text": "technique to braise fish in a sticky, dark caramel sauce. "
          },
          {
            "type": "text",
            "text": "The sauce reduces until it clings to the fish and has an intense sweet and salty flavour. "
          },
          {
            "type": "text",
            "text": "This recipe serves 4 with steamed rice."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Make the "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nuoc-mau"
                }
              }
            ],
            "text": "nước màu "
          },
          {
            "type": "text",
            "text": "caramel carefully. Sugar can burn quickly once it turns dark amber. Have all other ingredients ready to add."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
