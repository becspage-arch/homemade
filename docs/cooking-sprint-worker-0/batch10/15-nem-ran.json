  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nem rán are crispy fried rolls made with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nem-ran-wrapper"
                }
              }
            ],
            "text": "bánh tráng "
          },
          {
            "type": "text",
            "text": "rice paper wrappers that turn shatteringly thin when fried. "
          },
          {
            "type": "text",
            "text": "The filling is a mix of pork, "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "glass-noodle-term"
                }
              }
            ],
            "text": "glass noodles "
          },
          {
            "type": "text",
            "text": ", and mushrooms. "
          },
          {
            "type": "text",
            "text": "This recipe makes about 16 rolls, enough for 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Make sure the filling is not too wet before rolling. Squeeze out any excess moisture from the vegetables to prevent soggy rolls."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
