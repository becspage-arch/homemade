  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Vịt nấu chao is duck legs braised slowly with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "chao-tofu"
                }
              }
            ],
            "text": "chao "
          },
          {
            "type": "text",
            "text": "fermented tofu, lemongrass, and coconut water. "
          },
          {
            "type": "text",
            "text": "The fermented tofu gives the sauce a deeply savoury, complex flavour that is unlike any other Vietnamese braise. "
          },
          {
            "type": "text",
            "text": "This recipe serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fermented tofu is found in jars at Asian supermarkets. Use the white variety, not the red chilli version, for this dish."
          }
        ]
      },
      {
