      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the soy sauces, fish sauce, sugar, and garlic. Rub all over the pork. Marinate for at least 1 hour or overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a Dutch oven. Sear the pork on all sides until browned, about 3 minutes per side."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add 300 ml of water, the star anise, and cinnamon. Bring to a simmer, cover and braise on low heat for 45 to 60 minutes until tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the pork and slice thinly. Reduce the braising liquid over high heat until thick and glossy. This is the sauce for the bowls."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the noodles according to the packet. Drain and toss with a little oil to prevent sticking."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the noodles between bowls. Top with sliced pork and ladle 2 to 3 tablespoons of sauce over each bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add bean sprouts, mint, and coriander. Serve with extra sauce on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The pork sauce burns and becomes bitter.",
              "cause": "The reduction was left unattended on high heat.",
              "fix": "Watch the sauce closely as it reduces. Stir frequently and remove from heat as soon as it coats the back of a spoon."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The pork is dry after braising.",
              "cause": "Not enough liquid was used or the heat was too high.",
              "fix": "Keep the heat very low and ensure the lid is tight. Add more water during cooking if the liquid reduces below halfway."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The udon noodles are too soft and collapse.",
              "cause": "They were cooked for too long.",
              "fix": "Cook udon for 1 minute less than the packet suggests. They should be slightly firmer than you want to eat them as they continue to soften in the bowl."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cao lầu is one of the most unique dishes in Vietnam because it is said to be impossible to make authentically outside Hội An. "
          },
          {
            "type": "text",
            "text": "The special noodles require well water and ash from the Cham islands. "
          },
          {
            "type": "text",
            "text": "Hội An itself is a UNESCO World Heritage town with a strong history of Chinese, Japanese, and Vietnamese trade. "
          },
          {
            "type": "text",
            "text": "The dish shows all of those influences in its noodles, pork, and flavour profile. "
          },
          {
            "type": "text",
            "text": "Visitors to Hội An eat it as one of the essential food experiences of the town."
          }
        ]
      }
    ]
  }
}
