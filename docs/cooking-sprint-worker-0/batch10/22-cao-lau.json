    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cao lầu is Hội An's most distinctive dish. "
          },
          {
            "type": "text",
            "text": "Chewy "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "cao-lau-noodle"
                }
              }
            ],
            "text": "cao lầu noodles "
          },
          {
            "type": "text",
            "text": "are topped with braised "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "xa-xiu-pork"
                }
              }
            ],
            "text": "xá xíu "
          },
          {
            "type": "text",
            "text": "pork, crispy croutons, fresh herbs, and just a splash of broth. "
          },
          {
            "type": "text",
            "text": "This recipe serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thick udon noodles make a good substitute for authentic cao lầu noodles outside Vietnam. Cook them slightly firmer than the packet suggests."
          }
        ]
      },
