  "glossaryTerms": [
    {
      "slug": "la-lot",
      "term": "Lá lốt",
      "definition": "Betel leaf - a dark green, peppery leaf used in Vietnamese and Southeast Asian cooking as a wrapper for grilled meats. It has a pungent, slightly bitter flavour that complements beef well."
    },
    {
      "slug": "bo-7-mon",
      "term": "Bò 7 món",
      "definition": "A Vietnamese feast of seven beef dishes, traditionally served at celebrations. Bò nướng lá lốt is one of the dishes in this banquet."
    }
  ],
