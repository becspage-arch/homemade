      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the pork in a stockpot with 1.5 litres of water. Bring to the boil, skim, then simmer for 30 minutes. Remove the pork and slice it. Keep the broth simmering."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the shallots and garlic in oil until golden. Add the tomato wedges and cook for 5 minutes until softened and starting to break down."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tomato and shallot mixture to the broth. Add the tamarind paste, fish sauce, and sugar. Simmer for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend or mash the chopped prawns with the eggs and 1 tbsp fish sauce to make a rough paste. Season to taste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring the broth to a gentle boil. Drop spoonfuls of the prawn paste into the soup. It will set into soft, fluffy dumplings in 3 to 4 minutes. Do not stir vigorously."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the fried tofu and sliced pork to the broth and heat through for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the cooked noodles between 4 bowls. Ladle over the hot broth with the dumplings, tofu, and pork. Top with spring onion and serve with bean sprouts and lime."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The prawn paste breaks apart in the broth instead of setting.",
              "cause": "The broth was not hot enough when the paste was added.",
              "fix": "Bring the broth to a proper boil before adding the paste. Drop spoonfuls in gently and do not stir for the first 2 minutes."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The broth tastes too sour.",
              "cause": "Too much tamarind was added at once.",
              "fix": "Add the tamarind a tablespoon at a time and taste between additions. Balance with a pinch of sugar if needed."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The tofu falls apart in the soup.",
              "cause": "Silken or soft tofu was used instead of firm.",
              "fix": "Use firm tofu only. Fry it in oil until golden before adding to the soup. This gives it a skin that holds together."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bún riêu is a popular home-cooked noodle soup found across Vietnam. "
          },
          {
            "type": "text",
            "text": "It is most closely associated with the north and has been eaten as a street food for generations. "
          },
          {
            "type": "text",
            "text": "Freshwater crabs from rivers and paddy fields are the traditional protein. "
          },
          {
            "type": "text",
            "text": "In cities, canned crab or minced prawn is used as a practical substitute. "
          },
          {
            "type": "text",
            "text": "The dish is loved for its bright, tangy flavour that stands apart from the cleaner broths of phở."
          }
        ]
      }
    ]
  }
