    {
      "slug": "dau-phu",
      "term": "Đậu phụ",
      "definition": "The Vietnamese word for tofu, made from curdled soy milk pressed into blocks. Firm tofu is most commonly used in Vietnamese cooking as it holds its shape when fried."
    },
    {
      "slug": "ca-chua-sauce",
      "term": "Sốt cà chua",
      "definition": "A simple Vietnamese tomato sauce made from fresh tomatoes, garlic, shallots, fish sauce, and sugar. It is sweeter and lighter than a Western tomato sauce."
    }
  ],
