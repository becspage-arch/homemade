    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bánh canh is a satisfying noodle soup built around thick, chewy "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "banh-canh-noodle"
                }
              }
            ],
            "text": "bánh canh noodles "
          },
          {
            "type": "text",
            "text": "in a clear "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "pork-broth-light"
                }
              }
            ],
            "text": "nước lèo "
          },
          {
            "type": "text",
            "text": "broth. "
          },
          {
            "type": "text",
            "text": "Udon noodles make an excellent substitute for the authentic thick rice noodles. "
          },
          {
            "type": "text",
            "text": "This recipe serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Skim the broth carefully in the first 20 minutes. A clear broth is the hallmark of a well-made bánh canh."
          }
        ]
      },
