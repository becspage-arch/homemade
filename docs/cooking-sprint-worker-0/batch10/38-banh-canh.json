      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the pork shoulder in a stockpot with 2 litres of cold water. Bring to the boil and skim off all foam thoroughly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the onion, ginger, and garlic. Reduce to a gentle simmer. Cook for 60 to 75 minutes until the pork is cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the pork and set aside to cool. Strain the broth through a sieve and return to the pot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season the broth with fish sauce and sugar. It should taste clean, slightly sweet, and savoury."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slice the cooked pork thinly. If using prawns, add them to the simmering broth for 2 to 3 minutes until just cooked."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the cooked noodles between 4 bowls. Top with sliced pork and prawns. Ladle the very hot broth over the top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Finish with spring onion and coriander. Serve with lime wedges and sliced chilli on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The broth is cloudy and grey.",
              "cause": "The foam was not skimmed properly at the start.",
              "fix": "Bring the pork to the boil in cold water and skim off all the grey foam before adding aromatics. Do not let the broth boil vigorously."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The udon noodles are too starchy and thicken the broth.",
              "cause": "Udon releases more starch than rice noodles when added to hot soup.",
              "fix": "Cook and rinse the udon noodles in a separate pot before adding to the bowl. Add the broth on top rather than cooking the noodles in the broth."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The pork is dry and stringy.",
              "cause": "It was simmered at too high a temperature.",
              "fix": "Keep the broth at the barest possible simmer. The surface should barely move. A gentle poach gives much more tender pork."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bánh canh is eaten throughout Vietnam and is especially popular in the south and centre. "
          },
          {
            "type": "text",
            "text": "The coastal version from Trảng Bàng uses freshly made rice sheets cut into thick strips. "
          },
          {
            "type": "text",
            "text": "In the Mekong Delta, crab or prawn versions are more common than pork. "
          },
          {
            "type": "text",
            "text": "The dish is sold at markets, street stalls, and small restaurants for breakfast or lunch. "
          },
          {
            "type": "text",
            "text": "Its thick, chewy noodles make it one of the most comforting and filling Vietnamese noodle soups."
          }
        ]
      }
    ]
  }
}
