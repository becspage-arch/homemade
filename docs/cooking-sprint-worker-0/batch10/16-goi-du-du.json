            ],
            "text": "green papaya "
          },
          {
            "type": "text",
            "text": "tossed in a tangy "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nuoc-cham-salad"
                }
              }
            ],
            "text": "nước chấm "
          },
          {
            "type": "text",
            "text": "dressing with prawns, herbs, and peanuts. "
          },
          {
            "type": "text",
            "text": "This recipe serves 4 as a side."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you cannot find green papaya, green mango or shredded kohlrabi make good substitutes with a similar crunch."
          }
        ]
