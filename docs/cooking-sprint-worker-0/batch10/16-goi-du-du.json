      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Shred the green papaya on the coarse side of a box grater or use a julienne peeler. Rinse under cold water and drain well in a colander."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the prawns in simmering water for 2 to 3 minutes until pink. Drain and cool."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the dressing by mixing the fish sauce, lime juice, sugar, garlic, and chilli with 2 tbsp of water. Stir until the sugar dissolves."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the shredded papaya, carrot, sliced shallots, and prawns in a large bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the dressing over the salad and toss well to coat everything evenly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the mint and coriander. Toss gently."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to a serving plate. Scatter over the crushed peanuts and serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The salad is watery and the dressing is diluted.",
              "cause": "The papaya was not drained properly after shredding.",
              "fix": "After shredding, squeeze the papaya firmly in a clean cloth or colander to remove as much liquid as possible before dressing."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The dressing is too salty.",
              "cause": "Too much fish sauce was used for the amount of papaya.",
              "fix": "Add more lime juice and a pinch of extra sugar to balance. The dressing should taste bright and balanced, not fishy."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "The papaya turns soft and loses its crunch quickly.",
              "cause": "The salad was dressed too far in advance.",
              "fix": "Only dress the salad just before serving. The acid in the dressing breaks down the papaya fibres quickly."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Green papaya salad is eaten across Southeast Asia in different forms. "
          },
          {
            "type": "text",
            "text": "The Vietnamese version is milder and sweeter than the famous Lao and Thai versions. "
          },
          {
            "type": "text",
            "text": "It is popular in the south of Vietnam as a starter or side dish at family meals. "
          },
          {
            "type": "text",
            "text": "Dried shrimp is often added for extra umami in the traditional recipe. "
          },
          {
            "type": "text",
            "text": "The salad is most commonly served alongside grilled meats."
          }
        ]
      }
    ]
  }
