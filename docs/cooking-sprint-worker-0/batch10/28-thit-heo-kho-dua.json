      "slug": "young-coconut-water",
      "term": "Coconut water",
      "definition": "The clear liquid from inside a young coconut. It has a delicate, natural sweetness. In Vietnamese cooking it is used as a braising liquid to add sweetness without refined sugar."
    },
    {
      "slug": "kho-dua-technique",
      "term": "Kho dừa",
      "definition": "A Vietnamese braising method using coconut water as the base liquid. The coconut water reduces during cooking and caramelises slightly to make a rich, naturally sweet sauce."
    }
  ],
