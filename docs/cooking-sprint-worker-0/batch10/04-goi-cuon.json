{
  "body": {
    "content": [
      {
        "content": [
          {
            "text": "Gỏi cuốn are fresh rolls made with soft ",
            "type": "text"
          },
          {
            "text": "rice paper ",
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "rice-paper"
                }
              }
            ]
          },
          {
            "text": "filled with prawns, pork, noodles, and herbs. ",
            "type": "text"
          },
          {
            "text": "They are served at room temperature with a peanut dipping sauce or ",
            "type": "text"
          },
          {
            "text": "nuoc cham ",
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nuoc-cham-term"
                }
              }
            ]
          },
          {
            "text": ". This recipe serves 4 as a starter.",
            "type": "text"
          }
        ],
        "type": "paragraph"
      },
      {
        "content": [
          {
            "text": "Have all your fillings prepped and lined up before you start rolling. Once the rice paper is wet it becomes sticky quickly and you need to work fast.",
            "type": "text"
          }
        ],
        "type": "paragraph"
      },
      {
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ],
        "type": "heading",
        "attrs": {
          "level": 2
        }
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
