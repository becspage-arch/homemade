              "amount": 100,
              "unit": "g",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": "filling"
            },
            {
              "ingredientSlug": "mint",
              "amount": 1,
              "unit": "handful",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": "filling"
            },
            {
              "ingredientSlug": "coriander-fresh",
              "amount": 1,
              "unit": "handful",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": "filling"
            },
            {
              "ingredientSlug": "spring-onion",
              "amount": 4,
              "unit": "whole",
              "prepNote": "trimmed",
              "isOptional": false,
              "groupLabel": "filling"
            },
            {
