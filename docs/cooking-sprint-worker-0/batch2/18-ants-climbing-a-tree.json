      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Soak the glass noodles in cold water for 20 minutes until pliable. Drain well and cut into 15 cm lengths with scissors."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the vegetable oil in a wok over high heat. Add the pork mince and stir-fry, breaking it up, until browned, about 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Push the mince to the side. Add the doubanjiang and fry for 30 seconds until the oil turns red."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and ginger, stir everything together and cook for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the Shaoxing wine and let it sizzle for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the soy sauce and chicken stock. Bring to a simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained noodles. Stir and cook for 4 to 5 minutes, until the noodles have absorbed most of the liquid and are tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from the heat. Drizzle with sesame oil, scatter over the spring onions and serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Noodles are sticking together",
              "cause": "They sat too long after draining.",
              "fix": "Add them straight to the pan once drained, or toss with a few drops of oil if there is a delay."
            },
            {
              "symptom": "Dish is too salty",
              "cause": "Doubanjiang and soy sauce are both salty, and stock brands vary.",
              "fix": "Taste before adding soy sauce and reduce or omit it if the doubanjiang alone is salty enough."
            },
            {
              "symptom": "Noodles are still firm after 5 minutes",
              "cause": "They were not soaked long enough.",
              "fix": "Soak until fully pliable, at least 20 minutes in cold water, or 10 minutes in warm water."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ants climbing a tree is a beloved home dish from Sichuan province, found in households across the region and served in small restaurants throughout China. It is economical, quick and deeply satisfying. The playful name makes it a favourite with children and has helped it travel well beyond Sichuan into the wider Chinese culinary repertoire."
          }
        ]
      }
    ]
  }
