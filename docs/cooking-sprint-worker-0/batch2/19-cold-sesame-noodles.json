  "glossaryTerms": [
    {
      "slug": "tahini",
      "term": "Tahini",
      "definition": "A smooth paste ground from sesame seeds. It is used interchangeably with Chinese sesame paste in many cold noodle recipes, though Chinese sesame paste is made from toasted seeds and has a deeper, nuttier flavour. Stir well before using as the oil separates on standing."
    },
    {
      "slug": "sesame-oil",
      "term": "Sesame Oil",
      "definition": "A dark, fragrant oil pressed from toasted sesame seeds. Used as a finishing condiment rather than a cooking oil, as its flavour diminishes under direct heat. A small amount adds a characteristic nutty aroma."
    },
    {
      "slug": "chilli-oil",
      "term": "Chilli Oil",
      "definition": "Oil infused with dried chillies, often with added spices such as Sichuan pepper and star anise. Chinese chilli oil is typically bright red and used as a condiment or sauce ingredient. Heat level varies by brand."
    },
    {
      "slug": "shaoxing-wine",
      "term": "Shaoxing Wine",
      "definition": "A Chinese rice wine with a nutty, amber flavour used widely in marinades, sauces and braises. Named after the city of Shaoxing in Zhejiang province. Dry sherry is the closest substitute."
    }
  ],
