      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the noodles in a large pot of boiling water according to the packet instructions until just tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain and rinse immediately under cold running water until the noodles are completely cool. Toss with 1 tsp vegetable oil to prevent sticking."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk together the tahini, soy sauce, rice vinegar, Shaoxing wine, chilli oil, sesame oil, sugar and garlic in a bowl. Add 2 to 3 tbsp cold water and whisk until smooth and pourable."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toss the cold noodles with the dressing until well coated."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide into bowls. Top with spring onions and chopped roasted peanuts if using. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Dressing is too thick to coat the noodles",
              "cause": "Tahini thickens when mixed with acid or soy.",
              "fix": "Whisk in cold water a tablespoon at a time until the dressing flows easily."
            },
            {
              "symptom": "Noodles are clumped together",
              "cause": "They were not rinsed or oiled after cooking.",
              "fix": "Always rinse under cold water immediately after draining and toss with a small amount of oil."
            },
            {
              "symptom": "Dish tastes flat",
              "cause": "Sesame paste and soy can dull other flavours.",
              "fix": "Add a little more rice vinegar for brightness, or increase the chilli oil for contrast."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cold sesame noodles are eaten across China in summer when a hot bowl of soup feels like too much work. They are a northern and Sichuan staple, sold as street food and made at home with whatever noodles are to hand. The dressing formula is adaptable: some versions use peanut butter, others add black vinegar or a spoonful of fermented chilli bean paste."
          }
        ]
      }
    ]
  }
