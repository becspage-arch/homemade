      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toss the aubergine batons with 1 tsp salt and spread in a colander. Leave for 20 minutes, then pat thoroughly dry with kitchen paper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the soy sauce, rice vinegar, sugar and cornflour slurry in a small bowl. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 3 tbsp vegetable oil in a wok over high heat until just smoking. Fry the aubergine in a single layer for 4 to 5 minutes, turning occasionally, until golden on all sides. Work in batches if needed. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce the heat to medium. Add the remaining 1 tbsp oil. Fry the doubanjiang for 30 seconds until fragrant and the oil turns red."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and ginger and stir-fry for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the sauce mixture and stir until it thickens, about 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the aubergine to the wok and toss to coat in the sauce. Cook for 1 minute more."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from the heat. Drizzle with sesame oil and scatter over the spring onions. Serve with steamed rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Aubergine soaks up too much oil",
              "cause": "It was not dried well enough before frying, or the oil was not hot enough.",
              "fix": "Pat the salted aubergine very dry and make sure the oil is shimmering before adding it."
            },
            {
              "symptom": "Sauce is too salty",
              "cause": "Doubanjiang varies in saltiness between brands.",
              "fix": "Taste before adding any extra soy sauce and reduce the doubanjiang quantity by half a tablespoon next time."
            },
            {
              "symptom": "Aubergine is mushy",
              "cause": "Overcooked during frying.",
              "fix": "Fry at high heat for no more than 5 minutes. The pieces should hold their shape with just a little give."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Yu xiang aubergine comes from Sichuan province in south-west China, where the yu xiang flavour family is one of the most celebrated in the regional kitchen. Home cooks make it regularly as a vegetable side, and it appears on restaurant menus across China. The dish is a good introduction to how Sichuan cooks balance heat, acidity and sweetness in a single sauce."
          }
        ]
      }
    ]
  }
}
