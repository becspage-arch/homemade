  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pasta e fagioli is a thick bean and pasta soup built on a base of "
          },
          {
            "type": "glossaryTooltip",
            "attrs": {
              "termSlug": "soffritto"
            },
            "content": [
              {
                "type": "text",
                "text": "soffritto"
              }
            ]
          },
          {
            "type": "text",
            "text": " and crisped "
          },
          {
            "type": "glossaryTooltip",
            "attrs": {
              "termSlug": "pancetta"
            },
            "content": [
              {
                "type": "text",
                "text": "pancetta"
              }
            ]
          },
          {
            "type": "text",
            "text": ". Mashing some of the borlotti beans directly in the pot thickens the broth without any flour. This recipe serves 4 as a main course."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Short pasta such as ditalini or tubetti is stirred in at the end and cooked directly in the soup so it absorbs the flavour of the broth."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "pancetta",
              "amount": 100,
              "unit": "g",
              "prepNote": "diced",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "extra-virgin-olive-oil",
              "amount": 2,
              "unit": "tbsp",
              "prepNote": null,
