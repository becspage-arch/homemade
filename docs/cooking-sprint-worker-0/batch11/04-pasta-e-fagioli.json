              "amount": 1,
              "unit": "medium",
              "prepNote": "finely diced",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "carrot",
              "amount": 1,
              "unit": "medium",
              "prepNote": "finely diced",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "celery",
              "amount": 2,
