              "unit": "sprigs",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "tomato-puree",
              "amount": 2,
              "unit": "tbsp",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "borlotti-beans",
              "amount": 2,
              "unit": "x 400g tins",
              "prepNote": "drained and rinsed",
              "isOptional": false,
