      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil in a dutch oven over medium heat. Add the onion and cook gently for 8 to 10 minutes until soft and translucent. Add the garlic and dried chilli and cook for another 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the white wine vinegar and let it bubble for 1 to 2 minutes, scraping the base of the pan. The sharpness will soften as it cooks down."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tinned tomatoes, fish stock and saffron water. Season to taste. Stir well and bring to a gentle simmer. Cook uncovered for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the clams to the broth. Cover and cook for 3 to 4 minutes until they start to open."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Nestle the cod chunks into the broth. Cook uncovered for 4 minutes at a gentle simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the prawns and cook for a further 3 minutes until just pink. Discard any clams that have not opened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter over the flat-leaf parsley and check the seasoning. Serve immediately in deep bowls with crusty bread."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Broth tastes too sharp",
              "cause": "The vinegar was not cooked down enough before adding the tomatoes and stock",
              "fix": "Simmer the broth uncovered for a few more minutes to drive off the acidity, then taste and adjust"
            }
          },
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Cod is falling apart",
              "cause": "The fish went in too early or the heat was too high",
              "fix": "Keep the broth at a gentle simmer when the fish goes in and check it after 3 minutes"
            }
          },
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Clams did not open",
              "cause": "The clams were dead before cooking or the lid was not on properly",
              "fix": "Discard any clams that stay closed after 5 minutes of covered cooking over medium heat"
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Brodetto Marchigiano is eaten along the coast of Le Marche, from Ancona down to San Benedetto del Tronto. Each port town claims its own version as the true one. The saffron and vinegar together set it apart from similar stews in Abruzzo and Puglia. It is made on the day and eaten straight from the pot. Serve with bread to soak up the broth."
          }
        ]
      }
    ]
  }
