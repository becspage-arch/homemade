  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pollo alla "
          },
          {
            "type": "text",
            "text": "Cacciatora",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "cacciatora"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " starts with browning bone-in chicken pieces to build a rich "
          },
          {
            "type": "text",
            "text": "fond ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fond"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", then adds tomatoes, olives, capers, and white wine for a long, gentle braise. The result is fall-off-the-bone chicken in a deeply savoury sauce. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use bone-in, skin-on thighs or a whole chicken cut into pieces. Boneless chicken will cook too fast and miss the depth of flavour the slow braise creates."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
