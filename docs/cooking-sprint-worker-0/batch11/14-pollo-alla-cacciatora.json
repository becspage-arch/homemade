      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pat the chicken thighs dry with kitchen paper. Season with black pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil in a Dutch oven over high heat. Brown the chicken skin-side down for 5 minutes without moving, until the skin is golden. Flip and brown the other side for 3 minutes. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce heat to medium. Add the onion and garlic to the pot and cook for 5 minutes until softened and beginning to colour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the white wine and let it bubble for 2 minutes. Add the tinned tomatoes, olives, capers, rosemary, and thyme."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the chicken to the pot skin-side up. Bring to a gentle simmer, cover, and cook for 40 minutes. Remove the lid for the last 10 minutes to thicken the sauce. Taste and adjust seasoning before serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Skin loses its crispness during braising"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "This is normal in a braise. Cook with the lid off for the last 10 minutes and the skin will firm up again."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Sauce too watery"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the chicken and boil the sauce hard for 5 minutes to reduce and concentrate it."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Too salty from the olives and capers"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rinse the capers well and use mild olives. Do not add any other seasoning until the end."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cacciatora is found from Tuscany down to Sicily. Every family has a version. The name conjures a hunter cooking what he caught over an open fire. Today it is Sunday lunch food all over Italy. It is the kind of dish that tastes even better the next day."
          }
        ]
      }
    ]
  }
