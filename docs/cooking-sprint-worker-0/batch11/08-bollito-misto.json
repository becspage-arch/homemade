      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the beef brisket in a large stockpot. Cover with cold water by at least 5 cm. Bring slowly to the boil, skimming off any grey foam that rises. This takes about 15 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Once the foam has cleared, add the onion, carrot, celery, bay leaves and peppercorns. Season to taste. Reduce to a very gentle simmer and cook uncovered for 90 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lower the chicken into the broth. Continue simmering gently for a further 60 minutes, or until both meats are completely tender when pierced with a skewer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the meats cook, make the salsa verde. Finely chop the parsley, capers, anchovies and garlic together on a board until you have a rough paste. Transfer to a bowl, stir in the vinegar and olive oil, and season to taste. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Twenty minutes before serving, ladle enough hot broth into a separate pan to cook the potatoes. Simmer the potatoes until tender, about 15 to 18 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Strain a good ladleful of clear broth into cups or small bowls and serve as a first course."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lift the meats from the broth, slice and arrange on a warm platter with the potatoes. Serve with the salsa verde on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Broth is cloudy",
              "cause": "The water came to a hard boil before the foam was fully skimmed, or the heat was too high during cooking",
              "fix": "Keep the simmer as gentle as possible throughout and skim any fresh foam in the first 20 minutes"
            }
          },
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Brisket is tough after 90 minutes",
              "cause": "The simmer was too vigorous or the cut was very thick",
              "fix": "Continue simmering and check every 20 minutes until a skewer slides through the thickest part with no resistance"
            }
          },
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Salsa verde is too sharp",
              "cause": "The capers or anchovies were very salty and were not rinsed well",
              "fix": "Stir in a little more olive oil to balance the sharpness and taste again before serving"
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bollito misto is a cold-weather dish from the Po Valley, eaten most in Piedmont, Lombardy and Emilia-Romagna. In its most elaborate form it includes seven cuts of beef, a whole chicken, and a cotechino sausage. The home version here uses just two meats. Restaurants in Turin and Bologna serve it from trolleys wheeled to the table. It is the kind of dish that takes a long afternoon and feeds a crowd."
          }
        ]
      }
    ]
  }
