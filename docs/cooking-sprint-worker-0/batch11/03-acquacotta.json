      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large saucepan over medium heat. Add the onion and celery. Cook for 8 minutes until softened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and dried chilli. Cook for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chopped tomatoes and cook for 10 minutes, breaking them down with a spoon."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the stock. Bring to a simmer and cook for 15 minutes. Season to taste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce the heat so the soup is just barely simmering. Crack each egg directly into the soup. Cover and cook for 3 to 4 minutes until the whites are just set."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place a slice of toasted bread in each bowl. Carefully ladle the soup and one egg into each bowl. Scatter basil and parmesan over the top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Egg whites are rubbery",
              "cause": "The soup was boiling too hard when the eggs were added",
              "fix": "Reduce the heat to a bare simmer before cracking in the eggs"
            }
          },
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Soup tastes watery",
              "cause": "The tomatoes were not cooked down long enough",
              "fix": "Cook the tomatoes for a full 10 minutes before adding stock"
            }
          },
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Eggs broke apart in the soup",
              "cause": "They were dropped from too high or the liquid was disturbed",
              "fix": "Crack each egg into a small cup first and slide gently into the soup"
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Acquacotta is from the Maremma, a coastal area in southern Tuscany. It was the food of herdsmen who worked the flat, marshy land. They made it with whatever vegetables they had and cooked it over a fire. Today it is served in local restaurants as a regional classic. The egg on top makes it more filling and more interesting."
          }
        ]
      }
    ]
