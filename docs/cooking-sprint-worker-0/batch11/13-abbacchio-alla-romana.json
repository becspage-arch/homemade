      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Preheat the oven to 160C. Pat the lamb pieces dry and season with black pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil in a Dutch oven over high heat. Brown the lamb in batches for 3 to 4 minutes per side until deeply coloured. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce heat to medium. Add the garlic, rosemary, and anchovies to the pot. Cook for 2 minutes, mashing the anchovies until they dissolve."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the lamb to the pot. Pour in the white wine and vinegar. Bring to a boil, then cover and transfer to the oven."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Braise for 1 hour 15 minutes until the meat is very tender and pulling from the bone. Check occasionally and add a splash of water if the pot looks dry. Taste the sauce and adjust seasoning before serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Lamb not browning properly"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Too much lamb in the pot at once lowers the temperature. Brown in small batches with space between pieces."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Sauce too sharp from vinegar"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add a little water and cook uncovered for a few minutes to mellow the acidity."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Meat still tough after the stated time"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Older or larger cuts need more time. Cover and return to the oven for another 20 to 30 minutes."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Abbacchio alla Romana is the Easter dish of Rome. Families have cooked it for generations. The lamb is always young and the sauce is always wine-based. Anchovies are the secret ingredient most visitors do not expect. Serve it with bread to mop up every drop of the sauce."
          }
        ]
      }
    ]
  }
