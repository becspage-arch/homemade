  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pollo al "
          },
          {
            "type": "text",
            "text": "Mattone",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "mattone"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " starts by "
          },
          {
            "type": "text",
            "text": "spatchcocking",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "spatchcock"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " the chicken to flatten it, then cooks it skin-side down under a heavy weight for the first 25 minutes. The weight presses every part of the skin against the hot cast iron, crisping it uniformly. Serves 4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use a cast iron skillet as both the cooking vessel and the weight. Wrap a second cast iron pan or a brick in foil and set it on top of the chicken for the pressing stage."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "chicken-whole",
              "amount": 1,
              "unit": null,
              "prepNote": "about 1.4 kg, spatchcocked",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "extra-virgin-olive-oil",
              "amount": 3,
