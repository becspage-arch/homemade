      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dust the veal pieces generously in flour and season to taste. Heat the olive oil and butter in a dutch oven over high heat. Brown the veal for 3 to 4 minutes per side until deeply golden. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce the heat to medium. Add the onion, carrot and celery to the pan and cook for 8 minutes until softened. Add the garlic and cook for 1 more minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the white wine and let it bubble for 2 minutes, scraping up any sticky bits from the base. Add the tinned tomatoes, chicken stock, bay leaves and thyme."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the veal to the pot. The liquid should come about halfway up the sides of the meat. Bring to a gentle simmer, then cover tightly and cook on the lowest heat for 90 minutes, turning the pieces once halfway through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Check the veal . it should be completely tender and starting to pull away from the bone. If not, cover and continue for another 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the bay leaves and thyme sprigs. Mix together the chopped parsley, lemon zest and the remaining garlic clove (finely grated) to make the gremolata."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir half the gremolata into the sauce. Serve the veal in shallow bowls with the sauce spooned over and the remaining gremolata scattered on top. Serve with risotto alla milanese or mashed potato."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Sauce is thin and watery",
              "cause": "The lid was slightly ajar and too much liquid evaporated, or there was too much stock",
              "fix": "Remove the veal and reduce the sauce over medium heat for 5 to 8 minutes uncovered until it coats the back of a spoon"
            }
          },
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Veal is still tough after 90 minutes",
              "cause": "The heat was too low or the cut was very thick",
              "fix": "Cover and continue braising over very low heat, checking every 20 minutes with a skewer"
            }
          },
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "Gremolata tastes bitter",
              "cause": "White pith was included with the lemon zest",
              "fix": "Use a fine grater and a light touch on the lemon to get only the yellow outer layer, avoiding the white pith beneath"
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Osso buco is a Milanese dish that has been on restaurant menus in the city since the 19th century. The traditional pairing is with saffron risotto, which is spooned into the same bowl. The marrow in the bone is the prize . use a small spoon to scoop it out. Milan also has a version without tomatoes, which is the older of the two."
          }
        ]
      }
    ]
  }
