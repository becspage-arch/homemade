      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the olive oil in a large saucepan or wide pot over medium heat. Add the onion and cook for 8 minutes until soft. Add the garlic and cook for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the white wine and let it bubble for 2 minutes. Add the tinned tomatoes, crushing them with a spoon, and the fish stock. Simmer for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the squid rings to the broth. Simmer gently for 8 minutes until just tender. Do not boil hard or the squid will toughen."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the clams. Cover and cook for 4 minutes, shaking the pot once or twice, until all the clams have opened. Discard any that stay closed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the prawns and cook for 2 to 3 minutes until they are pink all the way through. Remove from the heat immediately."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter the parsley over the soup and stir. Ladle into wide bowls and serve with bread to soak up the broth."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "The squid is rubbery",
              "cause": "It cooked at too high a temperature or for too long.",
              "fix": "Keep the heat at a gentle simmer, not a boil. Squid needs either very quick cooking (under 2 minutes) or long slow cooking (over 30 minutes) to be tender."
            }
          },
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "The clams did not open",
              "cause": "They may be dead or the heat was too low.",
              "fix": "Discard any clams that stay firmly shut after 5 minutes of covered cooking. Increase the heat slightly and give the pot a good shake before discarding."
            }
          },
          {
            "type": "troubleshootItem",
            "attrs": {
              "symptom": "The broth tastes thin",
              "cause": "The base was not reduced enough before the seafood was added.",
              "fix": "Remove the seafood and boil the broth hard for 5 minutes to concentrate it, then return the seafood briefly to warm through."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fish soup in Italy was fisherman food . made on the boat from the smallest, least saleable catch of the day. Every port has a different name and a different mix of fish. In Livorno it is called cacciucco. In the Marche it is brodetto. What they share is the idea of using the sea's variety rather than just one fish. The dish has long outgrown its humble roots and now appears on restaurant menus across the country."
          }
        ]
      }
    ]
  }
