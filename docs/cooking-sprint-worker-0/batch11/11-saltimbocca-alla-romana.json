              "amount": null,
              "unit": "pinch",
              "prepNote": "freshly ground, to taste",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lay the veal escalopes on a board. Place one sage leaf on each, then lay a slice of prosciutto on top. Press firmly so the prosciutto adheres. Season the underside with black pepper only."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the butter and olive oil in a large frying pan over high heat until the foaming subsides."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the veal prosciutto-side down in a single layer. Cook for 2 minutes until the prosciutto is golden and slightly crisp."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Flip and cook the veal side for 1 minute. Transfer to a warm plate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the white wine into the hot pan and scrape up any browned bits. Let it bubble for 1-2 minutes until reduced by half. Spoon the sauce over the veal and serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Prosciutto not crisping"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The pan is not hot enough or is overcrowded. Cook in batches if needed and make sure the fat is properly foaming before adding the meat."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Veal tough and dry"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The escalopes were too thick or cooked too long. Beat them to about 5 mm and keep to the stated cooking times."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Sauce too thin"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce the wine a little longer, or swirl in a small knob of cold butter off the heat to emulsify and thicken."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Saltimbocca is a Roman classic found in trattorias across the city. It is simple food cooked with care. Romans eat it as a secondo, the main course after pasta. The dish works well on weeknights and is fast enough for guests. It has been part of Roman cooking for well over a century."
          }
        ]
      }
    ]
  }
