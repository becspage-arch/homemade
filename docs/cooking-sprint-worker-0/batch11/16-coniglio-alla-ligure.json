      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pat the rabbit pieces dry. Season with black pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 3 tablespoons of olive oil in a Dutch oven over high heat. Brown the rabbit pieces in batches for 3 to 4 minutes per side until golden. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the remaining oil to the pot. Reduce heat to medium and cook the onion and garlic for 5 minutes until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the rabbit to the pot. Pour in the white wine and let it bubble for 2 minutes. Add the stock, olives, pine nuts, rosemary, thyme, and bay leaves."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a gentle simmer, cover, and cook over low heat for 55 to 60 minutes until the rabbit is tender and coming away from the bone. Remove the lid for the last 10 minutes to reduce the sauce. Remove the herb sprigs and bay leaves before serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Rabbit dry and stringy"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rabbit dries out quickly over high heat. Keep the braise at a very gentle simmer and make sure the pot stays covered for most of the cooking time."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Sauce too thin"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the rabbit and boil the liquid uncovered for 5 to 10 minutes until it thickens and coats a spoon."
                  }
                ]
              }
            ]
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "issue": "Pine nuts too bitter"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add them with only 15 minutes of cooking left rather than at the start. Long cooking can turn pine nuts slightly bitter."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Coniglio alla Ligure is the Sunday dish of the Ligurian hills. Rabbit was the affordable meat of rural families. Olives and pine nuts grew everywhere and went into everything. The dish is earthy, fragrant, and very much of its landscape. It pairs well with polenta or crusty bread."
          }
        ]
      }
    ]
  }
