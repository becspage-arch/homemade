  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Baccala alla Vicentina uses the technique of very slow "
          },
          {
            "type": "text",
            "text": "mantecatura",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "mantecatura"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " applied to "
          },
          {
            "type": "text",
            "text": "baccala",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "baccala"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " braised in milk for 4 hours, producing a rich, creamy dish eaten with soft polenta. This is not a quick dinner. It rewards patience with extraordinary depth. Serves 4 to 6."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Salt cod must be soaked for 48 hours in cold water with multiple water changes to remove excess salt before cooking. This is not optional."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
