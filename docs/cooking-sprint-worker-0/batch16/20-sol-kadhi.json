              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk coconut milk and yoghurt together in a bowl until smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add lime juice, garlic, green chilli, and salt. Stir well. Taste and adjust lime and salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a small pan over medium heat. Add cumin seeds. Fry for 30 seconds until they turn golden and fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the hot cumin oil directly into the coconut mixture. Stir."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add fresh coriander. Serve at room temperature or chilled. Do not heat the finished drink."
                  }
                ]
              }
            ]
          }
        ]
