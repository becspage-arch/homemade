      "slug": "pithla-term",
      "term": "Pithla",
      "definition": "A Maharashtrian chickpea flour curry with a loose, pourable texture. The name comes from pith, meaning chickpea flour in Marathi."
    },
    {
      "slug": "bhakri",
      "term": "Bhakri",
      "definition": "A Maharashtrian flatbread made from millet, jowar, or bajra flour. Coarser and crispier than wheat roti. The traditional accompaniment to pithla."
    },
    {
      "slug": "dry-pithla",
      "term": "Dry Pithla",
      "definition": "A thicker, drier version of pithla cooked until it pulls away from the pan. Used as a filling for bhakri sandwiches."
    }
