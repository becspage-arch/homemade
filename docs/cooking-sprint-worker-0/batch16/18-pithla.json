  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pithla"
          },
          {
            "type": "text",
            "text": " is made from chickpea flour cooked with water: "
          },
          {
            "type": "text",
            "text": "pithla term ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "pithla-term"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". The traditional partner is "
          },
          {
            "type": "text",
            "text": "bhakri ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bhakri"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". A thicker, firmer version called "
          },
          {
            "type": "text",
            "text": "dry pithla",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dry-pithla"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " can be made by reducing it further. This recipe makes the more common loose version."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Whisk the chickpea flour and water together until smooth before adding to the pan. Lumps that go into a hot pan cannot be whisked out."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
