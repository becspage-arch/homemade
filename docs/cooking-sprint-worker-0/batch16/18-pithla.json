      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk chickpea flour with 600ml cold water until completely smooth. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a medium saucepan over medium heat. Add mustard seeds and wait for them to pop."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add cumin, asafoetida, curry leaves, and green chilli. Fry 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion. Cook for 5 minutes until softened. Add garlic and turmeric. Cook 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the chickpea flour mixture. Stir constantly as it will thicken quickly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook for 8 minutes, stirring, until the pithla is thick enough to coat the back of a spoon. Add salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Finish with fresh coriander. Serve immediately with roti or rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pithla has lumps throughout",
              "cause": "Flour not whisked with cold water before adding to the hot pan",
              "fix": "Always whisk flour and water cold before combining with the hot base. Lumps in a hot pan cannot be removed."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pithla tastes raw and floury",
              "cause": "Not cooked long enough",
              "fix": "Cook for the full 8 minutes while stirring. The raw flour taste cooks out as the mixture thickens."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pithla is a peasant dish from rural Maharashtra, historically associated with farming communities in the Vidarbha and Marathwada regions. It was made with pantry staples when other ingredients were unavailable. The combination of pithla and bhakri is sometimes called the poor man's meal of Maharashtra. Today it is eaten across the state at all social levels and is considered comfort food, often made on rainy days or when cooking time is short."
          }
        ]
      }
    ]
  }
