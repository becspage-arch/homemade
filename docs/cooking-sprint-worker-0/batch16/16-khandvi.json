      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Oil two large flat baking trays or a marble surface generously. Have them ready beside the stove."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk together chickpea flour, yoghurt, turmeric, ginger, chilli, salt, and 250ml water until smooth with no lumps."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour into a heavy pan over medium heat. Stir constantly with a spatula for 12-15 minutes. The paste will thicken. Do not stop stirring."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Test by spreading a teaspoon on the oiled tray. Leave 30 seconds. If it peels off and rolls without cracking, the paste is ready."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Working very fast, spread the paste thinly across the oiled trays using a spatula. Aim for a 2-3mm thickness."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Leave to cool for 3 minutes. Score into 8cm wide strips. Roll each strip into a tight cylinder."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange rolls on a plate. Heat oil, add mustard seeds. When they pop, add sesame seeds and curry leaves. Fry 20 seconds. Pour over the rolls."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter fresh coriander over the top. Serve at room temperature."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Paste does not peel off the tray and tears when rolled",
              "cause": "Not cooked long enough. Paste still has too much moisture",
              "fix": "Return to the heat and cook further. Do the rolling test again before spreading the full batch."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Paste sets too quickly and cannot be spread",
              "cause": "Spreading was not fast enough once the paste was off the heat",
              "fix": "Have your trays very close. Work with one tray at a time. If it sets, use the rest for a thick pan-set slice version instead."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Khandvi is a snack specific to Gujarat, served at tea time and at Gujarati social gatherings. It requires considerable skill to execute well, which is why it has a reputation as a test of a cook's ability. The dish is associated with Gujarati food culture more broadly than any one city, but Ahmedabad and Surat are known for particularly good versions. It is eaten at room temperature with green coriander chutney."
          }
        ]
      }
    ]
  }
}