      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dry-roast the semolina in a pan over medium heat, stirring constantly, for 4 to 5 minutes until it turns light golden and smells nutty. Transfer to a bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In the same pan, heat ghee. Fry cashews until golden. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add mustard seeds to the ghee. When they pop, add cumin, curry leaves, asafoetida, and green chilli. Fry 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion and ginger. Cook 5 minutes until soft. Add carrot and peas. Cook 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring 500 ml water to a boil in a kettle. Pour into the pan. Add salt. Stir."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the roasted semolina into the boiling water in a slow, steady stream, stirring constantly to prevent lumps. Reduce heat to low. Cover and cook 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in lemon juice. Top with cashews and coriander. Serve hot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Upma has lumps",
              "cause": "Semolina was added too quickly or water was not boiling",
              "fix": "Stir vigorously to break up lumps. Add a splash of hot water and stir again."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Texture is gluey",
              "cause": "Too much water or semolina not roasted dry enough",
              "fix": "Spread on a tray and let steam escape for 2 minutes, then fluff with a fork."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Upma is a breakfast staple across South India and in Maharashtra. It is sold at railway stations, office canteens, and small restaurants called darshinis in Bangalore. The dish is also eaten in parts of Gujarat under the name soji. In Tamil Nadu it is called rava upma and is often served with coconut chutney. The name comes from Sanskrit words meaning 'top' and 'flour', referring to the grain added on top of the cooking liquid."
          }
        ]
      }
    ]
  }
