  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The key to good upma is dry-roasting the "
          },
          {
            "type": "text",
            "text": "semolina",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "semolina"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " first until it smells nutty. A small pinch of "
          },
          {
            "type": "text",
            "text": "asafoetida",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "asafoetida"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in the tempering adds depth without announcing itself."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use a 1:2.5 ratio of semolina to water. Pour the water in all at once and stir immediately to prevent lumps."
          }
        ]
      },
