      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the muthia: mix chickpea flour, fenugreek seeds, 0.5 tsp salt, and enough water to form a stiff dough. Shape into small cylinders. Steam for 10 minutes. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend coconut cream, coriander, garlic, ginger, and green chilli to a smooth paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a heavy pan. Add cumin seeds and let splutter 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add potatoes and aubergine. Stir and cook 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the coconut paste, turmeric, ground coriander, and remaining salt. Stir well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add green beans, peas, and the steamed muthia. Add 100ml water. Stir gently."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover tightly and cook on very low heat for 25 minutes. Check once and add a splash of water if needed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Finish with lemon juice. Serve with puri or roti."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Vegetables stick to the bottom and burn",
              "cause": "Heat too high or pan too thin",
              "fix": "Use a heavy-based pan. Keep heat at the lowest setting. Add more water if needed."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Muthia are very dense and chewy",
              "cause": "Dough was too stiff or steamed too long",
              "fix": "The dough should be firm but not completely stiff. Steam just until set, about 10 minutes."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Undhiyu is the festival food of Gujarat, made at Uttarayan in January. Winter vegetables are at their best then, and the dish is traditionally slow-cooked underground in clay pots."
          }
        ]
      }
    ]
  }
