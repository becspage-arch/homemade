      "slug": "undhiyu-term",
      "term": "Undhiyu",
      "definition": "A Gujarati vegetable dish whose name derives from the word undhu, meaning upside down. It was traditionally cooked in an inverted clay pot buried in the earth over a fire."
    },
    {
      "slug": "methi-muthia",
      "term": "Methi Muthia",
      "definition": "Steamed or fried dumplings made from chickpea flour and fresh fenugreek leaves. Added to undhiyu for texture and flavour."
    },
    {
      "slug": "surti-papdi",
      "term": "Surti Papdi",
      "definition": "Flat green beans from the Surat region of Gujarat, the traditional undhiyu bean. Green beans are a suitable substitute."
    }
  ],
