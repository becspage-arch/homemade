    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kheer",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "kheer"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " needs full-fat milk and low heat. High heat causes the milk to split. A few drops of "
          },
          {
            "type": "text",
            "text": "rose water",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "rose-water"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " stirred in at the end is traditional and optional."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stir every 10 minutes to prevent the milk solids sticking to the bottom. The kheer is done when it coats the back of a spoon thickly."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
