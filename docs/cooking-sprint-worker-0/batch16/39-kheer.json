      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring the milk to a gentle simmer in a heavy pot over low-medium heat. Add the rinsed rice. Stir."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer on low heat for 45 to 50 minutes, stirring every 8 to 10 minutes. The milk should reduce by about one third and the rice become very soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add sugar and crushed cardamom. Stir and cook another 5 to 8 minutes until the sugar dissolves and the kheer is thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in saffron milk if using. Taste and add more sugar if needed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve warm in small bowls, topped with cashews, flaked almonds, and pistachio slivers. Or chill and serve cold."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Milk has caught on the bottom of the pot",
              "cause": "Heat too high or not stirring often enough",
              "fix": "Do not scrape the burnt layer. Pour the unburnt kheer into a clean pot and continue cooking on lower heat."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Kheer is too thin after an hour",
              "cause": "Rice variety releases too little starch, or heat was too low",
              "fix": "Increase heat slightly and cook a further 10 to 15 minutes, stirring constantly."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kheer is one of the oldest recorded dishes in Indian culinary history, appearing in Sanskrit texts from the first millennium. It is made across South Asia under different names: payasam in South India, payesh in Bengal, firni in the North (made with ground rice). It is prepared at Hindu, Muslim, and Sikh religious ceremonies, offered at temples, and served at the conclusion of wedding feasts. Each region has a slightly different spice combination or garnish."
          }
        ]
      }
    ]
  }
