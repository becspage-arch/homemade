      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dry-roast peppercorns, cumin, fennel, star anise, cloves, cardamom, cinnamon, and dried red chillies in a dry pan for 2 minutes. Grind to a coarse powder."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a large pan. Add curry leaves and fry 30 seconds until they crackle."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onions. Cook over medium heat for 15 minutes until very soft and golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic and ginger. Cook 2 minutes. Add tomatoes and cook until they break down, about 8 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the ground masala, turmeric, and coriander. Stir and cook 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add chicken and salt. Stir to coat. Cook on medium-high heat for 5 minutes to seal the surface."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add coconut milk and 150ml water. Stir, cover, and simmer on low heat for 35 minutes until the chicken is cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the lid and cook 10 more minutes to reduce the sauce. Finish with fresh coriander."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Masala tastes flat despite using all the spices",
              "cause": "Spices were not dry-roasted before grinding",
              "fix": "Dry-roasting in a hot pan activates the volatile oils. Do not skip this step."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce is oily at the surface",
              "cause": "Coconut milk has split from high heat",
              "fix": "Keep heat at a gentle simmer after adding coconut milk. High heat causes the emulsion to break."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The Chettiars were a community of merchants and bankers who traded across Southeast Asia from their base in the Chettinad region of Tamil Nadu. They brought back spices and flavour influences from Burma, Sri Lanka, and Malaysia. The resulting cuisine is one of the most complex in India, using spices like kalpasi and marathi mokku that appear almost nowhere else in Indian cooking. The food is generally non-vegetarian and pepper-heavy."
          }
        ]
      }
    ]
  }
