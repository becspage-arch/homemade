  "glossaryTerms": [
    {
      "slug": "chettinad-masala",
      "term": "Chettinad Masala",
      "definition": "A freshly ground spice blend from the Chettinad region. It typically includes peppercorns, kalpasi, marathi mokku, and star anise alongside the usual warming spices."
    },
    {
      "slug": "kalpasi",
      "term": "Kalpasi",
      "definition": "Stone flower, a dried lichen used in Chettinad cooking. It has a woody, earthy aroma. Also called dagad phool in Hindi."
    },
    {
      "slug": "curry-leaves",
      "term": "Curry Leaves",
      "definition": "Fresh or dried leaves from the Murraya koenigii tree. They have a fragrant, slightly citrus-savoury aroma and are used across South Indian cooking."
    }
  ],
