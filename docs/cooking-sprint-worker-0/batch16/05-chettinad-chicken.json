  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "What makes this curry stand apart is the freshly ground "
          },
          {
            "type": "text",
            "text": "chettinad masala ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "chettinad-masala"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", which includes the dried lichen "
          },
          {
            "type": "text",
            "text": "kalpasi",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "kalpasi"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and a large quantity of fresh "
          },
          {
            "type": "text",
            "text": "curry leaves ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "curry-leaves"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". Kalpasi is available from specialist Indian grocery shops and is worth seeking out. Star anise is the closest widely available substitute."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Grind the whole spices fresh for this recipe. Pre-ground spice blends cannot replicate the complexity of a freshly ground Chettinad masala."
          }
        ]
      },
