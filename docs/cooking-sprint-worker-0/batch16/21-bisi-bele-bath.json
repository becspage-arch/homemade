      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a large pot, combine lentils with 700 ml water. Bring to a boil, skim foam, then simmer 15 minutes until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add rice, potato, carrot, tomato, turmeric, chilli powder, and salt. Stir and add 400 ml more water. Simmer 20 minutes, stirring occasionally."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in peas, tamarind paste, coriander, and garam masala. Cook 5 more minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a small pan, heat ghee. Add mustard seeds and wait for them to pop. Add cumin seeds, curry leaves, and onion. Fry 8 minutes until onion is golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the temper over the rice and lentil pot. Stir to combine. Top with cashews and fresh coriander. Serve hot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Mixture is too thick and stodgy",
              "cause": "Not enough water added during cooking",
              "fix": "Stir in boiling water, a ladleful at a time, until the consistency is porridge-like."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Tastes flat",
              "cause": "Not enough tamarind or salt",
              "fix": "Add another half teaspoon of tamarind paste and taste again. Adjust salt."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bisi bele bath is a signature dish of Karnataka state in southern India. The name means 'hot lentil rice' in Kannada. It originated in the Udupi temple kitchen tradition and has been eaten for centuries. Today it is served at weddings, temples, and street stalls across Karnataka. It is often accompanied by papad and a dollop of ghee on top."
          }
        ]
      }
    ]
