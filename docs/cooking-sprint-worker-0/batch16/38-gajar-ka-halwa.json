      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put grated carrot and whole milk into a wide heavy pan. Bring to a simmer over medium heat. Cook uncovered, stirring occasionally, for 40 minutes until all the milk has been absorbed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add ghee to the carrot mixture. Stir and fry over medium heat for 10 minutes until the carrot starts to pull away from the sides of the pan and smells toasted."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add sugar and cardamom. Stir constantly for 8 to 10 minutes until the sugar dissolves and the mixture thickens and shines."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in double cream. Cook 2 more minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a small pan, fry cashews in a knob of ghee until golden. Scatter cashews, flaked almonds, and pistachios over the halwa. Serve warm or at room temperature."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Halwa is sticking to the pan and burning",
              "cause": "Heat too high or not stirring enough at the end stage",
              "fix": "Reduce heat to low and stir constantly. A splash of milk can help loosen it if it catches."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Too wet after adding sugar",
              "cause": "Sugar draws moisture from the carrot",
              "fix": "Continue cooking and stirring over medium heat. The excess moisture will cook off in 5 to 8 minutes."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Gajar ka halwa is a winter celebration sweet across North India. The deep red carrots of Punjab, harvested in December and January, are prized for this dish for their sweetness and low water content. The halwa is made at weddings, festivals, and Diwali celebrations. It is served warm in small bowls, often with a scoop of vanilla ice cream in modern restaurants. Street vendors sell it from large flat pans during winter months in Delhi and Amritsar."
          }
        ]
      }
    ]
  }
