      "slug": "thepla-term",
      "term": "Thepla",
      "definition": "A thin Gujarati flatbread made from wholemeal flour with fresh or dried fenugreek leaves and spices. Softer and more pliable than a roti."
    },
    {
      "slug": "methi",
      "term": "Methi",
