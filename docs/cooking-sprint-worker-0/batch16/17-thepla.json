      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine flour, turmeric, chilli powder, cumin, and salt in a bowl. Add the fenugreek leaves and mix."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add yoghurt and oil. Mix. Add water gradually until the dough comes together as a soft, pliable ball."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Knead for 3 minutes. Divide into 12 balls."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll each ball on a lightly floured surface into a thin round, about 15cm across."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a dry tawa or heavy frying pan over medium-high heat until hot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook each thepla for 1-2 minutes until brown spots appear. Brush with a little oil, flip, and cook the other side."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stack the cooked thepla and keep wrapped in a cloth to stay soft. Serve with yoghurt or pickle."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Thepla tears when rolling",
              "cause": "Dough is too stiff",
              "fix": "Add a splash more yoghurt or water. The dough should be as soft as an earlobe."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Thepla is hard and chewy after cooking",
              "cause": "Cooked too long or on too low a heat",
              "fix": "Cook on high heat for a short time. A hot pan means the bread puffs and stays soft rather than drying out."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thepla is Gujarati travel food. It keeps without refrigeration for two to three days, making it suited to long journeys, and generations of Gujarati families have packed it in tiffin when travelling. In Gujarat it is eaten for breakfast with chai and pickles, or as a mid-morning snack. The methi variety is the most common, but thepla is also made with grated bottle gourd or fresh coriander in place of fenugreek."
          }
        ]
      }
    ]
  }
}