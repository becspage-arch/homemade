      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season cod pieces with turmeric and 0.5 tsp salt. Set aside for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a wide pan. Add mustard seeds and let them pop. Add curry leaves and fry 20 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion and cook over medium heat until soft and translucent, about 8 minutes. Do not brown them."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic, ginger strips, and green chillies. Cook 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add sliced tomato. Cook 3 minutes until softened. Add remaining salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in coconut milk. Bring to a very gentle simmer. Do not boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lay the seasoned fish pieces in the sauce. Spoon sauce over the top. Cover and cook on very low heat for 8 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add lemon juice. Serve immediately with appam or plain rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Coconut milk sauce splits and looks grainy",
              "cause": "Heat was too high and the coconut milk boiled",
              "fix": "Keep the sauce at the lowest possible simmer after adding coconut milk. A rolling boil breaks the emulsion."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Fish breaks apart when served",
              "cause": "Stirred the fish during cooking or overcooked it",
              "fix": "Leave the fish completely undisturbed. Check doneness by pressing the surface. Remove as soon as it flakes easily."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fish molee is closely associated with the Syrian Christian community of Kerala, also called the Nasrani community, who have lived in the state for nearly two thousand years. Their cuisine is distinct from both Hindu and Muslim Kerala food, allowing meat and fish. The mild coconut milk base was likely influenced by Portuguese traders who arrived in the 16th century. The dish is now made across Kerala and is commonly served with appam, a fermented rice flour pancake."
          }
        ]
      }
    ]
  }
