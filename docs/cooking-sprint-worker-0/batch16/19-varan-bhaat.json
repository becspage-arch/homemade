  "glossaryTerms": [
    {
      "slug": "varan",
      "term": "Varan",
      "definition": "A simple Maharashtrian cooked dal, usually made from toor dal or split peas. It is cooked until very soft, then seasoned with turmeric and a small amount of ghee or oil."
    },
    {
      "slug": "bhaat",
      "term": "Bhaat",
      "definition": "Plain steamed rice in Marathi. In the context of varan bhaat, it refers to plain boiled rice served as the base of the meal."
    },
    {
      "slug": "toop",
      "term": "Toop",
      "definition": "The Marathi word for ghee, clarified butter. Adding toop to varan bhaat at the table is considered essential and is not just a garnish."
    }
  ],
