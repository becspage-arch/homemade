      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook basmati rice: bring 600 ml water to a boil, add rinsed rice, stir, cover, and simmer on the lowest heat for 12 minutes. Take off heat and leave covered for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a pot over medium heat. Add cumin seeds and bay leaves. Fry 30 seconds until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion. Cook 12 minutes, stirring often, until deep golden brown."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic and ginger. Cook 2 minutes. Add tomato, turmeric, coriander, cumin ground, and chilli powder. Cook 15 minutes until the tomato is cooked down and the oil separates around the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add beans, salt, and 300 ml water. Simmer 20 minutes until the gravy is thick and the beans are well coated."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in garam masala. Taste and adjust salt. Serve over rice with coriander on top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Curry tastes raw and acidic",
              "cause": "The tomato masala was not cooked long enough",
              "fix": "Continue cooking the masala base, stirring frequently, until the tomato is completely broken down and the oil pools around the edges."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Beans are too firm",
              "cause": "Tinned beans not warmed through, or dried beans under-cooked before adding",
              "fix": "Add 100 ml water and cook a further 15 minutes, partially mashing a few beans to thicken the gravy."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rajma chawal is the default Sunday lunch in millions of North Indian households. It is considered comfort food in the way that a roast dinner is in Britain. The dish is especially associated with Delhi and Punjab. Kidney beans were introduced to India from the Americas via trade routes and became embedded in North Indian cooking within a few generations. The combination of rajma and plain rice eaten together is considered a complete meal."
          }
        ]
      }
    ]
  }
