      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rinse rice flakes in a colander under cold water for 20 seconds. Shake off excess water. Leave to rest 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a wide pan. Add peanuts and fry 2 minutes until golden. Remove with a slotted spoon and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In the same oil, add mustard seeds. When they pop, add cumin seeds, curry leaves, and green chilli. Fry 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion and potato. Cook 8 minutes until the potato is soft. Add turmeric and peas. Stir 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the soaked rice flakes, salt, and sugar. Toss gently to combine. Cook 2 minutes over low heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Squeeze over lemon juice. Top with coriander and fried peanuts. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rice flakes are mushy",
              "cause": "Too much water left on the flakes after rinsing",
              "fix": "Next time, shake the colander vigorously and leave to drain for the full 5 minutes before using."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Poha is sticking to the pan",
              "cause": "Pan not oiled enough or heat too high",
              "fix": "Add a drizzle of oil and toss gently. Reduce heat to low."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Poha is the default morning meal in Madhya Pradesh and Maharashtra. In Indore, poha stalls serve it with jalebis on the side, a sweet and savoury combination unique to the city. It is also popular in Gujarat, where it is made without potato, and in parts of Odisha, where it is eaten with milk. The Nagpuri version adds sev on top. Street hawkers sell it from carts outside offices and schools from early morning."
          }
        ]
      }
    ]
  }
