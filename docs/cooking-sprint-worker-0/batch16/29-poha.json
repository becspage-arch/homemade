        "content": [
          {
            "type": "text",
            "text": "Poha",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "poha"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " cooks in under 15 minutes once you have the "
          },
          {
            "type": "text",
            "text": "tadka",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tadka"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " ready. The flakes only need a brief rinse to soften. Do not soak them or they become mushy."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rinse the flakes in a colander, shake off the water, and leave for 5 minutes. They will be perfectly soft and separate."
          }
        ]
