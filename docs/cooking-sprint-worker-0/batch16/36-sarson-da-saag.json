      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place spinach, half the garlic, ginger, green chilli, tomato, turmeric, and salt in a pot. Add 200 ml water. Bring to a boil, then simmer covered for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "If using chickpea flour, mix with 4 tablespoons of water and stir into the pot. This thickens the saag and adds a slightly nutty note. Cook 5 more minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Use a hand blender to partially blend. Leave it chunky. Stir in garam masala."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a separate small pan, heat ghee until very hot. Add cumin seeds, remaining sliced garlic, and dried chillies. Fry 2 minutes until the garlic is golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the hot tempering over the saag. Stir briefly and top with the butter. Serve with makki di roti."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Saag is watery",
              "cause": "Too much water added or not cooked down enough",
              "fix": "Cook uncovered over medium heat, stirring, until most of the water evaporates. Add chickpea flour if it needs thickening."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Bitterness remains",
              "cause": "Spinach not cooked long enough",
              "fix": "Continue cooking on low heat for another 10 to 15 minutes. The bitterness mellows with time."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sarson da saag is a winter dish of the Punjab. Mustard greens grow abundantly in Punjab fields from November onwards and are harvested for both human food and cattle fodder. The dish is eaten from December to February, always with makki di roti and a mound of white butter on top. It is associated with the harvest festival of Lohri, when families gather around bonfires and eat the dish together. Outside of Punjab, spinach is the standard substitute."
          }
        ]
      }
    ]
  }
