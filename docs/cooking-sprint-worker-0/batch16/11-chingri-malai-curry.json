      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season prawns with turmeric and 0.5 tsp salt. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a wide pan. Mix all panch phoron seeds together. Add to the oil and let splutter for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion and cook over medium heat until golden, about 8 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic, ginger, and green chilli. Cook 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in coconut milk. Add remaining salt. Bring to a gentle simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the seasoned prawns. Cook uncovered for 4 minutes until pink and just cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from heat immediately. Serve with steamed rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Prawns are rubbery and tough",
              "cause": "Overcooked",
              "fix": "Remove the pan from heat as soon as the prawns turn pink. They continue cooking from residual heat."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce is very thin",
              "cause": "Full-fat coconut milk not used or sauce not reduced",
              "fix": "Use full-fat coconut milk. Simmer for 5 minutes before adding prawns to concentrate the sauce slightly."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "West Bengal and Bangladesh share a long river delta coastline that makes prawns and fish central to the daily diet. Chingri malai curry is considered a celebration dish in Bengali households. The freshwater river prawns called golda chingri, which can grow very large, are the traditional choice. The dish uses coconut milk despite Bengal not being a coconut-growing region; the coconut was likely introduced through trade with the south."
          }
        ]
      }
    ]
  }
