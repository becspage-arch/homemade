      "slug": "chingri",
      "term": "Chingri",
      "definition": "The Bengali word for prawn. Golda chingri are large freshwater prawns. Bagda chingri are sea prawns. Either type works in this dish."
    },
    {
      "slug": "malai",
      "term": "Malai",
      "definition": "Literally cream in Bengali and Hindi. In this recipe it refers to the coconut cream that forms the sauce, not dairy cream."
    },
    {
      "slug": "panch-phoron",
      "term": "Panch Phoron",
      "definition": "A Bengali five-spice blend of equal parts fenugreek, nigella, cumin, black mustard, and fennel seeds. Used whole in tempering."
    }
  ],
