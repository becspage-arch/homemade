      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook yellow split peas in 400ml water with turmeric until very soft, about 20 minutes. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil or steam green beans until just tender, about 5 minutes. Drain."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Grind coconut cream (or desiccated coconut with a little water), 1 tsp cumin seeds, and black peppercorns to a coarse paste in a blender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine cooked split peas and green beans in a wide pan over medium heat. Add salt and the coconut paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir and cook for 5 minutes until the mixture thickens. Remove from heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a small pan. Add mustard seeds and wait for them to pop. Add 0.5 tsp cumin, dried chilli, curry leaves, and asafoetida. Fry 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the oil and spices over the kootu. Stir through and serve with rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Kootu is too thin and watery",
              "cause": "Dal not cooked down enough or too much water used",
              "fix": "Cook the dal until it is almost dry. The mixture should hold its shape when scooped."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Coconut paste tastes raw and gritty",
              "cause": "Paste was not cooked through",
              "fix": "Stir the paste into the hot vegetable and dal mixture and cook for at least 5 minutes to mellow it."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kootu is part of the Tamil Brahmin tradition, where meals are built around rice and a series of vegetable preparations. Each dish serves a different role at the table."
          }
        ]
      }
    ]
  }
