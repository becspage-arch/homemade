      "slug": "chhena",
      "term": "Chhena",
      "definition": "Fresh acid-set cheese made by curdling hot milk with lemon juice or vinegar, then draining the curds. The basis of most Bengali sweets."
    },
    {
      "slug": "sandesh-term",
      "term": "Sandesh",
      "definition": "A Bengali sweet made from kneaded fresh chhena and sugar, shaped into rounds or formed in wooden moulds."
    },
    {
      "slug": "nolen-gur",
      "term": "Nolen Gur",
      "definition": "Date palm jaggery, a seasonal Bengali ingredient with a distinctive smoky-sweet flavour used in premium sandesh. Regular jaggery is used when nolen gur is unavailable."
    }
