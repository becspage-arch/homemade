      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Soak ker and sangri (or substitute) in water overnight. Drain and rinse twice to remove bitterness."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil the soaked ker and sangri in fresh water for 15 minutes until just tender. Drain and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a wide pan over medium heat. Add cumin seeds, mustard seeds, asafoetida, and dried chillies. Let them splutter for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion and cook until golden, about 8 minutes. Add garlic and cook 2 minutes more."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add turmeric, coriander, chilli powder, and ground cumin. Stir and cook 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained ker and sangri. Stir to coat in the spices."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add tamarind paste and salt. Cook on low heat for 10 minutes, stirring occasionally, until the mixture is dry and fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Finish with fresh coriander. Serve with flatbread or rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dish tastes very bitter",
              "cause": "Ker was not soaked or rinsed enough",
              "fix": "Always soak overnight and rinse at least twice before cooking."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Mixture is watery rather than dry",
              "cause": "Too much liquid retained after cooking the ker and sangri",
              "fix": "Drain thoroughly and cook on high heat at the end to drive off moisture."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ker sangri developed in the Thar Desert of Rajasthan, where water is scarce and fresh vegetables rarely available for months at a time. Both ker and sangri grow wild in the desert and were harvested, dried, and stored. The dish was originally a food of necessity but is now considered a regional speciality. It is served at weddings and carried by travellers as a preserved food that keeps without refrigeration."
          }
        ]
      }
    ]
  }
