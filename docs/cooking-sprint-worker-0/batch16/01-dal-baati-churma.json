      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 200C. Mix wholemeal flour, 2 tbsp ghee, and salt. Add water gradually to form a stiff dough. Divide into 12 balls."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Flatten each ball slightly. Place on a baking tray. Bake for 30 minutes, turning once, until golden and hard."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook lentils and split peas together in 900ml water until very soft, about 25 minutes. Season with salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 1 tbsp ghee in a pan. Fry cumin seeds for 30 seconds. Add onion and cook until golden, about 8 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic and ginger. Cook 2 minutes. Add tomatoes, turmeric, chilli powder, and coriander. Cook until tomatoes break down."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir the tomato mixture into the cooked dal. Add garam masala. Simmer 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Crush 4 of the baked baati coarsely. Mix with remaining ghee and grated jaggery to make churma."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve the remaining baati cracked open in the dal. Place churma alongside. Top with coriander."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Baati are soft inside after baking",
              "cause": "Dough was too wet or oven not hot enough",
              "fix": "Use just enough water to bring the dough together. Bake at a full 200C."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dal is too thin",
              "cause": "Lentils not cooked long enough to thicken the liquid",
              "fix": "Simmer uncovered for an extra 10 minutes, stirring occasionally."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dal baati churma is the signature dish of Rajasthan in northwest India. The arid climate made wheat more reliable than rice, and baati could be baked over dried dung cakes in the desert. The dish is served at weddings, festivals, and family gatherings across the region. It is eaten communally, with everyone helping themselves from shared bowls of dal and churma."
          }
        ]
      }
    ]
  }
