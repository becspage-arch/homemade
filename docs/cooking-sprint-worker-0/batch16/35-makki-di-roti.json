      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix fine polenta, optional wholemeal flour, ginger, chilli, coriander, and salt in a bowl. Add warm water gradually, mixing until a stiff but pliable dough forms."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide into 8 balls. Wet your palms thoroughly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place one ball on a cold tawa. Using wet palms, press and pat it outward into a circle about 15 cm across and 5 mm thick. Patch any cracks."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the tawa over medium heat. Cook 4 minutes until the base is set and lightly golden. Drizzle a little ghee around the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Carefully flip using a wide spatula. Cook another 4 minutes until golden on the second side."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place on a plate and rub a generous piece of butter over the top immediately. Serve with sarson da saag."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Roti cracks all over when pressing",
              "cause": "Dough too dry or polenta too coarse",
              "fix": "Add a teaspoon of water to the dough, knead briefly, and add a tablespoon of wholemeal flour. The extra gluten helps hold it together."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Roti sticks to the tawa when flipping",
              "cause": "Not cooked long enough on the first side",
              "fix": "Wait until you can see the edges starting to dry out and the base has clearly set before flipping."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Makki di roti is the winter bread of Punjab, eaten from November to February when mustard greens are in season. It is always eaten with sarson da saag and a generous smear of makhan, the white Punjabi butter. Corn was introduced to Punjab through trade and became embedded in rural cooking over centuries. The bread is thicker and more substantial than wheat roti and was historically the food of agricultural workers. Many Punjabi families still eat it weekly in winter."
          }
        ]
      }
    ]
  }
