      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix chickpea flour with 0.5 tsp turmeric, 0.5 tsp chilli powder, 0.5 tsp salt, and ghee. Add water gradually to form a stiff, pliable dough."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll the dough into cylinders about 2cm thick. Cut into 3cm pieces."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring a large pot of salted water to a boil. Add the gatte and cook for 10 minutes. They are done when they float. Remove and slice in half."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reserve 200ml of the cooking water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk the yoghurt with remaining turmeric, chilli powder, coriander, garam masala, and 1 tsp salt until smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a wide pan over medium heat. Add cumin, mustard seeds, and asafoetida. Let splutter 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce heat to low. Pour in the whisked yoghurt gradually, stirring constantly. Add the reserved cooking water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer gently for 5 minutes. Add the gatte and heat through for 3 minutes. Garnish with coriander."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Yoghurt gravy splits and curdles",
              "cause": "Heat too high when adding the yoghurt",
              "fix": "Reduce to the lowest heat before adding yoghurt. Stir constantly and add it gradually."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Gatte are crumbly and fall apart in the water",
              "cause": "Dough was too dry or not kneaded enough",
              "fix": "The dough should be pliable but not sticky. Knead for at least 3 minutes."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Gatte ki sabzi is a core part of the Rajasthani thali. It was created to provide protein and substance without relying on fresh vegetables, which were scarce in the desert. Chickpea flour was ground from dried chickpeas, a reliable stored ingredient. The dish is made across Rajasthan in home kitchens and dhabas, often served with bajra roti."
          }
        ]
      }
    ]
  }
}