      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Set up your steamer. Grease the tin with a little oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix chickpea flour, yoghurt, ginger, green chilli, turmeric, salt, and lemon juice. Add water gradually to make a smooth, pourable batter with no lumps."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "When the steamer is ready, add 1 tsp eno (or 0.5 tsp baking soda) to the batter. Stir quickly and immediately pour into the tin."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Steam for 15 minutes on medium heat. Insert a skewer: it should come out clean."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from steamer. Allow to cool 3 minutes, then cut into squares or diamonds in the tin."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a small pan. Add mustard seeds and let pop. Add curry leaves and sesame seeds. Pour over the dhokla immediately."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter fresh coriander over the top. Serve with green chutney."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dhokla is dense and does not rise",
              "cause": "Eno not mixed in fast enough or batter sat before steaming",
              "fix": "Add eno at the last moment. Pour into the tin within 30 seconds and get it into the steamer immediately."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Surface is wet and the dhokla collapses when cut",
              "cause": "Undercooked or steamer not hot enough",
              "fix": "Steam for the full 15 minutes. The surface should feel firm and a skewer should come out dry."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dhokla is sold from breakfast onwards at street stalls and shops across Gujarat. It is eaten as a snack, packed in tiffin boxes, and served at weddings alongside other Gujarati snacks. The traditional khaman dhokla uses a fermented batter of split black gram and chickpea flour soaked overnight. This recipe uses the faster instant version that has become standard in most home kitchens."
          }
        ]
      }
    ]
  }
