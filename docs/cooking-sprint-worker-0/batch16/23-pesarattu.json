        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain the soaked split peas and rice. Blend with ginger, green chilli, cumin, salt, and enough water to make a smooth, pourable batter."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a non-stick griddle or tawa over high heat until very hot. Lightly oil the surface."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour a ladleful of batter in the centre. Quickly spread outward in a spiral to make a thin crepe, about 20 cm across."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter a little chopped onion and coriander on top. Drizzle oil around the edges. Cook 2 to 3 minutes until the base is golden and crisp."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Flip and cook 1 minute on the other side. Serve immediately with ginger chutney."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Crepe is thick and spongy",
              "cause": "Batter is too thick or the pan was not hot enough",
              "fix": "Thin the batter with a splash of water. Ensure the pan is smoking hot before adding batter."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sticks to the pan",
              "cause": "Pan not hot enough or not enough oil",
              "fix": "Increase heat and add a little more oil around the edge before the next crepe."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pesarattu are a breakfast food from Andhra Pradesh and Telangana in south India. They are typically eaten with upma stuffed inside and a small bowl of allam chutney, a sharp ginger-based condiment. Because they use pulses rather than fermented batter, they require no overnight fermentation like dosa does. Street carts across Hyderabad and Vijayawada sell them from early morning."
          }
        ]
      }
    ]
  }
