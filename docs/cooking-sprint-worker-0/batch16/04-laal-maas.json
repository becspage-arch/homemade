      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Marinate lamb in yoghurt, half the garlic and ginger, chilli paste, and chilli powder for at least 2 hours, ideally overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat ghee in a heavy casserole over high heat. Brown the lamb in batches until deep brown on all sides. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In the same pot, add cloves, cardamom, and cinnamon stick. Fry 30 seconds until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add sliced onions. Cook on medium heat, stirring often, for 20 minutes until deep golden brown."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add remaining garlic and ginger. Cook 2 minutes. Add coriander, cumin, and turmeric. Cook 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the lamb and all its marinade. Add salt and 200ml water. Stir well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a boil, then reduce to the lowest heat. Cover tightly. Cook for 60 minutes until the lamb is very tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Uncover and cook 10 more minutes until the oil separates to the surface. Finish with fresh coriander."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Curry is dull orange rather than deep red",
              "cause": "Dried chillies were not used or were weak in colour",
              "fix": "Use Kashmiri chilli powder, which is mild but deeply pigmented. Or soak more dried red chillies and increase the paste."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Lamb is tough after an hour of cooking",
              "cause": "Heat was too high and the liquid evaporated",
              "fix": "Add a little more water and continue cooking on very low heat. Bone-in lamb shoulder needs full time at low heat."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Laal maas was originally prepared by Rajput hunters using wild boar or game brought back from the hunt. The heavy use of chilli reflected both the availability of the spice and the tastes of a warrior class who ate meat-heavy diets. The dish is now associated with Rajasthani festive cooking and is served at weddings and special occasions. It is eaten with flatbread, never rice, in the traditional manner."
          }
        ]
      }
    ]
  }
