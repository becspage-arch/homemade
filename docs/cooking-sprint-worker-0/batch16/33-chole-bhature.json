      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the bhature dough: mix plain flour, a pinch of salt, 1 teaspoon oil, and yoghurt. Add water gradually to form a soft, pliable dough. Knead 5 minutes. Cover and rest 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 4 tablespoons of oil. Add cumin seeds, bay leaves, cinnamon, cardamom, and cloves. Fry 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion. Cook 12 minutes until deep golden. Add garlic and ginger. Cook 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add tomato puree, turmeric, coriander, cumin, and chilli powder. Cook 10 minutes until thick and the oil separates."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add chickpeas, tamarind paste, garam masala, salt, and 250 ml water. Simmer 20 minutes. Adjust consistency with water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide bhature dough into 8 balls. Roll each to a thin oval about 15 cm long."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat frying oil to 180 C. Fry each bhature one at a time, pressing gently with a slotted spoon to help it puff. Fry 1 to 2 minutes per side until golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain bhature on paper. Serve immediately with the chole, coriander, and sliced raw onion."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Bhature do not puff",
              "cause": "Dough was too stiff or oil not hot enough",
              "fix": "Check oil temperature with a small piece of dough. It should rise immediately. If dough is stiff, add a teaspoon of water and knead again."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Chole is too thin",
              "cause": "Not enough cooking time for the gravy to reduce",
              "fix": "Mash a quarter of the chickpeas against the side of the pot. This thickens the gravy quickly without adding starch."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chole bhature originated in the Punjab region and became the defining street food of Delhi from the 1950s onwards. It is eaten as a hearty breakfast or lunch, never dinner. The dish is associated with the Katra Neel area of Old Delhi and Nai Sarak, where specialist shops have been serving it for generations. It is also sold at railway stations and dhabas across North India. The combination is considered too heavy for evenings."
          }
        ]
      }
    ]
  }
