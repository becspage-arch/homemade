      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend coconut cream with cumin seeds and green chillies to a coarse paste using a little water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put potato, aubergine, and green beans in a wide pan. Add turmeric, salt, and just enough water to barely cover."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and cook over medium heat for 10 minutes until the potato is just tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add courgette and peas. Cook 3 more minutes uncovered."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the coconut paste. Cook 3 minutes on low heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from heat. Stir in the whisked yoghurt and half the curry leaves. Do not boil after adding yoghurt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drizzle with coconut oil and scatter remaining curry leaves over the top. Serve immediately with rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Vegetables turn to mush",
              "cause": "Cooked too long or too much water used",
              "fix": "Use the minimum water needed and check the potatoes after 8 minutes. Remove from heat while they still hold their shape."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dish is very thick and dry",
              "cause": "Water evaporated before the vegetables were cooked",
              "fix": "Add a splash of water and stir. The finished dish should be moist, not dry."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Avial is one of the oldest Kerala dishes. Legend credits its invention to Bhima, one of the Pandava brothers, who cooked it during their time in hiding."
          }
        ]
      }
    ]
  }
}