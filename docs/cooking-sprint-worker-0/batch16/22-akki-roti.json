      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix rice flour, onion, chilli, ginger, coriander, cumin, carrot, and salt in a bowl. Add coconut milk if using."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add warm water gradually, mixing until a soft, pliable dough forms. It should not crack at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide into 8 balls. Wet your fingers. Press each ball onto a cold tawa into a thin circle, about 15 cm across."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the tawa over medium heat. Drizzle a little oil around the edges. Cook 3 to 4 minutes until the underside is golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Flip carefully and cook 2 to 3 minutes on the other side. Serve immediately with coconut chutney."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dough cracks when spreading",
              "cause": "Dough is too dry",
              "fix": "Wet your fingers more and add a teaspoon of water to the dough. Knead briefly."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Roti tears when flipping",
              "cause": "Flipped too early before the underside set",
              "fix": "Wait until the edges look dry and the bottom is golden before flipping."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Akki roti is eaten across Karnataka as a morning meal. Akki means rice in Kannada. Because it uses rice flour rather than wheat, it is naturally gluten-free and has been a daily staple for generations. Different households add different vegetables depending on what is available. It is typically served with coconut chutney or saaru, a thin lentil broth."
          }
        ]
      }
    ]
  }
