      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil potatoes and cauliflower until very soft. Drain and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt butter in a large pan over medium heat. Add onion and cook 10 minutes until soft and starting to brown. Add garlic and ginger. Cook 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add green pepper. Cook 4 minutes. Add tomato and tomato puree. Cook 8 minutes until very thick and jammy."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add turmeric, chilli powder, garam masala, and salt. Stir for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add boiled potato, cauliflower, and peas to the pan. Mash everything together with a potato masher. Stir and cook 10 minutes, mashing as you go."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add a knob of butter on top and scatter fresh coriander. Serve with toasted buttered rolls and lemon wedges."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Bhaji is too watery",
              "cause": "Vegetables were not drained well enough, or cook time too short",
              "fix": "Cook uncovered over higher heat, stirring constantly, until the water evaporates."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Tastes bland",
              "cause": "Not enough spice or salt",
              "fix": "Add another teaspoon of garam masala and half a teaspoon of salt. Cook 2 more minutes."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pav bhaji was created in Mumbai's Chira Bazaar area as a fast, filling meal for mill workers. The pav bread itself arrived with Portuguese colonists. Today it is sold from griddle carts across Mumbai from mid-afternoon until late at night. The street version uses a separate tawa for the bhaji and another for the rolls, both slathered in butter. It is now popular across India and sold in restaurants and canteens nationwide."
          }
        ]
      }
    ]
