      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a heavy pot. Add mustard seeds. When they pop, add curry leaves and dried red chillies. Fry 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion and cook 12 minutes over medium heat until deep golden. Add garlic and ginger. Cook 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add tomato, turmeric, coriander, cumin, and chilli powder. Cook 8 minutes, mashing the tomato, until the oil separates."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add lamb and salt. Increase heat and fry, stirring frequently, for 10 minutes until the lamb is sealed and browned."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add 250 ml water. Cover and simmer on low heat for 45 minutes until the lamb is tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in spinach and tamarind paste. Cook uncovered 10 minutes until the spinach wilts and the sauce thickens. Add garam masala and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Lamb is still tough after the cook time",
              "cause": "The pieces are too large or the heat was too low",
              "fix": "Add 100 ml more water and continue cooking, covered, for another 20 minutes."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce tastes too sour",
              "cause": "Too much tamarind for the quantity of spinach",
              "fix": "Add a pinch of sugar and a splash of water. Stir and taste again."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Gongura mutton is one of the most celebrated dishes of Andhra Pradesh. Gongura leaves, also called sorrel or roselle, are central to Andhra cooking. They grow easily in the region's hot climate and add a distinctive tartness. The dish is eaten at Sunday lunches and festive meals across the state. It is almost always served with plain rice to balance the heat."
          }
        ]
      }
    ]
  }
