      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer red lentils in 300ml water for 15 minutes until very soft. Blend or mash to a smooth liquid."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the tamarind water, chopped tomatoes, crushed garlic, crushed pepper, turmeric, and salt in a saucepan. Simmer for 10 minutes until tomatoes soften."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the blended lentil liquid to the tamarind tomato base. Stir and simmer 5 minutes. The broth should be thin and pourable."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a small pan. Add mustard seeds and wait for them to pop. Add cumin seeds, dried chilli, curry leaves, and asafoetida. Fry 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the spiced oil directly into the rasam. Stir and taste for salt and sourness."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Finish with fresh coriander. Serve hot as a soup or pour over plain rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rasam tastes too sour",
              "cause": "Too much tamarind paste or it was not diluted enough",
              "fix": "Add more water and a pinch of sugar to balance. Taste before adding the full amount of tamarind."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth is cloudy and thick",
              "cause": "Too many lentils used or not thinned enough",
              "fix": "Add more water. Rasam should run like a thin soup, not cling to the spoon."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rasam is eaten in Tamil Nadu as a second course after sambar and rice. It is also drunk warm on its own as a remedy for colds and poor digestion. Every Tamil household has its own version, with variations in the ratio of pepper to tamarind. The name comes from a Sanskrit and Tamil word meaning juice or liquid. It is also found in Karnataka and Andhra Pradesh under different names."
          }
        ]
      }
    ]
  }
