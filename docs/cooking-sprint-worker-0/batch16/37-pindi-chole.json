                }
              }
            ]
          },
          {
            "type": "text",
            "text": " chole uses tamarind as the primary sour note, substituting for "
          },
          {
            "type": "text",
            "text": "anardana",
            "marks": [
              {
                "type": "glossaryTooltip",
