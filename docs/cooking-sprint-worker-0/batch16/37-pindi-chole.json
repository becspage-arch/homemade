      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a heavy pan over medium-high heat. Add cumin seeds. When they sizzle, add onion and cook 12 minutes until deep golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic and ginger matchsticks. Fry 3 minutes until starting to colour. Add green chilli."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add cumin ground, coriander, chilli powder, and turmeric. Stir constantly for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add chickpeas, tamarind paste, and salt. Toss to coat evenly. Cook over high heat 10 to 12 minutes, stirring frequently, until the chickpeas are slightly charred in places and very dry."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garam masala. Toss again. Taste and adjust salt and tamarind. Serve topped with fresh coriander and lemon wedges."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Chickpeas are watery and bland",
              "cause": "Heat was too low or moisture was trapped",
              "fix": "Cook uncovered over high heat, tossing constantly, until the moisture evaporates and the chickpeas start to colour."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Spices are burning",
              "cause": "Heat too high with dry spices and not enough oil",
              "fix": "Add a splash of water and stir immediately. Reduce heat to medium."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pindi chole comes from Rawalpindi, a major city in the Punjab region of what is now Pakistan. After Partition in 1947, Punjabi families who moved to India brought the recipe with them, and it became well established in Delhi and Amritsar. Unlike the gravy-based chole masala common in restaurants, pindi chole is dry and served at room temperature, making it a popular street food and takeaway dish. It is often sold alongside kulcha or puri."
          }
        ]
      }
    ]
  }
