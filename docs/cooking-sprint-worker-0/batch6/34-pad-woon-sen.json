  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pad woon sen serves 2 and takes about 20 minutes. The traditional glass noodles are made from mung bean starch and are not listed in this library. "
          },
          {
            "type": "text",
            "text": "Rice vermicelli",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "rice-vermicelli"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " soaked in warm water for 5 minutes gives a very similar result. The dish is seasoned with "
          },
          {
            "type": "text",
            "text": "oyster sauce",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "oyster-sauce"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "text",
            "text": "light soy sauce",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "soy-sauce-light"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", and a finish of "
          },
          {
            "type": "text",
            "text": "sesame oil",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "sesame-oil"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Soak the rice vermicelli in warm (not boiling) water for exactly 5 minutes. They continue to soften in the hot wok. Over-soaked noodles turn to mush."
          }
        ]
      },
      {
        "type": "heading",
