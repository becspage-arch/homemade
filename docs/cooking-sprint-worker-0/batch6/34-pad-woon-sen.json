      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over high heat. Add the garlic and fry for 20 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the pork mince. Break it up and fry for 4 minutes until browned."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Push the pork to one side. Pour in the beaten eggs and scramble lightly. Fold through the pork before fully set."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained rice vermicelli. Toss to combine. Add a splash of water if the noodles are sticking."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add {{oyster-sauce}} and {{soy-sauce-light}}. Toss everything together for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the beansprouts and spring onions. Toss for 1 minute. Remove from the heat and drizzle with {{sesame-oil}}. Top with coriander and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Noodles are clumped together in a mass",
              "cause": "Over-soaked or not separated before adding to the wok",
              "fix": "Toss noodles with a little vegetable oil after draining to stop them sticking. Add a splash of water to the wok and toss quickly."
            },
            {
              "symptom": "Noodles are breaking into short pieces",
              "cause": "Over-soaked in boiling water",
              "fix": "Use warm water rather than boiling and limit the soak to 5 minutes."
            },
            {
              "symptom": "Dish is too salty",
              "cause": "Too much oyster sauce",
              "fix": "Reduce to 1.5 tablespoons of oyster sauce next time. Serve with lime wedges to cut the salt."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pad woon sen is a staple of Thai home cooking and street food stalls. The glass noodles made from mung bean starch have a silky, slightly chewy texture that holds sauce well. They are lower in calories than wheat noodles and very quick to prepare. The dish is flexible: pork can be swapped for chicken, prawns, or tofu. It is mild, satisfying, and well suited to weeknight cooking. The sesame oil added at the end is a Chinese-influenced touch common across many Thai noodle dishes."
          }
        ]
      }
    ]
  }
