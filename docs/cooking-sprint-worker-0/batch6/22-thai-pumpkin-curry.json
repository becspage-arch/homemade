      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Peel and cube approximately 500 g of butternut squash or pumpkin into 3 cm pieces. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pound the soaked dried chilli, shallots, lemongrass, and garlic to a rough paste in a pestle and mortar."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over medium-high heat. Fry the paste for 3 minutes until fragrant. Add the thick cream from the top of the coconut milk tin and continue to fry for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the pumpkin cubes and tofu. Toss to coat in the paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the remaining coconut milk. Add the kaffir lime leaves. Simmer for 15 to 18 minutes until the pumpkin is tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season with {{soy-sauce-light}}, {{palm-sugar}}, and lime juice. Stir in the Thai basil and serve immediately over jasmine rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Pumpkin is still firm after 18 minutes",
              "cause": "Cubes were cut too large",
              "fix": "Cover the wok and simmer for a further 5 minutes. Cut to 2 cm next time for faster cooking."
            },
            {
              "symptom": "Curry is too hot for a vegan paste",
              "cause": "Too many dried chillies in the paste",
              "fix": "Reduce to 1 or 2 dried chillies next time. The paste heat varies between brands."
            },
            {
              "symptom": "Tofu is falling apart",
              "cause": "Tofu was too soft or stirred too vigorously",
              "fix": "Use extra-firm tofu and fold gently. Add it in the last 5 minutes of cooking."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pumpkin in Thai red curry is a natural pairing. The sweetness of the pumpkin softens the heat of the paste in the same way coconut milk does. This dish is popular in Thai vegetarian restaurants, where fish sauce is replaced with soy sauce and the shrimp paste in the curry base is omitted. Butternut squash is the most widely available substitute for the kabocha squash used in Thailand. The texture and sweetness translate almost perfectly."
          }
        ]
      }
    ]
  }
}
