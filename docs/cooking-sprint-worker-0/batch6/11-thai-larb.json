  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thai larb serves 2 and takes about 20 minutes. The dish is a warm minced pork salad dressed with lime, "
          },
          {
            "type": "text",
            "text": "fish sauce",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fish-sauce"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", and "
          },
          {
            "type": "text",
            "text": "dried chilli",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dried-chilli"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". Toasted ground rice is the signature ingredient. It adds a nutty, slightly gritty texture that holds the dressing. Fresh mint (described below, no slug) is scattered over at the end."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Toast the raw rice in a dry pan until golden before grinding it. This step takes only 3 minutes and completely transforms the texture and flavour of the salad."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 2,
          "items": [
            {
              "ingredientSlug": "pork-mince",
              "amount": 250,
              "unit": "g",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "jasmine-rice",
              "amount": 2,
              "unit": "tbsp",
              "prepNote": "raw, for toasting",
