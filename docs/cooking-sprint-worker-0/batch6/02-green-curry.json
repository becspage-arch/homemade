      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the green chillies, lemongrass, galangal, shallots, garlic, shrimp paste, and coriander roots into a smooth paste using a food processor or pestle and mortar. Add a splash of water if needed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon the thick cream from the top of the coconut milk tin into a wok over a medium heat. When it sizzles, add the curry paste and fry for 3 to 4 minutes, stirring constantly, until fragrant and slightly darker."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chicken and stir to coat in the paste. Cook for 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the remaining coconut milk and add the torn kaffir lime leaves. Bring to a gentle simmer and cook for 12 to 15 minutes until the chicken is cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season with fish sauce and palm sugar. Taste and adjust. Add the Thai basil and stir once."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve over jasmine rice topped with shredded kaffir lime leaves and coriander leaves."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Curry tastes flat or watery",
              "cause": "The paste was not fried long enough. The frying step concentrates and develops the flavour.",
              "fix": "Fry the paste for at least 3 to 4 minutes. You should smell it change and see it darken slightly."
            },
            {
              "symptom": "Curry is too spicy",
              "cause": "Thai green chillies vary a lot in heat.",
              "fix": "Use fewer chillies next time, or remove the seeds before blending. Add a little more coconut milk and palm sugar to tame the heat now."
            },
            {
              "symptom": "Chicken is dry",
              "cause": "Cooked too long at too high a heat.",
              "fix": "Simmer gently rather than boiling hard. Chicken thighs are more forgiving than breast."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Green curry comes from central Thailand and is named for the colour of its fresh chilli paste. The heat of the dish comes from those same green chillies. "
          },
          {
            "type": "text",
            "text": "Kaffir lime leaves",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "kaffir-lime-leaves"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "text",
            "text": "Thai basil",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "thai-basil"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " are added at the end to keep their brightness. The ratio of paste to coconut milk is the main thing that separates a bold curry from a mild one."
          }
        ]
      }
    ]
  }
