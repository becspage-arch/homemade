      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pound the soaked dried chilli, lemongrass, galangal, shallots, garlic, and {{shrimp-paste}} together in a pestle and mortar until you have a rough paste. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Open the coconut milk tin without shaking it. Spoon the thick cream from the top into a wok over medium-high heat. Fry for 2 minutes until it begins to spit and separate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the paste to the hot cream. Stir and fry for 3 to 4 minutes until fragrant and the oil begins to show at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the pork pieces. Toss to coat in the paste and cook for 5 minutes, stirring often."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the remaining coconut milk and add the torn {{kaffir-lime-leaves}}. Bring to a simmer and cook for 15 minutes until the pork is tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season with {{fish-sauce}} and {{palm-sugar}}. Taste and adjust. The sauce should be rich, slightly sweet, and savoury."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in most of the Thai basil leaves. Serve topped with sliced red chilli and remaining basil alongside jasmine rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Curry tastes thin and watery",
              "cause": "Coconut milk was not reduced before adding the pork",
              "fix": "Simmer uncovered for 5 more minutes to concentrate the sauce."
            },
            {
              "symptom": "Paste smells burnt and bitter",
              "cause": "Heat was too high when frying the paste",
              "fix": "Start again with a lower flame. The cream should sizzle gently, not scorch."
            },
            {
              "symptom": "Pork is chewy",
              "cause": "Cook time was not long enough",
              "fix": "Continue simmering with the lid on for another 10 minutes until the pork gives easily when pressed."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Red curry is one of the most recognised dishes in Thai cooking. It appears on tables from Bangkok street stalls to home kitchens across the country. The paste is built around dried red chillies, lemongrass, and galangal. Coconut milk softens the heat and creates the silky sauce. Pork belly is the traditional choice because the fat keeps the meat moist through the long simmer. This is the dish most Thai cooks learn first."
          }
        ]
      }
    ]
  }
