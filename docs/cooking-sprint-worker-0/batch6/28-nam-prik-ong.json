      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over medium heat. Add the {{shrimp-paste}} and fry, stirring, for 30 seconds until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic, shallots, and dried chilli. Fry for 2 minutes until softened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Increase the heat to high. Add the pork mince. Break it up and cook for 5 to 6 minutes until browned."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the {{tinned-tomatoes}}. Stir to combine and simmer for 10 minutes until the sauce thickens."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season with {{fish-sauce}} and {{palm-sugar}}. Taste. The dip should be savoury, mildly spiced, and slightly sweet."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to a serving bowl. Garnish with coriander. Serve warm with beansprouts, cucumber slices, raw cabbage, and steamed sticky rice alongside."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Dip is too watery",
              "cause": "Not reduced long enough after adding the tomatoes",
              "fix": "Simmer uncovered for 5 more minutes until the sauce thickens visibly."
            },
            {
              "symptom": "Shrimp paste smell is very strong",
              "cause": "Not fried long enough before adding other ingredients",
              "fix": "Fry the shrimp paste for a full minute, stirring constantly, until the sharp raw smell fades."
            },
            {
              "symptom": "Dip is too hot",
              "cause": "Too many dried chillies",
              "fix": "Add a pinch of palm sugar. Reduce to 1 or 2 dried chillies next time."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nam prik ong is a signature of northern Thai cooking, centred in Chiang Mai and the surrounding Lanna region. Northern Thai cuisine uses less coconut milk and more dried spices and fermented pastes than central Thai cooking. Nam prik ong is always served with a selection of raw and lightly cooked vegetables for dipping. It appears at nearly every shared northern Thai meal as one of several dips around a central bowl of sticky rice. The shrimp paste is what sets it apart from any Western tomato sauce."
          }
        ]
      }
    ]
  }
