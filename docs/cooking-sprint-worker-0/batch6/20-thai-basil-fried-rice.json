      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over high heat until smoking. Add the garlic and chilli. Stir for 20 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the diced chicken. Stir-fry for 3 to 4 minutes until cooked through and starting to brown."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cold rice. Press flat and let it sit for 30 seconds. Break apart and toss. Repeat for a further 2 minutes until the rice is hot and lightly coloured."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the oyster sauce, fish sauce, soy sauce, and sugar. Toss to mix."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from the heat. Add the Thai basil leaves and fold through gently. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Rice is clumping",
              "cause": "Rice was warm or freshly cooked",
              "fix": "Use rice that has been refrigerated for at least 8 hours. Break any clumps apart with your hands before adding."
            },
            {
              "symptom": "Chicken is releasing water",
              "cause": "Pan was not hot enough or chicken was wet from washing",
              "fix": "Pat chicken dry. Ensure the wok is smoking before adding. Cook in a single layer."
            },
            {
              "symptom": "Basil turned dark and bitter",
              "cause": "Added while pan was still on the heat",
              "fix": "Take the wok off the heat completely before adding the basil."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thai basil fried rice sits between khao pad (plain fried rice) and pad krapow (basil stir-fry). It brings the freshness of the herb into the comfort of a fried rice format. It is popular at late-night street stalls where cooks move fast and the wok never cools down. The chilli level is always negotiable. Thai diners often ask for more chilli than the standard recipe calls for. The dish is best eaten the moment it leaves the pan."
          }
        ]
      }
    ]
  }
