  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Guay tiew neua serves 4 and takes about 65 minutes. The broth is built with beef, garlic, "
          },
          {
            "type": "text",
            "text": "dark soy sauce",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "soy-sauce-dark"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", and whole star anise (no slug, described below). "
          },
          {
            "type": "text",
            "text": "Flat rice noodles",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "rice-noodles-flat"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " are added at the end and the soup is topped with "
          },
          {
            "type": "text",
            "text": "fresh coriander",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "coriander-fresh"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". The spice note from the star anise gives the broth its distinctive warm depth."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use 2 whole star anise pods simmered in the broth from the start and removed before serving. Do not add them at the end or the flavour will be raw and sharp."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
