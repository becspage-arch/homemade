      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring 1.5 litres of water to the boil. Add the crushed garlic, ginger, and 2 whole star anise pods. Simmer for 15 minutes to build the base."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the {{soy-sauce-dark}}, {{soy-sauce-light}}, {{fish-sauce}}, and {{palm-sugar}}. Stir and simmer for 10 more minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove and discard the star anise pods. Taste and adjust the seasoning."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring the broth to a steady simmer. Add the sliced beef. Cook for 3 to 4 minutes until just cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the flat rice noodles in a separate pot of boiling water for 2 to 3 minutes or per packet. Drain and divide between bowls."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle the hot beef and broth over the noodles. Top with beansprouts, spring onions, fresh coriander, and chilli slices. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Broth tastes flat and watery",
              "cause": "Not enough soy sauce or simmering time",
              "fix": "Simmer uncovered for a further 10 minutes to concentrate. Add more fish sauce in small amounts."
            },
            {
              "symptom": "Beef is tough",
              "cause": "Sliced too thick or overcooked in the broth",
              "fix": "Slice beef as thin as possible, ideally 2 to 3 mm. Cook only until the pink disappears."
            },
            {
              "symptom": "Noodles have dissolved into the broth",
              "cause": "Added directly to the pot and cooked too long",
              "fix": "Always cook noodles separately and add them at the last moment."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Guay tiew neua is Thai for beef noodle soup. Noodle shops in Thailand serve it from early morning into the afternoon. The dish shows the heavy influence of Chinese immigrant cooking on Thai food. The spiced, soy-based broth owes something to Chinese braised meats. Thai cooks adapted it with fish sauce and local aromatics. Each table is set with small pots of sugar, fish sauce, chilli flakes, and vinegar so diners can fine-tune the bowl to their own taste."
          }
        ]
      }
    ]
  }
}
