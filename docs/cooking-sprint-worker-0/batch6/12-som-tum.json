      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Use a large mortar if you have one. Pound the garlic and fresh red chilli together to a rough paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the {{palm-sugar}}, {{tamarind-paste}}, {{fish-sauce}}, and lime juice. Stir with the pestle to dissolve the sugar. Taste. The dressing should be sour first, then salty, with mild sweetness and heat behind."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In place of green papaya, use 200 g of shredded firm green vegetable such as green cabbage or courgette, along with the beansprouts. Add these to the mortar."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Use the pestle to bruise and lightly pound the vegetables into the dressing. They should be softened slightly but still have crunch."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the spring onions and toss everything together."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to a plate. Scatter over the crushed roasted peanuts and dried chilli flakes if using. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Salad is watery and limp",
              "cause": "Vegetables sat in dressing too long before serving",
              "fix": "Dress the salad right before eating. Som tum does not keep."
            },
            {
              "symptom": "Dressing tastes flat and sweet",
              "cause": "Not enough lime or fish sauce",
              "fix": "Add lime juice first in small increments. The sour note should be the loudest flavour."
            },
            {
              "symptom": "Salad is overwhelmingly hot",
              "cause": "Too many chillies pounded into the dressing",
              "fix": "Add more palm sugar and an extra squeeze of lime. Use fewer chillies next time."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Som tum is the most eaten salad in Thailand. It comes from the Isan region of the northeast and is now sold on every street corner in Bangkok. The name means pounded sour. Green papaya is the classic base, shredded into long, fine strands and bruised lightly in the mortar so it absorbs the dressing. The four-flavour balance of hot, sour, salty, and sweet is the measure of a good som tum. Cooks are judged by how well they hold these four notes in tension."
          }
        ]
      }
    ]
  }
