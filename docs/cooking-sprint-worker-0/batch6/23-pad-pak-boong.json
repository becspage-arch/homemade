              "groupLabel": null
            },
            {
              "ingredientSlug": "vegetable-oil",
              "amount": 3,
              "unit": "tbsp",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the {{oyster-sauce}}, {{soy-sauce-light}}, and {{caster-sugar}} in a small bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over the highest heat until smoking."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and chilli. Stir for 20 seconds until golden and fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the beansprouts. Toss vigorously for 1 to 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the sauce. Toss for a further 30 seconds. The beansprouts should be tender but still have crunch."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve immediately. This dish waits for no one."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Beansprouts are limp and watery",
              "cause": "Wok not hot enough or overcooked",
              "fix": "The whole dish should take no more than 3 minutes once the wok is up to heat. Move fast."
            },
            {
              "symptom": "Garlic is burnt",
              "cause": "Garlic went in before the oil was fully hot, then overcooked",
              "fix": "Add garlic only when the oil is smoking. Move it constantly and add the greens within 30 seconds."
            },
            {
              "symptom": "Dish is too salty",
              "cause": "Too much oyster sauce relative to the vegetable quantity",
              "fix": "Add a pinch of sugar and serve with more rice to balance."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pad pak boong is one of Thailand's most famous street food side dishes. The original vegetable, morning glory or water spinach, grows in wetlands across Southeast Asia and is used in dishes from Thailand to Vietnam and Indonesia. Thai cooks stir-fry it in a screaming-hot wok, sometimes tossing it high in the air for the benefit of watching diners. The dish is quick, cheap, and deeply flavoured. Oyster sauce and garlic are the only seasoning it needs."
          }
        ]
      }
    ]
  }
}
