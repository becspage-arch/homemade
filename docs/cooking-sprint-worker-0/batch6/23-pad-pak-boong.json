              "amount": 1,
              "unit": "tbsp",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "caster-sugar",
              "amount": 0.5,
              "unit": "tsp",
              "prepNote": null,
