  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pad pak boong serves 2 and takes about 10 minutes. Morning glory, also called water spinach, is the traditional vegetable but is not widely available outside Southeast Asia. This recipe uses "
          },
          {
            "type": "text",
            "text": "beansprouts",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "beansprouts"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " as a substitute with similar crunch. The dish is seasoned with "
          },
          {
            "type": "text",
            "text": "oyster sauce",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "oyster-sauce"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "text",
            "text": "garlic",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "garlic"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". Speed and heat are the whole technique."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This dish cooks in under 3 minutes once the wok is hot. Have the sauce mixed and everything within arm's reach before you start. Delayed seasoning leads to overcooked, soggy greens."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 2,
          "items": [
            {
              "ingredientSlug": "bean-sprouts",
              "amount": 250,
              "unit": "g",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "garlic",
              "amount": 5,
              "unit": "cloves",
              "prepNote": "finely chopped",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "chilli-red",
              "amount": 2,
              "unit": null,
              "prepNote": "sliced",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "oyster-sauce",
              "amount": 2,
              "unit": "tbsp",
              "prepNote": null,
