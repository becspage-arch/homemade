  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thai boat noodles serves 4 and takes about 65 minutes. The broth is rich and dark, built from beef and pork with "
          },
          {
            "type": "text",
            "text": "dark soy sauce",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "soy-sauce-dark"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "text",
            "text": "fish sauce",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fish-sauce"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", and a small amount of "
          },
          {
            "type": "text",
            "text": "shrimp paste",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "shrimp-paste"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". "
          },
          {
            "type": "text",
            "text": "Flat rice noodles",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "rice-noodles-flat"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " are cooked separately and the broth is ladled over at the table."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The broth deepens greatly if made a day ahead and refrigerated overnight. Skim the fat that solidifies on the surface before reheating."
          }
        ]
      },
      {
