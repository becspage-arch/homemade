      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring 1.5 litres of water to the boil in a large pot. Add the garlic, shallots, and ginger. Simmer for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the pork belly strips to the broth. Simmer for 20 minutes until tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add {{soy-sauce-dark}}, {{soy-sauce-light}}, {{fish-sauce}}, {{shrimp-paste}}, and {{palm-sugar}}. Stir and simmer for 10 more minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a steady simmer. Add the beef slices. Cook for 3 to 4 minutes until just cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the flat rice noodles separately in boiling water per packet instructions. Drain and divide between bowls."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle the hot broth with beef and pork over the noodles. Top with beansprouts, spring onions, and coriander. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Broth is too thin and pale",
              "cause": "Not enough dark soy sauce or simmering time was too short",
              "fix": "Add another tablespoon of dark soy and simmer for 10 more minutes uncovered to concentrate."
            },
            {
              "symptom": "Beef is tough",
              "cause": "Sliced too thick or overcooked",
              "fix": "Slice to 2 mm. Cook only until the pink disappears and remove immediately."
            },
            {
              "symptom": "Shrimp paste flavour is too strong",
              "cause": "Added too much",
              "fix": "Use no more than 1 teaspoon. Add palm sugar to soften the intensity."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thai boat noodles come from the floating markets and canal-side stalls of central Thailand. They were originally sold from small boats where the cook worked over a single burner. The bowls were small and cheap, so diners ordered several rounds. The broth is famously dark and intense. Shrimp paste is one of the traditional ingredients, though modern versions often reduce or omit it for a cleaner flavour. The dish is now found at specialist noodle shops in Bangkok, particularly in the Ayutthaya area where it originated."
          }
        ]
      }
    ]
  }
