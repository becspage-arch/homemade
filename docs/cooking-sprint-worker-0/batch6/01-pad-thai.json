      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the tamarind paste, fish sauce, and sugar in a small bowl. Taste and adjust. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat {{vegetable-oil}} in a wok over a high heat until smoking. Add the shallots and garlic and stir-fry for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the prawns and toss until they just turn pink, about 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Push everything to the side. Crack in the eggs and scramble lightly, then fold into the prawn mixture."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained noodles and pour over the tamarind sauce. Toss vigorously for 2 to 3 minutes until the noodles absorb the sauce and char a little at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add most of the beansprouts and spring onions. Toss once and remove from the heat immediately."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide between bowls. Top with peanuts, the remaining beansprouts and spring onions, and serve with lime wedges and chilli flakes on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Noodles are sticky and clumped",
              "cause": "They were not drained well enough or the wok was not hot enough.",
              "fix": "Drain the soaked noodles thoroughly. Make sure the wok is properly smoking before adding them."
            },
            {
              "symptom": "Dish tastes too sour",
              "cause": "Too much tamarind or a very concentrated paste.",
              "fix": "Add a little more sugar and a small splash of fish sauce to balance. Taste before serving."
            },
            {
              "symptom": "Prawns are rubbery",
              "cause": "Overcooked. Prawns cook very quickly in a hot wok.",
              "fix": "Next time add them later and cook for just 1 to 2 minutes until they curl and turn pink."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pad Thai is sold from carts and stalls all over Thailand. It became the national noodle dish after a government campaign in the 1940s encouraged Thais to eat less rice. The dish uses "
          },
          {
            "type": "text",
            "text": "tamarind paste",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tamarind-paste"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " for sourness and "
          },
          {
            "type": "text",
            "text": "fish sauce",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fish-sauce"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " for salt. Every cook adjusts the balance at the table with the four condiments: sugar, chilli, fish sauce, and vinegar. At home, you can do the same thing in the bowl."
          }
        ]
      }
    ]
  }
}
