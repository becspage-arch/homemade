  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pad Thai serves 2 and comes together in about 35 minutes. The key is having everything prepped before the wok gets hot. Once you start cooking, there is no time to stop."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Soak flat rice noodles in cold water for 20 minutes rather than boiling them. They will finish cooking in the wok and stay springy instead of mushy."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
