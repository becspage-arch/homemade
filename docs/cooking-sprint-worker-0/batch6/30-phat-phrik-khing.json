      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pound the soaked dried chilli, lemongrass, shallots, garlic, and {{shrimp-paste}} together in a pestle and mortar to a rough paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over medium-high heat. Add the paste and fry for 3 to 4 minutes, stirring constantly, until deeply fragrant and the oil separates at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the pork mince. Break it up and stir-fry for 5 to 6 minutes until cooked through and beginning to brown."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add 200 g of trimmed green beans (cut into 3 cm pieces). Stir-fry for 3 to 4 minutes until tender but still crisp."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season with {{fish-sauce}} and {{palm-sugar}}. Toss to combine."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from the heat. Add the shredded kaffir lime leaves and toss through. Serve immediately over jasmine rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Dish is wet and saucy rather than dry",
              "cause": "Pork released too much water",
              "fix": "Cook the pork over higher heat and do not cover. Drain any excess liquid before adding the beans."
            },
            {
              "symptom": "Paste is bitter and burnt",
              "cause": "Paste fried over heat that was too high",
              "fix": "Keep the heat at medium-high and stir constantly. The paste should sizzle, not scorch."
            },
            {
              "symptom": "Green beans are too soft",
              "cause": "Added too early or cooked too long",
              "fix": "Add beans later in the process and stir-fry for no more than 4 minutes."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Phat phrik khing is a central Thai dish with a character distinct from the coconut-based curries. The dry approach concentrates the flavour of the paste directly onto the protein and vegetable rather than distributing it through a sauce. It is often described as one of the more intense Thai dishes because nothing moderates the heat of the paste. Kaffir lime leaves are essential here. They add fragrance and a slight bitterness that balances the richness of the pork."
          }
        ]
      }
    ]
  }
