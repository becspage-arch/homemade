        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the eggs in a saucepan and cover with cold water. Bring to the boil, then simmer for 10 minutes for a fully set yolk."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to a bowl of cold water for 1 minute. Peel immediately while still warm. Halve or quarter each egg."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the {{fish-sauce}}, lime juice, and {{palm-sugar}} in a small bowl. Stir until the sugar dissolves. Taste. The dressing should be sour, salty, and lightly sweet."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange the eggs on a plate. Scatter over the shallots, spring onions, and red chilli."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon the dressing over the eggs. Top with coriander and crushed peanuts if using. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Yolks have a grey-green ring",
              "cause": "Eggs overcooked",
              "fix": "Reduce the boiling time to 9 minutes and transfer to cold water immediately."
            },
            {
              "symptom": "Dressing is too sour",
              "cause": "Too much lime juice for the amount of palm sugar",
              "fix": "Add another pinch of palm sugar and a few extra drops of fish sauce to balance."
            },
            {
              "symptom": "Shallots taste harsh",
              "cause": "Strong shallots eaten raw",
              "fix": "Soak sliced shallots in cold water for 5 minutes to mellow them before using."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thai egg dishes are one of the most versatile and affordable parts of Thai cooking. This version is a dressed salad rather than a fried or scrambled preparation. The lime and fish sauce dressing is the same four-flavour balance used across Thai salads. It makes a quick lunch when served over rice, or a light starter before a more substantial curry. The raw shallots and chilli give it a freshness that dressed eggs in other traditions rarely achieve."
          }
        ]
      }
    ]
  }
