      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Peel 3 medium waxy potatoes and cut into 3 cm cubes. Parboil in salted water for 5 minutes. Drain and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pound the shallots, garlic, lemongrass, ginger, dried chilli, {{shrimp-paste}}, and 2 teaspoons of ground turmeric in a pestle and mortar to a paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large saucepan over medium heat. Fry the paste for 3 minutes until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chicken. Stir to coat in the paste and cook for 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the {{coconut-milk}} and add the parboiled potatoes. Bring to a gentle simmer and cook for 20 minutes until the chicken is cooked through and the potatoes are tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season with {{fish-sauce}} and {{palm-sugar}}. Taste and adjust. Serve over jasmine rice topped with fresh coriander."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Curry has no golden colour",
              "cause": "Not enough turmeric or paste was not fried long enough",
              "fix": "Fry the paste until visibly yellow and fragrant. Add an extra pinch of turmeric if needed."
            },
            {
              "symptom": "Potatoes are still hard after 20 minutes",
              "cause": "Potatoes were not parboiled or cut too large",
              "fix": "Cut to 2 cm and always parboil for 5 minutes before adding. Simmer longer with the lid on if needed."
            },
            {
              "symptom": "Curry is too mild",
              "cause": "Dried chillies were removed or mild variety used",
              "fix": "Add a pinch of dried chilli flakes and simmer for 5 more minutes."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Yellow curry shows the Indian influence on Thai cooking most clearly. The turmeric that colours it yellow arrived through centuries of trade across the Bay of Bengal. Thai cooks absorbed these influences and made them their own by adding lemongrass, galangal, and fish sauce. The resulting curry is milder and more fragrant than an Indian equivalent. It is often the first Thai curry people encounter because the heat level is accessible and the flavour is complex without being aggressive."
          }
        ]
      }
    ]
  }
