      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the soaked dried chillies, lemongrass, galangal, shallots, garlic, and shrimp paste into a smooth paste. Add a splash of water to help it blend."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a heavy pot over a medium heat. Fry the paste for 4 minutes until fragrant and the oil starts to separate at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the beef and stir to coat in the paste. Cook for 3 minutes to seal."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the coconut milk and add enough water to just cover the beef. Bring to a simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and cook on a very low heat for 1 hour. Add the peanuts after 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "After 1 hour, stir in the palm sugar, fish sauce, and tamarind paste. Taste and adjust. Cook uncovered for a further 15 minutes to thicken slightly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve over jasmine rice with extra peanuts scattered on top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Beef is still tough after the cooking time",
              "cause": "The heat was too high and the liquid boiled rather than simmered.",
              "fix": "Reduce the heat. Keep it at a gentle blip. Cook for another 20 to 30 minutes."
            },
            {
              "symptom": "Sauce is too thin",
              "cause": "Too much liquid was added.",
              "fix": "Remove the lid and simmer for 15 to 20 minutes to reduce. Stir occasionally."
            },
            {
              "symptom": "Curry tastes sweet but flat",
              "cause": "Needs more salt and sour balance.",
              "fix": "Add fish sauce one teaspoon at a time and a little more tamarind paste. Taste between each addition."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Massaman curry has roots in the Muslim communities of southern Thailand and reflects the spice trade routes through the region. The paste uses warm spices like cardamom and cinnamon alongside Thai aromatics. "
          },
          {
            "type": "text",
            "text": "Palm sugar",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "palm-sugar"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "text",
            "text": "shrimp paste",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "shrimp-paste"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " give the sauce its layered, sweet-savoury base. It is one of the mildest Thai curries and often described as the most complex in flavour."
          }
        ]
      }
    ]
  }
