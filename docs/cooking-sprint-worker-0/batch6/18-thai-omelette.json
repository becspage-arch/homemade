      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Beat the eggs with {{fish-sauce}} and {{soy-sauce-light}} in a bowl. Add the pork mince and spring onions. Stir to combine."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over high heat until very hot. The oil should shimmer and begin to smoke slightly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the egg mixture all at once. It will spit and puff in the hot oil. Leave undisturbed for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fold the omelette in half and cook for a further 1 minute until golden on the outside and just set inside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lift onto jasmine rice. Drizzle with {{oyster-sauce}} and top with sliced chilli. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Omelette is flat and rubbery",
              "cause": "Oil was not hot enough when the egg went in",
              "fix": "The oil must be very hot before adding the egg. Test with a drop of egg mixture first."
            },
            {
              "symptom": "Pork is not cooked through",
              "cause": "Mince was too dense or omelette too thick",
              "fix": "Use a thin layer of mince mixed into the egg. Ensure the fold gives at least 1 minute of cooking."
            },
            {
              "symptom": "Omelette is too salty",
              "cause": "Fish sauce was measured too generously",
              "fix": "Use 1 tablespoon maximum. Oyster sauce on top adds more salt, so balance is needed."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Khai jiew, the Thai omelette, is one of the most frequently eaten dishes in Thailand. It is the comfort food of Thai home cooking. A bowl of rice with a khai jiew on top is lunch, dinner, or a midnight snack depending on who you ask. The dish is deceptively simple. The technique of frying in hot oil rather than gently cooking gives it a completely different character from Western omelettes. Street cooks can produce one in under 3 minutes over a high-flame gas burner."
          }
        ]
      }
    ]
  }
