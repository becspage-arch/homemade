      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the {{soy-sauce-dark}}, {{soy-sauce-light}}, {{oyster-sauce}}, and {{caster-sugar}} in a small bowl. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over the highest heat until smoking. Add the pork slices and cook for 2 minutes until browned at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and stir for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Push everything to one side. Crack the eggs into the cleared space and scramble lightly. Let them set slightly before breaking them up and mixing with the pork."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the flat rice noodles. Pour the sauce over the top. Toss everything together, letting the noodles sit on the base of the wok for 30 seconds at a time to develop char."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the beansprouts. Toss for 1 minute. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Noodles are clumping together",
              "cause": "Fresh noodles stuck or dried noodles under-soaked",
              "fix": "Separate noodles with your hands before adding to the wok. Add a splash of water if they stick."
            },
            {
              "symptom": "Dish looks grey and steamed",
              "cause": "Wok was not hot enough",
              "fix": "Heat the wok until visibly smoking before adding oil. Cook in smaller batches if needed."
            },
            {
              "symptom": "Sauce is too salty",
              "cause": "Over-seasoned with dark soy",
              "fix": "Add a pinch of caster sugar and a squeeze of lime to balance. Use less dark soy next time."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pad see ew is a Chinese-influenced Thai street food dish. The name means stir-fried soy sauce noodles. It is sold from pushcart stalls across Thailand, usually alongside pad thai. The dark colour comes entirely from the soy sauce rather than any additional colouring. Chinese broccoli is the classic vegetable but cooks substitute whatever is to hand. The smoky char that comes from very high wok heat is what makes this dish hard to replicate on a domestic hob."
          }
        ]
      }
    ]
  }
