      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the chicken breasts, ginger slices, and crushed garlic in a large saucepan. Cover with cold water by 5 cm. Bring to a gentle simmer over medium heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce the heat to low. Poach at a bare simmer for 20 to 25 minutes until cooked through. Remove the chicken and set aside. Reserve the broth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Measure 500 ml of the warm broth into a saucepan. Add the rinsed jasmine rice and bring to a simmer. Cook, covered, for 12 to 15 minutes until the rice is tender and has absorbed the liquid. Rest covered for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the dipping sauce. Mix the grated ginger, grated garlic, {{soy-sauce-light}}, lime juice, and a pinch of caster sugar. Stir to combine. Taste and adjust."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slice the poached chicken across the grain. Arrange over bowls of the broth rice."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon a little warm broth over the chicken. Top with spring onions and coriander. Serve the dipping sauce on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Chicken is tough and chewy",
              "cause": "Poaching water was boiling rather than simmering",
              "fix": "Keep the heat very low. The water should barely move. Boiling toughens the protein."
            },
            {
              "symptom": "Rice is waterlogged",
              "cause": "Too much broth or lid lifted during cooking",
              "fix": "Use 500 ml of broth for 300 g rice. Keep the lid on throughout and do not stir."
            },
            {
              "symptom": "Dipping sauce is too salty",
              "cause": "Too much soy sauce",
              "fix": "Add more lime juice and a small pinch of sugar to bring the balance back."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Khao man gai is Thailand's version of Hainanese chicken rice, introduced by Chinese immigrants generations ago. It is one of the most ordered street food dishes in Bangkok. The dish looks simple but every element depends on the quality of the poaching broth. The rice absorbs the broth and tastes of the chicken. The chicken slices are mild and silky. The dipping sauce is where the heat and sharpness live. This is quiet, precise cooking."
          }
        ]
      }
    ]
  }
