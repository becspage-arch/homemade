      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the coconut milk, lemongrass, garlic, caster sugar, soy sauce, and 1 teaspoon of ground turmeric together in a bowl. Add the chicken strips. Cover and refrigerate for at least 1 hour or overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For the peanut sauce: warm the coconut milk in a saucepan over medium heat. Add the crushed peanuts, {{tamarind-paste}}, {{palm-sugar}}, {{fish-sauce}}, and chilli flakes. Stir over medium heat for 5 minutes until the sauce thickens. Taste and adjust. Keep warm."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Thread the marinated chicken onto soaked skewers, weaving each strip onto the skewer in an S-shape."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a griddle pan over high heat until smoking. Grill the skewers for 3 to 4 minutes per side until cooked through with char marks."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve the skewers immediately with the warm peanut sauce for dipping."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Chicken is sticking to the griddle",
              "cause": "Pan not hot enough or marinade excess not drained",
              "fix": "Get the griddle very hot before adding skewers. Shake off excess marinade before grilling."
            },
            {
              "symptom": "Peanut sauce is too thick",
              "cause": "Sauce reduced too far",
              "fix": "Add a splash of hot water and stir until smooth."
            },
            {
              "symptom": "Chicken is dry and overcooked",
              "cause": "Strips were too thin or grilled too long",
              "fix": "Slice chicken into strips no thinner than 1.5 cm and check at 3 minutes per side."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Satay is sold from charcoal grills across Thailand and across Southeast Asia more broadly. The dish is thought to have arrived through trade routes from the Middle East and was adopted and transformed in each country it passed through. Thai satay is typically sweeter and more coconut-forward than Indonesian or Malaysian versions. The peanut sauce is always served warm rather than at room temperature. Street versions are cooked over glowing coals in minutes, which gives a smoke that a domestic griddle only partially replicates."
          }
        ]
      }
    ]
  }
