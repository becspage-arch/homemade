              "amount": 3,
              "unit": null,
              "prepNote": "sliced",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the {{fish-sauce}}, lime juice, {{caster-sugar}}, sliced garlic, and chillies in a bowl. Set this broth aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stuff one bruised lemongrass stalk and some coriander stalks into the fish cavity."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the fish on a heatproof plate that fits inside your steamer. Pour the broth over and around the fish."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Steam over vigorously boiling water for 12 to 15 minutes until the flesh at the thickest point flakes easily when pressed with a fork."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Carefully transfer the fish and all the broth to a serving plate. Top with fresh coriander and spring onions. Serve with jasmine rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Fish is still raw at the bone after 15 minutes",
              "cause": "Fish was too thick or steamer was not at full pressure",
              "fix": "Steam for 3 to 5 more minutes. Check at the thickest point near the bone. Water in the steamer should always be at a full boil."
            },
            {
              "symptom": "Broth is too salty",
              "cause": "Too much fish sauce",
              "fix": "Squeeze more lime juice over the finished dish. Serve with plenty of rice to balance."
            },
            {
              "symptom": "Fish is sticking to the plate",
              "cause": "Plate was not lined",
              "fix": "Line the steaming plate with a few spring onion lengths before placing the fish on top."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thai steamed fish with lime and chilli broth is a restaurant classic and a confident home cook's dish. Steaming is the gentlest way to cook fish and produces a texture that frying and baking cannot match. The broth that collects on the plate becomes part of the dish. It is spooned over rice and eaten with every bite. Sea bass is the most popular choice in Thailand but any firm white fish works well. The combination of lime, fish sauce, garlic, and chilli is one of the cleanest, brightest flavour profiles in Thai cooking."
          }
        ]
      }
    ]
  }
}
