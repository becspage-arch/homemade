        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "cod-fillet",
              "amount": 700,
              "unit": "g",
              "prepNote": "use 1 whole sea bass or snapper, scored 3 times each side",
              "isOptional": false,
