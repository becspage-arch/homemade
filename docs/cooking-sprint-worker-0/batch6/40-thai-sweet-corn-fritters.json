      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the dipping sauce. Mix the {{fish-sauce}}, lime juice, {{palm-sugar}}, and sliced chilli in a small bowl. Stir until the sugar dissolves. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Use 300 g of drained tinned sweetcorn or cut the kernels from 2 fresh cobs. Place in a large bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the beaten {{eggs}}, {{cornflour}}, spring onions, coriander, chilli, garlic, and {{caster-sugar}}. Stir until everything is coated in a thick batter. The mix should hold together when scooped."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wide frying pan over medium-high heat. Drop heaped tablespoons of the batter into the pan. Press each one gently flat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry for 2 to 3 minutes per side until golden and crisp. Work in batches to avoid crowding the pan. Drain on kitchen paper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve hot with the lime dipping sauce."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Fritters are falling apart in the pan",
              "cause": "Batter is too loose",
              "fix": "Add an extra tablespoon of cornflour and stir well. The batter must hold its shape when spooned."
            },
            {
              "symptom": "Fritters are soggy rather than crispy",
              "cause": "Oil not hot enough or pan overcrowded",
              "fix": "Test the oil with a small drop of batter. It should sizzle immediately. Fry in small batches."
            },
            {
              "symptom": "Dipping sauce is too sharp",
              "cause": "Too much lime juice",
              "fix": "Add more palm sugar and a splash of water to balance."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sweetcorn fritters are a popular snack at Thai street markets and vegetarian restaurants. The use of cornflour rather than plain flour gives the fritters a lighter, crisper result with a slightly chewy interior. They are always served with a sharp dipping sauce. The fish sauce and lime combination in the sauce is the same four-flavour base used throughout Thai cooking. For a fully vegan version, substitute the fish sauce in the dipping sauce with soy sauce and a small pinch of salt."
          }
        ]
      }
    ]
  }
