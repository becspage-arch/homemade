      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over high heat until smoking. Add the garlic and stir for 20 seconds until golden and fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tofu cubes. Toss for 2 minutes until they begin to colour on the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the spring onions and beansprouts. Toss everything together for 2 minutes. The beansprouts should still have crunch."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add {{oyster-sauce}}, {{soy-sauce-light}}, and {{caster-sugar}}. Toss to coat everything in the sauce."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and adjust. Serve immediately over jasmine rice with sliced chilli on top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Vegetables are soggy",
              "cause": "Wok not hot enough, causing steaming instead of frying",
              "fix": "Preheat the wok until it smokes before adding any oil. Cook in small batches."
            },
            {
              "symptom": "Tofu is sticking to the wok",
              "cause": "Tofu was not dry enough before cooking",
              "fix": "Pat tofu dry with kitchen paper before adding. Add an extra splash of oil if needed."
            },
            {
              "symptom": "Sauce is too salty",
              "cause": "Too much oyster sauce for the vegetable quantity",
              "fix": "Add a pinch of sugar and a squeeze of lime to balance. Serve over more rice."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pad pak ruam means stir-fried mixed vegetables in Thai. It is the most versatile dish in the Thai home kitchen. Any vegetable can go in. The sauce is always the same: garlic, oyster sauce, and a little soy. This is the dish Thai cooks make when they need a quick side or want to use up what is in the refrigerator. It appears next to every curry and noodle dish on the Thai table. The oyster sauce glaze is what makes it distinctly Thai rather than generically Asian."
          }
        ]
      }
    ]
  }
