      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok over high heat until smoking. Add the garlic and chilli. Stir for 30 seconds until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the pork mince. Break it up and stir-fry for 4 to 5 minutes until cooked through and starting to brown."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add {{oyster-sauce}}, {{fish-sauce}}, {{soy-sauce-light}}, and {{caster-sugar}}. Toss to coat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from the heat. Add the Thai basil leaves and toss through the residual heat until just wilted."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "If serving with a fried egg, fry one egg per person in a separate pan with plenty of hot oil until the edges are crispy and the yolk is still runny."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve immediately over jasmine rice with the fried egg on top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Pork is releasing water and stewing",
              "cause": "Pan not hot enough or too much mince for the pan size",
              "fix": "Cook in two batches or increase the heat before adding the mince."
            },
            {
              "symptom": "Dish is too salty",
              "cause": "Too much fish sauce or oyster sauce",
              "fix": "Add a pinch of caster sugar and serve over more rice to balance."
            },
            {
              "symptom": "Basil turned dark and bitter",
              "cause": "Added to the pan while still on the heat",
              "fix": "Always take the wok off the heat before adding the basil."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pad krapow moo is as close to Thai fast food as home cooking gets. Krapow is the Thai word for holy basil, the original herb used in this dish. Thai basil is a widely available substitute with a similar character. The dish is eaten at all hours in Thailand, including as a late-night meal after a long shift. Every cook has their own ratio of chilli to sauce. The fried egg is not optional for most Thais."
          }
        ]
      }
    ]
  }
