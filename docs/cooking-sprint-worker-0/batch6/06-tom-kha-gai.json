      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring 500 ml of water to the boil in a large saucepan. Add the lemongrass, galangal, kaffir lime leaves, shallots, and chilli."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer for 5 minutes to build the base."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the {{coconut-milk}} and return to a gentle simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chicken strips. Cook for 8 to 10 minutes until the chicken is cooked through. Do not boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season with {{fish-sauce}} and lime juice. Taste for balance. The soup should be mildly sour, salty, and creamy."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle into bowls and top with fresh coriander. Serve with jasmine rice or on its own."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Broth is curdled and oily",
              "cause": "Coconut milk was boiled too vigorously",
              "fix": "Next time keep the heat at a low simmer after adding the coconut milk."
            },
            {
              "symptom": "Chicken is dry",
              "cause": "Overcooked in the broth",
              "fix": "Check thighs at 8 minutes. They are done when no pink remains at the centre."
            },
            {
              "symptom": "Soup lacks fragrance",
              "cause": "Aromatics were not bruised",
              "fix": "Bruise lemongrass and galangal firmly before adding. This releases the essential oils."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tom kha gai translates roughly as chicken galangal soup. It is one of Thailand's most comforting dishes. The coconut milk base distinguishes it from the sharper tom yum. Galangal is the ingredient that makes it unmistakably Thai rather than generically creamy. The soup appears at family meals, roadside stalls, and celebratory feasts alike. It is often served in a small clay pot that holds the heat."
          }
        ]
      }
    ]
  }
