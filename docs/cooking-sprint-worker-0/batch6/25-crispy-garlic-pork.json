      "slug": "pork-belly-skin-on",
      "term": "Pork belly (skin-on)",
      "definition": "A rich, fatty cut of pork with the skin attached. The fat renders during frying and keeps the meat moist while the skin crisps."
    },
    {
      "slug": "fish-sauce",
      "term": "Fish sauce",
      "definition": "Fermented fish liquid. It is added near the end of cooking to give the pork a savoury, umami glaze."
    },
    {
      "slug": "garlic",
      "term": "Garlic",
      "definition": "Used in large quantity here. The garlic fries slowly alongside the pork until deeply golden and crisp."
    },
    {
      "slug": "soy-sauce-dark",
      "term": "Dark soy sauce",
      "definition": "Added in small amounts to colour the pork and add a caramel depth."
    }
