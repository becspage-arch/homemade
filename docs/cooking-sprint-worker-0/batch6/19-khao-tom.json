      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring 1 litre of water to the boil in a large saucepan. Add the ginger and crushed garlic. Simmer for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the raw rice. Simmer on medium-low heat for 20 minutes, stirring occasionally, until the rice is very soft and the soup has thickened. If using leftover cooked rice, add it in step 3 and simmer for just 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll the pork mince into small balls about the size of a marble. Drop them into the simmering soup. Cook for 5 minutes until cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season with {{fish-sauce}} and {{soy-sauce-light}}. Taste for balance. The soup should be mild and comforting with a light savouriness."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle into bowls. Top with sliced spring onions, fresh coriander, and a few drops of sesame oil. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Soup is too thick",
              "cause": "Rice absorbed more water than expected during simmering",
              "fix": "Add more water in 100 ml increments and stir until the consistency is a loose porridge."
            },
            {
              "symptom": "Pork balls are falling apart",
              "cause": "Mince was too lean or not compressed enough when rolling",
              "fix": "Use mince with some fat content. Compress the balls firmly before adding."
            },
            {
              "symptom": "Soup tastes bland",
              "cause": "Under-seasoned",
              "fix": "Add fish sauce in small amounts at the table. The flavour should be mild but not flat."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Khao tom is eaten across Thailand for breakfast. It is the dish Thai people reach for when they are unwell, tired, or starting a long day. The dish is mild and deeply comforting. It shows the Chinese congee tradition adapted to Thai ingredients and tastes. Street stalls that specialise in khao tom open before dawn and often sell out by mid-morning. The garnishes at the table are essential: crispy fried garlic, sliced chilli, and extra fish sauce each sharpen the bowl in a different direction."
          }
        ]
      }
    ]
  }
