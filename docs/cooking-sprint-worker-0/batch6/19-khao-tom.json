  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Khao tom serves 2 and takes about 30 minutes. It is a soup where "
          },
          {
            "type": "text",
            "text": "jasmine rice",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "jasmine-rice"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " is simmered until very soft in a broth flavoured with "
          },
          {
            "type": "text",
            "text": "fresh ginger",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "ginger-fresh"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "text",
            "text": "fish sauce",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fish-sauce"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". It is the Thai version of congee and is served across Thailand for breakfast. Leftover rice speeds up the cooking time considerably."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This soup thickens as it sits. If making ahead, add a splash of water when reheating to loosen it back to a broth consistency."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
