  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thai peanut sauce makes about 300 ml and takes 13 minutes. It combines "
          },
          {
            "type": "text",
            "text": "roasted peanuts",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "peanuts-roasted"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " with "
          },
          {
            "type": "text",
            "text": "coconut milk",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "coconut-milk"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "text",
            "text": "tamarind paste",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tamarind-paste"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", and "
          },
          {
            "type": "text",
            "text": "palm sugar",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "palm-sugar"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". It is served warm with satay skewers, fresh spring rolls, or as a dressing for salads. The sauce thickens as it cools, so add a splash of water when reheating."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use ready-roasted peanuts and blend them in a food processor to a rough paste before starting. This saves time and gives a more consistent sauce than crushing by hand."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "peanuts",
              "amount": 150,
              "unit": "g",
              "prepNote": "blended to a coarse paste",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "coconut-milk",
              "amount": 200,
              "unit": "ml",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "tamarind-paste",
