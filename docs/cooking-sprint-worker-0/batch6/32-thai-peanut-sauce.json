              "groupLabel": null
            },
            {
              "ingredientSlug": "garlic",
              "amount": 1,
              "unit": "clove",
              "prepNote": "finely grated",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the {{coconut-milk}} into a small saucepan over medium heat. Bring to a gentle simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the blended peanut paste, grated garlic, and chilli flakes. Stir to combine."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the {{tamarind-paste}}, {{palm-sugar}}, and {{soy-sauce-light}}. Stir over medium heat for 5 minutes until the sugar dissolves and the sauce thickens to a consistency that coats a spoon."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and adjust. The sauce should be nutty, sweet, sour, and mildly spiced. Add more tamarind for sourness, more palm sugar for sweetness, or more chilli for heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve warm. If the sauce thickens too much on standing, stir in hot water a tablespoon at a time until it flows easily."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Sauce has seized into a stiff paste",
              "cause": "Too little coconut milk or overheated",
              "fix": "Add warm water and stir over low heat until smooth. Do not boil once the peanut paste is in."
            },
            {
              "symptom": "Sauce is too sour",
              "cause": "Too much tamarind",
              "fix": "Add an extra tablespoon of palm sugar and stir over low heat until dissolved."
            },
            {
              "symptom": "Sauce tastes bland",
              "cause": "Insufficient seasoning",
              "fix": "Add soy sauce and a pinch of salt in small amounts. The peanut flavour should be rich and present."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thai peanut sauce is the dipping sauce that accompanies satay across Southeast Asia. Each country has its own version. The Thai version is typically thinner and more coconut-forward than Indonesian peanut sauce and sweeter than Malaysian versions. It is also used as a dressing for fresh spring rolls and noodle salads. The sauce keeps well in the refrigerator for several days and improves overnight as the flavours settle. It is one of the most useful sauces in the Thai kitchen."
          }
        ]
      }
    ]
  }
