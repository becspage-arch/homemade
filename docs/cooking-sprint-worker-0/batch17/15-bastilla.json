  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Traditional bastilla uses "
          },
          {
            "type": "text",
            "text": "warqa",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "warqa"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " pastry, but filo or homemade plain flour sheets both work. Do not skip the "
          },
          {
            "type": "text",
            "text": "sweet-savoury dusting",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "sweet-savoury-dusting"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " of icing sugar and cinnamon. It sounds odd; it is essential."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Make the filling ahead and cool completely before assembling. Warm filling will steam the pastry and make it soggy."
          }
        ]
      },
