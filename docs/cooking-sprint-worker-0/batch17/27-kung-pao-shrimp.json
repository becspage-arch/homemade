      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix all the sauce ingredients in a small bowl. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pat the prawns very dry with kitchen paper. Moisture will cause them to steam rather than sear."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the wok over the highest heat possible for 2 minutes. Add the oil. When it shimmers and begins to smoke, add the dried chilli pieces and peppercorns. Stir for 30 seconds until fragrant and slightly darkened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and ginger. Stir for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the prawns in a single layer. Cook for 60 to 90 seconds without moving. Toss once."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the spring onion, pour in the sauce, and toss everything together over high heat for 30 seconds. The sauce should thicken slightly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from heat. Toss in the peanuts. Serve immediately with steamed rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Prawns are rubbery and overcooked",
              "cause": "The prawns were left in the pan too long. Prawns cook in under 2 minutes at high heat.",
              "fix": "Remove the prawns as soon as they curl into a C shape and turn opaque. They will continue cooking in the residual heat of the sauce."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dried chillies burn and taste bitter",
              "cause": "The oil was too hot when the chillies went in, or they were left unattended.",
              "fix": "Keep the chillies moving constantly once they hit the oil. They should darken, not blacken. If they burn, discard and start again."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kung pao chicken, the original version, is named after Ding Baozhen, a Qing dynasty governor of Sichuan province whose official title was Gong Bao. The dish became one of the most exported Chinese recipes globally, though the overseas version is often sweeter and starchier than the original. In Sichuan, the sauce is less sweet and the Sichuan pepper flavour is prominent. Shrimp was not traditional but is now common in coastal versions of the dish."
          }
        ]
      }
    ]
  }
