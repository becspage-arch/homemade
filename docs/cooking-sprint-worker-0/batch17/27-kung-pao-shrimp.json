  "glossaryTerms": [
    {
      "slug": "kung-pao-sauce",
      "term": "Kung Pao Sauce",
      "definition": "The signature sauce for kung pao dishes, combining soy sauce, rice vinegar, sugar, and a little cornflour. It should taste simultaneously sweet, sour, and salty before the chilli heat comes in."
    },
    {
      "slug": "velveting-prawns",
      "term": "Velveting",
      "definition": "Coating prawns or meat in a thin layer of cornflour and egg white before cooking. This seals in moisture and gives the exterior a lightly crisp, silky texture."
    },
    {
      "slug": "wok-hei",
      "term": "Wok Hei",
      "definition": "Literally 'breath of the wok'. The smoky, slightly charred flavour that comes from cooking over very high heat in a seasoned wok. Requires a very hot hob and quick movement."
    }
  ],
