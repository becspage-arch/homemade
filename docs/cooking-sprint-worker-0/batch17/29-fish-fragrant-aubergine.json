      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toss the aubergine batons with the salt in a colander. Leave for 15 minutes. Squeeze out as much moisture as you can with your hands. Pat dry."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the sauce ingredients in a small bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 3 tablespoons of oil in the wok over high heat. Add the aubergine and cook, tossing occasionally, for 6 to 8 minutes until collapsed, golden at the edges, and cooked through. Remove to a plate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the remaining oil to the wok. Add the white spring onion pieces, garlic, ginger, and red chilli. Stir-fry over high heat for 1 minute until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the aubergine to the wok. Pour in the sauce. Toss together for 1 to 2 minutes until the sauce reduces to a glaze and coats the aubergine."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter the green spring onion tops over the top. Serve with steamed rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Aubergine absorbs all the oil and the pan goes dry",
              "cause": "The aubergine was not dried thoroughly after salting, or the wok was not hot enough.",
              "fix": "Add a splash of water to the pan. The steam will help the aubergine cook through without needing more oil."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce evaporates before it coats the aubergine",
              "cause": "The pan was too hot at the sauce stage.",
              "fix": "Reduce the heat to medium before adding the sauce. Toss quickly to coat rather than leaving it to cook down further."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fish fragrant dishes are specific to Sichuan province. The flavour profile is thought to have originated in Zigong, a city in southern Sichuan historically known for salt production. The method of building a sauce around garlic, ginger, spring onion, chilli, vinegar, and sugar creates an instantly recognisable flavour that runs through dozens of Sichuanese preparations. Yu xiang qie zi is one of the dishes most commonly ordered in Sichuan home cooking."
          }
        ]
      }
    ]
  }
