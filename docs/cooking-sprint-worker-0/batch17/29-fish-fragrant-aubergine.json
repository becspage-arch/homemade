                }
              }
            ],
            "text": "salting the aubergine "
          },
          {
            "type": "text",
            "text": ". This step takes 15 minutes but makes a real difference. Follow the "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "stir-fry-seasoning"
                }
              }
            ],
            "text": "seasoning order"
          },
          {
            "type": "text",
            "text": " strictly: aromatics, then aubergine, then sauce."
          }
        ]
