      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season chicken with salt. Blend canned tomatoes, red pepper, chilli and half the onion until smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a large pot over medium-high heat. Fry the sliced onion for 5 minutes until lightly brown."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic and ginger. Cook 1 minute. Pour in the blended tomato mixture. Cook for 20 minutes, stirring regularly, until the oil separates on top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the ground egusi with 4 tablespoons of water to form a loose paste. Add to the pot in small spoonfuls. Stir gently, then cover and cook for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chicken pieces. Pour in 250ml water. Stir, cover and cook on medium-low for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add prawns if using and spinach. Cook uncovered for 5 minutes. Taste and adjust salt."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Egusi formed hard lumps",
              "cause": "Added without water or too much at once",
              "fix": "Always mix egusi with water first. Add in small spoonfuls rather than pouring it all in at once."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Soup too thin",
              "cause": "Not enough egusi or too much water",
              "fix": "Mix 2 tablespoons of extra ground egusi with water and stir in. Simmer uncovered for 5 minutes."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Egusi soup is eaten across Nigeria and into Cameroon, Togo and Ghana. Each ethnic group has its preferred method: some fry the egusi paste first, some add it directly to the broth. The choice of leaf varies by region from bitterleaf to ugu (pumpkin leaf) to spinach. It is considered comfort food and celebration food in equal measure."
          }
        ]
      }
    ]
  }
