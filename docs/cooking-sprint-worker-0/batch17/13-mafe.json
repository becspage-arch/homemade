      "slug": "mafe-base",
      "term": "Mafe base",
      "definition": "The combination of deeply cooked tomato paste and peanut butter that forms the sauce. Both must be cooked separately before combining to avoid a raw, separated texture."
    },
    {
      "slug": "natural-peanut-butter",
      "term": "Natural peanut butter",
      "definition": "Peanut butter made only from peanuts, without added sugar or palm oil. Essential for savoury cooking as sweetened peanut butter makes the stew cloying."
    }
  ],
