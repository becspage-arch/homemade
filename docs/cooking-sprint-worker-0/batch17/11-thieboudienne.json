  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thieboudienne has two components that make it distinctive. The first is the "
          },
          {
            "type": "text",
            "text": "rof",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "rof"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " stuffed into the fish. The second is the "
          },
          {
            "type": "text",
            "text": "xoon ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "xoon"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", the caramelised crust that forms on the bottom of the pot. Both are essential to the dish."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use a firm white fish that will hold together. Whole sea bass or cod steaks work well. The fish is cooked first, then removed while the vegetables and rice cook in the same broth."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "sea-bass",
              "amount": 800,
              "unit": "g",
              "prepNote": "whole fish, cleaned and scored, or 4 thick fillets",
              "isOptional": false,
              "groupLabel": "Fish"
            },
            {
