      "slug": "rof",
      "term": "Rof",
      "definition": "The herb and garlic stuffing pushed into slits in the fish before cooking in thieboudienne. Made from parsley, garlic and chilli."
    },
    {
      "slug": "xoon",
      "term": "Xoon",
      "definition": "The crust that forms at the bottom of the pot as the rice cooks. Scraped up and served as the most prized part of the dish, equivalent to socarrat in paella."
    }
  ],
  "techniqueSlugs": [],
