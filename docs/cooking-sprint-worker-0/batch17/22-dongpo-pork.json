      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the tied pork squares in a large pan, skin-side down. Cover with cold water. Bring to the boil and cook for 5 minutes. Drain, rinse, and pat dry."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lay a bed of half the spring onions and half the ginger on the bottom of your dutch oven. Place the pork squares on top, skin-side down."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the Shaoxing wine, both soy sauces, sugar, remaining ginger, spring onions, star anise, cinnamon, and peppercorns. Pour in just enough water to reach halfway up the pork."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to the boil over high heat. Skim any foam. Cover tightly. Reduce heat to the lowest setting and cook for 1 hour 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Carefully turn each pork square skin-side up. Cover and continue braising for another 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the pork to a warm plate. Increase heat and reduce the braising liquid to a syrupy glaze, about 10 to 15 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Strain the sauce. Add a few drops of sesame oil if using. Remove the twine from the pork. Serve each square skin-side up in a small bowl with sauce spooned over. Eat with steamed buns or rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pork falls apart when turning",
              "cause": "The braise is progressing well. The meat is very tender.",
              "fix": "Use two large spoons or a wide spatula to support the piece when turning. This is a sign of success, not a problem."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce tastes too salty",
              "cause": "The braising liquid over-reduced with both soy sauces present.",
              "fix": "Add a splash of water and a pinch more sugar to balance. Simmer briefly to integrate."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dongpo pork comes from Hangzhou, the capital of Zhejiang province, a city known for its refined cuisine built around the area's freshwater fish, pork, and tea culture. The dish carries the name of Su Shi, the Song dynasty statesman and poet who wrote about his method for slow-braising pork. The version served in Hangzhou restaurants today is often presented in small clay pots, skin-side up, on a bed of vegetables. It is considered one of the eight great regional Chinese cuisines of the Jiangnan school."
          }
        ]
      }
    ]
  }
