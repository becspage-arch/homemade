        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fill a wide pan with water. Add the sliced ginger, the 2 whole spring onions, and the salt. Bring to a simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slide the cod portions into the barely simmering water. Cook gently for 6 to 8 minutes depending on thickness. The flesh should be just opaque throughout. Remove carefully with a wide spatula and place on a serving plate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the fish poaches, make the sauce. Combine the vinegar, sugar, both soy sauces, and 100ml of the poaching liquid in a small bowl. Mix the cornflour with 2 tablespoons of cold water in a separate bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a small pan over medium heat. Add the julienned ginger and cook for 1 minute until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the vinegar and soy mixture. Bring to the boil. Stir in the cornflour slurry and keep stirring until the sauce thickens to a glossy consistency, about 1 to 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the sauce over the fish. Scatter the sliced spring onion on top. Serve immediately with steamed rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Fish breaks apart during poaching",
              "cause": "The water was boiling too vigorously.",
              "fix": "The water must be barely simmering, almost still. Turn the heat right down. A few gentle bubbles around the edge is correct."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce is cloudy instead of glossy",
              "cause": "The cornflour was added to hot liquid without mixing first, causing lumps.",
              "fix": "Always mix cornflour with cold water first. If the sauce is lumpy, strain it through a fine sieve before serving."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "West Lake is the scenic freshwater lake at the centre of Hangzhou, and the fish that lived in it historically fed the city. Grass carp was the original choice because it thrived in the lake. The restaurant Lou Wai Lou, opened in 1848 on the banks of West Lake, has served this dish continuously for over 170 years. Xi Hu Cu Yu appears on virtually every menu in Hangzhou and is considered the dish most representative of the city's cooking style."
          }
        ]
      }
    ]
  }
}