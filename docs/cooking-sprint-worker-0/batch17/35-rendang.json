      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend or pound all the spice paste ingredients to a smooth paste. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wide, heavy-based pan over medium heat. Add the spice paste. Fry, stirring constantly, for 8 to 10 minutes until very fragrant and the oil begins to separate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the beef chunks and stir to coat in the paste. Cook for 3 to 4 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the coconut milk. Add the cinnamon stick, star anise, sugar, and salt. Bring to the boil, stirring."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce to a steady simmer, uncovered. Cook for 1 hour 30 minutes, stirring every 15 minutes. The coconut milk will reduce significantly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the toasted sesame seeds. Continue cooking, now stirring more frequently, for another 30 to 60 minutes. The liquid will disappear entirely and the beef will start to fry in the released coconut oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir almost constantly at this final stage. The meat will darken and develop a deep brown crust. This is exactly right. Cook until the beef is as dark as you want, then remove from heat. Remove the whole spices. Serve with steamed rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rendang sticks and burns in the final stage",
              "cause": "The heat was too high once the liquid had evaporated.",
              "fix": "Reduce heat to low for the final frying stage. Stir constantly. A little burning adds flavour; a lot creates bitterness."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Beef is still tough after 2 hours",
              "cause": "Shin requires very long, low cooking. Two hours at a simmer may not be enough.",
              "fix": "Continue cooking, adding 50ml of water if necessary to prevent burning. Rendang takes patience. Shin may need up to 3 hours total."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rendang was voted the world's most popular dish in multiple polls. This caused debate about authenticity when a British TV show criticised a competition entry. The dish originates with the Minangkabau people of West Sumatra, where it is cooked for celebrations and eaten cold."
          }
        ]
      }
    ]
