  "glossaryTerms": [
    {
      "slug": "dry-curry",
      "term": "Dry Curry",
      "definition": "A curry cooked until virtually all the liquid has evaporated. The meat then fries in its own fat and the coconut oil separates, producing a concentrated, intensely flavoured dish with almost no sauce."
    },
    {
      "slug": "kerisik",
      "term": "Kerisik",
      "definition": "Toasted desiccated coconut, ground to a rough paste. Added to rendang to thicken it and add a nutty, roasted coconut flavour. Simulated here using a dry-toasted coconut with sesame seeds."
    },
    {
      "slug": "minangkabau-cooking",
      "term": "Minangkabau Cooking",
      "definition": "The culinary tradition of the Minangkabau people of West Sumatra, Indonesia. Known for its use of coconut milk, chilli, and complex spice pastes. Padang restaurants serve Minangkabau food across Southeast Asia."
    }
  ],
