      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the broth chicken thighs in a large pot. Cover with 2 litres of cold water. Add the ginger, spring onions, and peppercorns. Bring to the boil, skim off any foam."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce to a steady simmer. Cook for 1 hour until the broth is rich and golden. Season with salt. Strain and discard the solids."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the broth simmers, partially freeze the second batch of chicken thighs for 20 minutes, then slice them as thinly as possible. Arrange on a plate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange the vegetables, mushrooms, and soaked rice noodles in small bowls or plates for each person. Set everything on the table before the broth is ready."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring the strained broth to a vigorous boil. Ladle it into large, deep bowls. One person should have their bowl filled first and begin eating while you fill the others."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "At the table: add the raw chicken slices to the broth first and stir gently. They will turn opaque in under a minute. Then add the vegetables and mushrooms. Finally, slide in the noodles. Eat immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Chicken slices are still pink in the centre",
              "cause": "The slices were too thick or the broth was not hot enough.",
              "fix": "Stir the slices gently in the broth for another minute. If they remain pink, the broth was not hot enough. Reheat the remaining broth before refilling bowls."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth tastes thin and watery",
              "cause": "Not enough chicken, or the bones were not used.",
              "fix": "Add bone-in chicken pieces to the broth pot, not just thighs, and simmer for a full hour. A splash of fish sauce or light soy can help at the end."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Crossing the bridge noodles comes from Mengzi in Yunnan province. The cuisine there is shaped by its closeness to Southeast Asia. The traditional version can include up to twenty small dishes of separate ingredients. In Kunming, specialist restaurants serve only this dish."
          }
        ]
      }
    ]
  }
