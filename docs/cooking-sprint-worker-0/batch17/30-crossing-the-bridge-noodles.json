  "glossaryTerms": [
    {
      "slug": "yunnan-broth",
      "term": "Yunnan Broth",
      "definition": "A rich, clear chicken and pork broth that is the base of crossing the bridge noodles. It must be extremely hot when served so it cooks the raw ingredients tableside."
    },
    {
      "slug": "rice-vermicelli",
      "term": "Rice Noodles",
      "definition": "Noodles made from rice flour. They range from thin vermicelli to thicker flat noodles. Yunnan rice noodles (mi xian) are round and about 3mm thick. Dried rice noodles need soaking before use."
    },
    {
      "slug": "tableside-cooking",
      "term": "Tableside Cooking",
      "definition": "A serving style where diners add raw ingredients to a very hot broth at the table and allow them to cook in the residual heat. The broth must be vigorously boiling just before serving."
    }
  ],
