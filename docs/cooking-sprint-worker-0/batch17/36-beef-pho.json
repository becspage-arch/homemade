  "glossaryTerms": [
    {
      "slug": "pho-broth",
      "term": "Pho Broth",
      "definition": "The base of pho, made by charring ginger and onion directly over flame before simmering them with bone-in beef and a spice packet of star anise, cinnamon, cloves, and cardamom. The charring removes harshness and adds a subtle smokiness."
    },
    {
      "slug": "charring-aromatics",
      "term": "Charring",
      "definition": "Blackening the surface of onion and ginger directly over a gas flame or under a grill before adding to a broth. This technique is specific to pho and bun bo hue and produces a cleaner, more complex broth flavour."
    },
    {
      "slug": "raw-beef-pho",
      "term": "Bo Tai",
      "definition": "Thin-sliced raw beef placed in the pho bowl before the broth is ladled over. The hot broth cooks the beef to rare or medium-rare. The beef must be very fresh and sliced as thinly as possible."
    }
  ],
