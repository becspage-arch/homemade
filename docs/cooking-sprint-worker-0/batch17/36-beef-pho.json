                  "termSlug": "raw-beef-pho"
                }
              }
            ],
            "text": "bo tai"
          },
          {
            "type": "text",
            "text": " (raw beef) must be paper-thin. Partially freeze the beef for 20 minutes before slicing to make this possible."
          }
        ]
      },
