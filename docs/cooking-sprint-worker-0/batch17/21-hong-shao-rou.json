      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the pork belly chunks in a large pan. Cover with cold water. Bring to the boil and cook for 5 minutes. Drain and rinse the pork under cold water. Pat dry."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a dutch oven or heavy-based pan over medium-high heat. Add the pork pieces skin-side down. Sear for 3 to 4 minutes until the skin is golden. Turn and sear the other sides briefly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the sugar to the pan around the pork. Let it melt and caramelise for 1 to 2 minutes, stirring carefully."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the Shaoxing wine or rice vinegar. It will sizzle. Add both soy sauces, the star anise, cinnamon, ginger, spring onion bundle, and peppercorns."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in enough water to barely cover the pork. Bring to a boil, then reduce to a very low simmer. Cover and cook for 1 hour 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the lid. Increase heat to medium. Cook for 20 to 30 minutes more, turning the pork every few minutes, until the sauce reduces to a thick glaze that coats the meat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pick out the spring onion bundle, star anise, and cinnamon. Serve the pork over steamed rice, spooning the glaze over the top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce is too thin at the end",
              "cause": "The lid was on during the reduction phase, trapping steam.",
              "fix": "Remove the lid and cook uncovered on medium heat, stirring frequently, until the sauce thickens to a syrup."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pork skin is tough, not gelatinous",
              "cause": "The braise time was too short or the heat too high.",
              "fix": "Return the pork to the pan with a splash of water, cover, and braise for another 30 minutes on the lowest heat."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hong shao rou is one of the signature dishes of Shanghai and the surrounding Jiangnan region. The technique of red-braising is common across eastern China, but the Shanghainese version is notably sweeter than those from Hunan or Sichuan. Chairman Mao Zedong was famously devoted to the Hunanese version of the dish, which helped cement its national profile. In Shanghai home kitchens, hong shao rou is considered comfort food and often appears at Lunar New Year family meals."
          }
        ]
      }
    ]
  }
