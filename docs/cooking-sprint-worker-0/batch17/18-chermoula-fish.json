    {
      "slug": "chermoula",
      "term": "Chermoula",
      "definition": "A North African herb marinade and sauce made from fresh coriander, parsley, garlic, cumin, paprika, lemon juice and olive oil. Used across Morocco, Tunisia and Algeria."
    },
    {
      "slug": "scoring-fish",
      "term": "Scoring fish",
      "definition": "Making diagonal cuts through the skin and into the flesh of a fish before marinating. The cuts allow the marinade to penetrate the flesh rather than sitting only on the surface."
    }
  ],
