      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend or pound all chermoula ingredients to a rough paste. Taste and adjust salt and lemon."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Score each fillet 3 times across with a sharp knife. Rub the chermoula paste all over the fish, pressing it into the cuts."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Marinate in the fridge for at least 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a griddle pan over very high heat until smoking. Place fillets skin-side down. Cook without moving for 4 minutes until the skin is crisp and chars at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Flip carefully and cook for 2 to 3 minutes on the other side. The fish should flake easily when pressed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve with preserved lemon wedges, couscous or flatbread and extra chermoula on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Fish sticking to the pan",
              "cause": "Pan not hot enough or moved too early",
              "fix": "The fish releases naturally when the skin is ready. Do not force it. If it resists, wait another 30 seconds."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Chermoula burning in the pan",
              "cause": "Pan too hot for the herb paste",
              "fix": "The char on the herbs is part of the flavour. If it burns completely black, reduce heat slightly next time. A little dark colour is correct."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chermoula is used across North Africa, from Morocco to Egypt. The Moroccan version is the most herb-forward. The Tunisian version is spicier, with more chilli. In Morocco it is strongly linked to fish cookery along the Atlantic coast."
          }
        ]
      }
    ]
  }
