      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the sauce. Combine the sesame oil or paste, light soy, rice vinegar, chilli powder, ground pepper, garlic paste, and sugar in a bowl. Mix well. It will be thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the noodles according to packet instructions. Reserve a mug of cooking water before draining. Divide the noodles into 4 bowls."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the noodles cook, heat the oil in a wok over high heat. Add the minced pork and cook without stirring for 2 minutes until it starts to brown on the bottom."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Break up the pork and add the soy sauce and Shaoxing wine. Stir-fry for 3 to 4 minutes until the pork is cooked through and starting to crisp. Remove from heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Thin the sauce with 4 to 6 tablespoons of the hot noodle water. Stir until smooth and pourable."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon 2 to 3 tablespoons of sauce into each bowl of noodles. Toss to coat. Top with the pork, crushed peanuts, and spring onion. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce is too thick to coat the noodles",
              "cause": "Not enough hot cooking water was added to the sauce.",
              "fix": "Add more hot water a tablespoon at a time and stir until the sauce flows freely."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pork topping is grey and soft, not crispy",
              "cause": "The pan was not hot enough or the pork was moved too early.",
              "fix": "Use maximum heat and leave the pork undisturbed for 2 minutes before breaking it up. A well-seasoned wok or cast iron pan helps."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dan dan noodles started as a Chengdu street food. Vendors carried them on shoulder poles through the city. The dish has since spread to Sichuanese restaurants worldwide, but versions outside China often reduce the heat and add peanut butter. Neither is traditional."
          }
        ]
      }
    ]
  }
