  "glossaryTerms": [
    {
      "slug": "ma-la",
      "term": "Ma La",
      "definition": "The defining Sichuanese flavour profile combining ma (the numbing sensation from Sichuan pepper) and la (the heat from chilli). Together they produce a complex, tingling spiciness."
    },
    {
      "slug": "ya-cai",
      "term": "Ya Cai",
      "definition": "Yibin preserved mustard greens, a key ingredient in dan dan noodles. They add a salty, slightly fermented crunch. Available in Chinese supermarkets. A small amount of kimchi can substitute."
    },
    {
      "slug": "sesame-paste-chinese",
      "term": "Sesame Paste",
      "definition": "Chinese sesame paste made from roasted sesame seeds. Thicker and more intense than tahini. If using tahini, add a few drops of sesame oil to approximate the flavour."
    }
  ],
