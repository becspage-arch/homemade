  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The defining ingredient here is "
          },
          {
            "type": "text",
            "text": "palm nut concentrate ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "palm-nut-concentrate"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". Without it the dish cannot be made. Most recipes also call for "
          },
          {
            "type": "text",
            "text": "ground crayfish ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "crayfish-ground"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", which gives the soup its umami depth. Both are sold at West African grocery stores."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The soup thickens as it cooks. Keep stirring every few minutes to stop the palm base sticking to the bottom."
          }
        ]
      },
