      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season chicken with salt. Brown in a dry pan over high heat, 2 minutes per side. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the canned tomatoes, red pepper and chillies until smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In a large pot, combine palm nut concentrate (or coconut milk) with 400ml water. Stir over medium heat until combined."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion, garlic, blended tomato mix, bay leaves and ground crayfish. Stir well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add chicken pieces. Bring to a boil, then reduce to a simmer and cook covered for 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add spinach and cook for a further 5 minutes. Taste and adjust salt. Serve with fufu or rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Soup is too thin",
              "cause": "Not enough palm concentrate or too much water",
              "fix": "Simmer uncovered for 10 minutes to reduce. A good ofe akwu coats a spoon."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Soup tastes flat",
              "cause": "Missing the ground crayfish or insufficient seasoning",
              "fix": "Add a teaspoon of fish sauce as an alternative umami source. Adjust chilli and salt to taste."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ofe akwu is central to Igbo cooking from Anambra to Abia states. It is considered a soup of celebration and family. The dish is very similar to banga soup from the Niger Delta, though banga includes additional aromatic seeds like oburunbebe sticks. Both are served with pounded yam or starch (a thick cassava preparation) rather than rice."
          }
        ]
      }
    ]
  }
