      "slug": "yaji",
      "term": "Yaji",
      "definition": "The dry spice blend used for suya, made primarily from ground peanuts, ginger, paprika and chilli. Each vendor has their own proportions."
    },
    {
      "slug": "suya-skewers",
      "term": "Suya skewers",
      "definition": "Long flat metal skewers that hold thinly sliced meat for cooking over an open flame. Wooden skewers soaked in water are a workable substitute."
    }
  ],
