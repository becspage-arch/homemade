  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The spice mix called "
          },
          {
            "type": "text",
            "text": "yaji",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "yaji"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " is what makes suya distinct. Ground peanuts are the base, not a garnish. Thread the meat onto "
          },
          {
            "type": "text",
            "text": "suya skewers",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "suya-skewers"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " or soaked wooden skewers and cook over the highest heat available."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Slice beef as thin as possible, around 3mm. Partially freezing the meat for 20 minutes makes this much easier."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
