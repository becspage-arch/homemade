              "groupLabel": "To serve"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix all yaji ingredients together in a wide bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add oil to the spice mix and stir. Add the beef slices and press into the mix until evenly coated."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Thread 3 to 4 slices onto each skewer, spreading the meat flat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Chill for at least 1 hour, or overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a griddle pan or grill to very high heat. Cook skewers for 3 to 4 minutes per side until charred in places and cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dust with extra yaji and serve immediately with raw onion rings and sliced tomato."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Meat is tough",
              "cause": "Sliced too thick or cooked too slowly",
              "fix": "Slice as thin as possible and cook over the highest heat for a short time. The goal is char on the outside with just-cooked inside."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Peanuts burning",
              "cause": "Pan not hot enough before meat was added",
              "fix": "The pan must be fully preheated before the skewers go on. A smoking hot pan chars the outside fast before the coating can burn through."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Suya originated with the Hausa-Fulani people of northern Nigeria and has spread across the country and into neighbouring states. Street vendors set up charcoal grills after dark, skewering beef, chicken and offal for evening crowds. The dish has crossed into the Nigerian diaspora worldwide and is now sold in West African restaurants from London to Houston."
          }
        ]
      }
    ]
  }
