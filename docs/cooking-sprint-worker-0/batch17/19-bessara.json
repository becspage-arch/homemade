  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The "
          },
          {
            "type": "text",
            "text": "bessara consistency",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bessara-consistency"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " is somewhere between soup and hummus. Add water gradually when blending to get the right texture. The "
          },
          {
            "type": "text",
            "text": "cumin bloom",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "cumin-bloom"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " drizzled on top at serving adds a second layer of spice that stays fresh and bright."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Yellow split peas do not need soaking. Rinse and add directly to the pot. They take around 35 to 40 minutes to become completely soft."
          }
        ]
      },
      {
        "type": "heading",
