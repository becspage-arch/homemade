      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place split peas and 2 whole garlic cloves in a pot. Cover with 1 litre cold water. Bring to a boil, skim any foam, then simmer uncovered for 35 to 40 minutes until peas are completely soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain the peas, reserving the cooking water. Blend peas with 2 tablespoons olive oil, 2 crushed garlic cloves, cumin, paprika, lemon juice and salt. Add reserved water gradually until the mixture reaches a thick, pourable consistency."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and adjust salt and lemon."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat remaining 2 tablespoons olive oil in a small pan. Add 0.5 teaspoon cumin and swirl for 30 seconds until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour bessara into bowls. Drizzle with cumin oil, a pinch of chilli powder and paprika. Serve with bread."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Bessara too thick after blending",
              "cause": "Not enough cooking water added",
              "fix": "Add the reserved cooking water a tablespoon at a time while blending until the desired texture is reached."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Flavour is flat",
              "cause": "Not enough cumin or lemon",
              "fix": "Add an extra half teaspoon of cumin and squeeze more lemon. Taste after each addition."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bessara is the working breakfast of northern Morocco, particularly in the cities of Fez and Meknes. Vendors serve it before dawn to labourers and students from large pots over charcoal, ladled into shallow terracotta bowls with a drizzle of oil. The traditional version uses dried split fava beans, but yellow split peas have become common because they do not require hours of soaking and peeling. The dish also appears in Egypt under the same name, where it is fried into patties similar to falafel."
          }
        ]
      }
    ]
  }
