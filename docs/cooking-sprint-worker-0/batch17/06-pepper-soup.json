      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place chicken in a pot with onion, garlic, ginger, bay leaves and thyme. Cover with 1.2 litres cold water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a boil. Skim any grey foam from the surface. Reduce to a steady simmer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the allspice, crushed black pepper and whole chillies. Simmer for 30 minutes until chicken is cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and season with salt. The broth should be clear, golden and noticeably hot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve in bowls with fresh coriander if using. Eat with agidi (corn pudding) or plain bread."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth is cloudy",
              "cause": "Not skimmed or boiled too hard",
              "fix": "Skim thoroughly in the first 10 minutes and keep at a gentle simmer rather than a rolling boil."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Not enough heat",
              "cause": "Not enough chilli",
              "fix": "Pepper soup should have a building heat. Add more fresh chilli or a pinch of cayenne. Taste as you go."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pepper soup is the Nigerian equivalent of a restorative broth. It is served to new mothers, given to people with fevers, and eaten to counter the effects of a long night. Every region and every household has its own version. In the south the broth is typically made with goat or offal; in the north, chicken or fish is more common."
          }
        ]
      }
    ]
  }
