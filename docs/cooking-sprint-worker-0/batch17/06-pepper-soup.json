    {
      "slug": "pepper-soup-spice",
      "term": "Pepper soup spice",
      "definition": "A blend of dried seeds including calabash nutmeg (ehuru), uziza seeds and African pepper. Sold pre-mixed at West African grocery stores. Allspice and black pepper are a partial substitute."
    },
    {
      "slug": "point-and-kill",
      "term": "Point and kill",
      "definition": "Nigerian restaurant term for live catfish you choose yourself, killed fresh and cooked in pepper soup. The freshness intensifies the flavour."
    }
  ],
