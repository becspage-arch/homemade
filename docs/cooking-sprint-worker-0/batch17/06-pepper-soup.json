  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "What separates pepper soup from plain broth is the "
          },
          {
            "type": "text",
            "text": "pepper soup spice",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "pepper-soup-spice"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " blend. Without it the dish is just soup. Restaurant versions using the "
          },
          {
            "type": "text",
            "text": "point-and-kill",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "point-and-kill"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " method use very fresh catfish. Chicken thighs make an excellent home alternative."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Keep the broth clear. Skim any foam from the surface during the first 10 minutes of cooking."
          }
        ]
      },
