      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the pickles. Combine the rice vinegar, sugar, and salt in a bowl. Stir until dissolved. Toss in the julienned carrot and leave for at least 1 hour. The carrot will soften slightly and turn bright orange."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the pork marinade ingredients. Pour over the pork belly slices. Toss to coat. Leave for 30 minutes at room temperature or up to 2 hours in the fridge."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a griddle pan over high heat until smoking. Add the pork slices in batches, pressing flat. Cook for 3 to 4 minutes per side until charred and cooked through. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Split each baguette lengthways without cutting through fully. Spread a generous layer of pate on each cut side."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Layer the warm pork slices into the baguette. Add a handful of drained pickled carrot, fresh coriander, sliced spring onion, and green chilli to taste. Press together and eat immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pork sticks to the griddle and tears",
              "cause": "The griddle was not hot enough or the pork was moved too early.",
              "fix": "Do not touch the pork for the first 2 minutes. It will release naturally once a crust has formed."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pickled carrot is too sharp",
              "cause": "Too much vinegar or the carrot was left too long.",
              "fix": "Rinse briefly under cold water and toss with a pinch of sugar before using."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Banh mi emerged in Vietnam during French colonial rule. Baguettes became widely available in Saigon and other cities, and Vietnamese cooks adapted them. The filling is not French. It combines pickled vegetables, fresh herbs, and bold sauces in a way that is entirely Vietnamese."
          }
        ]
      }
    ]
  }
