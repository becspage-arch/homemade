      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make a quick prawn stock. Fry the reserved prawn shells in a little oil for 2 minutes. Add 800ml of water. Simmer for 15 minutes. Strain and discard the shells."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend or pound all the paste ingredients together until as smooth as possible."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large saucepan over medium heat. Add the paste. Fry, stirring constantly, for 8 to 10 minutes until the paste darkens, smells fragrant, and the oil starts to separate out around the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the prawn stock and bring to a simmer. Cook for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce to a gentle simmer and stir in the coconut milk. Add the fish sauce. Do not boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the prawns and cook for 3 to 4 minutes until pink and cooked through. Taste for seasoning. Add lime juice to taste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the soaked rice noodles between 4 deep bowls. Top with bean sprouts. Ladle the soup and prawns over. Scatter with coriander. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Coconut milk has curdled into grainy flecks",
              "cause": "The soup was boiled hard after the coconut milk was added.",
              "fix": "Keep the heat very low once coconut milk goes in. If the soup curdles, a blitz with an immersion blender can partially rescue the texture."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Paste is oily and bitter after frying",
              "cause": "The paste was fried too quickly on too-high heat.",
              "fix": "Fry paste on medium, not high, heat. The oil separating out is a good sign. Bitterness means the dried chilli was burnt."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Laksa is the defining dish of Peranakan cuisine. This is the cooking of the Straits Chinese who settled in the Malay Peninsula from the 15th century onwards. Their food blends Chinese and Malay traditions in ways that cannot now be separated."
          }
        ]
      }
    ]
  }
