  "glossaryTerms": [
    {
      "slug": "laksa-paste",
      "term": "Laksa Paste",
      "definition": "The aromatic base for laksa, typically containing dried chilli, lemongrass, shallots, galangal, and shrimp paste. Most of the flavour in a laksa comes from the quality and freshness of the paste."
    },
    {
      "slug": "coconut-milk-cooking",
      "term": "Coconut Milk",
      "definition": "The creamy liquid pressed from grated coconut flesh. Full-fat coconut milk is essential for laksa. It must not be boiled hard or it will split and become grainy."
    },
    {
      "slug": "sambal-paste",
      "term": "Sambal",
      "definition": "A chilli-based condiment used across Malaysian and Indonesian cooking. A spoonful stirred into laksa at the table adds extra heat."
    }
  ],
