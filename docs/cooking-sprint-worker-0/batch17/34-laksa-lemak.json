  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The depth of a laksa depends almost entirely on the "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "laksa-paste"
                }
              }
            ],
            "text": "laksa paste "
          },
          {
            "type": "text",
            "text": ". This recipe builds it from scratch. Bottled laksa paste works as a shortcut but produces a noticeably flatter result. Once the paste is cooked out in oil, the rest of the dish comes together quickly."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Never boil the soup hard once the "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "coconut-milk-cooking"
                }
              }
            ],
            "text": "coconut milk"
          },
          {
            "type": "text",
            "text": " goes in. Keep it at a gentle simmer. Serve with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "sambal-paste"
                }
              }
            ],
            "text": "sambal"
          },
          {
            "type": "text",
            "text": " on the side for those who want more heat."
          }
        ]
      },
