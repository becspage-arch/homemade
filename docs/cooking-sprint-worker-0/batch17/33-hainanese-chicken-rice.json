  "glossaryTerms": [
    {
      "slug": "gentle-poaching",
      "term": "Gentle Poaching",
      "definition": "Cooking chicken in water held just below a simmer, around 80C. The chicken goes in, the water is brought barely to temperature, then the heat is turned off. The residual heat finishes the cooking, producing extremely tender, silky flesh."
    },
    {
      "slug": "ice-bath",
      "term": "Ice Bath",
      "definition": "Plunging cooked food into a large bowl of ice and cold water immediately after cooking. For poached chicken, this stops the cooking instantly and contracts the skin, giving it a silky, slightly gelatinous texture."
    },
    {
      "slug": "chicken-rice-fat",
      "term": "Chicken Fat",
      "definition": "The fat skimmed from the top of the poaching stock. Used to fry the rice before adding stock. It gives the rice its distinctive flavour and a slightly shiny surface."
    }
  ],
