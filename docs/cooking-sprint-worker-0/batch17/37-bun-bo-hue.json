  "glossaryTerms": [
    {
      "slug": "annatto-oil",
      "term": "Annatto Oil",
      "definition": "Oil infused with annatto seeds to produce a deep red colour. Used in bun bo Hue to give the broth its distinctive rust-red colour. Simulated here using a small amount of turmeric and chilli."
    },
    {
      "slug": "mam-ruoc",
      "term": "Shrimp Paste",
      "definition": "Fermented shrimp paste used in Southeast Asian cooking. In bun bo Hue, a small amount is dissolved in the broth at the end of cooking to add depth and a distinctive umami quality. Fish sauce can be increased to substitute."
    },
    {
      "slug": "round-rice-noodles",
      "term": "Round Rice Noodles",
      "definition": "Thick, round rice noodles specific to bun bo Hue. About 3mm in diameter, they are thicker and rounder than the flat noodles used in pho. Dried round rice noodles (bun) need soaking before use."
    }
  ],
