      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blanch the beef shin and pork belly in boiling water for 5 minutes. Drain and rinse under cold water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Char the onion and ginger over a gas flame or under the grill until deeply blackened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the blanched meats, charred onion and ginger, lemon zest or lemongrass, and star anise in a stockpot. Cover with 3 litres of cold water. Bring to the boil, skim well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce to a very gentle simmer. Cook for 2 hours 30 minutes. Remove the pork belly after 1 hour if it is cooked through. It should be tender but not falling apart. Set aside. Continue simmering the beef shin."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the chilli oil. Heat the vegetable oil in a small pan. Add the garlic and cook for 30 seconds. Add the chilli powder and turmeric. Stir for 30 seconds until fragrant and sizzling. Remove from heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the beef shin from the broth. Slice both meats thinly. Strain the broth. Season with fish sauce, sugar, and salt. Stir in the chilli oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blanch the soaked noodles briefly in boiling water, 30 to 60 seconds. Divide between 4 bowls. Top with the sliced meats. Ladle the hot broth over. Serve with spring onion, bean sprouts, mint, and lime."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth has no lemongrass fragrance",
              "cause": "Lemon zest is a substitute and has less intensity than real lemongrass.",
              "fix": "Simmer for longer with the zest in place. Alternatively, add a few drops of fresh lemon juice to the finished broth to lift the citrus note."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pork belly is overcooked and falling apart",
              "cause": "Left in the broth for too long alongside the beef.",
              "fix": "Remove the pork belly after 1 hour and set it aside to cool. Slice and reheat in the bowl when serving."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bun bo Hue comes from the city of Hue in central Vietnam. Hue was the imperial capital of the Nguyen dynasty, and the city's food reflects a long tradition of refined cooking. This soup is spicier and more complex than pho."
          }
        ]
      }
    ]
