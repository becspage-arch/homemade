  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 4 and is ready in about 45 minutes."
          },
          {
            "type": "text",
            "text": "Nikujaga"
          },
          {
            "type": "text",
            "text": "is often called the Japanese home cooking dish. It is the food Japanese people say tastes like their mother's cooking. The flavours are simple: soy, sweetness, and the background depth of"
          },
          {
            "type": "text",
            "text": "dashi"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thinly sliced pork belly is traditional in the Kansai region. Beef is used in Kanto and Tokyo. Either works well. The potato should be floury, not waxy, so it absorbs the broth. King Edward or Maris Piper are good choices."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "pork-shoulder",
              "amount": 400,
              "unit": "g",
              "prepNote": "thinly sliced into 3cm pieces",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "dashi-stock",
              "amount": 600,
              "unit": "ml",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "soy-sauce-light",
              "amount": 60,
              "unit": "ml",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
