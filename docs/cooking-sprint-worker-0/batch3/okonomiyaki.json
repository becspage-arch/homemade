      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the Worcestershire sauce and tonkatsu sauce together to make the okonomiyaki sauce. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk the eggs, dashi, and soy sauce together in a large bowl. Add the flour and stir until just combined. Do not overmix."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the shredded cabbage and spring onions to the batter. Fold together until the cabbage is coated. The mixture will be very thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a small amount of oil in a frying pan over medium heat. Spoon a quarter of the batter into the pan. Press it gently into a round about 2cm thick and 18cm across."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lay 2 or 3 strips of pork belly across the top of the pancake."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook for 5 to 6 minutes over medium heat until the underside is deep golden and the edges look set. Slide a wide spatula underneath."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Flip the pancake in one confident movement, pork side down. Press the top gently with the spatula to flatten slightly. Cook for a further 5 to 6 minutes until the pork is cooked and the pancake is cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slide onto a plate. Drizzle the okonomiyaki sauce over in a zigzag. Drizzle Japanese mayonnaise over the top in the same pattern. Scatter with bonito flakes and aonori. Repeat for the remaining pancakes."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The pancake falls apart when flipped",
              "cause": "The underside was not fully set, or the pancake was too thick",
              "fix": "Cook on medium rather than medium-high. Wait until the edges of the pancake look dry and the bottom is firmly golden before flipping. Flip with a large, flat spatula."
            },
            {
              "symptom": "The inside is raw when the outside is golden",
              "cause": "The heat was too high",
              "fix": "Reduce the heat to medium-low after flipping and cover the pan with a lid for 3 minutes. The trapped steam will cook the interior without burning the surface."
            },
            {
              "symptom": "The batter is too thin and the pancake spreads flat",
              "cause": "Too much dashi was added or the flour was not measured accurately",
              "fix": "Add a tablespoon of flour at a time to thicken the batter before cooking. The correct batter holds its shape loosely when spooned."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Okonomiyaki is the street food and comfort food of Osaka and Hiroshima. The Osaka version mixes all the ingredients together. The Hiroshima version layers them with noodles. Both cities claim theirs as the original. It is sold at stalls, in restaurants, and cooked at home on a flat griddle."
          }
        ]
      }
    ]
  }
}