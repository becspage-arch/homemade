  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 4 as a starter and takes about 40 minutes. The wings are fried twice to achieve the thin, crispy skin that"
          },
          {
            "type": "text",
            "text": "Nagoya cuisine"
          },
          {
            "type": "text",
            "text": "is famous for, then tossed in a sticky sweet soy"
          },
          {
            "type": "text",
            "text": "tare"
          },
          {
            "type": "text",
            "text": "glaze."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The double-fry is the key step. The first fry at a lower temperature cooks the wings through. The second fry at a higher temperature crisps the skin. Do not skip this step. Make the glaze in a separate pan so it is ready to toss with the wings the moment they come out of the oil."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "chicken-wings",
              "amount": 1000,
              "unit": "g",
              "prepNote": "tips removed, split at the joint into two pieces each",
              "isOptional": false,
              "groupLabel": null
            },
            {
