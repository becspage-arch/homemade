      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pat the chicken wings dry with kitchen paper. Toss in the cornflour until each piece is lightly and evenly coated. Shake off any excess."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the oil into a wok. Heat to 160°C. Fry the wings in batches for 8 minutes until cooked through but not yet deeply coloured. Drain on a wire rack."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Increase the oil temperature to 190°C. Fry the wings again in batches for 3 to 4 minutes until the skin is thin, deep golden and very crisp. Drain on the rack."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the wings are in their second fry, make the"
                  },
                  {
                    "type": "text",
                    "text": "tare"
                  },
                  {
                    "type": "text",
                    "text": ". Put the soy sauce, mirin, sake, sugar, garlic and ginger in a small saucepan. Bring to a simmer and cook for 3 minutes until slightly thickened and glossy. Remove from the heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toss the hot"
                  },
                  {
                    "type": "text",
                    "text": "tebasaki"
                  },
                  {
                    "type": "text",
                    "text": "wings in the tare until fully coated. Scatter over the sesame seeds. Serve straight away."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Skin is not crispy after the second fry",
              "cause": "The oil was not hot enough or the wings were overcrowded in the wok.",
              "fix": "Check the oil temperature with a thermometer. Fry in smaller batches so the temperature does not drop when the wings go in."
            },
            {
              "symptom": "Glaze is too thin and runs off the wings",
              "cause": "The tare was not reduced enough or the wings were not hot when tossed.",
              "fix": "Simmer the tare a little longer until it coats the back of a spoon. Toss the wings immediately after they come out of the oil."
            },
            {
              "symptom": "Wings are greasy inside",
              "cause": "The first fry temperature was too high and the outside cooked before the inside.",
              "fix": "Keep the first fry at 160°C. The lower temperature allows the meat to cook through gently without the outside over-colouring."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tebasaki wings are one of the defining dishes of Nagoya in Aichi Prefecture. They became famous through a local restaurant chain called Furaibo, which developed the style in the 1960s. The Nagoya version is distinguished by its thin, very crispy skin and a sweet soy glaze that is applied after frying rather than before. Nagoya food culture is known for bold seasoning and dishes that are richer and more intensely flavoured than those found elsewhere in Japan."
          }
        ]
      }
    ]
  }
