      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the beef mince, pork mince, cooled sweated onion, eggs, soaked panko, nutmeg, black pepper, and salt in a large bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix firmly with your hands for 2 to 3 minutes until the mixture is smooth and slightly tacky. It should hold together when squeezed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide into 4 equal portions. Shape each into an oval patty about 2cm thick. Press a small indent in the centre of each with your thumb. This helps the patty cook evenly without puffing up."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large frying pan over medium-high heat. Add the patties and cook for 3 to 4 minutes until a deep brown crust forms underneath."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Turn the patties over. Reduce the heat to medium. Cover with a lid and cook for a further 8 to 10 minutes until cooked through. Check the centre with a skewer. The juices should run clear."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the patties to a warm plate. Pour the red wine into the pan and let it bubble for 2 minutes, scraping up any bits from the base."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the demi-glace, Worcestershire sauce, and soy sauce. Simmer for 3 to 4 minutes until the sauce coats the back of a spoon. Add the butter and swirl to finish."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the patties back in the sauce for 1 minute. Serve over steamed rice with the sauce spooned over."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The patties autumn apart in the pan",
              "cause": "The mixture was not mixed enough or the fat content of the mince was too low",
              "fix": "Mix the meat mixture for a full 2 minutes. The mixture should feel sticky and cohesive before shaping. Use mince with at least 15% fat."
            },
            {
              "symptom": "The patties are cooked on the outside but raw in the centre",
              "cause": "The heat was too high, or the patties were too thick",
              "fix": "After browning, reduce the heat to medium and always cover the pan with a lid. This steams the interior without burning the crust."
            },
            {
              "symptom": "The sauce is too thin and does not coat the patties",
              "cause": "The sauce was not reduced long enough",
              "fix": "Simmer the sauce for longer, or mix 5g of cornflour with a splash of cold water and whisk it in. Bring back to a simmer until thickened."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hambagu arrived in Japan with Western-style cooking in the Meiji era and became a firm family-meal staple in the postwar decades. It appears on the menus of yoshoku restaurants, which specialise in Japanese adaptations of Western dishes. At home it is often served on a sizzling cast-iron plate alongside a fried egg, corn, and a mound of rice. It appears regularly on school lunch menus and is a dish many Japanese people associate with childhood."
          }
        ]
      }
    ]
  }
