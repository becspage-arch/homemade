      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix together the Worcestershire sauce, soy sauce, and sugar in a small bowl. Stir to dissolve the sugar. Set the sauce aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "If using fresh noodles, loosen them with your fingers. If using pre-cooked packet noodles, follow the packet instruction to separate them."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the wok over high heat until it starts to smoke. Add the oil and swirl to coat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the pork in a single layer. Leave it to colour for 1 to 2 minutes without stirring. Toss and cook for a further minute until cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the carrot and cabbage. Stir-fry for 2 to 3 minutes until just beginning to soften."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the noodles to the wok. Toss everything together over high heat for 2 minutes until the noodles are heated through and beginning to colour at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the sauce around the edges of the wok and toss everything together quickly. Add the spring onions and toss once more."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide into bowls. Drizzle with Japanese mayonnaise, scatter over the bonito flakes and sesame seeds, and serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The noodles are sticking together and clumping",
              "cause": "The wok was not hot enough or the noodles were added cold and wet",
              "fix": "Make sure the wok is smoking hot before the noodles go in. Separate them well before adding. A splash of water and a quick toss can help loosen them."
            },
            {
              "symptom": "The vegetables are waterlogged and soggy",
              "cause": "Too many ingredients were added at once, dropping the wok temperature",
              "fix": "Cook in batches if your wok is smaller than 32cm. The wok must stay hot throughout. Work quickly over the highest heat your hob can produce."
            },
            {
              "symptom": "The sauce tastes flat",
              "cause": "The sauce needs a little more umami or acidity",
              "fix": "Add an extra splash of soy sauce and a small amount of oyster sauce if you have it. Taste before serving and adjust."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Yakisoba is Japanese street food at its most straightforward. It is sold at festivals, fairs, and market stalls across Japan throughout the year. The dish developed in the Taisho and early Showa periods as a cheap, fast meal for working people. The sauce is loosely inspired by Worcestershire sauce, which arrived in Japan in the late 19th century and was adapted into a sweeter, thicker condiment. Yakisoba noodles come in pre-cooked packs at Japanese and Asian supermarkets and make this an even faster weeknight meal."
          }
        ]
      }
    ]
  }
