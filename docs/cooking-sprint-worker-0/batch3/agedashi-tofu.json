      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Wrap the tofu block in 3 sheets of kitchen paper. Place a plate or chopping board on top and leave to press for at least 20 minutes. Change the paper if it becomes saturated."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the broth. Combine the dashi, soy sauce, and mirin in a small saucepan. Bring to a gentle simmer over medium heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir the cornflour-water mixture, then whisk it into the simmering broth. Cook for 1 to 2 minutes, stirring, until the broth is lightly thickened and glossy. Keep warm over very low heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wok to 180°C."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cut the pressed tofu into 6 to 8 blocks, each roughly 5cm square. Spread the cornflour on a plate. Roll each block gently in the cornflour until lightly and evenly coated. Shake off any excess."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lower the tofu pieces into the oil carefully, a few at a time. Fry for 2 to 3 minutes, turning gently, until the outside is lightly golden and the coating is set."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove with a slotted spoon and drain briefly on kitchen paper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the tofu between small deep bowls. Ladle the warm broth over the tofu to come halfway up the sides. Top with grated ginger, sliced spring onions, and bonito flakes. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The oil spits violently when the tofu goes in",
              "cause": "The tofu was not pressed dry enough",
              "fix": "Press the tofu for longer and change the kitchen paper if it becomes wet. Pat each piece dry again with fresh paper just before coating and frying."
            },
            {
              "symptom": "The coating slides off in the oil",
              "cause": "The tofu surface was still wet, or too much loose flour was left on",
              "fix": "Pat the tofu dry. After rolling in cornflour, shake off all the excess. Only a thin, even film should remain. Lower the tofu gently and do not disturb it for the first 30 seconds of frying."
            },
            {
              "symptom": "The coating goes soft immediately in the broth",
              "cause": "The broth was poured over too soon, or too much broth was used",
              "fix": "Add the broth at the very last moment, just before serving. The broth should come only halfway up the tofu, not submerge it. Serve and eat without delay."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Agedashi tofu is a Japanese restaurant classic and a common izakaya dish. It is also made at home as a simple starter. The starch coating turns the broth slightly thick on contact, making a light sauce that clings to each piece."
          }
        ]
      }
    ]
  }
