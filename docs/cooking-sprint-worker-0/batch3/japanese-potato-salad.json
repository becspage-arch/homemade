      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toss the cucumber slices with a pinch of salt in a small bowl. Leave for 10 minutes, then squeeze out the water with your hands. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the potato and carrot together in a large saucepan of salted boiling water. Bring to the boil and cook for 12 to 15 minutes until the potato is completely tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain and return to the pan. Spread on a tray to cool for 2 minutes. While still warm, sprinkle the rice vinegar and sugar over the potato. Toss gently."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Use a potato masher to roughly mash the mixture. You want a textured result, not a smooth puree. Some chunks should remain. Leave to cool completely."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Once the potato is at room temperature, add the Japanese mayonnaise and fold through gently. Season with salt to taste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fold in the squeezed cucumber and ham if using. Taste and adjust the seasoning."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Chill for at least 30 minutes before serving, or serve at room temperature straight away. The salad keeps in the fridge for up to 2 days."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The salad is watery",
              "cause": "The cucumber was not salted and squeezed, or the potato was not drained properly",
              "fix": "Always salt the cucumber and squeeze out the water thoroughly before adding it. Make sure the potato is completely drained and steamed dry before mashing."
            },
            {
              "symptom": "The mayonnaise looks greasy or separated",
              "cause": "The potato was still warm when the mayonnaise was added",
              "fix": "The potato must cool to room temperature first. Spread it on a wide tray to speed up cooling. Never add mayo to warm potato."
            },
            {
              "symptom": "The texture is too smooth and uniform",
              "cause": "The potato was overmashed",
              "fix": "Japanese potato salad should have texture. Mash roughly with a hand masher for only a few strokes. Stop while there are still small chunks of potato visible."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Japanese potato salad is a Western-influenced dish that has been thoroughly absorbed into everyday Japanese home cooking. It appears in bento boxes, as a side at izakayas, and in the prepared-food sections of supermarkets and convenience stores. Kewpie mayonnaise, which was introduced to Japan in 1925, is central to the dish and gives it a richness that distinguishes it from the sharper, thinner dressings used in European versions. Most Japanese households serve it cold as part of a set meal alongside a main protein dish and rice."
          }
        ]
      }
    ]
  }
