      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the rice according to the packet instructions. Keep warm with the lid on."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the"
                  },
                  {
                    "type": "text",
                    "text": "dashi"
                  },
                  {
                    "type": "text",
                    "text": ", soy sauce,"
                  },
                  {
                    "type": "text",
                    "text": "mirin"
                  },
                  {
                    "type": "text",
                    "text": ", and sugar in a wide frying pan. Bring to a simmer over medium heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chicken pieces in a single layer. Simmer for 6 to 8 minutes, turning once, until the chicken is just cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter the spring onion pieces over the chicken. Pour the beaten egg evenly over the surface. Cover the pan with a lid."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook for 1 to 2 minutes until the egg is just set but still slightly runny in the centre. Remove from the heat immediately."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the rice between 4 bowls. Slide a portion of the chicken and egg mixture over each bowl of rice. Spoon over some of the broth. Top with shredded nori."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Egg is fully set and rubbery",
              "cause": "The egg cooked for too long after adding to the pan.",
              "fix": "Watch the egg carefully. Remove the pan from the heat while the surface still looks slightly underdone. Carry-over heat will finish it in the bowl."
            },
            {
              "symptom": "Sauce is too sweet",
              "cause": "The mirin and sugar ratio is too high for your taste.",
              "fix": "Reduce the mirin by 10ml and omit the sugar next time. Taste the simmering broth before adding the chicken and adjust to your preference."
            },
            {
              "symptom": "Chicken is tough",
              "cause": "The chicken was overcooked or the heat was too high.",
              "fix": "Simmer gently, not at a rolling boil. Chicken thighs take around 6 to 8 minutes. Cut a piece open to check it is white throughout before adding the egg."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Oyakodon is a staple of Japanese home cooking and appears on the menu of almost every Japanese restaurant. It originated in the Meiji era in Tokyo. The dish became nationally popular via railway bento boxes in the late 19th century. Today it is considered one of the definitive Japanese comfort foods. Each family has its own small variations on the broth ratio."
          }
        ]
      }
    ]
  }
