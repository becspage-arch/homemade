  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 4 and takes about 55 minutes from start to finish."
          },
          {
            "type": "text",
            "text": "Japanese curry, known as"
          },
          {
            "type": "text",
            "text": "karē"
          },
          {
            "type": "text",
            "text": "raisu, is milder and sweeter than Indian or Thai curry. It is thickened with a"
          },
          {
            "type": "text",
            "text": "roux"
          },
          {
            "type": "text",
            "text": "block sold in Japanese supermarkets, which dissolves straight into the sauce."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cook the curry and the rice at the same time. The sauce holds well and tastes better the next day, making this a good batch-cook dish. Serve with rice on one side of the bowl and curry poured over the other half. This is the traditional way to eat it."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "chicken-thigh",
              "amount": 600,
              "unit": "g",
              "prepNote": "boneless, cut into 3cm chunks",
              "isOptional": false,
              "groupLabel": null
            },
            {
