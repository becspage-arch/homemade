  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 4 and takes about 50 minutes. It draws on the idea of"
          },
          {
            "type": "text",
            "text": "French onion soup"
          },
          {
            "type": "text",
            "text": "but adds soy sauce to give the broth a deeper, more savoury note."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Do not rush the onions. Thirty minutes over a low heat is what turns them golden and sweet. Stir them every 5 minutes so they colour evenly without burning. If they start to stick, add a small splash of water and scrape up the base."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "onion",
              "amount": 600,
              "unit": "g",
              "prepNote": "peeled and finely sliced",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "unsalted-butter",
              "amount": 40,
              "unit": "g",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "stock-beef",
              "amount": 1000,
              "unit": "ml",
              "prepNote": null,
              "isOptional": false,
