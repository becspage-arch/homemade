              "amount": 100,
              "unit": "g",
              "prepNote": "grated",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the butter in a large saucepan over a low heat. Add the sliced onions and a pinch of salt. Cook over a low heat for 30 minutes, stirring every 5 minutes, until deeply"
                  },
                  {
                    "type": "text",
                    "text": "caramelised"
                  },
                  {
                    "type": "text",
                    "text": "and golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the sake and let it bubble for 1 minute to cook off the alcohol."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the beef stock and soy sauce. Bring to a simmer and cook for 10 minutes. Taste and adjust the seasoning."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the grill to high. Toast the bread slices on both sides under the grill until golden. Remove and top each slice generously with grated Gruyere."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle the soup into four ovenproof bowls. Float a cheese toast on top of each. Place the bowls under the grill for 3 to 4 minutes until the cheese is bubbling and golden. This is the"
                  },
                  {
                    "type": "text",
                    "text": "gratinee"
                  },
                  {
                    "type": "text",
                    "text": "finish. Serve straight away."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Onions are pale and not sweet after 30 minutes",
              "cause": "The heat was too low or the pan was overcrowded.",
              "fix": "Increase the heat slightly to medium-low. Stir more often. Onions need direct contact with the base of the pan to colour properly."
            },
            {
              "symptom": "Soup tastes too salty",
              "cause": "The beef stock was already seasoned and the soy sauce added too much salt on top.",
              "fix": "Use low-sodium stock or unsalted homemade stock. Add the soy sauce gradually and taste as you go."
            },
            {
              "symptom": "Cheese toast has sunk into the soup",
              "cause": "The bread was too thin or too light to float on the soup.",
              "fix": "Use thick bread, at least 2cm, and toast it well on both sides so it is sturdy before the cheese goes on."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "French onion soup arrived in Japan through the country's long love of French cuisine. Japanese cooks began adding soy sauce and sake to the broth to bring the flavours closer to home. The result is a soup that tastes both familiar and distinctly Japanese. It appears on the menus of yoshoku restaurants, the category of Western-influenced Japanese cooking that developed through the twentieth century."
          }
        ]
      }
    ]
  }
}