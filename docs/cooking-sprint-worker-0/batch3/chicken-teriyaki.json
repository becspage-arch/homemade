  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 4 and takes around 30 minutes from start to finish. Chicken thighs are cooked in a pan and coated in a sticky, glossy"
          },
          {
            "type": "text",
            "text": "teriyaki"
          },
          {
            "type": "text",
            "text": "glaze made with soy sauce,"
          },
          {
            "type": "text",
            "text": "mirin"
          },
          {
            "type": "text",
            "text": ", and"
          },
          {
            "type": "text",
            "text": "sake"
          },
          {
            "type": "text",
            "text": ". Serve over steamed rice with a scattering of sesame seeds."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use bone-in or boneless thighs with the skin on. Press the skin flat against the pan as it cooks so it makes direct contact with the surface. This gives you crisp, caramelised skin rather than a steamed, flabby result. Remove excess fat from the thighs before cooking to avoid a greasy sauce."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "chicken-thigh",
              "amount": 8,
              "unit": "piece",
              "prepNote": "skin-on, boneless, excess fat trimmed",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "soy-sauce-light",
              "amount": 60,
              "unit": "ml",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "mirin",
              "amount": 60,
              "unit": "ml",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "sake",
              "amount": 60,
              "unit": "ml",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
