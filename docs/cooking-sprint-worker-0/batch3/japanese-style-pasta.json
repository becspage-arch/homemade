  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 2 and takes about 30 minutes. It is a classic example of"
          },
          {
            "type": "text",
            "text": "wafu"
          },
          {
            "type": "text",
            "text": "cooking, where Italian pasta is paired with Japanese seasonings."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The sauce comes together in the frying pan off the heat. Add the butter and soy sauce to the hot pan after it comes off the hob, then toss in the pasta quickly. Moving fast keeps the sauce silky rather than greasy. Add a splash of pasta water to loosen if needed."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 2,
          "items": [
            {
              "ingredientSlug": "spaghetti",
              "amount": 200,
              "unit": "g",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "salmon-fillet",
              "amount": 300,
              "unit": "g",
              "prepNote": "skin removed, cut into 3cm chunks",
              "isOptional": false,
              "groupLabel": null
            },
