  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 4 and is ready in about 20 minutes. Cold"
          },
          {
            "type": "text",
            "text": "soba"
          },
          {
            "type": "text",
            "text": "noodles are piled on a"
          },
          {
            "type": "text",
            "text": "zaru"
          },
          {
            "type": "text",
            "text": "or plate and served alongside a bowl of"
          },
          {
            "type": "text",
            "text": "tsuyu"
          },
          {
            "type": "text",
            "text": "dipping sauce made with dashi, soy sauce, and"
          },
          {
            "type": "text",
            "text": "mirin"
          },
          {
            "type": "text",
            "text": ". You pick up a small bundle of noodles, dip them briefly in the sauce, and eat. It is one of the simplest and most satisfying lunches in Japanese cooking."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rinse the cooked noodles under cold running water straight away. Rub them between your palms as you rinse. This removes the surface starch that makes noodles sticky and clump together. Drain well and pile them loosely on the serving plate."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "noodles-soba",
              "amount": 400,
              "unit": "g",
