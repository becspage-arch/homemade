        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the soy sauce,"
                  },
                  {
                    "type": "text",
                    "text": "sake"
                  },
                  {
                    "type": "text",
                    "text": ","
                  },
                  {
                    "type": "text",
                    "text": "mirin"
                  },
                  {
                    "type": "text",
                    "text": ", ginger, garlic, and sesame oil in a bowl. Add the chicken pieces and mix well. Cover and leave to marinate for at least 15 minutes, or up to 2 hours in the fridge."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the vegetable oil into a wok and heat to 160°C. Use a kitchen thermometer to check the temperature."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lift the chicken pieces from the marinade. Toss them in the cornflour until evenly coated. Shake off any excess."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the chicken in batches of 6 to 8 pieces. Cook for 4 to 5 minutes until pale golden and just cooked through. Remove with a slotted spoon to a wire rack. Do not crowd the wok."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rest all the chicken for 3 minutes. Increase the oil temperature to 180°C."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the chicken to the hot oil in batches. Fry for 90 seconds until deeply golden and very crisp. Drain on the wire rack."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve immediately with Japanese mayonnaise and sliced spring onions."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Chicken is soggy, not crispy",
              "cause": "The oil temperature dropped too low during frying, or the chicken was crowded.",
              "fix": "Fry in small batches and keep the oil between 155°C and 165°C for the first fry. Always rest and second-fry for the final crunch."
            },
            {
              "symptom": "Coating falls off during frying",
              "cause": "The marinade was too wet when the cornflour was added.",
              "fix": "Lift each piece from the marinade and let excess drip off before coating. Pat dry with kitchen paper if the chicken is very wet."
            },
            {
              "symptom": "Chicken is raw inside but brown outside",
              "cause": "The oil was too hot at the first fry stage.",
              "fix": "Keep the first fry at 160°C. Use a thermometer. If the oil is too hot, the outside browns before the inside cooks."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Karaage is eaten everywhere in Japan. It appears in bento boxes, at izakaya bars, and in convenience stores. It is one of the most requested home-cooked dishes in Japanese households. Oita prefecture in Kyushu is famous for its karaage culture and even holds a dedicated karaage festival each year."
          }
        ]
      }
    ]
  }
