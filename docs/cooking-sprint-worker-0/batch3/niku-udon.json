  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 4 and takes about 30 minutes from start to finish. It gives you four bowls of hot, comforting noodle soup with pork belly on top."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cook the pork belly slices in a dry frying pan before adding them to the broth. This colours them slightly and improves the flavour. Do not boil the broth hard once the noodles go in, or they will turn mushy."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "noodles-udon",
              "amount": 600,
              "unit": "g",
              "prepNote": "fresh or vacuum-packed",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "pork-belly",
              "amount": 300,
              "unit": "g",
              "prepNote": "thinly sliced",
