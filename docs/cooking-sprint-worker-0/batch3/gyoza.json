      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the pork mince, spring onions, ginger, garlic, soy sauce, sake, sesame oil, and cornflour together in a bowl. Stir vigorously for 2 minutes until the mixture becomes slightly sticky. This helps the filling hold together."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lay a gyoza wrapper flat on your palm. Place 1 heaped teaspoon of filling in the centre. Dampen the edge of the wrapper with a little water using your finger."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fold the wrapper in half over the filling. Use"
                  },
                  {
                    "type": "text",
                    "text": "pleating"
                  },
                  {
                    "type": "text",
                    "text": "to seal the curved edge: make 4 to 5 small folds along the front edge, pressing each against the flat back. Place on a floured tray. Repeat with the remaining wrappers and filling."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the vegetable oil in a large frying pan over medium-high heat. Arrange 12 gyoza flat-side down in a single layer. Fry for 2 minutes until the bases are golden and crisp."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add 80ml of water to the pan. Immediately cover with a lid. Steam for 5 to 6 minutes until the water has mostly evaporated."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the lid. Let the remaining water evaporate and fry for 1 to 2 more minutes until the bases are crisp again. Slide onto a plate. Repeat with the remaining gyoza."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the dipping sauce ingredients together. Serve alongside the hot gyoza."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Gyoza stick to the pan and tear when lifted",
              "cause": "The pan was not hot enough before adding oil, or the oil was not hot before adding the gyoza.",
              "fix": "Heat the pan over medium-high heat for 1 minute before adding oil. Add the gyoza only when the oil shimmers. They will release naturally once the base is golden."
            },
            {
              "symptom": "Filling is raw inside after steaming",
              "cause": "The wrappers were sealed too tightly, or the steam time was too short.",
              "fix": "Steam for a full 6 minutes with the lid on. If in doubt, cut one open after cooking to check. Pork filling should be white all the way through."
            },
            {
              "symptom": "Wrappers are tough and chewy",
              "cause": "The gyoza were overcooked during the frying stage, or homemade wrappers were rolled too thick.",
              "fix": "Use ready-made gyoza wrappers if available. Stick to the timing in the recipe. Overcooked wrappers dry out and become leathery."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Gyoza arrived in Japan from China during the Second World War. Japanese cooks adapted the recipe, making the wrappers thinner and the garlic and ginger flavour more pronounced. Today the city of Utsunomiya claims to be Japan's gyoza capital and holds an annual festival. Gyoza are sold everywhere from ramen shops to izakaya to supermarket frozen aisles. At home they are a weekend project that the whole family joins in on."
          }
        ]
      }
    ]
  }
