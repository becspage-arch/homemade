      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the dough by mixing the flour, yoghurt and a little water into a soft mass. Rest it covered for 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For the chole, fry the onions in 3 tablespoons of oil until golden. Add garlic and ginger."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the cumin, coriander and chilli powder, then the tomatoes. Cook for 8 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chickpeas and 250ml water. Simmer for 20 minutes, mashing a few to thicken."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and coriander. Season to taste and keep warm."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll the dough into discs and fry in hot oil, pressing gently, until puffed and golden. Serve with the chole."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The bhature did not puff",
              "cause": "The oil was not hot enough",
              "fix": "Heat the oil until a scrap of dough rises at once before frying."
            },
            {
              "symptom": "The chole is bland",
              "cause": "The base was undercooked",
              "fix": "Brown the onions and tomatoes fully before adding chickpeas."
            },
            {
              "symptom": "The dough is tough",
              "cause": "It was not rested enough",
              "fix": "Rest the dough for the full hour so it relaxes."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chole bhature is a weekend treat in Punjab and Delhi. The fried bread makes it feel special. It is rich, so people eat it for a late brunch. Serve with sliced onion and pickle. Save it for days when you want a feast."
          }
        ]
      }
    ]
  }
