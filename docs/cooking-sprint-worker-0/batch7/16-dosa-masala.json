      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Soak the rice and lentils for 4 hours, then blend with water to a smooth batter. Leave to ferment overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For the filling, heat the oil and add the mustard seeds and "
                  },
                  {
                    "type": "text",
                    "text": "curry leaves",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "curry-leaves"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " until they crackle."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onion, green chilli and ginger until soft. Stir in the turmeric."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the boiled potato, mash roughly and season to taste. Stir in the coriander."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a wide frying pan. Pour a ladle of batter and spread it thin in a spiral. Drizzle with oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook until crisp and golden, spoon in the potato, fold and serve hot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The dosa sticks",
              "cause": "The pan was not seasoned",
              "fix": "Wipe the hot pan with oil and a cut onion before each dosa."
            },
            {
              "symptom": "The batter did not ferment",
              "cause": "The room was too cold",
              "fix": "Leave it somewhere warm for longer until it bubbles and rises."
            },
            {
              "symptom": "The dosa is soft not crisp",
              "cause": "The pan was not hot enough",
              "fix": "Heat the pan properly and spread the batter thinner."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Masala dosa is breakfast across South India. The crisp crepe and soft filling are a perfect pair. It takes practice to spread the batter thin. Serve with sambar and coconut chutney. The first one is a test, the rest get easier."
          }
        ]
      }
    ]
