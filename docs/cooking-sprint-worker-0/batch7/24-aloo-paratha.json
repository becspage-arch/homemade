  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This makes 8 parathas and takes about 55 minutes plus resting. Make a soft dough and let it rest so it rolls out easily. Keep the filling dry so it does not tear the dough."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Seal the filling well and roll gently so it does not burst."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
