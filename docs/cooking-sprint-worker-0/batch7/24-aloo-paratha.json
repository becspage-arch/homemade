      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the flour with water into a soft dough. Rest it covered for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the mashed potato with the onion, ginger, chilli, cumin, turmeric, "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and coriander. Season to taste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the dough into 8 balls. Roll each into a small disc."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place a spoon of filling in the centre, gather the edges to seal and flatten."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll out gently into a larger round, taking care not to tear it."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook on a hot frying pan, brushing both sides with "
                  },
                  {
                    "type": "text",
                    "text": "ghee",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "ghee"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ", until golden spots appear. Serve hot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The paratha tore",
              "cause": "Too much filling or rough rolling",
              "fix": "Use less filling and roll gently and evenly."
            },
            {
              "symptom": "The dough is stiff",
              "cause": "It was not rested enough",
              "fix": "Rest it longer so it softens and rolls easily."
            },
            {
              "symptom": "The filling is wet",
              "cause": "The potato held too much water",
              "fix": "Mash dry potato and avoid adding any liquid."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Aloo paratha is a hearty Punjabi breakfast. The stuffed bread keeps you full for hours. It cooks on a hot pan with a little ghee. Serve it with yoghurt, butter or pickle. It is weekend food worth the effort."
          }
        ]
      }
    ]
  }
