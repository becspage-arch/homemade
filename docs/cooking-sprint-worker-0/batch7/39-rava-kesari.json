      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Soak the saffron in 2 tablespoons of warm water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat most of the ghee in a saucepan and fry the cashews and almonds until golden. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the semolina to the pan and roast on low until it smells nutty."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in 450ml hot water and the soaked saffron. Stir hard to avoid lumps."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "When the water is absorbed, stir in the sugar and cardamom. It will loosen, then thicken again."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the rest of the ghee and the nuts. Cook until glossy and serve warm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The pudding is lumpy",
              "cause": "The water went in too fast",
              "fix": "Stir hard and add water steadily to break up lumps."
            },
            {
              "symptom": "It is too dry",
              "cause": "Not enough water or ghee",
              "fix": "Add a splash of hot water and a little more ghee."
            },
            {
              "symptom": "It tastes raw",
              "cause": "The semolina was not roasted",
              "fix": "Roast the semolina until nutty before adding water."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rava kesari is a sweet made for festivals and guests. It comes together fast from store cupboard staples. The saffron gives it a golden glow. Serve it warm in small bowls. It is a treat with no fuss."
          }
        ]
      }
    ]
