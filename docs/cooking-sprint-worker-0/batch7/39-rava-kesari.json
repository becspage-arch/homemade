  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rava kesari serves 4 and takes about 25 minutes. Roast the "
          },
          {
            "type": "text",
            "text": "semolina",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fine-semolina"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in "
          },
          {
            "type": "text",
            "text": "ghee",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "ghee"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " first so the pudding is smooth. Add the hot water carefully, as it will splutter."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Soak the "
          },
          {
            "type": "text",
            "text": "saffron",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "saffron"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in a little warm water to draw out its colour."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
