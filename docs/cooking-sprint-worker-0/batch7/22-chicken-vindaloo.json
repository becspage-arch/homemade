      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend garlic, ginger, chilli, cumin, coriander, turmeric, cinnamon, and cloves with 3 tablespoons of vinegar. Mix to a smooth paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Coat the chicken in the paste and chill for 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large saucepan and fry the onion until deep golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the marinated chicken and brown it for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add 250ml water and the tamarind. Simmer for 25 minutes until the chicken is tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ". Season to taste and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "It is too sharp",
              "cause": "Too much vinegar",
              "fix": "Add a pinch of sugar and a little water to round it."
            },
            {
              "symptom": "It is too hot",
              "cause": "Too much chilli powder",
              "fix": "Cut the chilli next time or add a spoon of yoghurt."
            },
            {
              "symptom": "The gravy is thin",
              "cause": "Too much water",
              "fix": "Simmer uncovered to reduce to a thick coating."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Vindaloo came to Goa with Portuguese traders. Its name points to wine vinegar and garlic. Indian cooks made it their own with chilli. It is famous for its heat and tang. Serve it with plain rice to cool the fire."
          }
        ]
      }
    ]
