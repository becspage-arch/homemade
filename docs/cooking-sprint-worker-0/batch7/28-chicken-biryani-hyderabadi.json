  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hyderabadi chicken biryani serves 4 and takes about 95 minutes plus marinating. The chicken goes in raw under the rice, so marinate it well for at least 2 hours. Seal the pot tightly to trap the "
          },
          {
            "type": "text",
            "text": "steam",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dum"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Soak the "
          },
          {
            "type": "text",
            "text": "saffron",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "saffron"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in warm milk so it stains the rice in golden streaks."
          }
        ]
      },
