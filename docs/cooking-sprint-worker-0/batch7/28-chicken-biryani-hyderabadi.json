      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Marinate the chicken in the yoghurt, ginger, garlic, "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ", chilli powder and turmeric for 2 hours."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the sliced onions in the ghee until deep golden and crisp. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Parboil the "
                  },
                  {
                    "type": "text",
                    "text": "basmati rice",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "basmati-rice"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " with the cardamom, cinnamon and bay leaves until 70 percent cooked. Drain."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spread the marinated chicken in a heavy pot. Scatter half the fried onions, mint and coriander over it."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Layer the rice on top. Add the saffron milk, remaining onions and herbs."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover tightly and cook on the lowest heat for 35 minutes. Rest for 10 minutes, then fold gently and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The chicken is undercooked",
              "cause": "The heat was too low or the time too short",
              "fix": "Use a heavy pot and the full steaming time, then rest before opening."
            },
            {
              "symptom": "The bottom burned",
              "cause": "The heat was too high",
              "fix": "Use the lowest heat and a heat diffuser under the pot."
            },
            {
              "symptom": "The rice is mushy",
              "cause": "It was boiled too far before layering",
              "fix": "Parboil only to 70 percent so it finishes in the steam."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hyderabadi biryani is the most famous of all. The raw chicken and rice cook together in one sealed pot. The result is layered and fragrant. Serve it with raita and a simple salad. It is the dish to make for a crowd."
          }
        ]
      }
    ]
