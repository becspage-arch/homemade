      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Soak the idli rice and lentils for 4 hours, blend to a thick batter and ferment overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon the batter into greased moulds and steam for 12 minutes until set. Lift out and keep warm."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For the sambar, simmer the lentils with turmeric and 700ml water until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the onion, tomato, coriander and chilli powder. Cook for 10 minutes, then stir in the "
                  },
                  {
                    "type": "text",
                    "text": "tamarind",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "tamarind-paste"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil and add the mustard seeds and "
                  },
                  {
                    "type": "text",
                    "text": "curry leaves",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "curry-leaves"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " until they crackle."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the tempering over the sambar, season to taste and serve with the warm idlis."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The idlis are dense",
              "cause": "The batter did not ferment",
              "fix": "Ferment longer in a warm spot until it bubbles."
            },
            {
              "symptom": "The idlis stuck",
              "cause": "The moulds were not greased",
              "fix": "Oil the moulds well before spooning in the batter."
            },
            {
              "symptom": "The sambar is bland",
              "cause": "Not enough tamarind or salt",
              "fix": "Add a little more tamarind and season to taste."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Idli is the lightest of breakfasts. It is steamed, not fried, and easy to digest. The soft cakes dip into hot sambar. Coconut chutney often joins the plate. It is a gentle start to any day."
          }
        ]
      }
    ]
