  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Idli sambar serves 4 and takes about 50 minutes plus soaking and fermenting. The idli batter must ferment overnight, so start the day before. Steam the idlis just until set and springy."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Grease the moulds well so the idlis lift out clean."
          }
        ]
      },
