      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer the lentils with the turmeric and 700ml water until very soft, about 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the onion, tomato, aubergine and okra. Cook for 12 minutes until the vegetables are tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the coriander, chilli powder and the tamarind. Simmer for 5 minutes and season to taste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a small pan. Add the mustard seeds, dried chilli, "
                  },
                  {
                    "type": "text",
                    "text": "curry leaves",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "curry-leaves"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and a "
                  },
                  {
                    "type": "text",
                    "text": "pinch of asafoetida",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "asafoetida"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "When the seeds crackle, pour this tempering over the sambar."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir once and serve hot with rice or idli."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The sambar is too sour",
              "cause": "Too much tamarind",
              "fix": "Add a little water and a pinch of jaggery or sugar to balance."
            },
            {
              "symptom": "It is too thin",
              "cause": "The lentils were undercooked",
              "fix": "Simmer the lentils until fully broken down before adding vegetables."
            },
            {
              "symptom": "The tempering burned",
              "cause": "The oil was too hot",
              "fix": "Add the curry leaves off the heat once the seeds pop."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sambar appears at nearly every South Indian meal. It goes with rice, idli, dosa and vada. Each home has its own spice balance. The mix of sour, spice and lentil is the heart of it. A pot lasts a family through the day."
          }
        ]
      }
    ]
  }
