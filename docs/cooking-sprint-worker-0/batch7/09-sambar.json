  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sambar serves 4 and takes about 50 minutes. Cook the lentils until very soft so the stew is smooth. Stir the "
          },
          {
            "type": "text",
            "text": "tamarind",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tamarind-paste"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in near the end to keep its tang clear."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The finishing "
          },
          {
            "type": "text",
            "text": "tadka",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tadka"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " of mustard seeds and curry leaves makes the whole dish sing."
          }
        ]
      },
