      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil the potato, cauliflower and peas until very soft, then mash roughly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt half the butter in a large pan. Fry the onion until soft, then add garlic and ginger."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the turmeric and chilli powder, then add the tomatoes. Cook for 8 minutes until pulpy."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the mashed vegetables and 200ml water. Mash together and simmer for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the rest of the butter, the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and coriander. Season to taste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Split the rolls, butter and toast them in a frying pan, then serve with the bhaji."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The bhaji is lumpy",
              "cause": "The vegetables were not mashed enough",
              "fix": "Mash harder or use a potato masher in the pan."
            },
            {
              "symptom": "It tastes flat",
              "cause": "Not enough butter or spice",
              "fix": "Add more butter and a little extra masala."
            },
            {
              "symptom": "It is too dry",
              "cause": "Too little water",
              "fix": "Loosen with hot water until it is soft and spreadable."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pav bhaji was born on the streets of Mumbai. It fed mill workers a fast, filling meal. The buttered rolls scoop up the spiced mash. Squeeze lemon and add raw onion at the table. It is street food you can make at home."
          }
        ]
      }
    ]
