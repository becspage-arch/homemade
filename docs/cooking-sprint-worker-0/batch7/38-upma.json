        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dry toast the semolina in a pan until lightly golden and nutty. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the "
                  },
                  {
                    "type": "text",
                    "text": "ghee",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "ghee"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and fry the cashews until golden. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the mustard seeds and "
                  },
                  {
                    "type": "text",
                    "text": "curry leaves",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "curry-leaves"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " to the ghee until they crackle."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onion, green chilli and ginger until soft. Add the peas."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in 600ml hot water and a little salt. Bring to the boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the toasted semolina slowly, mixing well. Cook for 3 minutes, then fold in the cashews and coriander."
                  }
                ]
              }
            ]
          }
        ]
      },
