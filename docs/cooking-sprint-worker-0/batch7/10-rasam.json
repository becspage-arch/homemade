      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Crush the peppercorns and cumin in a "
                  },
                  {
                    "type": "text",
                    "text": "pestle and mortar to a coarse powder."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer the tomato with the turmeric, garlic and 700ml water for 10 minutes until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the tamarind and the crushed pepper and cumin. Simmer gently for 8 minutes. Season to taste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the ghee in a small pan. Add the mustard seeds, dried chilli, "
                  },
                  {
                    "type": "text",
                    "text": "curry leaves",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "curry-leaves"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and a "
                  },
                  {
                    "type": "text",
                    "text": "pinch of asafoetida",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "asafoetida"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "When the seeds pop, pour this "
                  },
                  {
                    "type": "text",
                    "text": "tadka",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "tadka"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " over the rasam."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter with coriander and serve hot in bowls or over rice."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The rasam tastes harsh",
              "cause": "It was boiled too hard",
              "fix": "Keep it at a gentle simmer once the tamarind goes in."
            },
            {
              "symptom": "It is too sour",
              "cause": "Too much tamarind",
              "fix": "Add more water and a pinch of jaggery to balance."
            },
            {
              "symptom": "The aroma is weak",
              "cause": "The pepper and cumin were not fresh",
              "fix": "Crush them just before cooking for the strongest scent."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rasam is the comfort drink of South India. People sip it when they feel under the weather. It also pours over rice as a light course. The black pepper gives a warm kick. Every family guards its own recipe."
          }
        ]
      }
    ]
  }
