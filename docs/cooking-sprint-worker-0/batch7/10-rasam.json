  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rasam serves 4 and takes about 35 minutes. Crush the pepper and cumin fresh for the best aroma. Do not boil the "
          },
          {
            "type": "text",
            "text": "tamarind",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tamarind-paste"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " broth hard, just bring it to a gentle simmer."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Add the fresh coriander right at the end so its scent stays bright."
          }
        ]
      },
      {
        "type": "heading",
