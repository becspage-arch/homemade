      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the chicken with the yoghurt, half the ginger and garlic, the chilli powder and turmeric. Chill for at least 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spread the chicken on a baking tray and grill on high for 12 minutes, turning once, until lightly charred."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt half the butter in a large saucepan. Fry the onion until soft, then add the rest of the ginger and garlic for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tinned tomatoes and cumin. Simmer for 15 minutes until thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the sauce until smooth, then return it to the pan with the remaining butter and the sugar."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the grilled chicken and the cream. Add the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and simmer for 5 minutes. Season to taste and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The sauce split",
              "cause": "The cream was added at too high a heat",
              "fix": "Lower the heat and stir in the cream gently at the end."
            },
            {
              "symptom": "The curry tastes sharp",
              "cause": "The tomatoes were not balanced",
              "fix": "Add the sugar and a little more butter to round the acidity."
            },
            {
              "symptom": "The chicken is dry",
              "cause": "It was grilled too long",
              "fix": "Grill only until charred at the edges, as it finishes cooking in the sauce."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Butter chicken came from the kitchens of old Delhi. It was a way to use leftover tandoori chicken in a rich sauce. Today it is one of the best loved curries in the world. Serve it with naan or rice. A bowl of this feels like a treat any night."
          }
        ]
      }
    ]
  }
