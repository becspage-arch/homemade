      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large frying pan and add the cumin seeds until they crackle."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onion until soft, then add the ginger for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the turmeric, coriander and chilli powder, then add the potato. Cook for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cauliflower and tomato. Toss to coat in the spices."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and cook on low for 15 minutes, stirring now and then, until tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Uncover, raise the heat to brown the edges. Add the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and coriander. Season to taste and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The vegetables are mushy",
              "cause": "They were stirred too much",
              "fix": "Stir gently and let pieces sit to brown between turns."
            },
            {
              "symptom": "The potato is still hard",
              "cause": "It was added too late",
              "fix": "Give the potato a head start before the cauliflower."
            },
            {
              "symptom": "The dish is bland",
              "cause": "The spices were not toasted",
              "fix": "Fry the ground spices in oil for 30 seconds to wake them up."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Aloo gobi is humble everyday food. It needs no special gear and uses common vegetables. Serve it with roti and dal for a simple meal. The dry style means it travels well in a lunchbox. It is a good first Indian dish to learn."
          }
        ]
      }
    ]
  }
