          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring the milk to a gentle simmer in a large saucepan."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the rinsed rice and simmer on low, stirring often, for 30 minutes until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the sugar and cardamom and cook for another 10 minutes until thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the soaked saffron and stir through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toast the almonds and cashews lightly and stir most of them in."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter the rest of the nuts on top and serve warm or chilled."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The kheer caught and tastes burnt",
              "cause": "The heat was too high",
              "fix": "Cook on low and stir often, scraping the base."
            },
            {
              "symptom": "It is too thin",
              "cause": "It was not cooked long enough",
              "fix": "Simmer longer until it thickens and coats the spoon."
            },
            {
              "symptom": "It set too thick",
              "cause": "It cooled and the rice swelled",
              "fix": "Loosen with a splash of warm milk before serving."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kheer is made for festivals and family meals. It cooks slowly with little more than rice and milk. The cardamom and saffron lift it. Serve it warm in winter or chilled in summer. It is a sweet everyone grows up with."
          }
        ]
      }
    ]
  }
