  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kheer serves 4 and takes about 55 minutes. Stir often so the milk does not catch on the bottom of the pan. Soak the "
          },
          {
            "type": "text",
            "text": "saffron",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "saffron"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in a little warm milk to bring out its colour."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Low and slow is the way, so keep the heat gentle and stir often."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "basmati-rice",
              "amount": 100,
              "unit": "g",
              "prepNote": "rinsed",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "whole-milk",
              "amount": 1,
              "unit": "l",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "caster-sugar",
