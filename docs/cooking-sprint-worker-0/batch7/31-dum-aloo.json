  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dum aloo serves 4 and takes about 55 minutes. Fry the potatoes first so they soak up the gravy. Then let them "
          },
          {
            "type": "text",
            "text": "steam",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dum"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " gently in the sauce to take on the spice."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Prick the fried potatoes so they drink in the gravy."
          }
        ]
      },
      {
