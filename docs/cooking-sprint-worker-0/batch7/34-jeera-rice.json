              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "ghee",
              "amount": 2,
              "unit": "tbsp",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "bay-leaves",
              "amount": 1,
              "unit": "piece",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "cardamom-pods",
              "amount": 2,
              "unit": "piece",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "coriander-fresh",
              "amount": 10,
              "unit": "g",
              "prepNote": "chopped",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rinse the rice until the water runs clear, then soak for 15 minutes and drain."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the ghee in a large saucepan. Add the cumin seeds, bay leaf and cardamom until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained rice and stir gently to coat in the ghee."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in 550ml water and a little salt. Bring to the boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and cook on the lowest heat for 12 minutes until the water is absorbed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rest off the heat for 10 minutes, then fluff with a fork and scatter with coriander."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The rice is sticky",
              "cause": "It was not rinsed enough",
              "fix": "Rinse until the water runs clear before cooking."
            },
            {
              "symptom": "The rice is hard",
              "cause": "Too little water or time",
              "fix": "Add a splash of hot water and steam a little longer."
            },
            {
              "symptom": "The grains broke up",
              "cause": "It was stirred too much",
              "fix": "Stir gently and only fluff with a fork at the end."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Jeera rice is the everyday partner to a curry. The cumin gives plain rice a warm scent. It is quick and needs little. Serve it with dal, curry or raita. It dresses up a simple meal with no fuss."
          }
        ]
      }
    ]
  }
