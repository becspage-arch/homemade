  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Jeera rice serves 4 and takes about 35 minutes including resting. Rinse the "
          },
          {
            "type": "text",
            "text": "basmati rice",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "basmati-rice"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " until the water runs clear for separate grains. Toast the cumin in "
          },
          {
            "type": "text",
            "text": "ghee",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "ghee"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " before the rice goes in."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rest the cooked rice off the heat so the grains firm up and stay separate."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "basmati-rice",
              "amount": 300,
              "unit": "g",
              "prepNote": "rinsed",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "cumin-seeds",
