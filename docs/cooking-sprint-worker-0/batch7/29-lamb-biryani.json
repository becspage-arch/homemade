      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Marinate the lamb in the yoghurt, ginger, garlic, "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ", chilli powder and turmeric for 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onions in the ghee until deep golden. Set half aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the marinated lamb in the remaining onions for 70 minutes until tender, adding water as needed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Parboil the "
                  },
                  {
                    "type": "text",
                    "text": "basmati rice",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "basmati-rice"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " with the cardamom and cinnamon until 70 percent cooked. Drain."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Layer the rice over the lamb. Scatter the "
                  },
                  {
                    "type": "text",
                    "text": "saffron",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "saffron"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " milk, reserved onions and mint on top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover tightly and steam on the lowest heat for 25 minutes. Rest, then fold gently and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The lamb is tough",
              "cause": "It was not cooked long enough",
              "fix": "Simmer the lamb until fork tender before layering."
            },
            {
              "symptom": "The rice is mushy",
              "cause": "It was boiled too far",
              "fix": "Parboil only to 70 percent before steaming."
            },
            {
              "symptom": "The bottom caught",
              "cause": "The heat was too high",
              "fix": "Use the lowest heat and a heavy pot or diffuser."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Lamb biryani is a dish for feasts. The slow lamb and fragrant rice are worth the work. Every layer carries flavour. Serve it with raita and salad. It is the centrepiece of a celebration table."
          }
        ]
      }
    ]
