  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Lamb biryani serves 4 and takes about 125 minutes plus marinating. The lamb needs long, slow cooking before layering, so be patient. Seal the pot to keep the "
          },
          {
            "type": "text",
            "text": "steam",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dum"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in at the end."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cook the lamb until truly tender before layering, as it will not soften much in the steam."
          }
        ]
      },
