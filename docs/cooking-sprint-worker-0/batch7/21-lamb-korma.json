      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the ghee in a dutch oven. Fry the cardamom and cinnamon for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onions until soft and pale gold, then blend half with a little water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the blended onion to the pan with the garlic and ginger. Add the cumin and coriander."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the lamb and brown it. Lower the heat and stir in the yoghurt a little at a time."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the ground almonds and 300ml water. Cover and simmer for 70 minutes until tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the cream and the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ". Season to taste and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The gravy split",
              "cause": "The yoghurt curdled",
              "fix": "Add it slowly off the heat and stir constantly."
            },
            {
              "symptom": "The lamb is tough",
              "cause": "It needs more time",
              "fix": "Keep simmering gently until it is fork tender."
            },
            {
              "symptom": "The korma is too thin",
              "cause": "Not enough thickening",
              "fix": "Add a little more ground almonds and simmer to reduce."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Korma comes from the rich Mughlai kitchens of old. It is mild, creamy and fragrant. Nuts and cream give it a special feel. Serve it with naan or pilau rice. It is a curry for a quiet treat."
          }
        ]
      }
    ]
