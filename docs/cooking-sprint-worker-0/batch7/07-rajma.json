  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rajma serves 4 and takes about 50 minutes. Brown the onion base slowly, as it carries the whole dish. Mash some of the beans at the end to thicken the gravy."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A longer, slower simmer makes the gravy taste richer and more rounded."
          }
        ]
      },
