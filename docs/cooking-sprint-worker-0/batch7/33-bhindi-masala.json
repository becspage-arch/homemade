    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bhindi masala serves 4 and takes about 40 minutes. Dry the okra well before cooking so it does not turn slimy. Fry it on a higher heat without stirring too much."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Wipe the okra dry and avoid adding water to keep it from going slimy."
          }
        ]
      },
