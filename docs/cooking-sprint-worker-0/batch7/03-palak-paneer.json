  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Palak paneer serves 4 and takes about 40 minutes. Blanch the spinach briefly so the sauce stays a fresh green, not dull. Cube the "
          },
          {
            "type": "text",
            "text": "paneer",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "paneer"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " before you start so it is ready to fold in."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Do not overcook the spinach after blending or it loses its bright colour."
          }
        ]
      },
