      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Wilt the spinach in boiling water for 1 minute, then drain and rinse under cold water to keep it green."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the spinach with the green chilli to a smooth puree."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the ghee in a large saucepan. Add the cumin seeds and let them crackle."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onion until soft, then add the garlic, ginger and tomato. Cook for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the spinach puree and simmer gently for 5 minutes. Season to taste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fold in the paneer cubes and the cream. Add the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and warm through for 3 minutes before serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The sauce turned brown",
              "cause": "The spinach was cooked too long",
              "fix": "Blanch only briefly and simmer the puree for a few minutes at most."
            },
            {
              "symptom": "The paneer is rubbery",
              "cause": "It was boiled hard in the sauce",
              "fix": "Add the paneer near the end and warm it gently."
            },
            {
              "symptom": "The dish tastes flat",
              "cause": "Not enough salt or spice",
              "fix": "Season to taste and add a little extra garam masala at the end."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Palak paneer is comfort food in Punjab and beyond. It pairs spinach with fresh cheese for a filling meatless meal. Serve it with naan, roti or rice. The bright green sauce makes it look as good as it tastes. It is a gentle way to eat plenty of greens."
          }
        ]
      }
    ]
