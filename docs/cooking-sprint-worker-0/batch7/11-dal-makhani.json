      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer the black lentils and beans in 1 litre of water for 40 minutes until very soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In another pan, melt half the butter and fry the cumin seeds, then the onion until golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic, ginger and chilli powder, then the tomatoes. Cook for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Tip the lentils and their water into the tomato base. Simmer on low for 30 minutes, stirring often."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the cream and the rest of the butter. Cook for another 10 minutes until thick and glossy."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ". Season to taste and serve with a swirl of cream."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The dal is thin",
              "cause": "It was not simmered long enough",
              "fix": "Keep cooking on low and stirring until it thickens."
            },
            {
              "symptom": "It tastes flat",
              "cause": "Not enough butter or salt",
              "fix": "Add a little more butter and season to taste."
            },
            {
              "symptom": "The lentils stayed firm",
              "cause": "They were not cooked enough first",
              "fix": "Simmer the lentils until fully soft before combining."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dal makhani is the king of Punjabi lentil dishes. It once cooked overnight over coals. The butter and cream make it a treat. Serve it with naan or jeera rice. It is the dish to make when you want to impress."
          }
        ]
      }
    ]
  }
