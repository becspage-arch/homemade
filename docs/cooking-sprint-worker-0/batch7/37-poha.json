        "attrs": {
          "items": [
            {
              "symptom": "The poha is mushy",
              "cause": "It was soaked too long",
              "fix": "Rinse and drain it, never leave it sitting in water."
            },
            {
              "symptom": "The poha is dry",
              "cause": "It was not rinsed enough",
              "fix": "Sprinkle over a little water and warm gently."
            },
            {
              "symptom": "It tastes flat",
              "cause": "Not enough salt or lime",
              "fix": "Season to taste and finish with plenty of lime."
