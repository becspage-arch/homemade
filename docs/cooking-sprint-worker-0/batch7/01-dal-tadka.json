  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This dal tadka serves 4 and takes about 45 minutes from start to finish. Rinse the "
          },
          {
            "type": "text",
            "text": "red lentils well first so the dish stays clean and bright. Watch the lentils as they simmer and skim any foam that rises.",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "ghee"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "For the deepest flavour, make the "
          },
          {
            "type": "text",
            "text": "tadka",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tadka"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " last and pour it over while it still sizzles."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
