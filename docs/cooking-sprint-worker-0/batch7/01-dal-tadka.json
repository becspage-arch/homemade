      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put the rinsed lentils in a "
                  },
                  {
                    "type": "text",
                    "text": "large saucepan with the turmeric and 800ml of water. Bring to the boil, then lower the heat and simmer for 25 minutes until soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season to taste with salt and mash a little of the dal against the side of the pan for a creamy texture."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the "
                  },
                  {
                    "type": "text",
                    "text": "ghee",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "ghee"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " in a small saucepan. Add the cumin seeds and let them crackle."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the onion and fry until golden. Stir in the garlic, ginger and green chilli for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chopped tomato and a "
                  },
                  {
                    "type": "text",
                    "text": "pinch of asafoetida",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "asafoetida"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ". Cook for 5 minutes until the tomato breaks down."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour this tadka over the lentils. Stir in the garam masala, scatter with coriander and serve hot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The dal is too thick",
              "cause": "The lentils absorbed all the water",
              "fix": "Stir in a splash of hot water until it loosens to a pourable soup."
            },
            {
              "symptom": "The tadka tastes raw",
              "cause": "The spices were not bloomed long enough",
              "fix": "Fry the cumin and garlic until fragrant and lightly golden before adding tomato."
            },
            {
              "symptom": "The lentils stayed firm",
              "cause": "Old lentils or hard water",
              "fix": "Simmer longer with a little extra water until they turn soft and creamy."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dal tadka is everyday food in northern India. It sits beside rice, roti or both. Many cooks make a pot early and reheat it through the week. The tempering is the heart of the dish. A squeeze of lemon at the table lifts every spoonful."
          }
        ]
      }
    ]
  }
