      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large saucepan and add the cumin seeds until they crackle."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onions until deep golden, about 8 minutes. Add the garlic and ginger for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the coriander, turmeric and chilli powder for 30 seconds, then add the tomatoes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the tomatoes for 8 minutes until thick and the oil starts to separate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the chickpeas and 200ml water. Simmer for 12 minutes, mashing a few chickpeas to thicken."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the tamarind and "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ". Season to taste, scatter with coriander and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The gravy is watery",
              "cause": "Not enough chickpeas were mashed",
              "fix": "Mash more chickpeas or simmer uncovered to reduce."
            },
            {
              "symptom": "The dish tastes flat",
              "cause": "The onions were undercooked",
              "fix": "Brown onions until deep golden next time for more depth."
            },
            {
              "symptom": "It is too sour",
              "cause": "Too much tamarind",
              "fix": "Balance with a small pinch of sugar and a little water."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chana masala is found on streets and at family tables alike. It is cheap, filling and full of protein. Serve it with rice, bhature or warm roti. A wedge of lemon and raw onion is the classic side. It keeps and reheats beautifully."
          }
        ]
      }
    ]
