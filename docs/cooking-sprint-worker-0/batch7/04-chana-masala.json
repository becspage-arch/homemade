    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chana masala serves 4 and takes about 40 minutes. Brown the onions well, as they give the gravy its depth. The "
          },
          {
            "type": "text",
            "text": "tamarind",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tamarind-paste"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " goes in near the end to keep its tang fresh."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mash a spoonful of the chickpeas to thicken the sauce naturally."
          }
        ]
      },
