      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the syrup by simmering the sugar with 300ml water, the cardamom and rose water for 8 minutes. Keep warm."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the flour, ground almonds and melted "
                  },
                  {
                    "type": "text",
                    "text": "ghee",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "ghee"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " with the milk into a soft dough. Rest for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll the dough into small smooth balls with no cracks."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil to a gentle medium and fry the balls slowly, turning, until deep golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lift them out and drop them straight into the warm syrup."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Leave to soak for at least 30 minutes before serving warm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The dumplings are hard",
              "cause": "They were fried too fast",
              "fix": "Fry slowly on a low heat so they cook through."
            },
            {
              "symptom": "They cracked apart",
              "cause": "The dough was too dry",
              "fix": "Add a little more milk to make a smooth, soft dough."
            },
            {
              "symptom": "They did not soak up syrup",
              "cause": "The syrup was too cold",
              "fix": "Keep the syrup warm so the dumplings drink it in."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Gulab jamun is the sweet of celebrations. It appears at weddings and festivals across India. The warm syrup makes it melt in the mouth. Serve it warm on its own or with ice cream. A little goes a long way."
          }
        ]
      }
    ]
  }
