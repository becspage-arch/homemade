  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This makes about 20 gulab jamun and takes about 45 minutes plus resting. Make the syrup first so it is warm and ready. Fry the dumplings slowly on a low heat so they cook through."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Soak the hot dumplings in warm syrup so they drink it up and swell."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
