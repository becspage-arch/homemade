      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the chicken with the yoghurt, ginger, garlic, garam masala, turmeric and chilli powder. Chill for 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the sliced onions in the ghee until deep golden and crisp. Set half aside for the top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Soak the rice for 20 minutes, then boil it with the cardamom, bay leaves and cinnamon until 70 percent cooked. Drain."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the marinated chicken in the remaining onions and ghee for 15 minutes, adding the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " towards the end."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Layer the rice over the chicken. Scatter the saffron milk, mint, coriander and reserved onions on top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover tightly and cook on the lowest heat for 20 minutes to "
                  },
                  {
                    "type": "text",
                    "text": "steam through",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "dum"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ". Rest for 5 minutes, then fold gently and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The rice is mushy",
              "cause": "It was fully boiled before steaming",
              "fix": "Parboil only to 70 percent so it finishes in the steam."
            },
            {
              "symptom": "The bottom burned",
              "cause": "The heat was too high during steaming",
              "fix": "Use the lowest heat and a heavy pan, or sit it on a heat diffuser."
            },
            {
              "symptom": "The chicken is underdone",
              "cause": "It was not cooked enough before layering",
              "fix": "Cook the chicken until almost done before adding the rice."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Biryani is the dish people make to celebrate. Every region has its own version. This home style keeps the steps simple. Serve it with a cooling raita. Leftovers are just as good the next day."
          }
        ]
      }
    ]
  }
