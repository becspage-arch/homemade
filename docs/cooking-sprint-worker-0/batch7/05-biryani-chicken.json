  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This chicken biryani serves 4 and takes about 80 minutes plus marinating. Soak the "
          },
          {
            "type": "text",
            "text": "basmati rice",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "basmati-rice"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and marinate the chicken first. Watch the heat at the end so the bottom does not catch."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Soak the "
          },
          {
            "type": "text",
            "text": "saffron",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "saffron"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in warm milk so its colour spreads through the rice."
          }
        ]
      },
