      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dry roast the coriander, cumin, peppercorns, dried chilli and cardamom in a frying pan until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Grind the roasted spices in a "
                  },
                  {
                    "type": "text",
                    "text": "pestle and mortar to a coarse powder."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large saucepan and add the "
                  },
                  {
                    "type": "text",
                    "text": "curry leaves",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "curry-leaves"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ". Fry the onions until golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic, ginger and turmeric, then the tomato. Cook for 6 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the ground spice mix, then add the chicken. Coat well and add 200ml water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and simmer for 25 minutes until the chicken is tender. Stir in a little "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ", season to taste and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The spices taste bitter",
              "cause": "They were roasted too dark",
              "fix": "Roast only until fragrant and just coloured."
            },
            {
              "symptom": "The gravy is too thin",
              "cause": "Too much water",
              "fix": "Simmer uncovered to reduce to a thick coating."
            },
            {
              "symptom": "It is too hot",
              "cause": "Too many dried chillies",
              "fix": "Use fewer chillies or add a splash of coconut milk."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chettinad food comes from a trading community in Tamil Nadu. It is known for bold spice and pepper heat. The fresh roasted spices set it apart. Serve it with rice or dosa. It is a dish for people who love a kick."
          }
        ]
      }
    ]
