      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mango lassi is the cool drink of summer. It pairs sweet mango with tangy yoghurt. It calms the heat of a spicy meal. Serve it cold in tall glasses. It is loved by children and adults alike."
          }
        ]
      }
    ]
