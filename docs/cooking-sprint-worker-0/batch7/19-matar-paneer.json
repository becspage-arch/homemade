    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Matar paneer serves 4 and takes about 40 minutes. Blend the onion and tomato base for a smooth gravy. Add the "
          },
          {
            "type": "text",
            "text": "paneer",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "paneer"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " near the end so it stays soft."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Soak the paneer cubes in warm water for 10 minutes to keep them tender."
          }
        ]
      },
