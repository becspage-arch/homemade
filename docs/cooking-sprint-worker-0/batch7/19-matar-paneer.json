      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil and add the cumin seeds until they crackle."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onion until soft, then add the garlic, ginger and tomato. Cook for 8 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend this base to a smooth gravy and return it to the pan."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the coriander, turmeric and chilli powder. Add 200ml water and simmer for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the peas and cook for 5 minutes, then fold in the paneer and cream."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ". Season to taste and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The paneer is rubbery",
              "cause": "It was cooked too long",
              "fix": "Add it at the end and warm it gently."
            },
            {
              "symptom": "The gravy is grainy",
              "cause": "The base was not blended",
              "fix": "Blend the onion and tomato until smooth."
            },
            {
              "symptom": "It tastes flat",
              "cause": "Not enough salt or spice",
              "fix": "Season to taste and add a little extra garam masala."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Matar paneer is everyday comfort in North India. Peas and cheese make it filling and mild. It suits children and adults alike. Serve with roti or rice. It is quick enough for a busy night."
          }
        ]
      }
    ]
