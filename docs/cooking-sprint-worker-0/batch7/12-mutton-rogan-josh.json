      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the ghee in a dutch oven. Brown the lamb in batches and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cardamom, cinnamon, cloves and bay leaves to the same pan and fry for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onions until golden, then add the garlic and ginger for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the chilli powder, coriander and cumin, then return the lamb."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lower the heat and stir in the whisked yoghurt a little at a time. Add 300ml water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and simmer gently for 75 minutes until the lamb is tender. Stir in the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ", season to taste and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The gravy split",
              "cause": "The yoghurt was added too fast",
              "fix": "Add it slowly off a high heat and stir constantly."
            },
            {
              "symptom": "The lamb is tough",
              "cause": "It needs more time",
              "fix": "Keep simmering gently until a fork slides through easily."
            },
            {
              "symptom": "The colour is pale",
              "cause": "Not enough chilli or browning",
              "fix": "Brown the lamb fully and use a good red chilli powder."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rogan josh comes from the valleys of Kashmir. The name points to its red oil and rich gravy. It is a dish for feasts and cold days. Serve it with rice or naan. The slow cooking is worth the wait."
          }
        ]
      }
    ]
