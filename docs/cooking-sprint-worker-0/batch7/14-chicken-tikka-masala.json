      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the chicken with the yoghurt, half the garlic and ginger, the turmeric and half the chilli powder. Chill for 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spread the chicken on a baking tray and grill on high for 12 minutes until charred."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large saucepan. Fry the onion until soft, then add the rest of the garlic and ginger."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the cumin and remaining chilli powder, then add the tomatoes. Simmer for 12 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the grilled chicken and the cream. Simmer for 8 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the "
                  },
                  {
                    "type": "text",
                    "text": "garam masala",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "garam-masala"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and coriander. Season to taste and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The sauce is thin",
              "cause": "It was not reduced enough",
              "fix": "Simmer uncovered until it coats the back of a spoon."
            },
            {
              "symptom": "The chicken is dry",
              "cause": "It was grilled too long",
              "fix": "Grill only until charred, as it finishes in the sauce."
            },
            {
              "symptom": "The sauce tastes sharp",
              "cause": "The tomatoes were not balanced",
              "fix": "Add a little cream and a pinch of sugar."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tikka masala grew up in British curry houses. It takes grilled tikka and bathes it in a creamy sauce. It is mild enough for everyone at the table. Serve with rice and naan. It is the curry many people order first."
          }
        ]
      }
    ]
  }
