  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chicken tikka masala serves 4 and takes about 60 minutes plus marinating. Marinate the chicken for at least an hour so it stays juicy. Grill it until charred at the edges before the sauce."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A little char on the chicken adds the smoky note that defines this dish."
          }
        ]
      },
