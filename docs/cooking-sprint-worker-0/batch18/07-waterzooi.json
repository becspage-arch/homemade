      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt butter in a large saucepan. Soften onion, leek, and celery for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add carrot and potato."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place chicken thighs on top of the vegetables. Pour in stock. Add bay leaves and thyme."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a gentle simmer. Cover and cook for 35 to 40 minutes until the chicken is cooked through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove chicken. Shred the meat off the bone and return it to the pan. Remove bay and thyme."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix egg yolks with cream in a small bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove pan from the heat entirely. Stir in the cream mixture. Do not boil again."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season well. Stir in parsley. Serve with crusty bread."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth has curdled",
              "cause": "Liaison added to boiling liquid",
              "fix": "Take the pan off the heat fully before adding the cream and egg mixture."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Chicken is dry",
              "cause": "Overcooked",
              "fix": "Check at 35 minutes. Shred while still moist."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Vegetables mushy",
              "cause": "Cut too small or cooked too long",
              "fix": "Cut vegetables into larger pieces and add potato slightly later."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Waterzooi is Ghent's most famous dish. The name comes from the Flemish for water and to boil. It was originally made with freshwater fish but switched to chicken when the rivers became too polluted in the 18th century. Every Ghent restaurant serves its own version. The fish version is still found in coastal Belgian towns like Bruges."
          }
        ]
      }
    ]
  }
