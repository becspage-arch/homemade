  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hutspot is the simplest of Dutch dishes. Potato, carrot, and onion go into one pot, boil together until soft, then everything is "
          },
          {
            "type": "text",
            "text": "mash ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "mash"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "ed together with butter. The word "
          },
          {
            "type": "text",
            "text": "hotchpot",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "hotchpot"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " is a cousin of the name, and means much the same thing: things thrown together and mixed."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cut the carrot into smaller pieces than the potato so they finish cooking at the same time."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
