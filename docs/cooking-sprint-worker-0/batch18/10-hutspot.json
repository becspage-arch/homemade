              "amount": 0,
              "unit": "to taste",
              "prepNote": "ground",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put potato, carrot, and onion in a large saucepan. Cover with cold salted water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a boil. Cook until all vegetables are completely soft, about 25 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mash everything together with butter and warm milk until combined. Leave a little texture if you like."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season generously with salt and pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve as a main with a fried egg on top, or as a side with sausages."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Carrots still firm",
              "cause": "Cut too large or not cooked long enough",
              "fix": "Cut into smaller pieces or add an extra 10 minutes of cooking time."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Mash is watery",
              "cause": "Not drained thoroughly",
              "fix": "Return to the heat for 2 minutes after draining to steam off excess moisture."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Tastes bland",
              "cause": "Under-seasoned",
              "fix": "Hutspot needs generous salt. Season in stages during cooking."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hutspot is one of the oldest dishes in Dutch cuisine. According to legend, the people of Leiden found a pot of it abandoned by Spanish soldiers in 1574, ending a long siege. The city still cooks a commemorative pot every year on 3 October. Unlike stamppot, which uses greens, hutspot uses only carrot and onion for its colour and sweetness. It is eaten all winter across the Netherlands."
          }
        ]
      }
    ]
  }
}