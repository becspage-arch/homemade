      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a dutch oven over medium heat. Fry onion for 10 minutes until golden. Add garlic and ginger, fry for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add all ground spices and whole spices. Stir for 1 minute until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add chopped tomatoes and tomato puree. Cook for 8 minutes until the tomatoes have broken down into a thick paste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add 900ml water, lime zest, half the lime juice, and salt. Bring to the boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lower the fish fillets into the broth. Poach for 6 to 7 minutes until just cooked through. Remove carefully and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Measure 750ml of the broth. Add drained rice to the pot. Pour measured broth over. Bring to the boil, reduce to lowest heat, cover, and cook for 18 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Sprinkle saffron water and remaining lime juice over the rice. Lay fish fillets on top of the rice. Cover and rest off the heat for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter with fresh coriander and serve from the pot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Fish falls apart when removed from broth",
              "cause": "Poached too long.",
              "fix": "Check the fish at 5 minutes. It is done when the flesh just turns opaque all the way through. Use a wide spatula to lift it in one piece."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rice has no flavour",
              "cause": "Not enough broth volume used for the rice, or the base was undercooked.",
              "fix": "The rice must cook in the spiced fish broth, not plain water. If the broth was thin, reduce it first before measuring."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Saffron colour is patchy",
              "cause": "Saffron not steeped long enough or added to a cold surface.",
              "fix": "Steep the saffron for at least 10 minutes in warm water. Pour it evenly over the rice surface just before the final rest."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Machboos is the national dish of Bahrain and is eaten widely across the Gulf states. The name is thought to derive from the Arabic root for pressed or compacted, describing how the rice absorbs the broth and becomes almost fused with the spice base. The fish version, machboos samak, reflects the Gulf's long history as a fishing and pearling culture. Traditional fishing communities along the Bahraini and Kuwaiti coastline made this dish with whatever fish was landed that day. The dried loomi lime is the single most distinctive flavouring in Gulf cooking and is central to the dish's identity."
          }
        ]
      }
    ]
  }
