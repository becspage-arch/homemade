              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "lemon",
              "amount": 1,
              "unit": "whole",
              "prepNote": "to serve",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "If using wooden skewers, soak in cold water for 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cut lamb into small, even 2cm cubes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Thread 5 to 6 cubes tightly onto each skewer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Brush with olive oil. Season generously with salt and pepper. Scatter rosemary over."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a griddle pan until very hot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Grill skewers for 8 to 10 minutes total, turning every 2 minutes to brown all sides."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve immediately with lemon to squeeze over. Eat while hot."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Lamb sticking to the griddle",
              "cause": "Pan not hot enough or skewers not oiled",
              "fix": "Heat pan fully before adding. Oil the skewers, not the pan."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Lamb dry and tough",
              "cause": "Overcooked or too lean a cut",
              "fix": "Use shoulder, not leg. Cook quickly and keep a little pink."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Skewers burn",
              "cause": "Wooden skewers not soaked",
              "fix": "Soak wooden skewers in cold water for 30 minutes before threading."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Arrosticini are the soul food of Abruzzo. Shepherds in the Apennine mountains originally made them from the scraps of mutton left after butchering their flocks. The skewers are eaten outdoors at festivals and family gatherings, cooked in enormous quantities. In Abruzzo, an arrosticinata means a gathering built entirely around eating arrosticini. The region produces some of Italy's best lamb, grazed on high mountain pastures. The dish is never served with sauce."
          }
        ]
      }
    ]
  }
}