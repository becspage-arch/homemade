  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Arrosticini are as simple as grilling gets. Thread small cubes of lamb shoulder onto a "
          },
          {
            "type": "text",
            "text": "skewer ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "skewer"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", season with salt and rosemary, and cook fast over high heat. You could "
          },
          {
            "type": "text",
            "text": "marinate",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "marinate"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " the lamb in olive oil and herbs beforehand, but in Abruzzo they rarely do. The lamb speaks for itself."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use lamb shoulder, not leg. Shoulder has the fat distribution that keeps arrosticini juicy on a hot grill."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "lamb-shoulder",
              "amount": 600,
              "unit": "g",
              "prepNote": "cut into 2cm cubes",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "extra-virgin-olive-oil",
              "amount": 3,
              "unit": "tbsp",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "rosemary",
              "amount": 2,
              "unit": "sprigs",
              "prepNote": "leaves finely chopped",
              "isOptional": false,
              "groupLabel": null
            },
            {
