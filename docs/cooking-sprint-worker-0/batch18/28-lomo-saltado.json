        "content": [
          {
            "type": "text",
            "text": "Lomo saltado is a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "chifa"
                }
              }
