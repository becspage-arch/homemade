        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil potatoes in salted water until completely tender, about 20 minutes. Drain and mash while still very hot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Beat in lime juice, chilli paste, turmeric, oil, and salt. Taste. The mash should be tangy, slightly spicy, and vivid yellow. Allow to cool to room temperature."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix shredded chicken with yoghurt and a pinch of salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Line a loaf tin with cling film. Press half the potato mash into an even layer across the base."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Layer the chicken filling evenly over the mash. Lay avocado slices over the chicken."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Press the remaining mash over the top, smoothing it flat. Cover with cling film and chill for at least 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Turn out onto a plate, remove the cling film, and slice with a sharp knife. Serve cold."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Mash will not hold together when sliced",
              "cause": "Too much liquid added or the mash was not pressed firmly enough.",
              "fix": "Press each layer down firmly as you build the terrine. Use a drier variety of potato next time."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Avocado goes brown",
              "cause": "Avocado was exposed to air before assembly.",
              "fix": "Toss avocado slices in a little lime juice immediately before layering."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Mash is grey rather than yellow",
              "cause": "Not enough turmeric or the chilli paste lacked colour.",
              "fix": "Add another pinch of turmeric to the mash and beat in until the colour is vivid."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Causa is one of Peru's oldest dishes, with roots reaching back to pre-Inca Andean communities that cultivated hundreds of varieties of potato. The name may derive from the Quechua word kausay, meaning sustenance. During the War of the Pacific in the 1880s, women on the home front made causa to raise funds, which reinforced the dish's association with the idea of a shared cause. Today it is the party food of Lima, served at family celebrations in careful individual portions."
          }
        ]
      }
    ]
  }
