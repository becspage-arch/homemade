      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blend the spices, garlic, citrus juices, vinegar, and oil into a smooth paste. Season with salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rub the paste all over the pork pieces. Place in a dutch oven, cover, and refrigerate for at least 2 hours or overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter sliced onion over the pork. Add 100ml water to the base of the pot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover tightly and cook at 160C for 3 hours. The pork should be very soft and pulling apart at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from the oven. Rest for 15 minutes. Pull the pork apart using two forks, mixing the shreds with the cooking juices."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve piled into warm tortillas with a squeeze of lime."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pork is not pulling apart after 3 hours",
              "cause": "The cut was leaner than expected or the oven temperature was too low.",
              "fix": "Return to the oven for another 30 to 45 minutes. Add a splash of water if the base looks dry."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Colour is pale",
              "cause": "Not enough smoked paprika or the marinating time was too short.",
              "fix": "Stir extra smoked paprika into the cooking juices when shredding. The flavour will still be good."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Pork tastes dry",
              "cause": "Cooked without a lid or at too high a temperature.",
              "fix": "Always keep the dutch oven tightly covered. The steam is what keeps the meat moist throughout cooking."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cochinita pibil is the defining pork dish of the Yucatan Peninsula. It was cooked by the Maya in underground pit ovens lined with banana leaves, which gave the meat a smoky, earthy flavour. Spanish colonisers introduced the pig to the Americas, and the Maya adapted their existing pit-cooking tradition to the new animal. The result is a hybrid dish that has been eaten in the Yucatan for centuries. Today it is sold from street stalls on Sunday mornings, piled into small rolls called tortas."
          }
        ]
      }
    ]
  }
