  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Flamiche is built on two things done well: good "
          },
          {
            "type": "text",
            "text": "shortcrust pastry",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "shortcrust-pastry"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and leeks that have been allowed to "
          },
          {
            "type": "text",
            "text": "sweat",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "sweat"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " slowly until completely soft and sweet. Rush either step and the tart will disappoint."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Drain every drop of liquid from the leeks before adding them to the pastry case. A wet filling makes soggy pastry."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "plain-flour",
              "amount": 250,
              "unit": "g",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "unsalted-butter",
              "amount": 125,
              "unit": "g",
              "prepNote": "cold, cubed, plus extra for the leeks",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "eggs",
              "amount": 3,
              "unit": "whole",
              "prepNote": "1 for pastry, 2 for filling",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "leek",
              "amount": 4,
              "unit": "large",
              "prepNote": "washed and sliced",
              "isOptional": false,
              "groupLabel": null
            },
            {
