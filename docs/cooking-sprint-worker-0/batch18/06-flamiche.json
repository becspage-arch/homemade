              "amount": 200,
              "unit": "ml",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "gruyere",
              "amount": 80,
              "unit": "g",
              "prepNote": "grated",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "sea-salt-fine",
              "amount": 0,
              "unit": "to taste",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "peppercorns-black",
              "amount": 0,
              "unit": "to taste",
              "prepNote": "ground",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rub cold butter into flour until it looks like breadcrumbs. Add 1 egg and 2 tbsp cold water. Mix to a dough. Chill for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oven to 190C. Line a 23cm tart tin with the pastry. Blind bake for 15 minutes using baking paper and beans. Remove paper and beans. Bake 5 more minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Sweat leeks in a little butter with a pinch of salt, covered, for 15 minutes until very soft. Let all liquid evaporate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Beat together 2 eggs and double cream. Season well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spread leeks in the pastry case. Pour over the cream mixture. Scatter with grated cheese."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 25 to 30 minutes until golden and just set. Cool for 10 minutes before slicing."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Soggy pastry base",
              "cause": "Not blind baked long enough or filling too wet",
              "fix": "Blind bake fully and make sure leeks have lost all their liquid before filling the tart."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Filling cracks on top",
              "cause": "Oven too hot",
              "fix": "Reduce to 180C if it colours too fast."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Leeks taste bland",
              "cause": "Not cooked long enough before baking",
              "fix": "Sweat leeks until completely soft and slightly sweet before filling the tart."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Flamiche dates back to the medieval cuisine of northern France. Amiens, the capital of Picardy, claims it as the city's dish. In Flemish Belgium it is also made with endive or pumpkin. The version with leeks is the most common today. It is served warm, cut into wedges, often as a starter at Sunday lunch."
          }
        ]
      }
    ]
  }
}