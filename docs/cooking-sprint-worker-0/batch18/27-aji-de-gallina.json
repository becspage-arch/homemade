  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The sauce in aji de gallina is thickened by two things working together: "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "nut-thickening"
                }
              }
            ],
            "text": "nut thickening"
          },
          {
            "type": "text",
            "text": " from ground cashews, used here as a substitute for traditional walnuts, and "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bread-binding"
                }
              }
            ],
            "text": "bread binding"
          },
          {
            "type": "text",
            "text": " from soaked white bread blended into the base. Together they give the sauce its characteristic dense, creamy texture."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tip: use the poaching liquid from the chicken to loosen the sauce. It carries flavour the water cannot replicate."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
