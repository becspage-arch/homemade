      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a large heavy pan. Cook onion on medium-low heat for 10 minutes until soft and sweet."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic. Cook for 2 more minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add aubergine. Cook for 10 minutes, stirring occasionally."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add courgette and peppers. Cook for 10 more minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add fresh and canned tomatoes, paprika, and bay leaves."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir well. Cover and cook on low heat for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove lid. Cook uncovered for 10 minutes to reduce and concentrate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Season well. Remove bay leaves. Serve warm with eggs on top or bread alongside."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Vegetables watery",
              "cause": "Lid on too long or heat too low",
              "fix": "Remove lid and increase heat slightly to drive off liquid."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Aubergine bitter",
              "cause": "Old aubergine or not cooked long enough",
              "fix": "Use fresh aubergine and cook until completely soft."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Stew tastes flat",
              "cause": "Not enough olive oil or salt",
              "fix": "Add another tablespoon of oil and taste for salt."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pisto manchego comes from La Mancha, the flat plateau of central Spain made famous by Don Quixote. The dish shows clear Moorish influence in its sweet pepper and aubergine base. It is often topped with a fried egg, which turns it from a side dish into a main meal. Pisto is eaten hot, warm, or at room temperature and is common all year round. Like many Spanish vegetable dishes, it tastes better the next day."
          }
        ]
      }
    ]
  }
