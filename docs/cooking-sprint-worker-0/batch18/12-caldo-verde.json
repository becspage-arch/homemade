      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 2 tbsp oil in a large saucepan. Soften onion and garlic for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add potato. Pour in stock or water to cover. Season."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer for 20 minutes until potato is completely soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Use a stick blender to blend the soup smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return to medium heat. Add kale or spinach ribbons. Cook for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry chorizo slices in 1 tbsp oil until crisp at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle soup into bowls. Top with chorizo and a drizzle of olive oil."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Soup too thick",
              "cause": "Not enough liquid",
              "fix": "Add hot water or stock a ladleful at a time until the right consistency."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Greens taste dull",
              "cause": "Cooked too long after blending",
              "fix": "Add greens in the last 5 minutes only to keep colour and flavour."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Chorizo releases too much oil",
              "cause": "Fried too long",
              "fix": "Fry just until edges crisp, about 2 minutes each side."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Caldo verde is considered the national soup of Portugal. It is served at weddings, festivals, and late-night gatherings after fado concerts. The soup originates in the Minho region, where Galician kale called couve-galega is used. The combination of potato, greens, and smoked sausage is also found across Galicia in Spain. It is equally good for breakfast or supper."
          }
        ]
      }
    ]
  }
