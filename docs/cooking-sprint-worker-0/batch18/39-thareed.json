      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a dutch oven over high heat. Brown the lamb in batches for 3 to 4 minutes per side. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce heat to medium. Fry onion for 8 minutes. Add garlic, all whole spices, ground spices, and turmeric. Stir for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add fresh tomatoes and canned tomatoes. Cook for 5 minutes, breaking up the tomatoes with a spoon."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the lamb to the pot. Add 800ml water and salt. Bring to the boil, cover, and simmer for 50 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add potato and carrot. Cover and simmer for 15 more minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add courgette and cook for a final 10 minutes. Taste for salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange torn flatbread in a large deep serving dish. Ladle the hot stew and plenty of broth over the bread. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Lamb is still tough after 50 minutes",
              "cause": "The simmer was not vigorous enough or the cut was leaner than expected.",
              "fix": "Keep simmering for another 20 minutes. Add a splash of water if the pot looks dry. Shoulder needs time to break down."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Bread disintegrates completely",
              "cause": "Bread was too fresh or too thin, and soaked too long.",
              "fix": "Serve quickly once the stew is ladled over. Slightly stale, thicker bread holds up much better."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Broth tastes flat",
              "cause": "Spices were not bloomed before adding liquid.",
              "fix": "Stir the spices in the oil for a full 2 minutes before adding tomatoes. The heat activates the aromatics."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thareed is one of the oldest documented dishes in the Islamic world, mentioned in hadith literature as the Prophet Muhammad's preferred meal. It has been made across the Arabian Peninsula for well over a thousand years. Today it is the most important dish of Ramadan iftar tables in the UAE, Qatar, Bahrain, and Kuwait. Families make large pots to break the fast and share with neighbours. The bread base varies by family but the principle of lamb broth poured over bread remains unchanged across centuries."
          }
        ]
      }
    ]
  }
