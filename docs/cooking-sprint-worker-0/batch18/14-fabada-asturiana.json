  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fabada is built on the contrast between creamy white beans and smoky cured meat. The classic combination uses chorizo and "
          },
          {
            "type": "text",
            "text": "morcilla ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "morcilla"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". Good "
          },
          {
            "type": "text",
            "text": "skimming",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "skimming"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " in the first 20 minutes keeps the broth clear and clean."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Keep the heat very gentle throughout. Beans that boil hard will break apart and turn the broth grainy."
          }
        ]
      },
