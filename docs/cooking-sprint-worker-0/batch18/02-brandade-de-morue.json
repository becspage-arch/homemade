  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Brandade starts with "
          },
          {
            "type": "text",
            "text": "salt cod",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "salt-cod"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " that has been soaked and poached, then beaten with olive oil and potato until you "
          },
          {
            "type": "text",
            "text": "emulsify",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "emulsify"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " the whole thing into a thick, spreadable puree. It is gentle food, good with toast or raw vegetables."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use warm milk when loosening the mixture. Cold milk will make it seize."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
