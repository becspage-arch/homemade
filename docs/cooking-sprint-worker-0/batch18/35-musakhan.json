      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 80ml olive oil in a large saucepan over medium-low heat. Add all the sliced onions and a large pinch of salt. Cook slowly for 40 minutes, stirring every 5 minutes, until deeply golden and very soft."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir 3 tbsp sumac, allspice, cinnamon, and cardamom into the onions. Cook for 5 more minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rub chicken thighs with remaining sumac, cumin, remaining salt, and 20ml olive oil. Place on a baking tray."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roast chicken at 200C for 40 minutes until the skin is golden and crisp."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lay flatbreads on a large serving platter. Spoon the sumac onions generously over the bread."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the roasted chicken thighs on top of the onions. Rest for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter with toasted cashews and parsley. Serve at the table for people to pull apart."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Onions are pale and sharp after 40 minutes",
              "cause": "Heat was too high and they fried rather than caramelised.",
              "fix": "Lower the heat and add a splash of water. Cook for another 15 minutes, stirring. Real caramelisation requires patience at low heat."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Flatbread goes soggy under the onions",
              "cause": "Onions were too wet when placed on the bread.",
              "fix": "Drain excess oil from the onions before spooning them on. The bread should be moist but not waterlogged."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Chicken skin is pale",
              "cause": "Not enough sumac or the oven was too cool.",
              "fix": "Switch to grill mode for the last 5 minutes at high heat to crisp and colour the skin."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Musakhan is the dish Palestinians prepare for important occasions and for guests. It originated in the northern West Bank, where the olive harvest has been the backbone of local agriculture for thousands of years. The dish celebrates olive oil: it is used generously in the onions and the chicken, not as a flavouring but as a structural ingredient. The traditional bread for musakhan is taboon, baked on a bed of pebbles in a wood-fired oven. The dish is eaten communally, with hands, directly from the shared platter."
          }
        ]
      }
    ]
  }
