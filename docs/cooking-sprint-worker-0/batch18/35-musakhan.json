    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The defining flavour of musakhan is "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "sumac"
                }
              }
            ],
            "text": "sumac "
          },
          {
            "type": "text",
            "text": ", used in large amounts to season both the onions and the chicken. The onions need real time: true "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "caramelising-onions"
                }
              }
            ],
            "text": "caramelising"
          },
          {
            "type": "text",
            "text": " takes 40 minutes on a low flame. Rushing this step produces pale, sharp onions instead of the soft, sweet base the dish needs."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tip: do not hold back on the sumac. The recipe uses what seems like a lot. That quantity is correct."
          }
        ]
      },
