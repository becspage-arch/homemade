                }
              }
            ],
            "text": "fatteh"
          },
          {
            "type": "text",
            "text": " dish, named for the layering technique. The contrast between the hot chickpeas and the cold "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tahini-yoghurt"
                }
