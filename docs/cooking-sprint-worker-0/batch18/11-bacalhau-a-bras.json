  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bacalhau a Bras layers three textures in one pan: flaked "
          },
          {
            "type": "text",
            "text": "salt cod ",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "salt-cod"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", soft scrambled egg, and potato that you "
          },
          {
            "type": "text",
            "text": "straw fry",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "straw-fry"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " until crisp and golden. The dish comes together fast once you have the cod soaked and the potatoes fried."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Keep half the crispy potato back to fold in at the end. That way some of it stays crunchy."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
