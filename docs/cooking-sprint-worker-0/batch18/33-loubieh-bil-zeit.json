      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat olive oil in a large saucepan over medium heat. Add sliced onion and cook for 10 minutes until soft and beginning to colour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic, coriander, and cumin. Stir for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add canned tomatoes, salt, and 100ml water. Stir well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the green beans and stir to coat in the tomato mixture."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and cook on a low simmer for 30 minutes, stirring occasionally. The beans should be very tender and the sauce thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from heat. Stir in lemon juice. Taste for salt. Serve warm or at room temperature with flatbread."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Beans are still firm after 30 minutes",
              "cause": "The heat was too low or the lid was not on.",
              "fix": "Increase to medium-low, replace the lid, and cook for another 10 minutes. The trapped steam is what softens them."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce has dried out",
              "cause": "Too much evaporation from a loose-fitting lid.",
              "fix": "Add a splash of water, stir, and re-cover. The sauce should be saucy, not dry."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dish tastes flat",
              "cause": "Insufficient olive oil or lemon.",
              "fix": "Drizzle more olive oil over the finished dish and add another squeeze of lemon. Both are essential to the flavour."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Loubieh bil zeit is a cornerstone of the Lebanese mezze table and everyday home cooking. The bil zeit style of cooking, using generous olive oil as the cooking medium for vegetables, is one of the oldest food traditions in the eastern Mediterranean. Green beans, aubergine, courgette, and chickpeas are all cooked this way. The dish improves as it cools and sits, which is why it is often made the morning of a meal and served at room temperature. It is as good as a main course over rice as it is as a side dish."
          }
        ]
      }
    ]
  }
