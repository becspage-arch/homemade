      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put lamb, onion, cardamom, cinnamon, cloves, allspice, turmeric, and 1 tsp salt in a dutch oven. Cover with 1 litre water. Bring to a boil, skim foam, then simmer covered for 60 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the lamb and set aside. Strain the broth and measure out 750ml. Keep it hot."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk yoghurt with flour and a pinch of salt in a saucepan until smooth. Place over medium-low heat and stir constantly until it comes to a gentle simmer. Do not stop stirring or it will split."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle 200ml of the warm lamb broth into the yoghurt sauce. Stir and keep warm on the lowest heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt butter in a large saucepan. Add drained rice and stir for 2 minutes until coated and beginning to turn translucent."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the remaining 550ml hot lamb broth and 1 tsp salt. Bring to a boil, cover, and cook on the lowest heat for 18 minutes. Rest 10 minutes off the heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spread rice on a large platter. Arrange the lamb pieces over. Pour the warm yoghurt sauce over the top. Scatter with toasted cashews and almonds."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Yoghurt sauce splits and becomes grainy",
              "cause": "Heated too fast or not stirred constantly.",
              "fix": "The dish can still be eaten but the sauce will look curdled. Next time, whisk the flour into the yoghurt and stir without stopping from cold."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Lamb is tough after an hour",
              "cause": "The cut used was not fatty enough or the simmer was too gentle.",
              "fix": "Keep simmering for another 30 minutes. Shoulder needs time. A proper simmer, not just warm water, is needed."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rice is sticky and clumped",
              "cause": "Too much water or the lid was lifted during cooking.",
              "fix": "Do not lift the lid. Let the rice rest fully off the heat before fluffing with a fork."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mansaf is Jordan's national dish and the centrepiece of Bedouin hospitality. To serve mansaf is to honour a guest. The traditional dish uses jameed, a hard dried goat yoghurt that is crumbled and dissolved in hot water, giving the sauce a sharp, funky depth. Plain yoghurt is a milder substitute widely used outside Jordan. Mansaf is eaten standing around a large shared tray, with the right hand, traditionally without utensils. It is made for weddings, large celebrations, and as a mark of respect."
          }
        ]
      }
    ]
  }
