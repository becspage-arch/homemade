      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toast the dried chillies in a dry pan over medium heat for 1 minute each side. They should blister and darken slightly. Remove and soak in 300ml boiling water for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Char the onion halves and garlic cloves cut-side down in the same dry pan until blackened in patches, about 8 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain the chillies, keeping the soaking liquid. Blend chillies with the charred onion, garlic, tomatoes, and 200ml soaking liquid until smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toast cinnamon, cloves, peppercorns, and cumin seeds in the dry pan for 1 minute. Grind to a fine powder."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a dutch oven over high heat. Pour in the chilli paste and fry, stirring constantly, for 8 minutes. It will splatter."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the ground spices, stock, and salt. Stir well. Add chicken thighs, pushing them into the sauce."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer uncovered on low heat for 45 minutes. Stir every 10 minutes. The sauce should thicken enough to coat a spoon."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in sugar or dark chocolate, taste for salt, and serve with rice or warm tortillas."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce tastes bitter",
              "cause": "Chillies were toasted too long and burned.",
              "fix": "Add a teaspoon of sugar or a square of dark chocolate. Next time pull the chillies off heat as soon as they blister."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce is too thin",
              "cause": "Not enough evaporation during frying.",
              "fix": "Fry the paste for 5 more minutes on medium-high heat, stirring constantly, until it reduces and darkens."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Chicken is dry",
              "cause": "Cooked at too high a temperature.",
              "fix": "Keep the simmer very gentle, just a few bubbles. Thighs stay moist at low heat."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mole negro is the signature dish of Oaxaca in southern Mexico. The region is known as the land of seven moles, each named by colour and complexity. Negro is the darkest and most layered. It is made for weddings, funerals, and festivals. Home cooks in Oaxaca often use a paste bought from the market and finish it at home, but the full from-scratch version is a point of pride for those who make it."
          }
        ]
      }
    ]
  }
