      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in a large saucepan over medium heat. Fry onion for 8 minutes until soft and golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add garlic, chilli, cumin, and turmeric. Cook for 2 minutes, stirring."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add potatoes and stir to coat in the spiced oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in stock and bring to the boil. Reduce heat and simmer for 20 minutes. Some potato cubes will break down; this is correct."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in milk and salt. Simmer for a further 5 minutes. The soup should be thick and creamy."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from heat. Stir in the grated cheese until melted. Taste for salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ladle into bowls. Top with fresh coriander and sliced avocado."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Soup is too thin",
              "cause": "The potatoes have not broken down enough.",
              "fix": "Mash a few ladlefuls against the side of the pot with a spoon. Stir through and simmer another 5 minutes."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Cheese goes stringy and clumps",
              "cause": "The soup was still boiling when the cheese was added.",
              "fix": "Always take the pot off the heat before adding cheese. Stir in gradually over residual heat."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Soup tastes bland",
              "cause": "Underseasoned or stock was weak.",
              "fix": "Add more salt and a squeeze of lime. The soup needs confident seasoning to carry the potato starch."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Locro de papa is the soup of the Ecuadorian Andes. The highlands of Ecuador have been cultivating potatoes since long before Spanish colonisation, and the potato remains the defining ingredient of highland cooking. Locro appears on family tables every day, from basic versions made with water and salt to richer ones loaded with cheese and cream. In Quito, the capital, it is the most ordered soup in local restaurants. It is warming, cheap, and deeply filling."
          }
        ]
      }
    ]
  }
