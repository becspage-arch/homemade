      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 2 tbsp oil in a wide pan. Toast broken noodles, stirring, until golden. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add remaining oil to the same pan. Soften onion and garlic for 8 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add grated tomato and tomato puree. Cook for 5 minutes until thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add paprika and saffron water. Stir to combine."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in white wine. Let it bubble for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add fish stock. Bring to a boil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add toasted noodles. Cook for 8 minutes, stirring often."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Nestle prawns into the noodles. Cover. Cook for 3 to 4 minutes until prawns are pink."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Scatter parsley. Serve with lemon wedges."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Noodles clumped together",
              "cause": "Not enough liquid or not stirred",
              "fix": "Add a splash more stock and stir gently to separate."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Prawns overcooked",
              "cause": "Left too long after going pink",
              "fix": "Remove from heat the moment prawns curl and turn pink."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dish tastes bland",
              "cause": "Saffron not properly dissolved or stock too weak",
              "fix": "Dissolve saffron in a tablespoon of hot water before adding."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fideos are the Spanish pasta, predating Italian pasta imports in the Iberian peninsula. They are eaten across Catalonia, Valencia, and Andalusia in soups and dry-cooked dishes called fideus. The coastal version with shellfish is a classic of the Spanish Mediterranean. Toasting the noodles before adding liquid is the key technique that gives this dish its depth. The dish is related to fideua, a paella-style noodle dish from Valencia."
          }
        ]
      }
    ]
  }
