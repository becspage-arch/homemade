      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oil in the dutch oven. Cook lardons until golden. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add onion and garlic. Soften for 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in white wine to deglaze. Scrape the bottom of the pan."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add drained sauerkraut, bay leaves, peppercorns, and lardons."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Tuck in the sausages."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add enough water to just cover the sauerkraut. Cover and cook on low heat for 1 hour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil potatoes separately in salted water until tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve sauerkraut and sausages on a large platter with boiled potatoes on the side."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauerkraut too sour",
              "cause": "Not rinsed enough",
              "fix": "Rinse under cold water for a few minutes and taste before cooking."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sausages burst",
              "cause": "Cooked at too high a heat",
              "fix": "Do not prick sausages. Keep heat low throughout."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Too much liquid in the pot",
              "cause": "Too much water added",
              "fix": "Remove the lid and reduce on medium heat for 10 minutes."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choucroute garnie is the pride of Alsatian brasseries. The region has been making sauerkraut since at least the 15th century, brought west by traders from eastern Europe. A proper choucroute garnie contains several types of pork: smoked, cured, and fresh. Restaurants in Strasbourg serve versions that can weigh over a kilogram per person. It is a winter dish, best eaten after a long walk in cold air."
          }
        ]
      }
    ]
  }
