      "slug": "layering-rice",
      "term": "Layering Rice",
      "definition": "A technique of building a pot with solid ingredients on the base and uncooked rice on top, then cooking so the rice steams and takes on the flavours below."
    },
    {
      "slug": "resting-the-pot",
      "term": "Resting the Pot",
      "definition": "Leaving a cooked rice pot covered off the heat so the steam redistributes and the grains firm up before turning out."
    }
  ],
