      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the aubergine rounds in hot oil in batches until golden on both sides, about 3 minutes per side. Set aside on kitchen paper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry cauliflower florets in the same oil for 5 minutes until golden. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fry the onion in the remaining oil for 10 minutes until softened and lightly golden. Add chicken thighs and brown for 4 minutes per side."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in 400ml stock. Add allspice, cinnamon, cumin, turmeric, cardamom, and 1 tsp salt. Simmer for 20 minutes. Remove chicken and strain the stock, keeping it."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Layer the base of a deep stockpot with tomato slices. Add a layer of aubergine, then cauliflower, then chicken pieces."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the drained rice evenly over the top. Add remaining salt. Pour hot stock over slowly until the rice is just covered, about 1cm above the rice surface."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring to a boil, then reduce to the lowest heat, cover tightly, and cook for 25 minutes. Do not lift the lid."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from heat. Rest covered for 10 minutes. Place a large platter over the pot and flip in one firm motion. Lift the pot away. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rice is undercooked after 25 minutes",
              "cause": "Not enough stock or the lid leaked steam.",
              "fix": "Add 100ml hot water, replace the lid with a folded tea towel under it to seal, and cook for 10 more minutes."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Dish collapses when flipped",
              "cause": "Did not rest long enough or used too deep a pot relative to the amount of rice.",
              "fix": "Always rest for a full 10 minutes. The rice needs to firm up and release from the pot sides before flipping."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Bottom layer has burnt",
              "cause": "Heat too high during the final rice cooking stage.",
              "fix": "A thin dark crust on the tomatoes is acceptable and adds flavour. If truly burnt, it was cooked on too high a heat. Use the lowest possible setting."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Maqluba is eaten across the Levant but is most closely associated with Palestinian and Jordanian cooking. Its dramatic presentation makes it a dish of celebration: weddings, Eid gatherings, and large family meals. The act of turning the pot is a moment the whole table watches. Some cooks add pine nuts and raisins to the garnish; others keep it completely plain. The dish appears in medieval Arabic cookbooks, suggesting it has been made in more or less this form for close to a thousand years."
          }
        ]
      }
    ]
  }
