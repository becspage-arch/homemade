  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Maqluba depends on precise "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "layering-rice"
                }
              }
            ],
            "text": "layering"
          },
          {
            "type": "text",
            "text": " in a deep pot, then "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "resting-the-pot"
                }
              }
            ],
            "text": "resting the pot"
          },
          {
            "type": "text",
            "text": " before the flip. The flip itself is nerve-wracking the first time. Use a large round platter held flat against the pot rim, then invert in one confident, swift motion."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tip: do not stir the rice at any point during cooking. The layers must stay intact for the upside-down reveal to work."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
