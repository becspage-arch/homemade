  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stamppot is the Dutch way of turning a pot of potatoes into a full meal. You "
          },
          {
            "type": "text",
            "text": "mash",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "mash"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " the potatoes and greens together with butter and milk, then serve with a "
          },
          {
            "type": "text",
            "text": "rookworst",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "rookworst"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " or any good smoked sausage on top. Simple, filling, and completely satisfying."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use floury potatoes for the best mash. They break down easily and absorb the butter well."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "potato",
              "amount": 1000,
              "unit": "g",
              "prepNote": "peeled and cubed",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "spinach",
              "amount": 300,
              "unit": "g",
              "prepNote": "or kale, roughly chopped",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "sausages-pork",
              "amount": 4,
              "unit": "whole",
              "prepNote": "smoked if possible",
              "isOptional": false,
              "groupLabel": null
            },
            {
