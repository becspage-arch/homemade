              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil potatoes in salted water until completely soft, about 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Meanwhile fry sausages in oil until cooked through and browned. Keep warm."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In the last 5 minutes of potato cooking, add spinach or kale to the pot. Let it wilt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain everything well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mash potato and greens together with butter and warm milk until smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In the same frying pan, soften onion until golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir onion through the mash. Season well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve mash in a mound with a hollow in the middle. Place sausage on top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Mash is watery",
              "cause": "Not drained well or too much milk",
              "fix": "Drain thoroughly and add milk gradually."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Greens are stringy",
              "cause": "Kale not cooked long enough",
              "fix": "Use spinach for easier results, or cook kale for at least 8 minutes."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sausages split",
              "cause": "Cooked at too high a heat",
              "fix": "Cook on medium heat and turn often."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stamppot has been eaten in the Netherlands since the 17th century. It is strongly associated with winter and Dutch home cooking. The most traditional version uses kale and is eaten on the first day of frost each year, when the cold sweetens the leaves. Dutch people are fiercely loyal to their family's version. The dish was part of the Dutch Golden Age diet."
          }
        ]
      }
    ]
  }
}