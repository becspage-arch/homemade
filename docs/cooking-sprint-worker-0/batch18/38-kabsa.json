      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 2 tbsp oil in a dutch oven over medium-high heat. Brown the chicken pieces in batches for 4 minutes per side. Remove."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In the same pot, fry quartered onion and garlic for 3 minutes. Add canned tomatoes, all whole spices, ground spices, and 1 tsp salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return chicken to the pot. Add 800ml water. Bring to the boil, reduce heat, cover, and simmer for 35 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove chicken. Strain the broth and measure 700ml. Discard the solids."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain the soaked rice. Add to the pot with the 700ml strained broth, saffron water, and remaining salt. Bring to the boil. Reduce to lowest heat, cover, and cook for 18 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Meanwhile, fry the sliced onion rings in 2 tbsp oil over medium heat for 15 minutes until deep golden. Add cashews and flaked almonds for the last 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rest the rice for 10 minutes off the heat. Spread on a large platter. Arrange chicken pieces over. Top with fried onion and nuts."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rice is mushy",
              "cause": "Too much broth used or the heat was not reduced low enough.",
              "fix": "Measure the broth precisely. Use exactly 1.75 times the volume of rice in liquid. The heat must be at its absolute lowest once covered."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Rice has no aroma",
              "cause": "The spices did not bloom in the broth.",
              "fix": "Toast the whole spices in a dry pan for 1 minute before adding them to the broth next time. It makes a significant difference."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Chicken is dry",
              "cause": "Simmered too long after the initial braise.",
              "fix": "Remove the chicken as soon as it is cooked through at around 35 minutes. Reheat it over the rice for the last 5 minutes if needed."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kabsa is the national dish of Saudi Arabia and is eaten widely across the Gulf states, Yemen, and the broader Arabian Peninsula. The dish is Bedouin in origin, designed to be made in a single large pot over a fire. It is the default celebratory meal across the region, eaten at weddings, Eid, and large gatherings. There are dozens of regional variations. Lamb, camel, fish, and chicken are all used. The spice combination and the fried onion garnish remain consistent across all versions."
          }
        ]
      }
    ]
  }
