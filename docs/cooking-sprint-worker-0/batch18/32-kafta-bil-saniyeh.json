      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix lamb mince with grated onion, parsley, allspice, cinnamon, cumin, chilli, and half the salt. Knead for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Shape the mixture into 12 oval meatballs, about 6cm long each."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix canned tomatoes, tomato puree, olive oil, remaining salt, and 100ml water in a jug."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Layer potato slices in the base of a large baking tray. Scatter the onion rings over."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour three-quarters of the tomato sauce over the potatoes. Arrange the meatballs on top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spoon the remaining sauce over the meatballs. Bake at 200C for 35 to 40 minutes until the sauce is bubbling and the meatballs are browned on top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve directly from the tray with flatbread."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Potatoes are still hard after 40 minutes",
              "cause": "Slices were cut too thick.",
              "fix": "Slice potatoes to 5mm. If they are already in the oven and still hard, cover with foil and bake for another 15 minutes."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Meatballs are dry",
              "cause": "Not enough sauce or they cooked too long uncovered.",
              "fix": "Add a splash of water to the tray, cover with foil, and return to the oven for 10 minutes."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "symptom": "Sauce is watery",
              "cause": "Too much water added or the tomatoes were very liquid.",
              "fix": "Remove the foil for the last 10 minutes of baking to let the sauce reduce."
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kafta bil saniyeh is one of the most cooked dishes in the Lebanese home kitchen. Saniyeh means tray in Arabic, and this style of cooking, where everything goes into one vessel and into the oven together, is deeply embedded in Levantine cooking. It is a practical weeknight dish that needs no active attention once the tray goes in. Variations exist across Syria, Jordan, and the Palestinian territories. Each family adjusts the spices to their own taste, but the principle of meatballs, tomato, and potato baked together never changes."
          }
        ]
      }
    ]
  }
