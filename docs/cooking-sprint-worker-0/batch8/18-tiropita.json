          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tiropita-term"
                }
              }
            ],
            "text": "Tiropita"
          },
          {
            "type": "text",
            "text": " is sold in Greek bakeries as an individual pastry and made at home as a full-tin pie for family meals. It is one of the most popular of the Greek pita family, which includes spinach pie and leek pie among others. It is good warm from the oven and equally good cold the next day. Pack leftover slices for a desk lunch or a picnic."
          }
        ]
      }
    ]
