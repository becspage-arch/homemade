      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the olive oil, lemon juice, oregano, garlic and black pepper in a bowl. Add the lamb cubes and toss well to coat. Cover and refrigerate for at least 1 hour, or overnight if you have time."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Take the lamb out of the fridge 20 minutes before cooking to take the chill off. Thread the cubes onto the skewers, leaving a small gap between each piece so the heat can circulate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the griddle pan over a high heat until it is very hot. A drop of water should evaporate almost immediately on contact."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the skewers on the griddle and cook for 3 to 4 minutes on each side, turning once or twice, until the meat is charred at the edges and cooked through. Lamb shoulder takes about 12 to 15 minutes in total."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rest the skewers for 3 minutes, then serve alongside the plain yoghurt and a squeeze of extra lemon if you like."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "problem": "The meat is sticking to the griddle",
              "solution": "The pan was not hot enough before you added the skewers. Let it heat fully and do not move the meat until it releases naturally."
            },
            {
              "problem": "The lamb is tough",
              "solution": "Shoulder needs time to marinate and enough heat to cook through. Extend the marinating time and make sure the pieces are not too large."
            },
            {
              "problem": "The skewers are charring before the meat is done",
              "solution": "Wooden skewers need soaking first. Wrap the exposed ends in foil or use metal skewers instead."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Street stalls and small tavernas all over Greece sell "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "souvlaki-term"
                }
              }
            ],
            "text": "souvlaki"
          },
          {
            "type": "text",
            "text": " wrapped in flatbread with tomato and yoghurt. At home it is a quick weeknight dinner that needs almost no effort on the night itself once the marinating is done. Pork works just as well as lamb if that is what you have. Serve with flatbreads and a simple salad of tomato and onion."
          }
        ]
      }
    ]
  }
