  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This souvlaki serves 4 with 15 minutes of preparation, an hour of marinating and 15 minutes of cooking time. Cubes of lamb are threaded onto skewers, charred on a hot griddle and served with a cooling yoghurt dip."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If you are using wooden skewers, soak them in cold water for at least 30 minutes before grilling. This slows the rate at which they char under the heat and stops them burning through before the meat is cooked. Metal skewers need no preparation."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "lamb-shoulder",
              "amount": 700,
              "unit": "g",
