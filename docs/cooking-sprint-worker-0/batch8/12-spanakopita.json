  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This spanakopita serves 6 and takes about 30 minutes to prepare plus 45 minutes in the oven. Layers of crisp pastry encase a savoury spinach and feta filling that is deeply satisfying for a weekend lunch or a packed weekday meal."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Squeeze as much liquid as possible from the cooked spinach before mixing the filling. Excess moisture will make the base soggy and stop the pastry crisping properly. A clean tea towel works well for this."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 6,
          "items": [
            {
              "ingredientSlug": "spinach",
              "amount": 500,
              "unit": "g",
              "prepNote": "fresh or frozen, thawed",
