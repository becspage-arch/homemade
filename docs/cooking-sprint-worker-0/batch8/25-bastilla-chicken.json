    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 6 and takes 45 minutes to prepare and 60 minutes to cook at 190C. It is one of Morocco's most celebrated dishes, a spectacular sweet-savoury pie that takes some effort but repays it fully."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tip: Traditional "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bastilla-term"
                }
              }
            ],
            "text": "bastilla"
          },
          {
            "type": "text",
            "text": " uses warqa, a paper-thin Moroccan pastry. Filo pastry is an excellent substitute available in most supermarkets. Keep unused sheets covered with a damp cloth to prevent drying out while you work."
          }
        ]
      },
