      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 180C. Cook the bulgur wheat according to the packet instructions, then drain if needed and set aside. Cook the bulgur with a pinch of salt for best flavour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the meat sauce. Warm a little oil in the large saucepan over a medium-high heat. Fry the onion for 5 minutes until soft, then add the garlic and cook for 1 minute. Add the beef mince and break it up, cooking until browned all over."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the tomato puree, tinned tomatoes, cinnamon and oregano. Season well. Simmer for 20 minutes until the sauce is thick and concentrated. Remove from the heat and allow to cool slightly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the bechamel. Melt the butter in the medium saucepan over a medium heat. Add the flour and stir constantly for 2 minutes. Gradually pour in the milk, whisking out any lumps as you go. Cook, stirring, for 8 to 10 minutes until the sauce is thick and smooth. Remove from the heat, let it cool for 2 minutes, then stir in the beaten eggs and most of the parmesan. Season."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spread the cooked bulgur wheat in an even layer across the base of the rectangular baking tin. Spoon the meat sauce evenly on top, then pour the bechamel over to cover completely. Scatter the remaining parmesan on top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 45 to 55 minutes until the top is golden and set. A small amount of wobble in the very centre is fine; it will firm up as it rests. Leave to stand for 15 minutes before cutting into portions and serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "problem": "The bechamel has lumps",
              "solution": "Add the milk slowly and whisk constantly. If lumps do form, pass the sauce through a sieve before adding the eggs."
            },
            {
              "problem": "The top is browning before the centre is set",
              "solution": "Cover loosely with foil after 30 minutes and continue baking until firm."
            },
            {
              "problem": "The portions fall apart when serving",
              "solution": "The dish needs the full 15-minute rest after coming out of the oven. Cutting too early means the layers have not had time to set."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
