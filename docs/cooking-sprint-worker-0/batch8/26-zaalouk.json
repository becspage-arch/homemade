    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 4 as a side or starter and takes 10 minutes to prepare and 30 minutes to cook. It is one of the most popular Moroccan cooked salads, eaten warm, at room temperature or cold."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tip: "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "zaalouk-term"
                }
              }
            ],
            "text": "Zaalouk"
          },
          {
            "type": "text",
            "text": " improves significantly if left to sit for at least 30 minutes after cooking. Make it up to a day ahead and store in the fridge. The flavours deepen overnight and the texture becomes even better."
          }
        ]
      },
