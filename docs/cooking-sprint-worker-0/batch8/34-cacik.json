  "glossaryTerms": [
    {
      "slug": "cacik-term",
      "term": "Cacik",
      "definition": "A Turkish dip and sauce of yoghurt, cucumber, garlic and mint, similar to Greek tzatziki but typically thinner and served as a soup or side."
    }
  ],
  "techniqueSlugs": [],
  "criticalTechniques": [],
  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This recipe serves 4 and takes 10 minutes to prepare with no cooking needed. Thick yoghurt is stirred with grated courgette, garlic, mint, olive oil and lemon to make a cool, refreshing dip that doubles as a side sauce alongside grilled meats and flatbreads."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tip: squeeze as much water as possible from the grated courgette before stirring it through. Any excess moisture will quickly make the cacik thin and watery."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "plain-yoghurt",
              "amount": 200,
              "unit": "g",
              "prepNote": null,
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "courgette",
              "amount": 1,
