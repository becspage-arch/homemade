      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rinse the tomatoes, courgette and olives in the colander under cold water and pat dry. Cut the tomatoes into wedges and the courgette into thin half-moon slices."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Arrange the tomatoes and courgette on a large plate or shallow bowl. Scatter over the onion slices and olives."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the feta on top as a single piece or broken into large chunks. Do not mix it in; it should sit visibly on top."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drizzle the olive oil all over, then scatter the dried oregano. Season with black pepper and add a squeeze of lemon if you like. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "problem": "The salad is watery by the time it reaches the table",
              "solution": "Tomatoes release water once cut and dressed. Assemble and dress the salad just before serving rather than ahead of time."
            },
            {
              "problem": "The onion is too sharp and overpowering",
              "solution": "Soak the sliced onion in cold water for 10 minutes, then drain and pat dry before adding to the salad."
            },
            {
              "problem": "The feta is too salty",
              "solution": "Rinse the block briefly under cold water and pat dry. The surface brine accounts for much of the saltiness."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "horiatiki"
                }
              }
            ],
            "text": "horiatiki"
          },
          {
            "type": "text",
            "text": " is the original form of this salad as eaten in Greek villages, with no lettuce and no fuss. It is on every taverna table in summer, served as a shared starter or a side alongside grilled fish or meat. The absence of lettuce means it holds better than most salads and pairs well with bread for scooping up the olive-oil-and-tomato juices at the bottom of the bowl."
          }
        ]
      }
    ]
  }
}