              "amount": null,
              "unit": "pinch",
              "prepNote": "to taste",
              "isOptional": false,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Grate the courgette on the coarse side of a box grater. Place it in the colander set over a bowl, sprinkle with a pinch of salt and leave for 10 minutes. Then squeeze out as much liquid as possible with your hands."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put the yoghurt into a bowl. Add the drained courgette, minced garlic, olive oil, chopped mint and lemon juice. Stir everything together."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Taste and adjust the seasoning. Add more lemon juice if you want more brightness, more garlic if you prefer a stronger flavour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and refrigerate for at least 15 minutes before serving so the flavours can come together. Drizzle with a little extra olive oil just before bringing it to the table."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "problem": "The dip is watery",
              "solution": "The courgette was not squeezed dry enough, or the yoghurt was too thin. Drain both more thoroughly next time."
            },
            {
              "problem": "The garlic flavour is too sharp",
              "solution": "Raw garlic intensifies as it sits. Use less, or stir the dip together 30 minutes before serving so the sharpness mellows into the yoghurt."
            },
            {
              "problem": "The dip tastes flat",
              "solution": "It needs more salt and lemon. Season in small amounts, taste as you go, and do not skip the final drizzle of olive oil."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "No meze table in Greece is complete without "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tzatziki-term"
                }
              }
            ],
            "text": "tzatziki"
          },
          {
            "type": "text",
            "text": ". It sits alongside olives, bread and dips as a shared starter before the main course arrives. It also works as a sauce spooned over grilled souvlaki or dolloped inside a flatbread wrap. The dip keeps well in the fridge for two days, though the garlic becomes more pronounced over time."
          }
        ]
      }
    ]
  }
