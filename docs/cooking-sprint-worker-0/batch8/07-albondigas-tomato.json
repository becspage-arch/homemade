      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the beef mince, soaked breadcrumbs, beaten egg, grated garlic, parsley, cumin and a generous amount of black pepper in a bowl. Stir just until combined. Roll into walnut-sized balls (about 20 total). Set aside on a tray."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 3 tablespoons of olive oil in a large frying pan over a high heat. Fry the meatballs in batches for 4 to 5 minutes, turning gently, until browned all over. They do not need to be cooked through. Transfer to a plate and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the sauce in a large saucepan. Heat 2 tablespoons of olive oil over a medium heat. Add the onion and cook for 8 minutes until soft and starting to colour. Add the garlic and smoked paprika and cook for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the tomato puree and cook for 2 minutes. Add the tinned tomatoes and 150ml of water. Bring to a simmer and cook for 10 minutes until the sauce has reduced slightly and deepened in colour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Nestle the browned meatballs into the sauce. Cover and simmer gently for 15 minutes until the meatballs are cooked through. Serve scattered with fresh parsley and plenty of bread."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "problem": "The meatballs are falling apart during frying",
              "solution": "The mixture needs more binding. Add a second egg or a little more soaked breadcrumb. Chill the shaped meatballs for 20 minutes before frying to help them hold their shape."
            },
            {
              "problem": "The sauce is too thin",
              "solution": "Simmer uncovered for an extra 5 to 10 minutes. The sauce should coat the meatballs thickly, not pool around them."
            },
            {
              "problem": "The meatballs taste bland",
              "solution": "Season the mince mixture more generously before rolling. Fry a small piece first and taste it before shaping the rest."
            }
          ]
        }
      },
      {
