  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This fasolada serves 4 and needs around 15 minutes to prepare followed by 90 minutes of gentle simmering. It is one of the simplest soups in the Greek kitchen and also one of the most nourishing, built on dried chickpeas, celery, carrot and a generous amount of olive oil."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Soak the chickpeas overnight in cold water. This cuts the cooking time significantly and results in a more even texture throughout. Dried chickpeas that have not been soaked can take twice as long to become fully tender."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "chickpeas-dried",
              "amount": 300,
              "unit": "g",
              "prepNote": "soaked overnight and drained (used in place of white beans)",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "onion",
              "amount": 1,
              "unit": null,
              "prepNote": "finely chopped",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "celery",
              "amount": 3,
              "unit": "sticks",
              "prepNote": "sliced, with leaves reserved",
              "isOptional": false,
              "groupLabel": null
            },
            {
