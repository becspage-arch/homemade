  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Carrot cake is a spiced cake made with vegetable oil rather than butter, which gives it a very moist, dense crumb that keeps well for several days. The cream cheese frosting is sharp enough to cut through the sweetness of the cake. The walnuts are optional but give a good contrast to the soft crumb."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "For the cake" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "servings": 10,
          "items": [
            { "ingredientSlug": "vegetable-oil", "amount": 200, "unit": "ml" },
            { "ingredientSlug": "light-brown-sugar", "amount": 200, "unit": "g" },
            { "ingredientSlug": "eggs", "amount": 3, "unit": "each" },
            { "ingredientSlug": "carrot", "amount": 300, "unit": "g", "preparation": "peeled and grated" },
            { "ingredientSlug": "plain-flour", "amount": 200, "unit": "g" },
            { "ingredientSlug": "baking-powder", "amount": 2, "unit": "tsp" },
            { "ingredientSlug": "bicarbonate-of-soda", "amount": 0.5, "unit": "tsp" },
            { "ingredientSlug": "cinnamon-ground", "amount": 2, "unit": "tsp" },
            { "ingredientSlug": "ginger-ground", "amount": 1, "unit": "tsp" },
            { "ingredientSlug": "walnuts", "amount": 80, "unit": "g", "preparation": "roughly chopped" }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "For the frosting" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "servings": 10,
          "items": [
            { "ingredientSlug": "cream-cheese", "amount": 280, "unit": "g", "preparation": "at room temperature" },
            { "ingredientSlug": "unsalted-butter", "amount": 60, "unit": "g", "preparation": "softened" },
            { "ingredientSlug": "icing-sugar", "amount": 200, "unit": "g", "preparation": "sifted" },
            { "ingredientSlug": "vanilla-extract", "amount": 1, "unit": "tsp" }
          ]
        }
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Heat the oven to 180 C / fan 160 C / gas 4. Grease two 20 cm round cake tins and line the bases." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Whisk the oil and brown sugar together in a large bowl. Add the eggs one at a time, whisking well. Stir in the grated carrot." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Sift the flour, baking powder, bicarbonate of soda, cinnamon, and ginger over the wet ingredients. Fold in until combined. Stir in the walnuts." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Divide between the tins and bake for 30 to 35 minutes until a skewer comes out clean. Cool in the tins for 10 minutes, then turn out and cool completely on a wire rack." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Beat the cream cheese and butter together until smooth. Add the icing sugar and vanilla. Beat until fluffy and spreadable. Sandwich the two cakes with half the frosting and spread the rest on top." }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
