    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Shrimp and grits is stone-ground corn grits cooked in stock and milk until thick and creamy, then topped with prawns cooked in a smoky sauce of bacon, tomato, and garlic. The richness of the grits and the sharp, savoury prawn sauce need each other. Stone-ground grits take longer to cook but have much more corn flavour than instant."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "For the grits" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "servings": 4,
          "items": [
            { "ingredientSlug": "polenta", "amount": 200, "unit": "g" },
            { "ingredientSlug": "stock-chicken", "amount": 600, "unit": "ml" },
            { "ingredientSlug": "whole-milk", "amount": 400, "unit": "ml" },
            { "ingredientSlug": "unsalted-butter", "amount": 40, "unit": "g" },
            { "ingredientSlug": "cheddar", "amount": 60, "unit": "g", "preparation": "grated" },
            { "ingredientSlug": "salt-table", "amount": 1, "unit": "tsp" }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "For the prawns" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "servings": 4,
          "items": [
            { "ingredientSlug": "raw-king-prawns", "amount": 600, "unit": "g", "preparation": "peeled and deveined" },
            { "ingredientSlug": "streaky-bacon", "amount": 4, "unit": "each", "preparation": "cut into lardons" },
            { "ingredientSlug": "garlic", "amount": 3, "unit": "clove", "preparation": "chopped" },
            { "ingredientSlug": "pepper-green", "amount": 1, "unit": "each", "preparation": "diced" },
            { "ingredientSlug": "spring-onion", "amount": 4, "unit": "each", "preparation": "sliced, white and green parts separated" },
            { "ingredientSlug": "tinned-tomatoes", "amount": 200, "unit": "g" },
            { "ingredientSlug": "stock-chicken", "amount": 100, "unit": "ml" },
            { "ingredientSlug": "smoked-paprika", "amount": 1, "unit": "tsp" },
            { "ingredientSlug": "cayenne-pepper", "amount": 0.25, "unit": "tsp" },
            { "ingredientSlug": "lemon", "amount": 0.5, "unit": "each", "preparation": "juice only" },
            { "ingredientSlug": "salt-table", "amount": 0.5, "unit": "tsp" }
          ]
        }
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Bring the stock and milk to a simmer in a large saucepan. Whisk in the grits gradually to avoid lumps. Cook over a low heat, stirring frequently, for 25 to 30 minutes until thick and creamy. Stir in the butter and cheese. Season with salt. Keep warm." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Fry the bacon lardons in a large frying pan over a medium heat for 5 minutes until crisp. Add the spring onion whites, green pepper, and garlic. Cook for 3 minutes." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Add the smoked paprika and cayenne. Stir for 30 seconds. Pour in the tomatoes and stock. Simmer for 5 minutes." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Add the prawns and cook for 2 to 3 minutes, turning once, until pink and just cooked through. Add the lemon juice, salt, and the green spring onion tops. Stir together." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Spoon the grits into bowls and ladle the prawn sauce over the top. Serve immediately." }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
