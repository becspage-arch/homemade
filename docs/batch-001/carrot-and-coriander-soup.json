  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Carrot and coriander soup is a smooth, bright orange soup made from carrots cooked in stock with onion, garlic, and ground coriander, then blended until completely smooth. Fresh coriander is stirred in at the end and keeps its fresh flavour. It takes about 40 minutes from start to finish."
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "servings": 4,
          "items": [
            { "ingredientSlug": "unsalted-butter", "amount": 20, "unit": "g" },
            { "ingredientSlug": "onion", "amount": 1, "unit": "each", "preparation": "roughly chopped" },
            { "ingredientSlug": "garlic", "amount": 2, "unit": "clove", "preparation": "sliced" },
            { "ingredientSlug": "carrot", "amount": 700, "unit": "g", "preparation": "peeled and roughly chopped" },
            { "ingredientSlug": "coriander-ground", "amount": 1.5, "unit": "tsp" },
            { "ingredientSlug": "cumin-ground", "amount": 0.5, "unit": "tsp" },
            { "ingredientSlug": "stock-vegetable", "amount": 1000, "unit": "ml" },
            { "ingredientSlug": "sea-salt-fine", "amount": 1, "unit": "tsp" },
            { "ingredientSlug": "coriander-fresh", "amount": 20, "unit": "g", "preparation": "roughly chopped" },
            { "ingredientSlug": "double-cream", "amount": 2, "unit": "tbsp", "preparation": "to serve (optional)" }
          ]
        }
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Melt the butter in a large saucepan over a medium heat. Add the onion and cook for 5 minutes until softened. Add the garlic and cook for 1 minute." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Add the ground coriander and cumin. Stir and cook for 30 seconds. Add the carrot and stir to coat in the spices." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Pour in the stock. Season with salt. Bring to a boil, then simmer for 20 minutes until the carrots are completely tender." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Blend smooth with a stick blender. Stir in most of the fresh coriander. Taste for salt and spice." }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Ladle into bowls. Swirl over a little cream if using and scatter the remaining coriander over the top." }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
