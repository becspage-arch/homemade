        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry bacon in a dry frying pan until crisp and the fat has rendered. Add crushed garlic and cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Transfer bacon and garlic to a large saucepan. Add stock, diced potato, and marjoram. Bring to the boil then simmer for 20 minutes until the potato is tender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from heat. Stir in soured cream and white wine vinegar. Add worcestershire sauce." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season with salt and pepper. Serve with two hard-boiled egg halves in each bowl." }] }] }
