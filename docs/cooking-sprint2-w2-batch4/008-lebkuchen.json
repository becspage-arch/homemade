      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Warm honey, brown sugar, and butter together in a pan over a gentle heat until melted. Remove from heat and cool for 10 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the egg. Add flour, all the spices, and bicarbonate of soda. Mix to a firm dough." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Wrap and chill for 1 hour." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oven to 180°C. Line two baking sheets with baking paper." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roll dough to 5mm thick on a lightly floured surface. Cut into shapes with a cutter or knife. Place on the lined baking sheets with a little space between each." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bake for 12-15 minutes until just set and fragrant. Cool completely before decorating." }] }] }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Biscuits are very hard", "cause": "Over-baked or rolled too thin", "fix": "Remove when they look just set -- they firm up as they cool. Roll to at least 5mm." }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Where this dish lives" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Nuremberg and across Germany at Christmas markets. Sold in decorated tins as gifts. A key part of Advent celebrations across the country. Nuremberg's lebkuchen carry protected geographical status." }]
      }
