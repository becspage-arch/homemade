    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Lebkuchen fill the house with the scent of Christmas. The dough comes together quickly and needs an hour in the fridge before baking. They keep well in a tin for two weeks and the flavour deepens over the first few days." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 24,
          "items": [
            { "ingredientSlug": "plain-flour", "amount": 300, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "honey", "amount": 150, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "brown-sugar", "amount": 100, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
