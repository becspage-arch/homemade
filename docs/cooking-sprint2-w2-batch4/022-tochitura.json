      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a large pan over high heat. Fry bacon until crisp and the fat has rendered. Remove." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Brown the diced pork shoulder in the bacon fat in batches. Remove. Add sliced sausages and brown on all sides. Remove." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return all meats to the pan. Add crushed garlic and paprika. Stir and cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add tomato puree. Pour in wine and let it bubble for 2 minutes. Add stock and bay leaves." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Simmer uncovered on medium-low heat for 45-50 minutes until the pork is tender and the sauce has reduced and thickened. Season." }] }] }
        ]
      },
