        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix beef mince, raw rice, grated onion, egg, 1 tbsp paprika, salt, and pepper together until well combined." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stuff the mixture firmly into the peppers, filling to about 2cm below the top. Place the reserved tops back on." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stand the peppers upright and close together in a deep pot or casserole." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix tinned tomatoes, tomato puree, stock, oil, and the remaining 1 tbsp paprika. Pour around the peppers." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover tightly and simmer on a very low heat for 55-60 minutes, basting occasionally. The rice inside should be cooked and the meat set." }] }] }
        ]
