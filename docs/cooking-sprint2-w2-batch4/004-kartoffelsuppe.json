        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt butter in a large saucepan over medium heat. Add onion and soften for 5 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add carrot, leek, and celery. Cook for 3 minutes, stirring." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add potatoes, marjoram, and stock. Bring to the boil then reduce to a simmer. Cook for 25-30 minutes until the potato is very soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Blend half or all with a stick blender to your preferred texture. A partially blended soup has a good chunky feel; fully blended is smoother and creamier." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the cream. Season with salt and pepper. Serve topped with chopped parsley." }] }] }
        ]
