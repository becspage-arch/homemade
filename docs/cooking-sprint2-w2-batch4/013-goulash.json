      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oil in a large pot over high heat. Brown beef in batches -- do not crowd the pan. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce heat to medium. Add onion and cook for 8 minutes until golden and soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add garlic, paprika, and smoked paprika. Stir constantly for 1-2 minutes. The paprika must not burn." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add tomato puree, tinned tomatoes, stock, caraway seeds, bay leaves, and carrot. Return the beef." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to a simmer. Cover and cook on a low heat for 1.5-2 hours until the beef is very tender. Season." }] }] }
        ]
      },
