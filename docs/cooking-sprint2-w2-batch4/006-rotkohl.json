      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oil in a large saucepan over medium heat. Add onion and cook for 5 minutes until soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the shredded red cabbage and toss well to coat in the oil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add vinegar, brown sugar, cloves, bay leaves, allspice, and 100ml water. Stir to combine." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover and braise on a very low heat for 50-60 minutes, stirring every 15 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season with salt. Remove the bay leaves and cloves before serving." }] }] }
        ]
      },
