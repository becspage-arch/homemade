      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "The night before: place beef in a bowl with the diced carrot, celeriac, onion, bay leaves, allspice, peppercorns, and vinegar. Add cold water to just cover. Refrigerate overnight." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Next day: remove beef and pat very dry. Sear in a hot pan with butter until well browned on all sides." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Transfer to a heavy casserole. Drain the vegetables from the marinade and add to the pot. Pour over stock. Cover and braise in the oven at 160°C for 2.5-3 hours until very tender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove beef and rest. Blend the braising vegetables and juices with the cream to a smooth sauce. Strain through a sieve." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add lemon juice, lemon zest, and sugar. Season. Thicken with a flour-butter paste if needed. Slice beef and return to the sauce." }] }] }
        ]
      },
      {
        "type": "troubleshooter",
