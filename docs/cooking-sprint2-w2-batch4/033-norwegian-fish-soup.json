      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt butter in a large saucepan over medium heat. Add leek and celery and soften for 5 minutes. Add carrot and cook 2 more minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in flour and cook for 1 minute. Gradually add fish stock, stirring well to avoid lumps." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to a simmer and cook for 10 minutes until the carrot is nearly tender. Add cream. Season with salt and pepper." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Gently add fish chunks. Simmer very gently for 5-6 minutes until the fish is just cooked -- it should flake easily." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add lemon juice and dill. Do not boil after the fish goes in. Serve immediately." }] }] }
        ]
      },
