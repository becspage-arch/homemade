      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt butter in a large saucepan over medium heat. Add onion and cook for 5 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add grated carrot and cook for 3 minutes more." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add grated beetroot, shredded cabbage, garlic, and bay leaves. Pour over the stock." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to the boil then reduce to a gentle simmer. Cook for 40 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add vinegar in the last 5 minutes of cooking. Season with salt and pepper. Remove bay leaves." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve in bowls with a large spoonful of soured cream swirled on top." }] }] }
        ]
