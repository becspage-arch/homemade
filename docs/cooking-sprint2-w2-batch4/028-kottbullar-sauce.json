        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt butter in a saucepan over medium heat. Add flour and stir constantly with a wooden spoon for 2 minutes until the mixture turns a light tan colour." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add stock in 3-4 additions, whisking well between each addition to keep the sauce smooth." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to a gentle simmer. Cook for 5 minutes, stirring." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from heat. Stir in soured cream and worcestershire sauce. Season with salt and pepper." }] }] }
