          "items": [
            { "symptom": "Bechamel is lumpy", "cause": "Milk added too fast to the roux", "fix": "Add milk in 4-5 small additions, whisking constantly between each. Warm the milk first." }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Where this dish lives" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Greece. Found in every Greek taverna. Home cooks make it for Sunday lunch and family gatherings. It is considered one of the great comfort dishes of the eastern Mediterranean, with versions in Egypt, Turkey, and the Balkans." }]
      }
    ]
