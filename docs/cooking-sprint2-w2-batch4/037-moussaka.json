      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Salt the aubergine slices and leave for 20 minutes. Rinse and pat dry. Brush with olive oil and roast at 200°C for 20 minutes until golden and soft. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make meat sauce: cook onion in oil until soft. Add beef mince and brown well, breaking up lumps. Add garlic, tinned tomatoes, tomato puree, cinnamon, allspice, salt, and pepper. Simmer for 20 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make bechamel: melt butter in a saucepan. Stir in flour. Cook for 2 minutes. Add warm milk in slow additions, whisking constantly until thick and smooth. Remove from heat. Whisk in egg yolks and nutmeg." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Layer in a deep oven dish: half the aubergine, all the meat sauce, remaining aubergine. Pour bechamel evenly over the top. Scatter parmesan." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bake at 180°C for 40-45 minutes until deep golden and bubbling. Rest for 10 minutes before cutting." }] }] }
        ]
      },
      {
        "type": "troubleshooter",
