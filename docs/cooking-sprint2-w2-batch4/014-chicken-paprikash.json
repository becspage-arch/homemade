      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oil in a large pan. Brown chicken thighs on both sides, skin-side first, about 4 minutes each side. Remove." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In the same pan, cook onion on medium heat for 8 minutes until golden. Add garlic and paprika. Stir and cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add tomato puree. Pour in stock. Return chicken. Cover and simmer for 35-40 minutes until chicken is cooked through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove chicken and set aside. Mix flour into the soured cream until smooth." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove pan from heat. Stir in soured cream mixture. Return to a very gentle heat and simmer for 3 minutes, stirring. Return chicken to the sauce." }] }] }
        ]
      },
