      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Season and bake"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 200°C (fan 180°C / gas mark 6). Pat {{chicken-wings}} dry with kitchen paper. Toss with {{rapeseed-oil}}, {{paprika-smoked}}, {{garlic-powder}}, {{sea-salt-flakes}}, and {{black-pepper}}. Arrange skin side up on a rack set over a lined baking tray, with space between each wing."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 30 minutes, turning once halfway, until the skin is golden and the wings are cooked through."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the sauce and glaze"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine all the sauce ingredients in a small saucepan. Simmer for five minutes until slightly thickened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Increase the oven to 220°C (fan 200°C / gas mark 7). Brush the wings generously with BBQ sauce and return to the oven for five minutes. Brush again with a second coat and cook for a further five minutes until the glaze is sticky and caramelised. Watch carefully."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The skin is soft and not crisping",
              "cause": "Wings too wet, or not on a rack.",
              "fix": "Pat completely dry before seasoning. The rack is important: it lifts the wings off the tray so hot air circulates underneath."
            },
            {
              "symptom": "The BBQ glaze is burning",
              "cause": "Oven too hot, or glaze applied too early.",
              "fix": "Apply the glaze only in the last ten minutes of cooking. Watch the wings closely: the sugar in the sauce can go from caramelised to burned very quickly."
            },
            {
              "symptom": "The wings are undercooked after 30 minutes",
              "cause": "Wings too large, or oven running cool.",
              "fix": "Check one wing at the thickest point of the drummette: the juice should run clear. Add another five minutes before glazing."
            },
            {
              "symptom": "The glaze won't stick evenly",
              "cause": "Too much oil on the wings from the initial seasoning.",
              "fix": "Use only enough oil to coat lightly. Brush the wings lightly with the glaze: a pastry brush works better than pouring, which causes pooling."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "BBQ wings are the oven-friendly sibling of buffalo wings: less crisp but more accessible for home cooks making a large batch. They're a standard at American cookouts and tailgate parties, where the oven approach makes more sense than managing a deep fryer outdoors. Serve with coleslaw and carrot sticks."
          }
        ]
      }
    ]
  }
