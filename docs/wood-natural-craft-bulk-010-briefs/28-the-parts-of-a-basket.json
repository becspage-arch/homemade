{
  "slug": "the-parts-of-a-basket",
  "title": "The parts of a basket",
  "subtitle": "A reference for the terms used in all British willow basket patterns",
  "excerpt": "British willow basket patterns use a specific vocabulary that is consistent across the tradition. This article covers the parts of a basket from base to border, the weave types, and the terminology used in every pattern on this site.",
  "type": "READING",
  "categorySlug": "wood-natural-craft",
  "subCategorySlug": "basketry-willow",
  "difficulty": "BEGINNER",
  "season": null,
  "sourceType": "CLASSIC",
  "sourceNotes": null,
  "glossaryTerms": [
    {
      "slug": "slath",
      "term": "Slath",
      "definition": "The crossed-stick foundation of a round basket base. Two groups of sticks are pierced and interlocked to form the cross."
    },
    {
      "slug": "stake",
      "term": "Stake",
      "definition": "The upright structural rods of a basket that form the frame for the woven sides. Stakes are heavier-gauge rods than weavers."
    },
    {
      "slug": "weaver",
      "term": "Weaver",
      "definition": "The thinner rods woven between the stakes to build up the sides of the basket."
    },
    {
      "slug": "wale",
      "term": "Wale",
      "definition": "A band of three or four rods worked in sequence, each passing in front of two stakes and behind one, producing a strong structural weave used at upsets and rims."
    },
    {
      "slug": "border",
      "term": "Border",
      "definition": "The woven finishing edge at the top of a basket, made by folding the stakes down over the rim and threading them through the weave."
    }
  ],
  "techniqueSlugs": [],
  "criticalTechniques": [],
  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Willow basket-making has its own vocabulary, used in all written patterns. These terms appear in trade manuals from the nineteenth century and in contemporary workshop guides alike. Learn them once and you can follow any pattern without confusion about what piece goes where."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "The base"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "slath"
                        }
                      }
                    ],
                    "text": "Slath"
                  },
                  {
                    "type": "text",
                    "text": ": the crossed-stick centre of a round base. Two groups of base sticks pierced through each other. Forms the wheel from which the base radiates."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Base sticks: the heavy rods that form the structural spokes of the base. Also called slath sticks or cross-sticks on an oval base."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Base "
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "weaver"
                        }
                      }
                    ],
                    "text": "weaver"
                  },
                  {
                    "type": "text",
                    "text": "s: the weavers used to weave the base. Usually worked in pairing weave around the base sticks."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "The sides"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "stake"
                        }
                      }
                    ],
                    "text": "Stake"
                  },
                  {
                    "type": "text",
                    "text": "s: the upright rods that form the frame for the sides. Inserted alongside the base sticks after the base is complete. Heavier than weavers."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Upset: the first few rounds of waling weave at the base of the sides. The upset sets the stake angle and locks the sides to the base. Never skipped."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Siding: the main body of weaving between the upset and the final "
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "wale"
                        }
                      }
                    ],
                    "text": "wale"
                  },
                  {
                    "type": "text",
                    "text": "."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Wale: a structural band of three or four rods placed at the upset and at the rim."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pairing: a two-rod alternating weave, the densest and most common siding weave."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Randing: a single-rod weave requiring an odd number of stakes, giving a more open texture."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "The rim"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "border"
                        }
                      }
                    ],
                    "text": "Border"
                  },
                  {
                    "type": "text",
                    "text": ": the finishing edge of the basket made by folding the stakes down and threading them through the weave. The border type (three-rod, four-rod, three-behind-two) is specified in every pattern."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Kink: the sharp bend made in a stake at the rim line before threading it into the border. The kink defines where the rim sits."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Rod terminology"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Butt: the thick end of a willow rod, nearest to the root. Heavy, stiff. Butts go in first when starting a weaver."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Tip: the thin end. More flexible. Joins are made at tip-to-butt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slype: a long diagonal cut on the end of a stake or rod to give a point for insertion. Cut with secateurs in a single scissors action."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Gauge: the diameter of a rod at the butt. Patterns specify approximate gauge in millimetres to guide selection from a bolt of rods."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Tools"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bodkin: the pointed steel spike for opening channels in the weave to insert stakes or border ends."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rapping iron: a heavy flat-backed tool for pressing rounds of weave down tightly. Essential for the wale rounds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Secateurs: for slyping and trimming. One clean cut on each slype; do not saw at the rod."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Soaking trough: a long, flat-bottomed container for soaking rods. Must be long enough for the longest rods in the bolt (usually 4 ft / 1.2 m as a minimum)."
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}