      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Marinate the chicken"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mix the yoghurt, lemon juice, grated garlic, grated ginger, cumin, and smoked paprika in a bowl. Add the chicken pieces and coat well. Cover and refrigerate for at least 1 hour, or overnight."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Sear the chicken"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heat {{olive-oil}} of olive oil in a large frying pan over high heat. Sear the marinated chicken in two batches for 2 to 3 minutes per side until charred spots appear. The chicken does not need to be cooked through, just coloured. Transfer to a plate."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Build the masala sauce"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "In the same pan over medium heat, add the diced onion and cook for 8 to 10 minutes until golden. Add the sauce garlic and ginger; cook for 1 minute. Add the garam masala, coriander, turmeric, and chilli powder; stir for 1 minute. Add the tomato puree and stir for 1 minute. Pour in the tinned tomatoes. Transfer the sauce to the pressure cooker. Add the seared chicken pieces."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Pressure-cook and finish"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Seal the lid and bring to high pressure. Cook at high pressure for 10 minutes, then quick-release. Open the lid. Stir in {{double-cream}} of double cream. Season with salt. Simmer uncovered for 3 minutes in the open pot."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "The tikka has no colour or charring",
              "cause": "The pan was not hot enough, or the chicken was seared in too large a batch.",
              "fix": "Use a very hot pan and work in small batches with space between each piece. Crowding the pan drops the temperature and causes steaming rather than searing."
            },
            {
              "symptom": "The sauce is watery",
              "cause": "Tinned tomatoes added excess liquid.",
              "fix": "Simmer in the open pot over medium-high heat for 8 minutes until reduced. The sauce should coat the back of a spoon."
            },
            {
              "symptom": "The chicken is overcooked and dry",
              "cause": "The chicken was fully cooked during searing before pressure-cooking.",
              "fix": "The sear should just colour the surface, 2 minutes per side maximum. The pressure cooker finishes the cooking."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chicken tikka masala became so embedded in British food culture that a Foreign Secretary once called it a true British national dish. By the early 2000s, that claim was not far off. Its appeal is the spicing and the rich tomato-cream sauce. The pressure cooker makes it a weeknight dish rather than a weekend project."
          }
        ]
      }
    ]
  }
