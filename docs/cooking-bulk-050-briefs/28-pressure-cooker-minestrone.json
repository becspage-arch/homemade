      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Build the base"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Set the pressure cooker to sauté or use the open pot on the hob. Heat {{olive-oil}} of olive oil over medium heat. Add the onion, carrot, and celery; cook for 8 minutes until softened. Add the garlic and tomato puree; stir for 1 minute."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Add remaining ingredients and pressure-cook"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Add the tinned tomatoes, drained kidney beans, {{stock-vegetable}} of vegetable stock, thyme, and bay. Season with salt and pepper. Seal the lid and bring to high pressure. Cook at high pressure for 10 minutes. Quick-release the pressure."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Taste and serve"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Open the lid, discard the thyme and bay, and taste the soup. Adjust the seasoning. For a thicker minestrone, use the back of a spoon to crush some of the beans against the side of the pot. Finish with a generous drizzle of olive oil over each bowl."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "The soup is very thin",
              "cause": "The vegetables released more liquid than the stock requires.",
              "fix": "Crush some of the beans into the broth to thicken it naturally. Alternatively, simmer in the open pot over medium heat for 10 minutes to reduce."
            },
            {
              "symptom": "The vegetables are overcooked",
              "cause": "The pressure time was too long for finely diced vegetables.",
              "fix": "Cut vegetables into larger 2 cm pieces next time. For a soup with distinct pieces, reduce pressure time to 8 minutes."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Minestrone is the Italian version of the British vegetable soup. It is variable, satisfying, and a full meal with bread. The flavour improves after a night in the fridge, making it one of the best soups to make ahead. The pressure cooker cuts an hour of simmering to 10 minutes."
          }
        ]
      }
    ]
