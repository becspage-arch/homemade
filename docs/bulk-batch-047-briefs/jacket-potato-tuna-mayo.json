      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bake the potatoes"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 220 degrees C. Scrub {{potato}} potatoes and pat dry. Rub all over with {{sunflower-oil}} of oil and a generous pinch of salt. Prick several times with a fork."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place directly on the oven rack or on a baking tray. Bake for 70 to 80 minutes until the skin is crunchy and a skewer slides in without any resistance. Large potatoes need the full time."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the tuna mayo"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain {{tuna-tinned}} of tuna well and flake into a bowl. Add {{mayonnaise}} of mayonnaise, {{spring-onion}} finely sliced spring onions, and the juice of {{lemon}}. Season with pepper. Mix together and taste for seasoning."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Serve"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cut each potato across the top with a deep cross and push the ends to open it up. Add {{unsalted-butter}} of butter and let it melt. Pile the tuna mayo inside."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Skin is soft rather than crisp",
              "cause": "Foil used, or oven too cool, or potato not dried before oiling",
              "fix": "No foil. Pat the potato dry, rub with oil and salt, and bake at 220 degrees C directly on the rack."
            },
            {
              "symptom": "Filling is watery",
              "cause": "Tuna not drained thoroughly",
              "fix": "Press the drained tuna against the side of the tin with a fork to squeeze out extra liquid before mixing."
            },
            {
              "symptom": "Inside is dense and starchy",
              "cause": "Wrong variety of potato used",
              "fix": "Use a floury variety such as King Edward or Maris Piper. Waxy types stay dense when baked."
            },
            {
              "symptom": "Filling tastes bland",
              "cause": "Not enough seasoning or acid",
              "fix": "Add more lemon juice and a pinch of salt. Taste before it goes on the potato."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The tuna mayo jacket potato shares the top spot with cheese and beans as the most common baked potato filling in Britain. It became a high-street staple in the 1970s and 1980s through potato-bar stalls and staff canteens. The filling is a British tuna salad: mayonnaise-based, sharp with spring onion, and mild enough for anyone. It bears no resemblance to any dish from the cultures that originally developed tinned tuna as a product."
          }
        ]
      }
    ]
  }
