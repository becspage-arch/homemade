      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put the {{smoked-haddock}} of smoked haddock in a wide pan, skin-side down. Pour over {{whole-milk}} of milk and add the bay leaves. Bring to a bare simmer and poach for 8 minutes until the fish flakes easily. Lift out, remove the skin and any bones, and flake into large pieces. Discard the poaching milk."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the rice in well-salted boiling water for 8 minutes until just tender but still with a little bite. Drain and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the butter in a large saucepan over medium heat. Add the onion and cook for 6 minutes until soft. Add the garam masala, cumin, and turmeric and cook for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the drained rice and fold gently to coat in the spiced butter. Add the flaked haddock and fold in carefully to keep the flakes large."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Quarter the {{eggs}} of hard-boiled eggs and arrange on top. Season with black pepper, scatter with parsley, and serve with lemon wedges."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Rice is sticky and clumped",
              "cause": "Not rinsed before cooking, or cooked for too long",
              "fix": "Rinse the rice until the water runs clear. Cook for 8 minutes only; it will absorb moisture from the resting time in the pan."
            },
            {
              "symptom": "Fish breaks into very small pieces and disappears into the rice",
              "cause": "Flaked too finely, or stirred too vigorously when combining",
              "fix": "Flake the haddock into large 3 to 4 cm pieces and fold it in gently using a wide spatula. Stop mixing once it is incorporated."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Kedgeree was the breakfast dish of Anglo-Indian households and British colonial families returning from India. It appeared in Victorian and Edwardian country-house menus alongside kippers and devilled kidneys. By the twentieth century it had become a standard British weekend breakfast. It belongs to the tradition of Anglo-Indian cooking, a category of dishes developed when British colonists adapted Indian ingredients and techniques to suit British tastes. It remains one of the best of them."
          }
        ]
      }
    ]
  }
