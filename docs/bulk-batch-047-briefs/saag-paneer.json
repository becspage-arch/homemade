      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Blanch {{spinach}} of spinach in boiling water for 1 minute. Drain and cool under cold water. Squeeze dry in a cloth, then blend or finely chop until smooth. Set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 2 tablespoons of oil in a frying pan over medium-high heat. Add the {{paneer}} of paneer cubes and fry, turning, until golden on all sides. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the remaining oil in a large saucepan over medium heat. Add the onion and cook for 8 minutes until golden. Add the garlic, ginger, garam masala, cumin, coriander, and turmeric. Cook for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tinned tomatoes and cook for 5 minutes until reduced. Add the blended spinach and stir to combine. Cook for 3 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the fried paneer and fold gently. Stir in the cream if using. Simmer for 3 to 4 minutes until the paneer is heated through. Season with salt."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Paneer sticks to the pan and breaks apart",
              "cause": "Pan not hot enough before the paneer went in, or pan not non-stick",
              "fix": "Heat the oil until very hot before adding the paneer. Do not move the pieces for 1 to 2 minutes; they will release naturally once a crust has formed."
            },
            {
              "symptom": "Sauce is too thin",
              "cause": "Spinach not squeezed dry before blending",
              "fix": "Always squeeze the blanched spinach as dry as possible before blending. Wet spinach dilutes the sauce significantly."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Saag paneer is one of the most widely eaten vegetarian dishes in British Indian restaurants, alongside chana masala and aloo gobi. The dish comes from Punjabi home cooking and is eaten across north India. Paneer itself was popularised in Britain through the curry-house tradition and is now sold in most major supermarkets."
          }
        ]
      }
    ]
