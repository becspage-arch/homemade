        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Cook the pasta"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook the {{pasta-dried}} of pasta in well-salted boiling water for two minutes less than the packet says. It will finish cooking in the oven. Drain and set aside."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the cheese sauce"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt {{unsalted-butter}} of butter in a medium saucepan over medium heat. Add {{plain-flour}} of flour and stir for 2 minutes to cook the roux."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in {{whole-milk}} of milk a little at a time, whisking after each addition. Continue until all the milk is incorporated and the sauce is smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook over medium heat, stirring constantly, until the sauce thickens and coats the back of a spoon, about 5 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Take the pan off the heat. Stir in {{cheddar}} of grated cheddar, {{mustard-powder}} of mustard powder, and a grating of nutmeg. Season generously with salt and pepper. The sauce should taste distinctly cheesy."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Assemble and bake"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 200°C."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir the drained pasta into the cheese sauce."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour into the pie dish or baking dish."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the breadcrumbs with the extra grated cheddar for the topping. Scatter evenly over the pasta."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 20 minutes until the top is golden and crisp. Leave to rest for 5 minutes before serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Sauce is lumpy",
              "cause": "Milk added too fast without whisking",
              "fix": "Add the milk in small additions and whisk thoroughly after each one. If lumps form, push the sauce through a sieve and return to the pan."
            },
            {
              "symptom": "Pasta is dry and stiff after baking",
              "cause": "Pasta cooked fully before going in, or too little sauce",
              "fix": "Undercook the pasta by 2 minutes and use the full amount of sauce in the recipe. The pasta absorbs sauce as it finishes in the oven."
            },
            {
              "symptom": "Topping is pale after 20 minutes",
              "cause": "Oven not hot enough, or breadcrumbs were too fine",
              "fix": "Increase the oven to 210°C for the last 5 minutes, or finish under a hot grill for 2 to 3 minutes."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Baked pasta with cheese sauce has appeared in British cookbooks since the nineteenth century. The British version settled on mature cheddar rather than the Parmesan of Italian pasta al forno, which gives it a sharper, more savoury edge. Macaroni cheese became a standard school-dinner and canteen dish in the twentieth century, with the result that most people's first version came from a packet mix. Made from scratch it is a better dish: the sauce stays glossy, the cheese flavour is clean, and the breadcrumb top crackles."
          }
        ]
      }
    ]
  }
}