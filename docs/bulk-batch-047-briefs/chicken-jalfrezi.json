      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large frying pan over high heat until the oil is very hot and just starting to smoke."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the {{chicken-breast}} of chicken strips. Do not stir for the first minute: let them begin to colour. Then stir and cook for 2 to 3 more minutes until lightly browned."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the onion, peppers, and green chillies. Cook, stirring frequently, for 4 minutes over high heat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic, ginger, garam masala, cumin, and turmeric. Cook for 2 minutes, stirring constantly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add {{tinned-tomatoes}} of tinned tomatoes. Stir through and cook over high heat for 4 to 5 minutes until the tomatoes have broken down and the sauce clings to the chicken. Season with salt, scatter with coriander, and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Chicken is dry and stringy",
              "cause": "Breast cooked for too long at high heat",
              "fix": "Chicken breast needs no more than 5 to 6 minutes total. It finishes cooking in the sauce. Do not add more tomatoes to compensate; that just makes it wetter."
            },
            {
              "symptom": "Sauce is too wet and the vegetables are soft",
              "cause": "Heat too low, or too much liquid added",
              "fix": "Jalfrezi is a high-heat dish. Keep the pan very hot throughout. Do not add water or stock. If the sauce looks too wet, raise the heat and stir rapidly for 2 minutes."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Jalfrezi developed in Bengal as a way of using leftover roasted meat, stir-fried with onion, chilli, and spice. British curry houses adapted it into a fresh chicken dish, adding peppers as the characteristic British restaurant touch. It became one of the most ordered curries in Britain in the 1990s and remains in the top five alongside tikka masala and korma. Its appeal is speed and a slightly charred, restaurant-style character that is harder to achieve at home in a small domestic frying pan."
          }
        ]
      }
    ]
