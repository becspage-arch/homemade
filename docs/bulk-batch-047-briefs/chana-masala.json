      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large saucepan over medium heat. Add the onion and cook for 10 minutes until golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic, ginger, cumin, coriander, turmeric, and chilli powder. Cook for 2 minutes, stirring constantly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add {{tinned-tomatoes}} of tinned chopped tomatoes and 100 ml of water. Simmer for 8 minutes until the sauce has reduced and thickened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add {{chickpeas-tinned}} of drained chickpeas and the amchur powder. Stir to coat the chickpeas in the sauce. Simmer for 8 to 10 minutes until the chickpeas are heated through and the sauce clings to them."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the garam masala and season with salt. Taste: the sauce should be tangy, spiced, and savoury. If it needs more tartness, add more amchur or a squeeze of lemon juice."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve with rice or bread, scattered with fresh coriander."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Sauce is too wet and does not cling to the chickpeas",
              "cause": "Not reduced enough after the tomatoes went in",
              "fix": "Simmer the sauce without the chickpeas until it is very thick before adding them. The chickpeas give off no liquid, so the sauce needs to be right before they go in."
            },
            {
              "symptom": "Amchur is unavailable",
              "cause": null,
              "fix": "Use 1 tablespoon of lemon juice added at the end. It gives tartness but not the same fruity note; increase the garam masala slightly to compensate."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chana masala is a Punjabi street and home dish that became embedded in British Asian cooking and curry-house menus. It is one of the most widely eaten vegetarian dishes in Britain after salads and pasta. The tinned chickpea version is a British shortcut that works well; the traditional version uses dried chickpeas soaked and cooked from scratch, which gives a creamier, more textured result but takes considerably longer."
          }
        ]
      }
    ]
  }
