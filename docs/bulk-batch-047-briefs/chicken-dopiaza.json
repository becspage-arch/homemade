      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the curry base"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat 3 tablespoons of oil in a large saucepan over medium heat. Add the cardamom pods and fry for 30 seconds. Add the 2 finely chopped onions and cook for 10 minutes until golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic, ginger, garam masala, ground coriander, cumin, turmeric, and chilli powder. Cook for 2 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add {{tinned-tomatoes}} of tinned tomatoes. Simmer for 8 minutes until reduced and thick."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the {{chicken-thigh}} of chicken pieces."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir to coat."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add 150 ml of water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover and simmer for 20 minutes until the chicken is cooked through."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Add the second onion"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "While the chicken cooks, heat the remaining oil in a small frying pan over medium-high heat. Add the sliced onion and cook for 10 to 12 minutes until golden and starting to caramelise."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fold the caramelised onion slices into the chicken curry for the last 5 minutes of cooking. Season with salt, scatter with coriander, and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Second-stage onion is soft and indistinct in the dish",
              "cause": "Onion added too early and overcooked in the sauce",
              "fix": "Add the caramelised onion only in the last 5 minutes. It should retain its sliced texture rather than dissolving into the sauce."
            },
            {
              "symptom": "Sauce is thin",
              "cause": "Tomatoes not reduced enough before the chicken went in",
              "fix": "Reduce the tomato sauce until it is very thick and pulling away from the sides of the pan before adding the chicken."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dopiaza is a Mughal-origin technique that became a standard dish in British curry houses from the 1970s. It is less popular than tikka masala or korma. People who like its sweetness and soft texture tend to order it regularly. It is one of the few curry-house dishes where the cooking method, not the main ingredient, defines the dish."
          }
        ]
      }
    ]
  }
