    {
      "slug": "dopiaza",
      "term": "Dopiaza",
      "definition": "Urdu for double onion (do = two, piaz = onion). A dish where onion is used at two stages of cooking: finely chopped at the start for the sauce base, and added whole or halved at the end so the pieces hold their texture."
    }
  ],
