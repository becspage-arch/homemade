    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chicken "
          },
          {
            "type": "text",
            "text": "dopiaza",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dopiaza"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " uses onion twice. The first addition is finely chopped and cooked to a soft, sweet base for the sauce. The second addition is sliced and caramelised separately, then folded in near the end to add sweetness and texture. The result has more depth than a straightforward curry sauce."
          }
        ]
      },
