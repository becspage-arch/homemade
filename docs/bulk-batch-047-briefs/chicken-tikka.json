      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix all the marinade ingredients together. Add the {{chicken-thigh}} of chicken pieces and toss to coat. Cover and refrigerate for at least 2 hours."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "If using wooden skewers, soak them in water for 30 minutes to prevent burning. Thread the marinated chicken onto skewers, 3 to 4 pieces per skewer."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat a griddle pan or grill to high. Cook the skewers for 5 to 6 minutes per side until charred in patches and cooked through. Do not move them in the first 2 minutes: the marinade needs to set before the chicken releases from the grill."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Rest for 5 minutes. Serve with raw sliced onion and lemon wedges."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Chicken sticks to the griddle",
              "cause": "Not hot enough when the chicken went on, or moved too soon",
              "fix": "Heat the griddle until very hot. Leave the chicken undisturbed for 2 full minutes before attempting to turn it. It will release once a crust forms."
            },
            {
              "symptom": "Yogurt marinade is pale and does not colour",
              "cause": "Not enough Kashmiri chilli, or grill not hot enough",
              "fix": "The Kashmiri chilli gives colour as much as heat. If unavailable, use sweet paprika plus a small amount of regular chilli. The grill must be fully preheated."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chicken tikka is the dry version of the preparation that becomes chicken tikka masala when a sauce is added. It is served as a starter or side in British curry restaurants. The marinating technique comes from Mughal-era tandoor cooking. The British curry-house version is simpler and a little hotter than the original."
          }
        ]
      }
    ]
  }
