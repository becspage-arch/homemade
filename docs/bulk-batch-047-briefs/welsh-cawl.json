      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Day one: cook the lamb"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put the {{lamb-neck}} of lamb neck chops in a large saucepan with the halved onion, thyme, and bay leaves. Cover with {{stock-lamb}} of stock or water. Bring slowly to a simmer, skimming off grey foam thoroughly in the first 15 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer gently for 1.5 to 2 hours until the lamb is very tender. Lift the chops out and set aside to cool. Discard the onion halves, thyme, and bay leaves. Pour the broth into a bowl and refrigerate overnight."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Day two: cook the vegetables"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lift the hardened fat from the surface of the cold broth and discard it. Pull the lamb meat from the bones and shred it. Discard the bones."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the skimmed broth back into the saucepan and bring to a simmer. Add the carrot, parsnip, and swede. Cook for 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the potato and cook for a further 15 minutes until it is just tender."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the leek and shredded lamb. Simmer for 5 minutes until the leek is just tender and the lamb is heated through. Season generously."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve in deep bowls with parsley scattered over and crusty bread."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Broth is greasy",
              "cause": "Fat not skimmed thoroughly overnight",
              "fix": "If making in one day, skim frequently during the lamb-simmering stage and use kitchen paper to blot the surface of the broth before serving."
            },
            {
              "symptom": "Vegetables are mushy",
              "cause": "Added all at once and cooked for too long",
              "fix": "Add vegetables in order of how long they need: root vegetables first (20 minutes), potato next (15 minutes), leeks last (5 minutes)."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cawl is the national dish of Wales. It is linked to St David's Day on 1 March, but eaten throughout winter. Welsh cookbooks from the nineteenth century include it, but the tradition is much older. The two-day method removes the fat cleanly. It also reflects the old way of cooking: slow, practical, using what was available."
          }
        ]
      }
    ]
  }
