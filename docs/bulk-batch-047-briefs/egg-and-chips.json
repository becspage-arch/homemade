              "amount": null,
              "unit": "splash",
              "prepNote": "to serve",
              "isOptional": true,
              "groupLabel": null
            }
          ]
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A large baking tray and a frying pan wide enough to hold four eggs without crowding."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Cook the chips"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 220°C. Cut {{potato}} of potato into chips about 1 cm thick. Toss on a baking tray with {{sunflower-oil}} of sunflower oil and a pinch of salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Spread in a single layer. Roast for 25 to 30 minutes, turning once halfway through, until golden and crisp at the edges."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Fry the eggs"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "About 4 minutes before the chips are done, heat {{olive-oil}} of olive oil in a frying pan over medium heat until shimmering."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Crack {{eggs}} eggs into the pan. Cook for 2 to 3 minutes until the whites are set but the yolks are still runny. Baste the yolks with a little of the hot oil if you like."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Serve"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pile the chips onto warm plates. Lay the fried eggs on top. Season and shake over a little malt vinegar if you like it."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Chips are soft and pale",
              "cause": "Oven not hot enough or chips were too close together on the tray",
              "fix": "Make sure the oven is fully preheated to 220°C and the chips are in a single layer with space between them."
            },
            {
              "symptom": "Egg whites are still runny",
              "cause": "Pan not hot enough or lid not used",
              "fix": "If the whites are slow to set, place a lid on the pan for 30 seconds. The steam sets the whites without hardening the yolks."
            },
            {
              "symptom": "Egg yolks break during cooking",
              "cause": "Eggs cracked from too high above the pan",
              "fix": "Crack each egg into a small cup first, then tip gently into the pan close to the surface."
            },
            {
              "symptom": "Chips stick to the tray",
              "cause": "Not enough oil or tray not preheated",
              "fix": "Use a generous amount of oil and toss the chips well before roasting. Preheat the tray for 5 minutes first for crispier results."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Egg and chips is one of the most common quick meals in Britain. It turns up at home for a weeknight supper and on nearly every transport-cafe menu. Its simplicity is the point. The combination of fried egg and potato appears across many food cultures. The British version, with malt vinegar and ketchup on the side, is its own thing: informal, filling, and without pretension."
          }
        ]
      }
    ]
  }
}