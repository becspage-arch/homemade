  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Egg and chips is fried eggs with oven chips: simple, cheap, and fast enough for a weeknight. The chips go into a hot oven first; the eggs take three minutes in a frying pan and land on the plate at the same time."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 2,
          "items": [
            {
              "ingredientSlug": "potato",
              "amount": 600,
              "unit": "g",
              "prepNote": "floury variety, cut into thick chips about 1 cm wide",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "eggs",
              "amount": 4,
              "unit": "each",
              "prepNote": null,
