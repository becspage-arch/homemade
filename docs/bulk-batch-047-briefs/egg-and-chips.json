              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "olive-oil",
              "amount": 15,
              "unit": "ml",
              "prepNote": "for the frying pan",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "sea-salt-fine",
              "amount": null,
              "unit": "pinch",
              "prepNote": "to taste",
              "isOptional": false,
