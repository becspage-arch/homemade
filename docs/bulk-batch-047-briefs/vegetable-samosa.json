      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the dough and filling"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix {{plain-flour}} of flour, salt, and {{rapeseed-oil}} of oil in a bowl. Add cold water a little at a time, mixing until a stiff dough comes together. Knead for 3 minutes until smooth. Cover and rest for 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For the filling: fry the onion in oil over medium heat for 5 minutes until soft. Add the garlic, ginger, garam masala, cumin, and chilli powder. Cook for 1 minute. Remove from the heat, then add the mashed {{potato}} of potato and {{peas-frozen}} of peas. Mix well and season generously with salt. Cool completely before filling the samosas."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Fold and fry"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide the dough into 6 balls. Roll each ball into a thin circle about 20 cm in diameter. Cut each circle in half. Take one semicircle and form a cone by folding the straight edge into a cone shape, pressing the edge to seal with a little water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fill the cone two-thirds full with the potato filling. Fold the open top edge over and press firmly to seal. The finished samosa is a triangle. Repeat with the remaining dough and filling."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil to 170°C. Fry the samosas in batches of 3 to 4 for 4 to 5 minutes, turning once, until golden and crisp. Drain on kitchen paper. Serve with mango chutney or raita."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Samosas burst open during frying",
              "cause": "Seams not pressed firmly, or filling too wet",
              "fix": "Press the pastry seams very firmly and moisten with a little water before pressing. The filling must be cool and dry; a warm or wet filling steams from inside and forces the seams open."
            },
            {
              "symptom": "Pastry is pale and soft rather than crisp",
              "cause": "Oil temperature too low",
              "fix": "Heat the oil to exactly 170°C and check it before each batch. If the oil is too cool, the samosas absorb oil and turn soft."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Samosas are one of the most popular snacks in British Indian restaurants and takeaways. They are also sold at Asian grocers, markets, and sports grounds across the country. The potato and pea filling is the British curry-house standard. In South Asia and Central Asia, samosas come with many other fillings: minced meat, lentils, and various vegetables."
          }
        ]
      }
    ]
  }
