      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the stew"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 150°C. Dust the {{beef-chuck}} of beef pieces in the plain flour with salt and pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large frying pan over high heat. Brown the beef in batches until dark on all surfaces, 2 to 3 minutes per side. Transfer to the casserole dish."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lower the heat to medium. Add the onion, carrot, parsnip, and celery to the pan and cook in the residual fat for 6 minutes. Add the garlic, tomato purée, and Worcestershire sauce and cook for another minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in {{stock-beef}} of beef stock and bring to a simmer. Pour over the beef in the casserole dish. Add the thyme and bay leaves. Cover tightly and cook in the oven for 2 to 2.5 hours until the beef is tender."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make and cook the dumplings"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine {{self-raising-flour}} of self-raising flour, {{suet-shredded}} of shredded suet, thyme leaves, and salt in a bowl. Add cold water a little at a time, mixing with a fork until the mixture just comes together into a soft dough. Do not overwork it."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Divide into 8 equal balls. Remove the casserole from the oven. Remove the thyme sprigs and bay leaves, and taste and season the gravy."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Raise the oven to 180°C. Place the dumplings on top of the stew, leaving space between them. Return to the oven uncovered for 20 to 25 minutes until the dumplings have puffed and the tops are lightly golden."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Dumplings are dense and stodgy",
              "cause": "Overworked dough, or not enough liquid",
              "fix": "Mix the dumpling dough as little as possible once the water goes in. The mixture should be just cohesive. It is wetter than a pastry dough."
            },
            {
              "symptom": "Dumplings do not puff",
              "cause": "Old self-raising flour with expired leavening",
              "fix": "Check the date on the self-raising flour. As a test: drop a pinch into a glass of warm water; it should bubble up immediately if it is still active."
            },
            {
              "symptom": "Stew is thin",
              "cause": "The lid was left on during the final cooking",
              "fix": "Remove the lid for the last 20 minutes (when the dumplings go on). The uncovered cooking reduces and thickens the gravy."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Suet dumplings in a meat stew is one of the oldest British cooking combinations. It was a way to stretch a small amount of meat into a filling meal by adding filling starch that cooked in the same pot. The dumpling softens and absorbs the flavour of whatever it sits in, which makes it inseparable from the dish: a beef stew dumpling tastes of beef. It remains one of the best things about British winter cooking."
          }
        ]
      }
    ]
  }
}