      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Marinate and grill the chicken"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the yogurt, lemon juice, grated garlic, grated ginger, garam masala, paprika, and cumin together in a large bowl. Add the {{chicken-thigh}} of chicken pieces and toss to coat. Cover and refrigerate for at least 2 hours, or overnight."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "When ready to cook, heat a griddle pan or grill to high. Thread the chicken pieces onto skewers or lay directly on the griddle. Cook for 4 to 5 minutes per side until charred in places and cooked through. Set aside."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the sauce"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large saucepan over medium heat. Add the onion and cook for 10 minutes until golden. Add the garlic, ginger, garam masala, ground coriander, cumin, and paprika. Cook for 2 minutes, stirring constantly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add {{tinned-tomatoes}} of tinned tomatoes. Simmer for 10 minutes until the sauce has reduced and thickened. Use a blender or stick blender to puree the sauce until smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Return the smooth sauce to the pan. Stir in {{double-cream}} of double cream and the grilled chicken pieces. Simmer for 5 minutes until the chicken is heated through and the sauce coats it. Season with salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Serve with rice and scatter fresh coriander over the top."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Sauce is too thin",
              "cause": "Tomatoes not reduced enough before blending",
              "fix": "After blending, return the sauce to medium heat and simmer uncovered, stirring often, until it thickens. It should coat the back of a spoon."
            },
            {
              "symptom": "Chicken is dry and tough",
              "cause": "Breast meat used instead of thigh, or overcooked on the griddle",
              "fix": "Thighs stay moist much better than breast. Do not cook the chicken for longer than 5 minutes per side; it will cook further in the sauce."
            },
            {
              "symptom": "Sauce lacks depth and tastes flat",
              "cause": "Spices not fried long enough, or onion undercooked",
              "fix": "Cook the onion until it is genuinely golden (8 to 10 minutes minimum) and the spices until they smell fragrant (2 full minutes). Shortcutting either step makes a flat sauce."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chicken tikka masala is a British curry-house invention. The tikka comes from the tandoor tradition: marinated chicken cooked at very high heat. The masala sauce was made in British restaurant kitchens to suit a British taste for sauced dishes. It became the best-selling curry in Britain from the 1980s and has since spread worldwide."
          }
        ]
      }
    ]
  }
