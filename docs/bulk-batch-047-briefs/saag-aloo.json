      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Parboil the {{potato}} of potato cubes in salted water for 5 minutes until just beginning to give when pressed. Drain and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wide frying pan over medium-high heat. Add the cumin seeds and fry for 30 seconds. Add the onion and cook for 8 minutes until golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic, ginger, turmeric, ground coriander, and chilli powder. Stir for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the par-cooked potato. Toss to coat in the spiced onion. Cook over medium heat for 6 to 8 minutes, turning occasionally, until the potato is cooked through and taking a little colour at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add {{spinach}} of spinach in handfuls. Stir each handful in until it wilts before adding the next. Once all the spinach is wilted and any excess liquid has evaporated, taste and season with salt."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Potato falls apart in the pan",
              "cause": "Parboiled for too long, or a floury variety used",
              "fix": "Parboil for 5 minutes only, until just starting to give when pressed with a knife tip. Use a waxy variety that holds its shape."
            },
            {
              "symptom": "Spinach releases a lot of water and the dish becomes watery",
              "cause": "Pan not hot enough when the spinach went in",
              "fix": "Increase the heat to medium-high before adding the spinach. The water will evaporate quickly if the pan is hot enough."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Saag aloo is one of the most common side dishes in British curry houses. Spiced potato with greens is cooked in many forms across north India and Pakistan. The British restaurant version uses spinach instead of the traditional mustard greens. Spinach is more widely available and has a milder taste."
          }
        ]
      }
    ]
  }
