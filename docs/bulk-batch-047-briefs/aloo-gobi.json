      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a wide frying pan over medium-high heat. Add the cumin seeds. When they begin to splutter (about 30 seconds), add the onion. Cook for 7 minutes until lightly golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic, ginger, turmeric, ground coriander, and chilli powder. Stir for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the {{potato}} of potato cubes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir to coat in the spiced oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add 2 tablespoons of water."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover with a lid and cook for 8 minutes, stirring once halfway through."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the {{cauliflower}} of cauliflower florets. Stir, cover, and cook for a further 8 to 10 minutes until both potato and cauliflower are tender and beginning to caramelise at the edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the lid. Raise the heat to high and cook uncovered for 2 minutes, turning gently, to caramelise any pale edges. Add the garam masala, taste and season. Scatter with fresh coriander and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Vegetables are still hard after 15 minutes",
              "cause": "Pan not tight-lidded, or heat too low to generate steam",
              "fix": "Use a tight-fitting lid. If the lid does not fit well, cover with foil before putting the lid on. Keep the heat at medium so steam builds up quickly."
            },
            {
              "symptom": "Vegetables are mushy and falling apart",
              "cause": "Too much water added, or cooked for too long",
              "fix": "Use only 2 tablespoons of water. The steam does the cooking; more liquid makes it stew rather than dry-cook."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Aloo gobi is a staple of north Indian and Pakistani home cooking and a standard side dish in British curry restaurants. The version in curry houses is often softer and more sauced than the dry home version; the home version has more character. It is the kind of dish that is almost never ordered as a main in restaurants but is the best thing on the table when it is part of a spread."
          }
        ]
      }
    ]
  }
