      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 160°C. Heat the oil in a large casserole over high heat. Brown the {{lamb-shoulder}} of lamb pieces in batches, 2 to 3 minutes per side. Remove and set aside."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lower the heat to medium. Add the cardamom, cloves, cinnamon, and bay leaves to the oil. Fry for 30 seconds. Add the onion and cook for 12 minutes until golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic and ginger. Cook for 2 minutes. Add the Kashmiri chilli powder, ground coriander, and ground cumin. Stir for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the yogurt a tablespoon at a time, stirring after each addition until absorbed. Return the lamb and any resting juices to the pan. Add 200 ml of water and stir to combine."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cover tightly and transfer to the oven. Cook for 1.5 to 2 hours until the lamb is very tender. Remove the lid for the last 20 minutes to reduce and deepen the sauce."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the garam masala. Taste and season. Serve with rice or bread, scattered with fresh coriander."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Sauce is too thin",
              "cause": "Lid kept on throughout, not enough evaporation",
              "fix": "Remove the lid for the final 20 minutes. The sauce should reduce to coat the lamb rather than pool around it."
            },
            {
              "symptom": "Sauce is not red enough",
              "cause": "Kashmiri chilli powder not available; regular chilli used instead",
              "fix": "Use 1.5 tablespoons of sweet paprika plus 0.5 teaspoon of cayenne. This gives colour close to Kashmiri chilli."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rogan josh is from Kashmir and part of the Wazwan feast tradition. It came to Britain in the 1960s through the curry-house trade and became part of the standard restaurant menu. The British version stays closer to the Mughal original than tikka masala or korma. It relies on whole spices and slow braising, not cream and tomato sauce."
          }
        ]
      }
    ]
  }
