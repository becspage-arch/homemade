      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil the {{potato}} of potato cubes in salted water for 6 minutes until just starting to give when pierced. Drain and set aside to steam dry."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large frying pan over medium-high heat. Add the mustard seeds and curry leaves. Stand back: the mustard seeds will pop. Fry for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the onion and cook for 6 minutes until golden. Add the garlic, turmeric, cumin, and chilli powder. Cook for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the tinned tomatoes and cook for 4 minutes until the sauce has reduced and thickened."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the par-cooked potatoes and toss to coat. Press them gently against the pan to encourage crisping. Cook over medium-high heat for 5 to 6 minutes, turning occasionally, until the potatoes have golden, slightly charred edges."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garam masala and season with salt. Scatter with fresh coriander and serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Potatoes are soft all the way through with no crust",
              "cause": "Pan not hot enough, or potatoes over-boiled so they fall apart",
              "fix": "The pan needs to be very hot when the potatoes go in. Par-boil for 6 minutes only; the potatoes should still hold their shape firmly when lifted."
            },
            {
              "symptom": "Mustard seeds do not pop",
              "cause": "Oil not hot enough when seeds went in",
              "fix": "The oil must be properly hot before the seeds are added. Test with a single seed: it should pop within 5 seconds."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Bombay potatoes have been a British Indian restaurant side dish for half a century. The dish has roots in Maharashtrian batata bhaji but has evolved in British curry houses into a simpler, tomato-based preparation. They are almost always served as a side, but a large portion with raita and bread makes a light vegetarian meal."
          }
        ]
      }
    ]
  }
