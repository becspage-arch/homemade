      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Brown the lamb"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large frying pan over high heat. Add the {{lamb-mince}} of lamb mince and press it flat. Leave for 2 to 3 minutes without touching it, until a brown crust forms."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Break the mince up and cook for another 3 to 4 minutes, stirring, until browned all over. Tip the browned mince into a bowl. Pour off most of the fat from the pan, leaving about a tablespoon."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Build the filling"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce the heat to medium. Add the {{onion}} finely chopped onions and {{carrot}} diced carrots to the pan. Cook for 8 minutes until softened. Add {{garlic}} of crushed garlic and the chopped rosemary leaves. Cook for one minute more."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in {{tomato-puree}} of tomato purée and cook for 2 minutes. Return the lamb to the pan. Pour in {{stock-beef}} of stock and add {{worcestershire-sauce}} of Worcestershire sauce."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Simmer uncovered for 20 minutes, stirring now and then, until the gravy is thick and the lamb is tender. Season well."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the mash and bake"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Boil the {{potato}} of potato in salted water until tender, about 16 minutes. Drain, steam-dry for a minute, then mash with {{unsalted-butter}} of butter and {{whole-milk}} of warm milk. Season well."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 190°C. Spoon the filling into the pie dish. Spread the mash over the top, roughing up the surface with a fork."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 25 to 30 minutes until the top is golden and the edges bubble. Rest for 5 minutes before serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Filling is too fatty",
              "cause": "Lamb mince can be high in fat; it released into the filling",
              "fix": "After browning, tip the mince into a bowl and pour off the excess fat. Only return the mince to the pan, not the fat."
            },
            {
              "symptom": "The lamb flavour is too strong",
              "cause": "A higher-fat lamb mince or older mutton mince was used",
              "fix": "This is a feature of the dish, but a 20% fat lamb mince is milder. Rinsing with cold water before browning reduces gaminess but also flavour."
            },
            {
              "symptom": "Topping slides off when serving",
              "cause": "The filling was too loose when the mash went on",
              "fix": "Simmer the filling for longer so it is quite thick before topping. The mash should sit on a firm base."
            },
            {
              "symptom": "Rosemary flavour is too dominant",
              "cause": "Leaves not chopped finely enough, or too many added",
              "fix": "Chop rosemary leaves very finely so they melt into the sauce. Two small sprigs is the right amount for four servings."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The name 'shepherd's pie' appeared in British recipe books in the 1870s, always with lamb or mutton, always with a potato lid. The lamb-versus-beef distinction is one of those British food rules that people defend with surprising firmness. As a Monday-night supper after a Sunday roast, it served as a way to use leftover roast lamb with a mashed-potato topping that stretched the meal to a second evening. Today it is made more often with raw mince, which gives a better, more consistent result than leftovers."
          }
        ]
      }
    ]
  }
