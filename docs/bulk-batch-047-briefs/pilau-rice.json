  "glossaryTerms": [
    {
      "slug": "absorption-method",
      "term": "Absorption method",
      "definition": "A rice-cooking technique where rice is added to a measured quantity of liquid and cooked with a tight lid until all the liquid is absorbed. The ratio is typically one part rice to 1.5 parts water or stock."
    }
  ],
  "techniqueSlugs": [],
