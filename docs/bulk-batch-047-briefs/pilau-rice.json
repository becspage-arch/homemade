      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the butter in a medium saucepan over medium heat. Add the cardamom, cinnamon, cloves, and bay leaf. Fry for 1 minute until fragrant."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the onion and cook for 6 to 8 minutes until golden. Add the turmeric and stir for 30 seconds."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the {{basmati-rice}} of rinsed rice and stir to coat in the spiced butter for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in {{stock-chicken}} of stock or water and add the salt. Bring to a boil, then reduce the heat to its lowest setting. Cover tightly with a lid and cook for 12 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove from the heat with the lid on. Leave to steam for 10 minutes. Do not lift the lid during either the cooking or the resting time. The steam is finishing the rice."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Fluff with a fork. Remove the whole spices before serving or warn guests to avoid them."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Rice is sticky and clumped",
              "cause": "Not rinsed, or too much liquid used",
              "fix": "Rinse the rice under cold water until the water runs clear before cooking. Use exactly 1.8 parts liquid to 1 part rice by volume."
            },
            {
              "symptom": "Rice has a raw centre after 12 minutes",
              "cause": "Lid lifted during cooking, releasing the steam",
              "fix": "Do not lift the lid at any point during cooking or resting. The steam is what finishes the grains."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pilau rice is the standard rice accompaniment in British curry houses, served alongside or as part of a main meal. The British version is simpler than Indian biryani (which also contains meat or vegetables) but shares the same absorption technique and spicing principles. Pilau replaced plain boiled rice in British curry restaurants during the 1970s and is now the default."
          }
        ]
      }
    ]
  }
