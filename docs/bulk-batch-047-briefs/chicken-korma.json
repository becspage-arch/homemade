      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oil in a large saucepan over medium heat. Add the cardamom pods and cinnamon stick and fry for 30 seconds until fragrant. Add the onion and cook for 10 minutes until golden."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the garlic, ginger, garam masala, ground coriander, and cumin. Cook for 2 minutes, stirring constantly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the {{chicken-thigh}} of chicken pieces. Stir to coat in the spiced onion. Cook for 3 minutes, turning the pieces occasionally."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in {{plain-yoghurt}} of yogurt a tablespoon at a time, waiting for each addition to be absorbed before adding the next. This prevents the yogurt from curdling."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in {{coconut-milk}} of coconut milk and add {{ground-almonds}} of ground almonds. Stir to combine. Bring to a gentle simmer and cook uncovered for 20 to 25 minutes until the chicken is tender and the sauce has thickened. Season with salt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Remove the cardamom pods and cinnamon stick before serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Yogurt curdles into white lumps",
              "cause": "Added too quickly to a hot pan",
              "fix": "Add the yogurt a tablespoon at a time, stirring after each addition and waiting for it to fully incorporate before adding the next spoon."
            },
            {
              "symptom": "Sauce is too thin",
              "cause": "Coconut milk not reduced sufficiently",
              "fix": "Simmer uncovered for longer, stirring frequently. The ground almonds thicken the sauce as it reduces."
            },
            {
              "symptom": "Dish tastes bland",
              "cause": "Onion not cooked long enough, or spices added without being fried",
              "fix": "The onion needs to be truly golden (10 full minutes). The spices need to fry in the onion for at least 2 minutes before liquid goes in."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Korma is a Mughal technique that was adapted in British curry houses into a mild, creamy style intended for diners who preferred gentle flavours. It became one of the most ordered curries in Britain alongside tikka masala and bhuna. The coconut milk version is a British restaurant invention; the Mughal original used reduced cream and sometimes cashew paste. Both produce a dish that is deliberately mild, fragrant, and satisfying."
          }
        ]
      }
    ]
  }
