      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Prepare the oven and tray"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 210°C conventional. This is slightly lower than a standard scone recipe because spelt browns faster than white flour. Line a baking tray with baking paper."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Rub in the butter"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Put the wholegrain "
                  },
                  {
                    "type": "text",
                    "text": "spelt flour",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "spelt-flour"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ", baking powder, and salt into a large mixing bowl. Stir to combine."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cold cubed butter and use the "
                  },
                  {
                    "type": "text",
                    "text": "rubbing-in",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "rubbing-in"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " method: lift small amounts of the mixture and rub between your thumbs and fingers, letting it fall back into the bowl. Continue until the mixture resembles coarse breadcrumbs. Work quickly to keep the butter cold."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Mix the wet into the dry"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk the honey, milk, and beaten egg together in a small jug until the honey is fully dissolved."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the liquid into the flour mixture. Use a table knife or silicone spatula to bring the dough together with short cutting strokes. The dough will feel softer and slightly stickier than a white-flour scone dough; this is correct for spelt."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stop as soon as no dry flour remains. Do not add more flour and do not knead."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Shape and cut"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dust a surface lightly with spelt flour and turn out the dough. Pat gently to 2.5 cm thick. The dough may stick slightly; use a bench scraper or palette knife to lift it if needed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dip a 5 cm round cutter in flour and press straight down without twisting. Place the cut scones on the lined tray. Gather the scraps, pat together once, and cut again."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Brush the tops with a little extra beaten egg or milk. The honey in the dough means these scones will brown faster than plain ones, so watch closely in the final few minutes."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bake"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake on the middle shelf for 12 to 14 minutes, until the tops are deep golden and the scones sound hollow when tapped on the base."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to a cooling rack straight away. The crumb will be slightly denser than a white-flour scone; this is the nature of wholegrain spelt."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Scones are too dense",
              "avoid": "Avoid adding extra flour when the dough feels sticky. Spelt absorbs liquid at a slower rate than white flour; adding more flour will dry the crumb out further."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Tops browned too quickly",
              "avoid": "Avoid baking spelt scones at the same temperature as plain flour scones. The honey and bran in wholegrain spelt cause faster browning; 210°C is the correct temperature."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Scones did not rise",
              "avoid": "Avoid twisting the cutter when stamping; press straight down and lift cleanly. Also check that the baking powder is within its use-by date."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Honey did not incorporate",
              "avoid": "Avoid adding honey directly to the dry flour; it will clump. Always dissolve it in the milk and egg first."
            }
          }
        ]
      }
    ]
  }
}