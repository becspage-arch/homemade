    {
      "slug": "rubbing-in",
      "term": "Rubbing in",
      "definition": "A technique for combining cold butter with flour by pressing and rubbing the fat between the fingers until the mixture resembles coarse breadcrumbs. The process coats flour particles with fat, which inhibits gluten development and produces a short, tender texture in scones, pastry, and crumble."
    },
    {
      "slug": "spelt-flour",
      "term": "Spelt flour",
      "definition": "A flour milled from spelt, an ancient relative of wheat. Spelt has a nuttier flavour than modern wheat and a more fragile gluten structure, which makes it absorbent and liable to over-prove quickly."
    }
  ],
