      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Prepare the oven and tray"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 220°C conventional. Line a baking tray with baking paper."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Rub in the butter"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Combine the self-raising flour, "
                  },
                  {
                    "type": "text",
                    "text": "rolled oats",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "rolled-oats"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ", baking powder, salt, and brown sugar in a large mixing bowl. Stir briefly with a fork to distribute evenly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cold cubed butter. Use the "
                  },
                  {
                    "type": "text",
                    "text": "rubbing-in",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "rubbing-in"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " method: lift small handfuls of the flour and butter mixture and rub between your thumbs and fingers, letting it drop back into the bowl. Continue until the mixture resembles coarse, slightly damp breadcrumbs. Work quickly to keep the butter cold."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the chopped pecans so they are evenly distributed through the dry mixture."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Mix the wet into the dry"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the buttermilk into the bowl. Use a table knife or silicone spatula to bring the dough together with short cutting strokes. The oats will absorb liquid quickly; the dough will look stiffer and slightly rougher than a plain scone dough. This is correct."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stop mixing as soon as no dry flour remains. Do not knead."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Shape and cut"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Turn the dough onto a lightly floured surface. Pat gently to a thickness of 2.5 cm. The dough will feel firm; do not add extra flour or liquid."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dip a 5 cm round cutter in flour and press straight down without twisting. Place the cut scones on the lined tray. Gather the scraps, pat together once, and cut again."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Brush the tops with milk. Keep the glaze on the top surface only."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bake"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake on the middle shelf for 12 to 14 minutes, until the tops are deep golden and the scones sound hollow when tapped on the base."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to a cooling rack immediately. The oats in the crust will firm up slightly as the scones cool."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Scones spread flat instead of rising",
              "avoid": "Avoid adding extra milk when the dough feels stiff. The oats absorb liquid; a stiffer dough is correct for this recipe."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Scones did not rise",
              "avoid": "Avoid twisting the cutter when stamping out shapes. Press straight down and lift cleanly; twisting seals the cut edge and blocks rise."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Pecans sank to the bottom",
              "avoid": "Avoid adding the pecans after the butter is rubbed in but before the flour is fully coated. Stir them through the dry mixture first so they are distributed evenly before liquid is added."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Scones are tough",
              "avoid": "Avoid overworking the dough. Mix until the dry flour just disappears, then stop."
            }
          }
        ]
      }
    ]
  }
}