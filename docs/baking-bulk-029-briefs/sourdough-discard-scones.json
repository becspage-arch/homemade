              "isOptional": false
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Prepare the oven and tray"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 220°C conventional. Line a baking tray with baking paper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Take the "
                  },
                  {
                    "type": "text",
                    "text": "sourdough discard",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "sourdough-discard"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " and buttermilk out of the fridge now if you have not already. They need to reach room temperature before use."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Rub in the butter"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Sift the self-raising flour, baking powder, and salt into a large mixing bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cold cubed butter. Using your fingertips, work the butter into the flour by "
                  },
                  {
                    "type": "text",
                    "text": "rubbing in",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "rubbing-in"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ": lift small amounts of the mixture and rub between your thumbs and fingers, letting it drop back into the bowl. Continue until the mixture resembles coarse breadcrumbs with no visible lumps of butter."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Work quickly so the warmth of your hands does not melt the butter."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Mix the wet ingredients into the dry"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir the honey into the room-temperature sourdough discard until combined, then add the buttermilk and stir briefly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the wet mixture into the flour and butter crumbs. Use a table knife or silicone spatula to bring the dough together with short cutting strokes. Stop as soon as no dry flour remains; the dough will look shaggy."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Do not knead. Overworking the dough develops gluten and produces tough scones."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Shape and cut"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Tip the dough onto a lightly floured surface. Pat gently to a thickness of 2.5 cm; do not use a rolling pin at this stage or the scones will rise unevenly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dip a 5 cm round cutter in flour and press straight down without twisting. Lift the cutter cleanly. Repeat, placing the cut scones onto the lined tray. Gather the scraps, pat together once, and cut again."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Brush the tops lightly with milk using a pastry brush. Do not let glaze run down the sides or it will glue the scone to the tray and inhibit rise."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bake"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake on the middle shelf for 12 to 14 minutes, until the tops are deep golden and the scones sound hollow when tapped on the base."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to a cooling rack immediately. Eat warm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Scones did not rise",
              "avoid": "Avoid twisting the cutter when stamping out scones; twisting seals the cut edge and prevents rise. Press straight down and lift cleanly."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Scones are tough and dense",
              "avoid": "Avoid overworking the dough. Mix only until the dry flour disappears, then stop."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Butter seized in the liquid",
              "avoid": "Avoid adding cold sourdough discard or cold buttermilk directly from the fridge. Both must be at room temperature or the fat seizes into hard lumps."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Scones spread flat rather than rising",
              "avoid": "Avoid a dough that is too wet. If your discard is very liquid, reduce the buttermilk by a tablespoon."
            }
          }
        ]
      }
    ]
  }
}