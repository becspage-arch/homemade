  "glossaryTerms": [
    {
      "slug": "rubbing-in",
      "term": "Rubbing in",
      "definition": "A technique for combining cold butter with flour by pressing and rubbing the fat between the fingers until the mixture resembles coarse breadcrumbs. The process coats flour particles with fat, which inhibits gluten development and produces a short, tender texture in scones, pastry, and crumble."
    },
    {
      "slug": "sourdough-discard",
      "term": "Sourdough discard",
      "definition": "Unfed sourdough starter removed before refreshing. It still contains wild yeast and acid, which adds a mild tang to baked goods, though it does not have enough leavening power to raise bread on its own."
    }
  ],
  "techniqueSlugs": [
    "rubbing-in"
  ],
