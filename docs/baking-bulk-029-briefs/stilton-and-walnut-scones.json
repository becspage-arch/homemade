    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stilton and walnut scones fold crumbled "
          },
          {
            "type": "text",
            "text": "blue cheese",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "blue-cheese"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and walnuts into a savoury scone dough for a rich, sharp result. They are best eaten warm from the oven. Keep the Stilton in small crumbles, not large chunks, or the dough will not hold together and the scones will rise unevenly."
          }
        ]
      },
