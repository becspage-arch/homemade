      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Prepare the oven and tray"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 220°C conventional. Line a baking tray with baking paper."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Rub in the butter"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Sift the self-raising flour, baking powder, salt, and cayenne pepper into a large mixing bowl."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the cold cubed butter. Use the "
                  },
                  {
                    "type": "text",
                    "text": "rubbing-in",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "rubbing-in"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " method: lift small amounts of the mixture and rub between your thumbs and fingers, letting it drop back into the bowl. Continue until the mixture resembles coarse breadcrumbs with no visible lumps of butter. Work quickly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Crumble the Stilton into the bowl. The pieces should be roughly the size of large breadcrumbs, not bigger. Add the chopped walnuts. Toss lightly with a fork so both are distributed through the flour mixture."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Mix the wet into the dry"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour in the milk. Use a table knife or silicone spatula to bring the dough together with short cutting strokes. The Stilton will begin to break down slightly as you mix; this is fine."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stop as soon as no dry flour remains. The dough will look rough and slightly streaky. Do not knead."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Shape and cut"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Turn the dough onto a lightly floured surface. Pat gently to 2.5 cm thick. The cheese will make the dough slightly softer and stickier than a plain scone; use a bench scraper to lift if needed."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dip a 5 cm round cutter in flour and press straight down without twisting. Place the cut scones on the lined tray. Gather the scraps, pat together once, and cut again."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Brush the tops with a little milk. Avoid letting the glaze drip down the sides; it will stick the scone to the tray and inhibit rise."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bake"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake on the middle shelf for 12 to 14 minutes, until the tops are deep golden and the scones sound hollow when tapped on the base. Some Stilton may ooze out and caramelise on the tray; this is normal."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Transfer to a cooling rack straight away. Eat warm. The "
                  },
                  {
                    "type": "text",
                    "text": "blue cheese",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "blue-cheese"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " flavour is stronger when the scones are just out of the oven."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Scones did not rise",
              "avoid": "Avoid large chunks of Stilton in the dough. Big pieces create weak spots in the structure and prevent even rise; crumble to roughly breadcrumb size."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Scones are too salty",
              "avoid": "Avoid using full-salt butter with Stilton; the cheese contributes significant salt on its own. Use unsalted or lightly salted butter and check the quantity of added salt."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Dough is too sticky to handle",
              "avoid": "Avoid adding extra flour to correct stickiness from the cheese; it will make the scones dry. Use a bench scraper to handle the dough instead."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Cheese pooled at the bottom of the scones",
              "avoid": "Avoid adding the Stilton after the liquid is in; the wet dough will not hold the cheese evenly. Always fold the cheese through the dry mixture before adding milk."
            }
          }
        ]
      }
    ]
  }
}