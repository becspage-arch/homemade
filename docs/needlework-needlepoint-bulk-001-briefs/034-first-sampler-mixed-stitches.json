              "label": "Canvas",
              "value": "13-count mono canvas, cut 27 by 35 cm (leaves a 5 cm margin around the 83 by 125 hole design area)"
            },
            {
              "label": "Thread: main (dark)",
              "value": "Persian wool. Suggested: DMC 930 / Anchor 1035 (dark antique blue). About 20 m"
            },
            {
              "label": "Thread: contrast (cream)",
              "value": "Persian wool. Suggested: DMC 712 / Anchor 926 (cream). About 10 m"
            },
            {
