      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mark the design boundary and the three dividing lines at holes 31, 63, and 95 across the 125-hole height. Work a single row of black continental stitches along each dividing line."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Work Section 1 in continental tent stitch. Fill the 83 by 29 hole area with two colours, placing a simple geometric motif (a small diamond or check) using the contrast colour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Work Section 2 in basketweave tent stitch, full fill in main colour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Work Section 3 in brick stitch, alternating main and cream in adjacent rows."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Work Section 4 in Hungarian stitch, main and cream interlocked. Block the finished sampler by dampening and pinning."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Leave the sampler unframed for use as a reference, tacking it to a cork board. Or mount and frame it as a record of the first session."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
