      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the caramel base"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heat the oven to 175°C (conventional). Grease a 23 cm round solid-base tin. Melt 50 g {{unsalted-butter}} with {{light-brown-sugar}} in a small saucepan over a medium heat, stirring for 1 to 2 minutes until the sugar dissolves and the mixture is smooth. Pour into the base of the prepared tin and spread evenly. Arrange the {{plums}} halves cut-side down in the caramel in a single layer, packing them closely."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the sponge batter"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Beat 150 g softened {{unsalted-butter}} and {{caster-sugar}} together until pale and fluffy, about 4 minutes. Add {{eggs}} one at a time, beating well after each addition. Beat in {{vanilla-extract}}. Sift {{plain-flour}}, {{baking-powder}}, and {{sea-salt-fine}} over the mixture and fold in alternately with {{whole-milk}}, beginning and ending with flour. Mix until just smooth."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bake and invert"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Spoon the batter over the plums and spread gently level. Bake for 40 to 45 minutes until the top is golden and a skewer inserted into the centre of the sponge (not a plum) comes out clean. Leave to cool in the tin for exactly 10 minutes on a wire rack, long enough for the caramel to begin to set but short enough that it does not stick. Run a palette knife around the edge, then invert onto a serving plate in one confident movement. If any plums stick, lift them back into place with a spoon. Serve warm."
          }
        ]
      }
    ]
  }
