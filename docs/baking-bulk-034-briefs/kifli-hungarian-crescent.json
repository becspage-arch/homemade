      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Mix and knead"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Combine {{plain-flour}}, {{yeast-fast-action}}, {{sea-salt-fine}}, and {{caster-sugar}} in a large bowl. Mix {{whole-milk}} and the beaten {{eggs}} together, then add to the flour. Mix to a rough dough, then knead for 6 minutes. Add {{unsalted-butter}} a little at a time, kneading after each addition. Continue for a further 6 to 8 minutes until the dough is smooth, soft, and just slightly sticky. It should pull cleanly away from the bowl."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bulk ferment"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Place in a lightly oiled bowl, cover with cling film, and leave at room temperature for 1 hour 15 minutes until doubled in size."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Shape the crescents"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Divide the dough into 12 equal pieces (about 60 g each). On a lightly floured surface, roll each piece into a teardrop shape, then roll it out with a rolling pin into a long, thin triangle, about 15 cm long and 8 cm across at the wide end. Roll up from the wide end, wrapping the dough around itself toward the narrow tip. Place on lined baking trays, tips tucked underneath, and curve the ends inward to form a crescent. Leave 4 cm between each roll."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Prove, glaze, and bake"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cover loosely with oiled cling film and prove for 40 minutes until puffed and the dough springs back slowly when pressed. Heat the oven to 185°C (conventional). Brush each roll gently with egg glaze, taking care not to deflate them. Bake for 15 to 18 minutes until pale golden and glossy. They should not be deep brown: kifli are a delicate, soft roll. Cool on a wire rack for 5 minutes before serving warm."
          }
        ]
      }
    ]
  }
