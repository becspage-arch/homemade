      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Mix and knead"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Combine {{plain-flour}}, {{yeast-fast-action}}, {{sea-salt-fine}}, {{caster-sugar}}, and {{cardamom-ground}} in a large bowl. Make a well in the centre and add {{water}} and {{vegetable-oil}}. Mix to a shaggy dough, then turn out and knead for 8 minutes until smooth and elastic. The dough should be soft and only slightly sticky; add a tablespoon of water if it feels stiff."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bulk ferment"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Return the dough to the bowl, cover with a damp tea towel or cling film, and leave at room temperature for 1 hour 15 minutes until doubled in size."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Shape and pattern the surface"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Turn the dough out and flatten gently. Place on a baking-paper-lined tray and press it out to a round roughly 28 to 30 cm in diameter. The edge can be slightly thicker than the centre. Cover loosely with oiled cling film and leave to prove for 40 to 45 minutes until noticeably puffed. Use a fork or fingertip to press a decorative pattern into the surface: radiating segments from the centre (like a wheel with 8 to 10 spokes) is traditional. Scatter {{sesame-seeds}} over the surface and press lightly to adhere."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bake"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heat the oven to 180°C (conventional). Bake for 22 to 25 minutes until golden brown across the surface and the base sounds hollow when tapped. The bread should not be pale; a deep golden colour indicates the crumb is fully baked. Cool on a wire rack for 10 minutes, then wrap loosely in a clean cloth while still warm to keep the surface soft."
          }
        ]
      }
    ]
  }
