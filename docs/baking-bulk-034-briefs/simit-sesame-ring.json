      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Mix and knead"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Combine {{strong-bread-flour}}, {{yeast-fast-action}}, {{sea-salt-fine}}, and {{caster-sugar}} in a large bowl. Mix {{water}} and {{vegetable-oil}} together, then pour into the flour. Mix to a dough and knead for 8 to 10 minutes until smooth, elastic, and not sticky. The dough should spring back when poked."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bulk ferment"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cover the bowl with cling film and leave at room temperature for 1 hour until doubled in size."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Divide and shape"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Turn the dough out and divide into 12 equal pieces (about 70 g each). Roll each piece into a rope about 40 cm long. Twist two ropes together, pressing the ends firmly to join and form a ring about 15 cm across. Repeat with the remaining pieces to make 6 rings. Place on lined trays."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Prove, dip, and coat"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cover loosely and prove for 30 minutes. Meanwhile, mix {{black-treacle}} with 100 ml warm water in a wide, shallow bowl. Tip {{sesame-seeds}} into a separate shallow tray. Dip each proved ring into the treacle mixture, turning to coat all surfaces, then lift out and let excess drip off for a few seconds. Lay the ring in the sesame seeds and press all sides firmly into the seeds until completely covered. Return to the lined tray."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bake"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heat the oven to 220°C (conventional). Bake for 18 to 20 minutes until the seeds are deep golden and the crust is crisp when tapped. Cool on a wire rack and eat the same day."
          }
        ]
      }
    ]
  }
