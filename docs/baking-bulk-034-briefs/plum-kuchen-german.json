      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the dough and prove"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Combine {{plain-flour}}, {{yeast-fast-action}}, {{caster-sugar}}, and {{sea-salt-fine}} in a large bowl. Add {{whole-milk}} and the beaten {{eggs}} and mix to a rough dough. Turn out and knead for 5 minutes, then knead in {{unsalted-butter}} a little at a time until absorbed. The dough should be soft and slightly sticky. Place in a bowl, cover, and leave for 1 hour 15 minutes until doubled."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Press into the tray and top"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Line a large baking tray (about 30 x 40 cm) with baking paper. Turn the dough out and press it into the tray with your fingertips, stretching to fill every corner. The layer should be about 8 mm thick. Cover loosely with oiled cling film and leave for 25 minutes to puff slightly. Arrange {{plums}} halves cut-side up in tight, overlapping rows across the entire surface of the dough. Mix {{caster-sugar}} for the topping with {{cinnamon-ground}} and scatter evenly over the plums."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Bake"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Heat the oven to 190°C (conventional). Bake for 30 to 35 minutes until the dough at the edges is golden and the plums have softened and released their juices. The base should sound hollow when tapped. Slide onto a board or rack and cut into squares. Serve warm with whipped cream, or at room temperature."
          }
        ]
      }
    ]
  }
