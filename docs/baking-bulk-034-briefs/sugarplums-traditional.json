  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sugarplums are made by blitzing dates, nuts, and candied peel with warm spices into a sticky paste, rolling it into small balls, and coating each one in caster sugar. There is no cooking involved: the dates bind the mixture, the nuts give texture, and the spices do the work. The only skills needed are a food processor and cold hands for rolling."
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "items": [
            {
              "ingredientSlug": "dates-medjool",
              "amount": 200,
              "unit": "g",
              "prepNote": "pitted",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "almonds",
              "amount": 100,
              "unit": "g",
              "prepNote": "toasted",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "pistachios",
              "amount": 75,
              "unit": "g",
              "prepNote": "unsalted, shelled",
              "isOptional": false,
              "groupLabel": null
            },
            {
              "ingredientSlug": "mixed-peel",
              "amount": 50,
              "unit": "g",
