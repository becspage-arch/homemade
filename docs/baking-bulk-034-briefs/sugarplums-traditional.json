      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Toast the almonds"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Spread {{almonds}} on a dry frying pan over a medium heat and toast for 3 to 4 minutes, stirring often, until they smell nutty and the skins begin to colour slightly. Tip onto a plate and leave to cool completely before using. Warm nuts make the paste greasy."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Blitz the mixture"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Put the cooled {{almonds}}, {{pistachios}}, and {{mixed-peel}} in a food processor and pulse 6 to 8 times until coarsely chopped. Add the {{dates-medjool}}, {{cinnamon-ground}}, {{cardamom-ground}}, {{nutmeg}}, and {{orange-blossom-water}}. Process for 30 to 45 seconds until the mixture forms a sticky, cohesive paste that clumps together when pressed. Some visible nut pieces are welcome; a completely smooth paste lacks texture. If the mixture is too dry to clump, add a few extra drops of orange blossom water."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Roll into balls"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Refrigerate the paste for 30 minutes before rolling; it is much easier to handle when cold. Pinch off pieces about the size of a large marble (around 15 g each) and roll between your palms into smooth balls. If the mixture sticks to your hands, rinse them in cold water and dry them before continuing."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Coat in sugar"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tip {{caster-sugar}} into a shallow bowl. Roll each ball in the sugar until evenly coated, pressing gently so the sugar adheres. Transfer to a baking-paper-lined tray. Keep refrigerated until serving."
          }
        ]
      }
    ]
  }
