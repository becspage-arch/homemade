  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail to close the hole after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "3-treble cluster (3tr cl)",
      "definition": "Three trebles into the same space, each left with the last loop on the hook, joined with one yarn-over through all remaining loops.",
      "slug": "treble-cluster"
    },
    {
      "term": "Popcorn",
      "definition": "Five trebles worked into the same space, the hook removed and reinserted through the top of the first treble and the working loop, then pulled through to close. The popcorn stands forward on the public face.",
      "slug": "popcorn"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming finished crochet and pinning to target dimensions while drying. Blocking flattens the background clusters without flattening the popcorns.",
      "slug": "blocking"
    }
  ],
  "techniqueSlugs": [
    "magic-ring",
    "working-in-the-round",
    "blocking-crochet"
  ],
  "criticalTechniques": [
    "magic-ring"
  ],
  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "popcorn"
                }
              }
            ],
            "text": "popcorn"
          },
          {
            "type": "text",
            "text": " is the most raised of the textured stitches — it stands fully forward on the public face while the surrounding "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "treble-cluster"
                }
              }
            ],
            "text": "treble cluster"
          },
          {
            "type": "text",
            "text": " background stays flat. Placing one popcorn at the centre of each side on rounds 3 and 5 gives four raised dots on round 3 and four more on round 5, each framed by cluster groups. The motif works best in a single bold colour where the texture carries the visual interest. Start from a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": " to keep the centre tight. "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "blocking"
                }
              }
            ],
            "text": "Blocking"
          },
          {
            "type": "text",
            "text": " flattens the background without compressing the popcorns."
          }
        ]
      },
      {
        "type": "infoPanel",
        "attrs": {
          "type": "materials"
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Yarn: DK cotton, approx 40 m per square. Hook: 4 mm. Notions: tapestry needle, scissors."
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "12 × 12 cm in DK cotton on a 4 mm hook, after blocking. The popcorns add local bulk and may tighten gauge slightly — check at round 3 and ease hook tension if the square is pulling in."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Stitches used"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Magic ring"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Chain (ch)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Treble (tr)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "3-treble cluster (3tr cl)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Popcorn: 5 tr in same sp, close to standing position"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slip stitch (sl st)"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 3 at the start of each round counts as the first tr throughout. Corners throughout: (3tr cl, ch 2, 3tr cl)."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 1"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Make a magic ring. Ch 3 (counts as first tr). 2 tr, ch 2. *(3 tr, ch 2); repeat from * 2 more times. Sl st to top of ch-3. Pull tail. (12 tr, 4 ch-2 corners)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 2"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sl st into corner sp. Ch 3 (counts as first tr). (2 tr, ch 2, 3 tr) in corner sp. Ch 1. *(3 tr, ch 2, 3 tr) in next corner sp. Ch 1; repeat from * 2 more times. Sl st to top of ch-3. (24 tr, 4 ch-2 corners, 4 ch-1 side sps)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 3 — first popcorn round"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sl st into corner sp. Ch 3 (counts as first tr). (2 tr, ch 2, 3 tr) in corner sp. Ch 1. *3 tr in ch-1 side sp. Ch 1. Popcorn in next ch-1 sp (or work into the top of the centre cluster from round 2 if only one side sp). Ch 1. 3 tr in next ch-1 sp. Ch 1. (3 tr, ch 2, 3 tr) in corner sp. Ch 1; repeat from * 2 more times. Sl st to top of ch-3. (4 popcorns centred on each side, 36 tr, 4 ch-2 corners, 12 ch-1 sps)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 4"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sl st into corner sp. Ch 3 (counts as first tr). (2 tr, ch 2, 3 tr) in corner sp. Ch 1. *3 tr in each ch-1 sp across side, ch 1 between groups. (3 tr, ch 2, 3 tr) in corner sp. Ch 1; repeat from * 2 more times. Complete last side. Sl st to top of ch-3. (48 tr, 4 ch-2 corners, 16 ch-1 side sps)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 5 — second popcorn round"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sl st into corner sp. Ch 3 (counts as first tr). (2 tr, ch 2, 3 tr) in corner sp. Ch 1. *Work clusters in each side sp across until the centre sp is reached. Work popcorn in centre ch-1 sp of each side. Ch 1. Continue clusters to corner. (3 tr, ch 2, 3 tr) in corner sp. Ch 1; repeat from * 2 more times. Sl st to top of ch-3. Fasten off. (4 popcorns, 60 tr, 4 ch-2 corners, 20 ch-1 side sps)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Chart"
          }
        ]
      },
      {
        "type": "craftChart",
        "attrs": {
          "roundCount": 5
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Weave in ends. Block by pinning to 12 × 12 cm on a blocking mat, applying steam without pressing the iron directly onto the popcorns. The popcorns should retain their raised shape; pressing them flat defeats the purpose."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Joining"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Join with the flat slip-stitch join through corresponding chain-1 spaces and cluster tops. The popcorns face outward on the public side and are not affected by the join seam."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Care"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hand wash or machine wash on a gentle cycle at 30 degrees. Turn inside out if machine washing to protect the popcorns. Reshape while damp and dry flat."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Move the popcorns to the corners instead of the sides — work a popcorn into the ch-2 corner space in place of one of the two corner clusters. Or try bobbles in the same positions for a lower-profile raised dot that sits closer to the background fabric."
          }
        ]
      }
    ]
  }
}