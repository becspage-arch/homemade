  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail to close the hole after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "3-treble cluster (3tr cl)",
      "definition": "Three trebles into the same space, each left with the last loop on the hook, joined with one yarn-over through all loops.",
      "slug": "treble-cluster"
    },
    {
      "term": "Shell",
      "definition": "Five trebles worked into the same stitch or space, fanning out to form a shell shape. Corner shells use five trebles; side shells use three trebles.",
      "slug": "shell"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming finished crochet and pinning to target dimensions while drying. Fans out the shell stitches on the border round.",
      "slug": "blocking"
    }
  ],
  "techniqueSlugs": [
