  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail to close the hole after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "Puff stitch",
      "definition": "Multiple half-treble loops worked into the same stitch — yarn over, insert hook, draw up a long loop, repeat 5 more times in the same stitch, then yarn over and pull through all loops. Softer and rounder than a bobble.",
      "slug": "puff-stitch"
    },
    {
      "term": "3-treble cluster (3tr cl)",
      "definition": "Three trebles into the same space, each left with the last loop on the hook, then joined with one yarn-over through all loops.",
      "slug": "treble-cluster"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming finished crochet and pinning to target dimensions while drying. Opens the cluster chain spaces and brings the puff centre into relief.",
      "slug": "blocking"
    }
  ],
