  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail to close the hole after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "Treble cluster (3tr cl)",
      "definition": "Three trebles worked into the same space, each left with the final loop on the hook, then joined with one yarn-over through all loops. Also called a 3-treble cluster.",
      "slug": "treble-cluster"
    },
    {
      "term": "Chain-2 corner",
      "definition": "Two chains at each corner create the distinct corner space. In round 2 onward, the corner is (3tr cl, ch 2, 3tr cl) — two clusters separated by two chains.",
      "slug": "chain-2-corner"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming finished crochet and pinning to target dimensions. Wet-blocking is recommended for cotton granny squares.",
      "slug": "blocking"
    }
  ],
  "techniqueSlugs": [
    "magic-ring",
    "working-in-the-round",
    "blocking-crochet"
  ],
  "criticalTechniques": [
