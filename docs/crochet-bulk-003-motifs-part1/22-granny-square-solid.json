  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail to close the hole after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "3-treble cluster (3tr cl)",
      "definition": "Three trebles worked into the same position, each left with the last loop on the hook, then joined with one yarn-over through all loops.",
      "slug": "treble-cluster"
    },
    {
      "term": "Working into the cluster top",
      "definition": "Inserting the hook through the closing loop of the previous round's cluster rather than into a chain space. This removes the chain gap between clusters and produces a solid, dense fabric.",
      "slug": "into-the-top"
    },
    {
      "term": "Blocking",
      "definition": "Applying steam or wet-pinning to the finished square to sharpen corners and regularise the grid. Steam-blocking works well on dense cotton fabric.",
      "slug": "blocking"
    }
  ],
  "techniqueSlugs": [
    "magic-ring",
