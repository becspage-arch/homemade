                          "termSlug": "slip-stitch"
                        }
                      }
                    ],
                    "text": "Slip stitch"
                  },
                  {
                    "type": "text",
                    "text": " (sl st)"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Note: ch 3 counts as first tr throughout. Mark the tip stitch of each point with a stitch marker on round 2 and move the markers up each round to keep track of the six point columns."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 1"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Make a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". Ch 3 (counts as first tr). Work 11 tr into the ring. Pull tail to close. Join with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "slip-stitch"
                }
              }
            ],
            "text": "sl st"
          },
          {
            "type": "text",
            "text": " to top of ch 3. (12 tr.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 2"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 3 (counts as first tr). *Work 3 tr into the next st (point increase), 1 tr in the next st*; repeat from * to * 5 more times (6 point repeats total). Join with sl st to top of ch 3. (24 tr — 6 groups of 3 tr at points, 6 single tr between points.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 3"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 3 (counts as first tr). *Work 3 tr into the first tr of the point group (this is the centre stitch of the 3-tr increase from round 2), 1 tr in each of the next 2 sts of the point group, 1 tr in the between-point tr*; repeat from * to * 5 more times. Join with sl st. (36 tr.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 4"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 3 (counts as first tr). *Work 3 tr into the tip tr of the point, 1 tr in each of the next 4 sts*; repeat from * to * 5 more times. Join with sl st to top of ch 3. Fasten off. (48 tr.)"
          }
        ]
      },
      {
        "type": "craftChart",
        "attrs": {
          "slug": "crochet-motif-star-six-point"
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Weave in tails. Wet-block by soaking, pressing out moisture, then pinning the motif to the blocking mat. Place one pin at the very tip of each of the six points and two pins on each side of the indentation between points to set the star silhouette. Leave to dry fully before unpinning."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Joining"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Six-point stars join tip-to-tip at the point stitches, with a sl st join or a short chain link. The spaces between the points of adjacent stars form a secondary pattern of diamond-shaped gaps."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Care"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hand wash in cool water. Block again after each wash to maintain the point shape."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The sunburst square motif uses a similar radiating structure but transitions from spikes at the centre to standard granny construction at the outer rounds. The chevron round motif uses the same principle of alternating increase and decrease columns to create an indented-star shape."
          }
        ]
      }
    ]
  }
