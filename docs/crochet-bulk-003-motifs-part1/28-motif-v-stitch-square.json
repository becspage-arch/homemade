  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail to close the hole after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "V-stitch",
      "definition": "Two trebles worked into the same stitch or space, separated by one chain: (tr, ch 1, tr). Creates an open V-shaped unit that adds width on the sides.",
      "slug": "v-stitch"
    },
    {
      "term": "Corner group",
      "definition": "Three trebles, chain 2, three trebles worked into the same corner space — (3tr, ch 2, 3tr). This is the standard corner for V-stitch squares, keeping the corner structure firm while the sides stay open.",
      "slug": "corner-group"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming finished crochet and pinning to target dimensions. Opens the V-stitch chain spaces and sharpens corner angles.",
      "slug": "blocking"
    }
  ],
  "techniqueSlugs": [
