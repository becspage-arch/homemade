                          "termSlug": "magic-ring"
                        }
                      }
                    ],
                    "text": "Magic ring"
                  },
                  {
                    "type": "text",
                    "text": " (MR)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Chain (ch)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "double-crochet-uk"
                        }
                      }
                    ],
                    "text": "Double crochet"
                  },
                  {
                    "type": "text",
                    "text": " (dc) — UK terminology"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "slip-stitch"
                        }
                      }
                    ],
                    "text": "Slip stitch"
                  },
                  {
                    "type": "text",
                    "text": " (sl st)"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 1"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Make a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". Ch 1 (does not count as a stitch). Work 6 dc into the ring. Pull the tail to close the ring. Join with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "slip-stitch"
                }
              }
            ],
            "text": "slip stitch"
          },
          {
            "type": "text",
            "text": " to the first dc. (6 dc.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 2"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 1 (does not count as a stitch throughout). Work 2 "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "double-crochet-uk"
                }
              }
            ],
            "text": "dc"
          },
          {
            "type": "text",
            "text": " in each of the 6 sts around. Join with sl st to first dc. (12 dc.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 3"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 1. *2 dc in next st, 1 dc in next st*; repeat from * to * around. Join with sl st. (18 dc.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 4"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 1. *2 dc in next st, 1 dc in each of next 2 sts*; repeat from * to * around. Join with sl st. Fasten off. (24 dc.)"
          }
        ]
      },
      {
        "type": "craftChart",
        "attrs": {
          "slug": "crochet-motif-flat-circle"
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cut yarn, leaving a 15 cm tail. Thread onto a tapestry needle and weave through the back loops of the final round at least twice to secure. Trim tail. Wet-block the motif by soaking in cold water, pressing out excess moisture in a towel, then pinning flat to a blocking mat. Leave to dry completely (usually overnight for cotton)."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Joining"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Flat circles join to each other and to granny squares with a whip stitch through the outer edge loops, or with a join-as-you-go slip stitch on the last round. When joining multiple circles, the gaps between them form decorative diamond shapes that can be filled with small chain-and-slip-stitch fill motifs."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Care"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cotton DK: machine wash at 30 °C on a gentle cycle, or hand wash in cool water. Lay flat to dry. Do not tumble dry cotton motifs as heat causes them to pucker and shrink unevenly."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Once this circle feels comfortable, try the lacy circle motif (which replaces the solid dc increases with treble shells and chain spaces) or the spiral round motif (which removes the join-and-turn step entirely for a seamless look). The flat circle is also the starting point for the shell round motif, where a shell edging is added on the final round."
          }
        ]
      }
    ]
  }
