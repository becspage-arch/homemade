                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mark the centre stitch of each triple-increase point with a stitch marker in round 2 and move it up each round. Ch 1 at the start of each round does not count as a stitch."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 1"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Make a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". Ch 1. Work 12 "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "double-crochet-uk"
                }
              }
            ],
            "text": "dc"
          },
          {
            "type": "text",
            "text": " into the ring. Pull tail to close. Join with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "slip-stitch"
                }
              }
            ],
            "text": "sl st"
          },
          {
            "type": "text",
            "text": " to first dc. (12 dc.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 2"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 1. *Work 3 dc into the next st (this is the point), 1 dc in the next st*; repeat from * to * 5 more times (6 repeats total). Join with sl st. (24 dc — 6 point groups of 3 dc, 6 single dc between points.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 3"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "*3 dc into the centre dc of the point group, 1 dc in each of the next 3 sts*; repeat from * to * 5 more times. Join with sl st. (36 dc.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Round 4"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "*3 dc into the centre dc of the point group, 1 dc in each of the next 5 sts*; repeat from * to * 5 more times. Join with sl st. Fasten off. (48 dc.)"
          }
        ]
      },
      {
        "type": "craftChart",
        "attrs": {
          "slug": "crochet-motif-chevron-round"
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Weave in tails. Wet-block by soaking, removing excess moisture, then pinning one pin at the tip of each of the six points and easing the sides between points to a smooth curve. Leave overnight."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Joining"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Join chevron round motifs tip-to-tip using a sl st join at the point stitch. The curved bays between points of adjacent motifs form a negative-space pattern when several motifs are joined together."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Care"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hand wash or machine wash at 30 °C gentle cycle. Pin to shape after each wash if the point definition needs refreshing."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The six-point star motif uses trebles instead of double crochet at the same six increase positions, giving sharper and taller points. The flat circle motif is the double-crochet baseline for comparison: identical stitches but increases staggered to produce a smooth circle rather than points."
          }
        ]
      }
    ]
  }
