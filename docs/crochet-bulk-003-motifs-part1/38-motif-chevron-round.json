  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The chevron round works three "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "double-crochet-uk"
                }
              }
            ],
            "text": "double crochets"
          },
          {
            "type": "text",
            "text": " into the same stitch at six evenly-spaced positions each round, producing points that project outward while the fabric between them stays flat. Unlike the six-point star (which uses trebles), this motif uses double crochet throughout, so the points are lower and the shape is a spiked disc rather than a sharp star. "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "blocking"
                }
              }
            ],
            "text": "Blocking"
          },
          {
            "type": "text",
            "text": " with a pin at each of the six points sharpens the profile considerably."
          }
        ]
      },
      {
        "type": "infoPanel",
        "attrs": {
          "variant": "materials"
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Yarn: DK weight cotton, approximately 26 m per motif. Hook: 4 mm. Notions: tapestry needle, scissors, blocking mat, 6 blocking pins."
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "4 rounds in DK cotton with a 4 mm hook = 13 cm across the widest point-to-point measurement. The disc between points is approximately 10 cm."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Stitches used"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
