  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail to close the hole after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "3-treble cluster (3tr cl)",
      "definition": "Three trebles into the same space, each left with the last loop on the hook, joined with one yarn-over through all loops.",
      "slug": "treble-cluster"
    },
    {
      "term": "Chain-join border",
      "definition": "A border round worked as chain-3 loops joined by slip stitches or double crochet into the cluster tops of the previous round. Replaces the final cluster round and creates attachment points for adjacent squares.",
      "slug": "chain-join-border"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming finished crochet and pinning to target dimensions while drying.",
      "slug": "blocking"
    }
  ],
  "techniqueSlugs": [
