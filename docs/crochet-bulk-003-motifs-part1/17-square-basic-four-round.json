  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail to close the hole after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "Double crochet (dc)",
      "definition": "UK double crochet: insert hook, yarn over, pull through, yarn over, pull through both loops. The shortest UK post stitch. Known as single crochet in US terminology.",
      "slug": "double-crochet-uk"
    },
    {
      "term": "Chain-2 corner",
      "definition": "Two chains worked at each corner to create a distinct corner space and allow the square to lie flat. The two-chain corner is the standard for squares built in dc.",
      "slug": "chain-2-corner"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming finished crochet and pinning to target dimensions while drying. Steam-blocking is preferred for cotton squares.",
      "slug": "blocking"
    }
  ],
