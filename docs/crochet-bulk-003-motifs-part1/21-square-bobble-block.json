  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail to close the hole after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "3-treble cluster (3tr cl)",
      "definition": "Three trebles worked into the same space, each left unfinished, then joined with one yarn-over through all remaining loops.",
      "slug": "treble-cluster"
    },
    {
      "term": "Bobble (5tr bobble)",
      "definition": "Five trebles worked into the same stitch, each left with the last loop on the hook, then joined with one yarn-over. The bobble sits forward on the public face but lower than a popcorn.",
      "slug": "bobble"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming finished crochet and pinning to target dimensions while drying. Flattens the background without collapsing the bobbles.",
      "slug": "blocking"
    }
  ],
  "techniqueSlugs": [
    "magic-ring",
    "working-in-the-round",
    "blocking-crochet"
  ],
