            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Yarn: DK weight cotton, approximately 28 m per motif. Hook: 4 mm. Notions: tapestry needle, scissors."
              }
            ]
          }
        ]
      },
