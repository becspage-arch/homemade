          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 1 (does not count as a stitch). Work 2 "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
