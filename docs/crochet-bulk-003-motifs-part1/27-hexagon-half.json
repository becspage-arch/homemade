  "glossaryTerms": [
    {
      "term": "3-treble cluster (3tr cl)",
      "definition": "Three trebles worked into the same space, each left with the last loop on the hook, joined with one yarn-over through all loops.",
      "slug": "treble-cluster"
    },
    {
      "term": "Flat construction",
      "definition": "Working back and forth in rows rather than joining into rounds. The half hexagon uses flat construction to create the straight bottom edge that fills blanket perimeters.",
      "slug": "flat-construction"
    },
    {
      "term": "Foundation chain",
      "definition": "The starting chain that sets the width of a flat-construction piece. For the half hexagon, the foundation chain provides the anchor points for the three base clusters.",
      "slug": "foundation-chain"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming finished crochet and pinning to target dimensions while drying. The half hexagon must be blocked flat to tile accurately with full hexagons.",
      "slug": "blocking"
    }
  ],
