  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail end to close the hole completely after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "Treble (tr)",
      "definition": "UK treble: yarn over, insert hook, yarn over and pull through, (yarn over, pull through 2 loops) twice. Known as double crochet in US terminology.",
      "slug": "treble"
    },
    {
      "term": "Double treble (dtr)",
      "definition": "Yarn over twice, insert hook, yarn over and pull through, (yarn over, pull through 2 loops) three times. Taller than a treble by one yarn-over step.",
      "slug": "double-treble"
    },
    {
      "term": "V-stitch",
      "definition": "Two trebles worked into the same stitch or space, separated by one chain. Creates an open V-shaped unit that increases the fabric width.",
      "slug": "v-stitch"
    },
    {
      "term": "Shell",
      "definition": "Five trebles worked into the same stitch or space. Creates a fan shape that adds width to the round.",
      "slug": "shell"
    },
    {
      "term": "Picot",
      "definition": "A small decorative loop: chain 3, slip stitch into the first chain. Used here in the final edging round.",
      "slug": "picot"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming finished crochet and pinning it to its target dimensions while drying. Essential for flat mandala construction at this scale.",
      "slug": "blocking"
    },
    {
      "term": "Stitch marker",
      "definition": "A clip or loop placed on the work to mark the start of a round or a reference stitch. Prevents miscounts in long rounds.",
      "slug": "stitch-marker"
    }
  ],
  "techniqueSlugs": [
