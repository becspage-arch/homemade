  "glossaryTerms": [
    {
      "term": "Magic ring",
      "definition": "An adjustable loop used as the starting centre of rounds. Pull the tail to close the hole after the first round is joined.",
      "slug": "magic-ring"
    },
    {
      "term": "3-treble cluster (3tr cl)",
      "definition": "Three trebles into the same space, each left with the last loop on the hook, joined with one yarn-over through all loops.",
      "slug": "treble-cluster"
    },
    {
      "term": "Hexagon corner",
      "definition": "Each of the six points of a hexagon is worked as (3tr cl, ch 2, 3tr cl) in the corner chain-2 space — the same structure as a square corner but with six points instead of four.",
      "slug": "hexagon-corner"
    },
    {
      "term": "Blocking",
      "definition": "Wetting or steaming and pinning to the correct point-to-point diameter. Hexagons need all six points pinned to sit flat in a blanket.",
      "slug": "blocking"
    }
  ],
