      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Salt the cucumbers"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Toss the sliced cucumbers with the salt in a colander and leave for 20 to 30 minutes. The salt draws out the excess moisture that would otherwise dilute the brine. Rinse briefly and pat dry."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the brine"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Warm the vinegar, water, and sugar in a small saucepan over low heat until the sugar dissolves. Leave to cool for 5 minutes."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Pack and pour"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Layer the cucumbers, dill, garlic, and peppercorns into a clean jar. Pour the warm brine over. Press down so everything is submerged. Seal and leave at room temperature for 1 hour, then refrigerate for at least 3 more hours."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Watery brine after 24 hours",
              "cause": "Cucumbers not salted before pickling, they released water into the brine.",
              "fix": "Always salt the cucumbers first. The 20-minute salt draws out the water before brining begins."
            },
            {
              "symptom": "Cucumbers have gone limp",
              "cause": "Sliced too thin, or soaked too long in brine.",
              "fix": "Slice 4 to 5 mm thick for a better crunch. Quick-pickled cucumbers deteriorate in texture after 2 weeks."
            },
            {
              "symptom": "Too sharp",
              "cause": "High-acid white wine vinegar.",
              "fix": "Increase the water to 120 ml and reduce vinegar to 130 ml, or add an extra teaspoon of sugar."
            },
            {
              "symptom": "No garlic flavour coming through",
              "cause": "Raw garlic takes 24 hours to infuse properly.",
              "fix": "The garlic flavour is more pronounced after 48 hours. For more immediate garlic character, use a small pinch of garlic powder in the brine."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Storage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Refrigerator only. Use within 2 weeks."
          }
        ]
      }
    ]
  }
