      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Cook the onion base"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Put the onion and garlic in the pan with a splash of vinegar. Cook over medium heat for 5 to 8 minutes until softened. Add the mustard seeds and cook for another minute."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Add everything and cook down"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Add the tomatoes, ginger, remaining vinegar, sugar, paprika, chilli flakes, and salt. Stir over low heat until the sugar dissolves. Bring to a simmer and cook uncovered for 60 to 70 minutes, stirring every 10 minutes, until the chutney is thick and dark. The tomatoes will break down completely. Draw a spoon across the base,  the line should hold for a few seconds."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Jar and seal"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ladle into hot sterilised jars while hot. Seal and invert for 2 minutes, then cool upright."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Watery chutney that won't thicken",
              "cause": "High-water tomatoes or insufficient reduction.",
              "fix": "Continue cooking uncovered, tomatoes can hold a lot of water. Add a grated cooking apple to help absorb excess liquid."
            },
            {
              "symptom": "Bitter, sharp taste",
              "cause": "Under-ripe tomatoes.",
              "fix": "Use the ripest tomatoes available. Add an extra 20 g of brown sugar to counter bitterness."
            },
            {
              "symptom": "Pale colour",
              "cause": "Not cooked long enough or too much vinegar too early.",
              "fix": "The dark colour comes from prolonged cooking of the sugars. Continue to a slow reduction, allow up to 90 minutes."
            },
            {
              "symptom": "Tough tomato skins in the chutney",
              "cause": "Unpeeled tomatoes, and skins don't break down fully.",
              "fix": "Pass through a coarse sieve or food mill after cooking if you prefer a smooth texture. Or peel the tomatoes by blanching before adding."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Storage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sealed: 12 months in a cool dark place. Refrigerate once opened and use within 4 weeks."
          }
        ]
      }
    ]
  }
