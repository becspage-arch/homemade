      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Combine and dissolve"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Put all the ingredients into the pan. Stir over low heat until the sugar dissolves. The plums will begin to release their juice immediately. Bring to a gentle simmer."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Simmer until thick"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cook uncovered for 50 to 60 minutes, stirring every 10 minutes, until the plums have completely broken down and the chutney is thick and dark. Watch for the line-in-the-pan test to hold. Remove the star anise before jarring."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Jar and seal"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ladle into hot sterilised jars while hot. Seal immediately and leave to cool."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Loose, runny texture",
              "cause": "Very juicy plums, they released more liquid than expected.",
              "fix": "Continue reducing uncovered. Plum chutney often looks thin when hot but thickens considerably on cooling."
            },
            {
              "symptom": "Bitter taste",
              "cause": "Plum skins can turn bitter with prolonged cooking.",
              "fix": "Skin is fine for most plum varieties, only very thick-skinned varieties cause this. Remove skins before cooking if needed."
            },
            {
              "symptom": "Chutney is too sweet",
              "cause": "Ripe summer plums have more sugar than expected.",
              "fix": "Add an extra 30 ml of red wine vinegar and reduce the sugar to 250 g next batch."
            },
            {
              "symptom": "Star anise flavour is too dominant",
              "cause": "Left in too long or too many used.",
              "fix": "Remove after 30 minutes of simmering rather than at the end. Use 1 star anise instead of 2."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Storage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sealed: 12 months in a cool dark place. Refrigerate once opened and use within 4 weeks."
          }
        ]
      }
    ]
  }
