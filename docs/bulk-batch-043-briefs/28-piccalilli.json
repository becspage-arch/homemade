      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Day 0: Salt the vegetables"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Toss all the prepared vegetables in the salt in a large bowl. Cover and leave overnight in the fridge. The salt draws out water, which keeps the vegetables crisp in the jar rather than soft and waterlogged."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Day 1: Rinse the vegetables"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Tip the salted vegetables into a colander and rinse thoroughly under cold running water. Shake dry and spread on a clean tea towel to remove as much moisture as possible. The vegetables should still be firm."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the mustard sauce"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Put the vinegar, sugar, mustard powder, turmeric, mustard seeds, and ground ginger into a saucepan. Stir over medium heat until the sugar dissolves. Mix the cornflour with 4 tbsp of the vinegar to make a smooth paste, then whisk into the hot sauce. Stir over medium heat for 3 to 4 minutes until the sauce thickens enough to coat the back of a spoon."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Fold in the vegetables and jar"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Take the sauce off the heat and fold in the drained vegetables,  the residual heat is enough to very slightly soften them without cooking them through. Pack into hot sterilised jars and seal. The piccalilli must be left for at least 4 weeks before opening."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Vegetables are soft and waterlogged",
              "cause": "Not brined overnight, or not rinsed and dried well enough.",
              "fix": "The overnight brine and thorough drying are the key to crisp piccalilli. Can't be rescued once jarred, the texture won't recover."
            },
            {
              "symptom": "Sauce is too thick and gluey",
              "cause": "Too much cornflour or cooked too long.",
              "fix": "Reduce cornflour to 1.5 tbsp. The sauce thickens further as it cools."
            },
            {
              "symptom": "Mustard is overwhelming when first opened",
              "cause": "Just made, piccalilli is always harsh until it has rested.",
              "fix": "Rest for the full 4 weeks minimum. 8 weeks is better. The mustard mellows considerably."
            },
            {
              "symptom": "Pale yellow — not vivid",
              "cause": "Not enough turmeric, or old turmeric that has lost its colour.",
              "fix": "Use 2.5 tsp fresh turmeric. Old turmeric produces weaker colour and less flavour."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Storage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sealed: 12 months in a cool dark place. Open after at least 4 weeks. Refrigerate once opened and use within 6 weeks."
          }
        ]
      }
    ]
