            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Soften the berries"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Put the blueberries and lemon juice in the jam pan over medium heat. Cook, stirring, until the berries burst and release their juice and about half have broken down, about 5 minutes. Mash with a spoon if you want a smoother jam."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Add sugar and boil"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Add the sugar and stir over low heat until dissolved. Raise to a full rolling boil and cook for 10 to 15 minutes without stirring. Test on a cold plate from 10 minutes. When the surface wrinkles, take off the heat, skim, rest 5 minutes, then ladle into hot sterilised jars and seal."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Colour fades to dull purple-grey",
              "cause": "Extended cooking destroys the anthocyanin pigments.",
              "fix": "Keep the boil as short as possible, test from 10 minutes. Colour fade is aesthetic only."
            },
            {
              "symptom": "Jam is too sweet",
              "cause": "Some commercial blueberry crops have very high natural sugar.",
              "fix": "Reduce sugar to 700 g per kg fruit and increase lemon juice by 1 tablespoon."
            },
            {
              "symptom": "Jam doesn't set",
              "cause": "Frozen-then-thawed blueberries can lose pectin.",
              "fix": "Add 1 tsp pectin dissolved in a tablespoon of lemon juice, return to the boil and test again."
            },
            {
              "symptom": "Jam is gritty",
              "cause": "Undissolved sugar.",
              "fix": "Stir over low heat until the sugar is completely clear before raising the temperature."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Storage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "12 months sealed. Refrigerate once opened."
          }
        ]
      }
