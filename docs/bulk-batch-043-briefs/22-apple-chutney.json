      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Combine everything and cook down"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Put all the ingredients into the pan. Stir over low heat until the sugar dissolves. Bring to a gentle simmer and cook uncovered, stirring every 5 to 10 minutes, for 50 to 60 minutes until the chutney is dark, thick, and reduced. The apple should have broken down almost completely. Draw a spoon across the base,  the line should hold cleanly."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Jar and seal"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ladle into hot sterilised jars immediately. Seal and invert for 2 minutes, then leave to cool upright. The chutney will thicken further as it cools."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Chutney is sticking and burning on the base",
              "cause": "Insufficient liquid at the end of the cook, or heat too high.",
              "fix": "Add a splash of vinegar and reduce the heat. Chutney needs watching in the last 15 minutes as it thickens."
            },
            {
              "symptom": "Chutney is watery after potting",
              "cause": "Not cooked long enough, liquid hasn't reduced sufficiently.",
              "fix": "Return to the pan and cook further, uncovered, until the line-in-the-pan test holds."
            },
            {
              "symptom": "Flavour is too sharp straight from the jar",
              "cause": "Just made, vinegar and spices need time to mellow.",
              "fix": "Rest for a minimum of 4 weeks before opening. The sharp vinegar edge softens considerably."
            },
            {
              "symptom": "Too sweet",
              "cause": "Very sweet dessert apples used instead of cooking apples.",
              "fix": "Use Bramleys or another cooking variety. If too sweet, add an extra 30 ml of malt vinegar."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Storage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sealed: 12 months in a cool dark place. Refrigerate once opened and use within 4 weeks."
          }
        ]
      }
    ]
