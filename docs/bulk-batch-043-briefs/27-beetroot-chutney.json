      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Combine and cook"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Put the grated beetroot, onion, apple, sugar, vinegar, ginger, and cinnamon into the pan. Stir over low heat until the sugar dissolves. Bring to a simmer and cook uncovered for 40 to 50 minutes, stirring regularly, until the mixture is thick and the liquid has reduced. The beetroot will hold some texture rather than dissolving completely."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Add horseradish and jar"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stir in the horseradish off the heat, if using. Ladle into hot sterilised jars immediately and seal. The horseradish is added off the heat to preserve some of its pungency."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Chutney has very little beetroot flavour",
              "cause": "Overcooked beetroot loses its earthy depth.",
              "fix": "Reduce cooking time to 35 minutes and taste, the beetroot flavour is stronger when the chutney isn't reduced too hard."
            },
            {
              "symptom": "Stains everything deep red during prep",
              "cause": "Beetroot pigment is very persistent.",
              "fix": "Wear gloves when grating raw or cooked beetroot. Use pre-cooked vacuum-packed beetroot (not in vinegar) to reduce handling."
            },
            {
              "symptom": "Horseradish flavour completely absent",
              "cause": "Horseradish added too early and cooked out.",
              "fix": "Always add horseradish off the heat, right before jarring."
            },
            {
              "symptom": "Too sweet",
              "cause": "Cooked beetroot is naturally sweet, and the apple adds to this.",
              "fix": "Reduce sugar to 200 g and add an extra 30 ml of red wine vinegar."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Storage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sealed: 12 months in a cool dark place. Refrigerate once opened and use within 4 weeks."
          }
        ]
      }
