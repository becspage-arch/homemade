      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Caramelise the onions"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Melt the butter with the oil in a large, wide, heavy-based pan over very low heat. Add the sliced onions and salt. Cook, stirring every 5 to 10 minutes, for 40 to 50 minutes until the onions are deeply golden brown, soft, and reduced to about a quarter of their original volume. This is the heart of the recipe,  patience here determines the depth of flavour."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Add sugar and vinegars, reduce"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Add the sugar, both vinegars, and the thyme. Stir until the sugar dissolves. Simmer uncovered for 30 to 35 minutes, stirring often, until thick and glossy. Remove the thyme."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Jar and seal"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ladle into hot sterilised jars while hot. Seal immediately and leave to cool."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Onions are still pale after 40 minutes",
              "cause": "Heat is too low, or the pan is too small and the onions are steaming rather than caramelising.",
              "fix": "Use a wide, heavy pan so moisture evaporates as the onions cook. Increase the heat very slightly, but watch carefully as they can burn quickly once they start to colour."
            },
            {
              "symptom": "Onions burned and bitter",
              "cause": "Heat too high, or left unattended.",
              "fix": "Caramelised onions cannot be rescued once burnt. Start again with fresh onions over lower heat."
            },
            {
              "symptom": "Chutney too sweet",
              "cause": "White onions caramelise to a very sweet base.",
              "fix": "Reduce sugar to 150 g and increase cider vinegar to 100 ml."
            },
            {
              "symptom": "Too sharp on opening day",
              "cause": "Vinegar needs time to integrate.",
              "fix": "Leave for at least 2 weeks before opening."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Storage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sealed: 12 months in a cool dark place. Refrigerate once opened and use within 4 weeks."
          }
        ]
      }
    ]
  }
