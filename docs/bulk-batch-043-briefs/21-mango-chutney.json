      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Cook the base"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Put the mustard seeds in the dry pan over medium heat and toast for 30 seconds until they pop. Add the onion, garlic, ginger, and a splash of vinegar. Cook over medium heat for 5 minutes until the onion softens."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Add mango and simmer until thick"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Add the mango, remaining vinegar, sugar, ground spices, chilli flakes, and salt. Stir over low heat until the sugar dissolves. Bring to a gentle simmer and cook uncovered for 40 to 45 minutes, stirring regularly, until the chutney is thick and jammy and the liquid has reduced. Draw a spoon across the base of the pan,  the line should hold for 3 seconds."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Jar and seal"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ladle into hot sterilised jars while still hot. Seal immediately and invert for 2 minutes, then right-way up to cool. Leave at least 2 weeks before opening for the flavour to mellow."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Chutney is too sweet",
              "cause": "Very ripe mangoes add more sugar than expected.",
              "fix": "Reduce sugar to 200 g or add an extra 30 ml of vinegar to sharpen the balance."
            },
            {
              "symptom": "Chutney is too sharp",
              "cause": "Underripe mangoes and full sugar-to-vinegar ratio.",
              "fix": "Add 30 g more sugar. Taste after simmering and adjust before jarring."
            },
            {
              "symptom": "Watery texture even after 45 minutes",
              "cause": "Very juicy mangoes released more liquid than expected.",
              "fix": "Continue cooking uncovered, chutney thickens as liquid evaporates. Allow up to 60 minutes total."
            },
            {
              "symptom": "Chutney tastes raw and harsh on opening day",
              "cause": "Just made, the spices haven't mellowed into the fruit.",
              "fix": "Leave sealed for at least 2 weeks. Mango chutney always improves with jar-resting."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Storage"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sealed: 12 months in a cool dark place. Refrigerate once opened and use within 4 weeks."
          }
        ]
      }
    ]
  }
