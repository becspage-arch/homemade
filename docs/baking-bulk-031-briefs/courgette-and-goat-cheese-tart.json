      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toss the courgette slices with the salt and leave in a colander for 30 minutes. Rinse briefly and pat very dry with kitchen paper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the pastry: rub cold butter into flour until crumbly. Add the egg yolk and cold water and press into a dough. Chill 30 minutes. Roll to 3 mm and line a 23 cm tart tin. Chill 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oven to 200 degrees C (fan 180 degrees C / gas 6). Blind-bake the pastry with paper and beans for 15 minutes, remove the paper and beans, brush the base with the reserved egg white, and bake a further 8 minutes until pale golden and dry. Reduce the oven to 180 degrees C (fan 160 degrees C / gas 4)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk together the goat's cheese, double cream, and eggs until smooth. Season lightly (the cheese is already salty). Stir in the thyme leaves."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the custard into the pastry case. Arrange the courgette slices over the top in overlapping concentric circles, pressing them lightly into the custard."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 30 to 35 minutes until the custard is just set with no wobble in the centre and the courgette edges have started to colour. Leave to rest 15 minutes before slicing."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Watery custard with a pool of liquid around the filling",
              "avoid": "Avoid skipping the salting and drying step for the courgette; unsalted courgette releases significant water during baking.",
              "fix": "Pat the courgette very dry before arranging. If the tart weeps liquid despite this, bake for a further 5 minutes to drive off the moisture."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Goat's cheese lumpy in the custard rather than smooth",
              "avoid": "Avoid using a firm or aged goat's cheese; it will not blend smoothly into the custard.",
              "fix": "Use a soft, rindless fresh goat's cheese (chevre style). Whisk vigorously until the custard is completely smooth before pouring."
            }
          }
        ]
      }
    ]
  }
