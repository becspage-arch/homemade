      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Poach the pears: put the sugar, water, cinnamon stick, star anise, and vanilla extract in a saucepan and bring to the boil to dissolve the sugar. Add the pear halves and simmer gently for 20 to 25 minutes until tender through when pierced with a skewer. Leave to cool in the syrup."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the pastry: rub cold butter into flour and icing sugar, add egg yolks, press into a dough. Chill 30 minutes. Roll to 3 mm, line a 23 cm tart tin, chill 20 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat oven to 190 degrees C (fan 170 degrees C / gas 5). Blind-bake the pastry case with paper and beans for 15 minutes, then remove paper and beans and bake a further 8 minutes until dry. Reduce oven to 180 degrees C (fan 160 degrees C / gas 4)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the almond cream: beat softened butter and caster sugar until pale. Beat in eggs one at a time. Fold in ground almonds and flour."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Lift the pear halves from the syrup and pat dry. Spread the almond cream over the base. Arrange the pear halves over the almond cream, pressing down lightly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 35 to 40 minutes until the almond cream is set and deep golden. Cool in the tin 20 minutes before unmoulding."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Pears sinking through the almond cream during baking",
              "avoid": "Avoid using very soft or overripe pears; they will disintegrate in the filling.",
              "fix": "Use firm pears, barely ripe, for poaching. They will soften during poaching but hold their shape through baking. Pat the poached pears very dry before pressing into the almond cream."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Almond cream raw and wet in the centre",
              "avoid": "Avoid underbaking; the almond cream takes longer to set than it looks.",
              "fix": "Test with a skewer in the almond cream (avoiding the pear); it should come out with just a few damp crumbs, not wet batter. Give it another 5 minutes if still wet."
            }
          }
        ]
      }
    ]
