      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the pastry: rub butter into flour and icing sugar until crumbly. Add egg yolks and press into a dough. Wrap and chill 30 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll to 3 mm and line a 23 cm tart tin. Chill 20 minutes. Heat the oven to 190 degrees C (fan 170 degrees C / gas 5). Blind-bake with baking paper and beans for 15 minutes, remove paper and beans, then bake a further 8 minutes until dry. Cool slightly."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reduce the oven to 175 degrees C (fan 155 degrees C / gas 4). Beat together the ricotta, honey, eggs, and vanilla extract until smooth."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pour the filling into the pastry case. Arrange the fig halves over the filling, pressing them lightly into the surface."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 30 to 35 minutes until the filling is just set with a slight wobble in the very centre. It will firm up as it cools. Leave to cool in the tin for at least 20 minutes before slicing. Drizzle with a little extra honey to serve."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "content": [
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Filling cracks across the surface",
              "avoid": "Avoid overbaking; a ricotta filling cracks if the centre sets completely in the oven.",
              "fix": "Remove when there is still a slight wobble in the very centre. The residual heat of the tin will set the centre as it cools."
            }
          },
          {
            "type": "troubleshooterItem",
            "attrs": {
              "problem": "Figs watery and releasing juice into the filling",
              "avoid": "Avoid very wet figs or figs that are overripe to the point of being burst.",
              "fix": "Pat the fig cut surfaces dry with kitchen paper before pressing into the filling. Bake for the full time; the released juice evaporates during baking."
            }
          }
        ]
      }
    ]
