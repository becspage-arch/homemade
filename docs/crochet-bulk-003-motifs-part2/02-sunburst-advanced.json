  "glossaryTerms": [
    {
      "slug": "treble-cluster",
      "term": "Treble cluster",
      "definition": "Three trebles worked into the same space and drawn together at the top. Forms the six radiating spokes in the sunburst centre."
    },
    {
      "slug": "shell-stitch",
      "term": "Shell",
      "definition": "Five (or any odd number of) trebles worked into the same base stitch, fanning outward. The shell border in round 4 fills the spaces between the sunburst spokes."
    }
  ],
