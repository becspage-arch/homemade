      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Marinate the chicken"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mix all the marinade ingredients together in a large bowl. Add the chicken pieces and turn to coat thoroughly. Cover and refrigerate for at least 2 hours, or overnight."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the toum"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Place the garlic and salt in a food processor or blender and blend to a fine paste. With the motor running, pour in the oil very slowly in a thin stream, adding a few drops of lemon juice and a drop of ice water alternately as you go. This creates an emulsion similar to mayonnaise. The finished toum should be white, thick, and fluffy. Season and refrigerate until needed."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Grill and serve"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thread the marinated chicken onto metal skewers. Heat a griddle pan to its highest setting. Grill the skewers for 4 to 5 minutes per side until the chicken is charred in places and cooked through. Rest for 5 minutes. Serve with toum, flatbread, and a simple tomato and herb salad."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Chicken sticking to the griddle",
              "cause": "Griddle not hot enough or moved too soon",
              "fix": "Heat the griddle for at least 5 minutes before adding the chicken. Do not move the pieces until they release naturally."
            },
            {
              "symptom": "Toum splits and becomes liquid",
              "cause": "Oil added too quickly",
              "fix": "Pour the oil in the thinnest possible stream. If it splits, start again with a fresh garlic base and drizzle the split toum in slowly."
            },
            {
              "symptom": "Chicken dry",
              "cause": "Overcooked or breast meat used",
              "fix": "Use boneless thigh. Check at 4 minutes per side; it should reach 74 C internal temperature and be pulled promptly."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Variations"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Shish tawook can be served as a wrap in flatbread with pickles and shredded lettuce, like a shawarma. The toum also works as a sauce for grilled vegetables or roasted potatoes."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Make ahead"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The toum keeps in the fridge for 2 weeks. The chicken marinade can be applied up to 24 hours ahead. Grill the skewers fresh just before serving."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Shish tawook is sold at grills and restaurants across Lebanon, Syria, and Jordan. In Beirut it is as common as a grilled chicken sandwich is in the UK. The dish has spread through the Lebanese diaspora and is found in Lebanese restaurants in cities worldwide. The combination of yoghurt-marinated chicken and toum is one of the defining flavour pairs of Levantine cooking."
          }
        ]
      }
    ]
  }
