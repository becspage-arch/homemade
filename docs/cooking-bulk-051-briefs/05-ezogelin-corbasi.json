      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Fry the base"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Warm the olive oil in the large pan over a medium heat. Add the onion and cook for 8 minutes until soft and starting to colour. Add the tomato puree, paprika, and cumin, stir well, and cook for 2 minutes until the puree darkens slightly."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Simmer the lentils and bulgur"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the lentils, bulgur, stock, and salt. Bring to the boil, then reduce the heat to a steady simmer. Cook for 25 to 30 minutes, stirring occasionally, until the lentils have completely dissolved and the bulgur is soft. The soup should be thick and spoonable but still pourable. Add a splash of water if it becomes too stiff."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Finish and serve"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Stir in the lemon juice. Taste and adjust the salt. Melt the butter in the small pan, stir in the Aleppo pepper and dried mint, and pour a little over each bowl just before serving."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Soup too thick to pour",
              "cause": "Bulgur has absorbed too much liquid",
              "fix": "Add hot water or stock, stir well over the heat for a minute to loosen."
            },
            {
              "symptom": "Bulgur still has bite",
              "cause": "Not cooked long enough",
              "fix": "Continue simmering; fine bulgur needs 25 to 30 minutes to soften fully in a thick base."
            },
            {
              "symptom": "Tastes flat",
              "cause": "Not enough salt or no lemon juice",
              "fix": "Adjust salt and add lemon; the acidity makes a significant difference to this soup."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Variations"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Some versions include a small amount of rice alongside the bulgur. For a smoky note, add a teaspoon of smoked paprika to the base with the sweet paprika. Serve with a slice of lemon and dried chilli on the side."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Make ahead"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Keeps in the fridge for 4 days and freezes for 3 months. The soup thickens considerably when cold. Add a few tablespoons of water when reheating and stir over a gentle heat."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ezogelin corbasi is named after Ezo, a bride from Nizip in southeastern Turkey whose story became part of Turkish folklore. The soup is a staple of southeastern Anatolia and is now served all over the country. It is especially good in winter."
          }
        ]
      }
    ]
  }
