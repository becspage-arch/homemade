      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Cook the base"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Warm the olive oil in the large pan over a medium heat. Add the onion and carrot and cook for 8 minutes, stirring often, until softened. Add the garlic, tomato puree, cumin, and paprika and stir for 1 minute until fragrant."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Simmer the lentils"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the rinsed lentils and the stock. Bring to the boil, then reduce the heat and simmer for 20 to 25 minutes until the lentils have completely dissolved and the carrot is very soft. Stir in the salt."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Blend and finish"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Use the stick blender to blitz the soup until completely smooth. Taste and add the lemon juice gradually; the soup should be bright and savoury. Adjust salt. For each serving, melt the butter in the small pan over a medium heat until foaming, stir in the Aleppo pepper, and pour immediately over each bowl."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Soup too thick",
              "cause": "Lentils absorbed all the liquid",
              "fix": "Add water or stock and stir well; the soup thickens as it sits and this is easily corrected."
            },
            {
              "symptom": "Grainy texture",
              "cause": "Under-blended or carrots not soft enough",
              "fix": "Blend for longer and ensure the carrot is completely tender before blending."
            },
            {
              "symptom": "Flat flavour",
              "cause": "Under-seasoned or no lemon juice",
              "fix": "Season generously and do not skip the lemon; it lifts the whole soup."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Variations"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Add a teaspoon of ground coriander or a pinch of turmeric for a deeper colour. Some versions include a diced potato with the carrot for extra body. For a vegan version, replace the butter finish with good olive oil drizzled over each bowl."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Make ahead"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The soup keeps for 4 days in the fridge and freezes for 3 months. Make the butter fresh when serving; it takes under 2 minutes and cannot be made ahead."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mercimek corbasi is served in every Turkish lokanta as the first course before the main meal. It also appears as a Ramadan opener at iftar, the fast-breaking meal at sunset. The soup is simple enough to cook daily and good enough to eat happily every time."
          }
        ]
      }
    ]
  }
