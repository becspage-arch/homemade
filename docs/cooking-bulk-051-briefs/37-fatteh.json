      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Toast the bread"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Preheat the oven to 200 C. Brush the torn flatbread pieces with olive oil, spread on a baking sheet, and toast for 10 to 12 minutes until golden and crisp. Set aside."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Warm the chickpeas"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Place the chickpeas in a small saucepan with the stock, allspice, and salt. Warm over medium heat for 5 to 8 minutes until hot through. They should be slightly saucy, not dry."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the yoghurt sauce"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mix the yoghurt, crushed garlic, lemon juice, salt, and tahini if using until smooth and combined. Taste and adjust the lemon and salt."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Assemble"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Spread the toasted bread across a large, wide serving dish. Spoon the warm chickpeas and their liquid evenly over the bread. Pour the yoghurt sauce over everything. Scatter the toasted pine nuts on top. Drizzle with olive oil and dust with paprika. Add chopped parsley if using. Serve immediately."
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "rows": [
            {
              "symptom": "Bread completely soft rather than having any texture",
              "cause": "Assembled too early or bread pieces too small",
              "fix": "Assemble within 5 minutes of serving. Tear the bread into larger pieces so the edges stay crisp longer."
            },
            {
              "symptom": "Yoghurt sauce too sharp",
              "cause": "Yoghurt very acidic or too much lemon",
              "fix": "Start with 1 tablespoon of lemon juice and taste before adding more. Adding tahini softens the sharpness."
            },
            {
              "symptom": "Chickpeas dry",
              "cause": "Too much stock evaporated",
              "fix": "The chickpeas need a little liquid; keep them moist. Add a splash of warm water when assembling if they look dry."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Variations"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Add a layer of cooked aubergine below the yoghurt for a more substantial dish. In Egypt, a red tomato sauce is sometimes added as an additional layer between the chickpeas and yoghurt."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Make ahead"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Toast the bread up to 2 hours ahead and keep in an airtight container. Warm the chickpeas and make the yoghurt sauce up to an hour ahead. Assemble just before serving so the bread stays intact."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Fatteh appears at breakfast and lunch tables across Lebanon, Syria, Jordan, and Egypt. It is sold at food stalls and eaten at home, and is particularly popular during Ramadan as a filling breakfast after the fast. The combination of bread, pulses, and yoghurt is ancient and practical: nothing goes to waste and the dish is built from store-cupboard ingredients."
          }
        ]
      }
    ]
  }
