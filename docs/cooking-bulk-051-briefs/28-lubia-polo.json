      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Cook the filling"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the butter in a wide heavy pot over medium heat. Add the onion and cook for 8 minutes until golden. Add the lamb, turmeric, and cinnamon. Brown the lamb on all sides for 5 minutes. Stir in the tomato puree and water, add salt, cover, and cook on a low simmer for 40 minutes until the lamb is very tender. Add the green beans and cook for a further 10 minutes. The filling should be fairly dry with just a small amount of thick sauce."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Parboil the rice"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring a large pot of well-salted water to the boil. Drain the soaked rice and add to the boiling water. Cook for 6 minutes until partially cooked: no longer chalky but firm at the centre. Drain and rinse with cold water."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Steam the polo"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the butter in the heavy pot over medium heat. Mix the yoghurt with 2 large spoonfuls of rice and spread over the base to form the tahdig. Alternate layers of rice and the lamb-bean filling, mounding towards the top. Drizzle the saffron water over. Wrap the lid in a tea towel, cover tightly, and cook over medium heat for 5 minutes until you hear a gentle sizzle. Reduce to the lowest heat and steam for 40 minutes. To serve, invert onto a large plate."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Tahdig burnt",
              "cause": "Heat too high after the initial sizzle",
              "fix": "Reduce to absolute minimum heat once the steam is established. A heat diffuser helps if available."
            },
            {
              "symptom": "Filling too wet",
              "cause": "Lamb released too much juice",
              "fix": "Uncover the filling pot and cook briefly on a higher heat to reduce before layering with the rice."
            },
            {
              "symptom": "Rice layers not distinct",
              "cause": "Rice stirred during layering",
              "fix": "Build the layers carefully and do not stir once assembled; the distinct layering reveals itself when inverted."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Variations"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Replace the lamb with chicken thighs for a lighter version. For a vegetarian lubia polo, use chickpeas in place of lamb and add a pinch of smoked paprika to compensate for the missing richness."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Make ahead"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The lamb and bean filling is best made a day ahead; the flavours deepen overnight. Parboil and steam the rice fresh on the day of serving."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Lubia polo is part of the large family of Persian polo dishes in which rice is cooked together with a filling. Each polo has its own season: sabzi polo in spring, albaloo polo in summer, lubia polo as an everyday family dish throughout the year. It is a standard part of the Persian home cook's repertoire."
          }
        ]
      }
    ]
  }
