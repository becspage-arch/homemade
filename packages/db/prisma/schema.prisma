// Homemade Prisma schema.
//
// Conventions:
// - cuid IDs everywhere
// - createdAt + updatedAt timestamps on every mutable row
// - soft-delete-by-status rather than physical deletes for content tables
// - body fields are JSON (TipTap document)
//
// Schema is incremental — start with the tutorial spine; add Recipe / Pattern /
// Review / Q&A / UserProject / Marketplace / Creator / Errata models in later
// phases as they become needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────────────────
// Users — Clerk shadow + role
// ────────────────────────────────────────────────────────────────────────────

model User {
  id      String   @id @default(cuid())
  clerkId String   @unique
  email   String   @unique
  name    String?
  role    UserRole @default(MEMBER)

  // Reader-side preferences and profile
  beginnerMode  Boolean @default(false)
  displayHandle String? @unique
  bio           String?

  // Suspension state (Phase 5). `isSuspended` is the convenience flag the
  // moderation flow toggles; `suspendedUntil` mirrors the active UserSuspension's
  // end. Both are denormalised so filtering doesn't need a join.
  isSuspended    Boolean   @default(false)
  suspendedUntil DateTime?

  // Legal compliance (Phase 8a). `cookieConsent` is the persisted version of
  // the cookie banner's decision (mirrored to localStorage); null = the
  // banner hasn't been answered for this account yet. `deletionScheduledFor`
  // is set while a 30-day deletion grace period is in flight. `deletedAt`
  // marks the row as soft-deleted (PII scrubbed, audit-log entries retained).
  // `hardDeletedAt` is the bookkeeping stamp the daily hard-delete cron sets
  // when it actually scrubs the account — distinct from `deletedAt` so we
  // can differentiate "scrubbed by user request via the cron" from any
  // future admin-initiated soft-delete that might reuse `deletedAt`.
  cookieConsent        Json?
  deletionScheduledFor DateTime?
  deletedAt            DateTime?
  hardDeletedAt        DateTime?

  // Creator program (Phase 6). `isCreator` is the denormalised flag set when
  // an application is approved; the full profile lives in `CreatorProfile`.
  // `isPatternTester` flips on when a member opts in to the tester pool.
  isCreator         Boolean   @default(false)
  creatorVerifiedAt DateTime?
  isPatternTester   Boolean   @default(false)

  // Premium entitlement (gating framework — Session E). `premiumActive` is the
  // single source of truth read by `hasPremium()`; everything gated (Studio on
  // premium content, all printing/downloading, recipe scaling + planning suite,
  // create-your-own, designer content) checks it. `premiumSince` / `premiumUntil`
  // are nullable and unused until Stripe billing (Session F) populates all three
  // from webhooks; until then `premiumActive` is toggled from the admin user page
  // to test gated flows. Indexed so admin can filter members by entitlement.
  premiumActive Boolean   @default(false)
  premiumSince  DateTime?
  premiumUntil  DateTime?

  // Stripe billing (Session F). `stripeCustomerId` links this Maker to their
  // Stripe Customer so the Customer Portal + repeat checkouts reuse one
  // customer. Set the first time a checkout completes for this account.
  // Nullable + unique: most rows never buy; the ones that do hold exactly one.
  // `Subscription` rows mirror Stripe's subscription objects so we OWN billing
  // state in our DB (continuity safeguard #1 — a Stripe outage never loses who
  // is a member or their renewal date). `premiumActive` stays the single
  // entitlement source `hasPremium()` reads; the webhook keeps it in step.
  stripeCustomerId String?        @unique
  subscriptions    Subscription[]

  // Analytics — acquisition + cohort plumbing. All nullable: existing users
  // pre-date the capture and that's fine. Captured client-side on first visit
  // (localStorage) and persisted here on first signup (Clerk webhook).
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  acquisitionChannel String?
  signupCohortWeek   String?
  country            String?
  deviceClass        String?

  // Phase 8 Homepage rebuild — onboarding + personalisation. `onboardedAt`
  // null = the onboarding card still shows on the homepage. `primaryCategoryIds`
  // / `experienceLevel` / `dietaryFlags` come from the onboarding card and
  // weight the personalised rails. `homeCountryCode` is captured from
  // Cloudflare's `cf-ipcountry` header at signup and steers the seasonality
  // engine; the user can override later from settings. `lastSeenAt` powers
  // the "New since you last visited" rail.
  onboardedAt        DateTime?
  primaryCategoryIds String[]         @default([])
  experienceLevel    ExperienceLevel?
  homeCountryCode    String?
  dietaryFlags       String[]         @default([])
  lastSeenAt         DateTime?

  // Mobile rebuild — push + cooking mode preferences. `pushNotificationsEnabled`
  // is the master toggle (false until the user accepts the opt-in prompt that
  // appears after their first started UserProject). Per-category opt-outs live
  // on the individual PushSubscription rows so a user can be opted in on iOS
  // and not on Android, or opted in for project reminders but not the weekly
  // digest. `cookingModeAutoEnable` makes recipe pages open straight into the
  // stripped-down cooking-mode reader on mobile.
  pushNotificationsEnabled Boolean @default(false)
  cookingModeAutoEnable    Boolean @default(false)

  // Maker profile (Session A — language rebrand + public profile). Every user
  // is a Maker; `isPublicMakerProfile` opts the account into the public
  // `/m/{handle}` page. `displayHandle` (above) is reused as the URL handle —
  // it predates the rebrand and is already unique-indexed. `bio` (above) is
  // the public profile bio. `makerHeaderImageId` is an optional cover image
  // (Media row). `makerJoinedAt` is the public "Maker since" stamp; defaults
  // to createdAt at backfill and at row insert.
  isPublicMakerProfile Boolean   @default(false)
  makerHeaderImageId   String?
  makerHeaderImage     Media?    @relation("UserMakerHeader", fields: [makerHeaderImageId], references: [id])
  makerJoinedAt        DateTime?

  // Session A addendum — handle change rate-limit (one change per 90 days
  // after first set) + the "Did you make this?" prompt dismissal map.
  // `dismissedDidYouMakeThis` is `{ tutorialId: ISO-8601 string }`; entries
  // older than 7 days are ignored at read time, no write-side cleanup needed.
  lastHandleChangeAt      DateTime?
  dismissedDidYouMakeThis Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutorialsAuthored Tutorial[]        @relation("TutorialAuthor")
  tutorialsCreated  Tutorial[]        @relation("TutorialCreator")
  versions          TutorialVersion[] @relation("VersionAuthor")
  auditLogs         AuditLog[]
  bookmarks         Bookmark[]
  savedPatterns     SavedPattern[]
  savedRecipes      SavedRecipe[]
  projects          UserProject[]

  reviews            Review[]
  reviewHelpfuls     ReviewHelpful[]
  ugcPhotos          UGCPhoto[]
  questions          Question[]
  answers            Answer[]
  questionUpvotes    QuestionUpvote[]
  errata             Errata[]         @relation("ErrataAuthor")
  errataResolved     Errata[]         @relation("ErrataResolver")
  reportsFiled       Report[]         @relation("ReportReporter")
  reportsResolved    Report[]         @relation("ReportResolver")
  suspensions        UserSuspension[] @relation("SuspensionSubject")
  suspensionsApplied UserSuspension[] @relation("SuspensionActor")
  suspensionsLifted  UserSuspension[] @relation("SuspensionLifter")
  notifications      Notification[]
  reviewsModerated   Review[]         @relation("ReviewModerator")
  photosModerated    UGCPhoto[]       @relation("PhotoModerator")

  creatorProfile   CreatorProfile?  @relation("CreatorProfileOwner")
  creatorDecisions CreatorProfile[] @relation("CreatorProfileDecider")
  patternTests     PatternTest[]
  testAssignments  TestAssignment[]

  dataExportRequests     DataExportRequest[]
  accountDeletionRequest AccountDeletionRequest?
  dmcaResolutions        DmcaTakedownRequest[]   @relation("DmcaResolver")
  signupAllowlistAdded   SignupAllowlist[]       @relation("SignupAllowlistAddedBy")

  // Admin overhaul — saved filters + cmd-K command history.
  savedFilters        SavedFilter[]         @relation("SavedFilterOwner")
  adminCommandHistory AdminCommandHistory[] @relation("AdminCommandActor")

  // Phase 8 Step 13 — Mindset
  mindsetPlans      UserPlan[]
  mindsetDailyPicks DailyPick[]
  practiceFavorites UserPracticeFavorite[]
  practiceUses      UserPracticeUse[]

  // Mobile rebuild — registered push devices (one per platform per install).
  pushSubscriptions PushSubscription[]

  // Session A addendum — Maker of the Month editorial picks (a User can be
  // featured many times; an admin User can pick many MOTM rows).
  makerOfTheMonthEntries MakerOfTheMonth[] @relation("MakerOfTheMonthFeatured")
  makerOfTheMonthPicks   MakerOfTheMonth[] @relation("MakerOfTheMonthPicker")

  // Session A addendum — tutorial-visit tracker for the "Did you make this?"
  // smart prompt. Counts page-views per (user, tutorial); only rows for
  // signed-in Makers exist.
  tutorialVisits TutorialVisit[]

  // Chart-viewer rebuild (2026-05-20). Per-user mark-stitched / mark-row
  // state for every chart the reader has touched. Charts require auth to
  // view at all; this is the persistence layer.
  chartProgress ChartProgress[]

  // Chart-viewer user-level preferences — applied to every chart the
  // user views. JSON shape: { gridColor?: string, gridWeightScale?:
  // number (0.5–2), showCentreLines?: boolean }. Null = built-in
  // defaults. Set via /api/me/preferences/chart-viewer.
  chartViewerPrefs Json?

  // ──────────────────────────────────────────────────────────────────────────
  // Location + climate (phase_location_climate_paper_001). Drives the
  // gardening renderer's silent month / frost-date customisation and the
  // pattern-page paper-size selector. All nullable: the renderer falls back
  // to the country-default row in `CountryClimate` when a user-level value
  // isn't set, and to the friendly "Where this works best" card when even
  // the country code is missing.
  //
  //   hemisphere          — 'N' | 'S'. Drives 6-month transposition.
  //   koppenZone          — e.g. 'Cfb' (oceanic UK). Indexes country climate.
  //   usdaHardinessZone   — '1a'..'13b'. US / Canada gardening lookup.
  //   rhsHardinessZone    — 'H1a'..'H7'. RHS gardening lookup.
  //   lastFrostDate       — month-day this year. Drives "plant after X" copy.
  //   firstFrostDate      — month-day this year. Drives "last harvest before X" copy.
  //
  // The existing `country` + `homeCountryCode` columns stay the canonical
  // country code; new code should read `homeCountryCode` (captured at
  // signup from cf-ipcountry); `country` is the older analytics column
  // and is kept for back-compat.
  // ──────────────────────────────────────────────────────────────────────────
  hemisphere        String?
  koppenZone        String?
  usdaHardinessZone String?
  rhsHardinessZone  String?
  lastFrostDate     String?
  firstFrostDate    String?

  // ──────────────────────────────────────────────────────────────────────────
  // Pattern Studio (phase_pattern_studio_001). `paperSize` was promoted
  // from a nullable String to a non-null PaperSize enum (A4 default).
  // `studioPreferences` is a per-user JSON bag for Studio UI state that
  // doesn't deserve its own column (zoom-on-open, palette panel pinned,
  // floss-key sort order, last-used brush size). `defaultFabricCount` /
  // `defaultBrand` / `defaultStrands` are the new-pattern + photo-to-
  // chart starting defaults; user can override per pattern.
  // ──────────────────────────────────────────────────────────────────────────
  paperSize          PaperSize  @default(A4)
  studioPreferences  Json?
  defaultFabricCount Int        @default(14)
  defaultBrand       FlossBrand @default(DMC)
  defaultStrands     Int        @default(2)

  // ──────────────────────────────────────────────────────────────────────────
  // Crochet Studio (phase_crochet_pattern_001). Per-user crochet preferences
  // and personal-inventory entries the Studio uses for substitution maths
  // and pattern presentation.
  //
  //   myHooks                       — slug refs to CrochetHook rows the user
  //                                    owns. Surfaces in the substitution
  //                                    helper ("you own a 3.5 mm Tulip Etimo").
  //   myYarns                       — Json stash entries. Free-form schema for
  //                                    v1: { id, name, weightSlug, yardage,
  //                                    leftoverYardage, colourHex, photoMediaId,
  //                                    notes }. Promoted to a real table only
  //                                    if query patterns demand it.
  //   myColourSchemes               — Json. Saved schemes — { id, name, colours[],
  //                                    sourceCrochetPatternId }. Mirrors the
  //                                    CrochetColourScheme model and stays in
  //                                    sync at write-time; this denormalised
  //                                    form is what the Studio reads.
  //   crochetLeftHanded             — true mirrors the chart horizontally and
  //                                    swaps direction-of-work in instructions
  //                                    that reference it.
  //   crochetTerminologyPreference  — 'uk' | 'us' | null. Null = use the
  //                                    pattern's declared terminologyConvention
  //                                    as the initial state of the toggle.
  // ──────────────────────────────────────────────────────────────────────────
  myHooks                      String[] @default([])
  myYarns                      Json?
  myColourSchemes              Json?
  crochetLeftHanded            Boolean  @default(false)
  crochetTerminologyPreference String?

  // Pattern Studio reverse relations.
  patterns        Pattern[]             @relation("PatternOwner")
  patternProgress UserPatternProgress[]
  designerProfile Designer[]            @relation("DesignerUser")

  // Cross-craft project + materials planner (phase_pattern_planner_001).
  // Generic, category-agnostic: a project references a pattern by
  // (craft, patternId) so every craft's pattern model can attach.
  plannerProjects PlannerProject[]
  plannerStash    PlannerStashItem[]

  // Crochet Studio reverse relations.
  crochetPatterns              CrochetPattern[]              @relation("CrochetPatternOwner")
  crochetProjectProgress       CrochetProjectProgress[]
  crochetProjectGauges         CrochetProjectGauge[]
  crochetStitchMarkers         CrochetStitchMarker[]
  crochetProjectRepeatCounters CrochetProjectRepeatCounter[]
  crochetColourSchemes         CrochetColourScheme[]

  // Needlework Studio personal inventory and preferences.
  // myNeedleworkThreads: JSON array of owned thread entries.
  // myNeedleworkTools: JSON array of hoops, frames, and other tools.
  // needleworkDisciplinePreference: which sub-discipline the user
  //   primarily works in (free text slug, e.g. "blackwork").
  myNeedleworkThreads            Json?
  myNeedleworkTools              Json?
  needleworkDisciplinePreference String?

  // Needlework Studio reverse relations.
  needleworkPatterns        NeedleworkPattern[]         @relation("NeedleworkPatternOwner")
  needleworkProjectProgress NeedleworkProjectProgress[]

  // Knitting Studio reverse relations (phase_knitting_pipeline_001).
  knittingPatterns        KnittingPattern[]         @relation("KnittingPatternOwner")
  knittingProjectProgress KnittingProjectProgress[]
  knittingStash           KnittingStash[]

  // User pattern photo submissions (phase_user_pattern_photo_001).
  userPatternPhotos       UserPatternPhoto[] @relation("UserPatternPhotoOwner")
  userPatternPhotoReviews UserPatternPhoto[] @relation("UserPhotoReviewer")

  // Sewing pre-S-2 (phase_sewing_measurements_planner_001). User-wide
  // measurement display preference applied across every renderer that
  // shows a body / fabric measurement. Canonical storage stays cm + mm
  // everywhere per the locked units rule; this flag only switches the
  // displayed unit at render time. Null = default to cm.
  measurementPreference String?

  // Recipe foundation (phase_recipe_foundation_001). Cross-craft cooking-unit
  // display preferences. Canonical storage stays conventional °C + grams + ml
  // per the locked temperature/units rule; these only switch the *displayed*
  // unit at render time and never re-author content. Null = the renderer
  // derives a default from the request locale (en-GB → fan °C + grams + UK
  // cups; en-US → °F + US cups; everywhere else → metric).
  ovenPreference   OvenPreference?
  weightPreference WeightPreference?
  volumePreference VolumePreference?

  // Sewing pre-S-2 reverse relations.
  sewingMeasurements UserSewingMeasurements?
  sewingPlans        UserSewingPlan[]

  // Sewing S-2 reverse relations.
  sewingPatternProjects         SewingPatternProject[]
  sewingPatternPersonalisations SewingPatternPersonalisation[]

  // Sewing S-6 reverse relations.
  sewingPatternHacks SewingPatternHack[]

  // Recipe foundation. User-uploaded recipes the Maker owns.
  userRecipes UserRecipe[] @relation("UserRecipeOwner")

  // Meal plan. The Maker's weekly recipe calendars.
  mealPlans MealPlan[] @relation("MealPlanOwner")

  // Shopping list. The Maker's synced working shopping list (free sign-in carrot).
  shoppingListState ShoppingListState?

  @@index([role])
  @@index([isSuspended])
  @@index([isCreator])
  @@index([onboardedAt])
  @@index([lastSeenAt])
  @@index([isPublicMakerProfile])
  @@index([premiumActive])
}

/// Mirror of a Stripe Subscription object (Session F — Stripe billing).
///
/// We own billing state in our own DB so a Stripe loss never loses who is a
/// member or when they renew (continuity safeguard #1 from the business model).
/// The Stripe webhook is the only writer: it upserts on `stripeSubscriptionId`
/// for every checkout.session.completed and customer.subscription.* /
/// invoice.* event, and `lib/stripe/sync.ts` recomputes the owning User's
/// `premiumActive` / `premiumUntil` from `status` each time.
///
/// `status` mirrors Stripe verbatim (active, trialing, past_due, canceled,
/// unpaid, incomplete, incomplete_expired, paused) as a plain String rather
/// than a Prisma enum so a new Stripe status never breaks the webhook.
/// `plan` ('monthly' | 'annual') and `currency` ('gbp' | 'usd') are resolved
/// back from the price id so admin + analytics don't have to re-derive them.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  stripePriceId        String
  status               String
  plan                 String?
  currency             String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  // Set when Stripe reports the subscription fully canceled (the deleted
  // event), distinct from cancelAtPeriodEnd which is a pending end-of-period
  // cancellation the user can still undo from the portal.
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  CONFIDENT
}

enum UserRole {
  ANONYMOUS
  MEMBER
  CREATOR
  TESTER
  EDITOR
  ADMIN
}

// Recipe foundation (phase_recipe_foundation_001). Cross-craft cooking unit /
// temperature display preferences. Canonical storage is always conventional °C
// + grams + ml; these only pick the render-time display per the locked
// temperature/units rule. The enum shape mirrors that locked memo
// (OvenPreference / WeightPreference / VolumePreference) rather than collapsing
// oven + scale + jug into one toggle, because UK readers routinely mix fan °C
// with grams while US readers mix °F with cups.
enum OvenPreference {
  FAN_C
  CONVENTIONAL_C
  FAHRENHEIT
  GAS_MARK
}

enum WeightPreference {
  METRIC
  IMPERIAL
}

enum VolumePreference {
  METRIC
  IMPERIAL_UK
  IMPERIAL_US
}

// ────────────────────────────────────────────────────────────────────────────
// Taxonomy — Category / SubCategory / Tag
// ────────────────────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  introBody   Json? // Rich content (TipTap) for the editorial intro
  order       Int     @default(0)

  // Multi-category fill plan (phase_categories_targets_001).
  // `targetTutorialCount` is the eventual library size for this category from
  // `BUILD_PROGRESS.md` § "Multi-category fill plan". Null = no target set.
  // `isPublicVisible` controls whether the category surfaces in public nav,
  // browse grids, and category pages. New categories with < 10 published
  // tutorials default to false; the publish path flips it to true once the
  // threshold is crossed. Admin sees every category regardless.
  // `launchOrder` orders the public nav rotation (1 = first spine, …) — used
  // by the "5 spine + overflow" header pattern.
  targetTutorialCount Int?
  isPublicVisible     Boolean @default(true)
  launchOrder         Int?

  // Single-queue autopilot (phase_autopilot_single_queue_001).
  // `pipelineStatus` gates whether the round-robin queue cron picks this
  // category. NOT_READY = no authoring prompt / master entities yet;
  // READY = the queue may fire batches against it; PAUSED = temporarily
  // skipped without disabling the cron; COMPLETE = published count has
  // hit `targetTutorialCount` and the publish path auto-flipped it.
  // `lastAutopilotRunAt` is set to now() at the start of each batch so
  // the round-robin sort picks the least-recently-fired READY category
  // next. `autopilotWeight` is reserved for future weighted round-robin
  // (each weight unit = one slot per cycle); default 1 means strict
  // round-robin.
  pipelineStatus     PipelineStatus @default(NOT_READY)
  lastAutopilotRunAt DateTime?
  autopilotWeight    Int            @default(1)

  // Crochet autopilot foundation (phase_crochet_autopilot_foundation_001).
  // `autopilotContentTypesEnabled` lists the content-type slugs the
  // single-queue autopilot may author for this category. Empty = the
  // routine falls back to the legacy `docs/{slug}-author.md` convention
  // (single prompt). Non-empty = the routine picks one type per fire
  // (weighted by coverage gap) and routes to
  // `docs/{slug}-{type-lower}-author.md`. Crochet X1 seeded TECHNIQUE,
  // STITCH, MOTIF, HOMEWARE; X2 (phase_crochet_x2_grading_001) adds
  // GARMENT + AMIGURUMI once the grading + shape math libraries land.
  //
  // `techniqueSlugs`, `criticalTechniques`, `aliases` are the category-
  // level reference set per the pipeline-setup memory rule. Populated
  // by each category's pipeline-setup worker. Used by the autopilot
  // routine so per-tutorial Tutorial.techniqueSlugs / criticalTechniques
  // / aliases stay consistent across the library, and by future
  // cross-category sweeps. Crochet seeded by
  // phase_crochet_autopilot_foundation_001; needlework seeded by
  // phase_needlework_pipeline_setup_001.
  autopilotContentTypesEnabled String[] @default([])
  techniqueSlugs               String[] @default([])
  criticalTechniques           String[] @default([])
  aliases                      String[] @default([])

  // Landing-page archetype. Drives /[categorySlug] layout selection.
  // RECIPE   → cooking, baking, herbal-medicine, natural-home
  // PATTERN  → cross-stitch, knitting, crochet, needlework, sewing
  // SKILL    → fibre-arts, wood-natural-craft, paper-word, pottery-ceramics
  // PRACTICE → mindset, sustainability, animals-smallholding
  // PLANT    → garden
  // FIX      → home-repair
  archetype CategoryArchetype @default(RECIPE)

  // Deliberate homepage browse-tile image override. When set, the "Browse all
  // categories" grid uses this Media instead of deriving a tile from the
  // category's content. Lets a category show a hand-picked, on-brand image
  // (e.g. a real cross-stitch chart render rather than a stock technique
  // photo a tutorial happened to carry). When null, pattern-craft categories
  // fall back to their most-popular published pattern, and everything else to
  // the most-loved published tutorial's photo. Nullable + additive.
  tileImageMediaId String?
  tileImage        Media?  @relation("CategoryTileImage", fields: [tileImageMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subCategories SubCategory[]
  tutorials     Tutorial[]
  magazinePicks CategoryMagazinePick[]

  @@index([pipelineStatus, lastAutopilotRunAt])
}

model SubCategory {
  id          String  @id @default(cuid())
  slug        String
  name        String
  description String?
  order       Int     @default(0)

  // Sub-cat-level autopilot gate (phase_needlework_pipeline_setup_001).
  // When true, the autopilot routine may pick this sub-cat as the target
  // for a batch within its parent category. When false, the routine skips
  // it. Used by needlework to enable the 7 fully-guided disciplines while
  // leaving goldwork, ribbon-embroidery, and stumpwork to specialist
  // curation workers. Categories that don't use sub-cat-level routing
  // leave every row at the default false; the routine then falls back to
  // the category-level author prompt.
  autopilotEnabled Boolean @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  tutorials          Tutorial[]
  patterns           Pattern[]
  crochetPatterns    CrochetPattern[]
  needleworkPatterns NeedleworkPattern[]
  knittingPatterns   KnittingPattern[]
  sewingPatterns     SewingPattern[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  tutorials Tutorial[]

  createdAt DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────────────────
// Cross-craft collection vocabulary (phase_collection_taxonomy_001)
//
// One controlled, site-wide vocabulary so the SAME "christmas" / "whimsical"
// tags every piece of content in any category — recipes, tutorials, and every
// craft's patterns. This is the spine of cross-craft theme search and the
// /themes/* SEO landing pages. Replaces the loose, tutorial-only `Tag` above
// (whose rows migrate into this system, after which `Tag` retires).
//
// Axes are N (not hardcoded into queries): Occasion, Season, Style are
// populated at launch; Subject is registered and grown over time. Adding an
// axis is one enum value; adding a TERM is pure data (admin-editable).
//
// Terms are attached to content through the polymorphic CollectionTagAssignment
// join, so we tag tutorials + all five pattern models without altering any of
// them, and "everything tagged christmas, across every craft" is one query.
// ────────────────────────────────────────────────────────────────────────────

enum CollectionAxis {
  OCCASION // holidays + life events: christmas, halloween, weddings, new-baby…
  SEASON // spring, summer, autumn, winter, year-round
  STYLE // aesthetic register: whimsical, pastel, vintage, gothic…
  SUBJECT // what it depicts: florals, animals, fantasy-creatures, celestial…
  AUDIENCE // who it's for: baby, kids, men, women, unisex, pets
}

enum TaggableType {
  TUTORIAL
  CROSS_STITCH_PATTERN
  CROCHET_PATTERN
  NEEDLEWORK_PATTERN
  KNITTING_PATTERN
  SEWING_PATTERN
}

// Provenance of an assignment, for QC + the "shelf auto-derives its tag" rule.
enum CollectionTagSource {
  AUTHORED // born-tagged at generation (most reliable — we chose the style)
  DERIVED // auto-derived from a theme sub-category ("home shelf" → tag)
  VISION // assigned by a vision pass over a finished image
  BACKFILL // bulk retro-tag of existing back-catalogue content
  MANUAL // set by hand in admin
}

model CollectionTag {
  id   String         @id @default(cuid())
  axis CollectionAxis
  slug String         @unique // globally unique: "christmas", "whimsical"
  name String // display: "Christmas"

  // `description` is PUBLIC and voice-clean (a list of what's inside) — it is
  // the /themes/<slug> page intro. `taggerGuidance` is INTERNAL: the precise
  // definition the AI tagger must follow so the controlled vocab stays
  // consistent. Keep them separate; they serve different readers.
  description    String?
  taggerGuidance String?

  // Search synonyms ("xmas", "father christmas", "fall"→autumn). Folded into
  // the search index so obvious queries hit even when they aren't the slug.
  aliases String[] @default([])

  // Optional hierarchy: "nativity".parent = "christmas". Lets a theme page
  // roll up its children and lets the tagger pick a specific child.
  parentId String?
  parent   CollectionTag?  @relation("CollectionTagHierarchy", fields: [parentId], references: [id])
  children CollectionTag[] @relation("CollectionTagHierarchy")

  order Int @default(0)

  // SEO/merchandising. `isThemePage` = this term gets a standalone, indexable
  // /themes/<slug> page (thin terms stay off-index to avoid thin-content).
  isThemePage Boolean @default(false)
  heroMediaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments CollectionTagAssignment[]

  @@index([axis, order])
}

model CollectionTagAssignment {
  id    String        @id @default(cuid())
  tagId String
  tag   CollectionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // Polymorphic target. contentId references the row of the model named by
  // contentType (no DB-level FK across the union; integrity is enforced in the
  // tagging layer + an orphan-sweep on content delete).
  contentType TaggableType
  contentId   String

  source CollectionTagSource @default(AUTHORED)

  createdAt DateTime @default(now())

  @@unique([tagId, contentType, contentId])
  @@index([contentType, contentId])
  @@index([tagId])
}

// ────────────────────────────────────────────────────────────────────────────
// Glossary — per-category technical terms
// ────────────────────────────────────────────────────────────────────────────

model GlossaryTerm {
  id         String @id @default(cuid())
  slug       String @unique
  term       String
  definition String // Short plain-text definition for tooltips
  body       Json? // Optional longer rich content for the term's own page

  categoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// ────────────────────────────────────────────────────────────────────────────
// Tutorials — the heart of the platform
// ────────────────────────────────────────────────────────────────────────────

model Tutorial {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  subtitle String?
  excerpt  String? // Short summary used on cards and meta description

  // RECIPE | TECHNIQUE discriminator (Phase 8 Step 2). Recipes lead, techniques
  // support — see `project_content_pipeline.md`. Existing rows default to
  // TECHNIQUE; the migration backfills strawberry jam to RECIPE.
  type TutorialType @default(TECHNIQUE)

  // Categorisation
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])
  tags          Tag[]

  // Metadata shown in the info bar
  difficulty  Difficulty @default(BEGINNER)
  timeMinutes Int? // Total time the tutorial takes (sum of all steps)
  season      Season?
  sourceType  SourceType @default(SYNTHESISED)
  sourceNotes String? // Reference list / attribution notes

  // ──────────────────────────────────────────────────────────────────────────
  // Phase 8 Step 2 — recipe metadata. Null on TECHNIQUE rows. Authors set
  // these per recipe in the admin form; the public renderer surfaces the
  // values in the info bar + footer asides when `type === RECIPE`.
  // ──────────────────────────────────────────────────────────────────────────

  servings                  Int? // Default yield (4 → "Serves 4")
  yieldDescription          String? // "1 loaf" / "12 muffins" — overrides "Serves N" when set
  prepMinutes               Int?
  cookMinutes               Int?
  restingMinutes            Int? // Dough rising, marinating
  chillingMinutes           Int? // Fridge / freezer rests (distinct from resting for filters)
  totalMinutes              Int? // Denormalised: prep + cook + resting + chilling. Recomputed on save.
  scalable                  Boolean  @default(true)
  freezable                 Boolean  @default(false)
  freezeNotes               String?
  batchable                 Boolean  @default(false)
  batchNotes                String?
  makeAheadNotes            String?
  dietaryFlags              String[] // vegetarian / vegan / glutenFree / dairyFree / halal / kosher / nutFree / pescatarian
  cuisine                   String? // Italian / British / French / etc. Single-valued.
  mealType                  String? // breakfast / lunch / dinner / snack / dessert / drink / side

  // Discoverability (phase_dish_type_001). `familiarCanon` flags the everyday
  // UK/US household staples (spaghetti bolognese, mac & cheese, shepherd's pie,
  // Victoria sponge...) so the region-aware category featuring can lead with
  // the familiar comfort canon and weave world food in as discovery, instead
  // of the old recency-ordered default that surfaced only the newest (exotic)
  // fills. Set by the dish-type classification pass; false on world-cuisine
  // discovery content and on every non-food category. The dish-type SHELF a
  // recipe browses under is its `subCategoryId` (drawn from
  // prisma/dish-type-vocabulary.ts); cross-cutting collections reuse `mood[]`;
  // the world-cuisine shelf reuses `cuisine` — no parallel taxonomy.
  familiarCanon             Boolean  @default(false)
  mood                      String[] // multi-tag — genre / register / vibe. Cooking values: comfortFood / weeknight / party / kidFriendly / freezerFriendly / healthy. Mindset values (Phase 8 Step 13 rebalance): manifesting / magical / playful / symbolic. Use the canonical strings exactly. Filterable via the GIN index.
  temperatureCelsius        Int?
  temperatureNote           String? // "fan oven", "low and slow"
  nutritionalInfoPerServing Json?

  // Foundational technique flag — drives the "Foundational technique" info-bar
  // badge for the ~500–700 core techniques (knife skills, mother sauces, etc.).
  // Always false on RECIPE rows.
  foundational Boolean @default(false)

  // Editorial pointer used by the recipe-page "Leftover bridge" block —
  // "when you've cooked this, here's what to do with the leftovers".
  leftoverTutorialId String?
  leftoverTutorial   Tutorial?  @relation("LeftoverBridge", fields: [leftoverTutorialId], references: [id], onDelete: SetNull)
  leftoverFor        Tutorial[] @relation("LeftoverBridge")

  // Content
  heroMediaId String?
  hero        Media?  @relation(fields: [heroMediaId], references: [id])
  body        Json // TipTap document — the article body

  // Snapshot of the pre-rewrite body, captured by the
  // mindset-completeness audit + rewriter pipeline before replacing
  // `body` with re-authored content. Null on rows that have never been
  // rewritten by an audit pipeline. The same field can be reused by
  // future audit cycles (cooking / baking / etc.) — same shape, same
  // semantics. Recovery: restore by copying revisedFrom back into body.
  //
  // NOTE: this field is shared across multiple pipelines (mindset audit,
  // image-relevance worker, etc.) so its presence does NOT specifically
  // mean "voice retrofitted". Use `voiceRetrofittedAt` for that.
  revisedFrom Json?

  // Voice-retrofit tracking — set to the time a tutorial was rewritten to
  // the voice-spec-2026-05-21 grade 6-8 register. The voice-retrofit
  // routine filters candidates on this field, so it stays isolated from
  // any other pipeline that touches `body` or `revisedFrom`. Null until
  // the voice-retrofit apply script has processed the row.
  voiceRetrofittedAt DateTime?

  // Crochet image pipeline A — diagram sourcing status. PENDING on rows
  // that haven't been processed; SUCCESS once a PD diagram is wired into
  // the body; NO_SOURCE when no PD source covers the topic and the
  // tutorial ships text-only. Shared enum with the hero pipeline, but
  // only PENDING / RUNNING / SUCCESS / NO_SOURCE apply here.
  diagramGenerationStatus ImageGenerationStatus @default(PENDING)

  // Phase 8 Homepage rebuild — heroImageStrategy tracks where the current
  // hero came from. PROCEDURAL_CARD = the renderer should show the
  // category-tinted SVG card built at request time from title + category.
  // REAL_PHOTO / AI_GENERATED = there's a Media row attached (`heroMediaId`).
  // UNSET = default for new rows until the editor / backfill resolves the
  // strategy. The public renderer falls through to PROCEDURAL_CARD whenever
  // no Media row exists, regardless of stored strategy, so callers stay safe.
  heroImageStrategy HeroStrategy @default(UNSET)

  // Image-verification sweep accumulates rejected hero image sources here
  // so re-sourcing across runs never reaches for a slot we've already
  // burned. Values are ImageSource slugs (pexels / unsplash / wikimedia /
  // pixabay / flux-schnell). After 3 distinct real-photo rejections the
  // sweep forces the next attempt to Flux. See
  // `packages/db/scripts/apply-media-verdicts.ts`.
  excludedImageSources String[] @default([])

  // Phase 8 homepage redesign — hero photo quality gate. The homepage
  // hero loader filters EDITORIAL_PICK candidates to `heroQuality =
  // EDITORIAL` so weak photos don't surface in the full-bleed Netflix-
  // style hero. STANDARD = default (eligible for card grid, not hero).
  // FALLBACK = weak / procedural photo, never used as a hero.
  heroQuality HeroQuality @default(STANDARD)

  // Lifecycle
  status       TutorialStatus @default(DRAFT)
  publishedAt  DateTime?
  scheduledFor DateTime?

  // Content-completeness gate (2026-06-15). When the publish path blocks a
  // row because it failed its per-category completeness check (leaked NaN /
  // undefined, unfilled placeholder, a PATTERN with no row/round
  // instructions, a recipe with no ingredients, ...), the row stays / is
  // returned to DRAFT and the structured failure is recorded here:
  //   { blocked, reasons[], rules[], blockedFromStatus, checkedAt, source }
  // publishedAt is deliberately preserved on un-publish so the audit trail
  // shows when the row was live. The qc-fix pass clears this back to null
  // once the row passes the completeness check again. AI-only — never a
  // human triage queue (no warning tier). See
  // packages/db/scripts/qc-completeness-rules/.
  qcBlockReason Json?

  // Authorship
  authorId String
  author   User   @relation("TutorialAuthor", fields: [authorId], references: [id])

  // Creator attribution (Phase 6). Null = Homemade-authored. When set, the
  // tutorial is shown with a "By {creator}" byline that links to /makers/[handle].
  creatorId String?
  creator   User?   @relation("TutorialCreator", fields: [creatorId], references: [id])

  versions          TutorialVersion[]
  bookmarks         Bookmark[]
  projects          UserProject[]
  reviews           Review[]
  ugcPhotos         UGCPhoto[]
  questions         Question[]
  errata            Errata[]
  patternTests      PatternTest[]
  recipeIngredients RecipeIngredient[]
  recipeTools       RecipeTool[]
  chartProgress     ChartProgress[]

  weeklyEditorialPicks  WeeklyEditorialPick[]
  categoryMagazinePicks CategoryMagazinePick[]
  projectSchedule       ProjectSchedule[]

  // Session A addendum — visit counter for the "Did you make this?" prompt.
  tutorialVisits TutorialVisit[]

  // ──────────────────────────────────────────────────────────────────────────
  // Phase 8 Step 13 — Mindset practice metadata. Null on rows where
  // type != PRACTICE. The `whenToUse` matcher string is the one-sentence
  // signal the "I'm feeling..." surface and the plan generator both read
  // when deciding which library row to surface. `alternativePracticeIds`
  // is a free-form string array (not a Prisma relation) so practices can
  // point at sibling slugs without needing a join row — same pattern as
  // `Ingredient.commonSubstitutes`.
  // ──────────────────────────────────────────────────────────────────────────

  practiceType           PracticeType?
  practiceTargets        PracticeTarget[] @default([])
  timeBand               TimeBand?
  bestTime               BestTime?
  practiceDepth          Difficulty?
  whenToUse              String?
  whenNotToUse           String?
  alternativePracticeIds String[]         @default([])

  // ──────────────────────────────────────────────────────────────────────────
  // Phase 8 Baking pipeline — Baking-specific recipe metadata. Null on rows
  // where `type != RECIPE` or where the recipe is not in the Baking category.
  // Cooking recipes ignore these columns (they continue to use the existing
  // `temperatureCelsius` / `temperatureNote` for oven cook temperatures).
  // Bread + pastry + cake + biscuit + pie + scone + confectionery +
  // cake-decorating live under one set of optional columns so all eight
  // sub-categories share a single migration. See `docs/baking-author.md`.
  // ──────────────────────────────────────────────────────────────────────────

  // Hydration metadata — baker's-percentage anchored. All percentages are
  // relative to flour weight; the flour weight itself anchors the whole
  // recipe so the public renderer can show derived totals.
  flourWeightGrams Int?
  hydrationPercent Float?
  saltPercent      Float?
  yeastPercent     Float?
  levainPercent    Float?

  // Proofing metadata. All in minutes; null when the bake doesn't use that
  // stage (a biscuit dough has no bulk ferment; a tin loaf has no levain
  // build). `retardingMinutes` distinct from `chillingMinutes` (recipe-wide
  // cold rest, e.g. a pastry chill) so bread workflows surface separately.
  bulkFermentMinutes Int?
  proofMinutes       Int?
  retardingMinutes   Int?
  levainBuildMinutes Int?

  // Lamination metadata. Puff, croissant, and Danish carry fold + rest
  // counts; shortcrust / filo skip these.
  laminationFolds Int?
  laminationRests Int?

  // Oven + steam. Baking-specific oven settings: distinct from cooking's
  // `temperatureCelsius` so bake-specific surfaces (steam method, etc.)
  // can group together. Authors may still set the cooking field for
  // legacy compatibility — the renderer prefers `bakeTemperatureCelsius`
  // when the recipe is in the Baking category.
  bakeTemperatureCelsius Int?
  bakeTemperatureNote    String?
  steamMethod            String?

  // Decorating. Surfaces in the info bar on cake-decorating tutorials.
  decoratingTechnique String?

  // Pre-ferment type. NONE on straight doughs; one of the structured
  // variants for breads that build flavour through a separate ferment.
  preFermentType PreFermentType?

  // ──────────────────────────────────────────────────────────────────────────
  // Phase Garden pipeline — Garden-specific growing-guide metadata. Null on
  // rows where `type != GROWING_GUIDE`. Growing difficulty reuses the existing
  // `difficulty` column (BEGINNER / INTERMEDIATE / ADVANCED ladder is shared
  // across categories). See `docs/garden-author.md` for per-sub-topic guidance
  // on which fields to set.
  // ──────────────────────────────────────────────────────────────────────────

  // Tool / equipment requirements (Skill archetype tool picker).
  // Free-form slug array (e.g. "drop-spindle", "wheel", "rigid-heddle",
  // "sloyd-knife"). The Skill landing aggregates distinct slugs across
  // the category's published tutorials to drive a tool picker so users
  // can filter "what can I make with the tools I have".
  requiredTools String[] @default([])

  // Months when the plant is sown / planted (lower-case 'march',
  // 'april', ...). Drives the "what to sow in April" public filter.
  plantingMonths String[] @default([])

  // Months when the plant is harvested / picked.
  harvestMonths String[] @default([])

  // Container + indoor friendliness — drive the "grows on a balcony" and
  // "windowsill-friendly" filters. Nullable on purpose: null means "not a
  // growing guide" / not applicable, distinct from explicit false.
  containerFriendly Boolean?
  indoorFriendly    Boolean?

  // Regional applicability. The author writes UK-default schedules; this flag
  // expands readership where the same schedule applies. Values:
  // 'UK' / 'EU' / 'US_NORTH' / 'US_SOUTH' / 'AU_NZ' / 'ZA'.
  // Defaults to ['UK'] at upload time when the author leaves it empty.
  regionsApplicable String[] @default([])

  // ──────────────────────────────────────────────────────────────────────────
  // Phase location_climate_paper_001 — region + climate metadata used by
  // every category that needs region-aware rendering (gardening leads;
  // needlework / sewing / knitting / crochet reuse the same columns when
  // those pipelines wire up their region-sensitive surfaces).
  //
  // All nullable. Tutorials with no climate metadata get no "Where this
  // works best" card and no silent month / frost adjustment — the renderer
  // falls through silently. The fields are deliberately granular so the
  // renderer can compose plain-English region guidance without authors
  // having to write or maintain that English themselves.
  //
  //   hemisphere               — 'N' | 'S'. Drives 6-month transposition.
  //   climateZones             — Köppen codes the tutorial is written for
  //                              (['Cfb'] for an oceanic-UK tutorial).
  //   usdaHardinessZones       — USDA zones the schedule works for
  //                              ([7, 8, 9] for a UK-range tutorial).
  //   rhsHardinessZones        — RHS zones ('H4', 'H5'…).
  //   growingMonthsByHemisphere — JSON map { N: ['feb', 'mar'], S: ['aug', 'sep'] }
  //                              keyed by hemisphere. Renderer prefers this
  //                              over a naive +6 transposition when set.
  //   frostSensitivity         — 'hardy' | 'half-hardy' | 'tender' | null.
  //                              Drives "wait until after last frost" copy.
  //   dayLengthSensitive       — true on lettuce-style plants that bolt
  //                              once daylight crosses a threshold.
  //   primaryRegionWrittenFor  — human-readable ('UK & Northern Europe').
  //   alsoGrowsIn              — human-readable ('US zones 5-9 …').
  //   paperSizeCompatible      — String[] of paper sizes a printable
  //                              pattern reflows cleanly to. Empty array
  //                              means non-printable (no PDF button).
  // ──────────────────────────────────────────────────────────────────────────

  hemisphere                String?
  climateZones              String[] @default([])
  usdaHardinessZones        Int[]    @default([])
  rhsHardinessZones         String[] @default([])
  growingMonthsByHemisphere Json?
  frostSensitivity          String?
  dayLengthSensitive        Boolean  @default(false)
  primaryRegionWrittenFor   String?
  alsoGrowsIn               String?
  paperSizeCompatible       String[] @default([])

  // ──────────────────────────────────────────────────────────────────────────
  // Phase 8 Herbal pipeline — herbal-medicine recipe metadata.
  //
  // Set on rows where `type IN (REMEDY, HERB_PROFILE)`. Null on every
  // non-herbal row. `primaryHerb` is the FK to the Herb master table —
  // SetNull so deleting a master row doesn't cascade away authored
  // remedies. `relatedConditionIds` is a free-form String[] (not a
  // Prisma relation) so a remedy can reference conditions without a
  // join row — same pattern as `alternativePracticeIds` on Mindset.
  // `preparationType` is the preparation taxonomy (tincture / decoction
  // / infusion / oil / salve / balm / syrup / compress / poultice /
  // bath / steam / inhalation / gargle / capsule). `safetyFlags`
  // inherits from the primary herb's flags and may extend with
  // tutorial-specific cautions ("pregnancy-caution-third-trimester").
  // `requiresMedicalDisclaimer` defaults true; the renderer surfaces
  // the canonical "Not medical advice…" line on every herbal page
  // unless an editor explicitly clears it.
  // ──────────────────────────────────────────────────────────────────────────

  primaryHerbId             String?
  primaryHerb               Herb?    @relation("TutorialPrimaryHerb", fields: [primaryHerbId], references: [id], onDelete: SetNull)
  relatedConditionIds       String[] @default([])
  preparationType           String?
  safetyFlags               String[] @default([])
  requiresMedicalDisclaimer Boolean  @default(true)

  // ──────────────────────────────────────────────────────────────────────────
  // Phase Sewing pipeline — sewing-specific metadata.
  //
  // Set on rows where `type IN (PATTERN, TECHNIQUE)` and `craftType` is
  // 'sewing'. `craftType` is the shared discriminator across the craft
  // categories — knitting / crochet / fibre-arts / wood / pottery /
  // paper pipelines will reuse the same column when their pipelines
  // land. `projectShape` documents what the construction looks like
  // (rectangle / gathered-rectangle / panel-construction / circle /
  // from-measurements / unconstructed). `requiredFabricTypes` +
  // `requiredNotions` are slug references validated against the
  // master `Fabric` / `SewingNotion` tables at upload time.
  // `bodyMeasurementsRequired` is only meaningful on PATTERN rows
  // where the cut sizes to the body — empty on bag / cushion /
  // curtain / soft-toy / homewares patterns.
  // ──────────────────────────────────────────────────────────────────────────

  craftType                String?
  projectShape             String?
  requiredFabricTypes      String[] @default([])
  requiredNotions          String[] @default([])
  sewingMethod             String?
  fabricYardageMetres      Float?
  finishedDimensionsCm     Json?
  bodyMeasurementsRequired String[] @default([])

  // ──────────────────────────────────────────────────────────────────────────
  // Phase 8 Crochet pipeline — Crochet-specific tutorial metadata.
  //
  // Set on rows where `type IN (STITCH, PATTERN)` and the tutorial sits
  // under the `crochet` Category. The knitting + needlework pipelines that
  // follow reuse most of these columns unchanged; only `primaryHookId` is
  // crochet-specific (knitting adds `primaryNeedleId` on the same shape).
  //
  // `primaryYarnWeightId` / `primaryHookId` are SetNull FKs so deleting a
  // master row never cascades away an authored pattern. `craftStitchSlugs`
  // is a String[] (not a Prisma relation) — patterns cross-reference a
  // handful of stitches and the renderer fetches them in one batched query,
  // same pattern as `relatedConditionIds` on herbal rows.
  //
  // `chartDefinition` is a JSONB column the SVG chart renderer in
  // `apps/web/src/lib/craft-charts/svg-chart.tsx` reads. Null on patterns
  // that don't have a chart; populated on in-the-round motifs and on
  // stitch tutorials that benefit from a glyph chart.
  // ──────────────────────────────────────────────────────────────────────────

  primaryYarnWeightId String?
  primaryYarnWeight   YarnWeight?     @relation("TutorialPrimaryYarnWeight", fields: [primaryYarnWeightId], references: [id], onDelete: SetNull)
  primaryHookId       String?
  primaryHook         CrochetHook?    @relation("TutorialPrimaryHook", fields: [primaryHookId], references: [id], onDelete: SetNull)
  /// Knitting analogue of `primaryHookId` — set on knitting PATTERN rows.
  /// Same SetNull policy.
  primaryNeedleId     String?
  primaryNeedle       KnittingNeedle? @relation("TutorialPrimaryNeedle", fields: [primaryNeedleId], references: [id], onDelete: SetNull)

  /// Stated gauge as the author wrote it — e.g. "18 dc × 10 rows = 10 × 10 cm
  /// in 4 mm hook, after blocking". Plain text; the renderer surfaces it
  /// verbatim in the pattern info bar. Null on STITCH rows.
  gaugeText String?

  /// Stated finished size — e.g. "30 × 30 cm", "Adult medium: 92 cm chest /
  /// 56 cm length". Plain text; renderer surfaces it verbatim.
  finishedSizeText String?

  /// 'uk' | 'us'. Drives the abbreviation set the renderer shows in the
  /// stitch-abbreviation legend and the chart-symbol key. UK-first
  /// publication policy: default 'uk' on every crochet row unless the
  /// source pattern is American. Null on non-crochet/knitting rows.
  terminologyConvention String?

  /// Generic chart definition consumed by the shared SVG chart renderer.
  /// Shape documented in `apps/web/src/lib/craft-charts/types.ts`.
  chartDefinition Json?

  /// Slugs of stitches this tutorial features. STITCH rows carry one slug
  /// (the stitch being taught); PATTERN rows carry every stitch the pattern
  /// uses. Slugs reference the master `Stitch` table; the upload script
  /// validates that each exists.
  craftStitchSlugs String[] @default([])

  /// Technique tags surfaced in the info bar and filterable on the public
  /// browse — e.g. 'magic-ring', 'joining-as-you-go', 'tapestry-crochet',
  /// 'blocking', 'invisible-finish', 'chainless-foundation'. Free-form
  /// strings so authors can add without a migration.
  craftTechniqueTags String[] @default([])

  // ──────────────────────────────────────────────────────────────────────────
  // Phase Knitting pipeline (phase_knitting_001) — knitting-specific
  // Tutorial metadata. Set on rows where `type IN (STITCH, PATTERN)` and
  // the tutorial sits under the `knitting` Category. Sized to cover the
  // full knitting catalogue: garments, accessories, colourwork, lace,
  // cable / Aran, brioche, and double-knit. All fields nullable so
  // existing rows (and non-knitting rows) need no backfill.
  //
  // Method enums are stored as String? for forwards compatibility — adding
  // a new cast-on or bind-off variant doesn't require a migration. The
  // upload script validates against the canonical method vocabulary in
  // `apps/web/src/lib/knitting/methods.ts`.
  //
  // `secondaryNeedleSizes` JSON shape:
  //   [{ section: 'ribbing', needleSlug: 'needle-3-25-mm' },
  //    { section: 'body',    needleSlug: 'needle-4-mm'   }]
  // — many garment patterns use a smaller needle for ribbing. The primary
  // needle on `primaryNeedleId` stays the body / main needle.
  //
  // `secondaryYarnWeightIds` carries additional YarnWeight IDs for
  // colourwork patterns that hold two or more strands, or for fades.
  //
  // `easePresetSlug` links to the EasePreset table the crochet grading
  // library introduced; knitting reuses the same vocabulary (`negative-
  // ease-2cm`, `relaxed-fit-5cm`, `oversized-15cm`, etc.).
  //
  // `gaugeInPatternStitch` JSON shape:
  //   { stitchesPer10cm: 22, rowsPer10cm: 30, stitchName: 'cable panel A',
  //     blocked: true }
  // — for cable / lace / brioche patterns where the stockinette gauge
  // differs from the pattern gauge. `gaugeText` carries the human-
  // readable phrasing; this column captures the structured numbers.
  // ──────────────────────────────────────────────────────────────────────────

  /// Cast-on method: `LONG_TAIL`, `CABLE`, `GERMAN_TWISTED`,
  /// `PROVISIONAL`, `ITALIAN_TUBULAR`, `OLD_NORWEGIAN`,
  /// `BACKWARD_LOOP`, `JUDYS_MAGIC`, `KNITTED_ON`, `CROCHET_PROVISIONAL`.
  castOnMethod String?

  /// Bind-off method: `STANDARD`, `STRETCHY`, `TUBULAR`, `SEWN`,
  /// `JENYS_SURPRISINGLY_STRETCHY`, `THREE_NEEDLE`, `I_CORD`,
  /// `RUSSIAN_GRAFT`, `PICOT`, `SUSPENDED`.
  bindOffMethod String?

  /// In-the-round working method: `MAGIC_LOOP`, `TWO_CIRCULARS`, `DPN`,
  /// `SHORT_CIRCULAR`, `STRAIGHT_FLAT`. Default authoring assumption is
  /// `MAGIC_LOOP`; the Studio surfaces the others as toggles where the
  /// pattern documents method-specific variants.
  inTheRoundMethod String?

  /// Per-section secondary needles. Null when the pattern uses one needle
  /// throughout. JSON array of `{ section, needleSlug }` entries.
  secondaryNeedleSizes Json?

  /// Secondary yarn weights for multi-yarn patterns (colourwork,
  /// stranded, fade). Empty array on single-yarn patterns. Slugs
  /// reference the master `YarnWeight` table.
  secondaryYarnWeightIds String[] @default([])

  /// Slug of the EasePreset row this pattern grades from. Used by the
  /// grading library to pick the right finished-bust offset.
  easePresetSlug String?

  /// Pattern-stitch gauge when it differs from stockinette gauge. JSON
  /// `{ stitchesPer10cm, rowsPer10cm, stitchName, blocked }`.
  gaugeInPatternStitch Json?

  // ──────────────────────────────────────────────────────────────────────────
  // Cross-category Foundations (phase_knitting_001). Foundations tutorials
  // that apply across crafts (blocking fundamentals, ergonomics, yarn
  // substitution maths, ball-band reading) cross-list under multiple
  // category landing pages without duplicating the row. The category page
  // surfaces tutorials where the page's slug appears in either the
  // tutorial's primary Category or in `crossCategoryWith`.
  //
  // Empty on the vast majority of tutorials. Set on the small set of
  // genuinely cross-craft Foundations rows.
  // ──────────────────────────────────────────────────────────────────────────

  /// Category slugs this tutorial also appears under, beyond its primary
  /// Category. e.g. `['crochet']` on a knitting blocking Foundations
  /// tutorial that should also appear on the crochet Foundations page.
  crossCategoryWith String[] @default([])

  // ──────────────────────────────────────────────────────────────────────────
  // Phase Pottery & ceramics pipeline — equipment-barrier flags + master-
  // table slug references. Set on rows where `craftType = 'pottery-ceramics'`
  // (the discriminator pulls double-duty across the craft pipelines).
  //
  // `requiresKiln` + `requiresWheel` drive the public list-page equipment-
  // barrier badge and filter. The 70 / 30 weighting between the no-equipment
  // sub-track and the wheel + kiln sub-track is enforced by the authoring
  // prompt; these flags are the runtime gate readers see.
  //
  // `requiredClayBodies` + `requiredCraftMaterials` are String[] (no Prisma
  // relation) mirroring `requiredFabricTypes` + `requiredNotions` on sewing.
  // The upload script validates each slug against the master `ClayBody` /
  // `CraftMaterial` tables at upload time. A no-equipment-track tutorial
  // referencing a CraftMaterial with `trainedEnvironmentOnly = true` is
  // rejected at upload — the silica / heavy-metal materials never end up on
  // a kiln-less reader's screen by accident.
  // ──────────────────────────────────────────────────────────────────────────

  requiresKiln           Boolean  @default(false)
  requiresWheel          Boolean  @default(false)
  requiredClayBodies     String[] @default([])
  requiredCraftMaterials String[] @default([])

  // ──────────────────────────────────────────────────────────────────────────
  // Technique linking (phase_technique_linking_001). Set on every tutorial
  // that references one or more technique tutorials inline (via the
  // `techniqueLink` mark in the body). Indexed so the future "Recipes using
  // this technique" rail can resolve `WHERE :slug = ANY(techniqueSlugs)` in
  // a single cheap query against the GIN index.
  //
  // `techniqueSlugs` is the full set — every technique slug the body
  // references, deduplicated. `criticalTechniques` is the subset without
  // which the recipe doesn't work (a shortcrust recipe references
  // `blind-baking`, `creaming-method-fat-and-sugar`, `rubbing-in`; only
  // `blind-baking` is critical — the others are incidental). The split
  // lets the rail rank "recipes that genuinely depend on this technique"
  // above "recipes that mention it in passing".
  //
  // Empty on technique tutorials themselves and on rows whose author hasn't
  // wrapped any technique words yet — the inline link infrastructure ships
  // before the backfill, and pre-launch rows land an empty array.
  // ──────────────────────────────────────────────────────────────────────────

  techniqueSlugs     String[] @default([])
  criticalTechniques String[] @default([])

  // Free-form search aliases used by the reverse-sweep Inngest function
  // (`on-technique-publish`) to find this technique inside already-
  // published recipes. Only meaningful on TECHNIQUE rows; ignored on
  // every other type. The sweep builds its search-term set from
  // `title + slug-with-spaces + aliases`, so this column captures the
  // common phrasings authors actually use ("blind baking",
  // "pre-bake the pastry" for the `blind-bake` technique) that the
  // canonical title doesn't already cover. See
  // `apps/web/src/lib/technique-sweep.ts` for the matching contract.
  aliases String[] @default([])

  // ──────────────────────────────────────────────────────────────────────────
  // Phase Sustainability pipeline — cost + payback metadata.
  //
  // Set on sustainability tutorials (solar, insulation, heat pump, water
  // tanks) where the reader's decision turns on "what does this cost and
  // when does it pay back". Likely to be re-used on Home & repair when
  // that pipeline lands. NULL on every other category and on sustainability
  // tutorials where the question doesn't apply (composting, foraging-style
  // reuse — no cash outlay, no payback to compute).
  //
  //   approximateCostGbp — typical setup cost in whole £. Order-of-magnitude
  //                        budgeting, not till receipts (£40 draught kit,
  //                        £8000 heat pump).
  //   paybackYears        — years for the saving to recoup the cost. 0 = pays
  //                        back inside a year. NULL = no financial payback
  //                        to compute, or unknown.
  //
  // Indexes on (type, approximateCostGbp) and (type, paybackYears) drive
  // the future "cheap upgrades" + "fast-payback upgrades" public filters.
  // ──────────────────────────────────────────────────────────────────────────

  approximateCostGbp Int?
  paybackYears       Int?

  // ──────────────────────────────────────────────────────────────────────────
  // Phase Natural-home pipeline — finished-product shelf life. Set on
  // natural-home RECIPE rows (soap, candle, balm, lotion, deodorant,
  // surface spray, etc.) and on herbal REMEDY rows where a structured
  // integer makes sense alongside the existing `recipe.makeAheadNotes`.
  // Null on every TECHNIQUE row, every READING row, every Cooking +
  // Baking recipe (food shelf life lives in `freezeNotes` /
  // `makeAheadNotes` where it already does).
  //
  // `shelfLifeDays` matches the name + unit on `Ingredient.shelfLifeDays`.
  // `shelfLifeNotes` carries the human-readable storage caveat ("Store in
  // a cool dark cupboard; discard if the surface develops white spots or
  // the salve smells rancid.") that a single integer can't capture.
  // ──────────────────────────────────────────────────────────────────────────
  shelfLifeDays  Int?
  shelfLifeNotes String?

  planDayMornings    UserPlanDay[]          @relation("PlanDayMorningPractice")
  planDayEvenings    UserPlanDay[]          @relation("PlanDayEveningPractice")
  planDayAnchors     UserPlanDay[]          @relation("PlanDayAnchorPractice")
  planDayReflections UserPlanDay[]          @relation("PlanDayReflectionPrompt")
  dailyPicks         DailyPick[]
  practiceFavorites  UserPracticeFavorite[]
  practiceUses       UserPracticeUse[]
  feelingMatches     UserFeeling[]

  // Pattern Studio (phase_pattern_studio_001). `patternId` is the bridge
  // to the canonical Pattern row backing this tutorial's chart inset; null
  // on every non-charted tutorial. `patternsSourced` is the reverse of
  // Pattern.sourceTutorialId — patterns that were originally extracted
  // from this tutorial body during the crossStitchChart backfill.
  patternId       String?
  pattern         Pattern?  @relation("TutorialPattern", fields: [patternId], references: [id], onDelete: SetNull)
  patternsSourced Pattern[] @relation("PatternSourceTutorial")

  // Crochet Studio (phase_crochet_pattern_001). `crochetPatternId` is the
  // bridge to the canonical CrochetPattern row backing a tutorial's
  // crochetPatternInset; null on every non-crochet tutorial. The reverse
  // relation `crochetPatternsSourced` matches Pattern.sourceTutorialId.
  crochetPatternId       String?
  crochetPattern         CrochetPattern?  @relation("TutorialCrochetPattern", fields: [crochetPatternId], references: [id], onDelete: SetNull)
  crochetPatternsSourced CrochetPattern[] @relation("CrochetPatternSourceTutorial")

  // Needlework Studio (phase_needlework_001). `needleworkPatternId` bridges
  // to the NeedleworkPattern row backing a tutorial's needleworkPatternInset.
  // Null on every non-needlework tutorial.
  needleworkPatternId       String?
  needleworkPattern         NeedleworkPattern?  @relation("TutorialNeedleworkPattern", fields: [needleworkPatternId], references: [id], onDelete: SetNull)
  needleworkPatternsSourced NeedleworkPattern[] @relation("NeedleworkPatternSourcedFrom")
  needleworkPatternsInset   NeedleworkPattern[] @relation("NeedleworkPatternSourceTutorial")

  // Knitting Studio (phase_knitting_pipeline_001). KnittingPattern.tutorialId
  // points back here. The Tutorial row carries the introductory editorial
  // content; KnittingPattern carries the row-by-row + chart + grading.
  knittingPatternsInset KnittingPattern[] @relation("TutorialKnittingPattern")

  // Sewing S-2 (phase_sewing_schema_001). SewingPattern.tutorialId points
  // back here so a pattern can hang off an introductory tutorial.
  sewingPatternsInset SewingPattern[] @relation("TutorialSewingPattern")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([slug])
  @@index([creatorId, status, publishedAt])
  @@index([type])
  @@index([type, cuisine])
  @@index([type, mealType])
  @@index([categoryId, status, familiarCanon])
  @@index([type, totalMinutes])
  @@index([type, freezable])
  @@index([type, batchable])
  @@index([type, foundational])
  @@index([type, practiceType])
  @@index([type, timeBand])
  @@index([type, bestTime])
  @@index([practiceTargets], type: Gin)
  @@index([mood], type: Gin)
  @@index([type, preFermentType])
  @@index([type, decoratingTechnique])
  @@index([type, containerFriendly])
  @@index([type, indoorFriendly])
  @@index([plantingMonths], type: Gin)
  @@index([harvestMonths], type: Gin)
  @@index([regionsApplicable], type: Gin)
  @@index([primaryHerbId])
  @@index([type, preparationType])
  @@index([craftType])
  @@index([type, craftType])
  @@index([type, projectShape])
  @@index([type, sewingMethod])
  @@index([requiredFabricTypes], type: Gin)
  @@index([requiredNotions], type: Gin)
  @@index([primaryYarnWeightId])
  @@index([primaryHookId])
  @@index([primaryNeedleId])
  @@index([craftStitchSlugs], type: Gin)
  @@index([craftTechniqueTags], type: Gin)
  @@index([type, terminologyConvention])
  @@index([type, castOnMethod])
  @@index([type, bindOffMethod])
  @@index([type, inTheRoundMethod])
  @@index([easePresetSlug])
  @@index([secondaryYarnWeightIds], type: Gin)
  @@index([crossCategoryWith], type: Gin)
  @@index([type, requiresKiln])
  @@index([type, requiresWheel])
  @@index([requiredClayBodies], type: Gin)
  @@index([requiredCraftMaterials], type: Gin)
  @@index([techniqueSlugs], type: Gin)
  @@index([type, approximateCostGbp])
  @@index([type, paybackYears])
  @@index([patternId])
  @@index([crochetPatternId])
  @@index([needleworkPatternId])
  @@index([shelfLifeDays])
  @@index([hemisphere])
  @@index([frostSensitivity])
  @@index([dayLengthSensitive])
  @@index([climateZones], type: Gin)
  @@index([usdaHardinessZones], type: Gin)
  @@index([rhsHardinessZones], type: Gin)
  @@index([paperSizeCompatible], type: Gin)
}

enum TutorialType {
  RECIPE
  TECHNIQUE
  PRACTICE
  READING
  GROWING_GUIDE
  // Phase 8 Herbal pipeline — REMEDY is a preparation tutorial (tincture,
  // decoction, infusion, oil, salve, balm, syrup, compress, poultice, bath,
  // steam). HERB_PROFILE is a single-herb materia-medica entry.
  REMEDY
  HERB_PROFILE
  // Phase Sewing pipeline — PATTERN is a rectangle / gathered-rectangle /
  // panel / circle / from-measurements project tutorial. Fitted-garment
  // patterns (requiring pattern pieces, grading, digitisation) are out of
  // scope at launch and use a separate workstream when added.
  //
  // Phase 8 Crochet pipeline adds STITCH (single-stitch tutorial — chain,
  // double crochet, treble, magic ring, slip stitch). PATTERN is shared
  // with sewing for finished-item patterns (granny square, dishcloth);
  // knitting + needlework pipelines will reuse both values. The
  // Tutorial's category + craft-keyed Stitch references disambiguate.
  STITCH
  PATTERN
}

enum HeroStrategy {
  REAL_PHOTO
  PROCEDURAL_CARD
  PUBLIC_DOMAIN_PLATE
  AI_GENERATED
  UNSET
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Single-queue autopilot (phase_autopilot_single_queue_001).
/// Gates whether the round-robin queue cron picks the category.
enum PipelineStatus {
  NOT_READY // No authoring prompt / master entities yet; queue skips.
  READY // Queue may fire bulk batches against this category.
  PAUSED // Temporarily skipped (e.g. quality drift) without disabling cron.
  COMPLETE // Published count has reached targetTutorialCount.
}

enum CategoryArchetype {
  RECIPE
  PATTERN
  SKILL
  PRACTICE
  PLANT
  FIX
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  YEAR_ROUND
}

enum SourceType {
  TESTED // Tested in Homemade kitchen/garden/etc
  CLASSIC // Classic precedent, cross-referenced across 5+ sources
  SYNTHESISED // Synthesised from public domain / extension service sources
  PUBLIC_DOMAIN // Direct public domain (e.g. Victorian crochet pattern)
  CREATOR // From an external creator (post Phase 6)
}

enum TutorialStatus {
  DRAFT
  IN_REVIEW
  PENDING_MODERATION
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Hero photo quality gate — Phase 8 homepage redesign.
// EDITORIAL: hero-grade photo, OK for the full-bleed editorial-pick hero.
// STANDARD : default; eligible for card-grid surfaces, never chosen for hero.
// FALLBACK : weak or procedural photo, never used as a hero anywhere.
enum HeroQuality {
  EDITORIAL
  STANDARD
  FALLBACK
}

// One row per save in the admin editor. Used for version history + rollback.
model TutorialVersion {
  id         String   @id @default(cuid())
  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  // Snapshot of the editable fields at this version
  title    String
  subtitle String?
  excerpt  String?
  body     Json
  status   TutorialStatus

  authorId   String
  author     User    @relation("VersionAuthor", fields: [authorId], references: [id])
  changeNote String?

  createdAt DateTime @default(now())

  @@index([tutorialId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Media — photos, videos, diagrams, illustrations
// ────────────────────────────────────────────────────────────────────────────

model Media {
  id String @id @default(cuid())

  // Cloudflare identifiers (one or both depending on type)
  cloudflareId String? @unique // Cloudflare Images / Stream ID
  r2Key        String? // R2 raw asset key

  type        MediaType
  mimeType    String?
  filename    String?
  alt         String?
  caption     String?
  attribution String? // Legacy free-text credit. Prefer the structured fields below.

  width  Int?
  height Int?
  bytes  Int?

  status MediaStatus @default(UPLOADING)

  // ──────────────────────────────────────────────────────────────────────────
  // Phase 8 content integration — structured sourcing + attribution metadata.
  // Set by the image-sourcing orchestrator (`apps/web/src/lib/image-sourcing/`).
  // The public renderer reads `requiresAttribution` to decide whether to show
  // the discreet attribution tooltip on the hero.
  // ──────────────────────────────────────────────────────────────────────────

  /// Source identifier — unsplash / pexels / wikimedia / pixabay / usda / nlm /
  /// flux-schnell / procedural-card / original / manual-upload.
  source String?

  /// URL of the original asset (for our records — never displayed).
  sourceUrl String?

  /// Photographer / illustrator name for attribution display.
  creatorName String?

  /// Licence code — CC-BY / CC-BY-SA / CC0 / PD / PROPRIETARY / UNSPLASH /
  /// PEXELS / PIXABAY etc. PROPRIETARY-but-permissive licences (Unsplash /
  /// Pexels / Pixabay) don't require attribution; CC-BY / CC-BY-SA do.
  licenceCode String?

  /// Link to the full licence text (e.g. https://creativecommons.org/licenses/by/4.0/).
  licenceUrl String?

  /// Computed at insert time from licenceCode. When true, the public renderer
  /// surfaces a discreet attribution tooltip on the hero.
  requiresAttribution Boolean @default(false)

  /// Verification verdict from the image-sourcing pipeline. A worker session
  /// (Claude Code, using its built-in multimodal Read capability) compares the
  /// image against the tutorial title / key ingredients / cuisine and decides
  /// whether the image is a plausible match. UNVERIFIED rows are picked up by
  /// the sweep script. REJECTED_USED_PROCEDURAL means the orchestrator could
  /// not find a plausible image even from Flux fallback and the tutorial fell
  /// back to its procedural card.
  verificationStatus MediaVerificationStatus @default(UNVERIFIED)
  verificationReason String?
  verifiedAt         DateTime?

  tutorialsHero    Tutorial[]
  ugcPhotos        UGCPhoto[]
  makerHeaderUsers User[]     @relation("UserMakerHeader")

  // Homepage browse-tile overrides (phase_homepage_fixes_001).
  categoryTileImages Category[] @relation("CategoryTileImage")

  // Pattern Studio (phase_pattern_studio_001).
  patternThumbnails Pattern[]  @relation("PatternThumbnail")
  patternHeros      Pattern[]  @relation("PatternHero")
  designerAvatars   Designer[]

  // Crochet Studio (phase_crochet_pattern_001).
  crochetPatternThumbnails    CrochetPattern[]      @relation("CrochetPatternThumbnail")
  crochetPatternSchematics    CrochetPattern[]      @relation("CrochetPatternSchematic")
  crochetPatternHeros         CrochetPattern[]      @relation("CrochetPatternHero")
  crochetPatternLoomHeros     CrochetPattern[]      @relation("CrochetPatternLoomHero")
  needleworkPatternThumbnails NeedleworkPattern[]   @relation("NeedleworkPatternThumbnail")
  needleworkPatternHeroes     NeedleworkPattern[]   @relation("NeedleworkPatternHero")
  crochetGaugeSwatchPhotos    CrochetProjectGauge[] @relation("CrochetGaugeSwatchPhoto")

  // Knitting Studio (phase_knitting_pipeline_001).
  knittingPatternThumbnails KnittingPattern[] @relation("KnittingPatternThumbnail")
  knittingPatternSchematics KnittingPattern[] @relation("KnittingPatternSchematic")
  knittingPatternHeros      KnittingPattern[] @relation("KnittingPatternHero")

  // Sewing S-2 (phase_sewing_schema_001).
  sewingPatternHeros SewingPattern[] @relation("SewingPatternHero")

  // Sewing S-8b: AI-generated product-shot heroes for bag / home /
  // accessory patterns.
  sewingPatternHeroProductShots SewingPattern[] @relation("SewingPatternHeroProductShot")

  // Optional semantic category for Media rows where the source / type pair
  // doesn't fully disambiguate. Set by category-specific generators (S-8b
  // for product shots; future flat-drawing batches likewise). Null on all
  // pre-existing rows.
  kind MediaKind?

  // Crochet image pipeline (phase_crochet_image_pipeline).
  stitchPreviews Stitch[] @relation("StitchPreview")

  // User pattern photo submissions (phase_user_pattern_photo_001).
  userPatternPhotos UserPatternPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([source])
  @@index([verificationStatus])
}

enum MediaType {
  PHOTO
  VIDEO
  DIAGRAM
  ILLUSTRATION
}

enum MediaStatus {
  UPLOADING
  READY
  FAILED
}

enum MediaVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  REJECTED_USED_PROCEDURAL
  /// Set by Pipeline B when Fal img2img fails the structural verification
  /// gate and the synthetic chart render is used as the fallback hero.
  SYNTHETIC_FALLBACK
}

/// Semantic kind tag for Media rows produced by a specific generator.
/// Optional; pre-existing rows leave it null. Lets queries filter for "all
/// product-shot heroes" without overloading the Media.type / Media.source
/// pair.
enum MediaKind {
  HERO_PRODUCT_SHOT
}

/// Shared by Tutorial.diagramGenerationStatus, Pattern.heroGenerationStatus,
/// and CrochetPattern.heroGenerationStatus. Each pipeline only writes a
/// subset of these values. Pipeline A (diagrams) never sets
/// SYNTHETIC_FALLBACK; Pipeline B (heroes) never sets NO_SOURCE.
enum ImageGenerationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED_VERIFICATION
  SYNTHETIC_FALLBACK
  NO_SOURCE
}

// ────────────────────────────────────────────────────────────────────────────
// User state — bookmarks + projects (Phase 4)
// ────────────────────────────────────────────────────────────────────────────

model Bookmark {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  // Maker profile (Session A). Per-bookmark public-on-profile toggle; default
  // false. When true, this bookmark renders on the Maker's public Make it list
  // at /m/{handle} (provided the Maker has isPublicMakerProfile=true).
  isPublic Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, tutorialId])
  @@index([userId])
}

// One SavedPattern per (user, pattern) — the pattern equivalent of Bookmark,
// so a single "Make it list" can hold both tutorials and patterns. Additive:
// the existing tutorial Bookmark table is untouched; the Make it list merges
// both at the read layer.
model SavedPattern {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  patternId String
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  // Mirrors Bookmark.isPublic — per-save toggle for the public Maker profile.
  isPublic Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, patternId])
  @@index([userId])
}

// One SavedRecipe per (user, community recipe) — completes the unified Make
// it list across tutorials, patterns and community (UserRecipe) recipes.
// Additive, same shape as Bookmark / SavedPattern.
model SavedRecipe {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userRecipeId String
  userRecipe   UserRecipe @relation(fields: [userRecipeId], references: [id], onDelete: Cascade)

  isPublic Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, userRecipeId])
  @@index([userId])
}

// One UserProject per (user, tutorial). Tracks "I'm making this" lifecycle plus
// the reader's private notes, supplies tick-list, and reading progress.
model UserProject {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  status      UserProjectStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  abandonedAt DateTime?

  notes                  String   @default("")
  suppliesChecked        Json     @default("[]")
  readingProgressPercent Int      @default(0)
  lastViewedAt           DateTime @default(now())

  // Phase 8 Homepage rebuild — multi-day arc tracker. Long-arc tutorials
  // (sourdough starters, fermentation, growing) register `ProjectSchedule`
  // rows; when the user starts a project these denormalised fields snapshot
  // the next step that should surface so the homepage scheduled-actions
  // rail and the hero state-machine can read without joining ProjectSchedule
  // on every request.
  nextScheduledStepNumber Int?
  nextScheduledAt         DateTime?
  scheduledStepsCompleted Int[]     @default([])

  // Maker profile (Session A) — the Made it log. `isPublic` opts a single
  // project into the public Maker profile at /m/{handle}/made/{projectId};
  // defaults false so private/legacy rows never leak. `publishedAt` is set
  // the first time isPublic flips true (and never cleared). `publicNote` is
  // separate from `notes` (private) so the Maker can write commentary for
  // public view without leaking private notes. `whatIUsed` is a JSON array
  // of { name, note?, productId?, productUrl? } — productId/productUrl are
  // reserved for Session K (marketplace) and stay null for now. `heroPhotoId`
  // overrides which UGCPhoto displays as the hero on the Made it detail page;
  // null = pick the most recent approved UGCPhoto, or fall back to tutorial
  // hero.
  isPublic    Boolean   @default(false)
  publicNote  String?
  whatIUsed   Json?
  publishedAt DateTime?
  heroPhotoId String?
  heroPhoto   UGCPhoto? @relation("UserProjectHeroPhoto", fields: [heroPhotoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tutorialId])
  @@index([userId])
  @@index([status])
  @@index([nextScheduledAt])
  @@index([isPublic, publishedAt])
}

enum UserProjectStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// ────────────────────────────────────────────────────────────────────────────
// Chart progress — per-user mark-stitched / mark-row / mark-step state
// ────────────────────────────────────────────────────────────────────────────

// One row per (user, tutorial, chart index) the reader has touched. Charts
// are not anonymously viewable — every reader is signed-in by the time a
// ChartProgress row exists. A single tutorial can contain multiple charts;
// `chartIndex` is the 0-based ordinal of the chart node inside the tutorial
// body (left-to-right, top-to-bottom traversal of the TipTap doc).
//
// The chart type (cross-stitch vs craft-chart vs origami vs weaving) drives
// which fields are meaningful: cross-stitch uses `markedCells`; knitting /
// crochet / weaving use `markedRows`; origami uses `markedSteps`. The
// renderer reads only the field that matches its chart kind.
model ChartProgress {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  /// 0-based ordinal of the chart node inside the tutorial body. Tutorials
  /// often have a single chart (chartIndex = 0); the field exists so a
  /// pattern with multiple charts (e.g. a sampler with three motifs) can
  /// track them independently.
  chartIndex Int

  /// Cross-stitch marked cells. Sparse list of "x,y" strings — only the
  /// cells the user has marked. Empty array on a fresh row.
  markedCells String[] @default([])

  /// Knitting / crochet / weaving marked rows. 1-indexed row numbers.
  markedRows Int[] @default([])

  /// Origami marked steps. 1-indexed step numbers.
  markedSteps Int[] @default([])

  /// View mode for symbol-vs-colour rendering. Cross-stitch only:
  /// "symbol-on-colour" (default) | "symbol-only" (print-ink-saver) |
  /// "colour-only" (preview the finished piece).
  viewMode String @default("symbol-on-colour")

  /// Display mode for stitched-vs-remaining view. "all" (default) shows
  /// everything; "stitched" shows only completed cells; "remaining" greys
  /// completed and emphasises what's left.
  displayMode String @default("all")

  /// Palette override — optional swap from the chart's authored palette
  /// to e.g. Anchor codes or a custom recolour. JSON map of paletteKey
  /// → { hex?, dmcCode?, anchorCode?, name? }. Null = use the authored
  /// palette as-is.
  paletteOverride Json?

  /// Per-chart notes. JSON array of { id, cellX?, cellY?, rowNumber?,
  /// stepNumber?, text, createdAt }. The renderer pins notes to whichever
  /// anchor field is set (cell for cross-stitch, row for craft, step for
  /// origami).
  notes Json @default("[]")

  /// Denormalised count of marked units (cells / rows / steps depending
  /// on chart kind). Avoids re-counting the array on every list-render.
  markedCount Int @default(0)

  /// Total time spent in the viewer for this chart, in seconds.
  /// Accumulated client-side and patched in batches.
  timeSpentSeconds Int @default(0)

  /// Last interactive touch (mark, toggle, note). Drives the "resume
  /// where I left off" rail on the dashboard.
  lastTouchedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, tutorialId, chartIndex])
  @@index([userId, lastTouchedAt])
  @@index([tutorialId])
}

// ────────────────────────────────────────────────────────────────────────────
// Audit log — every admin action recorded
// ────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id      String @id @default(cuid())
  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  action   String // e.g. "tutorial.create", "tutorial.publish", "category.update"
  resource String // e.g. "Tutorial:abc123"
  metadata Json? // Action-specific data (diff, before/after, etc.)

  createdAt DateTime @default(now())

  @@index([resource])
  @@index([actorId])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 5 — UGC: reviews, photos, Q&A, errata, reports, suspensions
// ────────────────────────────────────────────────────────────────────────────

model Review {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  rating Int // 1..5
  title  String?
  body   String

  helpfulCount Int             @default(0)
  helpfuls     ReviewHelpful[]

  status ReviewStatus @default(PENDING_MODERATION)

  moderatedAt    DateTime?
  moderatedById  String?
  moderatedBy    User?     @relation("ReviewModerator", fields: [moderatedById], references: [id])
  moderationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tutorialId])
  @@index([tutorialId, status, createdAt])
  @@index([status, createdAt])
}

enum ReviewStatus {
  PENDING_MODERATION
  PUBLISHED
  HIDDEN
  REMOVED
}

model ReviewHelpful {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, reviewId])
  @@index([reviewId])
}

model UGCPhoto {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  caption String?

  status UGCPhotoStatus @default(PENDING_MODERATION)

  // NSFW pre-screen results. Null means the scanner hasn't run (or no permission).
  nsfwScore          Float?
  nsfwClassification String?

  rejectionReason String?

  moderatedAt   DateTime?
  moderatedById String?
  moderatedBy   User?     @relation("PhotoModerator", fields: [moderatedById], references: [id])

  // Back-relation: UserProjects that have picked this photo as their public
  // Made it hero. SET NULL on delete so deleting a moderated photo doesn't
  // cascade the project.
  pickedAsHeroBy UserProject[] @relation("UserProjectHeroPhoto")

  createdAt DateTime @default(now())

  @@index([tutorialId, status])
  @@index([status, createdAt])
  @@index([userId])
}

enum UGCPhotoStatus {
  PENDING_MODERATION
  APPROVED
  REJECTED
}

model Question {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  body String

  status      UGCStatus        @default(PENDING_MODERATION)
  upvoteCount Int              @default(0)
  upvotes     QuestionUpvote[]
  answers     Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorialId, status, upvoteCount])
  @@index([userId])
}

enum UGCStatus {
  PENDING_MODERATION
  PUBLISHED
  HIDDEN
  REMOVED
}

model Answer {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  body String

  /// True when the author has role ADMIN or EDITOR at write time.
  isAuthorAnswer Boolean @default(false)

  status       UGCStatus @default(PENDING_MODERATION)
  helpfulCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId, status])
}

model QuestionUpvote {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, questionId])
  @@index([questionId])
}

model Errata {
  id String @id @default(cuid())

  /// Nullable so future anonymous reports can flow through. In practice the
  /// splash gate means every reporter has a session.
  userId String?
  user   User?   @relation("ErrataAuthor", fields: [userId], references: [id], onDelete: SetNull)

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  body String

  status ErrataStatus @default(OPEN)

  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("ErrataResolver", fields: [resolvedById], references: [id])
  resolutionNote String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([tutorialId])
}

enum ErrataStatus {
  OPEN
  ADDRESSED
  DISMISSED
}

model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  /// Generic ID into the target table. Not a FK because the target type varies.
  targetId   String

  reason      ReportReason
  description String?

  status           ReportStatus @default(OPEN)
  resolutionAction String?

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

enum ReportTargetType {
  REVIEW
  PHOTO
  QUESTION
  ANSWER
  USER
  // Session A addendum — Maker profile content moderation. `MAKER_BIO`,
  // `MAKER_HANDLE`, and `MAKER_HEADER_IMAGE` target the User row directly
  // (targetId = User.id). `MAKER_PROJECT_PUBLIC_NOTE` and
  // `MAKER_PROJECT_WHAT_I_USED` target a UserProject (targetId =
  // UserProject.id). Admin upholding clears the specific field rather than
  // hiding the whole row.
  MAKER_BIO
  MAKER_HANDLE
  MAKER_HEADER_IMAGE
  MAKER_PROJECT_PUBLIC_NOTE
  MAKER_PROJECT_WHAT_I_USED
}

enum ReportReason {
  SPAM
  ABUSE
  MISINFORMATION
  COPYRIGHT
  NSFW
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED_ACTION_TAKEN
  RESOLVED_NO_ACTION
  DISMISSED
}

model UserSuspension {
  id String @id @default(cuid())

  userId String
  user   User   @relation("SuspensionSubject", fields: [userId], references: [id], onDelete: Cascade)

  suspendedById String
  suspendedBy   User   @relation("SuspensionActor", fields: [suspendedById], references: [id])

  reason String

  startedAt DateTime  @default(now())
  /// Null means indefinite / permanent.
  endsAt    DateTime?

  liftedAt   DateTime?
  liftedById String?
  liftedBy   User?     @relation("SuspensionLifter", fields: [liftedById], references: [id])

  status SuspensionStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([status, endsAt])
}

enum SuspensionStatus {
  ACTIVE
  LIFTED
  EXPIRED
}

/// In-app notifications surfaced under /me. Intentionally small — moderation
/// outcomes + a couple of system messages. Email + push are deferred.
model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType
  body String
  /// Optional URL the user can click through to (e.g. the published review).
  href String?

  readAt DateTime?

  /// Mobile rebuild — set when this notification was also pushed to one of
  /// the user's `PushSubscription` devices. `pushedAt` records when the
  /// dispatch ran (may differ from `createdAt` because some categories are
  /// batched into the daily 09:00 cron). `pushed = true && pushedAt = null`
  /// shouldn't happen; treat it as "scheduled, not yet sent."
  pushed   Boolean   @default(false)
  pushedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum NotificationType {
  REVIEW_PUBLISHED
  REVIEW_HIDDEN
  REVIEW_REMOVED
  PHOTO_APPROVED
  PHOTO_REJECTED
  QUESTION_PUBLISHED
  QUESTION_HIDDEN
  ANSWER_PUBLISHED
  ANSWER_HIDDEN
  ERRATA_ADDRESSED
  ERRATA_DISMISSED
  ACCOUNT_SUSPENDED
  ACCOUNT_UNSUSPENDED
  CREATOR_APPLICATION_APPROVED
  CREATOR_APPLICATION_REJECTED
  CREATOR_TUTORIAL_PUBLISHED
  CREATOR_TUTORIAL_REJECTED
  CREATOR_TUTORIAL_SUBMITTED
  PATTERN_TEST_APPLICATION_ACCEPTED
  PATTERN_TEST_APPLICATION_REJECTED
  PATTERN_TEST_FEEDBACK_RECEIVED
  // Session A addendum — fired when a moderator clears a field on the
  // Maker's public profile after an upheld report (bio, handle, header,
  // publicNote, or a What-I-used entry). Body explains which field was
  // removed; href points the Maker to /me/settings or the project edit.
  MAKER_PROFILE_CONTENT_REMOVED
  // Recipe creator economy — fired by the AI moderation pass.
  USER_RECIPE_APPROVED
  USER_RECIPE_REJECTED
  SYSTEM
}

/// Mobile rebuild — one row per registered push-token (per platform per
/// install). When a user uninstalls and reinstalls the app, Capacitor's
/// per-install UUID changes, so a fresh row is created and the previous one
/// is marked `revokedAt` lazily when delivery fails. `enabledCategories`
/// stores which notification categories the user has opted into; an empty
/// array means "all enabled categories at registration time"; the per-category
/// settings page rewrites this list.
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform    PushPlatform
  deviceToken String
  deviceId    String?
  userAgent   String?

  enabledCategories String[] @default([])

  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, platform])
  @@index([deviceToken])
  @@index([revokedAt])
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 6 — Creator program + pattern testing
// ────────────────────────────────────────────────────────────────────────────

/// One row per user who has applied for or holds the creator role. The
/// application + decision history lives on the row; once decidedAt is set,
/// `applicationStatus` reflects the outcome. The owning user's `isCreator`
/// flag is set on approval so role checks don't need a join.
model CreatorProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("CreatorProfileOwner", fields: [userId], references: [id], onDelete: Cascade)

  bio       String
  specialty String

  // Optional social links surfaced on the public maker profile.
  websiteUrl      String?
  instagramHandle String?
  youtubeHandle   String?
  tiktokHandle    String?
  substackUrl     String?
  pinterestHandle String?

  applicationStatus CreatorApplicationStatus @default(APPLIED)
  applicationNote   String?
  appliedAt         DateTime                 @default(now())
  decidedAt         DateTime?
  decidedById       String?
  decidedBy         User?                    @relation("CreatorProfileDecider", fields: [decidedById], references: [id])
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationStatus, appliedAt])
}

enum CreatorApplicationStatus {
  NONE
  APPLIED
  APPROVED
  REJECTED
}

/// A pattern test is run by a creator (or future Homemade staff) on a tutorial
/// they own. Members opt in via `TestAssignment`. Once feedback is in, the
/// creator sees aggregated form data on the `feedback` page.
model PatternTest {
  id String @id @default(cuid())

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  status PatternTestStatus @default(DRAFT)

  /// Title shown on the public board — can differ from the tutorial title.
  title           String
  briefForTesters String
  maxTesters      Int    @default(5)

  recruitingClosesAt DateTime?
  completedAt        DateTime?

  assignments TestAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([creatorId, status])
  @@index([tutorialId])
}

enum PatternTestStatus {
  DRAFT
  RECRUITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// One row per (test, tester). Tracks lifecycle from APPLIED through
/// COMPLETED and stores the structured feedback JSON blob the tester submits.
model TestAssignment {
  id String @id @default(cuid())

  patternTestId String
  patternTest   PatternTest @relation(fields: [patternTestId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          TestAssignmentStatus @default(APPLIED)
  applicationNote String?

  /// Structured feedback form output. Shape:
  /// {
  ///   patternClarity: { score: 1..5, comment: string },
  ///   instructionClarity: { score: 1..5, comment: string },
  ///   photoAccuracy: { score: 1..5, comment: string },
  ///   suppliesAccuracy: { score: 1..5, comment: string },
  ///   timeTakenMinutes: number | null,
  ///   estimatedTimeMinutes: number | null,
  ///   whatWorked: string,
  ///   whatDidnt: string,
  /// }
  feedback Json?

  appliedAt       DateTime  @default(now())
  decidedAt       DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  withdrawnAt     DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patternTestId, userId])
  @@index([userId, status])
  @@index([patternTestId, status])
}

enum TestAssignmentStatus {
  APPLIED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  WITHDRAWN
  REJECTED
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 8a — Legal compliance: GDPR data rights + DMCA takedowns
// ────────────────────────────────────────────────────────────────────────────

/// One row per data-export request a user has fired. Holds the bundle URL
/// once produced. `expiresAt` is enforced at read time — once past, the
/// download link 410s and the row is marked EXPIRED.
model DataExportRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status DataExportStatus @default(REQUESTED)

  /// Public URL the user can fetch the bundle from (R2 custom domain).
  fileUrl String?
  /// R2 object key — kept so we can delete the bundle after expiry.
  fileKey String?
  bytes   Int?

  error String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

enum DataExportStatus {
  REQUESTED
  PROCESSING
  READY
  EXPIRED
  FAILED
}

/// One active row per user — `userId` is unique. While SCHEDULED, the user
/// is also flagged `isSuspended = true` so the account can't be used during
/// the grace period; cancelling lifts the suspension. After
/// `scheduledFor` passes a follow-up job (manual for now) runs the hard
/// delete: scrubs PII, sets `User.deletedAt`, preserves audit log entries.
model AccountDeletionRequest {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason String?

  status DeletionStatus @default(SCHEDULED)

  /// 30 days after `requestedAt`. A scheduled hard-delete job picks up rows
  /// past this date; until then the user can cancel.
  scheduledFor DateTime
  requestedAt  DateTime  @default(now())
  cancelledAt  DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
}

enum DeletionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

/// DMCA / takedown notices from outside the platform. We never want to
/// trust the claimant blindly — every record stores their sworn-statement
/// acceptance and a contact trail. Admin actions are audit-logged via the
/// shared `audit()` helper.
model DmcaTakedownRequest {
  id String @id @default(cuid())

  claimantName    String
  claimantEmail   String
  claimantAddress String?

  /// The URL or location of the allegedly infringing content. Free text
  /// because claimants don't always send a clean URL.
  contentUrl         String
  /// Description of the work being infringed and how it's being infringed.
  contentDescription String

  /// The DMCA notice requires the claimant to swear under penalty of perjury
  /// that the information is accurate and they are authorised to act. We
  /// don't accept a notice without this box ticked.
  swornStatementAccepted Boolean @default(false)

  status DmcaStatus @default(RECEIVED)

  actionTakenNote String?

  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("DmcaResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
}

enum DmcaStatus {
  RECEIVED
  UNDER_REVIEW
  ACTION_TAKEN
  REJECTED
  COUNTER_NOTICED
}

// ────────────────────────────────────────────────────────────────────────────
// Pre-launch signup allowlist
// ────────────────────────────────────────────────────────────────────────────

/// Pre-launch gate that pairs with the Clerk dashboard Restrictions feature.
/// While `SIGNUP_ALLOWLIST_ENABLED` is true (in the webhook handler), any
/// Clerk signup whose primary email isn't on this table is deleted via the
/// Clerk Backend API immediately and the Prisma mirror row is rolled back.
/// Flipped off on launch day — see `project_pre_launch_checklist.md`.
model SignupAllowlist {
  id String @id @default(cuid())

  /// Lowercased before write. Unique so we can't have stale duplicates.
  email String @unique

  /// The admin who added the entry. ON DELETE SET NULL so removing an admin
  /// account doesn't drop allowlist rows.
  addedById String?
  addedBy   User?   @relation("SignupAllowlistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  /// Optional free-text context, e.g. "Phase 6 creator test account".
  note String?

  /// Set when an allowlisted user actually signs up. Lets us spot stale
  /// entries that were never used.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([addedById])
}

// ────────────────────────────────────────────────────────────────────────────
// Admin overhaul — SavedFilter + AdminCommandHistory. SavedFilter persists
// the content-list filter chips an editor wants to reuse (e.g. "RECIPE drafts
// with no hero"). AdminCommandHistory feeds the cmd-K palette's "recent
// commands" rail.
// ────────────────────────────────────────────────────────────────────────────

model SavedFilter {
  id String @id @default(cuid())

  userId String
  user   User   @relation("SavedFilterOwner", fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?

  /// JSON blob mirroring the URL query string the content list uses. Shape
  /// is owned by the content-list page; persisted opaquely so we can iterate
  /// the filter UI without migrations.
  filterQuery Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model AdminCommandHistory {
  id String @id @default(cuid())

  userId String
  user   User   @relation("AdminCommandActor", fields: [userId], references: [id], onDelete: Cascade)

  /// Free-form command identifier — "publish_current", "goto_glossary",
  /// "search_tutorial:<id>", etc. The palette decides how to interpret it
  /// when surfacing it back in the Recent rail.
  command String

  /// Optional context (current route, tutorialId, etc.) captured at fire time.
  context Json?

  executedAt DateTime @default(now())

  @@index([userId, executedAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 8 — Master ingredient + tool tables. Recipes link to these via
// RecipeIngredient / RecipeTool join rows. The Ingredient table is the single
// source of truth for dietary flags, allergens, UK/US naming, substitutes —
// so "plain flour" carries its own gluten flag once and every recipe inherits.
// ────────────────────────────────────────────────────────────────────────────

model Ingredient {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// Optional explicit plural (used in summaries / titles). Falls back to the
  /// English `name + "s"` heuristic at render time when null.
  pluralName String?

  /// Free-form string enum: flour / dairy / meat / fish / vegetable / fruit /
  /// herb / spice / condiment / baking / pulse / grain / nut / seed / oil /
  /// vinegar / sweetener / alcohol / other. Kept as a string rather than a
  /// Prisma enum so authors can add categories without a follow-up migration.
  category String

  /// g / ml / each / tbsp / tsp / cup / pinch. Authors may override per
  /// RecipeIngredient via RecipeIngredient.unit.
  defaultUnit String

  /// Per-ingredient dietary flags — recipes derive their own dietaryFlags
  /// from the AND of their ingredient flags at index time.
  dietaryFlags String[]

  /// Slugs of other Ingredient rows that work as 1:1 substitutes.
  commonSubstitutes String[]

  /// Alternative names (UK ↔ US, regional). Indexed at search time so
  /// "rapeseed oil" finds "canola oil" and similar.
  aliases String[]

  /// Free-form notes — UK/US naming, prep tips, sourcing hints.
  notes String?

  /// Beginner-mode helper line surfaced in the structured-ingredients block
  /// when the reader has beginnerMode on. Per docs/page-design.md § 7.1.
  beginnerNote String?

  /// Cupboard-mode flag — items the average kitchen will already have
  /// (salt, pepper, plain flour, olive oil, …). Phase 8 cupboard-mode UI hooks
  /// off this so recipes that need 90% staples surface first.
  isStaple Boolean @default(false)

  /// UK 14-allergen list. When true, `allergenType` carries which group.
  isAllergen   Boolean @default(false)
  /// gluten / crustaceans / eggs / fish / peanuts / soybeans / milk / nuts /
  /// celery / mustard / sesame / sulphites / lupin / molluscs.
  allergenType String?

  /// Months when fresh-and-in-season, e.g. `["june", "july", "august"]`.
  /// Empty for pantry items.
  seasonality String[]

  /// Typical shelf life in days (fridge / cupboard depending on `storage`).
  shelfLifeDays Int?
  /// "fridge", "cool dark cupboard", "freezer".
  storage       String?

  /// Per-100g nutritional info. Flexible Json shape so we can refine later
  /// without re-migrating; stays null until populated.
  nutritionalInfoPer100g Json?

  /// Recipe foundation (phase_recipe_foundation_001). Density in g/ml, used by
  /// the render-time unit helper to convert between mass and volume (flour
  /// ≈ 0.53, caster sugar ≈ 0.85, water = 1.0, oil ≈ 0.92). Null = the renderer
  /// can't reconcile this ingredient between grams and cups, so it shows the
  /// authored unit unchanged rather than guessing.
  densityGPerMl Decimal?

  /// Recipe foundation. Supermarket-aisle grouping that the future shopping-list
  /// aggregator sorts by. Null renders as OTHER. Seeded from `category` at
  /// backfill; authors can override per ingredient.
  aisle IngredientAisle?

  recipeIngredients RecipeIngredient[]

  /// Recipe foundation. Richer substitution graph (ratio + context +
  /// flavour delta) layered over the legacy `commonSubstitutes` slug array.
  /// The array stays as the quick render-time hint; these rows carry the
  /// detail the substitution surface and shopping-list swaps need.
  substitutions         IngredientSubstitution[] @relation("MainIngredientSubstitutions")
  substitutedBy         IngredientSubstitution[] @relation("AltIngredientSubstitutions")
  userRecipeIngredients UserRecipeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isStaple])
  @@index([isAllergen])
  @@index([aisle])
}

model Tool {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// knife / pan / pot / oven / mixer / processor / measuring / bowl / tray /
  /// tin / board / utensil / appliance / electrical / thermometer / scale /
  /// other. Free-form string for the same forwards-compat reason.
  category String

  /// Alternative names ("stand mixer" alias for "KitchenAid", "loaf tin"
  /// alias for "bread pan").
  aliases String[]

  /// Flips false for tools we'll never sell (e.g. a sink). Lets the future
  /// marketplace filter out non-purchasable rows up-front.
  isPurchasable Boolean @default(true)

  /// Typical price in pennies (GBP). Phase 7 marketplace sorts the buy panel
  /// by this. Stays null until Rebecca sets one.
  typicalPriceGbp Int?

  notes String?

  recipeTools RecipeTool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPurchasable])
}

/// One row per (recipe, ingredient). Derived from the `ingredientsList` block
/// in the recipe body on every save — see `syncRecipeIngredientsFromBody` in
/// `apps/web/src/lib/recipe-ingredients-sync.ts`.
model RecipeIngredient {
  id String @id @default(cuid())

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  /// Null means "to taste" / "as needed".
  amount Float?
  /// Overrides Ingredient.defaultUnit when set.
  unit   String?

  /// "finely chopped", "at room temperature", "zest only".
  prepNote String?

  isOptional Boolean @default(false)

  /// Sub-heading the row sits under in the rendered list ("For the dough",
  /// "For the topping"). Null = renders under the recipe's main "Ingredients".
  groupLabel String?

  /// Display order within the group.
  position Int

  /// When false, the scale selector and "swap with substitute" affordance
  /// are suppressed for this row (e.g. flour percentages in bakery).
  substitutionAllowed Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorialId, position])
  @@index([ingredientId])
}

/// One row per (recipe, tool). The `equipmentList` TipTap block is deferred to
/// a future small session; for now these rows can be seeded directly when
/// recipes are authored, even though there's no editor block writing them yet.
model RecipeTool {
  id String @id @default(cuid())

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Restrict)

  isOptional Boolean @default(false)
  /// "or any oven-safe non-stick pan".
  notes      String?

  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorialId, position])
  @@index([toolId])
}

// ────────────────────────────────────────────────────────────────────────────
// Recipe foundation (phase_recipe_foundation_001)
//
// Layers the user-uploaded recipe surface + a richer substitution graph on top
// of the existing Ingredient / RecipeIngredient ontology (1,000+ canonical
// ingredients, already backfilled against published cooking / baking /
// herbal-medicine / natural-home tutorials). UserRecipe is deliberately
// distinct from Tutorial: ownership, lifecycle and AI-moderation state differ,
// and Tutorial stays the Homemade-authored library. UserRecipeIngredient and
// IngredientSubstitution both FK to the same canonical Ingredient table so the
// shopping-list + meal-plan workers aggregate user recipes and library recipes
// through one ingredient identity.
// ────────────────────────────────────────────────────────────────────────────

enum IngredientAisle {
  PRODUCE
  DAIRY
  MEAT_FISH
  PANTRY_DRY
  PANTRY_OIL
  PANTRY_CONDIMENT
  PANTRY_BAKING
  FROZEN
  BAKERY
  DELI
  DRINK
  HERBS_SPICES
  HOUSEHOLD
  OTHER
}

/// One row per (main ingredient → alternative). Richer than the legacy
/// `Ingredient.commonSubstitutes` slug array: carries a conversion ratio, the
/// context the swap is appropriate for, and a one-line flavour-change note.
/// Seeded at backfill from the existing arrays (ratio null, appropriateFor
/// 'any') and enriched by a later worker. Both sides cascade-delete with their
/// Ingredient.
model IngredientSubstitution {
  id               String @id @default(cuid())
  mainIngredientId String
  altIngredientId  String

  /// Multiply the main quantity by this to get the substitute quantity
  /// (1 cup butter ≈ 0.75 cup oil → ratio 0.75). Null = swap 1:1.
  ratio Decimal?

  /// "baking" | "frying" | "any". Kept a string for forwards-compat with the
  /// ingredient-category field, which is also a free string.
  appropriateFor String?

  /// One short line on how the result changes ("slightly denser crumb").
  flavourDelta String?

  notes String?

  mainIngredient Ingredient @relation("MainIngredientSubstitutions", fields: [mainIngredientId], references: [id], onDelete: Cascade)
  altIngredient  Ingredient @relation("AltIngredientSubstitutions", fields: [altIngredientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mainIngredientId, altIngredientId])
  @@index([mainIngredientId])
  @@index([altIngredientId])
}

/// A recipe a Maker uploads. Premium-gated to create (RECIPE_UPLOAD) and to
/// browse other Makers' recipes (COMMUNITY_RECIPES); both gates default off.
/// All moderation is AI-only per the locked rule. See
/// `apps/web/scripts/moderate-user-recipes.ts`. Photos are the Maker's own
/// content and are never modified.
model UserRecipe {
  id   String @id @default(cuid())
  slug String @unique

  ownerUserId String
  owner       User   @relation("UserRecipeOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  savedBy SavedRecipe[]

  title   String
  summary String?

  /// TipTap JSON, same body shape as Tutorial for renderer compatibility.
  body Json

  cuisineTags String[]  @default([])
  dietaryTags String[]  @default([])
  mealType    MealType?

  servings         Int
  prepTimeMinutes  Int?
  cookTimeMinutes  Int?
  totalTimeMinutes Int?

  /// Conventional °C canonical (mirrors Tutorial); render helper derives the
  /// rest from the reader's OvenPreference.
  temperatureCelsius Int?

  /// Maker's own photos. Plain Media ids (no FK relation) to match the
  /// crochet stash / gallery-id pattern and keep Media's reverse-relation list
  /// from ballooning. Never modified per the image policy.
  heroPhotoMediaId String?
  galleryMediaIds  String[] @default([])

  /// Which library category this recipe belongs alongside.
  categorySlug String

  status              UserRecipeStatus @default(PENDING_AI_MODERATION)
  /// "approved" | "flagged-spam" | "flagged-duplicate" | "flagged-copyright"
  /// | "flagged-voice". Set by the AI moderation pass.
  aiModerationVerdict String?
  /// Structured findings from the moderation worker.
  aiModerationNotes   Json?
  moderatedAt         DateTime?
  publishedAt         DateTime?

  visibility UserRecipeVisibility @default(PRIVATE)

  saveCount Int @default(0)
  viewCount Int @default(0)

  /// "own" | "adapted-from" | "family-recipe" | "inspired-by".
  originalityType String?
  /// Free-text attribution when adapted / inspired by another source.
  attribution     String?

  ingredients UserRecipeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId, status])
  @@index([categorySlug, visibility, publishedAt])
  @@index([visibility, publishedAt])
}

/// One row per (user recipe, ingredient). FK to the canonical Ingredient table
/// so user recipes aggregate into the same shopping list / meal plan as
/// library recipes. Mirrors RecipeIngredient's shape.
model UserRecipeIngredient {
  id           String @id @default(cuid())
  recipeId     String
  ingredientId String

  /// Null means "to taste" / "as needed".
  quantity Decimal?
  unit     String?
  notes    String?

  isOptional Boolean @default(false)
  order      Int

  recipe     UserRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipeId, order])
  @@index([ingredientId])
}

enum UserRecipeStatus {
  DRAFT
  PENDING_AI_MODERATION
  APPROVED
  REJECTED
  ARCHIVED
}

enum UserRecipeVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  DESSERT
  DRINK
  SIDE
  OTHER
}

// ────────────────────────────────────────────────────────────────────────────
// Meal plan (phase_meal_plan_001)
//
// A Maker's weekly recipe calendar. One MealPlan per (user, week); entries slot
// a recipe into a day + meal. Entries store the recipe by plain id + a
// denormalised slug/title rather than an FK relation to Tutorial / UserRecipe,
// matching the pragmatic id-only pattern used elsewhere (UserRecipe photos,
// crochet stash) so the plan survives a recipe being unpublished and the
// shopping-list generator can read slugs without a join. Saved per-user state,
// so it is a free signed-in feature now; the MEAL_PLANNING gate flips it to
// premium later.
// ────────────────────────────────────────────────────────────────────────────

model MealPlan {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation("MealPlanOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  /// Optional label; defaults to the week date at render time when null.
  title String?

  /// Monday of the plan's week (date only). One plan per user per week.
  weekStartDate DateTime @db.Date

  entries MealPlanEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerUserId, weekStartDate])
  @@index([ownerUserId, weekStartDate])
}

model MealPlanEntry {
  id     String   @id @default(cuid())
  planId String
  plan   MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// 0 = Monday ... 6 = Sunday.
  dayOfWeek Int
  mealType  MealType

  /// What's slotted: a library recipe (Tutorial) by id + denormalised slug /
  /// title, a user recipe by id, or a free-text note. All optional so a slot
  /// can hold any one of them.
  tutorialId    String?
  tutorialSlug  String?
  tutorialTitle String?
  userRecipeId  String?
  note          String?

  /// Optional per-slot servings override (defaults to the recipe's own).
  servings Int?
  position Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, dayOfWeek])
}

/// The Maker's working shopping list, synced server-side so it follows them
/// across devices. One row per user. Server-side sync is a free sign-in carrot,
/// not a premium feature: anonymous Makers keep the same list in localStorage,
/// and a signed-in Maker's list is the same data persisted. `recipeSlugs` is
/// the set of recipes the list is built from; `tickedIngredientIds` is the
/// tick-off state so a half-shopped list survives a device switch.
model ShoppingListState {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipeSlugs         String[] @default([])
  tickedIngredientIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 8 Step 13 — Mindset pipeline schema.
//
// Adds the practice-library taxonomy (PracticeType, PracticeTarget, TimeBand,
// BestTime) plus the user-side surfaces — UserPlan / UserPlanDay for the
// 30-day plan generator (free daily pick + paid custom), DailyPick for the
// free Today view, UserPracticeFavorite / UserPracticeUse for saved + done
// state, and UserFeeling for the anonymised "I'm feeling..." matcher.
//
// Practices themselves are Tutorial rows with `type = PRACTICE` and the
// columns added on the Tutorial model above. Long-form reading articles are
// Tutorial rows with `type = READING`. No master entity table for Mindset
// (practices are self-contained; no equivalent of Ingredient / Tool).
//
// See `docs/mindset-pipeline.md` for the rationale + page mapping, and
// `docs/mindset-brainstorm.md` for the matrix that drives the library.
// ────────────────────────────────────────────────────────────────────────────

enum PracticeType {
  TAPPING
  ENERGY_STATEMENT
  AFFIRMATION
  SPELL
  RITUAL
  ACTIVITY
  JOURNAL_PROMPT
  VISUALISATION
  MEDITATION
  EMBODIMENT
  READING
}

enum PracticeTarget {
  MONEY
  BODY
  RELATIONSHIPS
  SLEEP
  ANXIETY
  CONFIDENCE
  ABUNDANCE
  STUCK
  GRIEF
  FEAR
  MOTHERHOOD
  PURPOSE
  TIME
  ENERGY
  JOY
  SPIRITUALITY
  HEALTH
  SELF_WORTH
  FORGIVENESS
  AGEING
  HOME
}

enum TimeBand {
  THREE_MIN
  FIVE_MIN
  TEN_MIN
  TWENTY_MIN
  THIRTY_PLUS
}

enum BestTime {
  MORNING
  EVENING
  ANYTIME
  AS_NEEDED
}

enum PlanTier {
  FREE_DAILY_PICK
  PAID_CUSTOM
}

enum PlanStatus {
  PENDING_GENERATION
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum PlanSlotSource {
  LIBRARY_REF
  GENERATED
}

// Pre-ferment type for breads. Straight doughs are `NONE`; flavour-building
// breads use one of the structured variants. `OTHER` for niche cultures
// (rye sour, tangzhong-style scalds repurposed as flavour-build, etc.) —
// document in the recipe body when used.
enum PreFermentType {
  NONE
  POOLISH
  BIGA
  LEVAIN
  SPONGE
  OTHER
}

/// One row per user-generated plan. `inputText` is the Path A "pour it out"
/// free-text; `inputFields` is the Path B structured JSON. Either is null
/// depending on which path the user picked. `tierAtCreation` snapshots the
/// user's tier when the plan was created — a free user who later upgrades
/// keeps their original plan as FREE_DAILY_PICK (the daily-pick surface),
/// any subsequent plan they create is PAID_CUSTOM (the 30-day custom plan).
model UserPlan {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  inputText   String?
  inputFields Json?

  /// Default daily minutes the user has for practices. The generator
  /// matches library rows whose `timeBand` falls within these budgets.
  timeMorning Int @default(5)
  timeEvening Int @default(5)

  /// Free-text anti-tags ("nothing too woo", "nothing involving the body").
  /// The generator avoids library rows that match these patterns.
  antiTags String[] @default([])

  tierAtCreation PlanTier   @default(FREE_DAILY_PICK)
  status         PlanStatus @default(PENDING_GENERATION)

  startDate   DateTime?
  currentDay  Int       @default(1)
  completedAt DateTime?

  /// Personalised paragraph from the generator addressing the user's
  /// specific situation — paid tier only.
  generatorIntro String?

  days UserPlanDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

/// One row per (UserPlan, dayNumber). Each day has three optional slots —
/// morning, evening, anchor — plus an optional reflection prompt and a
/// weekly theme. Each slot points at either a library Tutorial row
/// (`LIBRARY_REF`) or stores generated TipTap content inline (`GENERATED`).
/// Generated content is private to the user — it never enters the public
/// library and never surfaces in search or browse.
model UserPlanDay {
  id String @id @default(cuid())

  userPlanId String
  userPlan   UserPlan @relation(fields: [userPlanId], references: [id], onDelete: Cascade)

  dayNumber Int

  morningSource           PlanSlotSource @default(LIBRARY_REF)
  morningPracticeId       String?
  morningPractice         Tutorial?      @relation("PlanDayMorningPractice", fields: [morningPracticeId], references: [id], onDelete: SetNull)
  morningGeneratedContent Json?
  morningDoneAt           DateTime?

  eveningSource           PlanSlotSource @default(LIBRARY_REF)
  eveningPracticeId       String?
  eveningPractice         Tutorial?      @relation("PlanDayEveningPractice", fields: [eveningPracticeId], references: [id], onDelete: SetNull)
  eveningGeneratedContent Json?
  eveningDoneAt           DateTime?

  /// Anchor slot — the weekly ritual / activity slot. Nullable on days
  /// that don't have one. `anchorSource` is null when no anchor is set.
  anchorSource           PlanSlotSource?
  anchorPracticeId       String?
  anchorPractice         Tutorial?       @relation("PlanDayAnchorPractice", fields: [anchorPracticeId], references: [id], onDelete: SetNull)
  anchorGeneratedContent Json?
  anchorDoneAt           DateTime?

  /// Optional journal prompt for the day — typically a JOURNAL_PROMPT
  /// library row. Generated journal prompts live in
  /// `morning_generated_content` / `evening_generated_content` instead
  /// (the slot they were generated into).
  dailyReflectionPromptId String?
  dailyReflectionPrompt   Tutorial? @relation("PlanDayReflectionPrompt", fields: [dailyReflectionPromptId], references: [id], onDelete: SetNull)

  weeklyTheme String?

  /// Private. The plaintext is encrypted at the app layer before write —
  /// the column stores ciphertext only. Excluded from analytics.
  reflectionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userPlanId, dayNumber])
  @@index([userPlanId, dayNumber])
}

/// One row per (user, day). The free-tier "Today view" pick — the library
/// row surfaced for that user on that date. Unique on (userId, pickDate)
/// so the same user can't get two picks for the same day.
model DailyPick {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The calendar date the pick is for (user's local day — stored as a
  /// DATE without time so it survives time-zone changes).
  pickDate DateTime @db.Date

  practiceId String
  practice   Tutorial @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  shownAt       DateTime  @default(now())
  viewedAt      DateTime?
  markedHelpful Boolean   @default(false)
  markedDoneAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, pickDate])
  @@index([userId, pickDate])
}

model UserPracticeFavorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  practiceId String
  practice   Tutorial @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([userId, practiceId])
  @@index([userId])
}

/// One row per "I did this practice" event. Powers the user's history view
/// + feeds back into the free-tier daily pick rotation so the same row
/// doesn't surface repeatedly.
model UserPracticeUse {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  practiceId String
  practice   Tutorial @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  usedAt        DateTime        @default(now())
  contextTarget PracticeTarget?

  @@index([userId, usedAt])
  @@index([practiceId])
}

/// One row per "I'm feeling..." matcher event. `userIdHashed` is a salted
/// hash of the userId so analytics aggregates don't tie back to a single
/// account — the matcher is anonymised by default. The matched practice
/// is captured (nullable; null = no good match found) for analytics on
/// library coverage gaps.
model UserFeeling {
  id String @id @default(cuid())

  userIdHashed String

  feelingAt    DateTime       @default(now())
  targetAtTime PracticeTarget

  matchedPracticeId String?
  matchedPractice   Tutorial? @relation(fields: [matchedPracticeId], references: [id], onDelete: SetNull)

  @@index([userIdHashed, feelingAt])
  @@index([targetAtTime])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 8 Homepage rebuild — WeeklyEditorialPick + ProjectSchedule.
//
// Editorial picks: Sunday-22:00-UTC Inngest cron seeds five AUTO_SELECTED
// picks per (Mon 00:00 UTC) week-anchor four weeks ahead. Admins can pin a
// row (status -> MANUALLY_PINNED) so subsequent cron runs leave it alone, or
// replace a single position (status -> MANUALLY_REPLACED) keeping the
// original auto-pick's id on `replacedAutoPickId` for audit.
//
// ProjectSchedule rows are per-tutorial multi-day step definitions for the
// long-arc workflows (sourdough starters, fermenting, preserving, growing).
// `surfaceAs` decides whether the user's homepage hero takes over for the
// day, a rail card surfaces under "Today's scheduled project actions", or
// only an in-app notification fires.
// ────────────────────────────────────────────────────────────────────────────

enum EditorialPickStatus {
  AUTO_SELECTED
  MANUALLY_PINNED
  MANUALLY_REPLACED
}

enum ScheduleSurface {
  HERO
  RAIL_CARD
  NOTIFICATION_ONLY
}

model WeeklyEditorialPick {
  id String @id @default(cuid())

  /// Monday 00:00 UTC of the week this pick is for. The Sunday-night cron
  /// generates rows for the next four weeks.
  weekStarting DateTime

  /// 1..5. The first position is the hero pick.
  position Int

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  status EditorialPickStatus @default(AUTO_SELECTED)

  /// Clerk userId (or User.id) when an admin pinned / replaced the row.
  selectedBy String?
  selectedAt DateTime?

  /// When an admin replaces an auto-pick, store the previous WeeklyEditorialPick
  /// id so audit-trail digging can reconstruct what was overridden.
  replacedAutoPickId String?

  /// Optional admin note when pinning / replacing.
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekStarting, position])
  @@index([weekStarting])
}

/// Per-category magazine block on the Recipe-archetype landing pages
/// (/cooking, /baking, /herbal-medicine, /natural-home). Position 1 is the
/// feature card; 2..4 are the supporting cards. Pinning is optional — when
/// no rows are scheduled for the current week, the RecipeLayout falls back
/// to algorithmic most-loved picking.
model CategoryMagazinePick {
  id String @id @default(cuid())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Monday 00:00 UTC of the week this pick is for. Admin pins land per-week.
  weekStarting DateTime

  /// 1 = feature card; 2, 3, 4 = supporting cards.
  position Int

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  /// Clerk userId (or User.id) when an admin pinned the row.
  selectedBy String?
  selectedAt DateTime?

  /// Optional admin note.
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, weekStarting, position])
  @@index([categoryId, weekStarting])
}

// The old content-autopilot tables (AutopilotHaltSignal + AutopilotPauseState,
// phase_8_content_integration_001 / phase_autopilot_status_001) were removed
// 2026-07-06 — the content autopilot is retired (categories grow on demand), and
// its hourly halt-notify Inngest cron was still emailing stale June halt signals.

// ────────────────────────────────────────────────────────────────────────────
// Bulk generation autopilot switch — one row per pattern craft. The bulk cron
// (bulk/<craft>.batch) only fills when its row is enabled; the admin bulk page
// toggles it. DB-backed (not an env var) so it survives deploys and an admin can
// flip it without a redeploy.
// ────────────────────────────────────────────────────────────────────────────
model BulkAutopilotState {
  craft       String   @id // 'cross-stitch' | 'needlework'
  enabled     Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

/// One bulk-generation run (a cron firing or a manual "Run a batch"). The
/// dispatcher creates the row and fans out one Inngest event per idea; each idea
/// event updates this row with ATOMIC increments as it finishes (publish / cull /
/// reroll / error), so the admin panel sees live per-run outcomes even though the
/// ideas run as independent events. This replaces the old single-run audit entry:
/// the batch no longer runs in one long request (which the gateway 504'd), so
/// there is no single place that could write a final summary — the row IS the
/// running summary. A run is done when published + culled + errors == requested.
model BulkRun {
  id          String   @id @default(cuid())
  craft       String // 'cross-stitch' | 'needlework'
  trigger     String // 'cron' | 'manual'
  requested   Int // ideas dispatched
  published   Int      @default(0)
  culled      Int      @default(0)
  repaired    Int      @default(0)
  /// Total generation attempts across the run (best-of-N: >1 per idea).
  generations Int      @default(0)
  errors      Int      @default(0)
  gemSlugs    String[] @default([])
  /// Short gate reasons behind culls — feeds the panel's "why did it dip" view.
  killReasons String[] @default([])
  triggeredById String?
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([craft, startedAt])
  @@index([startedAt])
}

model ProjectSchedule {
  id String @id @default(cuid())

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  /// 1, 2, 3, … In step-display order.
  stepNumber Int

  /// Days after `UserProject.startedAt` this step fires.
  offsetDays Int

  title String
  body  String

  surfaceAs ScheduleSurface @default(RAIL_CARD)

  /// Does the user need to mark this step done? When false, the step is
  /// information-only (e.g. "Your starter should smell mildly yeasty by now").
  requiresUserAction Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorialId, stepNumber])
}

// ────────────────────────────────────────────────────────────────────────────
// Self-hosted analytics — phase_analytics_self_hosted_001
//
// Aura-pattern adapted: every event the app fires lands here as a row, plus
// summary tables that the nightly Inngest cron rolls up so the admin
// dashboards never aggregate over the raw table at read time.
//
// Dual-fired alongside PostHog. PostHog stays for session recordings,
// heatmaps, and ad-hoc event exploration; the dashboards under
// /admin/analytics read from these tables.
// ────────────────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Clerk id for signed-in events; null when the actor was signed out
  /// at fire time. Matches the same id PostHog stores as distinctId.
  clerkUserId String?

  /// Server-issued analytics session id (homemade-session cookie). Separate
  /// from Clerk's auth session — exists so we can stitch a single browsing
  /// session together for funnel + drop-off views regardless of auth state.
  sessionId String

  /// Event name from `docs/analytics-taxonomy.md` — e.g. tutorial_viewed.
  event String

  /// Top-level namespace derived from the event name on insert. Cheap
  /// pre-bucketing for category-level rollups. Examples: acquisition,
  /// activation, engagement, content, search, creator, account, friction.
  category String?

  /// Event payload — same shape as the PostHog properties bag.
  properties Json?

  /// Page URL the event fired on (full URL).
  url String?

  /// Just the path portion of url, denormalised so per-page rollups don't
  /// have to parse url at read time.
  pathname String?

  referrer  String?
  userAgent String?

  /// 2-letter ISO from Cloudflare CF-IPCountry header.
  country String?

  /// mobile / tablet / desktop, derived from UA at capture time.
  deviceClass String?

  /// Denormalised from User.signupCohortWeek so cohort retention queries
  /// don't have to join across tens of millions of rows. Captured at fire
  /// time — a cohort week is immutable once set on the user.
  cohortWeek String?

  /// Denormalised from User.acquisitionChannel / utm*. Same rationale —
  /// channel is set once at signup and doesn't change.
  acquisitionChannel String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?

  @@index([clerkUserId, createdAt])
  @@index([event, createdAt])
  @@index([sessionId, createdAt])
  @@index([category, createdAt])
  @@index([cohortWeek, event, createdAt])
  @@index([pathname, createdAt])
  @@index([country, createdAt])
  @@index([acquisitionChannel, createdAt])
}

/// Daily metric rollups. One row per (date, metric, dimension). dimension
/// is the literal string "__total__" for the unsplit row and a "key=value"
/// string for splits (e.g. country=GB, channel=organic, category=cooking).
/// Using a sentinel rather than null keeps the unique constraint canonical
/// — Postgres treats NULL as distinct in unique indexes, which would let
/// duplicate unsplit rows slip in past Prisma's upsert path.
model AnalyticsDailyRollup {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  metric    String
  dimension String
  value     BigInt
  createdAt DateTime @default(now())

  @@unique([date, metric, dimension])
  @@index([metric, date])
}

/// Per-(signupWeek, weeksAfterSignup) retention rollup. cohortSize is the
/// total users in the cohort; retainedCount is the count active that week;
/// retentionRate is the float ratio for fast read-side rendering of the
/// heatmap.
model AnalyticsCohortRollup {
  id               String   @id @default(cuid())
  cohortWeek       String
  weeksAfterSignup Int
  cohortSize       Int
  retainedCount    Int
  retentionRate    Float
  createdAt        DateTime @default(now())

  @@unique([cohortWeek, weeksAfterSignup])
  @@index([cohortWeek])
}

/// Idempotency tracker for the nightly rollup cron. One row per UTC date
/// processed; the cron skips dates already marked complete unless the
/// admin manually triggers a backfill.
model AnalyticsRollupRun {
  id              String    @id @default(cuid())
  date            DateTime  @unique @db.Date
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  eventsProcessed Int       @default(0)
  metricsWritten  Int       @default(0)
  error           String?
}

// ────────────────────────────────────────────────────────────────────────────
// Garden — master taxonomy (phase_garden_pipeline_001 + phase_species_kingdom_001)
//
// Species is the Garden master entity (analogous to Ingredient for
// Cooking / Baking). Renamed from PlantVariety in phase_species_kingdom_001
// + a `kingdom` discriminator (PLANTAE / FUNGI) so mushroom species can sit
// in the same master table without conflating with plants at the
// kingdom-level filter. PlantPest + CompanionPlanting are reference tables
// that growing-guide tutorials cross-link. Tutorials reference species by
// slug in body prose rather than through a structured relation — same
// pattern as the existing ingredient / tool master tables.
// ────────────────────────────────────────────────────────────────────────────

/// Companion-planting relationship between two species.
enum CompanionRelationship {
  BENEFICIAL
  NEUTRAL
  HARMFUL
}

/// Taxonomic kingdom for a Species row. Drives kingdom-level filters and
/// any "related content" rail that should not cross plants and fungi.
enum Kingdom {
  PLANTAE
  FUNGI
}

model Species {
  id            String  @id @default(cuid())
  slug          String  @unique
  commonName    String
  latinBinomial String?

  /// PLANTAE for plants (vegetables, fruit, herbs, flowers, shrubs, trees);
  /// FUNGI for mushrooms. Defaults PLANTAE so existing inserts continue to
  /// work without a backfill pass.
  kingdom Kingdom @default(PLANTAE)

  /// Self-referential pointer to the parent species when this row is a
  /// named variety ("Brandywine" → "tomato"). Null on species-level rows.
  parentSpeciesId String?
  parentSpecies   Species?  @relation("SpeciesChildren", fields: [parentSpeciesId], references: [id], onDelete: SetNull)
  varieties       Species[] @relation("SpeciesChildren")

  /// vegetable / fruit / herb / flower / shrub / tree / other. Free-form
  /// string so authors can add categories without a follow-up migration —
  /// same pattern as `Ingredient.category`.
  category String

  /// RHS hardiness — strings H1a..H7. Multi-valued because a single plant
  /// typically tolerates a range.
  rhsHardinessZone  String[] @default([])
  /// USDA zones '1'..'13' as strings.
  usdaHardinessZone String[] @default([])

  /// full-sun / partial-shade / shade.
  sunRequirement   String?
  /// low / moderate / high.
  waterRequirement String?

  /// clay / sandy / loamy / chalky / well-drained / boggy. Array because
  /// most plants tolerate more than one soil type.
  soilType String[] @default([])

  daysToMaturity Int?
  seedingDepthCm Float?
  spacingCm      Int?
  heightCm       Int?

  /// Minimum container size that supports a normal crop, in litres. Null
  /// when the data isn't known. Replaces the coarse
  /// `Tutorial.containerFriendly` boolean: a cherry tomato fits in 25 L;
  /// a beefsteak needs 40 L. Set by
  /// `phase_species_container_granularity_001`.
  minimumContainerLitres Int?

  /// Minimum direct sun the plant tolerates indoors (hours per day).
  /// Null when the data isn't known. Distinguishes a 4-hour basil from
  /// a low-light sansevieria. Set by
  /// `phase_species_container_granularity_001`.
  minimumDailyDirectSunHours Int?

  /// Which parts the kitchen uses: 'fruit' / 'leaf' / 'root' / 'stem' /
  /// 'flower' / 'seed'. Empty on purely ornamental rows; multi-valued where
  /// more than one part is edible.
  edibleParts String[] @default([])

  notes String?

  /// Cupboard-mode equivalent — true for plants the average UK garden
  /// already grows (tomato, strawberry, mint, ...). Surfaces in the
  /// "starter plot" filter.
  isStaple    Boolean @default(false)
  /// True for perennials (rosemary, asparagus, fruit trees, ...).
  isPerennial Boolean @default(false)

  /// Months when in season (sown / harvested / blooming depending on
  /// category). Lower-case month names matching `Ingredient.seasonality`.
  seasonality String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asPlant     CompanionPlanting[] @relation("CompanionAsPlant")
  asCompanion CompanionPlanting[] @relation("CompanionAsCompanion")

  @@index([category])
  @@index([kingdom])
  @@index([isStaple])
  @@index([isPerennial])
  @@index([parentSpeciesId])
}

/// Common garden pest or disease. Reference table; the public
/// pest-management surfaces cross-link these rows from growing-guide
/// tutorials. `affectedPlants` is a free-form string array of Species
/// slugs (same pattern as `Ingredient.commonSubstitutes`).
model PlantPest {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// Species slugs the pest affects.
  affectedPlants String[] @default([])

  symptoms             String?
  /// Plain-text controls. The renderer prefers organic; the conventional
  /// column is shown factually with a "follow manufacturer instructions"
  /// voice line, not as endorsement.
  organicControls      String?
  conventionalControls String?

  /// low / moderate / high / catastrophic.
  severity String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([severity])
}

/// Pairwise companion-planting relationship. The seed enforces symmetry
/// where it exists ("tomato → basil = BENEFICIAL" implies the reverse).
/// HARMFUL pairs are folklore-strength claims; the author docs require a
/// citation in `notes` rather than a bare assertion.
model CompanionPlanting {
  id String @id @default(cuid())

  plantId String
  plant   Species @relation("CompanionAsPlant", fields: [plantId], references: [id], onDelete: Cascade)

  companionId String
  companion   Species @relation("CompanionAsCompanion", fields: [companionId], references: [id], onDelete: Cascade)

  relationship CompanionRelationship
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plantId, companionId])
  @@index([plantId])
  @@index([companionId])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 8 Herbal Medicine pipeline — master reference tables.
//
// Three additive tables underpin REMEDY and HERB_PROFILE tutorials:
//
//   Herb              — master materia-medica row. ~40 starter herbs
//                       seeded via `seed-herbs.ts`. Slug-keyed so
//                       authoring briefs can reference a herb by slug.
//   Condition         — body-system-tagged condition reference (~30
//                       starter rows via `seed-conditions.ts`).
//   HerbConditionUse  — relation table; one row per
//                       (herb, condition, preparationType). Powers the
//                       "what helps for X" surface and the herb-profile
//                       "traditional uses" block.
//
// See `docs/herbal-author.md` for the safety voice rules — herbal
// medicine carries the strictest safety stakes of any category.
// ────────────────────────────────────────────────────────────────────────────

model Herb {
  id            String  @id @default(cuid())
  slug          String  @unique
  commonName    String
  latinBinomial String
  family        String?

  /// 'leaf' | 'root' | 'flower' | 'bark' | 'seed' | 'berry' | 'rhizome'
  /// | 'bulb' | 'aerial-parts' | 'whole' | 'resin'.
  partsUsed String[] @default([])

  /// nervine | adaptogen | carminative | demulcent | expectorant
  /// | anti-inflammatory | digestive-bitter | astringent | diuretic
  /// | antimicrobial | circulatory-stimulant | hepatic | diaphoretic
  /// | emmenagogue | analgesic | sedative | tonic.
  primaryActions String[] @default([])

  keyConstituents String[] @default([])

  /// 'western-herbal' | 'chinese-medicine' | 'ayurveda' | 'folk-european'
  /// | 'native-american' | 'eclectic-american' | etc.
  traditionsCited String[] @default([])

  /// 'pregnancy-caution' | 'breastfeeding-caution' | 'not-with-anticoagulants'
  /// | 'not-with-ssri' | 'not-with-contraceptives' | 'not-long-term'
  /// | 'liver-caution' | 'kidney-caution' | 'photosensitising'
  /// | 'external-use-only' | 'paediatric-caution' | 'allergen-asteraceae'
  /// | 'hypotensive' | 'hypertensive'.
  safetyFlags String[] @default([])

  drugInteractionNotes String?
  notes                String?

  tutorials     Tutorial[]         @relation("TutorialPrimaryHerb")
  conditionUses HerbConditionUse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commonName])
  @@index([latinBinomial])
}

model Condition {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// 'digestive' | 'respiratory' | 'nervous' | 'musculoskeletal' | 'skin'
  /// | 'womens-health' | 'mental-emotional' | 'immune' | 'circulatory'
  /// | 'urinary' | 'endocrine'.
  bodySystem String

  commonSymptoms        String[] @default([])
  /// When the reader must see a doctor rather than self-treat. Surfaced
  /// in the public renderer at the top of every related remedy page.
  redFlagsRequireDoctor String?
  notes                 String?

  herbUses HerbConditionUse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bodySystem])
}

model HerbConditionUse {
  id String @id @default(cuid())

  herbId String
  herb   Herb   @relation(fields: [herbId], references: [id], onDelete: Cascade)

  conditionId String
  condition   Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  /// 'tincture' | 'decoction' | 'infusion' | 'oil' | 'salve' | 'balm'
  /// | 'syrup' | 'compress' | 'poultice' | 'bath' | 'steam' | 'inhalation'
  /// | 'gargle' | 'capsule'.
  preparationType     String
  traditionalUseNotes String?

  /// 'traditional' | 'case-based' | 'clinical-trial-supported'
  /// | 'well-established'. Conservative — see `docs/herbal-author.md`
  /// § "Evidence levels".
  evidenceLevel String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([herbId, conditionId, preparationType])
  @@index([herbId])
  @@index([conditionId])
}

// Phase Sewing pipeline — master reference tables.
//
// Two additive tables underpin PATTERN and sewing-discipline TECHNIQUE
// tutorials:
//
//   Fabric       — master fabric reference (~30 starter rows seeded via
//                  `seed-fabrics.ts`). Slug-keyed; tutorials cross-link
//                  fabrics via `Tutorial.requiredFabricTypes` String[].
//   SewingNotion — haberdashery items: threads, elastics, bindings,
//                  closures, stuffing, wadding, trims (~25 starter rows
//                  via `seed-sewing-notions.ts`).
//
// See `docs/sewing-author.md` for the authoring shape and the locked
// scope rule (no fitted-garment patterns at launch — rectangles, gathered
// rectangles, panel construction, simple circles, and from-measurements
// only).
// ────────────────────────────────────────────────────────────────────────────

model Fabric {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// 'light' | 'medium' | 'heavy' | 'upholstery'.
  weightCategory String

  /// Fibre tags. Multi-valued for blends.
  /// 'cotton' | 'linen' | 'wool' | 'silk' | 'polyester' | 'nylon'
  /// | 'viscose' | 'acrylic' | 'hemp' | 'bamboo' | 'rayon' | 'jute'.
  fibreContent String[] @default([])

  /// 'crisp' | 'flowing' | 'structured'.
  drape String?

  /// Grams per square metre. Optional — only when manufacturer-standard
  /// is well-known (calico ~150-170, denim ~340-400).
  gsm Int?

  /// Project shapes the fabric suits. Free-form tags.
  suitableFor String[] @default([])

  /// 'woven-natural' | 'woven-synthetic' | 'knit' | 'non-woven'
  /// | 'interfacing' | 'lining' | 'batting' | 'specialty'.
  category String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weightCategory])
  @@index([category])
}

model SewingNotion {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// 'closure' | 'interfacing' | 'thread' | 'binding' | 'elastic'
  /// | 'stuffing' | 'trim' | 'fastener' | 'cord' | 'lining'.
  category String

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 8 Crochet pipeline scaffold — Stitch / YarnWeight / CrochetHook.
//
// Stitch is craft-keyed so the knitting + needlework pipelines that follow
// extend the same master without parallel tables. CrochetHook stays crochet-
// specific; the knitting pipeline will add KnittingNeedle on the same shape.
// See `docs/crochet-author.md` for how patterns reference these.
// ────────────────────────────────────────────────────────────────────────────

model Stitch {
  id   String @id @default(cuid())
  slug String @unique

  /// 'crochet' | 'knitting' | 'cross-stitch' | 'tatting'. Drives the
  /// browse + filter and lets the same slug ("treble") collide across
  /// crafts without conflict (slugs are craft-prefixed: 'crochet-treble').
  craft String

  /// Display name the publication uses by default. Crochet rows authored
  /// UK-first set the UK name ("treble") here.
  canonicalName String

  ukName         String?
  usName         String?
  ukAbbreviation String?
  usAbbreviation String?

  /// 'basic' | 'foundation' | 'textured' | 'lace' | 'colourwork' | 'edging'
  /// | 'joining' | 'special'. Free-form string for future categories.
  category String

  /// Symbol key the SVG chart renderer reads. Matches one of the keys in
  /// `apps/web/src/lib/craft-charts/chart-symbols.ts`. Null on stitches
  /// whose chart glyph is built per-pattern.
  chartSymbol String?

  /// 'BEGINNER' | 'INTERMEDIATE' | 'ADVANCED'. Free-form string mirrors
  /// the Tutorial difficulty axis without coupling enums.
  difficulty String?

  parentStitchId String?
  parentStitch   Stitch?  @relation("StitchParent", fields: [parentStitchId], references: [id], onDelete: SetNull)
  childStitches  Stitch[] @relation("StitchParent")

  notes String?

  /// Alternate / historic / non-English names this stitch is also known by
  /// (whipped wheel, lazy daisy, point d'araignee...). Lets an external
  /// pattern's stitch name resolve to the canonical slug. Seeded from the
  /// craft stitch dictionaries.
  aliases String[] @default([])

  // Crochet image pipeline C — small (256x256) PNG render of the
  // chartSymbol glyph in isolation. Used by the stitch chooser picker,
  // the symbol-key explainer, and the public stitch directory. Rendered
  // in-house by the chart engine; no Fal involvement.
  previewMediaId String?
  preview        Media?  @relation("StitchPreview", fields: [previewMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([craft])
  @@index([category])
  @@index([parentStitchId])
  @@index([previewMediaId])
}

model YarnWeight {
  id   String @id @default(cuid())
  slug String @unique

  /// British convention name ("DK", "Aran", "Chunky").
  canonicalName String

  /// Craft Yarn Council standard weight 0..7. INT so the renderer can
  /// sort weights without parsing strings. Unique across rows.
  standardCategory Int @unique

  /// Alternative names readers will see on yarn labels and in older
  /// pattern books. e.g. UK "DK" = US "light worsted".
  ukNames String[] @default([])
  usNames String[] @default([])

  /// Traditional fibre-artist measurement for substituting yarn at the
  /// same weight without a label. Text "14-18" so a range fits.
  wrapsPerInch String?

  /// Recommended hook + needle ranges in millimetres ("3.0-3.5mm").
  /// Both populated on every row so the renderer can show needle
  /// equivalents beside hook sizes and vice versa.
  recommendedHookRangeMm   String?
  recommendedNeedleRangeMm String?

  /// 'drapey' | 'stable' | 'firm' | 'stiff'. Surfaces in the yarn-
  /// substitution helper.
  typicalDrape String?

  /// Plain-prose hint ("Garments, blankets at scale.").
  typicalProjects String?

  notes String?

  tutorials       Tutorial[]       @relation("TutorialPrimaryYarnWeight")
  crochetPatterns CrochetPattern[] @relation("CrochetPatternPrimaryYarn")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrochetHook {
  id   String @id @default(cuid())
  slug String @unique

  /// Canonical sort key. Unique — there is one CrochetHook row per
  /// millimetre size (4.0, 4.5, 5.0, ...).
  mmSize Float @unique

  /// Display name — "4 mm hook (G/6)".
  canonicalName String

  /// Old UK steel-and-imperial number ("8" for 4 mm). Modern UK patterns
  /// use mm. May be empty when the size has no UK number equivalent.
  ukSize String?

  /// US letter+number ("G/6", "H/8", "I/9"). Empty when the mm size has
  /// no exact US equivalent.
  usSize String?

  /// Japanese hook sizes ("2/0", "3/0", ...). Surfaces because many
  /// translated patterns from Japanese yarn-craft books use these.
  jpSize String?

  /// YarnWeight slugs this hook is recommended for. String[] (no FK)
  /// mirrors PlantPest.affectedPlants — small list, frequent renderer
  /// access, no join benefit.
  suitableYarnWeightSlugs String[] @default([])

  notes String?

  tutorials       Tutorial[]       @relation("TutorialPrimaryHook")
  crochetPatterns CrochetPattern[] @relation("CrochetPatternPrimaryHook")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Knitting needle reference table. Mirrors `CrochetHook` shape exactly
/// so the renderer and authoring scripts treat hook and needle the same
/// way (only the per-craft FK on Tutorial differs).
///
/// Covers 2.0–15 mm sizes with UK + US + JP conversions and the YarnWeight
/// slugs the needle suits. The same mm size is seeded once even though
/// physically the needle ships as straight / double-pointed / circular /
/// interchangeable variants — needle "type" is part of the pattern's
/// instructions, not part of the master row identity.
model KnittingNeedle {
  id   String @id @default(cuid())
  slug String @unique

  /// Canonical sort key. Unique — one KnittingNeedle row per mm size.
  mmSize Float @unique

  /// Display name — "4 mm needle (UK 8 / US 6)".
  canonicalName String

  /// Old UK numbering (14 = 2 mm; 000 = 10 mm; inverse of US).
  ukSize String?

  /// Modern US numbering (0 = 2 mm; 50 = 25 mm).
  usSize String?

  /// Japanese needle sizes (0..14 with their own conversion). Surfaces
  /// for translated patterns from Japanese knitting books.
  jpSize String?

  /// YarnWeight slugs this needle is recommended for. Same shape as
  /// `CrochetHook.suitableYarnWeightSlugs`.
  suitableYarnWeightSlugs String[] @default([])

  notes String?

  tutorials Tutorial[] @relation("TutorialPrimaryNeedle")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────────────
// Phase Pottery & ceramics pipeline scaffold — ClayBody + CraftMaterial.
//
// ClayBody is the master clay-body registry. One row per canonical body
// (earthenware-red, stoneware-smooth, porcelain, paper-clay, polymer-clay,
// air-dry-clay). Tutorials reference rows by slug via
// `Tutorial.requiredClayBodies`.
//
// CraftMaterial is the master raw-materials registry for craft pipelines
// beyond the Ingredient / Fabric tables. Pottery is the first pipeline to
// land here; future jewellery / paper / wood-finishing pipelines will reuse
// the same shape by setting `craft` to the appropriate slug. The single
// most important field is `trainedEnvironmentOnly`, which the upload
// script reads to refuse no-equipment-track tutorials referencing raw
// silica / heavy-metal materials.
// ────────────────────────────────────────────────────────────────────────────

model ClayBody {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// 'earthenware' | 'stoneware' | 'porcelain' | 'paper-clay' | 'polymer'
  /// | 'air-dry' | 'raku' | 'terracotta'. Free-form string for forwards
  /// compatibility (raku-specific bodies, ball-clay-heavy mixes).
  bodyType String

  /// Cone range as plain text ("06-04" for low-fire earthenware, "6" for
  /// mid-fire stoneware, "9-10" for high-fire stoneware/porcelain). Null
  /// on no-fire bodies (polymer, air-dry, paper-clay used without firing).
  firingRangeCones String?

  /// True when a kiln is required to vitrify the body. Mirrors the
  /// tutorial-level `requiresKiln` flag; the list-page filter ORs the
  /// two so a stoneware tutorial that forgot to set the tutorial flag
  /// still badges correctly.
  requiresKiln Boolean @default(false)

  /// Shrinkage from wet → bisque → fired, as percent range ("12-14%").
  /// Null when the body doesn't fire.
  shrinkagePercent String?

  /// Plasticity / wedging / hand-building / wheel notes.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bodyType])
  @@index([requiresKiln])
}

model CraftMaterial {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// 'pottery' | 'jewellery' | 'paper' | 'wood-finishing'. Future craft
  /// pipelines widen this vocabulary.
  craft String

  /// Sub-category within the craft. Pottery values:
  ///   'clay-tool-attached' (slip, engobe, wax / latex resist)
  ///   'glaze-raw'           (raw glaze ingredients — silica, kaolin,
  ///                          feldspar, frits, fluxes, modifiers)
  ///   'glaze-colourant'     (oxides + stains)
  ///   'glaze-premixed'      (commercial pre-mixed glazes safe for
  ///                          home use)
  ///   'underglaze'          (commercial under-glaze decoration)
  ///   'kiln-furniture'      (kiln wash, stilts, posts in
  ///                          consumable form)
  category String

  /// True for raw silica, heavy-metal oxides at studio quantity, and
  /// any material requiring respirator + dedicated mixing space. False
  /// for pre-mixed glazes + low-toxicity rutile / iron-oxide
  /// colourants. The upload script refuses no-equipment-track
  /// tutorials referencing rows with this set to true.
  trainedEnvironmentOnly Boolean @default(false)

  /// Hazard summary surfaced verbatim by the renderer in the materials
  /// list when present. Null when the material has no special handling.
  hazardNotes String?

  /// Sourcing / handling / typical-use notes.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([craft])
  @@index([category])
  @@index([craft, category])
  @@index([trainedEnvironmentOnly])
}

// ────────────────────────────────────────────────────────────────────────────
// Session A addendum — Maker of the Month + tutorial-visit tracker
// ────────────────────────────────────────────────────────────────────────────

/// One row per editorial pick for a calendar month. The admin pastes a Maker
/// handle, the form looks them up, the row is written here with a small
/// internal reason note. The public surfaces (badge on profile, homepage
/// tile) read `monthStart <= now() <= monthEnd` to auto-expire.
model MakerOfTheMonth {
  id String @id @default(cuid())

  userId String
  user   User   @relation("MakerOfTheMonthFeatured", fields: [userId], references: [id], onDelete: Cascade)

  /// First day of the featured month at 00:00 UTC.
  monthStart DateTime
  /// Last day of the featured month at 23:59:59 UTC. Renderer checks both
  /// bounds so a single misconfigured row doesn't take over indefinitely.
  monthEnd   DateTime

  /// Admin's internal note — why this Maker was picked. Not surfaced
  /// publicly. Visible in the admin list view.
  featuredReason String

  createdByUserId String
  createdBy       User   @relation("MakerOfTheMonthPicker", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  /// Only one Maker per month — admin form replaces an existing pick rather
  /// than allowing duplicates. Composite unique on (monthStart, monthEnd)
  /// would technically allow overlap; the unique on monthStart is enough
  /// because months don't overlap when monthStart is always the first of
  /// the month.
  @@unique([monthStart])
  @@index([monthStart, monthEnd])
}

/// Per-Maker, per-tutorial visit counter for the "Did you make this?"
/// smart prompt. Incremented server-side every time `tutorial_viewed`
/// fires for a signed-in Maker. Only rows for signed-in Makers exist —
/// anonymous visits never reach this table.
///
/// Composite primary key keeps inserts cheap and avoids a sweeper job; the
/// row count is bounded by (Makers × tutorials they've viewed) which is
/// orders of magnitude smaller than AnalyticsEvent.
model TutorialVisit {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  count         Int      @default(0)
  lastVisitedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, tutorialId])
  @@index([userId, count])
}

/// Country-level climate + paper defaults, used when a user has a
/// `homeCountryCode` set but hasn't picked specific zone / paper values.
/// Phase location_climate_paper_001.
///
/// `countryCode` is ISO 3166-1 alpha-2 (UK = GB per ISO; we accept both
/// 'GB' and 'UK' as the same row by storing 'GB' canonical + the brief's
/// label).
///
/// `defaultHemisphere`, `defaultKoppenZone`, `defaultUsdaZone`,
/// `defaultRhsZone` are coarse country-average values — fine as a
/// starting point; the user can override in settings or via the
/// postcode lookup (UK / US / CA / AU, follow-up worker).
///
/// `defaultPaperSize` is 'Letter' for the four imperial countries
/// (US / MX / PH / LR) and 'A4' for everyone else. `defaultLastFrostDate`
/// + `defaultFirstFrostDate` are stored as 'MM-DD' month-day strings so
/// the year rolls automatically.
model CountryClimate {
  countryCode           String  @id
  countryName           String
  defaultHemisphere     String
  defaultKoppenZone     String
  defaultUsdaZone       String?
  defaultRhsZone        String?
  defaultPaperSize      String
  defaultLastFrostDate  String?
  defaultFirstFrostDate String?
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([defaultHemisphere])
  @@index([defaultKoppenZone])
}

// ────────────────────────────────────────────────────────────────────────────
// Pattern Studio — Pattern, Designer, PatternLicense, UserPatternProgress
// (phase_pattern_studio_001). One canonical Pattern row backs every chart
// whether it sits inside a tutorial inset, the public library, or a user's
// My Patterns drawer. Cross-stitch is v1; knitting + crochet plug into the
// same shape via PatternType.
// ────────────────────────────────────────────────────────────────────────────

/// A designer — house (Homemade) or external — credited on patterns.
model Designer {
  id              String  @id @default(cuid())
  slug            String  @unique
  displayName     String
  bio             String?
  avatarMediaId   String?
  avatar          Media?  @relation(fields: [avatarMediaId], references: [id], onDelete: SetNull)
  websiteUrl      String?
  isHouseDesigner Boolean @default(false)
  userId          String?
  user            User?   @relation("DesignerUser", fields: [userId], references: [id], onDelete: SetNull)
  patternCount    Int     @default(0)

  patterns           Pattern[]
  crochetPatterns    CrochetPattern[]    @relation("DesignerCrochetPatterns")
  needleworkPatterns NeedleworkPattern[] @relation("DesignerNeedleworkPatterns")
  knittingPatterns   KnittingPattern[]   @relation("DesignerKnittingPatterns")
  sewingPatterns     SewingPattern[]     @relation("DesignerSewingPatterns")

  createdAt DateTime @default(now())

  @@index([isHouseDesigner])
  @@index([userId])
}

/// A pattern. `data` is the validated pattern JSON (schemaVersion 1, see
/// `packages/db/src/pattern.ts`). Denormalised widthCells / heightCells /
/// colourCount / totalStitches stay in sync via the save path so library
/// surfaces never re-walk the cell list.
model Pattern {
  id                    String       @id @default(cuid())
  slug                  String?      @unique
  type                  PatternType
  name                  String
  description           String?
  data                  Json
  thumbnailMediaId      String?
  thumbnail             Media?       @relation("PatternThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)
  // Hero photograph of the finished stitched piece. Used by the
  // library card / detail hero / tutorial inset / PDF cover when set.
  // Falls back to the rendered beauty thumbnail when null. Set by the
  // Stitching Mama catalogue import (Phase C) and by the admin
  // upload flow once a tester has stitched a user-generated pattern.
  heroMediaId           String?
  hero                  Media?       @relation("PatternHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  widthCells            Int
  heightCells           Int
  colourCount           Int
  totalStitches         Int          @default(0)
  designerId            String?
  designer              Designer?    @relation(fields: [designerId], references: [id], onDelete: SetNull)
  ownerUserId           String?
  owner                 User?        @relation("PatternOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  forkedFromId          String?
  forkedFrom            Pattern?     @relation("PatternForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks                 Pattern[]    @relation("PatternForks")
  sourceTutorialId      String?
  sourceTutorial        Tutorial?    @relation("PatternSourceTutorial", fields: [sourceTutorialId], references: [id], onDelete: SetNull)
  difficulty            Difficulty?
  estimatedHours        Int?
  premium               Boolean      @default(false)
  visibility            Visibility   @default(PRIVATE)
  publishedAt           DateTime?
  // Makeability / completeness gate block reason — set when the QC pass
  // un-publishes a row (visibility -> PRIVATE) for failing the locked checklist.
  // Nullable + additive; mirrors Tutorial.qcBlockReason.
  qcBlockReason         Json?
  subCategoryId         String?
  subCategory           SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  hasBackstitch         Boolean      @default(false)
  hasFrenchKnots        Boolean      @default(false)
  hasBeads              Boolean      @default(false)
  hasQuarterStitches    Boolean      @default(false)
  fabricCountSuggested  Int          @default(14)
  recommendedHoopInches Decimal?     @db.Decimal(5, 2)

  // Popularity signal (phase_pattern_popularity_001). Denormalised engagement
  // counters + a derived popularityScore so "most popular" sorts on one indexed
  // column. popularityScore = viewCount + 3*saveCount + 5*completionCount, kept
  // consistent by atomic delta updates at each event (see lib/popularity.ts).
  // Pre-launch every counter is 0, so a popularityScore sort falls back to
  // publishedAt — i.e. most-recent — and auto-fills as real usage arrives.
  viewCount       Int @default(0)
  saveCount       Int @default(0)
  completionCount Int @default(0)
  popularityScore Int @default(0)

  // Additional finished-piece photographs the library detail page rotates
  // through. JSON array of Media.id strings; ordering is the rotation order.
  // Heroes (heroMediaId) take the primary card slot; gallery is the
  // supporting detail-page strip. Populated by the Stitching Mama catalogue
  // import (Phase C) and by the admin upload flow.
  galleryMediaIds Json @default("[]")

  // Crochet image pipeline retrofit pass — tracks the Pipeline B outcome
  // when the optional cross-stitch retrofit runs (Stitching Mama mockups
  // → Fal img2img photoreal upgrade). PENDING on rows that haven't been
  // touched by the retrofit; SUCCESS / FAILED_VERIFICATION / SYNTHETIC_FALLBACK
  // describe the verdict the retrofit reached.
  heroGenerationStatus ImageGenerationStatus @default(PENDING)

  // User-submitted finished-piece photos (phase_user_pattern_photo_001).
  // When preferUserPhotoForHero is true and an isHero=true UserPatternPhoto
  // exists for this pattern, the renderer uses that instead of heroMediaId.
  // Note: relation is via raw patternId/patternType on UserPatternPhoto --
  // no Prisma relation field here because patternId is shared across two models.
  preferUserPhotoForHero Boolean @default(false)

  license        PatternLicense?
  userProgress   UserPatternProgress[]
  savedBy        SavedPattern[]
  tutorialsInset Tutorial[]            @relation("TutorialPattern")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId, updatedAt])
  @@index([type, visibility, publishedAt])
  @@index([subCategoryId, publishedAt])
  @@index([designerId])
  @@index([forkedFromId])
  @@index([sourceTutorialId])
  @@index([heroMediaId])
  @@index([popularityScore])
}

/// Sidecar so a Pattern can be retagged (free → marketplace → premium)
/// without rewriting the pattern data. Marketplace patterns add commercial
/// attribution + a redistribution stance the renderer surfaces in the
/// floss-key footer and PDF cover.
model PatternLicense {
  id                    String      @id @default(cuid())
  patternId             String      @unique
  pattern               Pattern     @relation(fields: [patternId], references: [id], onDelete: Cascade)
  licenseType           LicenseType
  attributionRequired   Boolean     @default(true)
  commercialUseAllowed  Boolean     @default(false)
  redistributionAllowed Boolean     @default(false)
  attributionText       String?
}

/// Per-(user, pattern) progress + study state. `stitchedCells` is a JSON
/// sparse map `{ "x,y": true }`; `currentColourSymbol` caches the last-
/// active palette symbol so reopening a pattern lands on the colour the
/// user was stitching.
model UserPatternProgress {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternId           String
  pattern             Pattern   @relation(fields: [patternId], references: [id], onDelete: Cascade)
  stitchedCells       Json      @default("{}")
  currentColourSymbol String?
  notes               String?
  startedAt           DateTime  @default(now())
  lastStitchedAt      DateTime  @default(now())
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([userId, patternId])
  @@index([userId, lastStitchedAt])
  @@index([patternId])
}

enum PatternType {
  CROSS_STITCH
  KNITTING_CHART
  CROCHET_CHART
}

enum LicenseType {
  LIBRARY_FREE
  LIBRARY_PREMIUM
  MARKETPLACE
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum PaperSize {
  A4
  LETTER
  LEGAL
  A3
  A2
  A1
  A0
}

enum FlossBrand {
  DMC
  ANCHOR
  MADEIRA
}

// ────────────────────────────────────────────────────────────────────────────
// Cross-craft project + materials planner (phase_pattern_planner_001)
//
// A shared, category-agnostic planner. The tables below carry NO craft
// specifics: a project references a pattern by (craft, patternId) so any
// craft's pattern model can attach, and per-craft detail (e.g. cross-stitch
// fabric count / strands, the materials maths itself) lives in the
// application-layer materials provider, not here. Cross-stitch is the first
// adapter; crochet / knitting / needlework / sewing reuse the same tables.
// ────────────────────────────────────────────────────────────────────────────

/// Which craft a planner project or stash item belongs to. Discriminates the
/// generic `patternId` reference so the right materials provider resolves it.
/// Broader than PatternType because the planner spans crafts that do not use
/// the chart Pattern model (sewing, needlework).
enum PlannerCraft {
  CROSS_STITCH
  CROCHET
  KNITTING
  NEEDLEWORK
  SEWING
}

enum PlannerProjectStatus {
  QUEUED
  IN_PROGRESS
  FINISHED
}

/// A maker's planned project — one pattern they intend to (or are) making.
/// Ordered within the queue via `position`. Craft-specific planner choices
/// (cross-stitch fabric count + strands, a future craft's gauge, etc.) live
/// in `settings` JSON so the shared table never grows craft columns.
model PlannerProject {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  craft      PlannerCraft
  // Generic reference to the source pattern. Not a Prisma FK because the
  // target table varies by craft (Pattern, CrochetPattern, …); the materials
  // provider resolves it. For cross-stitch this is Pattern.id.
  patternId  String
  status     PlannerProjectStatus @default(QUEUED)
  position   Int                  @default(0)
  notes      String?
  targetDate DateTime?
  // Per-craft planner settings, e.g. { fabricCount: 16, strands: 2 } for
  // cross-stitch. Shape is owned by the craft's materials provider.
  settings   Json                 @default("{}")
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([userId, craft, patternId])
  @@index([userId, status])
  @@index([userId, craft])
}

/// A material the maker already owns, counted against project needs so the
/// shopping list shows what is still to buy. Generic identity columns
/// (brand / code / name / colour) cover floss, yarn, thread, fabric; the
/// provider interprets `quantityOwned` + `unit` per craft (skeins, balls,
/// metres). `attributes` holds any craft-specific extras.
model PlannerStashItem {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  craft         PlannerCraft
  brand         String?
  code          String?
  name          String?
  colourRgb     String?
  quantityOwned Float        @default(1)
  unit          String       @default("skein")
  attributes    Json         @default("{}")
  notes         String?
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, craft, brand, code])
  @@index([userId, craft])
}

// ────────────────────────────────────────────────────────────────────────────
// Crochet Studio (phase_crochet_pattern_001)
//
// A sibling family to Pattern + UserPatternProgress + PatternLicense. Crochet
// patterns have enough category-specific structure (row-by-row written data
// with per-size variants, multi-piece amigurumi, garment grading with
// measurements, mandatory gauge, UK/US convention) that a single union with
// the cross-stitch Pattern table would be 40% NULL. This family stays
// separate; the Studio shell shares URL state and routing patterns with the
// cross-stitch Studio but the data model differs.
//
// Models:
//   CrochetPattern               — the pattern row.
//   CrochetPatternLicense        — sidecar license metadata.
//   CrochetProjectProgress       — per-(user, crochetPattern) project state.
//   CrochetProjectGauge          — swatch measurements the user logged.
//   CrochetStitchMarker          — digital stitch markers per project.
//   CrochetProjectRepeatCounter  — "repeat rows N-M until X cm" counters.
//   CrochetColourScheme          — saved colour schemes (reusable).
// ────────────────────────────────────────────────────────────────────────────

/// A crochet pattern. `rowsStructured` is the canonical body — a JSON array
/// of row / round objects the Studio renders into the written view, the
/// chart, and the schematic. `chartData` is the SVG-ready chart for in-the-
/// round and motif patterns. `schematicMediaId` points to a labelled
/// measurements diagram for garments. Multi-piece patterns (amigurumi,
/// seamed garments) carry `pieces` JSON and `assemblyInstructions` TipTap.
model CrochetPattern {
  id          String  @id @default(cuid())
  slug        String? @unique
  name        String
  description String?

  // ──────────────────────────────────────────────────────────────────────────
  // Body data — structured rows, chart, schematic.
  //
  // rowsStructured shape:
  //   [{
  //     section: "Body" | "Head" | "Round 1" | ...
  //     rowNumber: 1,
  //     rowLabel: "Round 1" | "Row 1 (RS)",
  //     instruction: "Ch 3 (counts as first treble), 2 tr into the ring, ...",
  //     stitchCount: 12,
  //     stitchCountAsCluster: 4,        // optional, for cluster-counted motifs
  //     sizeVariants: { "S": { instruction, stitchCount }, "M": { ... } },
  //     special: "uk-specific" | "left-handed-note" | null,
  //   }, ...]
  //
  // chartData shape: vector — { rounds: [...], grid: [...], symbols: [...] }
  //   consumed by `apps/web/src/lib/craft-charts/svg-chart.tsx`.
  // ──────────────────────────────────────────────────────────────────────────
  rowsStructured   Json
  chartData        Json?
  schematicMediaId String?
  schematic        Media?  @relation("CrochetPatternSchematic", fields: [schematicMediaId], references: [id], onDelete: SetNull)
  thumbnailMediaId String?
  thumbnail        Media?  @relation("CrochetPatternThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)

  // Crochet image pipeline B — photoreal hero generated by Fal img2img
  // from the synthetic chart render. Null on rows where Pipeline B has
  // not run, or where verification failed and we fell back to the
  // synthetic (the renderer then falls through to thumbnailMediaId).
  // heroGenerationStatus records the verdict; the renderer never reads
  // it, so changing the status does not change visible output.
  heroMediaId          String?
  hero                 Media?                @relation("CrochetPatternHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  heroGenerationStatus ImageGenerationStatus @default(PENDING)

  // ──────────────────────────────────────────────────────────────────────────
  // Loom pattern engine (phase_crochet_pattern_engine_001).
  //
  // loomProgram is the machine-EXECUTABLE stitch program — the stitch-by-stitch
  // source the loom compiles three ways that can never drift apart: geometry
  // (the rendered hero IS the exact pattern), the written `rowsStructured`, and
  // the `chartData` symbol chart. It generalises the aspenProgram fixture shape.
  // Distinct from rowsStructured (human words) and chartData (chart vector),
  // which the loom DERIVES from it — store the program and the other two are
  // regenerable, never hand-kept in sync.
  //
  // loomProgram shape — see CrochetProgram in
  //   apps/web/src/lib/loom/crochet/engine/program.ts:
  //   { name, form: 'flat' | 'grid' | 'disc' | 'sphere',
  //     stitch?, foundation?, rows?, grid?, rounds?,
  //     yarnWeight: 'fine' | 'worsted' | 'bulky', colourHex, palette?,
  //     rowColours?, gaugeText?, finishedSizeMm?, hookMm?, notes? }
  //
  // The loom hero is the EXACT-pattern render (deterministic geometry + a
  // fidelity-gated photoreal finish, no AI drift — feedback_hero_must_be_exact
  // _pattern), so it is tracked separately from the Fal img2img hero above; a
  // pattern renderer prefers loomHero when it is present.
  // loomRenderStatus / loomRenderedAt / loomFidelityScore record the last
  // render-on-publish run; loomGeometryHash lets a re-publish skip re-rendering
  // when the compiled geometry is unchanged.
  loomProgram       Json?
  loomHeroMediaId   String?
  loomHero          Media?                @relation("CrochetPatternLoomHero", fields: [loomHeroMediaId], references: [id], onDelete: SetNull)
  loomRenderStatus  ImageGenerationStatus @default(PENDING)
  loomRenderedAt    DateTime?
  loomYarnRadiusMm  Float?
  loomFidelityScore Float?
  loomGeometryHash  String?

  assemblyInstructions Json?

  // Pattern shape and construction
  format        CrochetPatternFormat @default(WRITTEN_ONLY)
  construction  CrochetConstruction?
  shapeCategory CrochetShape?

  // Crochet autopilot foundation (phase_crochet_autopilot_foundation_001).
  // `constructionDirection` is the build-direction axis on its own,
  // separate from `construction` which conflates direction with seam
  // treatment. New autopilot rows populate it; legacy rows leave it
  // null and read direction from `construction` (e.g. TOP_DOWN_SEAMLESS
  // implies TOP_DOWN).
  // `bodyShape` is the amigurumi geometric primitive (sphere, cylinder,
  // cone, ...). Null on non-amigurumi rows. Distinct from `shapeCategory`
  // which is the finished-piece category (BLANKET, GARMENT, AMIGURUMI,
  // MOTIF, ...).
  // `gradingNotes` carries the designer's free-text notes for graders
  // (e.g. "Skip every other increase between sizes M and L to keep the
  // sleeve cap proportional.") that don't fit the `sizesGraded` JSON.
  constructionDirection ConstructionDirection?
  bodyShape             BodyShape?
  gradingNotes          String?

  // ──────────────────────────────────────────────────────────────────────────
  // Sizing.
  //
  // sizesGraded shape:
  //   [{ name: "M", bust: 92, waist: 76, hip: 96, length: 60,
  //      sleeveLength: 45, shoulderWidth: 38 }, ...]
  //   Null on non-graded patterns (blankets, amigurumi, motifs).
  //
  // yardageBySize shape:
  //   { "XS": 800, "S": 900, "M": 1000, ... } per garment size
  //   { "default": 350 } for non-graded patterns
  // ──────────────────────────────────────────────────────────────────────────
  sizesGraded   Json?
  yardageBySize Json?

  // Yarn + hook + gauge
  primaryYarnWeightId String?
  primaryYarnWeight   YarnWeight?  @relation("CrochetPatternPrimaryYarn", fields: [primaryYarnWeightId], references: [id], onDelete: SetNull)
  primaryHookId       String?
  primaryHook         CrochetHook? @relation("CrochetPatternPrimaryHook", fields: [primaryHookId], references: [id], onDelete: SetNull)
  gaugeText           String?
  finishedSizeText    String?

  // Expanded pattern template (phase_crochet_signoff_001). videoUrl is
  // optional — independent designers may add a walkthrough; Homemade-authored
  // patterns ship without one initially. notions is the structured supply list
  // (stitch markers, tapestry needle, safety eyes, stuffing, buttons) the
  // planner materials roll-up + the Studio supply tick-list read directly,
  // instead of parsing it out of the body prose. safetyNotes carries toy /
  // baby cautions (e.g. choking hazard — use embroidered eyes for under-3s)
  // where the finished item warrants it; null when not relevant.
  videoUrl    String?
  notions     String[] @default([])
  safetyNotes String?

  // ──────────────────────────────────────────────────────────────────────────
  // Multi-piece patterns (amigurumi, seamed garments).
  //
  // pieces shape:
  //   [{ name: "Head", sectionLabel: "Head", makeQuantity: 1,
  //      stuffing: "firm", stitchCountTotal: 196 }, ...]
  // buildOrder shape:
  //   ["Ears", "Head", "Body", "Arms", "Legs", "Tail", "Assembly"]
  // ──────────────────────────────────────────────────────────────────────────
  pieceCount Int   @default(1)
  pieces     Json?
  buildOrder Json?

  // Stitches + techniques used (slug refs into Stitch master table + free-form
  // technique tags). abbreviationsUsed lists the per-pattern abbreviation
  // shorthand so the renderer can build the legend. specialStitchesUsed is
  // the subset that needs an inline explainer block at the top.
  abbreviationsUsed   String[] @default([])
  specialStitchesUsed String[] @default([])
  craftStitchSlugs    String[] @default([])
  craftTechniqueTags  String[] @default([])

  // UK / US terminology. 'uk' default; per-user toggle overrides at view time.
  terminologyConvention String @default("uk")

  // ──────────────────────────────────────────────────────────────────────────
  // Per-pattern counter affordances.
  //
  // clusterCountByRound shape:
  //   { "1": 4, "2": 8, "3": 12, ... } — for motif patterns, clusters per round
  //
  // repeatRowGroups shape:
  //   [{ startRow: 2, endRow: 3, label: "Stitch pattern repeat",
  //      defaultTargetCm: 30 }] — which rows form the repeatable block
  //
  // leftHandedChartAvailable — true when chartData includes a pre-mirrored
  //   variant; false means the renderer reflects at render time.
  // ──────────────────────────────────────────────────────────────────────────
  clusterCountByRound      Json?
  repeatRowGroups          Json?
  leftHandedChartAvailable Boolean @default(false)

  // Standard cataloguing
  difficulty     Difficulty?
  estimatedHours Int?
  premium        Boolean     @default(false)
  visibility     Visibility  @default(PRIVATE)
  publishedAt    DateTime?

  // Popularity signal (phase_pattern_popularity_001) — mirrors Pattern. Shared
  // formula popularityScore = viewCount + 3*saveCount + 5*completionCount kept
  // consistent by atomic delta updates. saveCount stays 0 until a crochet
  // save path exists; completionCount seeds from CrochetProjectProgress.
  viewCount       Int @default(0)
  saveCount       Int @default(0)
  completionCount Int @default(0)
  popularityScore Int @default(0)

  // Relations
  designerId       String?
  designer         Designer?        @relation("DesignerCrochetPatterns", fields: [designerId], references: [id], onDelete: SetNull)
  ownerUserId      String?
  owner            User?            @relation("CrochetPatternOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  forkedFromId     String?
  forkedFrom       CrochetPattern?  @relation("CrochetPatternForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks            CrochetPattern[] @relation("CrochetPatternForks")
  sourceTutorialId String?
  sourceTutorial   Tutorial?        @relation("CrochetPatternSourceTutorial", fields: [sourceTutorialId], references: [id], onDelete: SetNull)
  subCategoryId    String?
  subCategory      SubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  // User-submitted finished-piece photos (phase_user_pattern_photo_001).
  // patternId/patternType on UserPatternPhoto are raw FKs, not a Prisma relation,
  // because patternId is shared across Pattern and CrochetPattern.
  preferUserPhotoForHero Boolean @default(false)

  license        CrochetPatternLicense?
  progress       CrochetProjectProgress[]
  gaugeLogs      CrochetProjectGauge[]
  stitchMarkers  CrochetStitchMarker[]
  repeatCounters CrochetProjectRepeatCounter[]
  colourSchemes  CrochetColourScheme[]         @relation("CrochetColourSchemeSource")
  tutorialsInset Tutorial[]                    @relation("TutorialCrochetPattern")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId, updatedAt])
  @@index([visibility, publishedAt])
  @@index([subCategoryId, publishedAt])
  @@index([designerId])
  @@index([forkedFromId])
  @@index([sourceTutorialId])
  @@index([shapeCategory])
  @@index([format])
  @@index([primaryYarnWeightId])
  @@index([primaryHookId])
  @@index([heroMediaId])
  @@index([loomHeroMediaId])
  @@index([popularityScore])
  @@index([craftStitchSlugs], type: Gin)
  @@index([craftTechniqueTags], type: Gin)
}

/// Sidecar so a CrochetPattern can be retagged (free → premium → marketplace)
/// without rewriting pattern data. Marketplace patterns add commercial
/// attribution + a redistribution stance the renderer surfaces in the
/// pattern footer and PDF cover.
model CrochetPatternLicense {
  id                    String         @id @default(cuid())
  crochetPatternId      String         @unique
  crochetPattern        CrochetPattern @relation(fields: [crochetPatternId], references: [id], onDelete: Cascade)
  licenseType           LicenseType
  attributionRequired   Boolean        @default(true)
  commercialUseAllowed  Boolean        @default(false)
  redistributionAllowed Boolean        @default(false)
  attributionText       String?
}

/// Per-(user, crochetPattern) project state. `completedRows` is a JSON map
/// keyed by section then row number (`{ "Body": [1,2,3], "Head": [1,2] }`).
/// `currentRow` and `currentSection` cache the active position so reopening
/// the Studio lands exactly where the user left off. `customMeasurements`
/// is set when the user opts into custom grading (premium); the renderer
/// recomputes stitch counts against the user's measurements.
model CrochetProjectProgress {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crochetPatternId String
  crochetPattern   CrochetPattern @relation(fields: [crochetPatternId], references: [id], onDelete: Cascade)

  currentRow     Int     @default(0)
  currentSection String?
  completedRows  Json    @default("{}")
  notes          String?
  perRowNotes    Json    @default("{}")

  // User overrides for this project
  gradedSize          String?
  customMeasurements  Json?
  leftHandedOverride  Boolean?
  terminologyOverride String?
  preferredView       String?
  countByCluster      Boolean  @default(false)

  /// What the maker is using on THIS project — yarn, hook, optional
  /// swatch gauge. Shape:
  ///   {
  ///     yarn?: { label: string, weightSlug?: string, colourHex?: string,
  ///              colourName?: string, yardage?: number },
  ///     hook?: { mmSize: number, brand?: string },
  ///     swatch?: { stitchesPer10cm?: number, rowsPer10cm?: number,
  ///                blocked?: boolean }
  ///   }
  /// Captured by the Studio's project setup card on first open.
  /// Surfaces in the footer once filled. Optional — patterns without
  /// gauge concerns can skip the prompt.
  projectSetup Json?

  startedAt    DateTime  @default(now())
  lastWorkedAt DateTime  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, crochetPatternId])
  @@index([userId, lastWorkedAt])
  @@index([crochetPatternId])
}

/// Swatch measurements the user logged for a project. Multiple rows per
/// project are allowed — a crocheter often resamples after the first few cm
/// of real work. `crochetPatternId` is nullable so the user can log a swatch
/// outside any active project (e.g. stash exploration).
model CrochetProjectGauge {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  crochetPatternId String?
  crochetPattern   CrochetPattern? @relation(fields: [crochetPatternId], references: [id], onDelete: Cascade)

  stitchesPer10cm Float?
  rowsPer10cm     Float?
  hookMm          Float?
  yarnLabel       String?
  blocked         Boolean @default(false)
  notes           String?

  swatchPhotoMediaId String?
  swatchPhoto        Media?  @relation("CrochetGaugeSwatchPhoto", fields: [swatchPhotoMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([crochetPatternId])
}

/// A digital stitch marker. `position` JSON identifies the marker location:
///   { type: "row", section: "Body", row: 12, stitch: 8 }
///   { type: "chart", x: 4, y: 7 }
/// The Studio surfaces markers in both the written view and the chart view.
model CrochetStitchMarker {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crochetPatternId String
  crochetPattern   CrochetPattern @relation(fields: [crochetPatternId], references: [id], onDelete: Cascade)

  position Json
  label    String?
  colour   String?

  createdAt DateTime @default(now())

  @@index([userId, crochetPatternId])
}

/// "Repeat rows N-M until 15 cm" counter. The pattern declares the repeat
/// group on CrochetPattern.repeatRowGroups; the user's counter rides on top
/// per project. `targetCm` (measure with a tape) and `targetRepeats` (count
/// the rounds) are alternatives; the user picks whichever fits her project.
model CrochetProjectRepeatCounter {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crochetPatternId String
  crochetPattern   CrochetPattern @relation(fields: [crochetPatternId], references: [id], onDelete: Cascade)

  sectionLabel  String
  repeatsWorked Int    @default(0)
  targetRepeats Int?
  targetCm      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, crochetPatternId])
}

/// User-saved colour scheme. Built from a finished project or composed
/// fresh. `colours` JSON is an ordered array — `[{ hex: "#9CAF88",
/// label: "Sage", role: "main" }, ...]`. `sourceCrochetPatternId` is the
/// pattern the scheme was first used on; null for hand-composed schemes.
model CrochetColourScheme {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                   String
  colours                Json
  sourceCrochetPatternId String?
  sourceCrochetPattern   CrochetPattern? @relation("CrochetColourSchemeSource", fields: [sourceCrochetPatternId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

enum CrochetPatternFormat {
  WRITTEN_ONLY
  WRITTEN_AND_CHART
  CHART_ONLY
}

enum CrochetConstruction {
  TOP_DOWN_SEAMLESS
  BOTTOM_UP_SEAMLESS
