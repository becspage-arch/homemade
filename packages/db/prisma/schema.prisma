// ────────────────────────────────────────────────────────────────────────────
// UserPatternPhoto — user-submitted finished-piece photos
// (phase_user_pattern_photo_001)
// ────────────────────────────────────────────────────────────────────────────

/// A finished-piece photo submitted by a Maker for a cross-stitch Pattern or
/// CrochetPattern. Flows through an admin approval queue. When approved and
/// flagged isHero=true, and the parent pattern has preferUserPhotoForHero=true,
/// this photo replaces the generated hero on the pattern detail page and card.
model UserPatternPhoto {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation("UserPatternPhotoOwner", fields: [userId], references: [id], onDelete: Cascade)
  patternId   String
  patternType PatternType
  mediaId     String
  media       Media       @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  caption     String?

  status           UserPhotoStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedBy       User?           @relation("UserPhotoReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNotes      String?

  // When true, this photo is featured in the pattern gallery.
  isFeatured Boolean @default(false)
  // When true and the parent pattern has preferUserPhotoForHero=true,
  // this photo is used as the pattern card and detail hero.
  isHero     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([patternId, status])
  @@index([userId])
}

enum UserPhotoStatus {
  PENDING
  APPROVED
  REJECTED
  RESCINDED
}

enum NeedleworkProjectPhase {
  DESIGN
  TRANSFER
  STITCHING
  FINISHING
}

// ────────────────────────────────────────────────────────────────────────────
// Phase Knitting pipeline-setup (phase_knitting_pipeline_001) — KnittingPattern
// + KnittingProjectProgress + KnittingStash.
//
// Sibling family to CrochetPattern / NeedleworkPattern. Same shape rationale:
// knitting patterns carry enough category-specific structure (row-by-row
// written data with per-size variants, optional chart data per K-2's locked
// `KnittingChartData` contract, multi-piece garments, garment grading with
// bust / waist / hip measurements, gauge in both stockinette and pattern
// stitch, cable / lace / brioche / colourwork techniques) that a single
// union with Pattern or CrochetPattern would be 40 %+ NULL.
//
// Models:
//   KnittingPattern               — the pattern row.
//   KnittingProjectProgress       — per-(user, knittingPattern) project state.
//   KnittingStash                 — per-user yarn + needle inventory.
//
// Enums in this section:
//   KnittingProjectShape          — finished-piece shape. Single-valued.
//   KnittingTechniqueDiscipline   — multi-valued; a single hat can carry
//                                   COLOURWORK + CABLE_ARAN.
//   CastOnMethod / BindOffMethod  — proper Prisma enums; Tutorial keeps the
//   / InTheRoundMethod              K-1 String? columns unchanged so existing
//                                   knitting tutorial rows need no backfill.
//   KnittingYarnWeightStandard    — CYC weight category. Named to avoid the
//                                   collision with `model YarnWeight` (the
//                                   master yarn-weight table). Pattern carries
//                                   the enum for cheap WHERE filters; richer
//                                   data (brand-name examples, gauge ranges)
//                                   stays on the YarnWeight model.
// ────────────────────────────────────────────────────────────────────────────

model KnittingPattern {
  id          String  @id @default(cuid())
  slug        String? @unique
  name        String
  description String?

  /// Optional Tutorial that introduces this pattern. Distinct from
  /// `forkedFromId` (which references another KnittingPattern).
  tutorialId String?
  tutorial   Tutorial? @relation("TutorialKnittingPattern", fields: [tutorialId], references: [id], onDelete: SetNull)

  // ──────────────────────────────────────────────────────────────────────────
  // Body data — structured rows, chart, schematic.
  //
  // rowByRow shape (TipTap JSON): the row-by-row written instructions.
  //   Mirrors crochet `rowsStructured` but as TipTap so the admin editor
  //   handles glossaryTooltip / techniqueLink / orderedList marks inline.
  //
  // chartData shape: matches K-2's locked `KnittingChartData` shape (see
  //   apps/web/src/lib/knitting/renderer/types.ts).
  // ──────────────────────────────────────────────────────────────────────────
  chartData        Json?
  rowByRow         Json?
  schematicMediaId String?
  schematic        Media?  @relation("KnittingPatternSchematic", fields: [schematicMediaId], references: [id], onDelete: SetNull)
  thumbnailMediaId String?
  thumbnail        Media?  @relation("KnittingPatternThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)

  heroMediaId            String?
  hero                   Media?                @relation("KnittingPatternHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  heroGenerationStatus   ImageGenerationStatus @default(PENDING)
  preferUserPhotoForHero Boolean               @default(false)

  // ──────────────────────────────────────────────────────────────────────────
  // Project taxonomy. `projectShape` is the finished-piece category. A
  // KnittingPattern carries exactly one shape. `techniqueDisciplines` is a
  // multi-valued list — a single colourwork-and-cable hat carries
  // [COLOURWORK, CABLE_ARAN]. The two axes co-exist in navigation per
  // phase_knitting_001's sub-cat expansion.
  // ──────────────────────────────────────────────────────────────────────────
  projectShape         KnittingProjectShape
  techniqueDisciplines KnittingTechniqueDiscipline[] @default([])

  // Method enums — proper Prisma enums on KnittingPattern. Tutorial keeps
  // the K-1 `String?` shape for backwards compatibility; the upload script
  // validates the Tutorial string against this enum's value set.
  castOnMethod     CastOnMethod?
  bindOffMethod    BindOffMethod?
  inTheRoundMethod InTheRoundMethod?

  /// Pattern-stitch gauge when it differs from stockinette gauge. JSON
  /// `{ stitchesPer10cm, rowsPer10cm, stitchName, blocked }`. Mirrors the
  /// shape from K-1's Tutorial.gaugeInPatternStitch.
  gaugeInPatternStitch Json?

  /// Per-section secondary needle sizes (mm × 10 — 50 = 5.0 mm, 275 = 2.75
  /// mm). Many garment patterns switch to a smaller needle for ribbing.
  /// The primary needle lives in `needleSizeMm`. Empty array on patterns
  /// with a single needle throughout.
  ///
  /// Kept for back-compat with K-3 callers. New patterns populate
  /// `needleBySection` instead (the K-4.1 prompt update).
  secondaryNeedleSizes Int[] @default([])

  /// Per-section needle assignment as labelled JSON. K-4.1 replacement for
  /// the bare `secondaryNeedleSizes` array. Shape:
  ///   [{ section: "ribbing", needleMm: 4.0 },
  ///    { section: "body",    needleMm: 4.5 }, ...]
  /// The K-4.1 prompt populates this on every multi-needle pattern; older
  /// rows fall back to `secondaryNeedleSizes`.
  needleBySection Json?

  /// Secondary yarn weight slugs for multi-yarn patterns (colourwork,
  /// stranded, fade). Empty array on single-yarn patterns. Slugs reference
  /// the master `YarnWeight` table.
  secondaryYarnWeightIds String[] @default([])

  /// Slug of the EasePreset row this pattern grades from. Mirrors the
  /// crochet grading library's preset vocabulary.
  easePresetSlug String?

  /// CYC yarn weight standard. Enum kept distinct from `model YarnWeight`
  /// (the master brand-name + gauge-range table) by name to avoid a Prisma
  /// collision. Pattern carries the enum for cheap library filters; canonical
  /// brand-level data stays on YarnWeight.
  yarnWeightStandard KnittingYarnWeightStandard?

  /// Primary needle size in mm. Decimal(4, 2) so 2.25 / 2.75 half-sizes
  /// round-trip cleanly.
  needleSizeMm Decimal? @db.Decimal(4, 2)

  // ──────────────────────────────────────────────────────────────────────────
  // Sizing.
  //
  // sizesGraded shape:
  //   [{ name: "M", bust: 92, waist: 76, hip: 96, length: 60,
  //      sleeveLength: 45, shoulderWidth: 38,
  //      // K-5 sweater grading keys (optional until K-5 lands):
  //      yokeDepth?, neckCircumference?, armholeDepth?,
  //      sleeveCapDepth?, upperArmCircumference?,
  //      wristCircumference?, sleeveCuffCircumference? }, ...]
  //   Null on non-graded patterns (blankets, accessories).
  //
  // yardageBySize shape:
  //   { "XS": 800, "S": 900, "M": 1000, ... } per graded size
  //   { "default": 350 } for non-graded patterns
  //
  // gaugeText / finishedSizeText carry the human-readable phrasing the
  // author writes; `gaugeInPatternStitch` carries the structured numbers.
  // ──────────────────────────────────────────────────────────────────────────
  sizesGraded           Json?
  yardageBySize         Json?
  constructionDirection ConstructionDirection?
  gaugeText             String?
  finishedSizeText      String?

  // ──────────────────────────────────────────────────────────────────────────
  // Multi-piece patterns (seamed garments, mitten thumbs).
  // Same shape as CrochetPattern.pieces / buildOrder / assemblyInstructions.
  // ──────────────────────────────────────────────────────────────────────────
  pieces               Json?
  buildOrder           Json?
  assemblyInstructions Json?

  // Stitches + techniques used.
  abbreviationsUsed   String[] @default([])
  specialStitchesUsed String[] @default([])
  craftStitchSlugs    String[] @default([])
  craftTechniqueTags  String[] @default([])

  // UK / US terminology. Knitting differs less than crochet; "tension" vs
  // "gauge" is the main slip. Per-user toggle overrides at view time.
  terminologyConvention String @default("uk")

  /// Per-row repeat groups for the repeat counter. Same shape as
  /// CrochetPattern.repeatRowGroups.
  repeatRowGroups Json?

  // ──────────────────────────────────────────────────────────────────────────
  // K-4.1 author-prompt additions. Each field corresponds to a prompt
  // requirement surfaced in the Stage 2 reference-pattern audit:
  //
  // stitchCountCheckpoints — structural "stitch count check-in" entries
  //   the author populates so the Studio + the pattern body both surface
  //   "you should have N stitches here". Shape:
  //     [{ rowOrRound: 23, expected: [88, 96, 104, 112],
  //        label: "After yoke increases" }, ...]
  //   `expected` is one int per graded size, parallel to sizesGraded order.
  //
  // lifelinePoints — row numbers at which Studio prompts the knitter to
  //   thread a lifeline (lace + brioche + chart repeats). Empty array for
  //   patterns without lifeline prompts.
  //
  // errataVersion / errataLog — pattern versioning so corrections are
  //   user-visible without a slug change. Seed migration backfills "1.0.0".
  //
  // finishedWeightGrams — declared finished weight for blankets and large
  //   shawls; helps the Studio show a yarn-runs-out warning and helps the
  //   user pick a yarn substitute.
  //
  // dominantColour — for colourwork patterns, names which yarn ID
  //   ("MC" / "CC1" / "CC2") should be held below (dominant) when
  //   stranding. Null on single-colour patterns.
  //
  // recommendedSwatchSizeCm — default 15 cm × 15 cm; cables 20 cm × 20 cm.
  //   Surfaced in the gauge section + the Studio swatch prompt.
  // ──────────────────────────────────────────────────────────────────────────
  stitchCountCheckpoints  Json?
  lifelinePoints          Int[]   @default([])
  errataVersion           String?
  errataLog               Json?
  finishedWeightGrams     Int?
  dominantColour          String?
  recommendedSwatchSizeCm Int?

  // Standard cataloguing.
  difficulty     Difficulty?
  estimatedHours Int?
  premium        Boolean     @default(false)
  visibility     Visibility  @default(PRIVATE)
  publishedAt    DateTime?

  // Relations.
  designerId    String?
  designer      Designer?         @relation("DesignerKnittingPatterns", fields: [designerId], references: [id], onDelete: SetNull)
  ownerUserId   String?
  owner         User?             @relation("KnittingPatternOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  forkedFromId  String?
  forkedFrom    KnittingPattern?  @relation("KnittingPatternForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks         KnittingPattern[] @relation("KnittingPatternForks")
  subCategoryId String?
  subCategory   SubCategory?      @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  // Reverse relations.
  progress      KnittingProjectProgress[]
  stashAssigned KnittingStash[]           @relation("KnittingStashAssignedProject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectShape, publishedAt])
  @@index([subCategoryId, publishedAt])
  @@index([designerId])
  @@index([ownerUserId, updatedAt])
  @@index([visibility, publishedAt])
  @@index([forkedFromId])
  @@index([tutorialId])
  @@index([heroMediaId])
  @@index([craftStitchSlugs], type: Gin)
  @@index([craftTechniqueTags], type: Gin)
  @@index([techniqueDisciplines], type: Gin)
}

/// Per-(user, knittingPattern) project state. Mirrors CrochetProjectProgress
/// shape but adds knitting-specific counters (round / repeat /
/// stitch-in-row / RS-WS marker) per K-3's autosave path.
model KnittingProjectProgress {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  knittingPatternId String
  knittingPattern   KnittingPattern @relation(fields: [knittingPatternId], references: [id], onDelete: Cascade)

  // Linear position counters.
  currentRow         Int     @default(1)
  currentRound       Int     @default(1)
  currentRepeat      Int     @default(1)
  currentStitchInRow Int     @default(1)
  isOnRightSide      Boolean @default(true)
  currentSection     String?
  completedRows      Json    @default("{}")
  notes              String?
  perRowNotes        Json    @default("{}")

  /// Cable needles in flight — JSON array of
  /// `{ id, description, stitchCount, holdInFront, addedAt }`. Matches the
  /// CableNeedleEntry shape in
  /// `apps/web/src/components/studio/knitting/types.ts`.
  cableNeedles Json @default("[]")

  /// Free-text notes on the cable needles in flight. Captures "second
  /// cable, two stitches held in front" before crossing.
  cableNeedleNotes String?

  // User overrides for this project.
  selectedSize       String?
  selectedYarn       String?
  selectedNeedleSize Decimal? @db.Decimal(4, 2)

  /// Project setup — yarn / needles / cast on / swatch. Mirrors
  /// CrochetProjectProgress.projectSetup JSON shape, with needles + cast-on
  /// + in-the-round method replacing hook.
  projectSetup Json?

  startedAt    DateTime  @default(now())
  lastWorkedAt DateTime  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, knittingPatternId])
  @@index([userId, lastWorkedAt])
  @@index([knittingPatternId])
}

/// Personal yarn + needle stash. One row per yarn entry (a colour of one
/// brand at one weight). `needleSizesOwned` carries every needle size the
/// user owns at the stash level — distinct from the per-project needle on
/// KnittingProjectProgress.selectedNeedleSize.
model KnittingStash {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  yarnName       String
  brand          String?
  colourway      String?
  weight         KnittingYarnWeightStandard
  yardsPerSkein  Int?
  metresPerSkein Int?
  skeinsOwned    Int                        @default(1)
  fibre          String?

  /// Needle sizes owned, stored as mm × 10 (50 = 5.0 mm, 25 = 2.5 mm,
  /// 275 = 2.75 mm). Integer storage avoids floating-point comparison
  /// surprises when matching against a pattern's required needle.
  needleSizesOwned Int[] @default([])

  notes String?

  /// Optional reservation against a specific KnittingPattern. The user can
  /// say "this Drops Karisma is for the cardigan project" and the Studio
  /// hides it from substitution candidates for other projects.
  projectAssignedToId String?
  projectAssignedTo   KnittingPattern? @relation("KnittingStashAssignedProject", fields: [projectAssignedToId], references: [id], onDelete: SetNull)

  /// Soft-delete stamp — DELETE on /api/studio/knitting/stash sets this
  /// rather than dropping the row so the Studio can offer a brief undo
  /// affordance.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([projectAssignedToId])
}

enum KnittingProjectShape {
  SCARF
  HAT
  SHAWL
  BLANKET
  MITT_GLOVE
  SOCK
  SWEATER
  CARDIGAN
  VEST
  OTHER
}

enum KnittingTechniqueDiscipline {
  COLOURWORK
  LACE
  CABLE_ARAN
  BRIOCHE_DOUBLEKNIT
  SPECIALTY
}

/// Cast-on method. Superset of the K-1 Tutorial.castOnMethod string
/// vocabulary plus the prompt's KNITTED_ON + OTHER catch-alls so existing
/// Tutorial string values round-trip cleanly into this enum.
enum CastOnMethod {
  LONG_TAIL
  CABLE
  GERMAN_TWISTED
  PROVISIONAL
  ITALIAN_TUBULAR
  OLD_NORWEGIAN
  BACKWARD_LOOP
  JUDYS_MAGIC
  KNITTED_ON
  CROCHET_PROVISIONAL
  OTHER
}

/// Bind-off method. Superset of the K-1 Tutorial.bindOffMethod string
/// vocabulary plus SEWN_TUBULAR + ICELANDIC + KITCHENER + OTHER.
enum BindOffMethod {
  STANDARD
  STRETCHY
  TUBULAR
  SEWN
  SEWN_TUBULAR
  JENYS_SURPRISINGLY_STRETCHY
  ICELANDIC
  THREE_NEEDLE
  KITCHENER
  I_CORD
  RUSSIAN_GRAFT
  PICOT
  SUSPENDED
  OTHER
}

/// In-the-round working method. Superset of the K-1 Tutorial.inTheRoundMethod
/// string vocabulary. STRAIGHT_FLAT is the sentinel for flat work captured
/// alongside in-the-round patterns.
enum InTheRoundMethod {
  DPN
  MAGIC_LOOP
  TWO_CIRCULARS
  FIXED_CIRCULAR
  SHORT_CIRCULAR
  STRAIGHT_FLAT
}

/// CYC yarn weight standard. Distinct from `model YarnWeight` (the master
/// brand-name + gauge-range table). KnittingPattern.yarnWeightStandard
/// holds the enum for cheap library filters; the master YarnWeight row
/// holds the canonical record.
enum KnittingYarnWeightStandard {
  LACE
  FINGERING
  SPORT
  DK
  WORSTED
  ARAN
  BULKY
  SUPER_BULKY
  JUMBO
}

// ────────────────────────────────────────────────────────────────────────────
// Sewing pre-S-2: saved body measurements + printable sewing planner.
// phase_sewing_measurements_planner_001 (2026-06-10).
//
// Two free-tier-signed-in surfaces that flow into the rest of the sewing
// roadmap:
//
//   UserSewingMeasurements: the 3-5 default body measurements (bust /
//   chest, waist, hip, body height, inseam) plus 10 advanced disclosure
//   fields (bust point, back / front waist length, shoulder, arm,
//   wrist, thigh, calf, ankle, neck). Stored in cm canonical per the
//   locked units rule; the renderer reconciles cm and inches at view
//   time from User.measurementPreference. The S-5 freesewing wrapper
//   translates these field names into freesewing's measurement keys at
//   its boundary; nothing in this model is freesewing-aware.
//
//   UserSewingPlan: the printable / saveable project plan. Materials
//   (fabric / notions / thread), cutting plan, step checklist, free
//   notes, status. Powers /me/sewing-plans and its /print companion.
// ────────────────────────────────────────────────────────────────────────────

model UserSewingMeasurements {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 3-5 default profile (per the sewing locks). Every field nullable,
  // since a user may have only some of these.
  bustChestCm  Decimal? @db.Decimal(6, 2)
  waistCm      Decimal? @db.Decimal(6, 2)
  hipCm        Decimal? @db.Decimal(6, 2)
  bodyHeightCm Decimal? @db.Decimal(6, 2)
  inseamCm     Decimal? @db.Decimal(6, 2)

  // Advanced disclosure (shown inline when garment-specific).
  bustPointCm          Decimal? @db.Decimal(6, 2)
  backWaistLengthCm    Decimal? @db.Decimal(6, 2)
  frontWaistLengthCm   Decimal? @db.Decimal(6, 2)
  shoulderWidthCm      Decimal? @db.Decimal(6, 2)
  armLengthCm          Decimal? @db.Decimal(6, 2)
  wristCircumferenceCm Decimal? @db.Decimal(6, 2)
  thighCircumferenceCm Decimal? @db.Decimal(6, 2)
  calfCircumferenceCm  Decimal? @db.Decimal(6, 2)
  ankleCircumferenceCm Decimal? @db.Decimal(6, 2)
  neckCircumferenceCm  Decimal? @db.Decimal(6, 2)

  notes         String?
  lastUpdatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserSewingPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  // Link to a catalogued SewingPattern. Promoted to a proper FK in S-2
  // (phase_sewing_schema_001). Null on blank plans or plans linked only by
  // slug. patternSlug remains the free-form fallback for plans the user
  // started before the pattern existed in the catalogue.
  patternId   String?
  pattern     SewingPattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)
  patternSlug String?

  // Materials. Free-form JSON arrays at v1: schema sketched but not
  // enforced. The editor writes a known shape and a future migration
  // promotes to real tables if query patterns demand it.
  // fabricList:  [{ name, fabricType, widthCm, lengthCm, notes }]
  // notionsList: [{ name, quantity, notes }]
  // threadList:  [{ colour, weight, notes }]
  fabricList  Json?
  notionsList Json?
  threadList  Json?

  // Cutting plan sketched by the user. Refined when the plan is
  // promoted into the S-5 layout planner.
  // cuttingPlan: { layoutNotes, fabricWidthCm, totalLengthCm, pieceList }
  cuttingPlan Json?

  // Steps + progress.
  // stepsList: [{ id, stepText, isComplete, completedAt, notes }]
  stepsList Json?

  // Free notes section.
  notes String?

  status      SewingPlanStatus @default(DRAFT)
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([patternId])
}

enum SewingPlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// ────────────────────────────────────────────────────────────────────────────
// Sewing S-2: catalogued pattern + per-user project + custom personalisation.
// phase_sewing_schema_001 (2026-06-10).
//
// All fields up-front per the locked schema rule. The pipeline-setup worker
// (S-3) populates SubCategory targets and author prompts on top of this
// schema. Studio v1 (S-1) renders SewingPattern rows. The freesewing wrapper
// at apps/web/src/lib/sewing/grading/ (S-5a) populates engineCacheKey on
// SewingPattern and the output fields on SewingPatternPersonalisation; this
// migration only carves the room for those fields, it does not install or
// import @freesewing/*.
//
// Category.sewing stays NOT_READY and isPublicVisible stays false through
// S-2 through S-5 per the no-phased-rollout lock; everything flips together
// once the full surface is live.
// ────────────────────────────────────────────────────────────────────────────

model SewingPattern {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  // Designer and provenance. `isFreesewingDesign` flags rows whose draft
  // path goes through the S-5a wrapper layer over @freesewing/*. Non
  // freesewing rows (in-house designs, indie designer submissions) leave
  // the package and version fields null and source draft data from the
  // pattern body. `attributionText` is the voice-checked footer credit
  // rendered on tiled-print and browse-only output.
  designerId            String?
  designer              Designer?            @relation("DesignerSewingPatterns", fields: [designerId], references: [id], onDelete: SetNull)
  isFreesewingDesign    Boolean              @default(false)
  freesewingPackageName String?
  freesewingVersion     String?
  freesewingDesignSlug  String?
  sourceLicence         SewingSourceLicence?
  sourceUrl             String?
  attributionText       String?

  // Categorisation. `garmentCategory` is the headline taxonomy axis.
  // `garmentType` is free-text ("wrap dress", "raglan tee") for finer
  // grouping inside a category. `subCategoryId` ties into the shared
  // SubCategory taxonomy used across crafts.
  garmentCategory SewingGarmentCategory
  garmentType     String?
  subCategoryId   String?
  subCategory     SubCategory?          @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  skillLevel      SewingSkillLevel      @default(IMPROVER)

  // ──────────────────────────────────────────────────────────────────────────
  // Sizing.
  //
  // supportedSizes shape:
  //   [{ name: "XS", body: { bust: 81, waist: 64, hip: 87, height: 162 } }, ...]
  //   Body measurements stored in cm canonical per the units rule; the
  //   renderer reconciles cm and inches at render time.
  //
  // requiredMeasurements + optionalMeasurements carry measurement keys
  //   from the saved-measurements vocabulary (bustChestCm, waistCm, hipCm,
  //   bodyHeightCm, inseamCm, plus the advanced-disclosure set). The
  //   Studio uses these to drive the advanced-disclosure prompt.
  // ──────────────────────────────────────────────────────────────────────────
  supportedSizes       Json     @default("[]")
  defaultEaseCm        Decimal? @db.Decimal(6, 2)
  sizingNotes          String?
  requiredMeasurements String[] @default([])
  optionalMeasurements String[] @default([])

  // Body and finished garment charts. Per-size body and finished
  // dimensions. The S-5a wrapper uses bodyMeasurementChart as the input
  // baseline; finishedGarmentChart is the renderer's output ground truth
  // (and the basis for the user-facing finished measurements table).
  bodyMeasurementChart Json?
  finishedGarmentChart Json?

  // Seam allowance and construction. seamAllowanceIncluded toggles
  // whether pattern pieces already include the seam allowance (typical
  // for indie patterns) or expect the user to add it (typical for
  // freesewing output).
  seamAllowanceIncluded Boolean  @default(true)
  seamAllowanceCm       Decimal? @db.Decimal(4, 2)
  constructionDirection String?
  hasLining             Boolean  @default(false)
  hasInterfacing        Boolean  @default(false)
  hasClosure            Boolean  @default(false)
  closureType           String?

  // ──────────────────────────────────────────────────────────────────────────
  // Materials.
  //
  // recommendedFabrics shape:
  //   [{ type: "linen", weight: "medium", widthCm: 140, notes: "..." }, ...]
  //
  // recommendedNotions shape:
  //   [{ name: "invisible zipper", spec: "20cm", quantity: 1, notes: "..." }, ...]
  //
  // fabricRequirementsCm shape:
  //   { [sizeName]: { [fabricWidthCm]: totalLengthCm } }
  //   The materials calculator surfaces this per selected size and chosen
  //   fabric width.
  // ──────────────────────────────────────────────────────────────────────────
  recommendedFabrics   Json @default("[]")
  recommendedNotions   Json @default("[]")
  fabricRequirementsCm Json @default("{}")

  // Instructions (TipTap-style document with steps and linked technique
  // tutorials). Same shape as Tutorial body. Rendered by the public
  // TipTap-free renderer that walks the JSON.
  instructionsBody Json?

  // ──────────────────────────────────────────────────────────────────────────
  // Cutting and layout.
  //
  // cuttingLayouts shape:
  //   { [sizeName]: { [fabricWidthCm]: { layoutPaths: [...], notes: "..." } } }
  //
  // pieceList shape:
  //   [{ name: "Front", cut: 2, fold: "on-fold", grainline: "lengthwise" }, ...]
  // ──────────────────────────────────────────────────────────────────────────
  cuttingLayouts Json @default("{}")
  pieceList      Json @default("[]")

  // ──────────────────────────────────────────────────────────────────────────
  // Adjustments and variants.
  //
  // adjustmentGuides shape:
  //   [{ adjustmentName: "FBA", tutorialSlug: "...", appliesTo: ["bust-larger-than-D"] }, ...]
  //   "FBA" = full bust adjustment. Adjustments are the per-pattern guide
  //   pointers; the grade-between-sizes flow (S-5) is separate. Never use
  //   the indie slang "mash" anywhere.
  //
  // patternHacks shape:
  //   [{ hackName: "Lengthen into dress", description: "...", premiumGated: true }, ...]
  //   The premiumGated flag is read by Worker F's cross-category gating
  //   pass; this migration does not enforce it.
  // ──────────────────────────────────────────────────────────────────────────
  adjustmentGuides Json @default("[]")
  patternHacks     Json @default("[]")

  // Technique cross-references. Same semantics as Tutorial.techniqueSlugs /
  // criticalTechniques: techniqueSlugs is every technique the pattern body
  // references; criticalTechniques is the subset without which the pattern
  // cannot be completed. Powers "patterns using this technique" rails.
  // aliases carries search synonyms (UK/US sewing terminology, shop terms).
  techniqueSlugs     String[] @default([])
  criticalTechniques String[] @default([])
  aliases            String[] @default([])

  // Output formats supported by this pattern. The Studio download UI
  // filters available paths against this list. All four calibration
  // paths from the locked sewing decisions map onto these formats.
  availableFormats SewingFormat[] @default([])

  // Engine cache key. The S-5a wrapper hashes (designSlug, measurements,
  // options, calibrationMode) and writes the hash here so subsequent
  // identical drafts return the cached SVG. This migration does not
  // populate the field.
  engineCacheKey String?

  // Standard cataloguing (mirrors crochet, knitting, cross-stitch).
  // `difficulty` overlaps `skillLevel`; the former is the cross-craft
  // shared axis used by library filters, the latter is the sewing
  // specific seven-step scale.
  difficulty             Difficulty?
  estimatedHoursPerSize  Json?
  heroMediaId            String?
  hero                   Media?                @relation("SewingPatternHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  heroGenerationStatus   ImageGenerationStatus @default(PENDING)
  preferUserPhotoForHero Boolean               @default(false)

  // S-8a hero-flat renderer state. heroRendererVersion stores the
  // rendererVersion that produced the current hero. The batch script
  // re-renders any row where heroRendererVersion < RENDERER_VERSION (or
  // the row has no heroMediaId at all). heroNeedsFlatHand flags rows
  // whose archetype is not mapped — a human / illustrator picks up the
  // hero instead of the parametric renderer.
  heroRendererVersion Int        @default(0)
  heroNeedsFlatHand   Boolean    @default(false)
  premium             Boolean    @default(false)
  visibility          Visibility @default(PRIVATE)
  publishedAt         DateTime?
  // Makeability / completeness gate block reason — set when the QC pass
  // un-publishes a row (visibility -> PRIVATE) for failing the locked checklist.
  // Nullable + additive; mirrors Tutorial.qcBlockReason.
  qcBlockReason       Json?

  // Secondary product-shot hero for the bag / home / accessory sub-cats
  // where industry convention is product photography rather than a flat
  // line drawing (S-8b). Bag / home / accessory pattern detail pages render
  // both the S-8a parametric flat and this product shot; library cards use
  // whichever is set. `heroProductShotFallback=true` means the autonomous
  // worker exhausted 5 retries and the S-8a flat stays the only hero.
  // `heroProductShotScriptVersion` lets a future run force a regenerate
  // by bumping the version on the pattern. The 5-attempt retry budget is
  // tracked in `heroProductShotAttempts`.
  heroProductShotMediaId       String?
  heroProductShot              Media?  @relation("SewingPatternHeroProductShot", fields: [heroProductShotMediaId], references: [id], onDelete: SetNull)
  heroProductShotPrompt        String?
  heroProductShotAttempts      Int     @default(0)
  heroProductShotFallback      Boolean @default(false)
  heroProductShotScriptVersion Int     @default(1)

  // Errata and credits. `errataLog` is an append-only log of corrections
  // since the version was cut; the Studio shows it in the pattern footer.
  // `testerCredits` carries the role-and-credit pairs surfaced in the
  // attribution block.
  errataVersion String @default("1.0.0")
  errataLog     Json   @default("[]")
  testerCredits Json   @default("[]")

  // Optional tutorial that introduces this pattern.
  tutorialId String?
  tutorial   Tutorial? @relation("TutorialSewingPattern", fields: [tutorialId], references: [id], onDelete: SetNull)

  // Reverse relations.
  projects         SewingPatternProject[]
  personalisations SewingPatternPersonalisation[]
  hacks            SewingPatternHack[]
  plansLinked      UserSewingPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garmentCategory, publishedAt])
  @@index([subCategoryId, publishedAt])
  @@index([designerId])
  @@index([isFreesewingDesign])
  @@index([skillLevel])
  @@index([heroMediaId])
  @@index([heroProductShotMediaId])
  @@index([tutorialId])
  @@index([visibility, publishedAt])
}

/// Per-(user, sewingPattern) project state. One row per pattern per user
/// at any time. Re-making the same pattern in a new fabric branches via
/// the fork pattern (covered in S-1 Studio v1), not by allowing multiple
/// rows here.
model SewingPatternProject {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternId String
  pattern   SewingPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  // Status reuses the SewingPlanStatus enum (DRAFT, ACTIVE, PAUSED,
  // COMPLETED, ARCHIVED) introduced by the pre-S-2 measurements migration.
  status       SewingPlanStatus @default(DRAFT)
  selectedSize String?

  // ──────────────────────────────────────────────────────────────────────────
  // Personalisation choices.
  //
  // fabricChoice shape:
  //   { fabric: "linen", widthCm: 140, lengthCm: 280, lengthwiseGrain: true }
  //
  // notionsChoices shape:
  //   user's selection from recommendedNotions
  //
  // measurementsSnapshot shape:
  //   snapshot of UserSewingMeasurements at project start so subsequent
  //   measurement edits do not silently re-grade an in-progress make.
  // ──────────────────────────────────────────────────────────────────────────
  fabricChoice         Json?
  notionsChoices       Json?
  easeOverrideCm       Decimal? @db.Decimal(6, 2)
  measurementsSnapshot Json?

  // Step tracking. stepsProgress shape: { [stepIndex]: { completedAt, notes } }.
  stepsProgress Json @default("{}")

  // Free notes and user-submitted progress / finished photos. Photo
  // moderation rides on the existing UGC photo flow.
  notes             String?
  userPhotoMediaIds String[] @default([])

  startedAt    DateTime  @default(now())
  lastWorkedAt DateTime  @default(now())
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reverse relation for personalisation requests linked to this project.
  personalisations SewingPatternPersonalisation[]

  // Reverse relation for hacks promoted into this project (S-6).
  hacksSavedHere SewingPatternHack[] @relation("HackSavedToProject")

  @@unique([userId, patternId])
  @@index([userId, status])
  @@index([patternId])
}

/// Premium custom-grading request. The user provides their saved
/// measurements plus per-design options; the S-5a wrapper renders a
/// personalised SVG and writes it back here. Gated by config flag for
/// now; Worker F wires the gating. This migration carves the room
/// without building the wrapper itself.
model SewingPatternPersonalisation {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternId String
  pattern   SewingPattern         @relation(fields: [patternId], references: [id], onDelete: Cascade)
  projectId String?
  project   SewingPatternProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Measurement snapshot at request time. Freezing the values here keeps
  // the rendered SVG reproducible even if the user later edits their
  // saved measurements. measurementsPreferenceSnapshot records whether
  // the user was viewing in "cm" or "inches" at request time so the
  // delivered output matches the surface they came from.
  measurementsSnapshot           Json
  measurementsPreferenceSnapshot String

  // Personalisation request. designOptions shape: keyed by freesewing
  // design option ({ neckline: "scoop", sleeveLength: "short" }).
  designOptions  Json     @default("{}")
  easePreference Decimal? @db.Decimal(6, 2)

  // Output. Filled by the S-5a wrapper. outputSvg is the rendered SVG
  // string; outputCacheKey matches SewingPattern.engineCacheKey when the
  // wrapper hit its cache. errorMessage is set on FAILED rows.
  status         PersonalisationStatus @default(PENDING)
  outputSvg      String?
  outputCacheKey String?
  generatedAt    DateTime?
  errorMessage   String?

  // Delivery. Flipped true once the output is attached to the linked
  // SewingPatternProject (or downloaded directly if there is no project).
  deliveredToProject Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([patternId])
  @@index([status])
}

/// Saved hack composer state. A row represents a named bookmark of a
/// freesewing design with a specific option set (e.g. Bella with
/// neckline=scoop, bodyLength=+50mm). Different from
/// SewingPatternPersonalisation in intent: a Personalisation is a draft
/// the user downloads or attaches to a project; a Hack is a saved
/// configuration the user comes back to and iterates on. Same shape
/// otherwise so the wrapper can render either path. Gated by the
/// SEWING_HACK_COMPOSER config flag (default off); Worker F flips it.
model SewingPatternHack {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentPatternId String
  parentPattern   SewingPattern @relation(fields: [parentPatternId], references: [id], onDelete: Cascade)

  /// User-named, defaults to "Hack of <pattern name>" client-side at
  /// save time.
  name String?

  /// Saved freesewing option set. Same keying as
  /// SewingPatternPersonalisation.designOptions.
  hackOptions Json @default("{}")

  /// Frozen at save time so a later edit to UserSewingMeasurements does
  /// not silently re-grade the hack.
  measurementsSnapshot           Json
  measurementsPreferenceSnapshot String

  /// Output cache. outputCacheKey matches the wrapper's content hash so
  /// re-draws hit SewingPatternDraftCache.
  outputSvg      String?
  outputCacheKey String?
  generatedAt    DateTime?

  /// Optional promotion to a SewingPatternProject.
  savedToProjectId String?
  savedToProject   SewingPatternProject? @relation("HackSavedToProject", fields: [savedToProjectId], references: [id], onDelete: SetNull)

  notes String?

  /// Lifecycle mirrors PersonalisationStatus so the same wrapper path
  /// can populate either model.
  status PersonalisationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([parentPatternId])
  @@index([userId, updatedAt])
}

/// Garment taxonomy axis for SewingPattern. Distinct from the shared
/// SubCategory taxonomy: garmentCategory groups for "shop by who and
/// where", subCategoryId groups for "shop by craft technique."
enum SewingGarmentCategory {
  WOMENS_TOPS
  WOMENS_DRESSES
  WOMENS_BOTTOMS
  WOMENS_OUTERWEAR
  WOMENS_INTIMATES
  MENS_TOPS
  MENS_BOTTOMS
  MENS_OUTERWEAR
  KIDS
  BABIES
  UNISEX
  ACCESSORIES
  BAGS
  HOME
  COSTUME
  SPECIALTY
}

/// Sewing-specific skill ladder. Wider than the shared Difficulty enum
/// (BEGINNER, INTERMEDIATE, ADVANCED) because the sewing community uses
/// finer gradations (absolute-beginner vs improver vs confident-beginner).
/// SewingPattern carries both: skillLevel for sewing surfaces,
/// difficulty for cross-craft library filters.
enum SewingSkillLevel {
  ABSOLUTE_BEGINNER
  BEGINNER
  IMPROVER
  CONFIDENT_BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

/// Download / render path supported by a SewingPattern. Maps onto the
/// four calibration paths locked in the sewing strategy memo: printer
/// tiled (A4, Letter, Legal, A3) plus single-sheet A0, projector grid,
/// layered PDF for size-by-size colour selection, and browse-only inline
/// render. The Studio download UI filters against availableFormats.
enum SewingFormat {
  A4_TILED
  LETTER_TILED
  LEGAL_TILED
  A3_TILED
  A0
  PROJECTOR
  LAYERED_PDF
  BROWSE_ONLY
}

/// Source licence for catalogued patterns. PROPRIETARY_HOMEMADE covers
/// in-house designs; INDIE_DESIGNER_SUBMISSION covers patterns onboarded
/// through the S-7 designer flow. freesewing-derived rows carry MIT.
enum SewingSourceLicence {
  MIT
  GPL_V3
  CC_BY
  CC_BY_SA
  PROPRIETARY_HOMEMADE
  INDIE_DESIGNER_SUBMISSION
  PUBLIC_DOMAIN
}

/// Lifecycle of a SewingPatternPersonalisation request. The S-5a wrapper
/// flips PENDING into GENERATING, then SUCCESS or FAILED. REJECTED is
/// reserved for measurements that the wrapper refuses to draft
/// (out-of-range, mutually inconsistent).
enum PersonalisationStatus {
  PENDING
  GENERATING
  SUCCESS
  FAILED
  REJECTED
}

// ────────────────────────────────────────────────────────────────────────────
// Sewing S-5a: shared draft cache for the freesewing wrapper.
// phase_sewing_draft_cache_001 (2026-06-10).
//
// The wrapper hashes (designSlug, measurements, options, calibrationMode,
// freesewingVersion) into cacheKey and writes the rendered SVG here so
// subsequent identical drafts return the cached SVG without re-running
// freesewing. Entries are kept indefinitely; a freesewing version bump
// invalidates the entire prior set automatically (the version is part of
// the hash). Periodic eviction based on lastAccessedAt is a future concern.
// ────────────────────────────────────────────────────────────────────────────
model SewingPatternDraftCache {
  id                String   @id @default(cuid())
  cacheKey          String   @unique
  designSlug        String
  measurementsHash  String
  optionsHash       String
  calibrationMode   String
  svgOutput         String
  freesewingVersion String
  generatedAt       DateTime @default(now())
  lastAccessedAt    DateTime @default(now())
  accessCount       Int      @default(0)

  @@index([cacheKey])
  @@index([designSlug])
  @@index([lastAccessedAt])
}
