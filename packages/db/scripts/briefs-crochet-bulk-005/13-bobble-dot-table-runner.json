    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A bobble dot table runner is a 30 × 90 cm cotton runner with raised "
          },
          {
            "type": "text",
            "text": "bobbles",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bobble"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " scattered across a plain double crochet ground every four rows. The bobbles sit on the right side of the fabric; the pattern repeats every 8 stitches across and every 4 rows up. Intermediate skill is needed to keep even tension between the bobble rows and the plain rows."
          }
        ]
      },
      {
