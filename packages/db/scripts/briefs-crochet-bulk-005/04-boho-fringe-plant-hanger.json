  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A boho fringe plant hanger holds one standard 10, 13 cm pot in a simple double crochet cup worked from a "
          },
          {
            "type": "text",
            "text": "magic ring",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", with a fringe skirt of cut yarn strips looped through the base round below the pot. The fringe moves freely and gives the hanger a soft, layered look. Works in DK cotton in a single colour or with a contrasting fringe."
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
