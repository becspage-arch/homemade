            "type": "text",
            "text": "button tab",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "button-tab"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " at one corner buttons over to secure. Machine-washable and robust. One 100 m ball of DK cotton makes one wrap."
          }
        ]
      },
