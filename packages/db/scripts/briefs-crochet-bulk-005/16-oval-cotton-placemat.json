              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "16 dc × 20 rows = 10 × 10 cm in DK cotton with a 4 mm hook. For oval placemats, tension evenness is more important than exact gauge: check the oval lies flat after a few rounds."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Stitches used"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Chain (ch)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slip stitch (sl st)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Double crochet (dc). UK term; US equivalent is single crochet (sc)"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work in a continuous spiral with a stitch marker on the first st of each round. Ch 25."
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Round 1: 1 dc in 2nd ch from hook, 1 dc in each of next 22 ch, 3 dc in last ch (round the first short end). Work 22 dc back along the other side of the chain, 2 dc in the starting ch (round the second short end) (50 sts)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Round 2: 1 dc in each of 22 sts, 2 dc in each of 3 corner sts, 1 dc in each of 22 sts, 2 dc in each of last 3 sts (56 sts)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Round 3: 1 dc in each of 22 sts, [1 dc, 2 dc in next] 3 times, 1 dc in each of 22 sts, [1 dc, 2 dc in next] 3 times (62 sts)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Round 4: 1 dc in each of 22 sts, [2 dc, 2 dc in next] 3 times, 1 dc in each of 22 sts, [2 dc, 2 dc in next] 3 times (68 sts)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Round 5: 1 dc in each of 22 sts, [3 dc, 2 dc in next] 3 times, 1 dc in each of 22 sts, [3 dc, 2 dc in next] 3 times (74 sts)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Round 6: 1 dc in each of 22 sts, [4 dc, 2 dc in next] 3 times, 1 dc in each of 22 sts, [4 dc, 2 dc in next] 3 times (80 sts). Measure: mat should be approx. 30 × 40 cm. Sl st to join. Fasten off."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Weave in both ends. Steam-block lightly or wet-block flat if needed."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Care"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Machine-wash on 30°C gentle cycle. Lay flat to dry."
          }
        ]
      }
    ]
  }
