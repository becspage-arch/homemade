      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Materials"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "100 m DK cotton per mat. One 100 m ball per placemat, with a little left over."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "18 hhtr × 16 rows = 10 × 10 cm in DK cotton with a 4.5 mm hook. The herringbone stitch pulls in more than standard htr. Use a slightly larger hook than usual."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Stitches used"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Chain (ch)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Herringbone half treble (hhtr): yarn over, insert hook, draw up a loop (3 loops on hook), yarn over and draw through the first loop only (still 3 loops on hook), yarn over and draw through all 3 loops. This is the stitch throughout."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 57. (54 stitches + 3 turning chain.)"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Row 1: ch 2 (t-ch, does not count as st), hhtr in 3rd ch from hook, hhtr in each ch across (54 hhtr). Turn."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "All subsequent rows: ch 2 (t-ch), hhtr in each st across. The ch-2 turning chain does not count as a stitch. Work the first hhtr into the base of the ch-2 and the last hhtr into the last st of the previous row (54 hhtr). Turn."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Continue until mat measures 40 cm (approx. 64 rows). Fasten off."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "infoPanel",
        "attrs": {
          "type": "tip"
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "The herringbone stitch has a strong directional pull. The mat may lean slightly to one side off the hook. This disappears completely with wet-blocking."
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Weave in ends. Wet-block by pinning to size on a blocking mat and leaving until dry. This straightens the herringbone lean and softens the cotton."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Care"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Machine-wash on 30°C gentle cycle. Lay flat to dry."
          }
        ]
      }
    ]
  }
