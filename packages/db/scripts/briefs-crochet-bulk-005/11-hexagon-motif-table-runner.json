                    "text": "Double crochet (dc). UK term; US equivalent is single crochet (sc)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Treble (tr). UK term; US equivalent is double crochet (dc)"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Hexagon motif (make 18 for the standard runner)"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "MR: ch 3 (counts as tr), 11 tr into ring, sl st to top of ch 3 (12 tr)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Round 2: ch 3 (counts as tr), tr in same st, ch 1, *2 tr in next st, ch 1; repeat from * 10 times, sl st to top of ch 3 (12 pairs, 12 ch-1 spaces)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Round 3: sl st to ch-1 sp. Ch 3, 2 tr in same sp, ch 1, *3 tr in next ch-1 sp, ch 1; repeat from * 10 times, sl st to ch 3 (12 clusters, 12 ch-1 spaces)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Round 4 (points): sl st to ch-1 sp. [Ch 3, 2 tr, ch 2, 3 tr] into same sp (one hex point). Ch 1, 3 tr into next sp, ch 1. Repeat this 2-step sequence 5 more times, 6 points and 6 flat sides. Sl st to top of ch 3. Fasten off."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Joining"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Block all 18 hexagons to 12 cm flat before joining. Arrange in two staggered rows of 9: offset the top row by half a hexagon width. On the final round of each new hexagon, when you reach a joining side, replace the ch 2 at the hexagon point with ch 1, sl st into the corresponding point of the neighbouring hexagon, ch 1. At flat-side joins, replace ch 1 between clusters with sl st into the matching ch-1 space of the neighbour."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Weave in all ends. Wet-block the assembled runner and pin to size on the blocking mat. Leave until completely dry."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Care"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Machine-wash on 30°C gentle cycle. Lay flat to dry. Re-pin if needed to keep the hexagons flat after heavy washing."
          }
        ]
      }
    ]
  }
