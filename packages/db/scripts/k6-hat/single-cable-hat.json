      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    },
    {
      "slug": "c6f",
      "term": "C6F (cable 6 front)",
      "definition": "Slip 3 stitches to a cable needle held in front, knit 3 from the left needle, then knit 3 from the cable needle. The 6-stitch cable crosses to the left."
    }
  ],
