  "glossaryTerms": [
    {
      "slug": "mock-cable",
      "term": "Mock cable",
      "definition": "A stitch pattern that produces a twisted, cable-like column without using a cable needle. Worked by slipping a stitch, working the next stitches, then passing the slipped stitch over."
    },
    {
      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    }
  ],
