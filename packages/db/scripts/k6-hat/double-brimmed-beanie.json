      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    },
    {
      "slug": "folded-hem",
      "term": "Folded hem",
      "definition": "A technique where a piece of knitting is folded back on itself and the original cast-on stitches are joined to the live stitches to create a double layer. Produces a neat, firm edge that does not curl."
    }
  ],
