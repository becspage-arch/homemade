    {
      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    },
    {
      "slug": "jog",
      "term": "Jog",
      "definition": "The step that appears in stripes worked in the round because the round is a spiral; the first stitch of the new colour sits one round higher than the last stitch of the previous colour. Two-round stripes are the simplest way to manage it."
    }
  ],
