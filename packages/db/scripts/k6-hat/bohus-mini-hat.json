      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    },
    {
      "slug": "bohus-purl-stitch",
      "term": "Bohus purl stitch",
      "definition": "In Bohus colourwork, contrast colour stitches are purled on the right side rather than knitted. This raises the stitch slightly and creates a distinctive raised, textured colourwork effect."
    }
  ],
