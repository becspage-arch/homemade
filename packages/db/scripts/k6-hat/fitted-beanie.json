    {
      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    },
    {
      "slug": "negative-ease",
      "term": "Negative ease",
      "definition": "When a knitted item is worked to a circumference smaller than the body measurement it will cover. The fabric stretches to fit, producing a snug, close result."
    },
    {
      "slug": "stocking-stitch",
      "term": "Stocking stitch",
      "definition": "The fabric produced by knitting every round when working in the round. The right side shows smooth V-shaped stitches."
    }
  ],
