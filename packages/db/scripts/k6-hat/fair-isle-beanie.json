  "glossaryTerms": [
    {
      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    },
    {
      "slug": "fair-isle",
      "term": "Fair Isle",
      "definition": "A stranded colourwork technique where two yarn colours are carried across each round, with the non-working yarn floated loosely behind the work. No float should span more than 5 stitches without being caught."
    },
    {
      "slug": "float",
      "term": "Float",
      "definition": "The length of yarn carried across the back of the work when a colour is not being knitted. Floats that are too tight pucker the fabric; floats longer than 5 stitches should be caught every 3 to 4 stitches."
    }
  ],
