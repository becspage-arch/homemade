  "glossaryTerms": [
    {
      "slug": "i-cord",
      "term": "I-cord",
      "definition": "A narrow knitted tube made on two DPNs or on two stitches of a circular needle. Slide the stitches to the right end of the needle, pull the yarn firmly across the back, and knit. Repeat. The yarn pulled behind forms the tube."
    },
    {
      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    },
    {
      "slug": "make-one",
      "term": "M1 (make one)",
      "definition": "An increase that lifts the horizontal strand between two stitches onto the needle and knits through it. M1R lifts from front to back and knits through the back loop. M1L lifts from back to front and knits through the front loop."
    }
  ],
