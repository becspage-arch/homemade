      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    },
    {
      "slug": "float",
      "term": "Float",
      "definition": "The length of yarn carried across the back of the work when a colour is not being knitted. Floats spanning more than 5 stitches should be caught to prevent snagging inside the hat."
    }
