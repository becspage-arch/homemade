  "glossaryTerms": [
    {
      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    },
    {
      "slug": "intarsia",
      "term": "Intarsia",
      "definition": "A colourwork technique where isolated colour areas are worked with separate yarn bobbins. Each section has its own yarn; there are no long floats across the back. Yarns twist around each other at colour joins to prevent gaps."
    }
  ],
