  "glossaryTerms": [
    {
      "slug": "seed-stitch",
      "term": "Seed stitch",
      "definition": "A stitch pattern worked by alternating single knit and purl stitches. In the round, each stitch is worked opposite to how it appears: knit the purl bumps and purl the smooth V stitches. Produces a pebbled, reversible fabric that lies flat."
    },
    {
      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    }
  ],
