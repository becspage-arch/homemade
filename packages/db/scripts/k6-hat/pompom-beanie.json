  "glossaryTerms": [
    {
      "slug": "magic-loop",
      "term": "Magic loop",
      "definition": "A method of knitting a small circumference on one long circular needle by pulling a loop of cable through the work at the halfway point."
    },
    {
      "slug": "pompom",
      "term": "Pompom",
      "definition": "A spherical yarn trim made by wrapping yarn around a card or pompom maker, tying off the centre, and cutting the loops. The tied centre secures the trim to the hat crown."
    },
    {
      "slug": "rib-stitch",
      "term": "2 x 2 rib",
      "definition": "A stitch pattern alternating two knit stitches and two purl stitches. The columns of knit and purl stack vertically, producing a stretchy, vertically ridged fabric."
    }
  ],
