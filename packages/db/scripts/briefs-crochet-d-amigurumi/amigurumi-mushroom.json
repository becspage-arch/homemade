  "glossaryTerms": [
    {
      "slug": "magic-ring",
      "definition": "An adjustable start loop that closes to leave no hole at the centre of a piece."
    },
    {
      "slug": "amigurumi-decrease",
      "definition": "An invisible decrease worked through the front loops only to reduce stitch count without a visible gap."
    },
    {
      "slug": "half-double-crochet",
      "definition": "A stitch of medium height worked with one yarn-over, producing a softer, denser fabric than treble crochet."
    },
    {
      "slug": "slip-stitch-join",
      "definition": "A slip stitch used to close a round invisibly."
    }
  ],
  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This cheerful red-spotted mushroom is not an animal but a favourite woodland accent piece. A large sphere forms the cap and a short cylinder is the stem. No safety eyes required, which makes it an ideal first amigurumi project. Start both pieces with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". The finished mushroom stands about 11 cm tall."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Materials"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "DK yarn: 40 g red, 20 g white, 5 g cream. 3.5 mm crochet hook. Polyester stuffing. Tapestry needle."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "24 sts × 28 rows = 10 × 10 cm in dc on a 3.5 mm hook."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Cap (red)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work the full sphere in red. The lower hemisphere will curve over the stem once assembled, giving the characteristic mushroom silhouette. Use the "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-decrease"
                }
              }
            ],
            "text": "invisible decrease"
          },
          {
            "type": "text",
            "text": " throughout to keep the fabric taut."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 1: 6 sc in magic ring (6 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 2: [inc] × 6 (12 st) (12 sts)"
          }
        ]
