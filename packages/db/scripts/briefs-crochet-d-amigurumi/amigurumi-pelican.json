                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "pelican-magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": " and work in continuous rounds. The pouch cylinder is left open at the bottom to give a realistic drooping shape."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
