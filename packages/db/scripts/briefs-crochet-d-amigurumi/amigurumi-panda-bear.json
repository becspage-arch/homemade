      "slug": "magic-ring-pb",
      "term": "Magic ring",
      "definition": "An adjustable loop used to start amigurumi rounds. Pulling the tail closes the centre hole so no gap shows."
    },
    {
      "slug": "colour-change-pb",
      "term": "Colour change",
      "definition": "Switching yarn mid-round by pulling the new colour through the last step of the stitch before the colour change."
    },
    {
      "slug": "dc2tog-pb",
      "term": "Dc2tog",
      "definition": "Double crochet two stitches together. Used for decrease rounds that close each piece."
    },
    {
      "slug": "safety-eyes-pb",
      "term": "Safety eyes",
      "definition": "Plastic eyes with a washer-lock back. Fit inside the eye patch before sewing the patch to the head."
    },
