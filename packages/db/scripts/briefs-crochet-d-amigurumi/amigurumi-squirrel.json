        "content": [
          {
            "type": "text",
            "text": "This bushy-tailed squirrel has a sphere head and a pear body worked in warm brown DK. The oversized tail capsule uses a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fluffy-yarn"
                }
              }
            ],
            "text": "fluffy yarn"
          },
          {
            "type": "text",
            "text": " so it stands out from the smooth body. Start every piece with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". The squirrel sits about 14 cm tall with its tail arched behind it."
          }
        ]
