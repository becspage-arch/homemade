  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This gecko has an oval body, sphere head, four slim legs, and a cylinder tail. All pieces start with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring-ge"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Yarn and yarn amounts"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You need approx. 18 g of green DK and a contrasting colour for spots. Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "colour-change-ge"
                }
              }
            ],
            "text": "colour change"
          },
          {
            "type": "text",
            "text": " to work spots directly into body rounds, or embroider them afterwards."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Head"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 5 cm sphere (13 rounds). Fit "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes-ge"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": " at round 6 before closing."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Body"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 5 cm by 10 cm oval (15 rounds). Keep stuffing light so the body lies flat."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Legs (make 4)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 1.5 cm diameter by 4 cm capsule (10 rounds). Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-ge"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": " to close the foot end."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Tail"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 2 cm diameter by 7 cm cylinder (20 rounds). Taper the last four rounds with one decrease per round."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sew head to the front of the body using "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "ladder-stitch-ge"
                }
              }
            ],
            "text": "ladder stitch"
          },
          {
            "type": "text",
            "text": ". Attach the tail to the rear. Sew legs splayed out to each side so the gecko lies flat."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The amigurumi iguana uses the same flat layout with a longer spined tail."
          }
        ]
      }
    ]
  }
}