          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-magic-ring-sm"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". This is a great beginner project: every sphere uses the same increase-and-decrease sequence, just at different sizes. No safety eyes are needed; the eyes are embroidered on."
          }
        ]
      },
      {
        "type": "heading",
