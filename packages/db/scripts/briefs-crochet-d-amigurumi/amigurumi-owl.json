  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This round brown owl has a sphere head and an oval body, with wing ovals and a small beak cone attached. Feather markings on the body and the large disc-like facial area around the eyes are added with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "surface-embroidery"
                }
              }
            ],
            "text": "surface embroidery"
          },
          {
            "type": "text",
            "text": " after assembly. Start every piece with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". The finished owl sits about 14 cm tall."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Materials"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "DK yarn: 55 g warm brown, 15 g cream, 5 g amber. 3.5 mm crochet hook. Pair of 12 mm "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": " (large for owl effect). Polyester stuffing. Tapestry needle."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "24 sts × 28 rows = 10 × 10 cm in dc on a 3.5 mm hook."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Head"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 1: 6 sc in magic ring (6 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 2: [inc] × 6 (12 st) (12 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 3: [2 sc, inc] × 6 (18 st) (18 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 4: [3 sc, inc] × 6 (24 st) (24 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 5: [4 sc, inc] × 6 (30 st) (30 sts)"
          }
        ]
      },
