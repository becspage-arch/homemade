    {
      "termSlug": "amigurumi-increase",
      "definition": "Two double crochet worked into the same stitch to widen a round."
    },
    {
      "termSlug": "amigurumi-decrease",
      "definition": "Two stitches crocheted together to narrow a round."
    },
    {
