  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This komodo dragon has an oval head, a large capsule body, four sturdy legs, and a thick tail. All pieces start with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring-kd"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Yarn and yarn amounts"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You need approx. 34 g of grey DK. Add scale texture using "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "surface-embroidery-kd"
                }
              }
            ],
            "text": "surface embroidery"
          },
          {
            "type": "text",
            "text": " in a slightly darker grey across the back and sides."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Head"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 6 cm by 9 cm oval (18 rounds). Fit "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes-kd"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": " at round 7 before closing. Stuff with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "stuffing-kd"
                }
              }
            ],
            "text": "firm stuffing"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Body"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 8 cm diameter by 14 cm capsule (36 rounds). Stuff firmly."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Legs (make 4)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 3 cm diameter by 5 cm capsule (13 rounds). Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-kd"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": " to close the foot end."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Tail"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 3.5 cm diameter by 12 cm cylinder (34 rounds). Taper the final six rounds with one decrease per round."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sew head to the front of the body using "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "ladder-stitch-kd"
                }
              }
            ],
            "text": "ladder stitch"
          },
          {
            "type": "text",
            "text": ". Attach tail to the rear. Pin all four legs to the underside so the dragon lies flat before sewing. Add scale embroidery last."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The amigurumi crocodile uses the same flat-lying frame with a narrower body and a longer pointed head."
          }
        ]
      }
    ]
  }
