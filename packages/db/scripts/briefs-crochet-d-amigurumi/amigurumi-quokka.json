              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-increase"
                }
              }
            ],
            "text": "increase"
          },
          {
            "type": "text",
            "text": " each round to the equator. Decrease to the neck and stuff firmly with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "stuffing-and-closing"
                }
