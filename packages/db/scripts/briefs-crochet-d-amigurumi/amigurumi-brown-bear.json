  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This bear is larger than the classic teddy and uses four legs for a seated pose. The cone muzzle gives the face more definition. All pieces start with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring-bb"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Yarn and yarn amounts"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You need approx. 47 g of medium brown DK and a small amount of tan for the muzzle. Stuff each piece with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "stuffing-bb"
                }
              }
            ],
            "text": "firm stuffing"
          },
          {
            "type": "text",
            "text": " before closing."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Head"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 10 cm sphere (27 rounds). Fit "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes-bb"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": " at round 12."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Muzzle"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 5 cm base cone over 3 cm (8 rounds) in tan yarn. Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-bb"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": " to flatten the tip slightly. Stuff lightly and sew below the eyes."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Body"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 10 cm by 14 cm oval body (29 rounds). Stuff firmly."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Legs (make 4)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 4 cm diameter by 6 cm capsule (15 rounds). Stuff firmly."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Ears (make 2)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 3.5 cm sphere for each ear. Flatten and sew to the top sides of the head."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sew head to body using "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "ladder-stitch-bb"
                }
              }
            ],
            "text": "ladder stitch"
          },
          {
            "type": "text",
            "text": ". Attach front legs to the lower body front and back legs to the body base. Pin before sewing to check the bear sits level."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The amigurumi grizzly bear uses the same structure with raised arms for a standing pose."
          }
        ]
      }
    ]
  }
