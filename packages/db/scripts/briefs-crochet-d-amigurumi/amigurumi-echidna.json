      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Attach the beak to the head front at a slight downward angle. Join the head to the body. Add four short capsule legs to the underside. Insert safety eyes on the head above the beak."
          }
        ]
      },
