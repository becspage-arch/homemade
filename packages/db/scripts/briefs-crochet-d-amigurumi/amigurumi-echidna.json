          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "surface-crochet"
                }
              }
            ],
            "text": "surface crochet"
          },
          {
            "type": "text",
            "text": " in cream or pale yarn after the main body is stuffed and closed."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Head"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rounds: 16. Start with a "
