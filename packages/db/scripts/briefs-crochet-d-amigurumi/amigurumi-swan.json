        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thread wire through the neck before seaming. Insert "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "swan-safety-eyes"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": " on the head and stuff. Sew the orange beak to the front of the head. Attach the neck between head and body. Stuff the body fully and join using "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "swan-ladder-stitch"
                }
              }
            ],
            "text": "ladder stitch"
          },
          {
            "type": "text",
            "text": ". Bend the neck wire into a graceful curve."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Embroider a small black teardrop above each safety eye for the facial mask marking. Weave in all ends."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to make next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The amigurumi flamingo uses the same wired neck method."
          }
        ]
      }
    ]
  }
