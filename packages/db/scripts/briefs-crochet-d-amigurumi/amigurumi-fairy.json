        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Head"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "16-round sphere, 6 cm diameter. Fit 9 mm safety eyes between rounds 6 and 7. Stuff firmly."
