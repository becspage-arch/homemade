    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This red woodland fox is made in five pieces: a round "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic-ring"
          },
          {
            "type": "text",
            "text": " head, a pear-shaped body, four short leg capsules, a pointed nose cone, and a long fluffy tail. "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "colour-change"
                }
              }
            ],
            "text": "Colour changes"
          },
          {
            "type": "text",
            "text": " between red and white give the muzzle, chest, and tail tip their markings. Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": " before closing the head. The finished fox stands about 18 cm tall."
          }
        ]
      },
