          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes-td"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": " at round 8 before closing."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
