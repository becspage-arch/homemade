      "slug": "magic-ring",
      "term": "magic ring",
      "definition": "An adjustable loop used to start amigurumi pieces with a tight, hole-free centre."
    },
    {
      "slug": "invisible-decrease",
      "term": "invisible decrease",
      "definition": "A decrease worked through the front loops only to avoid a visible gap on the right side."
    },
    {
      "slug": "safety-eyes",
      "term": "safety eyes",
      "definition": "Plastic eyes with a locking washer used in amigurumi for a secure, professional finish."
    },
    {
      "slug": "flat-piece",
      "term": "flat piece",
      "definition": "A crocheted piece worked without stuffing, sewn flat onto the main body as a fin or ear."
    },
    {
      "slug": "sc",
      "term": "sc",
      "definition": "Single crochet (UK: double crochet) — the main amigurumi stitch."
    },
    {
      "slug": "assembly-ladder-stitch",
      "term": "assembly ladder stitch",
      "definition": "A seaming technique that joins stuffed pieces invisibly by weaving through alternating stitches."
    }
