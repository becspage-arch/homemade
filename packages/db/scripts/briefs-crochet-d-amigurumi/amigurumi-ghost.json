      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Top section"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "21-round sphere, 8 cm diameter. This forms the rounded head of the ghost. Do not stuff yet."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Body"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Continue below the sphere without fastening off. Work 28 rounds straight at the equator stitch count to form the body tube, 10 cm tall. Stuff the head section firmly and the body lightly as you go."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Wavy hem"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work the final round as a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "wavy-hem-a80"
                }
              }
            ],
            "text": "wavy hem"
          },
          {
            "type": "text",
            "text": ": [tr in next st, dc in next st] repeat around. Fasten off and weave in the end."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Use the "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "invisible-decrease-a80"
                }
              }
            ],
            "text": "invisible decrease"
          },
          {
            "type": "text",
            "text": " for any shaping at the top sphere. Embroider two round dot eyes in black satin stitch. Add a small open-mouth oval below if desired. Weave in all ends."
          }
        ]
      },
      {
        "type": "heading",
