      "slug": "magic-ring-pa",
      "term": "Magic ring",
      "definition": "An adjustable loop used to start amigurumi rounds. Pulling the tail closes the centre hole so no gap shows."
    },
    {
      "slug": "colour-change-pa",
      "term": "Colour change",
      "definition": "Switching yarn mid-round by pulling the new colour through the final step of the last stitch before the change."
    },
    {
      "slug": "dc2tog-pa",
      "term": "Dc2tog",
      "definition": "Double crochet two stitches together. Used to taper the beak cone and close capsule wing tips."
    },
    {
      "slug": "safety-eyes-pa",
      "term": "Safety eyes",
      "definition": "Plastic eyes with a washer-lock back. Fit before the opening is too small to reach inside."
    },
    {
      "slug": "ladder-stitch-pa",
      "term": "Ladder stitch",
      "definition": "A mattress-style join worked from the outside. Pulls nearly invisible once the yarn is tensioned."
    }
