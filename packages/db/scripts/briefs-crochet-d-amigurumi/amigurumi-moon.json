          {
            "type": "text",
            "text": "Body"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rounds: 24. Begin with a "
          },
          {
            "type": "text",
            "marks": [
