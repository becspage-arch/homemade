              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-increase"
                }
              }
            ],
            "text": "increase"
          },
          {
            "type": "text",
            "text": " until the equator, then "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-decrease"
                }
              }
            ],
            "text": "decrease"
          },
          {
            "type": "text",
            "text": " to close. Use off-white or cream yarn throughout."
          }
        ]
      },
      {
