  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A tiny white baby seal made from just two pieces: a sphere head and a small oval body. Both start with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-magic-ring-bs"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". This is an ideal first amigurumi project. The whole seal uses less than 30 g of yarn and can be finished in a single sitting."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "White DK yarn, approx. 12 g. 3.5 mm crochet hook. Tapestry needle. Craft scissors. Soft measuring tape. Pair of 9 mm "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-safety-eyes-bs"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": ". Polyester stuffing."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "24 dc x 28 rows = 10 x 10 cm in DK yarn on a 3.5 mm hook."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pieces"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Head"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 1: 6 sc in magic ring (6 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 2: [inc] × 6 (12 st) (12 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 3: [2 sc, inc] × 6 (18 st) (18 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 4: [3 sc, inc] × 6 (24 st) (24 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 5: [4 sc, inc] × 6 (30 st) (30 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 6: [5 sc, inc] × 6 (36 st) (36 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 7: [6 sc, inc] × 6 (42 st) (42 sts)"
