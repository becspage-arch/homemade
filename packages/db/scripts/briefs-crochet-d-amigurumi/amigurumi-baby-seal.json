        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 16: [3 sc, dec] × 6 (24 st) (24 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 17: [2 sc, dec] × 6 (18 st) (18 sts)"
