      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Lock "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-safety-eyes-bs"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": " into the head. Stuff the head. Stuff the body lightly. Attach the head to one tapered end of the body with a "
