      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 14: [5 sc, dec] × 6 (36 st) (36 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 15: [4 sc, dec] × 6 (30 st) (30 sts)"
