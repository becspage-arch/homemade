              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring-tree"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": " at the tip, expanding outward in "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "continuous-rounds-tree"
                }
              }
            ],
            "text": "continuous rounds"
          },
          {
            "type": "text",
            "text": " to a 10 cm base. Four small bauble spheres and a short trunk are made separately and sewn on."
          }
        ]
      },
