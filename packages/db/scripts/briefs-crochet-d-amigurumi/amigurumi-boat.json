    {
      "termSlug": "amigurumi-increase",
      "definition": "Two double crochet worked into the same stitch to widen a round."
    },
    {
      "termSlug": "amigurumi-decrease",
      "definition": "Two stitches crocheted together to narrow a round."
    },
    {
      "termSlug": "working-in-the-round",
      "definition": "Crocheting in a continuous spiral without turning."
    },
    {
      "termSlug": "stuffing-and-closing",
      "definition": "Filling a piece with toy stuffing then drawing the final stitches tight."
    },
    {
      "termSlug": "colour-change",
      "definition": "Swapping yarn mid-round to add a second colour."
    }
