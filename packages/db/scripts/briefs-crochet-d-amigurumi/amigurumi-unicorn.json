  "glossaryTerms": [
    {
      "slug": "magic-ring-a71",
      "term": "Magic ring",
      "definition": "An adjustable loop used to start crocheting in the round. You work the first round of stitches into the loop, then pull the tail to close the centre hole. It avoids the gap left by a starting chain."
    },
    {
      "slug": "invisible-decrease-a71",
      "term": "Invisible decrease",
      "definition": "A dc2tog worked by inserting the hook under the front loop only of two consecutive stitches. The result sits flatter than a standard decrease and leaves no visible bump on the right side of the fabric."
    },
    {
      "slug": "yarn-mane-a71",
      "term": "Yarn mane",
      "definition": "Lengths of yarn cut and looped through stitches along the top of the head and neck with a lark's head knot. The loops are left as-is for a loopy mane or cut and brushed out for a fluffy effect."
    }
  ],
