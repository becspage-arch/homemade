        "content": [
          {
            "type": "text",
            "text": "Sew the five inner petals around the bud, overlapping slightly. Use a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-decrease-rose"
                }
              }
            ],
            "text": "decrease"
          },
          {
            "type": "text",
            "text": " at the base of any petal that is too wide at the join before stitching. Sew the seven outer petals behind the inner ring, staggered so they show between the inner petals. Attach the bud-and-petal head to the top of the stem."
          }
        ]
      },
