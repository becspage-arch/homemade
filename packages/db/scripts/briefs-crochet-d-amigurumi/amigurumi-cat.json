      "term": "magic ring",
      "definition": "An adjustable loop used to start amigurumi pieces with a tight, hole-free centre."
    },
    {
      "slug": "invisible-decrease",
      "term": "invisible decrease",
      "definition": "A decrease that removes a stitch without leaving a visible gap on the right side of the fabric."
    },
    {
      "slug": "safety-eyes",
      "term": "safety eyes",
      "definition": "Plastic eyes with a locking washer used in amigurumi to give a secure, professional finish."
    },
