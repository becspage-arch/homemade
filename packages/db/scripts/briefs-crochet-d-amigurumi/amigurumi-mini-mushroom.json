            "text": "invisible finish"
          },
          {
            "type": "text",
            "text": " and close."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Insert the open top of the stem into the open base of the cap. Stuff the cap lightly. Whip stitch the remaining opening of the cap firmly around the stem. Embroider small white spots on the cap using your tapestry needle and contrast yarn. Attach a keychain clip to the top of the stem through the magic ring."
          }
        ]
      }
