        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 6: [5 sc, inc] × 6 (36 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 7: sc in each st (36 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 8: sc in each st (36 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 9: [4 sc, dec] × 6 (30 st)"
