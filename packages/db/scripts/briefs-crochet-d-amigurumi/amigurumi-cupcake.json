      "slug": "working-in-the-round-a61",
      "term": "Working in the round",
      "definition": "Crocheting in continuous rounds without turning, so the right side always faces you."
    },
    {
      "slug": "invisible-finish-a61",
      "term": "Invisible finish",
      "definition": "A method of closing the final round using the tail threaded through the front loops of the last stitches, hiding the join."
