      "slug": "magic-ring-li",
      "term": "Magic ring",
      "definition": "An adjustable loop used to start amigurumi rounds. Pulling the tail closes the centre hole so no gap shows."
    },
    {
      "slug": "loop-stitch-li",
      "term": "Loop stitch",
      "definition": "A decorative stitch where a yarn loop is held at the back of the work as the stitch is completed. Used here for the lion mane."
    },
    {
      "slug": "dc2tog-li",
      "term": "Dc2tog",
      "definition": "Double crochet two stitches together. Used for decrease rounds that close each piece."
    },
    {
      "slug": "safety-eyes-li",
      "term": "Safety eyes",
      "definition": "Plastic eyes with a washer-lock back. Fit before the opening is too small to reach inside."
    },
    {
      "slug": "ladder-stitch-li",
      "term": "Ladder stitch",
      "definition": "A mattress-style join worked from the outside. Pulls nearly invisible once the yarn is tensioned."
    }
