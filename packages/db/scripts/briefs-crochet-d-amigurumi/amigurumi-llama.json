  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The llama uses a longer neck than the alpaca. The saddle blanket is a small rectangle crocheted separately using "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "colour-change-ll"
                }
              }
            ],
            "text": "colour change"
          },
          {
            "type": "text",
            "text": " stripes and sewn across the body top. All pieces start with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring-ll"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Yarn and yarn amounts"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You need approx. 36 g total: brown DK for the main body and small amounts of red, blue, and orange for the saddle blanket stripes. Stuff each piece with firm stuffing before closing."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Head"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 5 cm by 8 cm oval head (15 rounds). Fit "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes-ll"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": " at round 7. Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-ll"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": " to close."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Neck"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 4 cm diameter by 8 cm cylinder (22 rounds). Stuff firmly so the neck holds the head upright."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Body"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 9 cm by 13 cm oval body (26 rounds). Stuff firmly."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Saddle blanket"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 7 cm by 5 cm rectangle in rows. Work 2-row stripes in alternating colours. Cast off and sew across the body top with the edges tucked slightly under."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Legs (make 4)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 2.5 cm diameter by 6 cm capsule per leg (15 rounds). Stuff firmly."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sew body to neck base using "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "ladder-stitch-ll"
                }
              }
            ],
            "text": "ladder stitch"
          },
          {
            "type": "text",
            "text": ". Sew head to neck top. Pin legs to the body base and check the llama stands level before sewing. Add the saddle blanket last."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The amigurumi alpaca uses a shorter neck and a yarn top-knot on the head crown."
          }
        ]
      }
    ]
  }
}