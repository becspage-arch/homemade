          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": ". Polyester stuffing. Tapestry needle."
          }
