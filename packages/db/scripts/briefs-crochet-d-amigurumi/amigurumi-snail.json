        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 17: [3 sc, dec] × 6 (24 st) (24 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
