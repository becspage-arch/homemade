  "glossaryTerms": [
    {
      "slug": "magic-ring",
      "term": "Magic Ring",
      "definition": "An adjustable start loop that closes to leave no hole at the centre of a piece."
    },
    {
      "slug": "surface-embroidery",
      "term": "Surface Embroidery",
      "definition": "Decorative stitching worked on top of finished crochet fabric to add spiral or texture detail."
    },
    {
      "slug": "safety-eyes",
      "term": "Safety Eyes",
      "definition": "Plastic eyes with a locking washer; secure before stuffing as they cannot be added afterwards."
    },
    {
      "slug": "amigurumi-decrease",
      "term": "Invisible Decrease",
      "definition": "An invisible decrease worked through the front loops only to reduce stitch count without a visible gap."
    }
  ],
  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This garden snail has a pear-shaped body curling upward at the front and a sphere shell mounted on its back. The shell spiral is added with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "surface-embroidery"
                }
              }
            ],
            "text": "surface embroidery"
          },
          {
            "type": "text",
            "text": " after the piece is assembled. The body sits flat, giving the snail a stable base. Start both pieces with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". The snail measures about 12 cm from nose to tail."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Materials"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "DK yarn: 30 g sage green (body), 25 g terracotta (shell), 5 g cream. 3.5 mm crochet hook. Pair of 8 mm "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": " on stalks if available, or standard 8 mm. Polyester stuffing. Tapestry needle."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "24 sts × 28 rows = 10 × 10 cm in dc on a 3.5 mm hook."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Body (sage green)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work the pear with the wide base at the bottom. Leave the top open after the final round; this open end will tuck under the shell during assembly."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 1: 6 sc in magic ring (6 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 2: [inc] × 6 (12 st) (12 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 3: [2 sc, inc] × 6 (18 st) (18 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 4: [3 sc, inc] × 6 (24 st) (24 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 5: Increase 6 stitches evenly around (30 st) (30 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 6: Increase 6 stitches evenly around (36 st) (36 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 7: Increase 6 stitches evenly around (42 st) (42 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 8: Increase 6 stitches evenly around (48 st) (48 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 9: sc in each st (48 st) (48 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 10: sc in each st (48 st) (48 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 11: sc in each st (48 st) (48 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 12: sc in each st (48 st) (48 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 13: sc in each st (48 st) (48 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 14: [6 sc, dec] × 6 (42 st) (42 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 15: [5 sc, dec] × 6 (36 st) (36 sts)"
          }
