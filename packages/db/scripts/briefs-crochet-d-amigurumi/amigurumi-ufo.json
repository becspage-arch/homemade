      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 6: [5 sc, inc] × 6 (36 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 7: [6 sc, inc] × 6 (42 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 8: [7 sc, inc] × 6 (48 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 9: sc in each st (48 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 10: [6 sc, dec] × 6 (42 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 11: [5 sc, dec] × 6 (36 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 12: [4 sc, dec] × 6 (30 st)"
          }
