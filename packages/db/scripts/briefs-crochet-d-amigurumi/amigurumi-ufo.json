    "content": [
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "About this pattern"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "An intermediate silver UFO saucer with a teal dome on top. The saucer body is a flat oval disc stuffed lightly to hold its shape, and the dome is a half-sphere worked in a contrasting colour. Small light spots are embroidered around the rim using yellow yarn."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Saucer disc"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rounds: 15. Begin with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": " in silver yarn and "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-increase"
                }
              }
            ],
            "text": "increase"
          },
          {
            "type": "text",
            "text": " outward to the full disc width. Work two straight rounds, then "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-decrease"
                }
              }
            ],
            "text": "decrease"
          },
          {
            "type": "text",
            "text": " the underside back down. Stuff lightly before closing."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 1: Chain 24. Working along chain: 2 sc in 2nd ch from hook, sc in next 21 ch, 3 sc in last ch, rotate. Along opposite side: sc in next 21 ch, 2 sc in last ch (50 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 2: Increase 6 stitches evenly around (56 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 3: Increase 6 stitches evenly around (62 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 4: Increase 6 stitches evenly around (68 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 5: Increase 6 stitches evenly around (74 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 6: Increase 6 stitches evenly around (80 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 7: sc in each st (80 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 8: sc in each st (80 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 9: sc in each st (80 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 10: sc in each st (80 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 11: Decrease 6 stitches evenly around (74 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 12: Decrease 6 stitches evenly around (68 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 13: Decrease 6 stitches evenly around (62 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 14: Decrease 6 stitches evenly around (56 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 15: Decrease 6 stitches evenly around (50 st). FO leaving 15 cm tail for closure."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Dome"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rounds: 16. Work a half-sphere in teal, beginning with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-increase"
                }
              }
            ],
            "text": "increase"
          },
          {
            "type": "text",
            "text": " rounds only, stopping at the equator. Leave the flat base open. Do not stuff."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 1: 6 sc in magic ring"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 2: [inc] × 6 (12 st)"
          }
        ]
      },
      {
        "type": "paragraph",
