      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 15: [1 sc, dec] × 6 (12 st)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 16: [dec] × 6 (6 st). FO leaving 15 cm tail for closure."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Centre the dome on the top of the saucer and sew around the base edge. Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "colour-change"
                }
              }
            ],
            "text": "colour change"
          },
          {
            "type": "text",
            "text": " or embroidery to add a ring of alternating light dots around the saucer rim. Add safety eyes inside the dome for a small alien passenger if desired."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "stuffing-and-closing"
                }
              }
            ],
            "text": "Stuffing and closing"
          },
          {
            "type": "text",
            "text": " the saucer disc lightly keeps it flat rather than round."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "working-in-the-round"
                }
              }
            ],
            "text": "Working in the round"
          },
          {
            "type": "text",
            "text": " throughout both pieces."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Estimated yarn: saucer 7 g silver, dome 5 g teal."
          }
        ]
      }
