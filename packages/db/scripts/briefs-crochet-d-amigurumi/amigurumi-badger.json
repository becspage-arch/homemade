            "text": "Round 9: [8 sc, inc] × 6 (54 st) (54 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 10: sc in each st (54 st) (54 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
