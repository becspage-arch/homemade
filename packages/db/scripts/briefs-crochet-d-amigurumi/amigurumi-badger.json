        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 12: [7 sc, dec] × 6 (48 st) (48 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
