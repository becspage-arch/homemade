  "body": {
    "type": "doc",
    "content": [
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Halves (make 2)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Start with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring-a175"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". Round 1: 6 dc. Round 2: 2 dc in each (12 sts). Round 3: (dc, 2 dc in next) x 6 (18 sts). Rounds 4-5: dc around. Round 6: (dc, "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-a175"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": ") x 6 (12 sts). Stuff lightly. Round 7: dc2tog x 6 (6 sts). Apply "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "invisible-finish-a175"
                }
              }
            ],
            "text": "invisible finish"
          },
          {
            "type": "text",
            "text": " and close. Leave a long sewing tail on the first half only."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Joining"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Hold the two halves side by side with closed tops uppermost. Whip stitch them together along about two thirds of the top edge, leaving the lower third open. Push both pieces gently together and pinch the bottom to form a point. Stitch through both layers at the pinch point to hold the heart shape. Attach a keychain clip at the centre top between the two humps."
          }
        ]
      }
    ]
  }
