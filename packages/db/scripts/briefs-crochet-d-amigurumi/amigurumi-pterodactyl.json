      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Attach the beak to the front of the head. Sew the head to the front of the body. Attach the wings to the sides of the body, angling them slightly upward and backward. Add a small flattened cone to the top of the head for the crest."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Add safety eyes to each side of the head, positioned between the beak base and the crest. Two small cylinder feet can be added under the body for display."
          }
        ]
