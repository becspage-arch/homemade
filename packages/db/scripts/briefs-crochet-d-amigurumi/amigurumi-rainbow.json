          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "amigurumi-decrease"
                }
              }
            ],
            "text": "decreases"
          },
          {
            "type": "text",
            "text": " back to close. Sew one cloud ball to each end of the arc, covering the closing stitches."
          }
