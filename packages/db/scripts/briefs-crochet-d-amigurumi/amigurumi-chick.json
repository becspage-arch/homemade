      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 4: sc in each st (12 st). FO leaving 20 cm tail for attaching to body. (12 sts)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
