        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 14: [2 sc, dec] × 6 (18 st) (18 sts)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 15: [1 sc, dec] × 6 (12 st) (12 sts)"
