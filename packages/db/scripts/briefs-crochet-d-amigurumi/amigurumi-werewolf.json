        "content": [
          {
            "type": "text",
            "text": "Work all pieces in brown dk yarn. Use a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring-a78"
