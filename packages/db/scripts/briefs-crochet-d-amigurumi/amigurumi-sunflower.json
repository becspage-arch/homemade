    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Sew the twelve petals evenly around the back face of the centre, pointing outward. Attach the base of the centre to the top of the stem. If any petal is too wide at the base, "
        },
        {
          "type": "text",
          "marks": [
            {
              "type": "glossaryTooltip",
              "attrs": {
                "termSlug": "amigurumi-decrease"
              }
            }
          ],
          "text": "decrease"
        },
        {
          "type": "text",
          "text": " one stitch before pinning it in place. The petals frame the centre on all sides."
        }
      ]
    },
