        {
          "type": "text",
          "marks": [
            {
              "type": "glossaryTooltip",
              "attrs": {
                "termSlug": "amigurumi-increase"
              }
            }
          ],
          "text": "Increase"
        },
        {
          "type": "text",
          "text": " at both narrow ends to shape the tip."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Round 1: Chain 9. Working along chain: 2 sc in 2nd ch from hook, sc in next 6 ch, 3 sc in last ch, rotate. Along opposite side: sc in next 6 ch, 2 sc in last ch (20 st)"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Round 2: Increase 6 stitches evenly around (26 st)"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Round 3: Increase 6 stitches evenly around (32 st)"
        }
      ]
    },
    {
