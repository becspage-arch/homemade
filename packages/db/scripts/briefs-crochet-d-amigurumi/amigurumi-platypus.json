      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Sew the bill to the narrow front of the body. Attach the flat tail to the back. Sew four short legs to the underside at the mid-point. Add safety eyes just above the bill join."
          }
        ]
