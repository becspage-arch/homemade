                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "colour-change"
                }
              }
            ],
            "text": "colour change"
          },
          {
            "type": "text",
            "text": " and left open at the top to give a ruffled look."
          }
        ]
      },
      {
        "type": "heading",
