    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This small grey wood mouse has a round sphere head, a pear-shaped body, and two flat cone ears. The thin rope tail is a crochet chain. Start every piece with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ". "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes"
                }
              }
            ],
            "text": "Safety eyes"
          },
          {
            "type": "text",
            "text": " give the mouse its wide-eyed look. The finished mouse sits about 10 cm tall."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Materials"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "DK yarn: 40 g mid grey, 5 g pale pink. 3.5 mm crochet hook. Pair of 8 mm "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "safety-eyes"
                }
              }
            ],
            "text": "safety eyes"
          },
          {
            "type": "text",
            "text": ". Polyester stuffing. Tapestry needle."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "24 sts × 28 rows = 10 × 10 cm in dc on a 3.5 mm hook."
          }
        ]
      },
      {
