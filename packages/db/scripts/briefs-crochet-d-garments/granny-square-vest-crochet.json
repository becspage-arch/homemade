      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Join all squares into front and back grids. Seam the panels at both shoulder edges across the top two squares. Seam both side edges leaving the top 20 cm (two squares) open for armholes. Work one round of dc around each armhole edge and around the neckline."
          }
        ]
