      "slug": "granny-sq-g183",
      "term": "Granny square",
      "definition": "A motif worked in rounds from a centre ring. Treble clusters at the corners and along the sides build a flat square that measures consistently once blocked."
    },
    {
      "slug": "join-as-you-go-g183",
      "term": "Join as you go",
      "definition": "A technique where the final round of each new square replaces the ch-2 corner space with a slip stitch into the corresponding corner of an already-finished square, attaching the two without a separate seaming step."
    },
    {
      "slug": "armhole-edge-g183",
      "term": "Armhole edge",
      "definition": "The open side edges of a sleeveless vest left unjoined at the top of each panel to form the armhole. A round of dc is worked along this edge to stabilise it."
    }
  ],
