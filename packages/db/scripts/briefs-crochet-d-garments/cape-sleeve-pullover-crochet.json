  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work front and back body panels as for a standard drop-shoulder tunic. Instead of sleeve tubes, work a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "cape-panel-g66"
                }
              }
            ],
            "text": "cape panel"
          },
          {
            "type": "text",
            "text": " for each arm. Each cape panel is a wide rectangle that attaches along the shoulder seam. Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-g66"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": " at the front neck edges."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Size M: body 188 sts wide and 81.7 cm tall. Each cape panel is approximately 54 sts wide at the hem and 25 cm tall, tapering to 30 sts at the shoulder edge."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials (size M)",
          "items": [
            {
              "name": "DK yarn",
              "qty": "448 yards"
            },
            {
              "name": "4 mm crochet hook",
              "qty": "1"
            },
            {
              "name": "Tapestry needle",
              "qty": "1"
            },
            {
              "name": "Measuring tape",
              "qty": "1"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Body"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 190. Work dc for 81.7 cm. Shape neck with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-g66"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": ". Work back panel identically without neck shaping."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Cape panels (make 2)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 56 for size M (adjust for other sizes). Decrease 1 st each side every 5 rows for 25 cm until 30 sts remain at the shoulder edge. Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Seam front to back at shoulders. Attach the narrow edge of each "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "cape-panel-g66"
                }
              }
            ],
            "text": "cape panel"
          },
          {
            "type": "text",
            "text": " along the shoulder seam. Seam body sides below the cape attachment. Weave in ends."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
