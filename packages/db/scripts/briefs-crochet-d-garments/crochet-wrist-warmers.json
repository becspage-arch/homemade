    {
      "slug": "fpdc-bpdc-rib-g114",
      "term": "FPDC/BPDC rib",
      "definition": "A crochet rib made by alternating front post double crochet and back post double crochet across each round. Working consistently into the same posts each round creates a stretchy raised rib fabric."
    },
    {
      "slug": "thumb-opening-g114",
      "term": "Thumb opening",
      "definition": "A gap in the rib formed by skipping several stitches and replacing them with chains on one round. On the following round those chains are worked as stitches, leaving an opening for the thumb to pass through."
    }
  ],
