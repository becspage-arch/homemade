  "glossaryTerms": [
    {
      "slug": "hex-motif-g189",
      "term": "Hexagon motif",
      "definition": "A six-sided crochet motif worked in rounds from a centre ring. Each round extends the shape outward and ends with six equal sides."
    },
    {
      "slug": "jayg-g189",
      "term": "Join as you go",
      "definition": "On the final round of each new hexagon, slip stitch into the corresponding edge of an already-finished neighbour instead of working a ch-2 space. This joins the two motifs in the same pass as completing the new one."
    },
    {
      "slug": "half-hex-g189",
      "term": "Half hexagon",
      "definition": "A hexagon worked to the midpoint then folded in half to fill the stepped edge of a hex grid at the hem and cuff lines. Half hexagons create a straight lower edge."
    }
  ],
