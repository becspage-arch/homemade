  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The most fitted crochet construction. Back, front, and sleeves all carry shaped "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "sleeve-cap-g20"
                }
              }
            ],
            "text": "sleeve caps"
          },
          {
            "type": "text",
            "text": " and armhole curves. Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-g20"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": " to work the curved edges. The result sits more closely to the arm than a drop-shoulder or raglan."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Size M: 138 sts wide, 66.6 cm body. Armhole depth 38 rows."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials (size M)",
          "items": [
            {
              "name": "Aran yarn",
              "qty": "290 yards"
            },
            {
              "name": "5 mm crochet hook",
              "qty": "1"
            },
            {
              "name": "Tapestry needle",
              "qty": "1"
            },
            {
              "name": "Scissors",
              "qty": "1 pair"
            },
            {
              "name": "2 cm buttons",
              "qty": "6"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Back"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 140. Work dc to underarm. Shape armhole: cast off 4 sts each end, then "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-g20"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": " each end for 3 rows. Work to shoulder."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Front halves"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work each front half separately. Apply armhole shaping as for back. Shape neck at top."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Sleeves"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 32. Work to 75 cm. "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "sleeve-cap-g20"
                }
              }
            ],
            "text": "Sleeve cap"
          },
          {
            "type": "text",
            "text": ": cast off 4 sts, then decrease each end every row until cap is ${g20m.yokeDepthRows} rows tall. Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The drop-shoulder cardigan uses the same shape without the armhole shaping curves."
          }
        ]
      }
    ]
  }
