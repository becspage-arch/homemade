  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "basket-weave-g201"
                }
              }
            ],
            "text": "basket-weave stitch"
          },
          {
            "type": "text",
            "text": " is built from alternating 4-stitch panels of "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fpdc-g201"
                }
              }
            ],
            "text": "fpdc"
          },
          {
            "type": "text",
            "text": " and bpdc. On the next row, work bpdc over the fpdc columns and fpdc over the bpdc columns to reverse the relief. Continue alternating for the full body height to build up the woven effect."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Size M: 146 sts wide, 81.7 cm body. Sleeve 63.3 cm."
          }
        ]
      },
