  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Start at the top centre point and increase on every row. Work a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "spine-increase-g72"
                }
              }
            ],
            "text": "spine increase"
          },
          {
            "type": "text",
            "text": " at the midpoint and an "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "edge-increase-g72"
                }
              }
            ],
            "text": "edge increase"
          },
          {
            "type": "text",
            "text": " at each side on every right-side row. The shawl grows by 4 stitches per row."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Begin with 5 sts. Work increases every row until the top edge measures 160 cm. Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            {
              "name": "DK yarn",
              "qty": "600 yards"
            },
            {
              "name": "4 mm crochet hook",
              "qty": "1"
            },
            {
              "name": "Tapestry needle",
              "qty": "1"
            },
            {
              "name": "Scissors",
              "qty": "1 pair"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Starting point"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 6. Row 1: dc in 4th ch from hook, dc, 2 dc in last ch (5 sts). Turn."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Increase rows"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Row 2: ch 3, 2 dc in first st, dc to centre st, "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "spine-increase-g72"
                }
              }
            ],
            "text": "2 dc in centre st"
          },
          {
            "type": "text",
            "text": ", dc to last st, "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "edge-increase-g72"
                }
              }
            ],
            "text": "2 dc in last st"
          },
          {
            "type": "text",
            "text": ". Turn. Repeat row 2 until length is reached."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Border"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work 1 round of dc around all three sides of the triangle. Fasten off and weave in ends."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
