      "slug": "fpdc-gs2",
      "term": "Front post double crochet",
      "definition": "A dc worked around the front of the post of the stitch below. Creates the raised ribs in the 1x1 rib."
    },
    {
      "slug": "bpdc-gs2",
      "term": "Back post double crochet",
      "definition": "A dc worked around the back of the post below. Forms the recessed part of the rib."
    }
