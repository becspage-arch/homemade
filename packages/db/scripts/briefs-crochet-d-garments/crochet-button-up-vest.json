      "slug": "button-band-g70",
      "term": "Button band",
      "definition": "A narrow strip of rib or dc worked along the front edge of a cardigan or vest. One side carries the buttons, the other has buttonholes spaced to match."
    },
    {
      "slug": "dc2tog-g70",
      "term": "Dc2tog",
      "definition": "Double crochet two stitches together. Used at the neck shaping on each front panel."
    },
    {
      "slug": "fpdc-g70",
      "term": "Front post double crochet",
      "definition": "A dc worked around the front of the post. Used in the button band rib for a firm, neat edge."
    },
    {
      "slug": "bpdc-g70",
      "term": "Back post double crochet",
      "definition": "A dc around the back of the post. The recessed stitch in the button band rib."
    }
