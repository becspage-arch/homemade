  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work back and two front panels in plain dc as for a standard drop-shoulder vest. Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-g70"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": " at the front neck edges. After seaming, work a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "button-band-g70"
                }
              }
            ],
            "text": "button band"
          },
          {
            "type": "text",
            "text": " along each front edge using "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fpdc-g70"
                }
              }
            ],
            "text": "fpdc"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bpdc-g70"
                }
              }
            ],
            "text": "bpdc"
          },
          {
            "type": "text",
            "text": " 1x1 rib. On the left band, work 5 evenly spaced buttonholes by chaining 2 and skipping 2 sts."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Size M: back 188 sts wide and 81.7 cm tall. Each front half 94 sts wide. Button band 5 sts wide, 5 buttons spaced evenly."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
