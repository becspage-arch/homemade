      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Back"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 190. Work dc for 81.7 cm. Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Front halves (make 2)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 96. Work dc for 81.7 cm. Shape neck with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-g70"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": ". Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Seam shoulders and sides. Work dc edging around armholes."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Button bands"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work 5 sts of 1x1 rib ("
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fpdc-g70"
                }
              }
            ],
            "text": "fpdc"
          },
          {
            "type": "text",
            "text": "/"
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bpdc-g70"
                }
              }
            ],
            "text": "bpdc"
          },
          {
            "type": "text",
            "text": ") along the right front edge for the button band. Work the left front edge the same but on the 3rd band row, work 5 evenly spaced buttonholes: ch 2, skip 2. Sew buttons to the right band to match. Weave in ends."
          }
        ]
      },
