      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 148. Row 1: dc across. From row 2, work 10 sts in 1x1 rib ("
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fpdc-g67"
                }
              }
            ],
            "text": "fpdc"
          },
          {
            "type": "text",
            "text": "/"
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bpdc-g67"
                }
              }
            ],
            "text": "bpdc"
          },
          {
            "type": "text",
            "text": "), dc across centre 126 sts, then 10 sts rib. Continue for 81.7 cm."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Front panel"
