  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work front and back panels in plain dc, reserving the outer 10 sts on each side for the "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "side-panel-g67"
                }
              }
            ],
            "text": "ribbed side panel"
          },
          {
            "type": "text",
            "text": ". Work those outer sts in 1x1 rib using alternating "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fpdc-g67"
                }
              }
            ],
            "text": "fpdc"
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bpdc-g67"
                }
              }
            ],
            "text": "bpdc"
          },
          {
            "type": "text",
            "text": " for every row. This gives a continuous rib strip down each side."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Size M: each panel 146 sts wide total. Centre dc section 126 sts. Side rib sections 10 sts each side. Body 81.7 cm."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
