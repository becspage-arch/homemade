                "attrs": {
                  "termSlug": "dc-tie-belt-g111"
                }
              }
            ],
            "text": "dc tie belt"
          },
          {
            "type": "text",
            "text": " and sew it at the waist seams."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Size M: 116 sts wide at bust. Body 105 cm. Sleeve 55 cm."
