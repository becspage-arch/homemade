                  "termSlug": "fpdc-cross-g204"
                }
              }
            ],
            "text": "fpdc cross-over cable"
          },
          {
            "type": "text",
            "text": " repeat throughout. The "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "open-front-g204"
                }
              }
            ],
            "text": "open front"
          },
          {
            "type": "text",
            "text": " needs no fastenings. Work a single dc border down each front edge. Seam shoulders. Set in sleeves. Seam sides and undersleeves."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
