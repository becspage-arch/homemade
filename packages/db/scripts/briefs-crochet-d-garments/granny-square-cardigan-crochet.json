      "slug": "granny-sq-g182",
      "term": "Granny square",
      "definition": "A classic motif worked in rounds from a centre ring. Clusters of treble stitches sit at each corner and along each side, building a flat square."
    },
    {
      "slug": "flat-join-g182",
      "term": "Flat join",
      "definition": "Placing two finished squares wrong sides together and working a slip stitch through both outer loops along the shared edge. Creates a visible raised seam on the right side."
    },
    {
      "slug": "dc-border-g182",
      "term": "dc border",
      "definition": "One or more rounds of double crochet worked around the full outer edge of the finished cardigan to neaten and stabilise all open edges including the front bands."
    }
