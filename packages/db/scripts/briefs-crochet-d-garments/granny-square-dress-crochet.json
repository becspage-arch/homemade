      "slug": "granny-sq-g184",
      "term": "Granny square",
      "definition": "A motif worked in rounds from a centre ring. Each round adds treble clusters at the corners and along the sides."
    },
    {
      "slug": "pickup-round-g184",
      "term": "Pick-up round",
      "definition": "A row or round of dc worked along the lower edge of a finished bodice section to establish a stitch count for the skirt. The number of stitches picked up determines the skirt width."
    },
    {
      "slug": "skirt-flare-g184",
      "term": "Skirt flare",
      "definition": "Increases worked at regular intervals on the skirt rounds to add width toward the hem. A slight A-line flare is created by adding one dc every 10 stitches on every fifth round."
    }
  ],
