    {
      "slug": "treble-mesh-g106",
      "term": "Treble mesh",
      "definition": "A fabric made by alternating treble crochet stitches with chain spaces. Each row sits the trebles into the chain spaces of the previous row. The result is an open, regular grid."
    },
    {
      "slug": "ch-sp-g106",
      "term": "Chain space",
      "definition": "The gap left by a chain in the previous row. Trebles are worked into these gaps rather than into individual stitches, keeping the mesh pattern consistent."
    }
  ],
