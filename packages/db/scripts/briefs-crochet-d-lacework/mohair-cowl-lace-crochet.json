                    "text": "sl st: slip stitch"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Foundation: chain 56. Sl st to first ch to form a ring."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Round 1"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 6 (counts as tr plus ch 3). *Skip 3 ch, tr into the next ch, ch 3*. Repeat around. Sl st to the 3rd ch of starting ch-6. (14 tr, 14 ch-3 spaces.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Round 2"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 6 (counts as tr plus ch 3). *Skip the ch-3 space, tr into the next tr, ch 3*. Repeat around. Sl st to 3rd ch of starting ch-6."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Repeat Round 2 for 20 rounds total, or until the cowl measures 26 cm. Fasten off. Thread the tapestry needle carefully through the mohair halo to weave in ends without breaking the fibres."
          }
        ]
      }
    ]
