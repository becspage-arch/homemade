      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Foundation and arc row" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Chain a multiple of 8 plus 2. Row 1: dc in each ch to end. Row 2: ch 1, *dc in next 3 dc, ch 5, skip 4 dc; repeat from * to last 3 sts, dc in each to end. Turn." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Fan row" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Row 3: ch 3, *7 tr into ch-5 arc, skip the 3 dc, dc into the next dc; repeat from * across. Fasten off." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Attaching" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Sew the foundation row edge to your fabric using the tapestry needle. Weave in all ends." }]
