                    "text": "sl st: slip stitch"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Foundation: chain 60. Sl st to the first ch to form a ring."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Round 1"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 5 (counts as tr plus ch 2). *Skip 2 ch, tr into the next ch, ch 2*. Repeat around. Sl st to the 3rd ch of starting ch-5. (20 tr, 20 ch-2 spaces.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Round 2"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 5 (counts as tr plus ch 2). *Skip the ch-2 space, tr into the next tr, ch 2*. Repeat around. Sl st to 3rd ch of starting ch-5."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Repeat Round 2 for 110 rounds, or until the tube measures 110 cm from the foundation ring. Fasten off. Weave in ends. Wet block, pulling the tube gently into a uniform cylinder."
          }
        ]
      }
    ]
  }
