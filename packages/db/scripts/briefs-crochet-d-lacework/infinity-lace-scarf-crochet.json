    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "An infinity scarf worked in the round as a long tube, then joined at the ends. The "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "shell-stitch"
                }
              }
            ],
            "text": "shell stitch"
          },
          {
            "type": "text",
            "text": " lace repeat works the same in every round because the right side always faces you."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The tube is 80 rounds of shell lace, making a loop approximately 150 cm in circumference. It is worn doubled around the neck."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
