                    "text": "ch: chain"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "dc (UK): double crochet"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "shell-stitch"
                        }
                      }
                    ],
                    "text": "shell stitch"
                  },
                  {
                    "type": "text",
                    "text": ": 5 tr into the same stitch"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "glossaryTooltip",
                        "attrs": {
                          "termSlug": "joining-round"
                        }
                      }
                    ],
                    "text": "joining round"
                  },
                  {
                    "type": "text",
                    "text": ": sl st to close each round"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "sl st: slip stitch"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Foundation: chain 51. Sl st to the first ch to form a ring. Be careful not to twist."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Round 1"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 3 (counts as first tr). Work 4 tr into the first ch (first shell). *Skip 4 ch, dc into the next ch, skip 4 ch, work 5 tr into the next ch (one shell)*. Repeat from * to * around. "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "joining-round"
                }
              }
            ],
            "text": "Join"
          },
          {
            "type": "text",
            "text": " with sl st to the top of the ch-3. (5 shells.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Round 2"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 1. Dc into the first tr (centre of shell). *Skip 2 tr, work 5 tr into the next dc, skip 2 tr, dc into the centre tr of the next shell*. Repeat around. Join with sl st to first dc."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Repeat Round 2 until work measures 150 cm in circumference (approximately 80 rounds). Fasten off. Weave in ends. Block lightly."
          }
        ]
      }
    ]
  }
