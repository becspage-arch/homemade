      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pattern"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Foundation: chain 74. Sl st to first ch to form a ring."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Round 1"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 4 (counts as tr plus ch 1). *Skip 1 ch, tr into the next ch, ch 1*. Repeat around. Sl st to the 3rd ch of starting ch-4. (37 tr, 37 ch-1 spaces.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Round 2"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 4 (counts as tr plus ch 1). *Skip the ch-1 space, tr into the next tr, ch 1*. Repeat around. Sl st to 3rd ch of starting ch-4."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Repeat Round 2 for 35 rounds total, or until the snood measures 35 cm from the foundation ring. Fasten off. Weave in ends."
          }
        ]
      }
    ]
