        "content": [
          { "type": "text", "text": "The doily grows in 8 " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "spoke-l43" } }], "text": "spokes" },
          { "type": "text", "text": " from the centre outward. " },
