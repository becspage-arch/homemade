        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Assemble" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Lay the front right side up. Overlap the two back panels at the centre, right sides down. Sew around all four edges with whip stitch using the tapestry needle. Turn right side out and insert the cushion pad." }]
