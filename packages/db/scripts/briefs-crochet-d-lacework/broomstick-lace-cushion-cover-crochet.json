      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Chain 50. Row 1: dc in each ch (50 dc). Work broomstick lace in groups of 5 (10 clusters) until the front measures 45 cm square. Bind off." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Back panels (make 2)" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Chain 50. Work dc rows until each back panel measures 30 cm. Fasten off." }]
      },
