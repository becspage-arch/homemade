    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A long flat scarf with a plain shell lace body and a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "ruffle-edging"
                }
              }
            ],
            "text": "ruffle edging"
          },
          {
            "type": "text",
            "text": " along both long sides. The ruffle is a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "lace-border"
                }
              }
            ],
            "text": "lace border"
          },
          {
            "type": "text",
            "text": " that gathers heavily by working three stitches into every stitch of the edge."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "right-side"
                }
              }
            ],
            "text": "right side"
          },
          {
            "type": "text",
            "text": " of the body is kept facing up throughout to make the ruffle join invisible. A light wet block sets the ruffle in its gathered position without flattening it."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
