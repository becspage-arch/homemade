  "glossaryTerms": [
    {
      "slug": "tunisian-simple-stitch",
      "term": "Tunisian simple stitch",
      "definition": "The foundation stitch of Tunisian crochet: insert the hook behind the front vertical bar of each stitch and pull up a loop, keeping all loops on the hook across the forward pass, then work them off two at a time on the return pass."
    },
    {
      "slug": "forward-pass",
      "term": "Forward pass",
      "definition": "The first half of a Tunisian row, where the hook picks up loops from left to right until all stitches are on the hook."
    },
    {
      "slug": "return-pass",
      "term": "Return pass",
      "definition": "The second half of a Tunisian row, where the hook works from right to left, pulling yarn through two loops at a time until one loop remains."
    },
    {
      "slug": "openwork-panel",
      "term": "Openwork panel",
      "definition": "A vertical strip of chain spaces and single stitches worked between solid Tunisian columns to create a ladder or eyelet effect."
    }
  ],
