  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Each wrist warmer is a small flat panel seamed with a " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "mitt-seam-l22" } }], "text": "mitt seam" },
          { "type": "text", "text": " on one side, leaving a " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "thumb-gap-l22" } }], "text": "thumb gap" },
          { "type": "text", "text": " of about 3 cm." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            { "name": "DK weight yarn", "qty": "100 m" },
            { "name": "4.0 mm crochet hook", "qty": "1" },
            { "name": "20 mm dowel or large needle", "qty": "1" },
            { "name": "Tapestry needle", "qty": "1" }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Foundation (make 2)" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Chain 30. Row 1: dc in each ch (30 dc). Do not turn." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Broomstick lace" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Loop row: draw up a loop from every stitch onto the dowel (30 loops). Cluster row: slide 5 loops off, ch 1, work 5 dc through the centre; repeat (6 clusters). Repeat until the panel is 15 cm." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Seam" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Fold each panel so the long edges meet. Seam from the cast-on end for 4 cm, leave 3 cm open for the thumb, then seam to the top. Fasten off and weave in the ends with the tapestry needle." }]
      }
    ]
  }
