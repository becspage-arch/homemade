        },
        "content": [
          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "2 shells x 6 rows = 10 x 10 cm after blocking."
