    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A wide, slouchy cowl in "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "open-mesh"
                }
              }
            ],
            "text": "open mesh"
          },
          {
            "type": "text",
            "text": " lace, worked in sport weight yarn. The mesh is a simple alternating grid of trebles and chain-2 spaces, which makes a very open, drapey fabric when "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "blocking"
                }
              }
            ],
            "text": "blocked"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The cowl is 40 rounds tall so it folds over in a wide double loop or sits high as a loose collar. The "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "foundation-ring"
                }
              }
            ],
            "text": "foundation ring"
          },
          {
            "type": "text",
            "text": " is 120 chains, giving 30 mesh repeats around."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            {
