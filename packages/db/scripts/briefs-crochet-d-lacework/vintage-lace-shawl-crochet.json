  "glossaryTerms": [
    {
      "slug": "treble-cluster",
      "term": "Treble cluster",
      "definition": "Three or four trebles worked into the same space, each left unfinished until the last step when all loops are closed together. The result is a single raised point."
    },
    {
      "slug": "chain-arch-vintage",
      "term": "Chain arch",
      "definition": "A chain of 4 or 5 bridging two cluster points. The arch creates the open space between clusters that gives vintage lace its characteristic airiness."
    },
    {
      "slug": "chain-loop-edge",
      "term": "Chain-loop edging",
      "definition": "A border of evenly spaced chain loops, each joined to the edge with a slip stitch. A simple but visually effective finishing row."
    }
  ],
