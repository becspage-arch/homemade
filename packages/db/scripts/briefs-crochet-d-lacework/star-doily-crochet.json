    "content": [
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "The star grows by adding " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "point-increase-l45" } }], "text": "point increases" },
          { "type": "text", "text": " at 6 equally-spaced positions on every other round. " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "valley-chain-l45" } }], "text": "Valley chains" },
          { "type": "text", "text": " fill the dips between points." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            { "name": "Fingering weight yarn (white)", "qty": "70 m" },
            { "name": "3.5 mm crochet hook", "qty": "1" },
            { "name": "Tapestry needle", "qty": "1" }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Centre" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Magic ring. Round 1: ch 3, 11 tr into ring (12 tr). Join. Round 2: ch 5, *skip 1 tr, tr in next tr, ch 2; repeat around (6 ch-2 spaces)." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Star points (rounds 3 to 7)" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Round 3: work 5 tr into each ch-2 space, ch 2 between groups (point increases). Round 4: dc in each tr, ch 5 between groups (valley chains). Round 5: work 7 tr into each dc cluster. Round 6: dc row with ch 7 valleys. Round 7: 9 tr clusters at each point, ch 3 picots at the chain valleys and at each point tip." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Finishing" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Fasten off and weave in the end. Block by pinning each point out firmly and misting." }]
      }
    ]
  }
