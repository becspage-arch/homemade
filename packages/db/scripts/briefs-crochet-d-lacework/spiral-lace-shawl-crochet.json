  "glossaryTerms": [
    {
      "slug": "two-stitch-spine",
      "term": "Two-stitch spine",
      "definition": "Two dc worked side by side at the exact centre of each RS row. They form a raised vertical line down the middle of the triangle and create the left and right increase points."
    },
    {
      "slug": "spine-yos",
      "term": "Yarn-over increase",
      "definition": "A simple yarn-over placed immediately before and after the centre spine stitches. Each one adds a stitch and leaves a small decorative eyelet."
    },
    {
      "slug": "spiral-mesh-fill",
      "term": "Mesh infill",
      "definition": "The ch-1 skip-1 mesh worked on each side of the spine to fill the triangle. The mesh rows are plain; the increases happen only at the spine and the two outer edges."
    }
  ],
