  "glossaryTerms": [
    {
      "slug": "dc-mesh-l3",
      "term": "Dc mesh",
      "definition": "A lace fabric of double crochet stitches separated by chain spaces. Each dc sits above the dc of the previous row; the chain spaces form the open grid."
    },
    {
      "slug": "blocking-l3",
      "term": "Blocking",
      "definition": "Wetting and pinning the finished rectangle to its full dimensions on a blocking mat. The mesh opens fully to its grid pattern once dry."
    },
    {
      "slug": "reversible-l3",
      "term": "Reversible fabric",
      "definition": "A fabric that looks the same from both sides. The dc mesh is reversible because the chain spaces read as open grid from either face."
    }
  ],
