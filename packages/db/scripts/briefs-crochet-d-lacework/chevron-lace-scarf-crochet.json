                    ],
                    "text": "valley decrease"
                  },
                  {
                    "type": "text",
                    "text": ": skip 2 sts at the valley point"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
