        "content": [
          {
            "type": "text",
            "text": "A long scarf in a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "chevron-repeat"
                }
              }
            ],
            "text": "chevron lace repeat"
          },
          {
            "type": "text",
            "text": " that creates a pointed zigzag texture along the length. The "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "lace-increase"
                }
              }
            ],
            "text": "increases"
          },
          {
            "type": "text",
            "text": " at each peak and the "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "lace-decrease"
                }
              }
            ],
            "text": "decreases"
          },
          {
            "type": "text",
            "text": " at each valley keep the stitch count even across every row."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The repeat is 18 stitches wide, giving two full chevrons across the scarf. The zigzag also appears along the long edges, giving a naturally shaped border without any additional edging work."
          }
        ]
      },
      {
        "type": "heading",
