          {
            "type": "text",
            "text": "Body"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "In the main colour, chain 61. Work in a simple V-stitch repeat (as given for the Lace Neck Wrap) until the body measures 155 cm. Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Leaf motif (make 10)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "In the contrast colour, chain 12."
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Row 1 (spine): dc into the 2nd ch from hook. Dc across to the last ch. Work 3 dc into the last ch (tip). Rotate work, dc back along the other side of the foundation chain to the start. Do not turn."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Row 2 (increases): Ch 1. Work 2 dc into each st around the outer edge of the leaf, working 3 dc into the tip st. Sl st to join. Fasten off."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Joining the leaves"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Block all 10 leaves. Lay five leaves along one short end of the body, aligning their bases with the scarf edge. With the tapestry needle and main colour yarn, slip-stitch the base of each leaf to the scarf edge. Repeat at the other short end. Weave in all ends."
          }
        ]
      }
    ]
