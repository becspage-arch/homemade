            "text": "fan"
          },
          {
            "type": "text",
            "text": " over an 11-stitch "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "shell-repeat-l4"
                }
              }
            ],
            "text": "shell repeat"
          },
          {
            "type": "text",
            "text": ". The wide fans and the open chain spaces between them produce a generous "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "wingspan-l4"
                }
              }
            ],
            "text": "wingspan"
          },
          {
