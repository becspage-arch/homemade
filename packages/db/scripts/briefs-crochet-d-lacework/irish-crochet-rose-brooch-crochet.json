  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "The rose begins with a ring, then builds " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "inner-petal-l34" } }], "text": "inner petals" },
          { "type": "text", "text": " and " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "outer-petal-l34" } }], "text": "outer petals" },
          { "type": "text", "text": " in two separate rounds to give a layered look." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            { "name": "Lace weight yarn (pink or white)", "qty": "20 m" },
            { "name": "3.5 mm crochet hook", "qty": "1" },
            { "name": "Brooch pin back", "qty": "1" },
            { "name": "Tapestry needle", "qty": "1" }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Centre ring" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Chain 6, join with a slip stitch to ring. Round 1: ch 1, 10 dc in ring. Join." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Inner petals" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Round 2: ch 1, *dc in next dc, ch 3, dc in same dc; repeat from * 9 more times (10 small loops). Work 1 dc, 3 tr, 1 dc into each loop to form 10 inner petals." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Outer petals" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Round 3: working behind round 2, slip stitch into the back of each dc from round 1, *ch 5; repeat from * around (10 longer loops). Work 1 dc, 5 tr, 1 dc into each loop to form 10 outer petals." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Finishing" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Fasten off and weave in the ends. Sew the brooch pin back to the reverse of the rose using the tapestry needle and a strong thread." }]
      }
    ]
  }
