                        }
                      }
                    ],
                    "text": "cluster decrease"
                  },
                  {
                    "type": "text",
                    "text": ": [yarn over, insert, pull up loop, yarn over, draw through 2 loops] repeated, then draw through all loops"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
