          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "large-mesh-beach"
                }
              }
            ],
            "text": "large mesh"
          },
          {
            "type": "text",
            "text": " row until work measures 65 cm from foundation. Use a "
