              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "mesh-background"
                }
              }
            ],
            "text": "mesh"
          },
          {
            "type": "text",
            "text": ". The leaf border begins when the wingspan reaches 130 cm. Each "
