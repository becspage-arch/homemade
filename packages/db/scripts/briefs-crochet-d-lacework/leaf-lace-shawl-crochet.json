          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "leaf-motif-crochet"
                }
              }
            ],
            "text": "leaf motif"
          },
          {
            "type": "text",
            "text": " is 12 stitches wide and uses "
