      "slug": "leaf-motif-crochet",
      "term": "Leaf motif",
      "definition": "A worked shape of front-post trebles and chain loops that forms an outlined leaf. The leaf sits proud of the background mesh."
    },
    {
      "slug": "front-post-leaf",
      "term": "Front post treble",
      "definition": "A treble worked around the post of the stitch below rather than into the top loops. It stands forward from the fabric surface, creating the raised effect used in the leaf outline."
    },
    {
      "slug": "mesh-background",
      "term": "Mesh background",
      "definition": "The plain ch-1 skip-1 mesh that fills the triangle body. It acts as a neutral background that makes the leaf border read clearly."
    }
