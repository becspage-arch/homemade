        "content": [
          { "type": "text", "text": "Each butterfly has a " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "butterfly-wing-pair-l53" } }], "text": "wing pair" },
          { "type": "text", "text": " above and below a central body treble. " },
