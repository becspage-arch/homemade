    "advanced lace shawl crochet"
  ],
  "glossaryTerms": [
    {
      "slug": "shell-fan",
      "term": "Shell fan",
      "definition": "A large shell of seven or more trebles worked into a single stitch or chain space, spreading into a wide arc that dominates the lace fabric design."
    },
    {
      "slug": "picot-arch",
      "term": "Picot arch",
      "definition": "An arch of chains that includes a picot: a three-chain loop joined at its base with a slip stitch, adding a decorative point to the arch."
    },
    {
      "slug": "lace-border",
      "term": "Lace border",
      "definition": "A separately worked or attached edging of several rows, usually more detailed than the body pattern, that finishes the outer edge of a lace shawl."
    },
    {
      "slug": "blocking",
      "term": "Blocking",
      "definition": "Wet-blocking with pins to open fine lace to its full dimensions and set the fan and picot shapes permanently."
    },
    {
      "slug": "spine",
      "term": "Spine",
      "definition": "The central increase column running down the centre back of a top-down triangular shawl."
    }
  ],
