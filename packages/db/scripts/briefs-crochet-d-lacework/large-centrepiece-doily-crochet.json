      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "This doily uses a " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "multi-round-l52" } }], "text": "multi-round structure" },
          { "type": "text", "text": " with 8 pineapple sections alternating with treble fans. A " },
          { "type": "text", "marks": [{ "type": "glossaryTooltip", "attrs": { "termSlug": "border-accent-l52" } }], "text": "border accent" },
          { "type": "text", "text": " in the final round gives a defined edge." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            { "name": "Lace weight yarn (white or ecru)", "qty": "350 m" },
            { "name": "3.5 mm crochet hook", "qty": "1" },
            { "name": "Tapestry needle", "qty": "1" }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Rounds 1 to 4 (centre)" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Magic ring. Round 1: ch 3, 23 tr (24 tr). Round 2: ch 5, skip 2, tr; repeat around (8 ch-2 spaces). Rounds 3 to 4: work treble groups and chain arcs evenly around." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Rounds 5 to 12 (pineapple sections)" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Round 5: work 11 tr base fans for 8 pineapple sections. Rounds 6 to 11: decrease each pineapple by 1 tr each round, filling sides with chain arcs and treble fans. Round 12: pineapple tips with picots and treble fan accents between sections." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Rounds 13 to 15 (border)"}]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Work three outer rounds of increasing chain arcs and treble fans. Final round: chain 5, picot, chain 5 border accents around the edge." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Finishing" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Fasten off and weave in the end. Block by pinning to a large board and misting generously." }]
      }
    ]
  }
