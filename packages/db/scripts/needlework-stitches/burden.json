  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Bricked couching lays rows of thread across a shape and binds each row down with small stitches. On the first row, binding stitches sit at regular intervals. On the second row, the binding stitches are shifted half a spacing, so they sit between the bindings of the row above. The staggered pattern gives the fill its flat, even texture.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Laid thread",
              "value": "Perle cotton no. 5 or 2 strands of wool"
            },
            {
              "label": "Binding thread",
              "value": "Stranded cotton, 1 strand, matching"
            },
            {
              "label": "Fabric",
              "value": "Firmly woven cotton or linen"
            },
            {
              "label": "Needles",
              "value": "Large needle for laid thread, embroidery needle size 10 for binding"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Filling a shape",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Lay the first thread across the shape. Bind it down with stitches at regular intervals of about 5 mm.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Lay the second thread parallel and immediately below, leaving a small gap. Bind it with stitches shifted 2 to 3 mm to the side of the first row's binding stitches.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Continue: odd rows bind at the same positions, even rows at the half-shift position. Fill the shape row by row.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Check that each even-numbered row's stitches sit halfway between those of the odd-numbered row.",
              "cause": "Binding stitches not properly staggered.",
              "symptom": "Vertical lines appear in the fill"
            },
            {
              "fix": "Pack laid threads so they sit touching or very nearly touching.",
              "cause": "Too much space left between parallel laid threads.",
              "symptom": "Gaps show between rows"
            }
          ],
          "heading": "When bricked couching goes wrong"
