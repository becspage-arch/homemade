  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Heavy chain stitch does not enter the fabric on every stitch. After the first two links, each new stitch inserts the needle under the previous two loops (not into the fabric) and back into the fabric only at the needle exit point. The chain builds on top of itself, forming a raised plaited band.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Thread",
              "value": "Perle cotton no. 5 or 6 strands of stranded cotton"
            },
            {
              "label": "Fabric",
              "value": "Firmly woven cotton or linen"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Working the stitch",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Work the first two links as plain chain stitch to establish the base.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "For the third stitch: slide the needle under both previous links (not through the fabric) and re-insert into the fabric at the point where link 2 exited.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Bring the needle up one stitch-length ahead. Pull through gently so the new loop should lie flat on top of the previous links.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Continue, always passing under the two previous links before each new entry into the fabric.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Check the needle goes under both links before entering the fabric.",
              "cause": "Only passing under one previous link.",
              "symptom": "The band lies flat rather than raised"
            },
            {
              "fix": "Pull each stitch to a firm but not tight tension before starting the next.",
              "cause": "Thread tension too light.",
              "symptom": "The links are loose and floppy"
