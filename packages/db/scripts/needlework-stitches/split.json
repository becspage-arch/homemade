  "glossaryTerms": [
    {
      "slug": "split-point",
      "term": "Split point",
      "definition": "The midpoint of the previous stitch where the needle pierces the thread to divide it and lock the stitches together."
    }
  ],
  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Split stitch pierces the ",
            "type": "text"
          },
          {
            "text": "split point",
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "split-point"
                }
              }
            ]
          },
          {
            "text": " of the previous stitch with every new stitch. This locks the stitches together and creates a fine plaited chain effect. It lies flatter than stem stitch and is the preferred outline for Jacobean crewelwork shapes.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Thread",
              "value": "Stranded cotton, 2 strands (even number so the needle can split evenly)"
            },
            {
              "label": "Fabric",
              "value": "Linen or cotton muslin"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Working a practice line",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Bring the thread up at the start (A). Take a forward stitch the full stitch length to B. Pull through.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Bring the needle up at the midpoint of the first stitch, piercing directly through the thread strands.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Take the next forward stitch, then come up through the midpoint of that stitch. Continue along the line.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Keep the split point exactly at the thread centre. An off-centre split produces an uneven surface.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Use an even number of strands and pierce exactly through the middle of the bundle.",
              "cause": "The needle is splitting off-centre.",
              "symptom": "The plait is uneven"
            },
            {
              "fix": "The needle must go through the thread, not alongside it. You should feel slight resistance as the needle divides the strands.",
              "cause": "Not piercing the previous stitch, just surfacing beside it.",
              "symptom": "The line looks like stem stitch"
            }
          ],
          "heading": "When split stitch goes wrong"
