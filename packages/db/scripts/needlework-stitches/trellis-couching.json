            "text": "Uses and related stitches"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Trellis "
          },
          {
            "type": "text",
            "text": "couching",
            "marks": [
              {
                "type": "techniqueLink",
                "attrs": {
                  "techniqueSlug": "embroidery-couching-stitch",
                  "label": "couching"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " fills large shapes in Jacobean and crewelwork with an open decorative grid. It is much lighter than "
          },
          {
            "type": "text",
            "text": "satin",
            "marks": [
              {
                "type": "techniqueLink",
                "attrs": {
                  "techniqueSlug": "embroidery-satin-stitch",
                  "label": "satin"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and adds visual interest without hiding the fabric ground. Pattern couching varies the tying stitch to make the grid itself a design element."
          },
          {
            "type": "text",
            "text": " Working a small repeating shape with the tying stitches, instead of plain crosses, gives pattern couching, a patterned version of the same lattice."
          }
        ]
      }
    ]
