  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Trellis couching works in three stages: lay horizontal threads across the shape, lay vertical threads over them, then tie every intersection. The tying stitch is usually a small diagonal stitch or a cross stitch that pins the two grid threads together at each junction.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Laid threads",
              "value": "Perle cotton no. 8, or 2 strands of stranded cotton"
            },
            {
              "label": "Tying thread",
              "value": "Stranded cotton, 2 strands, contrasting colour for a decorative effect"
            },
            {
              "label": "Fabric",
              "value": "Firmly woven cotton or linen"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Laying the trellis",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Lay horizontal threads across the shape at even spacing of 4 to 6 mm, anchoring each thread at both edges.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Lay vertical threads over the horizontals at the same spacing, crossing at right angles.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Tie each crossing point: bring the needle up beside it, make one small cross stitch over the crossing, and go back into the fabric.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Work across all intersections in rows to keep them evenly placed.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Anchor each thread at the fabric edge before moving to the next. Do not pull tightly.",
              "cause": "Horizontal and vertical threads not kept at equal tension.",
              "symptom": "The grid buckles"
            },
            {
              "fix": "Work across each row from left to right before moving to the next row.",
              "cause": "Working in an irregular order across the intersections.",
              "symptom": "Tying stitches are uneven"
            }
          ],
          "heading": "When trellis couching goes wrong"
        }
      },
      {
        "type": "heading",
        "attrs": {
