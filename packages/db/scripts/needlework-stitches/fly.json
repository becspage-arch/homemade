  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Fly stitch begins like a wide chain loop: bring the thread up at the left of the V, insert the needle to the right at the same level, and bring it up at the centre below. The thread sits under the needle tip to form the V. One securing stitch at the centre holds it down.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Thread",
              "value": "Stranded cotton, 2 to 3 strands"
            },
            {
              "label": "Fabric",
              "value": "Cotton or linen"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Working the stitch",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Bring the needle up at A (left arm of the V).",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Insert the needle at B (right arm of the V), level with A, and bring it up at C (the base point), keeping the thread under the needle.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Pull through until the V lies flat. Make one straight securing stitch down from C to D. The length of CD sets the tail length.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Mark A and B with a light dot from a water-soluble pen before stitching.",
              "cause": "Points A and B are not level.",
              "symptom": "The V arms are unequal lengths"
            },
            {
              "fix": "Space A and B at least 6 mm apart for a clear V shape.",
              "cause": "Width between A and B is too narrow.",
              "symptom": "The stitch looks squat rather than open"
            }
          ],
          "heading": "When fly stitch goes wrong"
