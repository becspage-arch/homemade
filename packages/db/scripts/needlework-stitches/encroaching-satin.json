        "attrs": {
          "items": [
            {
              "label": "Thread",
              "value": "Stranded cotton 2 to 3 strands in two or three tonal shades"
            },
            {
              "label": "Fabric",
              "value": "Linen or closely woven cotton"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "20 cm embroidery hoop"
