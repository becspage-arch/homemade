  "glossaryTerms": [
    {
      "slug": "encroach",
      "term": "Encroach",
      "definition": "The action of bringing the new row of stitches slightly into the space occupied by the previous row. The new stitches overlap the base of the old ones rather than meeting at a hard edge."
    }
  ],
  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Encroaching satin stitch uses the ",
            "type": "text"
          },
          {
            "text": "encroach",
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "encroach"
                }
              }
            ]
          },
          {
            "text": " action to soften the join between rows. Each new row of parallel stitches starts 2 to 3 mm inside the previous row rather than beginning at its base. This overlapping placement blends the colours where the rows meet.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
