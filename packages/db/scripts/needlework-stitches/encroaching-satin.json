        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Work the first row of satin stitch along one edge of the shape in colour A.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Begin the second row in colour B, bringing the needle up 2 to 3 mm inside the first row. Each stitch goes down at the far edge of the shape.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Continue with colour C if needed, encroaching into the second row in the same way.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Keep all stitches running at the same angle throughout all rows.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
