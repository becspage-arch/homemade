  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Feather stitch is an open fly stitch alternated left and right. Each loop tilts to one side, is anchored at its tip, and the next loop starts from that securing stitch and tilts to the other side. The result is a chain of V-shapes that zigzags down a central line.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Thread",
              "value": "Stranded cotton, 2 to 3 strands"
            },
            {
              "label": "Fabric",
              "value": "Cotton or linen"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Working a practice column",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Draw a centre line. Bring the needle up on the line at the top.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Insert the needle to the right of the line and slightly lower, bring it up on the line below the insertion point, thread under needle. Pull through to form the right-leaning loop.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Now insert the needle to the left of the line and bring it up on the line again. Thread under needle. Pull through to form the left-leaning loop.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Continue alternating left and right down the line. Keep loop sizes and angles consistent.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Check the width of each loop against the centre line before moving on. Equal width on each side keeps the column straight.",
              "cause": "Loops on one side are larger than the other.",
              "symptom": "The column drifts to one side"
            },
            {
              "fix": "Work on drawn guide lines until the rhythm is established.",
              "cause": "Loops are varying sizes or the securing points are not on the centre line.",
              "symptom": "The stitch looks ragged"
            }
