{
  "slug": "embroidery-detached-chain-stitch",
  "title": "Detached chain",
  "subtitle": "A single isolated loop anchored by a small tacking stitch",
  "excerpt": "Detached chain is a single chain loop that sits by itself on the fabric, tethered at the tip by one small stitch, the building block for lazy daisy and leaf fills.",
  "type": "STITCH",
