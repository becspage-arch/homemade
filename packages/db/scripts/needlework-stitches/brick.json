  "glossaryTerms": [
    {
      "slug": "half-drop-offset",
      "term": "Half-drop offset",
      "definition": "The alternating alignment of each row of stitches, where the start of each row is set half a stitch length back from the one above. This creates the brick-like interlocking pattern."
    }
  ],
  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Brick stitch achieves its even coverage through a ",
            "type": "text"
          },
          {
            "text": "half-drop offset",
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "half-drop-offset"
                }
              }
            ]
          },
          {
            "text": " between rows. The first row sets the stitch length. Every subsequent row begins half a stitch length in from the row above, staggering the joins so they look like laid brickwork.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Thread",
              "value": "Stranded cotton 2 to 3 strands"
            },
            {
              "label": "Fabric",
              "value": "Linen or cotton"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "20 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Working a practice piece",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Work the first row of straight stitches across the top of the shape, spacing them evenly at the chosen stitch length.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Begin the second row half a stitch length in from the first stitch of row one. Work stitches of the same length.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Begin the third row aligned with the first row. Continue alternating the offset each row.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Bring each stitch up between the bases of the row above to keep the coverage solid.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "The needle for each row must emerge between the bases of the stitches above. If the row below has gaps at its base, the coverage will fail.",
              "cause": "The second row is starting at the wrong position.",
              "symptom": "Gaps appear between rows"
            },
            {
              "fix": "Mark the start points of each row on the fabric before stitching. A ruler and water-soluble pen make this fast.",
              "cause": "The half-drop offset is not being maintained consistently.",
              "symptom": "The staggered pattern is lost"
            }
          ],
          "heading": "When brick stitch goes wrong"
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Uses and related stitches"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Brick stitch is widely used as a background fill in crewelwork and canvas work. When worked in graduated colours from one row to the next, it gives a striped shaded effect similar to "
          },
          {
            "type": "text",
            "text": "long and short stitch",
            "marks": [
              {
                "type": "techniqueLink",
                "attrs": {
                  "techniqueSlug": "embroidery-long-and-short-stitch",
                  "label": "long and short stitch"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " but with harder colour breaks."
          }
        ]
      }
    ]
  }
