  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Double feather stitch follows the same logic as feather stitch, but the rhythm is two-two instead of one-one. Make two loops to the right, then cross to make two loops to the left, then two right again. Each pair of loops sits one below the other before the direction changes.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Thread",
              "value": "Stranded cotton, 2 to 3 strands"
            },
            {
              "label": "Fabric",
              "value": "Cotton or linen"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Working the stitch",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Draw three parallel vertical lines as guides: a left line, a centre line, and a right line. Bring the needle up at the top of the centre line.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Make one right-leaning loop from the right guide back to the centre, as in plain feather stitch.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Make a second right-leaning loop directly below the first, still from the right guide back to the centre.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Now cross to the left: make two left-leaning loops from the left guide back to the centre in the same way.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Continue the 2-right, 2-left rhythm down the column.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Count quietly as you stitch (right, right, left, left) and use the guide lines until the rhythm is automatic.",
              "cause": "Losing track of the two-two rhythm.",
              "symptom": "The column drifts sideways"
            },
            {
              "fix": "Space both loops of a pair equally before changing sides.",
              "cause": "First and second loop of each pair at different heights.",
              "symptom": "The pairs are uneven"
            }
          ],
          "heading": "When double feather goes wrong"
        }
      },
