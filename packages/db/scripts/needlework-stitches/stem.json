  "glossaryTerms": [
    {
      "slug": "transfer-line",
      "term": "Transfer line",
      "definition": "The drawn or traced line on the fabric that guides where the stitches go."
    },
    {
      "slug": "working-thread",
      "term": "Working thread",
      "definition": "The strand in the needle that you are actively stitching with."
    }
  ],
  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Stem stitch works along a ",
            "type": "text"
          },
          {
            "text": "transfer line",
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "transfer-line"
                }
              }
            ]
          },
          {
            "text": " with the ",
            "type": "text"
          },
          {
            "text": "working thread",
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "working-thread"
                }
              }
            ]
          },
          {
            "text": " kept consistently to one side of the needle. Each stitch overlaps the previous one by half its length, building a smooth twisted cord.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Thread",
              "value": "Stranded cotton, 2 strands for fine lines, 3 strands for bolder outlines"
            },
            {
              "label": "Fabric",
              "value": "Cotton muslin or linen"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Working a practice line",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Draw a curved line on your fabric with a water-soluble pen. Bring the needle up at the left end of the line (point A).",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Insert the needle a stitch-length ahead (point B) and bring it up halfway back at the midpoint (point C). Keep the thread below the needle.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Pull through. For the next stitch, insert a full stitch-length ahead of B and bring up at B.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Continue along the line, keeping the thread consistently on the same side of the needle throughout.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Choose above or below at the first stitch and hold it there consistently throughout.",
              "cause": "Thread is switching sides between stitches.",
              "symptom": "The line looks bumpy rather than smooth"
            },
            {
              "fix": "Shorten the stitch length on tight curves. Smaller stitches follow the curve more accurately.",
              "cause": "Stitch length too long for the curve radius.",
              "symptom": "Curves pull to one side"
            }
          ],
          "heading": "When stem stitch goes wrong"
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Uses and related stitches"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stem stitch is the primary outline stitch for floral embroidery, crewelwork stems, and monogram outlines. Its mirror twist, with the thread held above the needle, is "
          },
          {
            "type": "text",
            "text": "outline stitch",
            "marks": [
              {
                "type": "techniqueLink",
                "attrs": {
                  "techniqueSlug": "embroidery-outline-stitch",
                  "label": "outline stitch"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", and "
          },
          {
            "type": "text",
            "text": "split stitch",
            "marks": [
              {
                "type": "techniqueLink",
                "attrs": {
                  "techniqueSlug": "embroidery-split-stitch",
                  "label": "split stitch"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " gives a finer version of the same smooth line. Packed in rows side by side, stem stitch also works as a dense fill."
          }
        ]
      }
    ]
  }
}