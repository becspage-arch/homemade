  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Back stitch works by going backwards to share the ",
            "type": "text"
          },
          {
            "text": "stitch hole",
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "stitch-hole"
                }
              }
            ]
          },
          {
            "text": " of the previous stitch. The needle emerges ahead of the working position, then enters backwards to meet the end of the last stitch. The result is a continuous joined line with no gaps.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Thread",
              "value": "Stranded cotton, 2 strands"
            },
            {
              "label": "Fabric",
              "value": "Cotton muslin or linen"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Working a practice line",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Bring the needle up one stitch-length ahead of the start point (point B).",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Insert the needle back at the start point (point A) and bring it up one stitch-length ahead of B (point C).",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Insert back at B, come up at a new point ahead. Each stitch fills the gap left by the forward movement.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Keep all stitches the same length for a regular, even line.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Use the tip of the needle to locate the exact previous hole before inserting. Sharing the hole closes the gap.",
              "cause": "The needle is not entering exactly the previous stitch hole.",
              "symptom": "Small gaps appear between stitches"
            },
            {
              "fix": "Shorten each stitch on curves. Back stitch follows tight curves well when the stitches are small.",
              "cause": "Stitch length too long for the curve.",
              "symptom": "The line wavers on curves"
            }
          ],
          "heading": "When back stitch goes wrong"
        }
      },
