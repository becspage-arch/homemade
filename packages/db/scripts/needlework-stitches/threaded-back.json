  "glossaryTerms": [
    {
      "slug": "lacing-thread",
      "term": "Lacing thread",
      "definition": "The second thread woven through the foundation stitches from a blunt needle. It creates the decorative loops without entering the fabric surface."
    }
  ],
  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Threaded back stitch runs a ",
            "type": "text"
          },
          {
            "text": "lacing thread",
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "lacing-thread"
                }
              }
            ]
          },
          {
            "text": " alternately over and under the foundation back stitches. The lacing thread goes up through the space above one stitch, then down through the space below the next, producing regular loops on both sides of the line.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Foundation thread",
              "value": "Stranded cotton, 2 strands in colour A"
            },
            {
              "label": "Lacing thread",
              "value": "Stranded cotton or fine ribbon in colour B"
            },
            {
              "label": "Needles",
              "value": "Embroidery needle for foundation; blunt tapestry needle for lacing"
            },
            {
              "label": "Fabric",
              "value": "Linen or cotton muslin"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Working a practice piece",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Work a line of evenly spaced back stitch with colour A.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Thread the tapestry needle with colour B. Bring it up at the start of the line.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Slide the needle upward through the first back stitch gap, then downward through the second, alternating throughout.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Do not pull the lacing thread tight; allow small loops to form evenly above and below the line.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Work the foundation with very regular stitch length. Mark intervals on the transfer line first.",
              "cause": "The foundation back stitches are different lengths.",
              "symptom": "The loops are uneven in size"
            },
            {
              "fix": "Let the lacing thread lie loosely. It should loop freely above and below the foundation line without tension.",
              "cause": "The lacing is too tight.",
              "symptom": "The lacing thread pulls the foundation line out of shape"
            }
          ],
          "heading": "When threaded back stitch goes wrong"
