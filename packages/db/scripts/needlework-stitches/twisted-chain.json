  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Twisted chain differs from plain chain at one point: instead of inserting the needle inside the previous loop, you insert it just outside the loop but under the working thread. This small change crosses the base of each link, adding the twist that gives the line its rope texture.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "What you need",
            "type": "text"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "items": [
            {
              "label": "Thread",
              "value": "Stranded cotton, 3 to 4 strands"
            },
            {
              "label": "Fabric",
              "value": "Cotton or linen"
            },
            {
              "label": "Needle",
              "value": "Embroidery needle size 9"
            },
            {
              "label": "Hoop",
              "value": "15 cm embroidery hoop"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Working the stitch",
            "type": "text"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Bring the needle up at A. Hold the thread in a loop to the left.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Insert the needle just to the left of A (outside the loop) and bring it up at B, one stitch-length ahead. The working thread should pass under the needle tip.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Pull through. The base of the loop crosses over itself, forming the twist.",
                    "type": "text"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Continue: for each new stitch insert outside (to the side of) the previous loop tip, not inside it.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "Common mistakes",
            "type": "text"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "intro": "Two common problems.",
          "items": [
            {
              "fix": "Check each insertion point. Outside the loop = twisted chain. Inside = plain chain.",
              "cause": "Occasionally inserting inside the loop instead of outside.",
              "symptom": "Some links are twisted and some are not"
            },
            {
              "fix": "Keep the insertion just 1 to 2 mm to the side of the loop edge.",
              "cause": "Inserting too far to the side.",
              "symptom": "The line is too wide"
            }
          ],
          "heading": "When twisted chain goes wrong"
        }
      },
