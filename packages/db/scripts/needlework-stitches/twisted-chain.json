{
  "slug": "embroidery-twisted-chain-stitch",
  "title": "Twisted chain stitch",
  "subtitle": "A chain variation where each loop is crossed before anchoring",
  "excerpt": "Twisted chain crosses the working thread over the loop before inserting the needle, giving each link a twisted appearance that produces a ropelike line with more texture than plain chain.",
