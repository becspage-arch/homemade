        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oven to 200C. Toss sweet potato with 2 tbsp olive oil. Season. Spread on a baking tray." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast 30 minutes until tender and caramelised." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toast almonds in a dry pan for 2 minutes until golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make dressing: whisk balsamic, remaining oil, honey, and mustard. Season." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Arrange spinach on a large plate or platter. Top with sweet potato." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter feta, almonds, and mint over the top. Drizzle dressing over and serve." }] }] }
