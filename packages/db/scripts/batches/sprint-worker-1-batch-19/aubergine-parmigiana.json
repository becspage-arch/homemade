        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Salt aubergine slices. Leave in a colander 15 minutes. Pat dry." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oven to 190C." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Brush aubergine with oil. Cook in batches in a hot griddle pan or frying pan until golden, 2 minutes each side. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "For the sauce, cook garlic in 2 tbsp oil for 1 minute. Add tomato puree. Cook 1 minute. Add tinned tomatoes. Simmer 15 minutes until thick. Season." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spread a thin layer of tomato sauce in a baking dish. Add a layer of aubergine. Add more sauce, then mozzarella, parmesan, and basil. Repeat layers. Finish with sauce, parmesan, and a drizzle of oil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bake 35 to 40 minutes until bubbling and golden." }] }] }
        ]
