          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Combine all ingredients in a bowl. Work together with your hands for 2 minutes until the mixture is cohesive and sticky." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide into 16 equal portions. Shape each around a skewer into a sausage about 10cm long." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Chill for 30 minutes. This helps them hold their shape." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oven to 220C. Place kofta on a lightly oiled baking tray." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast 12 to 15 minutes, turning once, until cooked through and lightly charred." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve with flatbreads, greek yoghurt, and sliced tomatoes." }] }] }
