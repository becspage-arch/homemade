            { "ingredientSlug": "plain-flour", "amount": 60, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "eggs", "amount": 2, "unit": null, "prepNote": "beaten", "isOptional": false, "groupLabel": null },
