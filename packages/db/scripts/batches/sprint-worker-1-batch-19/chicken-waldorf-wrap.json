      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Poach chicken: put breasts in a saucepan. Cover with cold water. Bring to a gentle simmer. Cook 12 minutes. Turn off the heat. Leave in the water 5 minutes. Slice when cool enough to handle." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toast almonds in a dry pan until golden. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix yoghurt, mustard, and juice of half the lemon. Season well." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss chicken, apple, and celery in the dressing." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "If making flatbreads: combine bread flour with water and a pinch of salt to a soft dough. Divide into 4. Roll thin. Cook in a dry hot pan 2 minutes each side." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pile filling into flatbreads. Scatter almonds and chives over. Roll and serve." }] }] }
        ]
      },
