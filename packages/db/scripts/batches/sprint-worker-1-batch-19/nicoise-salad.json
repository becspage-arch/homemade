        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Boil potatoes in salted water until tender, about 12 minutes. Drain and cool slightly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Blanch green beans in boiling water for 3 minutes. Drain and cool under cold water." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Hard-boil eggs: 10 minutes in boiling water. Cool in cold water. Peel and halve." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "For the dressing, whisk vinegar, mustard, and oil together. Season well." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Arrange potatoes, beans, cherry tomatoes, olives, and anchovies on a large platter." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add tuna and eggs. Scatter capers over. Drizzle dressing over everything." }] }] }
