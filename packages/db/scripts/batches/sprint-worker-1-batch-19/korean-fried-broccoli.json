        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix plain flour, cornflour, and milk to a smooth batter. Season." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the glaze: combine gochujang, honey, soy sauce, rice vinegar, garlic, ginger, and sesame oil in a small saucepan. Heat gently for 2 minutes until combined. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat sunflower oil in a deep pot to 180C. Test with a small drop of batter: it should sizzle immediately." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Dip broccoli florets in batter. Fry in batches for 3 to 4 minutes until golden and crisp. Do not crowd the pot." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drain on kitchen paper." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss hot broccoli in the glaze immediately. Serve right away." }] }] }
