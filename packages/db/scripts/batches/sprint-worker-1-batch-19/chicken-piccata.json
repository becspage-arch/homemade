        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Flatten chicken between cling film to 1cm. Dust both sides in flour." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oil in a large frying pan over high heat. Add chicken. Cook 3 minutes each side until golden. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce heat to medium. Add half the butter. Let it foam." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the stock and the juice of 2 lemons. Scrape up any bits from the pan. Simmer 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add capers and remaining butter. Stir until the sauce thickens slightly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return chicken to the pan. Coat in the sauce. Scatter parsley over and serve with lemon wedges." }] }] }
        ]
