        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Dust chicken in flour. Shake off excess." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt half the butter in a large frying pan over high heat. Cook chicken 3 minutes each side until golden. Remove." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce heat to medium. Add remaining butter. Add mushrooms and thyme. Cook 5 minutes until soft and beginning to colour." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add garlic. Cook 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in vinegar. Let it bubble for 1 minute. Add stock. Simmer 3 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in cream. Simmer 2 minutes until the sauce coats a spoon." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return chicken to the pan. Coat in the sauce. Serve immediately." }] }] }
        ]
