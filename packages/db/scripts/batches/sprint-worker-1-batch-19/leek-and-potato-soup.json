        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt butter in a large pot over low heat. Add leek, onion, and garlic. Cook gently for 10 minutes until soft. Do not let them colour." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add potato and stock. Bring to the boil. Reduce heat and simmer 20 minutes until potato is completely tender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Blend until smooth. Return to the pot." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season well. Stir in cream if using. Heat through gently." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve with chives scattered over and crusty bread on the side." }] }] }
