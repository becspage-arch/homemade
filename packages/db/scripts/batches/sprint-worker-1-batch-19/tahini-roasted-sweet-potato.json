        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oven to 200C. Toss sweet potato with olive oil, cumin, chilli flakes, and seasoning. Spread on a baking tray." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast 30 minutes until tender and caramelised, turning once halfway." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the tahini sauce: whisk tahini, juice of both lemons, garlic, and 4 tbsp water until smooth and pourable. Season." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Arrange sweet potato on a serving plate. Drizzle tahini sauce over." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter pomegranate seeds and parsley over the top. Serve warm." }] }] }
