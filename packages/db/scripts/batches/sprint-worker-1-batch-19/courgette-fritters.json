      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Grate courgette. Put in a clean tea towel. Squeeze out as much water as you can. This step matters." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Combine squeezed courgette, eggs, feta, flour, mint, garlic, and chilli flakes in a bowl. Season well. Mix to combine." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oil in a frying pan over medium heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drop heaped tablespoons of batter into the pan. Flatten lightly. Cook 3 minutes until golden underneath." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Flip and cook 2 more minutes. Repeat with remaining batter." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve hot with cool greek yoghurt." }] }] }
        ]
