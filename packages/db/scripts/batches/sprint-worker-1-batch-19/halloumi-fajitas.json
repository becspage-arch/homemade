        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix cumin, paprika, chilli flakes, garlic, and 2 tbsp oil. Add halloumi and peppers. Toss to coat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Get a large frying pan very hot over high heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook halloumi in one layer for 2 minutes each side until deeply golden. Remove." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add onion and peppers to the same pan. Cook 5 minutes, tossing, until charred at the edges." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return halloumi to the pan. Squeeze over one lime. Toss everything together." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve in warm flatbreads with soured cream, coriander, and lime wedges." }] }] }
