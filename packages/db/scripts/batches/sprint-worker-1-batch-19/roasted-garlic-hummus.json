      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat oven to 200C. Cut the top off the garlic head to expose the cloves. Drizzle with oil. Wrap in foil. Roast 30 minutes until completely soft and golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Squeeze roasted garlic out of the skins." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add chickpeas, tahini, juice of all 3 lemons, roasted garlic, and 2 tbsp olive oil to a blender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Blend for 2 minutes, adding 4 to 6 tbsp of the reserved chickpea liquid until smooth. The longer you blend, the creamier it gets." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season well. Transfer to a serving bowl." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drizzle remaining olive oil over. Scatter paprika and a pinch of cumin on top." }] }] }
        ]
