        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the pasta in well-salted boiling water until al dente. Drain and keep 200ml of pasta water." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While pasta cooks, heat the oil in the frying pan over medium-high heat. Add pancetta and cook for 5 minutes until golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the mushrooms. Cook without stirring for 3 minutes, then stir and cook for 2 more minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and thyme. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the cream and 100ml of pasta water. Simmer for 3 minutes until slightly thickened." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cooked pasta and toss. Add more pasta water as needed to loosen the sauce. Serve with parmesan." }] }] }
