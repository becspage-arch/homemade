      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat half the butter in the frying pan over high heat. Add the chicken strips in a single layer. Cook for 3 to 4 minutes without stirring until golden. Flip and cook 1 minute more. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the remaining butter. Fry the mushrooms over high heat for 4 minutes until golden. Add the onion and cook for 3 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, paprika, and Worcestershire sauce. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the chicken to the pan. Stir in the Dijon mustard." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Turn the heat to low. Add the soured cream and stir gently. Do not let it boil. Warm through for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter over the parsley and serve with rice or egg noodles." }] }] }
        ]
      },
