            { "ingredientSlug": "greek-yoghurt", "amount": 200, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": "Dressing" },
            { "ingredientSlug": "honey", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Dressing" },
