      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place the chicken breasts in the saucepan. Cover with cold water. Bring to a very gentle simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover and cook on the lowest heat for 15 to 18 minutes until the chicken is cooked through. The water should barely move." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the chicken and leave to cool for 10 minutes. Pull into rough pieces with two forks." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the yoghurt, honey, lime juice and zest, grated ginger, cumin, turmeric, coriander, and chilli flakes in a large bowl." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chicken and fold through the dressing. Taste and adjust with more lime or honey." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter over the fresh coriander and toasted almonds to serve." }] }] }
        ]
      },
