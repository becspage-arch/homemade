      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the pasta in well-salted boiling water until al dente. Drain, keeping 200ml pasta water." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in the frying pan over medium heat. Add the garlic and chilli flakes. Cook for 1 minute until the garlic is pale golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cherry tomatoes. Cook for 3 minutes until they start to collapse." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Turn the heat to high. Add the prawns. Cook for 2 to 3 minutes, turning once, until pink and just cooked." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the white wine vinegar. Let it bubble for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pasta to the pan. Toss with a splash of pasta water. Add the parsley and toss again. Serve straight away." }] }] }
