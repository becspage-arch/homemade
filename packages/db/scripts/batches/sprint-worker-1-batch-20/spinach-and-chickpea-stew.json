      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in the saucepan over medium heat. Cook the onion for 8 minutes until soft and golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, cumin, paprika, coriander, and chilli flakes. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tomato puree. Stir and cook for 1 minute. Add the tinned tomatoes and 200ml water." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chickpeas. Simmer for 15 minutes. Use the back of a spoon to crush about a quarter of the chickpeas against the side of the pan." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the spinach in big handfuls, stirring between each addition. Cook for 3 minutes until fully wilted." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Squeeze in the lemon juice. Taste and adjust seasoning. Scatter over the parsley and serve." }] }] }
        ]
