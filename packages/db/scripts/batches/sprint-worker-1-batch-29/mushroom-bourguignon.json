      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the butter and oil in a large pot over a high heat."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Brown the mushrooms in two or three batches until golden on all sides. Remove and set aside."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reduce the heat. Add the onion and carrot. Cook for 8 minutes until softened."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic and tomato puree. Cook for 2 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pour in the red wine vinegar. Stir and let it bubble for 2 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the stock, thyme, and bay leaves. Return the mushrooms to the pot."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Simmer for 20 minutes. Stir in the cornflour mixture. Cook for 3 more minutes until glossy. Serve with parsley."}]}]}
        ]
      },
