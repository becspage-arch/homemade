      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the olive oil in a large frying pan over a medium heat."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the onion and pepper. Cook for 8 minutes until soft."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, chilli, cumin, paprika, and coriander. Cook for 1 minute."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pour in the tomatoes. Simmer for 10 minutes until the sauce thickens. Season well."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Make 8 small wells in the sauce with the back of a spoon."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Crack an egg into each well. Cover the pan and cook for 5 to 7 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Remove when the whites are set but the yolks are still soft. Scatter with feta and fresh coriander."}]}]}
        ]
      },
      {
        "type": "heading",
