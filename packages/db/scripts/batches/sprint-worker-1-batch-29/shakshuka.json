            {"ingredientSlug": "tinned-tomatoes", "amount": 800, "unit": "g", "prepNote": "2 x 400g tins", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "onion", "amount": 1, "unit": "whole", "prepNote": "finely diced", "isOptional": false, "groupLabel": null},
