      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rinse the lentils and cook them in boiling water for 20 minutes until just tender. Drain and set aside."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the ghee in a large pot over a medium heat. Add the cumin seeds and let them sizzle for 30 seconds."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the onion and cook for 10 minutes until deep golden."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, ginger, coriander, garam masala, and chilli flakes. Cook for 2 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the tomato puree and tinned tomatoes. Stir and cook for 10 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the lentils, kidney beans, and 300ml of water. Stir to combine."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Simmer on a very low heat for 30 minutes, stirring often. Stir in the cream, season, and serve."}]}]}
        ]
      },
