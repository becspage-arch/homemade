        "type": "paragraph",
        "content": [{"type": "text", "text": "Focaccia needs a long proof to develop its open, chewy crumb. Most of the time is hands-off."}]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "What you need"}]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 1,
          "items": [
            {"ingredientSlug": "bread-flour", "amount": 500, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "olive-oil", "amount": 80, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "rosemary", "amount": 5, "unit": "sprigs", "prepNote": "leaves picked", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "garlic", "amount": 4, "unit": "cloves", "prepNote": "sliced", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "honey", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null}
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mix the flour with 7g of fast-action dried yeast, 1 tsp of salt, and the honey."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add 350ml of warm water and half the olive oil. Mix to a rough dough."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Knead for 8 minutes until smooth, or use a stand mixer on medium for 5 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cover and leave to rise for 1 hour until doubled in size."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pour the remaining olive oil into a large roasting tin. Press the dough into the tin."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scatter over the garlic and rosemary. Press deep dimples all over with your fingertips."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rest for 30 minutes, then bake at 220C for 22 to 25 minutes until golden. Season with sea salt flakes straight from the oven."}]}]}
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
