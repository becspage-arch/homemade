      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the olive oil in a large pot over a medium heat."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the onion, carrot, and celery. Cook for 10 minutes until soft."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, rosemary, and thyme. Cook for 1 minute."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the tomatoes and cook for 5 minutes, breaking them up with a spoon."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the beans and stock. Bring to a simmer."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mash a third of the beans roughly against the side of the pot to thicken the soup."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the kale and simmer for 15 minutes until tender. Season well and serve with a drizzle of olive oil."}]}]}
        ]
