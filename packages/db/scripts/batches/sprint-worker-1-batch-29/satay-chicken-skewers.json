        "type": "paragraph",
        "content": [{"type": "text", "text": "The marinade here does double duty as the dipping sauce. Mix it all together, divide it, and the hard work is done."}]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "What you need"}]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {"ingredientSlug": "chicken-breast", "amount": 700, "unit": "g", "prepNote": "cut into strips", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "peanut-butter", "amount": 4, "unit": "tbsp", "prepNote": "use half in the marinade and half in the dipping sauce", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "coconut-milk", "amount": 200, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "soy-sauce-light", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null},
