      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mix together the coconut milk, soy sauce, lime juice, honey, garlic, ginger, chilli flakes, and turmeric."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir in all 4 tablespoons of peanut butter until smooth."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pour half the mixture over the chicken strips. Toss to coat, then cover and chill for 30 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reserve the other half as a dipping sauce. Set aside."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oven to 220C. Thread the chicken onto metal or soaked wooden skewers."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Place over a roasting tin and cook for 12 to 15 minutes until cooked through and slightly charred."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Serve with the reserved dipping sauce and lime wedges."}]}]}
        ]
      },
