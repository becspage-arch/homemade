    "content": [
      {
        "type": "paragraph",
        "content": [{"type": "text", "text": "Cheese scones are fast and satisfying to make. Handle the dough as little as possible for the lightest result."}]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "What you need"}]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 1,
          "items": [
            {"ingredientSlug": "self-raising-flour", "amount": 225, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "unsalted-butter", "amount": 60, "unit": "g", "prepNote": "cold, cubed", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "cheddar", "amount": 100, "unit": "g", "prepNote": "grated. Use 80g in the dough and 20g to scatter on top", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "whole-milk", "amount": 120, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "eggs", "amount": 1, "unit": "whole", "prepNote": "beaten, for glazing", "isOptional": false, "groupLabel": null}
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oven to 220C. Lightly flour a baking tray."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rub the cold butter into the flour until the mixture resembles fine breadcrumbs."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir in 80g of the cheddar and a pinch of salt."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the milk gradually, mixing with a knife until a soft dough comes together."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pat the dough out to 3cm thick on a lightly floured surface. Cut out rounds with a 6cm cutter."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Place on the tray. Brush the tops with beaten egg and scatter over the remaining cheddar."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bake for 12 to 15 minutes until risen and deep golden. Cool briefly and eat warm."}]}]}
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {"symptom": "Scones are not rising.", "cause": "Dough was overworked or oven not hot enough.", "fix": "Handle dough minimally and ensure the oven is fully preheated."},
            {"symptom": "Scones are too dense.", "cause": "Too much milk or dough pressed too flat.", "fix": "Add milk gradually and keep the dough at least 3cm thick."},
            {"symptom": "Scones are spreading sideways.", "cause": "Dough too wet.", "fix": "Reduce milk by 1 tbsp next time."}
