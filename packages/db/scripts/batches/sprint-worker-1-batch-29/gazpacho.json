          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Place the tomatoes, cucumber, and pepper in a blender."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, vinegar, olive oil, and lemon juice."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Blend on high for 2 minutes until very smooth."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Taste and season well with salt and black pepper."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Transfer to a jug or container and refrigerate for at least 1 hour until thoroughly chilled."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir before serving. Pour into bowls and drizzle with a little extra olive oil."}]}]}
