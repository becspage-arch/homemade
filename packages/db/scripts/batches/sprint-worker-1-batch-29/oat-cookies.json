        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oven to 170C. Line two baking trays with baking paper."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Melt the butter and honey together in a small pan over a low heat. Allow to cool for 5 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mix the oats and flour in a large bowl."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the melted butter mixture and the egg. Stir until fully combined."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scoop tablespoon-sized rounds onto the trays, spaced well apart."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Flatten each round slightly with the back of a spoon."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bake for 10 to 12 minutes until golden at the edges. Cool on the tray before moving."}]}]}
        ]
