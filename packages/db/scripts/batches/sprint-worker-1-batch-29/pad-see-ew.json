        "type": "paragraph",
        "content": [{"type": "text", "text": "Pad see ew is a stir-fry that needs a very hot wok. Work fast and do not overcrowd the pan."}]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "What you need"}]
