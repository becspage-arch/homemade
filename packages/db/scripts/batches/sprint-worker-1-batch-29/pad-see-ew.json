        "attrs": {
          "items": [
            {"symptom": "Noodles are sticking together in clumps.", "cause": "Not soaked long enough or wok not hot enough.", "fix": "Soak noodles fully and ensure the wok is smoking before adding them."},
            {"symptom": "Dish lacks colour.", "cause": "Not enough dark soy or heat too low.", "fix": "Add an extra tablespoon of dark soy and increase the heat."},
            {"symptom": "Chicken is dry.", "cause": "Overcooked or cut too thick.", "fix": "Slice thinner next time and cook for 2 minutes only."}
