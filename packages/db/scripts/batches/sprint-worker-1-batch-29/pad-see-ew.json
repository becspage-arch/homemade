        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {"ingredientSlug": "noodles-rice", "amount": 400, "unit": "g", "prepNote": "wide, soaked in cold water for 30 minutes if dried", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "chicken-breast", "amount": 400, "unit": "g", "prepNote": "sliced thin", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "eggs", "amount": 2, "unit": "whole", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "pak-choi", "amount": 2, "unit": "heads", "prepNote": "halved lengthways", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "garlic", "amount": 5, "unit": "cloves", "prepNote": "sliced", "isOptional": false, "groupLabel": null},
