    "content": [
      {
        "type": "paragraph",
        "content": [{"type": "text", "text": "Moussaka is built in three layers: aubergine, spiced lamb, and bechamel. Each layer needs to be made properly before assembly."}]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "What you need"}]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {"ingredientSlug": "lamb-mince", "amount": 700, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "aubergine", "amount": 2, "unit": "whole", "prepNote": "sliced into 1cm rounds", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "onion", "amount": 1, "unit": "whole", "prepNote": "diced", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "garlic", "amount": 5, "unit": "cloves", "prepNote": "crushed", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "tinned-tomatoes", "amount": 400, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
