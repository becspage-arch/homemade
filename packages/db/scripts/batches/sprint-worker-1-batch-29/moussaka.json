      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oven to 200C. Brush the aubergine slices with oil and roast on a tray for 20 minutes until tender. Set aside."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fry the lamb mince in a dry pan over a high heat until browned. Remove and set aside."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "In the same pan, cook the onion for 5 minutes. Add the garlic, cinnamon, and allspice."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Return the lamb. Add the tomato puree and tomatoes. Simmer for 15 minutes until thick."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Make the bechamel: melt the butter, add the flour, then gradually whisk in the milk over a medium heat until thick. Stir in the eggs and half the parmesan."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Layer the aubergine, then the lamb sauce, then pour the bechamel over the top."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scatter the remaining parmesan on top and bake for 30 minutes until golden. Rest for 15 minutes before cutting."}]}]}
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {"symptom": "Bechamel has lumps.", "cause": "Milk added too fast.", "fix": "Whisk vigorously off the heat, then return and stir until smooth."},
            {"symptom": "Moussaka is falling apart when cut.", "cause": "Not rested long enough.", "fix": "Leave to rest for at least 15 minutes before serving."},
            {"symptom": "Topping is browning too quickly.", "cause": "Oven shelf too high.", "fix": "Move to the middle shelf and cover loosely with foil."}
          ]
        }
      }
    ]
