      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Season the chicken breasts and dust lightly with flour on both sides."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the olive oil in a large frying pan over a high heat until shimmering."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cook the chicken for 3 to 4 minutes each side until golden and cooked through. Remove and keep warm."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Turn the heat to medium. Add the stock and lemon juice. Scrape up any bits from the base."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Simmer for 3 minutes until the sauce reduces slightly."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Take the pan off the heat. Add the cold butter and swirl until melted."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir in the capers and parsley. Pour the sauce over the chicken and serve."}]}]}
        ]
      },
