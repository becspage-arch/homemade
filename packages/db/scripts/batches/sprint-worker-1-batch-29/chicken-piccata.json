      {
        "type": "paragraph",
        "content": [{"type": "text", "text": "Piccata is a fast weeknight dish once the chicken is flattened. A hot pan and cold butter in the sauce are the two tricks."}]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "What you need"}]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {"ingredientSlug": "chicken-breast", "amount": 4, "unit": "whole", "prepNote": "flattened to about 1cm thick", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "plain-flour", "amount": 3, "unit": "tbsp", "prepNote": "for dusting", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "unsalted-butter", "amount": 60, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "olive-oil", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "lemon", "amount": 2, "unit": "whole", "prepNote": "juice only", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "capers", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "parsley-flat", "amount": 30, "unit": "g", "prepNote": "roughly chopped", "isOptional": false, "groupLabel": null},
