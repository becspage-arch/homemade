    "content": [
      {
        "type": "paragraph",
        "content": [{"type": "text", "text": "The yoghurt dough takes five minutes to make. Start the onions first so they are ready when the flatbreads come out of the pan."}]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "What you need"}]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 1,
          "items": [
            {"ingredientSlug": "self-raising-flour", "amount": 300, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "greek-yoghurt", "amount": 200, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "cheddar", "amount": 150, "unit": "g", "prepNote": "grated", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "onion", "amount": 2, "unit": "whole", "prepNote": "peeled and sliced thin", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "unsalted-butter", "amount": 30, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "thyme-fresh", "amount": 3, "unit": "sprigs", "prepNote": "leaves picked", "isOptional": false, "groupLabel": null}
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Melt the butter in a frying pan over a low heat. Add the onion and thyme leaves."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cook slowly for 20 to 25 minutes, stirring often, until deep golden and soft. Remove from the pan and set aside."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "While the onions cook, mix the flour and yoghurt into a soft dough. Season with salt."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Divide into 4 pieces. Roll each one out thinly on a floured surface."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the pan to a medium-high heat. Cook each flatbread for 2 to 3 minutes each side until golden with dark spots."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scatter cheddar over each flatbread while still warm so it melts."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Top with the caramelised onions and serve at once."}]}]}
        ]
      },
