        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oven to 200C."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Toss the chicken thighs in the olive oil and paprika. Season well."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Arrange the chicken in a large roasting tin."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scatter the chorizo, peppers, cherry tomatoes, and garlic around the chicken."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Tuck the thyme sprigs in among everything."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Roast for 35 to 40 minutes until the chicken is cooked through and the skin is golden."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Squeeze the roasted garlic out of its skin and stir through the juices before serving."}]}]}
