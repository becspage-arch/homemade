          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bring the stock to a simmer in a large pot."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the kaffir lime leaves, ginger, and chilli. Simmer for 5 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the mushrooms and cook for 3 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Drop in the prawns and cook for 2 to 3 minutes until pink and cooked through."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir in the fish sauce, palm sugar, and lime juice."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Taste and adjust the balance of sour, salty, and sweet. Serve topped with coriander and spring onion."}]}]}
