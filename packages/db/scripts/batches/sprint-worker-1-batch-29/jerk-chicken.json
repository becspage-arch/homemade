      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Put the ginger, garlic, and spring onion in a food processor. Blitz to a rough paste."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the allspice, cinnamon, chilli flakes, soy sauce, lime juice, and honey. Blitz again until combined."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Score the chicken thighs a few times with a knife."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Coat the chicken thoroughly in the marinade. Cover and refrigerate for at least 1 hour."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oven to 220C. Arrange the chicken in a roasting tin."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Roast for 25 to 30 minutes until charred at the edges and cooked through."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rest for 5 minutes before serving with rice and lime wedges."}]}]}
        ]
