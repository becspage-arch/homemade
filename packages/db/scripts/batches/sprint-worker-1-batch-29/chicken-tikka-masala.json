      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mix the chicken chunks with the yoghurt, 1 tsp garam masala, and turmeric. Cover and chill for at least 1 hour."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the ghee in a large pan over a high heat. Fry the chicken in batches until charred in spots. Remove and set aside."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reduce the heat to medium. Add the onion and cook for 8 minutes until soft and golden."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, ginger, cumin, paprika, and remaining 2 tsp garam masala. Cook for 2 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir in the tomato puree and tinned tomatoes. Simmer for 10 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Return the chicken to the pan. Pour in the cream and stir."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Simmer gently for 10 minutes. Season and serve with rice and fresh coriander."}]}]}
        ]
      },
