      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Melt the butter with the olive oil in a large stockpot over a low heat."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the onions, thyme, and bay leaves. Season well with salt."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cook over a low heat for 40 to 50 minutes, stirring every 5 minutes, until the onions are deep golden brown."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pour in the white wine vinegar. Stir and cook for 2 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the stock and bring to a simmer. Cook for 10 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Remove the thyme sprigs and bay leaves. Taste and adjust seasoning."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ladle into bowls and scatter parmesan and cheddar generously over the top. Serve at once."}]}]}
        ]
      },
