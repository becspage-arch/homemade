            {"ingredientSlug": "stock-beef", "amount": 1200, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "parmesan", "amount": 80, "unit": "g", "prepNote": "finely grated, to serve", "isOptional": false, "groupLabel": null},
