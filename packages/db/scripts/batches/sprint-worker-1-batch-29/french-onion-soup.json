      {
        "type": "paragraph",
        "content": [{"type": "text", "text": "French onion soup is all about patience with the onions. Cook them low and slow until they turn deep golden and sweet."}]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "What you need"}]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {"ingredientSlug": "onion", "amount": 1500, "unit": "g", "prepNote": "peeled and sliced thin", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "unsalted-butter", "amount": 60, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "olive-oil", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "thyme-fresh", "amount": 4, "unit": "sprigs", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "bay-leaves", "amount": 2, "unit": "leaves", "prepNote": null, "isOptional": false, "groupLabel": null},
