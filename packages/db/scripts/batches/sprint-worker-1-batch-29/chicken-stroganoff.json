      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Melt the butter in a large frying pan over a high heat."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fry the chicken strips in batches until golden on all sides. Remove from the pan and set aside."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the onion to the pan. Cook over a medium heat for 5 minutes."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, mushrooms, and paprika. Cook for 5 minutes until the mushrooms are golden."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Return the chicken to the pan. Stir in the mustard."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Turn off the heat. Stir in the soured cream gently until fully combined."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Season and serve at once, scattered with parsley."}]}]}
        ]
