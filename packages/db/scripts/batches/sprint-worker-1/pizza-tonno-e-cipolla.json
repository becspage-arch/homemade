      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the dough and preheat"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the dough: mix flour, salt, yeast, cold water, and olive oil. Knead 8 to 10 minutes. Divide into 4 balls and cold-prove 24 to 48 hours, or prove at room temperature for 2 hours. Preheat the pizza stone at 250°C fan for 45 to 60 minutes."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Shape and top"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll or stretch each dough ball to a 28 to 30 cm round. Transfer to baking paper. Spread a thin layer of seasoned tomato sauce and add sliced mozzarella."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Break the drained tuna over the pizza in rough pieces. Arrange the red onion slices over the top. Add capers if using. Drizzle with olive oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slide onto the hot stone and bake for 7 to 10 minutes until the base is crisp and the onion edges are catching colour. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Troubleshooting"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Tuna is dry and crumbly after baking",
              "cause": "Tuna in brine used instead of tuna in oil, or overbaked",
              "fix": "Use tuna in olive oil. Do not bake beyond 10 minutes: the tuna only needs to warm through, not cook further."
            },
            {
              "symptom": "Onion is bitter and raw-tasting",
              "cause": "Raw red onion sliced too thick",
              "fix": "Slice the onion very thin. If the onion flavour is too sharp, marinate the slices in a little olive oil and a pinch of salt for 20 minutes before topping."
            },
            {
              "symptom": "Pizza is wet under the tuna",
              "cause": "Tuna not drained properly before use",
              "fix": "Drain the tuna thoroughly and press gently between sheets of paper before breaking it over the pizza."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pizza tonno e cipolla is a southern Italian home pizza. It is the kind made on a weeknight from cupboard ingredients. It is less showy than prosciutto e rucola but good and filling. In southern Italian pizzerie it is a standard menu item."
          }
        ]
      }
    ]
  }
