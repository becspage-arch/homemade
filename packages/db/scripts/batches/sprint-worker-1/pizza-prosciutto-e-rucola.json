      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Dough and preheat"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make the dough (flour, water, yeast, salt, olive oil), knead 8 to 10 minutes, divide into 4 balls, and cold-prove for 24 to 48 hours in the fridge."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place pizza stone in the oven and preheat to 250°C fan for 45 to 60 minutes."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Shape, bake, and finish"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Roll or stretch one dough ball to a 28 to 30 cm round on a floured surface. Transfer to baking paper. Spread a thin layer of seasoned tomato sauce and add sliced mozzarella."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slide the pizza onto the hot stone and bake for 7 to 10 minutes until golden and crisp."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Immediately remove the pizza and lay the Parma ham slices over the hot surface. Toss the rocket with a drizzle of olive oil and a pinch of salt and pile loosely over the ham. Add Parmigiano shavings if using. Serve at once: the rocket will just begin to wilt from the heat of the pizza below."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Troubleshooting"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Ham is dry and chewy after baking",
              "cause": "Ham was placed on the pizza before it went into the oven",
              "fix": "Ham must always go on after baking. It only needs the residual heat of the hot pizza to warm through."
            },
            {
              "symptom": "Rocket collapses immediately into the hot pizza",
              "cause": "Rocket placed directly on the pizza surface without the ham layer beneath",
              "fix": "Place the ham first to create a barrier between the hot surface and the rocket. Add the rocket on top of the ham so it only warms slightly rather than wilting fully."
            },
            {
              "symptom": "Base is pale and soft",
              "cause": "Stone not preheated long enough",
              "fix": "Preheat the stone for a full 45 to 60 minutes. The stone must be fully saturated with heat to give a crisp base."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pizza prosciutto e rucola is one of the most ordered pizzas in Italian restaurants. Its appeal is the contrast of hot crisp pizza with cold ham and peppery rocket. It became fashionable in the 1990s in northern Italian cities and spread internationally from there."
          }
        ]
      }
    ]
  }
