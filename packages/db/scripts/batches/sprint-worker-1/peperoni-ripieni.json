      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Prepare the filling"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Par-cook the rice in boiling salted water for 8 minutes: it should still be very al dente, not soft. Drain and cool."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the par-cooked rice with the tomatoes, garlic, basil, parsley, Parmigiano, and 3 tablespoons of the olive oil. Season generously."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Fill and bake"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Heat the oven to 190°C fan. Stand the peppers upright in a baking dish. Fill each with the rice mixture, pressing down to pack well. The rice will expand further as it finishes cooking."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drizzle the remaining olive oil over the peppers. Pour 200 ml of water into the base of the baking dish: this creates steam and keeps the peppers from drying out. Replace the pepper tops as lids."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bake for 50 to 55 minutes until the peppers are very soft and slightly charred at the edges. Rest for 10 minutes. Serve with any juice from the dish spooned over."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Troubleshooting"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Rice is still hard after baking",
              "cause": "Rice was under-par-cooked, or the dish didn't have enough moisture",
              "fix": "Ensure the rice is par-cooked for a full 8 minutes. Add more water to the dish base if it dries out during baking and cover with foil for the last 15 minutes."
            },
            {
              "symptom": "Peppers are soft but the filling seems dry",
              "cause": "Lid was not replaced during baking, or oven was too high",
              "fix": "The pepper lids keep moisture inside each pepper. If the filling dried out, add a spoon of water to each pepper and return to the oven for 10 minutes."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Stuffed peppers appear across Italy with different fillings. In Piedmont they are filled with anchovies and breadcrumbs. In Campania and the south, rice-based fillings are common. In Sicily the filling often includes pine nuts and raisins in the sweet-and-sour tradition. This recipe uses the southern rice-and-herb version."
          }
        ]
      }
    ]
  }
