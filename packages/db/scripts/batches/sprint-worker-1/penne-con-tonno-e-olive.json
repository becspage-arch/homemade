      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the sauce"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Warm the olive oil in a wide pan over medium heat. Cook the garlic for 1 to 2 minutes until pale gold. Add the chilli flakes if using. Add the tomatoes, crush with a spoon, and simmer for 10 minutes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add the olives and capers. Simmer for another 3 to 4 minutes. Add the drained tuna, breaking it into rough flakes. Cook for 1 minute just to warm through. Taste and season: it will probably need very little salt given the olives, capers, and tuna."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Cook pasta and finish"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cook penne in well-salted boiling water until 1 minute short of al dente. Reserve a cup of pasta water, then drain. Toss the penne into the sauce with a splash of pasta water over high heat for 1 to 2 minutes. Add the chopped parsley and serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Troubleshooting"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Tuna is dry and crumbly in the sauce",
              "cause": "The tuna was added too early and overcooked in the hot sauce",
              "fix": "Add the tuna at the very end, off or barely on the heat, and toss briefly. It only needs warming through."
            },
            {
              "symptom": "Sauce is too salty",
              "cause": "Olives, capers, and tinned tuna all carry salt: they compound quickly",
              "fix": "Rinse the capers well. Use unsalted pasta water. Taste before adding any extra salt."
            },
            {
              "symptom": "Flavour is thin and acidic",
              "cause": "Tomatoes were not reduced enough before adding other ingredients",
              "fix": "Simmer the tomato for a full 10 minutes before adding olives and capers. Reducing concentrates the flavour and takes the edge off the acidity."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pasta con tonno is Italian storecupboard cooking. Tuna in olive oil is a pantry staple in Italy in a way it is not in British kitchens. This partly explains why the dish is such a standard weeknight meal in Italy. The Sicilian version adds capers and olives. The Roman version uses a simpler tomato and garlic base."
          }
        ]
      }
    ]
  }
