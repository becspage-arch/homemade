      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the dough"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Mix the flour, salt, and yeast. Add the cold water and olive oil, mix to a rough dough, then knead for 8 to 10 minutes until smooth. Divide into 4 balls. Cover and refrigerate for 24 to 48 hours, or prove at room temperature for 2 hours."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Preheat and top"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place the pizza stone in the oven and preheat to 250°C fan for 45 to 60 minutes. Briefly sauté the mushrooms in olive oil for 3 to 4 minutes to remove some moisture. Season and cool."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "On a well-floured surface, roll or stretch a dough ball to a 28 to 30 cm round. Transfer to baking paper. Spread a thin layer of tomato sauce and arrange the mozzarella over the base. Arrange the four toppings in sections: artichokes in one quarter, ham in another, mushrooms in a third, olives in the fourth. Drizzle with olive oil."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Slide the pizza onto the hot stone and bake for 7 to 10 minutes until the base is crisp and the mozzarella is melted and spotted. Repeat with remaining pizzas."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Troubleshooting"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Mushrooms make the pizza wet",
              "cause": "Raw mushrooms release a lot of water during baking",
              "fix": "Always pre-cook the mushrooms in a hot pan for 3 to 4 minutes to remove moisture before topping the pizza."
            },
            {
              "symptom": "Artichokes taste metallic",
              "cause": "Tinned artichokes not drained properly",
              "fix": "Drain, pat dry, and season with a little olive oil and salt before adding to the pizza."
            },
            {
              "symptom": "Pizza slides off the stone or tears during transfer",
              "cause": "Dough was stretched too thin or not transferred on paper",
              "fix": "Always use baking paper as a transfer medium. Build the pizza on the paper, then slide paper and pizza onto the stone together. The paper can be removed after 2 minutes with tongs."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Where this dish lives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Pizza capricciosa has been a standard Italian pizzeria pizza since the mid-20th century. Its four toppings: artichoke, ham, mushroom, and olive: reflect the Italian idea of pizza as a platform for varied flavours. The toppings are arranged in quarters, each in its own section rather than mixed together."
          }
        ]
      }
    ]
