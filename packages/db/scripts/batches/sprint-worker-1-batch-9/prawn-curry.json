        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a wide frying pan over medium heat. Add the onions and cook for 10 minutes until golden. Add the garlic and ginger and cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the turmeric, cumin, ground coriander, chilli flakes, and tomato puree. Cook for 1 minute. Add the tinned tomatoes and cook on medium heat for 10 minutes until the sauce is thick and the oil begins to separate at the edges." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the prawns to the sauce and cook for 3 to 4 minutes, stirring gently, until they are pink and just cooked through. Stir in the garam masala." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season to taste, scatter over fresh coriander, and serve with lemon wedges and rice." }] }]
          }
        ]
