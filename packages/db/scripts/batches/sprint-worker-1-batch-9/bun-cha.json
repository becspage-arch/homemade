        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the pork mince with 1 tablespoon of fish sauce, half the garlic, and a pinch of pepper. Shape into small flat patties about 3 cm wide." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the broth: mix 150 ml of warm water with the remaining fish sauce, honey, rice vinegar, lime juice, remaining garlic, and sliced chilli. Taste and adjust." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a little oil in the frying pan over medium-high heat. Fry the pork patties for 3 to 4 minutes per side until well browned and cooked through. Work in batches if needed." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place the cooked pork patties in a shallow bowl or deep plate and pour the broth over them. Serve the cold noodles, julienned vegetables, and fresh herbs separately for everyone to help themselves." }] }]
          }
        ]
      },
