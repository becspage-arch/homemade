      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a large saucepan over medium heat. When hot, add the mustard seeds and cumin seeds. Cook for 30 seconds until they begin to splutter. Add the onion and cook for 8 minutes until soft." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and ginger and cook for 2 minutes. Add the turmeric, ground coriander, and chilli flakes. Stir for 1 minute. Add the tinned tomatoes and cook for 8 minutes until the sauce thickens and the oil separates slightly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the coconut milk, stir to combine, and bring to a gentle simmer. Season with salt." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cod pieces and cook at a very gentle simmer for 6 to 8 minutes until the fish is just cooked through. Do not stir vigorously or the cod will break apart." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter over fresh coriander and serve with lime wedges and rice." }] }]
          }
        ]
      },
