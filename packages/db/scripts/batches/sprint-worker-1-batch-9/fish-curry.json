            { "symptom": "Fish has fallen apart", "cause": "Curry was boiling too fast or stirred too much", "fix": "Keep heat very low once fish is added and do not stir." },
            { "symptom": "Sauce is too thin", "cause": "Tinned tomatoes were not reduced enough", "fix": "Cook the tomato base for 10 minutes before adding coconut milk." },
            { "symptom": "Curry tastes flat", "cause": "Spices were not bloomed in oil", "fix": "Fry the spices in oil until fragrant before adding the onion." }
