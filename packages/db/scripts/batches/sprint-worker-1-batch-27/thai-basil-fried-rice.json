          "items": [
            { "symptom": "Rice is clumping and steaming.", "cause": "Wok was not hot enough or rice was freshly cooked.", "fix": "Use the highest heat and always use cold day-old rice." },
            { "symptom": "Basil has turned dark and bitter.", "cause": "Added too early over high heat.", "fix": "Add the basil off the heat right at the end." },
            { "symptom": "Dish is too salty.", "cause": "Sauces are all high in sodium.", "fix": "Reduce the fish sauce and taste before adding more." }
