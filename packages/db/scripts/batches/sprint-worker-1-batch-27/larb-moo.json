        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the lime juice, fish sauce, palm sugar, chilli flakes and rice vinegar in a bowl until the sugar dissolves. Taste and adjust." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the pork mince in a dry frying pan over high heat for 5 to 6 minutes, breaking it up as it cooks." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from the heat. Pour the dressing over the pork and toss to combine." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the spring onion, coriander, mint and Thai basil. Toss quickly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve immediately with steamed jasmine rice or in lettuce cups." }] }] }
