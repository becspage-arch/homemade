      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the garlic in the food processor. Blitz briefly to chop." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tahini and lemon juice. Blitz for 1 minute until pale and thick." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chickpeas, lemon zest, cumin and a large pinch of salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Blitz for 2 to 3 minutes, scraping down the sides halfway through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "With the motor running, add the olive oil, then 2 to 4 tablespoons of the reserved chickpea liquid until the hummus is smooth and creamy." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste and adjust the salt and lemon." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve in a bowl with a drizzle of olive oil and a pinch of paprika if you like." }] }] }
        ]
