        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "chickpeas-tinned", "amount": 400, "unit": "g", "prepNote": "drained, liquid reserved", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "tahini", "amount": 4, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 2, "unit": "cloves", "prepNote": "roughly chopped", "isOptional": false, "groupLabel": null },
