      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pat the beef dry with kitchen paper. Season it well with salt and pepper." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat 2 tablespoons of oil in the stockpot over high heat. Brown the beef in batches, 2 to 3 minutes per side. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the remaining oil, then the onion, carrot and celery. Cook for 8 minutes until softened." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and tomato puree. Cook for 2 minutes, stirring." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the red wine vinegar. Let it bubble for 1 minute, scraping the bottom of the pot." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the beef to the pot. Add the stock, worcestershire sauce, thyme and bay leaves." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to the boil, then reduce to a very low simmer. Put a lid on and cook for 1 hour." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the mushrooms. Cook uncovered for a further 30 minutes until the beef is tender and the sauce has thickened." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the bay leaves and thyme stalks. Taste and adjust the seasoning." }] }] }
        ]
      },
