            { "symptom": "Beef is tough after 2 hours.", "cause": "Chuck needs more time at a low temperature.", "fix": "Continue cooking on low for another 30 minutes." },
            { "symptom": "Sauce is too thin.", "cause": "Too much liquid or lid was on the whole time.", "fix": "Simmer uncovered for 15 minutes to reduce." },
            { "symptom": "Stew tastes too sharp.", "cause": "Red wine vinegar needs time to mellow.", "fix": "Add a teaspoon of honey to balance the acidity." }
