          "items": [
            { "ingredientSlug": "chickpeas-tinned", "amount": 800, "unit": "g", "prepNote": "drained and rinsed (2 x 400g tins)", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "olive-oil", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cumin-ground", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "paprika-smoked", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
