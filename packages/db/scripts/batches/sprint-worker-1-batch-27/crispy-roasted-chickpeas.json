        "content": [{ "type": "text", "text": "Dry the chickpeas as well as you can before roasting. Moisture is the enemy of crispiness." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
