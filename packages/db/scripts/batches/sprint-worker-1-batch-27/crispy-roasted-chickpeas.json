          "items": [
            { "symptom": "Chickpeas are chewy, not crispy.", "cause": "They were not dry enough before going into the oven.", "fix": "Pat dry thoroughly and leave uncovered for 10 minutes before roasting." },
            { "symptom": "Chickpeas burned.", "cause": "Oven was too hot or cooked too long.", "fix": "Check at 25 minutes and reduce heat slightly if they look dark." },
            { "symptom": "Spices burned and tasted bitter.", "cause": "Spices were added before roasting.", "fix": "Always add the spices after the tin comes out of the oven." }
