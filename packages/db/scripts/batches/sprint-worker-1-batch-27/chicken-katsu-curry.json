        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Breadcrumbs are falling off.", "cause": "The coating was not pressed firmly or the egg was thin.", "fix": "Press panko firmly onto each piece and shake off excess flour." },
            { "symptom": "Chicken is golden outside but raw inside.", "cause": "Heat was too high and the outside cooked too fast.", "fix": "Reduce heat to medium and cook for 2 more minutes per side." },
            { "symptom": "Sauce is gritty.", "cause": "Not blended long enough.", "fix": "Blend for a full 60 seconds, then pass through a sieve." }
