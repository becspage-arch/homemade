      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the stock, onion, garlic, thyme and bay leaf in the stockpot. Bring to a simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chicken breasts. Poach gently for 15 to 18 minutes until cooked through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the chicken and set aside to cool slightly. Remove the onion, bay leaf and thyme stalks." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the carrot and celery to the broth. Simmer for 8 minutes until just tender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Shred the chicken into bite-sized pieces using two forks." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the noodles to the broth. Cook for 3 to 4 minutes until just tender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the shredded chicken to the pot. Taste and season with salt and pepper." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve in deep bowls, scattered with the parsley." }] }] }
        ]
      },
