      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the lamb with 100ml of yoghurt and a teaspoon of salt. Cover and chill for 30 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt the ghee in the stockpot over medium-high heat. Add the onions and cook for 12 minutes until deep golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and ginger. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the paprika, cumin, coriander, cardamom, cinnamon and cloves. Stir for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Increase the heat. Add the marinated lamb in batches and brown for 3 to 4 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes. Stir and bring to a simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover and cook on low heat for 1 hour until the lamb is very tender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the remaining yoghurt. Simmer for 5 minutes. Taste and season." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve with rice and scatter with coriander." }] }] }
        ]
      },
