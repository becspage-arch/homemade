        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in the stockpot over a medium heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion and green pepper. Cook for 8 minutes until softened." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic. Cook for 1 minute, stirring often." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the spices and stir for 30 seconds until fragrant." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Tip in the tinned tomatoes. Cook for 3 minutes, stirring, until the mixture thickens slightly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the black beans and vegetable stock. Bring to the boil, then reduce to a steady simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Simmer uncovered for 20 minutes until the soup has thickened." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Use a ladle to scoop out roughly a third of the soup. Blend it until smooth, then stir back in." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Squeeze in the lime juice. Taste and season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Ladle into bowls. Top with coriander and a spoonful of soured cream." }] }] }
        ]
