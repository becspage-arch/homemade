      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the spaghetti in a large pot of well-salted boiling water until al dente. Reserve a mug of pasta water before draining." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the pasta cooks, heat 2 tablespoons of olive oil in the frying pan over a medium heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the breadcrumbs and toast for 4 to 5 minutes, stirring often, until golden. Season with salt. Tip onto a plate." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the remaining olive oil to the pan over a low heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and cook gently for 2 minutes until just golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the anchovies and chilli flakes. Stir for 2 minutes until the anchovies have melted into the oil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the drained pasta and a good splash of pasta water. Toss vigorously." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the parsley, lemon zest, and lemon juice. Toss again." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve immediately, scattered with the toasted breadcrumbs." }] }] }
        ]
      },
