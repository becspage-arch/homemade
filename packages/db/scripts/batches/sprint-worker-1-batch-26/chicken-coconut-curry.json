            { "symptom": "Curry sauce has split and looks oily.", "cause": "Coconut milk boiled too vigorously.", "fix": "Reduce heat immediately and stir; add a splash of water." },
            { "symptom": "Curry is not spicy enough.", "cause": "Curry paste strength varies by brand.", "fix": "Stir in an extra tablespoon of paste and simmer for 5 minutes." },
            { "symptom": "Pak choi is overcooked and yellow.", "cause": "Added too early or cooked too long.", "fix": "Add leafy greens in the last 3 to 4 minutes only." }
