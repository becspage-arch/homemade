          "items": [
            { "symptom": "Pilaf is stodgy and wet.", "cause": "Too much liquid or insufficient resting time.", "fix": "Rest for longer with the cloth; excess steam escapes through the cloth." },
            { "symptom": "Onions are still pale after 20 minutes.", "cause": "Heat was too low and the pan may be too wide.", "fix": "Raise heat slightly; they should sizzle gently." },
            { "symptom": "Bulgur is catching on the base.", "cause": "Heat too high during covered cooking.", "fix": "Use the lowest setting and check at 10 minutes." }
          ]
