            { "ingredientSlug": "bulgur-wheat", "amount": 250, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 3, "unit": "large", "prepNote": "thinly sliced into half-moons", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "unsalted-butter", "amount": 40, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "tomato-puree", "amount": 1, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cumin-ground", "amount": 0.5, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cinnamon-ground", "amount": 0.25, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
