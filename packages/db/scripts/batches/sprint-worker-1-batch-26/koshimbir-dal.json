            { "symptom": "Dal is too thick.", "cause": "Lentils absorb liquid as they sit.", "fix": "Stir in boiling water a ladleful at a time." },
            { "symptom": "Tadka spices are burning.", "cause": "Ghee was too hot before adding spices.", "fix": "Start fresh with lower heat; cumin seeds should sizzle, not blacken." },
            { "symptom": "Dal tastes dull after freezing.", "cause": "Flavours mute in the freezer.", "fix": "Reheat gently, then make a fresh small tadka to pour over." }
