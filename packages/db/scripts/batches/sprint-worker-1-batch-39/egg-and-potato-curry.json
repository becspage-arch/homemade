    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [{"type": "text", "text": "Egg and potato curry is a simple stovetop dish built from everyday ingredients. Score the eggs before adding them so the gravy soaks in. The gravy should be thick and well spiced, not watery."}]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "What you need"}]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {"ingredientSlug": "eggs", "amount": 6, "unit": "each", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "potato", "amount": 400, "unit": "g", "prepNote": "peeled and cut into 3 cm chunks", "isOptional": false, "groupLabel": null},
