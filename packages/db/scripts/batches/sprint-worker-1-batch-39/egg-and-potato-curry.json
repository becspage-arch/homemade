      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Boil the eggs for 10 minutes. Drain and place in cold water. Peel when cool. Score each egg with 4 shallow cuts all the way around."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Parboil the potato chunks in salted water for 8 minutes until just starting to soften. Drain and set aside."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oil in the large saucepan over a medium-high heat. Add the cumin seeds and fry for 20 seconds. Add the onions and cook for 10 minutes until golden."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic and ginger. Stir for 1 minute. Add the turmeric, coriander, cumin, chilli powder, and salt. Stir for 30 seconds."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the tinned tomatoes and water. Bring to a simmer and cook for 8 minutes, breaking up the tomatoes, until the oil starts to separate at the edges."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the parboiled potatoes. Stir gently to coat. Simmer for 5 minutes until the potato is tender and the sauce has thickened."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the whole eggs. Stir gently so the gravy gets into the scored cuts. Add the garam masala. Simmer for 3 minutes. Scatter with coriander and serve."}]}]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The potato is falling apart.",
              "cause": "It was parboiled for too long before going into the sauce.",
              "fix": "Reduce the parboil time to 5 minutes next time. The potato continues to cook in the gravy."
            },
            {
              "symptom": "The sauce is very thin.",
              "cause": "The tomatoes were not reduced enough.",
              "fix": "Cook the sauce uncovered for a further 5 minutes on a medium heat until it thickens and the oil separates."
            },
            {
              "symptom": "The eggs have a grey ring around the yolk.",
              "cause": "They were overcooked or not cooled quickly enough.",
              "fix": "Boil for exactly 10 minutes and transfer straight to cold water. Peel once cool."
            }
          ]
        }
      }
    ]
  }
