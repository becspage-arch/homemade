      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mix all the marinade ingredients together in a bowl. Add the chicken, coat well, and cover. Chill for at least 1 hour, or overnight."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oil in the large saucepan over a medium heat. Add the onions and cook for 10 minutes until soft and golden."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic and ginger for the sauce. Cook for 2 minutes. Add the ground spices and stir for 1 minute."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pour in the tinned tomatoes and 100 ml water. Simmer for 15 minutes until the onions are completely soft. Leave to cool slightly, then blend until smooth."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Meanwhile, heat the frying pan over a high heat. Cook the marinated chicken in a single layer for 4 minutes each side until charred at the edges and cooked through."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Return the blended sauce to the pan over a low heat. Stir in the butter and cream. Add the ground almonds if using to thicken."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the cooked chicken to the sauce. Simmer gently for 10 minutes. Taste, adjust salt, and scatter with coriander to serve."}]}]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The sauce is too thin.",
              "cause": "The tomatoes were watery or the sauce was not reduced enough.",
              "fix": "Stir in 2 tablespoons of ground almonds and simmer uncovered for 5 minutes to thicken."
            },
            {
              "symptom": "The sauce tastes sour.",
              "cause": "The tomatoes were too acidic.",
              "fix": "Stir in a teaspoon of honey or a pinch of sugar and simmer for 2 minutes to balance."
            },
            {
              "symptom": "The cream has curdled.",
              "cause": "The heat was too high when the cream was added.",
              "fix": "Lower the heat right down before adding the cream, and pour it in slowly while stirring."
            }
          ]
        }
      }
