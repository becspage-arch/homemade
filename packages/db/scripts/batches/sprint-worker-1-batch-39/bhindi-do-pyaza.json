      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Make sure the okra is completely dry before you start. Any moisture will make it slimy. Pat with a clean tea towel if needed."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat 2 tablespoons of the oil in the frying pan over a high heat. Add the okra in a single layer. Fry for 6 to 8 minutes, stirring often, until the edges are golden and dry."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Remove the okra from the pan and set aside. Do not cover it."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the remaining oil to the pan. Add the cumin seeds and let them sizzle. Add the 2 sliced onions and cook for 8 minutes until golden."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic and ginger. Stir for 1 minute. Add the turmeric, coriander, chilli powder, and salt. Cook for 30 seconds."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the tomatoes and cook for 3 minutes until they soften. Add the onion wedges and stir for 2 minutes."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Return the okra to the pan. Sprinkle over the garam masala and amchur if using. Toss gently and cook for 2 minutes. Serve immediately with coriander if using."}]}]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The okra is slimy all the way through.",
              "cause": "The okra was wet before cooking, or the pan was not hot enough.",
              "fix": "Spread the pieces in a single layer on a baking tray and roast at 200C for 10 minutes to drive off the slime before adding to the sauce."
            },
            {
              "symptom": "The okra is falling apart.",
              "cause": "It was stirred too much during the initial frying.",
              "fix": "Turn the pieces gently with tongs rather than stirring, and do not cook for longer than 8 minutes at the initial fry stage."
            },
            {
              "symptom": "The dish tastes flat.",
              "cause": "Okra needs a sour note to lift it.",
              "fix": "Stir in half a teaspoon of amchur or a small squeeze of lemon just before serving."
            }
          ]
        }
      }
    ]
  }
