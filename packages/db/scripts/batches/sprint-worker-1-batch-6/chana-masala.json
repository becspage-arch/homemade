      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the sunflower oil in a large saucepan over medium-high heat. Add the cumin seeds and let them sizzle for 30 seconds. Add the onion and cook for 8 minutes, stirring occasionally, until golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger, tomato puree, coriander-ground, cumin-ground, turmeric, and chilli flakes. Stir and cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the tinned tomatoes and 150 ml of water. Simmer for 8 minutes until the sauce thickens." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the drained chickpeas. Stir well, cover, and simmer for 10 minutes until the chickpeas are heated through and have absorbed some of the sauce." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the lid, stir in the garam masala and lemon juice. Taste and adjust seasoning with salt. Scatter the fresh coriander over the top before serving." }] }] }
        ]
      },
