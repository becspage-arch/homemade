        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a large saucepan over a medium-high heat. Add the cumin seeds. Fry for 30 seconds until they start to pop." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion. Cook for 6 to 8 minutes, stirring, until soft and golden at the edges." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and ginger. Stir for 1 minute. Add the turmeric, ground coriander, garam masala, and chilli flakes. Stir for another minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the tinned tomatoes and coconut milk. Season with salt. Simmer for 10 minutes until the sauce has thickened slightly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the prawns. Cook for 3 to 4 minutes until they are pink all the way through. Do not overcook. Scatter over the coriander and serve with lime wedges." }] }]
          }
        ]
      },
