      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season the chicken legs well. Heat the oil in a large pot over a medium-high heat. Brown the legs on all sides for about 8 minutes. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the onion, carrot, and celery to the same pot. Cook for 8 minutes, stirring, until softened." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the 4 crushed garlic cloves. Cook for 1 minute. Pour in the diluted vinegar and let it bubble for 2 minutes, scraping the base of the pot." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes and chicken stock. Tuck in the thyme and bay leaves. Return the chicken to the pot. The liquid should come halfway up the chicken." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover and cook on a low heat for 60 minutes. The chicken should be very tender and pulling away from the bone. Remove the lid for the last 10 minutes to reduce the sauce." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the finely minced garlic with the chopped parsley and lemon zest to make the gremolata. Scatter over just before serving." }] }]
          }
        ]
      },
      {
        "type": "heading",
