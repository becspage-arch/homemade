      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a wide pan over a medium heat. Add the onion and red pepper. Cook for 8 minutes until softened." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, sweet paprika, and smoked paprika. Stir for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the tinned tomatoes. Season with salt. Simmer for 10 minutes until the sauce has thickened." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the olives and capers. Nestle the cod fillets into the sauce. They should sit mostly submerged." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover with a lid. Cook on a low heat for 8 to 10 minutes. The fish is ready when it flakes easily and is opaque all the way through. Scatter with parsley and serve." }] }]
          }
        ]
      },
      {
        "type": "heading",
