  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Saltimbocca means 'jumps in the mouth' in Italian. The pancetta crisps against the chicken and the sage adds a savoury depth. Flatten the chicken breasts first so they cook evenly." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "chicken-breast", "amount": 4, "unit": "whole", "prepNote": "flattened to about 1cm thickness", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "sage", "amount": 12, "unit": "leaves", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "pancetta", "amount": 80, "unit": "g", "prepNote": "thinly sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "plain-flour", "amount": 40, "unit": "g", "prepNote": "for dusting", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "unsalted-butter", "amount": 60, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "olive-oil", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "white-wine-vinegar", "amount": 100, "unit": "ml", "prepNote": "diluted with 100ml water to mellow the sharpness", "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place each chicken breast between two sheets of baking paper. Bash with a rolling pin until about 1cm thick." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lay 3 sage leaves on each breast. Drape the pancetta slices over the top. Secure with a wooden toothpick." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Dust the plain side of each piece lightly with flour. Shake off the excess." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the butter and oil in a frying pan over a medium-high heat. Place the chicken pancetta-side down. Cook for 4 minutes until the pancetta is crisp." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Flip and cook the other side for 4 to 5 minutes until cooked through. Remove to a plate and rest for 5 minutes. Pour the diluted vinegar into the pan and bubble for 1 minute to make a quick sauce. Spoon over the chicken." }] }]
          }
        ]
      },
      {
        "type": "heading",
