      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a large pan over a high heat. Add the lamb mince. Break it up with a spoon and fry for 5 minutes until browned all over. Tip into a bowl and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the onion, carrot, and celery. Cook for 8 minutes until softened." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and tomato puree. Stir for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the mince to the pan. Add the stock, Worcestershire sauce, rosemary, and thyme. Simmer without a lid for 30 minutes until the sauce is thick. Stir occasionally." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the filling simmers, boil the potatoes for 15 to 20 minutes until tender. Drain well. Mash with the butter and warm milk until smooth. Season with salt." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 190C. Pour the filling into a large baking dish. Let it cool for 10 minutes. Spoon the mash over the top and spread evenly. Scatter with cheddar if using." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bake for 30 minutes until the mash is golden and the filling is bubbling around the edges. Rest for 10 minutes before serving." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Filling is watery under the mash",
              "cause": "Not reduced enough before topping",
              "fix": "Simmer filling without a lid until thick before topping."
            },
            {
              "symptom": "Mash is sinking into the filling",
              "cause": "Filling was still very hot when mash was added",
              "fix": "Cool the filling for 10 minutes before adding mash."
            }
          ]
        }
      }
    ]
