      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a saucepan over a medium heat. Add the onion. Cook for 6 minutes until soft. Add the garlic and cook for another minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tomato puree and smoked paprika. Stir for 1 minute until the paste is well coated in the oil." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes, beans, Worcestershire sauce, and honey. Season with salt. Stir gently to combine without breaking the beans." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Simmer on a low heat for 15 minutes until the sauce has thickened. Toast the bread. Serve the beans piled on top." }] }]
          }
        ]
      },
