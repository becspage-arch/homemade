  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "The marinade does two jobs: it flavours the fish and forms a sticky glaze in the pan. A short 30-minute soak is enough. Any longer and the soy starts to cure the flesh." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "salmon-fillet", "amount": 4, "unit": "whole", "prepNote": "about 150g each, skin on", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "soy-sauce-light", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "mirin", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "honey", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "sake", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "sesame-oil", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "ginger-fresh", "amount": 2, "unit": "cm", "prepNote": "grated", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "spring-onion", "amount": 3, "unit": "whole", "prepNote": "finely sliced, to serve", "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the soy sauce, mirin, honey, sake, sesame oil, and grated ginger together in a shallow dish." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the salmon fillets and turn to coat. Leave to marinate in the fridge for 30 minutes. Remove the fish and keep the remaining marinade." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a dry frying pan over a medium-high heat until very hot. There is no need to add oil as the marinade provides enough." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place the salmon skin-side down. Cook for 4 minutes without moving it. The skin should crisp up and release from the pan." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Flip the salmon. Spoon over some of the remaining marinade. Cook for 3 to 4 more minutes until the fish is cooked through and the glaze is sticky. Scatter with spring onion and serve." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Skin is sticking to the pan",
              "cause": "Pan was not hot enough before adding the fish",
              "fix": "Wait until the pan is very hot before adding fish."
            },
            {
              "symptom": "Glaze is burning",
              "cause": "Too much heat with the honey in the marinade",
              "fix": "Lower the heat and keep a close eye on it."
            }
          ]
        }
      }
    ]
