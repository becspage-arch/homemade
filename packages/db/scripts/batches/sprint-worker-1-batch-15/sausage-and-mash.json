  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "This is a dish where timing matters. Get the onions cooking low and slow first as they need the most time. The sausages and mash can happen around them." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "chorizo", "amount": 8, "unit": "whole", "prepNote": "use pork sausages for this dish", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "potato", "amount": 1000, "unit": "g", "prepNote": "peeled and cut into chunks", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 3, "unit": "whole", "prepNote": "finely sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "unsalted-butter", "amount": 60, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "whole-milk", "amount": 100, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "stock-beef", "amount": 400, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "worcestershire-sauce", "amount": 1, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "plain-flour", "amount": 2, "unit": "tbsp", "prepNote": "for the gravy", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "thyme-fresh", "amount": 3, "unit": "sprigs", "prepNote": null, "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt half the butter in a pan over a low heat. Add the onions and thyme. Cook very slowly for 20 minutes, stirring occasionally, until they are soft, sweet, and golden." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Meanwhile, fry the sausages in a separate pan over a medium heat for 15 to 20 minutes, turning, until browned all over and cooked through." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the potato chunks in a pan of cold salted water. Bring to the boil and cook for 15 to 20 minutes until tender." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir the flour into the cooked onions and cook for 1 minute. Pour in the stock and Worcestershire sauce. Stir and simmer for 5 minutes until the gravy is glossy and thickened. Season to taste." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drain the potatoes well. Add the remaining butter and warm milk. Mash until smooth. Season with salt." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Plate up the mash, rest the sausages on top, and pour the onion gravy over everything." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Mash is lumpy",
              "cause": "Potatoes not mashed enough or were too cold",
              "fix": "Mash while hot and beat in warm milk."
            },
            {
              "symptom": "Gravy is too thick",
              "cause": "Reduced too much",
              "fix": "Add more stock a little at a time."
            }
          ]
        }
      }
    ]
