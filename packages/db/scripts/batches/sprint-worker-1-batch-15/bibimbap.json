      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rinse the rice until the water runs clear. Cook in a rice cooker or in a saucepan with 450ml water. Bring to the boil, cover, and cook on very low heat for 12 minutes. Leave covered for 5 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry the beef mince in a dry hot wok for 5 minutes until browned. Add half the garlic, half the ginger, and 2 tbsp of soy sauce. Stir and cook for 2 more minutes. Set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Wipe the wok. Add 1 tsp of sesame oil. Saute the carrots for 3 minutes on high heat until just tender but still with bite. Season with a little soy and rice vinegar. Set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Blanch the spinach in boiling water for 30 seconds. Drain well. Squeeze out excess water. Season with sesame oil and a little soy sauce. Set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the mushrooms in the wok with 1 tsp of sesame oil and the remaining garlic and ginger for 3 to 4 minutes. Set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry one egg per person, sunny-side up, in a little oil." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide the rice between 4 bowls. Arrange each topping in sections on top. Place the fried egg in the centre. Add 1 tbsp of gochujang per bowl. Serve immediately and mix together at the table." }] }]
          }
        ]
      },
      {
        "type": "heading",
