          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drain through a sieve. Spread on a plate or tray to cool quickly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Whisk the lemon juice, olive oil, and crushed garlic together in a large bowl. Season with salt and pepper." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cooled farro, cucumber, tomatoes, pepper, olives, and parsley to the dressing. Toss to coat. Top with the crumbled feta and serve." }] }]
