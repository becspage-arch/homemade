        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a wok over a high heat. Add the pork mince. Break it up and fry for 4 to 5 minutes until browned." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and ginger. Stir for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the doubanjiang and gochujang. Stir to coat the meat. Cook for 2 minutes until the paste is fragrant and the oil turns red." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the mushrooms and toss to combine. Pour in the stock. Bring to a simmer." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the soy sauce. Stir in the cornflour slurry a little at a time until the sauce is glossy and thick. Drizzle over the sesame oil. Scatter with spring onion and serve with rice." }] }]
          }
        ]
      },
