      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the light soy, dark soy, rice vinegar, honey, and cornflour slurry together in a small bowl. Set the sauce aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the wok over a high heat until it just starts to smoke. Add the sunflower oil." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chicken in a single layer. Do not stir it for 2 minutes. Let it brown on one side, then toss and cook for another 2 minutes. Cook in batches if needed. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger, chilli flakes, and gochugaru to the wok. Stir for 30 seconds." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the red pepper and spring onion. Toss for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the chicken to the wok. Pour in the sauce. Toss everything together for 1 minute until the sauce thickens and coats the chicken. Add the peanuts and sesame oil. Serve straight away." }] }]
          }
        ]
      },
      {
