        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a saucepan over a medium-low heat. Add the garlic and chilli flakes. Cook gently for 2 minutes until the garlic is golden. Do not let it burn." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes. Season well with salt. Simmer for 15 minutes, stirring occasionally, until the sauce has thickened." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the rigatoni in well-salted boiling water according to the packet, less 1 minute. Before draining, scoop out a ladle of pasta water and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drain the pasta and add to the sauce. Toss over the heat for 1 minute. Add a splash of pasta water if the sauce is too thick. Scatter over the parsley and serve with parmesan if using." }] }]
          }
        ]
