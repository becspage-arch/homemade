        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 200C. Prick each potato all over with a fork. This lets steam escape and stops the skin bursting." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rub each potato with a little of the butter and a good pinch of salt. Place on a baking tray." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bake for 60 minutes. The skin should be completely crisp and the inside feel soft when you squeeze the potato gently." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Split each potato open with a knife. Push the sides to open it up. Add the remaining butter, then pile on the cheddar, soured cream, spring onion, and chilli flakes." }] }]
          }
        ]
