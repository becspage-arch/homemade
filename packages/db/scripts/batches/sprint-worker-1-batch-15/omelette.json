      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Break the eggs into a bowl. Season with salt and a little pepper. Beat well with a fork until the yolks and whites are fully combined." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the pan over a high heat for 1 minute. Add the butter. It should foam immediately. If it does not, the pan is not hot enough." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the eggs. Use a spatula to move them constantly, pulling the set egg from the edges into the centre. Keep the pan moving over the heat." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "When the eggs are just set but still glossy on top, scatter over the chives. Tilt the pan and fold the omelette onto a warm plate. Serve straight away." }] }]
          }
        ]
      },
      {
        "type": "heading",
