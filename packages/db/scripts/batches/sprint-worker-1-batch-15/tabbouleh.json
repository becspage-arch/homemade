            { "ingredientSlug": "parsley-flat", "amount": 120, "unit": "g", "prepNote": "very finely chopped", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "mint", "amount": 30, "unit": "g", "prepNote": "very finely chopped", "isOptional": false, "groupLabel": null },
