        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the bulgur wheat in a bowl. Pour over enough boiling water to just cover it. Leave for 15 minutes until the water is absorbed. Drain any excess through a sieve and spread out to cool." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Chop the parsley and mint very finely. This is the most time-consuming part. Use a large, sharp knife and chop in batches." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Combine the bulgur, herbs, tomato, spring onion, and cucumber in a large bowl. Add the lemon juice and olive oil. Toss well." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste and adjust with more lemon or salt. The salad should be bright and sharp. Serve straight away or within an hour." }] }]
          }
        ]
      },
