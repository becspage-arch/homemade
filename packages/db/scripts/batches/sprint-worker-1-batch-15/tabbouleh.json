        "type": "paragraph",
        "content": [{ "type": "text", "text": "Tabbouleh is a herb salad first and a grain salad second. The parsley and mint should be the dominant ingredients. Do not skimp on the herbs." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
