  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Pork escalopes work just as well as veal in this classic Roman dish. Ask your butcher to flatten them, or place between two sheets of baking paper and bash with a rolling pin." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "pork-loin", "amount": 4, "unit": "whole", "prepNote": "escalopes, about 150g each, flattened", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "sage", "amount": 8, "unit": "leaves", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "pancetta", "amount": 80, "unit": "g", "prepNote": "thinly sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "plain-flour", "amount": 40, "unit": "g", "prepNote": "for dusting", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "unsalted-butter", "amount": 50, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "olive-oil", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "lemon", "amount": 1, "unit": "whole", "prepNote": "juiced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "dijon-mustard", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lay 2 sage leaves on each pork escalope. Drape the pancetta slices over the top to cover the sage. Pin in place with a wooden toothpick." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Dust the non-pancetta side of each escalope lightly with flour. Shake off the excess." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the butter and oil in a large frying pan over a medium-high heat. Place the pork pancetta-side down. Cook for 3 minutes until the pancetta is golden and crisp." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Flip and cook the other side for 3 to 4 minutes until cooked through. Remove to a warm plate." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour the lemon juice into the hot pan. Whisk in the mustard. Let it bubble for 30 seconds. Spoon the sauce over the pork and rest for 5 minutes before serving." }] }]
          }
        ]
      },
      {
        "type": "heading",
