      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a large pot over a medium heat. Add the chorizo. Fry for 3 minutes until the fat starts to render and the edges are crisp." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion, celery, and green pepper. Cook for 6 minutes until softened. Add the garlic, smoked paprika, and thyme. Stir for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the black beans and stir to coat in the spiced oil." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the stock. Add the bay leaves. Bring to the boil. Add the rice and stir once. Reduce the heat to very low." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover with a tight lid. Cook for 20 minutes without lifting the lid. Check the rice is cooked and all the stock has been absorbed. Remove the bay leaves. Scatter over the spring onion and serve." }] }]
          }
        ]
      },
      {
