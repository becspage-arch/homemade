            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the capers, olives, and torn basil. Toss again gently." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Leave to rest at room temperature for 30 minutes before serving. The bread will soak up the dressing and tomato juices. Taste and adjust seasoning before serving." }] }]
