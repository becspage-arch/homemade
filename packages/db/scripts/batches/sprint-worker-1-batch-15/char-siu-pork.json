    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Char siu gets its sticky glaze from the honey in the marinade caramelising in a hot oven. The longer you marinate it the deeper the flavour. Two hours is the minimum." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "pork-shoulder", "amount": 700, "unit": "g", "prepNote": "cut into thick strips about 4cm wide", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "soy-sauce-light", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "soy-sauce-dark", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "honey", "amount": 4, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "five-spice", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "rice-vinegar", "amount": 1, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 3, "unit": "cloves", "prepNote": "crushed", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "ginger-fresh", "amount": 3, "unit": "cm", "prepNote": "finely grated", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "sesame-oil", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the light soy, dark soy, honey, five spice, rice vinegar, garlic, ginger, and sesame oil together in a large bowl." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pork strips and turn to coat thoroughly. Cover and leave in the fridge for at least 2 hours. Overnight is better." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 200C. Line a roasting tin with foil. Lift the pork out of the marinade and lay the strips in the tin. Keep the remaining marinade." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast for 25 minutes. Remove from the oven. Brush the pork with the remaining marinade on both sides." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return to the oven for 10 more minutes until the glaze is caramelised and the edges are starting to char at the tips. Rest for 10 minutes before slicing." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
