      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Combine the olive oil, crushed garlic, lemon juice, and all the spices in a large bowl. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chicken thighs and turn to coat thoroughly. Marinate for at least 30 minutes at room temperature, or up to 24 hours in the fridge." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Preheat the oven to 220C. Spread the chicken in a single layer in a roasting tin, slightly overlapping is fine." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast for 22 to 25 minutes until cooked through and dark at the edges. For extra char, place under a hot grill for 3 minutes at the end." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rest for 5 minutes, then slice thinly. Serve with greek yoghurt, flatbreads, and a simple salad." }] }] }
