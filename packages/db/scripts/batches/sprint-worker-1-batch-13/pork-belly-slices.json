            { "ingredientSlug": "ginger-fresh", "amount": 3, "unit": "cm", "prepNote": "peeled and finely grated", "isOptional": false, "groupLabel": "Glaze" },
            { "ingredientSlug": "garlic", "amount": 3, "unit": "cloves", "prepNote": "crushed", "isOptional": false, "groupLabel": "Glaze" },
            { "ingredientSlug": "rice-vinegar", "amount": 1, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Glaze" }
