    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Ask the butcher to slice the pork belly into pieces about 2cm thick, or do it yourself with a sharp knife. The slower the initial roast, the more fat renders out. The glaze step at the end is quick but needs watching, as the honey can burn fast." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "pork-belly", "amount": 800, "unit": "g", "prepNote": "sliced into 2cm pieces", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "soy-sauce-dark", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Glaze" },
            { "ingredientSlug": "soy-sauce-light", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Glaze" },
            { "ingredientSlug": "honey", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Glaze" },
