        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Preheat the oven to 180C. Arrange the pork belly slices in a single layer in a roasting tin. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast for 40 minutes, turning once halfway, until the fat has started to render and the meat is cooked through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Meanwhile, mix together all the glaze ingredients in a bowl." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour away most of the fat from the tin. Brush the glaze generously over each pork slice." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return to the oven at 220C for 15 to 20 minutes, turning and basting every 5 minutes, until the glaze is dark, sticky, and caramelised. Watch carefully in the last few minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve immediately over steamed rice." }] }] }
        ]
      },
      {
        "type": "heading",
