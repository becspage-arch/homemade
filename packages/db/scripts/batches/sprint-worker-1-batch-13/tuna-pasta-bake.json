      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Preheat the oven to 200C. Cook the pasta in salted boiling water for 2 minutes less than the packet time. Drain and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt the butter in a large saucepan over a medium heat. Add the flour and stir for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the milk gradually, whisking to avoid lumps. Cook for 5 minutes, stirring, until thick enough to coat the back of a spoon." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from the heat. Stir in 150g of the cheddar and the tomato puree. Season with salt and black pepper." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the drained tuna, frozen peas, and cooked pasta. Stir to combine and pour into a baking dish." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter the remaining 50g of cheddar over the top. Bake for 20 minutes until golden and bubbling." }] }] }
        ]
      },
