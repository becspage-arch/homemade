        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the soy sauce, oyster sauce, and cornflour slurry in a small bowl. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the wok over a high heat until smoking. Add the sunflower oil, then the garlic and ginger. Stir-fry for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the red pepper and stir-fry for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Push everything to one side and add the prawns. Cook for 2 minutes, stirring, until they just turn pink." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pak choi and spring onion and toss everything together for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the sauce and toss for 1 minute more until everything is glossy and coated." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drizzle over the sesame oil and serve immediately with rice." }] }] }
        ]
