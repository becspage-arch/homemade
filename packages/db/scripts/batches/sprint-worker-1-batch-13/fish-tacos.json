          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Warm the flatbreads or tortillas. Set out the cabbage, avocado, coriander, soured cream, and lime wedges." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Let everyone build their own tacos at the table: fish first, then toppings, then a squeeze of lime." }] }] }
