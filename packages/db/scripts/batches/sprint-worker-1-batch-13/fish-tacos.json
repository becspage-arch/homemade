        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the flour, smoked paprika, cumin, chilli flakes, and a good pinch of salt in a shallow bowl." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pat the cod strips dry with kitchen paper, then toss them in the seasoned flour to coat all over. Shake off the excess." }] }] },
