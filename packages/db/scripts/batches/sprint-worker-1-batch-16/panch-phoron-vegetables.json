  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Cut all the root vegetables to a similar size so they cook at the same rate. The green beans go in last as they need far less time than the potatoes." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "potato", "amount": 400, "unit": "g", "prepNote": "peeled and cut into 2cm cubes", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "sweet-potato", "amount": 200, "unit": "g", "prepNote": "peeled and cut into 2cm cubes", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "carrot", "amount": 2, "unit": "medium", "prepNote": "peeled and sliced into rounds", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "green-beans", "amount": 200, "unit": "g", "prepNote": "trimmed and halved", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 1, "unit": "medium", "prepNote": "finely sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 2, "unit": "cloves", "prepNote": "minced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cumin-seeds", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "mustard-seeds", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "fennel-seeds", "amount": 0.5, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chilli-flakes", "amount": 0.5, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "turmeric", "amount": 0.5, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "sunflower-oil", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a large saucepan over medium-high heat. Add the mustard seeds. Wait until they start to pop, about 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add cumin seeds and fennel seeds. Let them sizzle for 20 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion. Cook for 5 minutes until soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add garlic, turmeric, and chilli flakes. Stir for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the potato, sweet potato, and carrot. Stir to coat in the spices." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add 100ml water. Cover and cook on medium-low heat for 12 minutes, stirring twice." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the green beans. Cook uncovered for 5 more minutes until all the vegetables are tender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste and season with salt. Serve hot as a side dish." }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Vegetables are sticking to the pan", "cause": "Not enough water or heat too high", "fix": "Add a splash more water and stir well." },
            { "symptom": "Potato is still firm after cooking time", "cause": "Cubes too large", "fix": "Cover and cook 5 more minutes with a splash of water." },
            { "symptom": "Mustard seeds did not pop", "cause": "Oil was not hot enough", "fix": "Heat oil until shimmering before adding seeds." }
          ]
        }
