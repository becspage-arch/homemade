            { "ingredientSlug": "stock-beef", "amount": 500, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "bay-leaves", "amount": 3, "unit": "whole", "prepNote": null, "isOptional": false, "groupLabel": null },
