            { "symptom": "Sauce is thin and watery", "cause": "Not enough evaporation during braising", "fix": "Remove lid and simmer on medium for 15 more minutes." },
            { "symptom": "Paprika tastes bitter", "cause": "Pan was too hot when paprika was added", "fix": "Always take pan off heat before adding paprika." },
            { "symptom": "Beef is still tough", "cause": "Not cooked long enough", "fix": "Cover and cook for 30 more minutes on low heat." }
          ]
        }
