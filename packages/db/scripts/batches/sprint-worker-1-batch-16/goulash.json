      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a large stockpot over high heat. Brown the beef in two or three batches. Each piece should be golden on all sides. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce heat to medium. Add the onions. Cook for 15 minutes, stirring often, until very soft and golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and fennel seeds. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the pan from the heat. Stir in both paprikas. Return to medium heat and cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the red peppers, carrot, tinned tomatoes, and beef stock. Stir well." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the beef to the pot. Add the bay leaves. Bring to a boil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce to a low simmer. Cover and cook for 75 to 90 minutes until the beef is very tender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove bay leaves. Taste and adjust salt. Serve with a spoonful of soured cream." }] }] }
        ]
      },
      {
        "type": "heading",
