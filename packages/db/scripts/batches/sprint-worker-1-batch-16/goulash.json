    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Use a good-quality sweet paprika. This is the main flavour in goulash, so the quality matters more than in most dishes. Smoked paprika adds depth, but sweet paprika is the base." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "beef-chuck", "amount": 700, "unit": "g", "prepNote": "cut into 3cm cubes", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 3, "unit": "large", "prepNote": "sliced into half moons", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 3, "unit": "cloves", "prepNote": "minced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "carrot", "amount": 2, "unit": "medium", "prepNote": "sliced into rounds", "isOptional": false, "groupLabel": null },
