      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Halloumi is rubbery in the sauce", "cause": "It was added too early and overcooked", "fix": "Add halloumi in the last 2 minutes only." },
            { "symptom": "Sauce tastes sour", "cause": "Tomatoes not cooked down long enough", "fix": "Simmer 5 more minutes, then add a little honey." },
            { "symptom": "Sauce is too thick", "cause": "Too much evaporation during blending step", "fix": "Stir in 50ml warm water and simmer briefly." }
          ]
        }
