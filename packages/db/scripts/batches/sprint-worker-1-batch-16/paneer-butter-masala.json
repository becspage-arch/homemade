      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a dry frying pan over high heat. Fry the halloumi cubes for 2 minutes per side until golden. Set aside on a plate." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In the same pan, melt half the butter over medium heat. Add the cumin seeds and let them sizzle for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion. Cook for 10 minutes, stirring often, until deep golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add garlic and ginger. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add turmeric, coriander, and paprika. Stir for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the tinned tomatoes. Cook for 10 minutes, stirring, until the sauce thickens." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Transfer to a blender and blend until smooth. Return to the pan." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the remaining butter, double cream, honey, and garam-masala. Simmer for 5 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the fried halloumi. Stir gently to coat. Serve at once with rice or flatbread." }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
