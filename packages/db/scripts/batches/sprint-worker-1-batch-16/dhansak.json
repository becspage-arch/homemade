      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a large stockpot over high heat. Brown the lamb in two batches until golden on all sides. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce heat to medium. Add the onions. Cook for 10 minutes until soft and golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add garlic, ginger, and fennel seeds. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add cumin, coriander, turmeric, paprika, and chilli flakes. Stir for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes. Cook for 5 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the lamb to the pot. Add the lentils and butternut squash. Add 600ml water. Stir well." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to a boil. Reduce to a low simmer. Cover and cook for 60 minutes, stirring every 20 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Uncover. Stir in the garam-masala. Cook for 10 more minutes until thick." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste and adjust salt. Scatter with fresh coriander. Serve with rice." }] }] }
        ]
      },
