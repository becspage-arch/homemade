        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Steep the saffron in 2 tbsp warm water. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt 2 tbsp ghee in a large saucepan over medium heat. Add the cumin seeds and cloves. Sizzle for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onions. Cook for 15 minutes, stirring often, until golden and soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add garlic and ginger. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add cardamom and cinnamon. Stir for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the ground almonds. Stir well to combine." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In a separate pan, heat the remaining ghee over high heat. Add the chicken pieces. Brown for 3 minutes each side. Transfer to the sauce pan." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the coconut milk and saffron water. Stir well. Cover and cook on low heat for 20 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from heat. Let the sauce cool for 2 minutes. Stir in the yoghurt, cream, and honey. Taste and adjust salt. Remove cloves before serving." }] }] }
        ]
      },
