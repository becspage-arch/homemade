            { "symptom": "Filling is too dry", "cause": "Tomatoes cooked too long", "fix": "Add 2 tbsp water and stir to loosen." },
            { "symptom": "Aubergine skin is collapsing", "cause": "Overroasted before filling", "fix": "Check at 20 minutes; pull as soon as flesh is soft." }
