      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 200C (180C fan). Line a baking tray with foil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Score the cut side of each aubergine half with a sharp knife. Brush generously with olive oil. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place cut-side down on the tray. Roast for 25 minutes until completely soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the aubergines roast, make the filling. Heat 1 tbsp olive oil in a frying pan over medium-high heat. Cook the lamb mince for 5 minutes, breaking it up, until browned." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion. Cook for 5 minutes until soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add garlic, cumin, allspice, and cinnamon. Stir for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add tinned tomatoes and tomato puree. Cook for 8 minutes until thick. Stir in the parsley. Taste and adjust salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Turn the aubergines cut-side up. Spoon the lamb filling over each half." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return to the oven for 10 to 15 minutes. Remove. Crumble feta over the top and serve." }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
