        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 220C (200C fan). Line a baking tray with foil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the marinade. In a bowl, combine the honey, smoked paprika, and cumin. Add the garlic, mustard, worcestershire sauce, vinegar, soy sauce, and tomato puree. Stir well." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pat the chicken dry with kitchen paper. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss the chicken in the glaze until fully coated. Spread on the lined baking tray in a single layer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast for 22 to 25 minutes. The chicken is done when the glaze is sticky and slightly charred at the edges and the juices run clear." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rest for 5 minutes before serving." }] }] }
        ]
