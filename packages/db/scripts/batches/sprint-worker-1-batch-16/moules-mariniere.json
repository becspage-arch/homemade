        "type": "paragraph",
        "content": [{ "type": "text", "text": "Prawns cook very quickly. Two to three minutes in the hot broth is all they need. Overcooking makes them tough and rubbery." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
