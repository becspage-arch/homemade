        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Hard boil the eggs. Lower them into boiling water. Cook for 10 minutes. Transfer to cold water. Peel when cool." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season the chicken breasts with salt. Grill or pan-fry in a hot dry pan for 5 to 6 minutes each side until cooked through. Rest for 5 minutes, then slice." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry the pancetta in a dry pan over medium heat until crispy. Drain on kitchen paper." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the dressing. Whisk the olive oil, red wine vinegar, and mustard together. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Arrange all the toppings over the salad. Place the chicken, eggs, avocado, and pancetta on top. Add the tomatoes, cucumber, and cheddar." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drizzle over the dressing. Scatter with chives. Serve at once." }] }] }
        ]
