      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mix the chicken with all the marinade ingredients and a pinch of salt. Leave for at least 15 minutes."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat 2 tablespoons of oil in a large frying pan over a high heat. Add the chicken pieces in a single layer."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cook for 4 minutes without moving them. Turn and cook for 3 more minutes. The chicken should be charred in patches. Remove to a plate."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the remaining oil to the pan. Add the onion and cook for 5 minutes over a high heat until soft at the edges and lightly charred."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the peppers, green chilli, sliced garlic, and ginger. Stir-fry for 3 minutes."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the ground coriander and cumin. Stir for 30 seconds. Add the tomato puree and cook for 1 minute."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the tinned tomatoes and salt. Return the chicken to the pan. Stir everything together and cook for 5 minutes until the sauce clings to the chicken."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Taste and adjust salt. Scatter with fresh coriander if using and serve immediately."}]}]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The chicken is steaming rather than charring.",
              "cause": "The pan was not hot enough or the pieces were too close together.",
              "fix": "Cook in two batches over a very high heat. Leave space between each piece and do not move them for at least 3 minutes."
            },
            {
              "symptom": "The sauce is watery.",
              "cause": "The tomatoes released too much liquid.",
              "fix": "Turn the heat up and stir-fry for another few minutes to drive off the excess moisture."
            },
            {
              "symptom": "The peppers are too soft.",
              "cause": "They went in too early or cooked too long.",
              "fix": "Add the peppers later in the stir-fry stage and keep the heat high so they soften quickly but hold some bite."
            }
          ]
        }
      }
    ]
  }
