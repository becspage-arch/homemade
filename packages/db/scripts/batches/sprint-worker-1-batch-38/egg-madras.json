      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Boil the eggs for 9 minutes. Transfer to cold water, peel, and set aside."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oil in a large frying pan over a medium heat. Add the cumin seeds and fry for 30 seconds."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the onion and cook for 10 minutes until deep golden brown. Stir often."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir in the garlic, ginger, and chilli. Cook for 1 minute."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the ground coriander, cumin, turmeric, and chilli powder. Stir for 30 seconds."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pour in the tinned tomatoes and tamarind paste. Add salt and stir well. Simmer for 15 minutes until thick."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Score the peeled eggs a few times with a knife. Nestle them into the sauce. Simmer for 5 minutes."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir in the garam masala. Taste and adjust salt. Scatter with fresh coriander if using."}]}]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The eggs have a grey ring around the yolk.",
              "cause": "They were cooked too long or not cooled quickly.",
              "fix": "Cook for exactly 9 minutes and transfer immediately to cold water to stop the cooking."
            },
            {
              "symptom": "The sauce is too thin.",
              "cause": "The tomatoes were not reduced enough before adding the eggs.",
              "fix": "Remove the eggs and boil the sauce hard for a few minutes. Return the eggs to warm through."
            },
            {
              "symptom": "The curry is too hot.",
              "cause": "The chillies or chilli powder were stronger than expected.",
              "fix": "Stir in a tablespoon of plain yoghurt or a splash of coconut milk to cool the heat."
            }
          ]
        }
      }
    ]
