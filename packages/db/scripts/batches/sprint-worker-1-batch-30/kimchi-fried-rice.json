        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the gochujang, soy sauce, and sesame oil in a small bowl. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat 2 tbsp sunflower oil in a wok over high heat until smoking." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the white spring onion parts, garlic, and ginger. Stir-fry for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the shredded cabbage. Toss over high heat for 3 minutes until it softens." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cold rice. Press it into the wok and cook without stirring for 2 minutes to get crispy bits." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the sauce. Toss everything together over high heat for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry the eggs separately in the remaining oil. Serve the rice topped with a fried egg and green spring onion." }] }] }
        ]
      },
