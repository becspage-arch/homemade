      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat 2 tbsp ghee in a large saucepan over high heat. Sear the lamb in two batches, browning on all sides. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the remaining ghee and reduce heat to medium. Cook the onion for 10 minutes until deep golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the garlic and ginger. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the turmeric, ground coriander, cumin, and cardamom. Stir for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the lamb to the pan. Stir in the yoghurt one tablespoon at a time." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in 300ml of water. Bring to a simmer, then cover and cook for 40 minutes until the lamb is tender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Wilt the spinach in a separate pan with a splash of water. Blend until smooth, then stir into the lamb." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the garam masala. Simmer for 5 minutes. Taste for salt and serve with fresh coriander." }] }] }
        ]
      },
