        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place the salmon in a pan of gently simmering water. Poach for 8 minutes. Remove, cool slightly, then flake the flesh from the skin." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Soft-boil the eggs for 7 minutes. Cool in cold water, then peel and halve." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the rice according to pack instructions until just done. Drain and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt the butter in a large saucepan over medium heat. Add the cumin seeds and sizzle for 20 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion. Cook for 8 minutes until soft and golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the garlic and ginger. Cook for 2 minutes. Add the turmeric and garam masala." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fold the cooked rice into the spice mixture. Pour in the cream and stir gently." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Gently fold in the flaked salmon. Add the lemon juice and taste for salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve in bowls with the egg halves on top and parsley scattered over." }] }] }
        ]
      },
