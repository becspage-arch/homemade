        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Steep the saffron in 3 tbsp of hot water. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a stockpot over medium heat. Add the fennel seeds and sizzle for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion. Cook for 8 minutes until soft and golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the garlic. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the tinned tomatoes. Add the thyme and bay leaves. Simmer for 5 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the stock and the saffron water. Bring to a gentle boil. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Gently lower in the salmon and cod pieces. Cook for 3 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the king prawns. Cook for 2 minutes until they turn pink." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the thyme and bay leaves. Scatter the parsley over and serve with lemon wedges." }] }] }
        ]
      },
