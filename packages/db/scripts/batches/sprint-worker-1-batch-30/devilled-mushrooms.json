      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt the butter in a wide frying pan over high heat until it foams and starts to turn golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the mushrooms in a single layer. Leave them to fry without stirring for 3 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir and continue to cook for 4 minutes until well coloured and any liquid has evaporated." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the mustard, Worcestershire sauce, and chilli flakes. Stir to coat the mushrooms." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the cream. Stir and simmer for 3 minutes until the sauce clings to the mushrooms." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Squeeze in the lemon juice. Taste for salt. Scatter the parsley over and serve." }] }] }
        ]
      },
