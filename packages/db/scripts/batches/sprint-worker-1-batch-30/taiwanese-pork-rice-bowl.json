      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Start the rice. Soft-boil the eggs for 7 minutes then transfer to cold water." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a dry large saucepan over high heat. Add the pork mince and cook without stirring for 3 minutes to get colour." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Break up the pork and stir in the garlic and ginger. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the star anise and five-spice. Stir for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in both soy sauces, the mirin, and honey. Add 200ml of water." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Simmer over medium-low heat for 20 minutes, stirring occasionally, until the sauce is thick and glossy." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the star anise. Serve the pork over bowls of rice with the egg halves on the side. Top with spring onion." }] }] }
        ]
      },
