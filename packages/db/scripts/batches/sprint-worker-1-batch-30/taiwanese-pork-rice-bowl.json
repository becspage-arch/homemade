            { "symptom": "Sauce is too thin after 20 minutes.", "cause": "Too much water or heat too low.", "fix": "Increase heat and simmer uncovered for 5 more minutes." },
            { "symptom": "Pork tastes too sweet.", "cause": "Honey or mirin overpowered the savoury notes.", "fix": "Add a dash more light soy sauce to balance it." },
            { "symptom": "Sauce is catching on the bottom.", "cause": "Sugar in soy and honey burns at high heat.", "fix": "Keep heat low and add a splash of water, stirring well." }
