            { "symptom": "Sauce is too thick.", "cause": "Too much water has evaporated.", "fix": "Stir in 50-100ml of water and reheat gently." },
            { "symptom": "Chickpeas are still firm.", "cause": "Tinned chickpeas need time to absorb the sauce.", "fix": "Simmer for an extra 10 minutes with the lid on." }
