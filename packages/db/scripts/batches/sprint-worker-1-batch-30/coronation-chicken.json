      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place the chicken breasts in a saucepan. Cover with cold water and add a pinch of salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to a gentle simmer over medium heat. Cook for 18 minutes until cooked through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the chicken and leave to cool for 10 minutes. Shred into pieces with two forks." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the yoghurt, creme fraiche, garam masala, turmeric, mustard, honey, and lemon juice in a large bowl." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toast the flaked almonds in a dry frying pan for 2 minutes until golden. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the shredded chicken and diced apple to the dressing. Toss gently to coat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste for salt. Scatter the almonds and coriander over before serving." }] }] }
        ]
