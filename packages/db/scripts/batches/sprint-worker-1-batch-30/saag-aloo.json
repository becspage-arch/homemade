        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring a large saucepan of salted water to the boil. Add the potatoes and cook for 8 minutes. Drain and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Wipe out the pan and set it over medium heat. Melt the ghee." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the mustard seeds and cumin seeds. Let them pop and sizzle for about 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion and chilli. Cook for 8 minutes, stirring often, until the onion is soft and golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the garlic and ginger. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the turmeric, ground coriander, and garam masala. Stir for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the par-boiled potatoes. Toss to coat in the spices. Cook for 5 minutes until lightly golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the spinach in large handfuls, stirring each batch until wilted before adding more." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season with salt. Scatter the fresh coriander over and serve." }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Potatoes are breaking up.", "cause": "Par-boiled for too long before the second cook.", "fix": "Par-boil for 6 minutes only and handle gently." },
            { "symptom": "Spinach is watery.", "cause": "High water content released during wilting.", "fix": "Cook on high heat uncovered until the liquid evaporates." },
            { "symptom": "Dish tastes bland.", "cause": "Not enough salt or the spices need more cooking.", "fix": "Season generously and stir in an extra pinch of garam masala." }
          ]
        }
      }
