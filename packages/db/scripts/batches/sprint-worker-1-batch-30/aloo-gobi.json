          "items": [
            { "symptom": "Broccoli is mushy.", "cause": "Added too early and overcooked.", "fix": "Add broccoli 5 minutes after the potatoes next time." },
            { "symptom": "Spices are sticking and burning.", "cause": "Pan too dry or heat too high.", "fix": "Add a splash of water and lower the heat slightly." },
            { "symptom": "Vegetables are soft but not golden.", "cause": "Lid was on, trapping steam.", "fix": "Remove lid and turn up heat to drive off the moisture." }
