        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Boil the potato cubes in salted water for 5 minutes. Drain and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the ghee in a large saucepan over medium-high heat. Add the cumin seeds and sizzle for 20 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion and chilli. Cook for 6 minutes until softened." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the garlic and ginger. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the turmeric and ground coriander. Stir for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the par-boiled potatoes and the broccoli florets. Toss to coat in the spice mixture." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook for 12 minutes, stirring occasionally, until the potatoes are golden and the broccoli is tender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the garam masala. Season with salt and top with fresh coriander." }] }] }
        ]
      },
