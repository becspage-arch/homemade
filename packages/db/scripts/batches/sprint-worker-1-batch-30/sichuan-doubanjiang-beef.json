      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Start your rice cooking first so it is ready when the beef is done." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the sunflower oil in a wok over high heat until smoking." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the doubanjiang. Fry for 1 minute, stirring, until it turns dark red and fragrant." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger, and white parts of the spring onion. Stir-fry for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the beef mince. Break it up and cook for 4 minutes until browned." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the beef stock. Add the light and dark soy sauce. Bring to a simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the cornflour slurry. Cook for 2 minutes until the sauce has thickened." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drizzle over the sesame oil. Scatter the green spring onion tops over and serve with rice." }] }] }
        ]
      },
