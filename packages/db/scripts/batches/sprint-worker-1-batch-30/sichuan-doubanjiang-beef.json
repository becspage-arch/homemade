            { "symptom": "Sauce is too salty.", "cause": "Doubanjiang and soy sauce are both high in salt.", "fix": "Add a splash more stock and a pinch of palm sugar." },
            { "symptom": "Sauce has not thickened.", "cause": "Cornflour slurry was not mixed well.", "fix": "Mix more slurry and stir in over medium heat." },
            { "symptom": "Beef is clumping together.", "cause": "Not broken up early enough in a hot wok.", "fix": "Use a spatula to chop the mince as it hits the pan." }
