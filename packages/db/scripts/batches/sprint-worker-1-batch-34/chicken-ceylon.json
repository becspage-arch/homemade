        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oil in the saucepan over a medium heat. Add the onions and cook for 8 minutes until golden."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, ginger, and red chilli. Stir for 1 minute. Add the coriander, cumin, turmeric, chilli powder, and cracked black pepper and stir for 30 seconds."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir in the tomato puree and cook for 1 minute."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the chicken pieces and stir to coat. Cook for 4 minutes, turning often, until sealed on all sides."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pour in the coconut milk. Bring to a gentle simmer. Cook uncovered for 20 minutes, stirring occasionally, until the chicken is cooked through and the sauce has thickened."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir in the garam masala, salt, and lime juice. Taste and adjust the seasoning and heat."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scatter with fresh coriander and serve with basmati rice."}]}]
          }
        ]
      },
      {
        "type": "heading",
