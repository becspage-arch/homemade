      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The coconut milk has split into oil and white solids.",
              "cause": "The heat was too high after the coconut milk went in.",
              "fix": "Keep the simmer gentle throughout. If it splits, turn the heat to the lowest setting and stir in a tablespoon of cold water."
            },
            {
              "symptom": "The curry tastes flat despite the pepper.",
              "cause": "The lime was added at the start rather than at the end.",
              "fix": "Add a fresh squeeze of lime just before serving to bring back the brightness."
            },
            {
              "symptom": "The sauce is too thin.",
              "cause": "The coconut milk was low-fat or the curry was not simmered long enough.",
              "fix": "Use full-fat coconut milk and simmer uncovered until the sauce coats the back of a spoon."
            }
          ]
        }
      }
