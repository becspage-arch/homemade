      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oil in the frying pan over a medium-high heat. Add the mustard seeds and curry leaves. Stand back; they spit. Let them pop for 20 seconds."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the onions and cook for 8 minutes, stirring often, until golden brown."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, ginger, and red chilli. Stir for 1 minute. Add the chilli powder, coriander, cumin, and turmeric and stir for 30 seconds."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the tinned tomatoes and tamarind paste. Cook over a medium heat for 12 minutes, stirring occasionally, until the sauce thickens and the oil separates."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Turn the heat to high. Add the prawns and stir to coat. Cook for 3 to 4 minutes, turning once, until the prawns are pink and just cooked through."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stir in the garam masala and salt. Taste for heat and sharpness; add more tamarind or chilli powder if you want."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scatter with fresh coriander and serve straight away with rice or bread."}]}]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The prawns are rubbery.",
              "cause": "They were in the pan too long or the heat was too low.",
              "fix": "Prawns need high heat and a short time. Remove them from the pan the moment they curl and turn opaque."
            },
            {
              "symptom": "The sauce is not hot enough.",
              "cause": "The chilli powder was measured conservatively.",
              "fix": "Add more chilli powder at the end, or add finely sliced fresh red chilli and let it sit in the sauce for 2 minutes."
            },
            {
              "symptom": "The mustard seeds did not pop.",
              "cause": "The oil was not hot enough when they went in.",
              "fix": "Heat the oil until it shimmers before adding them, and keep the lid nearby to stop any jumping out of the pan."
            }
          ]
        }
      }
