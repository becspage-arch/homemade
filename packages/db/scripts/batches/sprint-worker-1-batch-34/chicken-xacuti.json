      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dry-toast the coriander seeds, cumin, cloves, cardamom seeds, star anise, cinnamon, poppy seeds, and dried chillies in the dry frying pan over a medium heat for 3 to 4 minutes, stirring constantly, until fragrant and just smoking. Tip onto a plate to cool."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Toast the desiccated coconut separately in the dry pan for 2 minutes until golden. Add to the spices. Once cool, grind the whole lot with the turmeric to a fine powder in the spice grinder."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oil in the large saucepan over a medium heat. Add the onions and cook for 10 minutes until golden."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic and ginger and stir for 1 minute. Add the ground xacuti masala and stir for 2 minutes until fragrant."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the tinned tomatoes and cook for 8 minutes, stirring often, until the sauce thickens."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the chicken pieces and stir well. Pour in the coconut milk and add the salt. Bring to a simmer."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cook uncovered for 25 minutes until the chicken is tender and the sauce is thick. Taste and adjust salt. Serve with rice and fresh coriander."}]}]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The spices burned during toasting.",
              "cause": "The heat was too high or they were left unattended.",
              "fix": "Start over with fresh spices if they are black or smell acrid. The whole dish depends on the masala being toasted, not burned."
            },
            {
              "symptom": "The sauce is grainy or sandy in texture.",
              "cause": "The spice grinder did not grind finely enough.",
              "fix": "Pass the ground masala through a fine sieve and grind the coarse pieces again before adding them."
            },
            {
              "symptom": "The coconut milk sauce is too thin.",
              "cause": "The lid was on and the sauce did not reduce.",
              "fix": "Remove the lid and simmer over a medium heat for a further 10 minutes, stirring occasionally."
            }
          ]
        }
      }
    ]
  }
