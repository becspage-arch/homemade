          "items": [
            { "symptom": "Broth tastes flat despite the miso.", "cause": "The miso was boiled in the broth, losing its flavour.", "fix": "Always dissolve miso off the heat in a ladle of broth before adding back." },
            { "symptom": "Pork is chewy and not golden.", "cause": "The pan was not hot enough or the pork was moved too soon.", "fix": "Use high heat and leave the pork undisturbed for 3 to 4 minutes per side." }
          ]
        }
