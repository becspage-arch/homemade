      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Soft-boil the eggs. Lower them into boiling water and cook for 6 minutes and 30 seconds. Transfer to cold water. Peel when cool." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the sesame oil in a stockpot over a medium-high heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pork belly strips. Cook for 3 to 4 minutes per side until golden. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In the same pot, cook the garlic and ginger for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the chicken stock. Add the soy sauce. Bring to a gentle simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pak choi. Simmer for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the egg noodles separately in boiling water according to the packet. Drain." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Take the broth off the heat. Dissolve the miso paste into a ladleful of broth, then stir it back into the pot." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide the noodles between four deep bowls." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Ladle over the broth. Top each bowl with pork belly slices, a halved egg, pak choi, and spring onion." }] }] }
        ]
      },
      {
        "type": "heading",
