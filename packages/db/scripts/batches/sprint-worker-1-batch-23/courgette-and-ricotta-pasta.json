            { "symptom": "Sauce is watery and pools at the bottom of the plate.", "cause": "Courgette was not squeezed dry before cooking.", "fix": "Squeeze grated courgette hard in a tea towel before adding to the pan." },
            { "symptom": "Ricotta has melted into the sauce and lost its texture.", "cause": "The pasta was too hot when the ricotta was added.", "fix": "Add ricotta as a topping after plating, not stirred into the hot pan." }
