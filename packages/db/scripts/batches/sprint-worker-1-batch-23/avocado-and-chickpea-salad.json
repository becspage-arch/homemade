          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the dressing. Whisk together the olive oil, red wine vinegar, lemon juice, and cumin. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the chickpeas in a large bowl. Pour half the dressing over them. Toss and leave for 5 minutes." }] }] },
