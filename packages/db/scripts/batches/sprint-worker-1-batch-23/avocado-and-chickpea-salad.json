          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the avocado chunks. Fold in gently so they do not break up." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drizzle over the remaining dressing." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter over the mint. Serve immediately." }] }] }
