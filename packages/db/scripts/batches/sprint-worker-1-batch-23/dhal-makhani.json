    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "The secret to a good dal makhani is time and a low heat. Rushing it gives you a thin, grainy result. Let it bubble gently and stir often, especially in the last 15 minutes." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
