        "type": "paragraph",
        "content": [{ "type": "text", "text": "Do not over-process the prawns. Pulse until roughly minced with a few larger pieces remaining. A completely smooth paste gives a dense, bouncy result rather than a light patty." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "king-prawns", "amount": 400, "unit": "g", "prepNote": "raw, peeled, and deveined", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "ginger-fresh", "amount": 20, "unit": "g", "prepNote": "peeled and roughly chopped", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 2, "unit": "cloves", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "spring-onion", "amount": 3, "unit": null, "prepNote": "roughly chopped", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "sesame-oil", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "soy-sauce-light", "amount": 1, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cornflour", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "sunflower-oil", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the prawns, ginger, garlic, and spring onion in a food processor." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pulse 6 to 8 times until roughly minced. Do not blend smooth." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Transfer to a bowl. Add the sesame oil, soy sauce, and cornflour." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix until just combined. The mixture will be sticky." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "With damp hands, shape into 12 small round patties about 1.5cm thick." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the sunflower oil in a large frying pan over a medium-high heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the patties in batches for 3 minutes per side until golden and cooked through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drain on kitchen paper. Serve with dipping sauce or a light dipping soy." }] }] }
        ]
      },
      {
