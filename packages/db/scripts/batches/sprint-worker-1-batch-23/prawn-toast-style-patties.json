            { "symptom": "Patties fell apart in the pan.", "cause": "Not enough cornflour was mixed in or the mixture was too wet.", "fix": "Add an extra tablespoon of cornflour and chill for 15 minutes before frying." },
            { "symptom": "Patties are dense and rubbery inside.", "cause": "Prawns were blended too smooth.", "fix": "Only pulse in short bursts. Stop when the texture is still rough and chunky." }
