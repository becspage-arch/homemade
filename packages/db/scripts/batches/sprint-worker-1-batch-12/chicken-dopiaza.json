      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat 3 tablespoons of oil in a large pan over a medium-high heat. Add the 2 finely sliced onions and cook, stirring often, for 15 to 20 minutes until deep golden brown." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger and cumin seeds to the pan and cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the turmeric, coriander, paprika and chilli flakes. Stir for 1 minute, then add the tinned tomatoes. Cook for 5 minutes until the oil begins to separate from the sauce." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chicken pieces and stir to coat. Add 150ml of water, bring to a simmer and cook covered for 15 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In a separate pan, fry the 2 diced onions in the remaining tablespoon of oil until softened but still with some bite, about 6 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir the second batch of onions into the curry. Add the garam masala and cook uncovered for a further 5 minutes. Season and serve." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Curry tastes flat with little depth.",
              "cause": "The first batch of onions was not browned enough.",
              "fix": "Cook sliced onions until deep golden, not just soft."
            },
            {
              "symptom": "Sauce is too thin.",
              "cause": "Too much water was added and not cooked off.",
              "fix": "Cook uncovered for the last 5 minutes to reduce."
            }
          ]
        }
      }
