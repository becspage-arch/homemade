          "items": [
            {
              "symptom": "Eggs are splitting and falling apart.",
              "cause": "They were not pricked before frying or sauce was boiled hard.",
              "fix": "Prick eggs and simmer gently, never boil the sauce."
            },
            {
              "symptom": "Sauce is raw-tasting and acidic.",
              "cause": "Tinned tomatoes were not cooked long enough.",
              "fix": "Simmer sauce for at least 10 minutes before adding eggs."
            }
          ]
        }
