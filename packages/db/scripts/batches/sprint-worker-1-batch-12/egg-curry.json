      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Prick the peeled eggs all over with a fork. Heat 1 tablespoon of the oil in a pan and fry the eggs, turning, until golden on all sides, about 3 minutes. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the remaining oil to the pan over a medium heat. Cook the onions for 10 minutes until golden." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger, turmeric, cumin, coriander and paprika. Cook, stirring, for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the tomato puree and cook for 1 minute, then add the tinned tomatoes and 100ml water. Simmer for 10 minutes until the sauce thickens." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garam masala and the fried eggs to the sauce. Simmer gently for 5 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season, scatter over the fresh coriander and serve with rice or flatbreads." }] }]
          }
        ]
      },
      {
        "type": "heading",
