        "type": "paragraph",
        "content": [{ "type": "text", "text": "Keep the heat high so the prawns colour quickly rather than stewing. They are done as soon as they curl and turn pink, usually 2 minutes per side." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "king-prawns", "amount": 600, "unit": "g", "prepNote": "peeled and deveined", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "unsalted-butter", "amount": 80, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 6, "unit": "cloves", "prepNote": "thinly sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chilli-flakes", "amount": 0.5, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "parsley-flat", "amount": 30, "unit": "g", "prepNote": "roughly chopped", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "lemon", "amount": 2, "unit": "whole", "prepNote": "1 juiced, 1 cut into wedges", "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pat the prawns dry with kitchen paper and season well with salt." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt the butter in a large frying pan over a high heat until it begins to foam." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and chilli flakes and cook for 30 seconds, stirring, until fragrant but not browned." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the prawns in a single layer and cook for 2 minutes without moving them." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Flip each prawn and cook for a further 1 to 2 minutes until cooked through and curled." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from the heat. Squeeze over the lemon juice and scatter the parsley. Serve immediately with lemon wedges." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Prawns are rubbery and tough.",
              "cause": "They were overcooked or cooked from frozen without thawing.",
              "fix": "Remove prawns the moment they curl fully and turn pink."
            },
            {
              "symptom": "Garlic is bitter and brown.",
              "cause": "The pan was too hot before the butter was added.",
              "fix": "Keep garlic moving and lower heat if it browns fast."
            }
          ]
        }
