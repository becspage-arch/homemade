        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Combine the lamb mince, grated onion, garlic, cumin, coriander, allspice, cinnamon, chilli flakes, parsley and 1 teaspoon of salt in a bowl. Mix well with your hands." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry a small piece of the mixture in a pan to taste and adjust the seasoning if needed." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide the mixture into 16 equal portions. Shape each into a sausage about 8 cm long. Place on a lined baking tray and refrigerate for 30 minutes to firm up." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 220 C. Bake the kofte for 12 to 15 minutes until cooked through and the edges are browned." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve with flatbreads, yoghurt, chopped tomato and fresh herbs." }] }]
          }
        ]
