      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 200 C. Line the baking tray with baking paper." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the olive oil and Dijon mustard together in a small bowl." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place the salmon fillets skin-side down on the tray. Brush each fillet generously with the mustard mixture." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter the sliced garlic over and around the fillets. Lay thyme and rosemary sprigs alongside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place the lemon slices on top of each fillet. Season with salt and black pepper." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast for 12 to 15 minutes until the salmon flakes when pressed at the thickest part." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Squeeze the remaining lemon over the fillets and serve immediately." }] }]
          }
        ]
      },
