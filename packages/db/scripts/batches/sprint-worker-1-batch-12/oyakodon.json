        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the rice according to the packet instructions and keep warm." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Combine the stock, soy sauce, mirin and sake in a wide frying pan. Bring to a simmer over a medium heat." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion and cook for 3 minutes until slightly softened." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chicken strips in a single layer and simmer for 6 to 8 minutes until cooked through, turning once." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour the beaten eggs in a slow, circular stream over the chicken. Cover and cook for 2 minutes until just set but still slightly wobbly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spoon immediately over bowls of warm rice. Top with spring onion." }] }]
          }
        ]
      },
