      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the rinsed lentils in a saucepan with 800ml water and the turmeric. Bring to a boil, skim any foam, then simmer for 20 minutes until very soft." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Meanwhile heat the ghee in a separate pan over a medium-high heat. Add the mustard seeds and cumin seeds. When they pop, add the onion and cook for 8 minutes until golden." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger and coriander. Cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes and cook for 5 minutes until the sauce thickens." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour the onion and tomato mixture into the lentils. Add the spinach in handfuls, stirring until completely wilted." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Squeeze in the lemon juice. Season with salt and serve with rice or roti." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Lentils are gluey and stodgy.",
              "cause": "They were not rinsed before cooking.",
              "fix": "Rinse under cold water until the water runs clear."
            },
            {
              "symptom": "Mustard seeds have not popped.",
              "cause": "The ghee was not hot enough before they went in.",
              "fix": "Heat the ghee until it shimmers before adding seeds."
            }
          ]
        }
      }
