        "type": "paragraph",
        "content": [{ "type": "text", "text": "Do not salt the lentils during cooking or they will turn tough. Salt only once they are drained and in the bowl." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "lentils-green", "amount": 250, "unit": "g", "prepNote": "rinsed", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chorizo", "amount": 150, "unit": "g", "prepNote": "sliced into 5mm rounds", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 1, "unit": "whole", "prepNote": "finely diced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 3, "unit": "cloves", "prepNote": "sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "carrot", "amount": 2, "unit": "whole", "prepNote": "finely diced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "celery", "amount": 2, "unit": "sticks", "prepNote": "finely diced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "dijon-mustard", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": "dressing" },
            { "ingredientSlug": "red-wine-vinegar", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "dressing" },
            { "ingredientSlug": "olive-oil", "amount": 4, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "dressing" },
            { "ingredientSlug": "parsley-flat", "amount": 30, "unit": "g", "prepNote": "roughly chopped", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "thyme-fresh", "amount": 4, "unit": "sprigs", "prepNote": null, "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the lentils in a saucepan with the thyme sprigs and cover with cold water by at least 5cm. Bring to a boil then simmer for 25 to 30 minutes until just tender but still with a little bite. Drain and discard the thyme." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the lentils cook, fry the chorizo slices in a dry frying pan over a medium heat for 3 minutes per side until crisp. Remove and set aside, keeping the fat in the pan." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the onion, carrot and celery in the chorizo fat over a medium heat for 8 minutes until soft. Add the garlic and cook for 1 more minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Whisk the Dijon, red wine vinegar and olive oil together in a large bowl with salt and pepper." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Tip the warm drained lentils into the bowl along with the cooked vegetables. Toss to coat. Fold in the chorizo and parsley." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste and adjust seasoning. Serve warm." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Lentils are mushy and have lost their shape.",
              "cause": "They were cooked too long or salted during cooking.",
              "fix": "Check at 25 minutes and drain as soon as they are just tender."
            },
            {
              "symptom": "Salad tastes flat and needs more punch.",
              "cause": "Dressing was made ahead and the vinegar mellowed.",
              "fix": "Add an extra teaspoon of vinegar and a pinch of salt before serving."
            }
          ]
        }
      }
