    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "The beans can be mashed with the back of a spoon for a chunky texture or blended briefly for a smooth, creamy result. Either way is correct." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "black-beans", "amount": 800, "unit": "g", "prepNote": "2 x 400g tins, drained and rinsed", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 1, "unit": "whole", "prepNote": "finely diced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 3, "unit": "cloves", "prepNote": "minced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cumin-ground", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chilli-flakes", "amount": 0.25, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "olive-oil", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "lime", "amount": 1, "unit": "whole", "prepNote": "juiced", "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a large frying pan over a medium heat. Cook the onion for 8 minutes until soft and golden." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, cumin and chilli flakes and cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the drained black beans and 150ml water. Cook for 5 minutes until the beans are heated through and beginning to absorb the flavours." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mash the beans roughly with the back of a wooden spoon or a potato masher, adding a splash more water if needed to reach a spreadable consistency." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook for a further 5 minutes, stirring, until the paste thickens and pulls away from the sides of the pan. Squeeze in the lime juice and season with salt." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Beans are very dry and stiff.",
              "cause": "Too much liquid cooked off before mashing.",
              "fix": "Add a splash of water and stir to loosen."
            },
            {
              "symptom": "Beans taste bland despite seasoning.",
              "cause": "Cumin was too old or garlic was undercooked.",
              "fix": "Toast the cumin in the dry pan first before adding oil."
            }
          ]
        }
