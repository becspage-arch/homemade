      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss the aubergine with a generous pinch of salt, leave for 10 minutes, then pat dry with kitchen paper." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the sunflower oil in a wok over a very high heat. Fry the aubergine in two batches until golden and starting to soften, about 4 minutes per batch. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add a little more oil if needed. Fry the pork mince, breaking it up, for 3 minutes until browned." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger and white parts of the spring onion. Cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the doubanjiang and stir for 30 seconds. Pour in the stock and soy sauce. Return the aubergine and simmer for 3 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the cornflour slurry and cook until the sauce thickens. Drizzle with sesame oil and scatter over the green spring onion." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
