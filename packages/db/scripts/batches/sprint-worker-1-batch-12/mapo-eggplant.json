        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "aubergine", "amount": 2, "unit": "whole", "prepNote": "cut into 2cm cubes", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "pork-mince", "amount": 200, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "doubanjiang", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
