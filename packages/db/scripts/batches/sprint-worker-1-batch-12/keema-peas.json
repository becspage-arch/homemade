        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a large pan over a medium heat. Cook the onions for 10 minutes until golden." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger, cumin, coriander, turmeric and chilli flakes. Cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Increase the heat to high. Add the lamb mince and break it up with a spoon. Cook for 5 minutes until browned all over." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tomato puree and stir for 1 minute, then add the tinned tomatoes. Reduce the heat and simmer for 15 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the frozen peas and garam masala. Cook for 3 minutes until the peas are heated through." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season with salt. Scatter over fresh coriander and serve with rice or flatbreads." }] }]
          }
        ]
      },
