        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the ghee in a large heavy pot over a high heat. Brown the lamb in batches, turning, until coloured all over. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the bay leaves, cloves and cumin seeds and let them sizzle for 30 seconds." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onions and cook for 15 minutes until deep golden, stirring regularly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger, paprika, chilli flakes, coriander, cinnamon and cardamom. Cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes and cook for 5 minutes until the sauce darkens and the oil separates slightly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the lamb. Stir in the yoghurt a spoonful at a time. Add 200ml water, bring to a simmer, cover and cook for 60 minutes until the lamb is tender." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the lid for the last 10 minutes to thicken the sauce. Season and serve with basmati rice and flatbreads." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Yoghurt has curdled and looks grainy.",
              "cause": "It was added all at once to a very hot pan.",
              "fix": "Add yoghurt one spoon at a time and stir after each."
            },
            {
              "symptom": "Lamb is still tough after 60 minutes.",
              "cause": "The heat was too high and the liquid boiled off too fast.",
              "fix": "Keep it at a low simmer and add more water if needed."
            }
          ]
        }
      }
