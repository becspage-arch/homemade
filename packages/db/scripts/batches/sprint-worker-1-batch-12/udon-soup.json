      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the noodles according to the packet instructions. Drain, rinse under cold water to stop cooking, and divide between four bowls." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour the stock into a large pot and bring to a simmer. Add the soy sauce and mirin." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the mushrooms and simmer for 5 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pak choi and prawns. Cook for 3 minutes until the prawns are pink and the greens are just tender." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Ladle the hot broth, vegetables and prawns over the noodles. Scatter with spring onion and serve immediately." }] }]
          }
        ]
      },
