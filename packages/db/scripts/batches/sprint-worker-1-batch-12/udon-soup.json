      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "This recipe uses thick egg noodles as an accessible substitute for fresh udon. If you can find fresh or frozen udon at an Asian supermarket, use those and follow the packet cooking time." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
