            { "ingredientSlug": "stock-chicken", "amount": 1500, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "soy-sauce-dark", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
