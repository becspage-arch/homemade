        "attrs": {
          "items": [
            {
              "symptom": "Sauce is very bitter from the lemon.",
              "cause": "Lemon pith and seeds were left in the slices.",
              "fix": "Slice lemon thin and remove all seeds before adding."
            },
            {
              "symptom": "Chicken is dry and stringy.",
              "cause": "It cooked at too high a heat with the lid off.",
              "fix": "Keep the braise covered on a low simmer."
            }
          ]
        }
