      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season the chicken on both sides with salt." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a large pan over a medium-high heat. Brown the chicken in batches for 3 minutes per side until golden. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Cook the onions in the same pan for 10 minutes until soft and golden." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, cumin, coriander, turmeric and cinnamon. Cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the chicken to the pan. Add the lemon slices, saffron water and 200ml of water. Bring to a simmer, cover and cook for 25 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the olives and cook uncovered for a further 10 minutes until the sauce thickens. Season. Scatter over fresh coriander and serve with couscous or flatbreads." }] }]
          }
        ]
      },
      {
        "type": "heading",
