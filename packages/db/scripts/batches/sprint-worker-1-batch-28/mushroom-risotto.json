        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "arborio-rice", "amount": 320, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "mushrooms-chestnut", "amount": 400, "unit": "g", "prepNote": "sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 1, "unit": "whole", "prepNote": "finely diced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 3, "unit": "cloves", "prepNote": "minced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "thyme-fresh", "amount": 3, "unit": "sprigs", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "white-wine-vinegar", "amount": 150, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "stock-chicken", "amount": 1200, "unit": "ml", "prepNote": "kept hot in a separate pan", "isOptional": false, "groupLabel": null },
