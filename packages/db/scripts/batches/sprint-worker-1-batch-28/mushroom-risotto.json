            { "symptom": "Rice is still hard after 20 minutes.", "cause": "Stock was not hot enough or heat was too low.", "fix": "Raise heat and keep adding hot stock until rice is tender." },
            { "symptom": "Risotto spread flat on the plate.", "cause": "Too much liquid left in the pan.", "fix": "Cook one more minute, stirring, before serving." }
