        "type": "paragraph",
        "content": [{ "type": "text", "text": "Good risotto needs patience and hot stock. Keep the stock simmering in a separate pan and add it one ladle at a time." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
