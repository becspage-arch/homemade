          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 200 degrees C." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put all the vegetables except the cherry tomatoes into a large roasting tin. Add the olive oil, balsamic vinegar, and thyme. Season well and toss to coat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spread into a single layer. Roast for 25 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cherry tomatoes. Toss everything gently and return to the oven for a further 15 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Check the vegetables are tender and slightly charred at the edges. Scatter over the basil and serve." }] }] }
