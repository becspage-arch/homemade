        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the soy sauce, honey, 2 teaspoons of sesame oil, garlic, ginger, and grated pear in a bowl. Add the beef and toss to coat. Cover and chill for 30 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the sushi rice while the beef marinates." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the gochujang with the remaining 1 teaspoon of sesame oil and a splash of water to make a dipping sauce. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a frying pan over high heat until very hot. Cook the beef in batches for 1 to 2 minutes per batch. Do not stir; let it caramelise on one side first." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide the rice into bowls. Top with the beef, cucumber, carrot, and spring onion." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve the gochujang sauce on the side." }] }] }
