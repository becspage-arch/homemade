      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring a large pan of well-salted water to the boil. Cook the spaghetti until al dente. Reserve a mugful of pasta water before draining." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a large frying pan over medium heat. Add the garlic and chilli flakes. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cherry tomatoes. Cook for 5 minutes until they begin to break down." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the white wine vinegar. Simmer for 2 minutes until reduced by half." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the prawns. Cook for 2 minutes, turning once, until pink and just cooked through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the drained pasta and a splash of pasta water. Toss over the heat for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Squeeze over the lemon juice. Add the parsley. Toss once more and serve." }] }] }
        ]
      },
