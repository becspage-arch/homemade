          "items": [
            { "symptom": "Stew is thin and watery.", "cause": "Beans not mashed or too much stock added.", "fix": "Mash more beans and simmer uncovered for 5 more minutes." },
            { "symptom": "Beans turned mushy.", "cause": "Simmered too long or tin beans were already very soft.", "fix": "Add beans later in the cook and check after 5 minutes." },
            { "symptom": "Stew tastes flat despite the herbs.", "cause": "Under-seasoned or lemon not yet added.", "fix": "Add more salt and the lemon juice; taste again before serving." }
