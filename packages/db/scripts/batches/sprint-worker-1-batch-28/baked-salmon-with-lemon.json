        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 200 degrees C. Line the roasting tin with baking paper." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the olive oil, lemon zest, lemon juice, mustard, and garlic in a small bowl." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place the lemon slices in the tin to form a bed for the fish." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lay the salmon fillets on top, skin side down. Spoon the glaze over each piece." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bake for 12 to 15 minutes. The fish is ready when it flakes easily with a fork at the thickest point." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter the dill over the top and serve straight from the tin." }] }] }
        ]
