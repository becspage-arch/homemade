            { "symptom": "Sauce is very tangy.", "cause": "Too much lemon juice or too many capers.", "fix": "Balance with a splash of cream and more pasta water." },
            { "symptom": "Cream sauce looks split.", "cause": "Heat was too high when cream was added.", "fix": "Remove from heat and whisk in a spoonful of pasta water." }
