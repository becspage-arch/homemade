          "items": [
            { "symptom": "Halloumi turned rubbery and did not brown.", "cause": "Wok was not hot enough or pieces were too close together.", "fix": "Use a very hot dry wok and fry in two batches." },
            { "symptom": "Sauce is very thin.", "cause": "Full-fat coconut milk not used or too much liquid added.", "fix": "Simmer uncovered for 2 to 3 minutes to reduce the sauce." },
            { "symptom": "Pak choi is limp and overcooked.", "cause": "Added too early alongside the beans.", "fix": "Add pak choi for the last 2 minutes only; it wilts very fast." }
          ]
