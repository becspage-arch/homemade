      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 200 degrees C. Toss half the squash with a tablespoon of olive oil and season. Spread on a roasting tin and roast for 25 minutes until golden at the edges. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the remaining oil in a large saucepan over medium heat. Cook the onion for 4 minutes until soft. Add the garlic and sage. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the remaining raw squash. Stir for 2 minutes to coat in the oil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the rice. Stir for 2 minutes until the edges look translucent." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the white wine vinegar. Stir until absorbed." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the hot stock one ladle at a time. Stir after each addition and wait until absorbed before adding more. The rice will take about 20 minutes total." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mash the cooked base squash roughly into the risotto. Stir in the butter and parmesan." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spoon into bowls. Top with the roasted squash and toasted pine nuts. Serve at once." }] }] }
        ]
      },
