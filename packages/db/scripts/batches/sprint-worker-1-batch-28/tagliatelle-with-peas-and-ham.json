        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the pasta in well-salted boiling water according to the packet. Reserve a mugful of pasta water before draining." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry the pancetta in a dry frying pan over medium-high heat for 5 minutes until crispy. Remove with a slotted spoon and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the butter and garlic to the pan. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the cream. Simmer for 2 minutes until slightly thickened." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the peas. Cook for 2 minutes from frozen." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the drained pasta and a splash of pasta water. Toss well." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the parmesan and crispy pancetta. Remove from the heat. Scatter over the mint and serve." }] }] }
