            {
              "symptom": "Fish is falling apart in the broth",
              "cause": "Overcooked or stirred too roughly.",
              "fix": "Ladle gently to serve and do not stir once fish is in."
            },
            {
              "symptom": "Broth has separated and looks oily",
              "cause": "Coconut milk boiled too vigorously.",
              "fix": "Lower heat and stir well. It will come back together."
            }
          ]
        }
