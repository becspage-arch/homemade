        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring a large pot of well-salted water to the boil. Cook the spaghetti according to the packet, then drain, reserving a mugful of pasta water." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the pasta cooks, warm the olive oil in a large frying pan over a medium heat. Add the anchovies and stir until they have completely dissolved into the oil, about 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and chilli flakes and cook for 1 minute until the garlic is just golden at the edges." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the tinned tomatoes, crushing them with the back of a spoon. Add the olives and capers and simmer for 12 to 15 minutes until the sauce has thickened slightly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the drained spaghetti to the pan and toss well, adding a splash of pasta water to loosen if needed. Scatter over the parsley and serve at once." }] }]
          }
        ]
      },
      {
