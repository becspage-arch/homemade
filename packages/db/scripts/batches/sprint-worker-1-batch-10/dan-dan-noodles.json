          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix together the peanut butter, soy sauce, sesame oil, miso, chilli flakes, gochugaru and chicken stock in a bowl until smooth. Taste and adjust." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the noodles in boiling water according to the packet. Drain, rinse under cold water and divide between four deep bowls." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a wok over a high heat. Add a splash of oil, then fry the pork mince, breaking it up, for 5 to 6 minutes until golden and slightly crisp." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and ginger to the wok and stir for 1 minute. Add 2 tablespoons of soy sauce and toss to coat." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spoon the sauce over the noodles, then top with the pork, spring onions and crushed peanuts." }] }]
          }
        ]
