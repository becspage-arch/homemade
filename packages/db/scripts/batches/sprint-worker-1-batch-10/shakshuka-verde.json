        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a wide frying pan over a medium heat. Add the onion and cook for 8 minutes until soft. Add the garlic and green chilli and cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the grated courgette and cumin and coriander. Cook, stirring, for 5 minutes until the courgette has softened and released its liquid." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the spinach in handfuls and stir until fully wilted. Season well with salt and pepper." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make 8 wells in the sauce and crack an egg into each. Season the eggs. Cover the pan with a lid and cook on a medium-low heat for 4 to 5 minutes until the whites are just set." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from the heat and scatter over the crumbled feta and fresh coriander. Serve with flatbread or crusty bread." }] }]
          }
        ]
      },
      {
        "type": "heading",
