      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a wide, heavy-based pan over a medium heat. Add the cumin seeds and fry for 30 seconds until they begin to sizzle." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion and cook for 12 minutes, stirring often, until deep golden brown." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger, turmeric, ground cumin and ground coriander. Cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes and cook for 8 minutes until the sauce has reduced and the oil starts to separate around the edges." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chicken and stir to coat. Cook for 8 minutes, turning once, until sealed." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the spinach in large handfuls, stirring until each batch wilts. Add 100ml of water, cover and cook for 10 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the cream and garam masala. Simmer for 5 more minutes and serve with rice or naan." }] }]
          }
        ]
      },
