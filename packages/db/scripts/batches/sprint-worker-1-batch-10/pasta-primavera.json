      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the pasta in plenty of well-salted boiling water until al dente. Drain, saving a large mugful of pasta water." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a wide frying pan over a medium-high heat. Add the courgette and red pepper and cook for 5 to 6 minutes, stirring now and then, until softened and lightly golden." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and cook for 1 minute. Add the cherry tomatoes and peas, toss everything together and cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Tip the drained pasta into the pan. Add the lemon zest, a good squeeze of lemon juice and a splash of pasta water. Toss well to coat." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from the heat and stir in half the parmesan. Divide between bowls and top with the basil and remaining parmesan." }] }]
          }
        ]
      },
