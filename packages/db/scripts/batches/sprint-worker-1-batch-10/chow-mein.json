      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the noodles according to the packet. Drain, rinse with cold water and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat 2 tablespoons of oil in a wok over the highest heat until smoking. Add the chicken in a single layer and cook without stirring for 2 minutes, then stir-fry for 2 more minutes until cooked through. Remove to a plate." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the remaining oil to the wok. Add the carrot and cabbage and stir-fry for 2 minutes. Add the garlic, ginger and spring onions and cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the noodles and the chicken back to the wok. Pour over the soy sauce and oyster sauce and toss everything together for 2 minutes over high heat." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from the heat, drizzle with sesame oil and serve immediately." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
