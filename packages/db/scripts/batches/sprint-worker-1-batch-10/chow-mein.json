      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Noodles clumping together",
              "cause": "Not enough oil or heat, or noodles over-cooked.",
              "fix": "Add a splash of water and toss fast over high heat."
            },
            {
              "symptom": "Chicken is dry and rubbery",
              "cause": "Overcooked, often from too many pieces in the pan.",
              "fix": "Fry in a single layer and remove as soon as cooked through."
            }
          ]
        }
      }
