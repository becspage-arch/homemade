            {
              "symptom": "Rice is still crunchy after 20 minutes",
              "cause": "Not enough liquid or heat too low.",
              "fix": "Add 100ml of hot water, cover and cook for 10 more minutes."
            },
            {
              "symptom": "Rice has caught and burned on the bottom",
              "cause": "Heat too high or pot too thin.",
              "fix": "Use a heavy-based pot and the lowest possible heat."
            }
          ]
        }
      }
