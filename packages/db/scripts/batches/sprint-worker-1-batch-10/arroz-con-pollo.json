      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a large, wide pot over a medium-high heat. Season the chicken and brown in batches for 3 to 4 minutes per side. Remove to a plate." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the onion and red peppers and cook for 8 minutes until soft. Add the garlic, paprika, cumin, oregano and tomato puree. Cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes and cook for 3 minutes. Add the rinsed rice and stir to coat in the spices." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the chicken to the pot. Pour over the hot stock and add the bay leaves. Bring to the boil, cover tightly and reduce to the lowest possible heat. Cook for 20 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter the frozen peas over the top without stirring. Replace the lid and cook for 5 more minutes until the peas are heated through and the rice is fully cooked." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from the heat and leave to rest, lid on, for 5 minutes. Discard the bay leaves and serve." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
