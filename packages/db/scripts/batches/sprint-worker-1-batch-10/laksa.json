      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a splash of oil in a large pot over a medium heat. Fry the red curry paste with the garlic and ginger for 2 minutes, stirring constantly, until fragrant." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the chicken stock and bring to the boil. Add the coconut milk, reduce to a gentle simmer and cook for 10 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the fish sauce and lime juice. Taste and adjust." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pak choi and prawns to the simmering broth. Cook for 3 to 4 minutes until the prawns are pink and curled and the pak choi is just tender." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide the cooked rice noodles between deep bowls. Ladle over the broth, prawns and pak choi. Top with spring onions, thai basil and a wedge of lime." }] }]
          }
        ]
      },
      {
