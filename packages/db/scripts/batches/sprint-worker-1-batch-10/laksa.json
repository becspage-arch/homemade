            {
              "symptom": "Broth looks curdled and greasy",
              "cause": "Coconut milk boiled too hard.",
              "fix": "Lower the heat and whisk to bring it back together."
            },
            {
              "symptom": "Prawns are rubbery",
              "cause": "Overcooked. Prawns need only 3 to 4 minutes.",
              "fix": "Add prawns last and remove from heat as soon as they curl."
            }
          ]
        }
