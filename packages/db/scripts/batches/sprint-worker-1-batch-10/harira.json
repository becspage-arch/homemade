        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a splash of oil in a large pot over a medium heat. Add the lamb mince and cook, breaking it up, for 5 to 6 minutes until browned all over. Remove to a plate." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In the same pot, cook the onion and celery with a pinch of salt for 8 minutes until soft." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add all the dry spices and the tomato puree. Stir for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes, stock, red lentils and browned lamb. Bring to the boil, then reduce to a steady simmer and cook for 20 minutes until the lentils have completely dissolved and thickened the soup." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chickpeas and cook for a further 10 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Turn off the heat. Stir in the lemon juice, fresh coriander and parsley. Taste for seasoning and serve." }] }]
          }
        ]
      },
