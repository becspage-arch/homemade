        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the ghee in a wide, heavy pan over a medium heat. Add the onion and cook for 15 minutes until very soft and pale golden." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger, cardamom, ground coriander, ground cumin and turmeric. Cook for 2 minutes, stirring constantly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the ground almonds and stir for 1 minute. Add the chicken pieces and stir to coat in the spice paste." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the coconut milk and bring to a gentle simmer. Cook for 12 minutes until the chicken is cooked through." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lower the heat and stir in the yoghurt and cream. Do not let it boil. Cook gently for 5 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the garam masala, taste for seasoning and serve with basmati rice." }] }]
          }
        ]
      },
