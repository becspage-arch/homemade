    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [{"type": "text", "text": "This is a fast, crisp Jamaican side of sautéed white cabbage. It gives the plate colour and a little heat from scotch bonnet. Keep the heat high and move the cabbage quickly so it softens without going limp."}]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "What you need"}]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {"ingredientSlug": "cabbage-white", "amount": 1, "unit": "each", "prepNote": "quartered, cored and finely shredded", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "onion", "amount": 1, "unit": "each", "prepNote": "halved and thinly sliced", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "scotch-bonnet", "amount": 1, "unit": "each", "prepNote": "deseeded and finely chopped", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "garlic", "amount": 2, "unit": "cloves", "prepNote": "crushed", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "carrot", "amount": 1, "unit": "each", "prepNote": "peeled and grated", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "thyme", "amount": 4, "unit": "sprigs", "prepNote": "leaves stripped", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "vegetable-oil", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "allspice", "amount": 0.25, "unit": "tsp", "prepNote": "ground", "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "salt-table", "amount": 0.5, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null},
            {"ingredientSlug": "black-pepper", "amount": 0.25, "unit": "tsp", "prepNote": "ground", "isOptional": false, "groupLabel": null}
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oil in the frying pan over a high heat until it shimmers."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the onion and cook for 2 minutes, stirring often, until starting to soften."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic and scotch bonnet. Stir for 30 seconds until fragrant."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Tip in the cabbage and carrot. Toss everything together using tongs or a wooden spoon."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the thyme, allspice, salt and pepper. Stir and cook for 6 minutes over a high heat."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The cabbage should still have some bite. Taste and adjust the seasoning."}]}]},
          {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Serve immediately while the cabbage is still crisp and bright."}]}]}
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {"symptom": "The cabbage is limp and watery.", "cause": "The pan was not hot enough or too much cabbage was added at once.", "fix": "Use a wide pan on a high heat. Cook in two batches if the pan is crowded."},
            {"symptom": "It tastes bland.", "cause": "The seasoning was added too late or not enough salt was used.", "fix": "Season at the same time as the cabbage goes in, not at the end."},
            {"symptom": "It is too spicy.", "cause": "The scotch bonnet seeds were left in.", "fix": "Always deseed the scotch bonnet. Use half a chilli next time for a milder result."}
          ]
        }
      }
