      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Method"}]},
      {"type": "orderedList", "content": [
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Toss the julienned carrot with rice vinegar and a pinch of salt. Set aside to pickle while you cook."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cook the rice per the packet instructions. Keep warm."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat a little oil in the frying pan over a high heat. Add the garlic and ginger. Cook for 30 seconds."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the pork mince. Break it up and fry until golden, about 8 minutes."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the soy sauce, fish sauce, honey, and lime juice. Stir and cook for 2 more minutes."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Spoon rice into bowls. Top with pork, pickled carrot, cucumber, spring onion, and coriander."}]}]}
      ]},
