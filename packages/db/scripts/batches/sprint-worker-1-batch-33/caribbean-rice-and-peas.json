    "content": [
      {"type": "paragraph", "content": [{"type": "text", "text": "The rice cooks directly in coconut milk, which makes it rich and creamy. Do not lift the lid while it cooks or the steam will escape."}]},
      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "What you need"}]},
      {"type": "ingredientsList", "attrs": {"defaultServings": 4, "items": [
        {"ingredientSlug": "long-grain-rice", "amount": 350, "unit": "g", "prepNote": "rinsed", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "kidney-beans", "amount": 400, "unit": "g", "prepNote": "tinned, drained", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "coconut-milk", "amount": 400, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "garlic", "amount": 3, "unit": "cloves", "prepNote": "crushed", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "spring-onion", "amount": 3, "unit": "whole", "prepNote": null, "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "thyme-fresh", "amount": 3, "unit": "sprigs", "prepNote": null, "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "kaffir-lime-leaves", "amount": 2, "unit": "leaves", "prepNote": null, "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "chilli-green", "amount": 1, "unit": "whole", "prepNote": "whole, left intact", "isOptional": false, "groupLabel": null}
      ]}},
      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Method"}]},
      {"type": "orderedList", "content": [
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Put the coconut milk in the saucepan. Add 350ml of water. Bring to a simmer."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, spring onion, thyme, and kaffir lime leaves. Add the whole chilli."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the kidney beans and rice. Stir once. Season well with salt."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bring to the boil, then turn the heat to very low. Cover and cook for 18 minutes."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Take off the heat. Leave with the lid on for 5 minutes. Then fluff with a fork."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Remove the thyme sprigs, kaffir lime leaves, and chilli before serving."}]}]}
      ]},
      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Troubleshooting"}]},
      {"type": "troubleshooter", "attrs": {"items": [
        {"symptom": "Rice is sticky or wet.", "cause": "Too much liquid or heat too high.", "fix": "Spread on a tray and leave to steam off for 5 minutes."},
        {"symptom": "Rice is undercooked.", "cause": "Lid was lifted during cooking.", "fix": "Cover, add 2 tbsp water, cook 5 more minutes on low."}
      ]}}
