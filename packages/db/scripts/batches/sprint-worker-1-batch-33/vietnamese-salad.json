      ]}},
      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Method"}]},
      {"type": "orderedList", "content": [
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mix the lime juice, fish sauce, palm sugar, and chilli in a small bowl. Stir until the sugar dissolves."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Put the noodles in a large bowl. Add the carrot, cucumber, and green papaya."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the prawns and all the herbs. Pour over the dressing."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Toss everything gently to coat. Taste and adjust salt or lime if needed."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scatter over the crushed peanuts. Serve straight away."}]}]}
      ]},
