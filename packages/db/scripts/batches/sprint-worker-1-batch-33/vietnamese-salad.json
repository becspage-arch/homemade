        {"ingredientSlug": "noodles-glass", "amount": 150, "unit": "g", "prepNote": "soaked in hot water for 5 minutes, then drained", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "cucumber", "amount": 1, "unit": "whole", "prepNote": "julienned", "isOptional": false, "groupLabel": null},
