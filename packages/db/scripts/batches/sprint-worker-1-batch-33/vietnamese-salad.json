        {"ingredientSlug": "green-papaya", "amount": 1, "unit": "whole", "prepNote": "peeled and shredded", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "mint", "amount": 30, "unit": "g", "prepNote": "leaves picked", "isOptional": false, "groupLabel": null},
