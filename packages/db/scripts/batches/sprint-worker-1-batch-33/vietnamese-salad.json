    "content": [
      {"type": "paragraph", "content": [{"type": "text", "text": "This salad comes together quickly once the noodles are soaked. Use all three herbs if you can as each one adds something different."}]},
      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "What you need"}]},
