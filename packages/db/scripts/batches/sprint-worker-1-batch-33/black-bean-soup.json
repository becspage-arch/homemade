        {"ingredientSlug": "lime", "amount": 2, "unit": "whole", "prepNote": "juiced", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "coriander-fresh", "amount": 20, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "soured-cream", "amount": 100, "unit": "g", "prepNote": "to serve", "isOptional": false, "groupLabel": null}
      ]}},
      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Method"}]},
      {"type": "orderedList", "content": [
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the olive oil in the stockpot over a medium heat. Add the onion and green pepper. Cook for 8 minutes until soft."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, cumin, oregano, and chilli flakes. Cook for 1 minute."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the black beans and vegetable stock. Bring to the boil, then simmer for 20 minutes."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scoop half the soup into a blender. Blend until smooth, then stir it back in."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the lime juice. Taste and season with salt."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ladle into bowls. Top with soured cream and fresh coriander."}]}]}
      ]},
