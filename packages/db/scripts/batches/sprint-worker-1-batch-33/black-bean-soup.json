    "content": [
      {"type": "paragraph", "content": [{"type": "text", "text": "This soup gets its body from blending half of it, which gives a creamy result without any cream. It keeps well and tastes even better the next day."}]},
      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "What you need"}]},
      {"type": "ingredientsList", "attrs": {"defaultServings": 4, "items": [
        {"ingredientSlug": "black-beans", "amount": 800, "unit": "g", "prepNote": "2 x 400g tins, drained", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "onion", "amount": 2, "unit": "whole", "prepNote": "diced", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "garlic", "amount": 6, "unit": "cloves", "prepNote": "crushed", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "pepper-green", "amount": 1, "unit": "whole", "prepNote": "diced", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "cumin-ground", "amount": 2, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "oregano-dried", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "chilli-flakes", "amount": 0.5, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "stock-vegetable", "amount": 800, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null},
