    "content": [
      {"type": "paragraph", "content": [{"type": "text", "text": "This ceviche uses cooked prawns so no raw fish handling is needed. The lime and lemon juice cures the flavour while the prawns stay tender."}]},
      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "What you need"}]},
      {"type": "ingredientsList", "attrs": {"defaultServings": 4, "items": [
        {"ingredientSlug": "king-prawns", "amount": 500, "unit": "g", "prepNote": "cooked and peeled", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "lime", "amount": 4, "unit": "whole", "prepNote": "juiced", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "lemon", "amount": 1, "unit": "whole", "prepNote": "juiced", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "onion", "amount": 1, "unit": "whole", "prepNote": "finely sliced", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "chilli-red", "amount": 2, "unit": "whole", "prepNote": "finely sliced", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "coriander-fresh", "amount": 40, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "avocado", "amount": 1, "unit": "whole", "prepNote": "cubed", "isOptional": false, "groupLabel": null},
        {"ingredientSlug": "cucumber", "amount": 1, "unit": "whole", "prepNote": "diced", "isOptional": false, "groupLabel": null}
      ]}},
      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Method"}]},
      {"type": "orderedList", "content": [
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Put the prawns in a bowl. Add the lime juice and lemon juice. Stir to coat."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the onion and chilli. Season with salt. Stir gently."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cover and chill for 30 minutes. The onion will soften slightly."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the avocado, cucumber, and most of the coriander. Fold in gently."}]}]},
        {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scatter over the remaining coriander. Serve straight away."}]}]}
      ]},
      {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Troubleshooting"}]},
      {"type": "troubleshooter", "attrs": {"items": [
