        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the yoghurt with 3 cloves of crushed garlic, the lemon zest and juice, oregano, cumin, paprika, and olive oil. Season with salt." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chicken thighs and coat them well. Cover and chill for at least 1 hour." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the tzatziki: grate the cucumber and squeeze out as much liquid as possible. Mix with the remaining 1 clove grated garlic and the mint. Season with salt. Refrigerate until needed." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Preheat the oven to 220C." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spread the chicken in the roasting tin in a single layer. Roast for 22 to 25 minutes until cooked through and charred in places." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rest for 5 minutes. Slice the chicken into strips." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve the chicken with the tzatziki, crumbled feta, and warm flatbread or rice." }] }]
          }
        ]
      },
