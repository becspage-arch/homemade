          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scoop the avocado flesh into a bowl. Add the lemon zest and most of the lemon juice." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Smash roughly with a fork. You want chunks, not a smooth paste." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season well with salt, black pepper, and the chilli flakes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toast your bread until golden and firm." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "If poaching eggs: bring a pan of water to a gentle simmer. Swirl the water and slide in one egg at a time. Cook for 3 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pile the avocado onto the toast. Top with a poached egg if using." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drizzle with olive oil. Scatter over the mint and a pinch more chilli." }] }]
          }
        ]
