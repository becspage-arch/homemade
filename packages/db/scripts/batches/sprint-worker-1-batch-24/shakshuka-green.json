      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Warm the olive oil in the pan over a medium heat." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the leek and cook for 6 minutes, stirring often, until soft." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the garlic and chilli. Cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the spices and stir to coat everything." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the spinach in handfuls. Stir each batch until wilted before adding the next." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season with salt. Spread the greens into an even layer." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make 6 small wells in the greens. Crack one egg into each well." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover the pan and cook on low heat for 6 to 8 minutes, until the whites are set." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter over the feta and fresh coriander. Serve straight from the pan." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The egg whites are still clear after 8 minutes.",
              "cause": "The pan temperature was too low or the lid was not fully sealed.",
              "fix": "Increase heat slightly and replace lid for 2 more minutes."
            },
            {
              "symptom": "The greens are watery and thin.",
              "cause": "Spinach released moisture before it could evaporate.",
              "fix": "Cook uncovered on medium heat for 2 minutes to evaporate."
            },
            {
              "symptom": "The garlic has caught and tastes bitter.",
              "cause": "Garlic went in when the pan was too hot.",
              "fix": "Remove bitter pieces and add a small splash of water."
            }
          ]
        }
      }
