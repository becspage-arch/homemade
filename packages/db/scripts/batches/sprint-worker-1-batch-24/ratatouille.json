        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Preheat the oven to 180C." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the aubergine and courgette in the roasting tin. Drizzle with 3 tbsp olive oil and season with salt." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast for 20 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Meanwhile, warm the remaining olive oil in the large saucepan over a medium heat. Add the onion and cook for 8 minutes until soft." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, peppers, and tomatoes. Cook for 5 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the roasted aubergine and courgette to the saucepan. Add the thyme, rosemary, and balsamic vinegar." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season well. Cook on a low heat for 20 minutes, stirring occasionally, until everything is soft and the sauce has thickened." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the herb stalks. Tear over the basil and serve." }] }]
          }
        ]
