        "type": "paragraph",
        "content": [{ "type": "text", "text": "Make the flatbreads first and set them aside. You can cook the chicken and flatbread filling at the same time if you have two pans going." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "self-raising-flour", "amount": 250, "unit": "g", "prepNote": "plus extra for dusting", "isOptional": false, "groupLabel": "Flatbreads" },
            { "ingredientSlug": "olive-oil", "amount": 3, "unit": "tbsp", "prepNote": "1 tbsp for the dough, 2 tbsp for cooking chicken", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chicken-breast", "amount": 500, "unit": "g", "prepNote": "thinly sliced", "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "onion", "amount": 1, "unit": "medium", "prepNote": "thinly sliced", "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "pepper-red", "amount": 2, "unit": "medium", "prepNote": "deseeded and sliced", "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "pepper-yellow", "amount": 1, "unit": "medium", "prepNote": "deseeded and sliced", "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "garlic", "amount": 2, "unit": "cloves", "prepNote": "crushed", "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "cumin-ground", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": "Filling" },
