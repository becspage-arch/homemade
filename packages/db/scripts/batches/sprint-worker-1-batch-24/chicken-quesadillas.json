      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the flatbreads: mix the flour with a pinch of salt and 1 tbsp olive oil. Add 120 to 150 ml water, a little at a time, until you have a soft dough." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide into 8 equal pieces. Roll each one out thinly on a floured surface." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook each flatbread in a dry hot pan for 1 minute per side. Set aside on a plate." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add 2 tbsp olive oil to the pan over high heat. Add the chicken and cook for 4 minutes until golden." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion and peppers. Cook for 5 minutes until soft." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the garlic and spices. Cook for 1 more minute. Season with salt." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lay one flatbread in the pan over low heat. Spread chicken mix on half, then scatter with cheese." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fold the flatbread over. Press gently. Cook for 1 to 2 minutes per side until golden and the cheese has melted." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cut into wedges. Serve with soured cream, lime, and coriander." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The cheese is not melting before the flatbread burns.",
              "cause": "Heat is too high or the filling was added cold.",
              "fix": "Lower the heat and cover the pan with a lid for 1 minute."
            },
            {
              "symptom": "The flatbread is chewy and doughy.",
              "cause": "It was not rolled thin enough or not cooked at high enough heat.",
              "fix": "Roll thinner next time and use a very hot dry pan."
            }
          ]
        }
      }
    ]
  }
