        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Preheat the oven to 220C." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss the aubergine, courgette, pepper, onion, garlic, and cherry tomatoes with the olive oil, cumin, and paprika. Season with salt." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spread in the roasting tin. Roast for 25 to 30 minutes until golden and caramelised." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the vegetables roast, put the couscous in a large bowl. Pour over 300ml of just-boiled water. Cover with a plate and leave for 5 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fluff the couscous with a fork. Add the lemon zest, lemon juice, and a drizzle of olive oil. Season." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toast the almonds in a dry pan until golden. Set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Squeeze the roasted garlic cloves from their skins and mix into the couscous." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Tip the roasted vegetables over the couscous. Scatter the parsley and almonds on top. Serve warm or at room temperature." }] }]
          }
        ]
      },
