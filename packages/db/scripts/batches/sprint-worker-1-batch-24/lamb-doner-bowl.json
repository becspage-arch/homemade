        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Preheat the oven to 200C." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the lamb mince with the onion, garlic, and all the spices. Season generously with salt and pepper." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Shape the mix into a flat loaf roughly 20 cm long and 3 cm thick. Place in the roasting tin." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast for 25 to 30 minutes until cooked through and slightly charred on top." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the lamb roasts, cook the rice according to the packet or in a rice cooker." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the cucumber and tomatoes. Season with salt and a squeeze of lemon." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rest the lamb for 5 minutes. Slice thinly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Build the bowls: rice, then lamb slices, then salad, yoghurt, and mint. Serve with lemon wedges." }] }]
