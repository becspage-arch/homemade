            {
              "symptom": "The chicken skin is pale and soft after browning.",
              "cause": "Pan was not hot enough or skin was still wet.",
              "fix": "Pat skin dry and use higher heat; do not move chicken while browning."
            },
            {
              "symptom": "The sauce is too acidic.",
              "cause": "Vinegar or wine was not cooked down enough.",
              "fix": "Simmer uncovered and add a small pinch of sugar."
            }
          ]
        }
      }
