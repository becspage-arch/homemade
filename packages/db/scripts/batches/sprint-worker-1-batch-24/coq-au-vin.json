        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season the chicken legs with salt and pepper." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt the butter in the stockpot over a medium-high heat. Brown the chicken skin-side down for 5 minutes until golden. Flip and cook for 2 minutes more. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pancetta. Cook for 3 minutes until lightly browned. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce heat to medium. Add the onion and cook for 5 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, tomato puree, and flour. Stir and cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the wine and stock. Stir and scrape up anything stuck to the bottom." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the chicken and pancetta. Add the thyme and bay leaves. Bring to a gentle simmer." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover and cook on the lowest heat for 1 hour." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the mushrooms. Cook uncovered for 20 more minutes until the sauce thickens." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the bay leaves and thyme. Scatter parsley over the top. Serve with mashed potato or crusty bread." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
