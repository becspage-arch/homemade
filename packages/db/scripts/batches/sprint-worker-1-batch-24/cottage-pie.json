      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Preheat the oven to 200C." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Boil the potatoes in salted water for 15 to 20 minutes until tender. Drain well." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mash the potatoes with the butter and warm milk until smooth. Season with salt. Set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In the stockpot over a high heat, brown the mince in batches until coloured. Drain off excess fat." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion, carrot, and celery. Cook for 5 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, tomato puree, and worcestershire sauce. Cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the stock. Add thyme and bay leaves. Simmer for 15 minutes until thick." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove bay leaves. Tip the filling into a large baking dish." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spoon the mash over the top. Spread gently and drag a fork across the surface to create ridges." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bake for 20 to 25 minutes until the top is golden and the filling is bubbling." }] }]
          }
        ]
      },
