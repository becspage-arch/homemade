      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Make the filling first and let it cool slightly before adding the pastry top. If you add the pastry to a very hot filling, the bottom will go soggy before it bakes." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "chicken-breast", "amount": 600, "unit": "g", "prepNote": "diced into 2cm pieces", "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "leek", "amount": 2, "unit": "medium", "prepNote": "sliced", "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "carrot", "amount": 2, "unit": "medium", "prepNote": "diced", "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "peas-frozen", "amount": 150, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "unsalted-butter", "amount": 60, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "plain-flour", "amount": 60, "unit": "g", "prepNote": "for filling roux", "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "whole-milk", "amount": 450, "unit": "ml", "prepNote": "400ml for filling sauce, 50ml for pastry dough", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "stock-chicken", "amount": 200, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "thyme-fresh", "amount": 2, "unit": "sprigs", "prepNote": null, "isOptional": false, "groupLabel": "Filling" },
            { "ingredientSlug": "self-raising-flour", "amount": 200, "unit": "g", "prepNote": "for pastry top", "isOptional": false, "groupLabel": "Pastry top" }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Preheat the oven to 200C." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt 20g of the butter in the stockpot over a medium-high heat. Add the chicken and cook for 4 minutes until golden. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the remaining butter to the pot. Add the leek and carrot. Cook for 6 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the plain flour. Cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in 400ml of the milk and the stock gradually, stirring all the time. Add the thyme." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to a simmer and cook for 5 minutes until the sauce thickens." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the chicken and add the peas. Season well. Remove the thyme stalks. Pour into a large baking dish." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the pastry top: mix the self-raising flour with a pinch of salt. Add 50ml milk and stir to a rough, shaggy dough." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drop spoonfuls of the dough over the top of the filling, leaving gaps for steam." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bake for 20 to 25 minutes until the top is golden and the filling is bubbling at the edges." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The pastry top is still doughy in the middle after 25 minutes.",
              "cause": "Dough was dropped too thick or oven was not hot enough.",
              "fix": "Cover edges and return to the oven for 5 more minutes at 210C."
            },
            {
              "symptom": "The filling is very thin and watery.",
              "cause": "Not enough flour in the roux or sauce was not cooked long enough.",
              "fix": "Simmer the filling for longer before topping and baking."
            }
          ]
        }
      }
    ]
