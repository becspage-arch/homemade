          "items": [
            {
              "symptom": "The sauce is too thin and watery.",
              "cause": "The tomatoes were not cooked down enough.",
              "fix": "Simmer uncovered for 5 more minutes before adding eggs."
            },
            {
              "symptom": "The egg yolks set solid before the whites are done.",
              "cause": "Heat was too high, or the pan had hot spots.",
              "fix": "Cook on the lowest heat possible and keep the lid on."
            }
          ]
        }
