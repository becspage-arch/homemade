      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a dry frying pan over a high heat. Add the mince and cook without stirring for 2 minutes to get some colour." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Break the mince up with a spoon and keep cooking until browned all over. About 5 minutes total." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Push the mince to one side. Add the onion and cook in the same pan for 4 minutes until soft." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic. Stir everything together and cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add all the spices and the tomato puree. Stir to coat the mince." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the stock. Let it bubble and reduce for 3 to 4 minutes until the mince looks glossy and the liquid is mostly gone." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season with salt. Warm your taco shells in a dry pan or oven." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fill the shells with the mince. Top with tomato, avocado, and coriander. Squeeze lime over the top." }] }]
          }
        ]
      },
