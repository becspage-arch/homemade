      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 200C. Toss the aubergine, courgette, pepper, and cherry tomatoes in 3 tablespoons of olive oil. Season well. Spread across a large roasting tin in a single layer." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Nestle the unpeeled garlic cloves into the vegetables. Roast for 30 to 35 minutes until the edges are charred and the tomatoes have burst." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Meanwhile, cook the lentils. Put them in a saucepan and cover with cold water by 5cm. Bring to the boil. Simmer for 20 to 25 minutes until tender but not falling apart. Drain." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Squeeze the roasted garlic out of their skins into a small bowl. Mash with a fork. Whisk in the balsamic vinegar, lemon juice, remaining olive oil, and mustard. Season well." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Tip the warm lentils into a large bowl. Add the roasted vegetables and pour over the dressing. Toss gently." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter the parsley and crumbled feta over the top. Serve warm." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Vegetables are soft and pale, not caramelised.", "cause": "Tin was overcrowded so they steamed.", "fix": "Use two tins and spread vegetables in a single layer." },
            { "symptom": "Lentils are mushy.", "cause": "Cooked too long or started in already-boiling water.", "fix": "Start in cold water and taste from 20 minutes in." },
            { "symptom": "Salad is dry.", "cause": "Not enough dressing for the volume of lentils.", "fix": "Add a splash more olive oil and lemon juice to loosen." }
          ]
        }
      }
