    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Give the vegetables plenty of space in the roasting tin. Crowding them makes them steam rather than roast." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "lentils-green", "amount": 250, "unit": "g", "prepNote": "rinsed", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "aubergine", "amount": 1, "unit": null, "prepNote": "cut into 3cm cubes", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "courgette", "amount": 2, "unit": null, "prepNote": "cut into 3cm pieces", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "pepper-red", "amount": 2, "unit": null, "prepNote": "deseeded and cut into chunks", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cherry-tomatoes", "amount": 300, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 4, "unit": "cloves", "prepNote": "unpeeled, for roasting", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "balsamic-vinegar", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Dressing" },
            { "ingredientSlug": "olive-oil", "amount": 5, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Dressing" },
            { "ingredientSlug": "dijon-mustard", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": "Dressing" },
            { "ingredientSlug": "lemon", "amount": 1, "unit": null, "prepNote": "juice only", "isOptional": false, "groupLabel": "Dressing" },
            { "ingredientSlug": "parsley-flat", "amount": 30, "unit": "g", "prepNote": "roughly chopped", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "feta", "amount": 100, "unit": "g", "prepNote": "crumbled", "isOptional": false, "groupLabel": null }
