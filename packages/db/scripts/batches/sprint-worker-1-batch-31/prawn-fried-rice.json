        "attrs": {
          "items": [
            { "symptom": "Prawns are rubbery.", "cause": "Overcooked in the first step.", "fix": "Remove them the moment they turn pink, about 1 minute each side." },
            { "symptom": "Rice is mushy and wet.", "cause": "Rice was still warm or freshly cooked.", "fix": "Only use cold, fully chilled rice from the fridge." },
            { "symptom": "Rice lacks colour or flavour.", "cause": "Heat was too low or pan too crowded.", "fix": "Use maximum heat and cook in two batches if needed." }
          ]
        }
