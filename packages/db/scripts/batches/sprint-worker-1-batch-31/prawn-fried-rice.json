        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the wok over the highest heat for 2 minutes. Add 2 tablespoons of sunflower oil. Add the prawns in a single layer and cook for 1 minute per side until pink. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add 1 more tablespoon of oil. Add the carrot and stir-fry for 2 minutes. Add the garlic and ginger and cook for 30 seconds." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Push everything to one side. Add the remaining oil to the empty side. Pour in the beaten eggs and scramble until just set. Break them up and mix through the vegetables." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cold rice. Press and toss for 2 minutes until the grains separate and begin to colour." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the frozen peas and the soy sauce. Toss everything together and cook for 1 more minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the prawns to the wok. Toss for 30 seconds to heat through. Drizzle with sesame oil and scatter spring onion over the top." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
