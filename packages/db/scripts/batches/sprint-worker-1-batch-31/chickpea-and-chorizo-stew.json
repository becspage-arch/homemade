        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a large saucepan over medium heat. Add the chorizo slices. Cook for 3 to 4 minutes until the fat has rendered out and the edges are crispy. Remove with a slotted spoon and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In the same oil, fry the onion and peppers for 5 minutes until soft. Add the garlic and smoked paprika. Cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes, stock, and bay leaves. Stir and bring to a simmer." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chickpeas. Simmer for 15 minutes until the sauce has thickened slightly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the chorizo to the pot. Simmer for 5 more minutes. Discard the bay leaves." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste and season. Scatter parsley over the top. Serve with crusty bread." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
