        "attrs": {
          "items": [
            { "symptom": "Stew tastes bland despite the chorizo.", "cause": "Smoked paprika was not added with the onions.", "fix": "Fry paprika briefly in oil; raw paprika has much less flavour." },
            { "symptom": "Chickpeas are breaking up in the sauce.", "cause": "Stirred too vigorously after adding them.", "fix": "Add chickpeas gently and stir only occasionally." },
            { "symptom": "Sauce is thin.", "cause": "Not simmered long enough uncovered.", "fix": "Remove the lid and simmer for 10 more minutes to reduce." }
          ]
