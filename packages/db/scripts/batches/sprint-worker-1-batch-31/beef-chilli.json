      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a large saucepan over high heat. Brown the beef mince in two batches, breaking it up with a spoon. Each batch should take about 5 minutes. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add a splash of oil if needed. Fry the onion and peppers for 5 minutes until soft." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, cumin, smoked paprika, chilli flakes, and oregano. Stir for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the tomato puree and cook for 1 minute. Return the browned mince to the pot." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes, stock, and Worcestershire sauce. Stir everything together and bring to a simmer." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Simmer uncovered for 20 minutes, stirring occasionally. Add the kidney beans and cook for a further 10 minutes until the sauce is thick." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste and season. Serve with rice, soured cream, or cheddar as you like." }] }]
          }
        ]
      },
