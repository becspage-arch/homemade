    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Fry the aubergine in batches until golden before the sauce goes in. Undercooking at this stage makes the final curry watery and bland." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "aubergine", "amount": 2, "unit": null, "prepNote": "cut into 3cm cubes", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "tinned-tomatoes", "amount": 400, "unit": "g", "prepNote": "1 x 400g tin", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 1, "unit": null, "prepNote": "finely diced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 5, "unit": "cloves", "prepNote": "minced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "ginger-fresh", "amount": 3, "unit": "cm", "prepNote": "finely grated", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cumin-seeds", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
