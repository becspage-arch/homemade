      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat 2 tablespoons of ghee in a large saucepan over high heat. Fry the aubergine cubes in batches for 5 to 6 minutes until golden on most sides. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce heat to medium. Add the remaining ghee. Add the cumin seeds and let them sizzle for 20 seconds." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion with a pinch of salt. Cook for 6 to 7 minutes until soft and lightly golden." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger, and green chilli. Cook for 2 minutes. Add the coriander and turmeric. Stir for 30 seconds." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the tinned tomatoes and add 100ml water. Simmer for 8 minutes until the sauce has thickened." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the aubergine to the pan. Stir gently to coat. Simmer for 5 more minutes. Stir in the garam masala." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste and season. Scatter fresh coriander over the top. Serve with rice or bread." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Aubergine is soft and watery in the final curry.", "cause": "Not browned properly before the sauce was added.", "fix": "Fry on high heat in small batches until golden before adding sauce." },
            { "symptom": "Curry tastes flat.", "cause": "Spices added too late or garam masala skipped.", "fix": "Always stir in garam masala at the very end of cooking." },
            { "symptom": "Sauce is too thick and catching on the bottom.", "cause": "Not enough water added with the tomatoes.", "fix": "Add 50ml more water and stir the base of the pan." }
          ]
        }
      }
    ]
  }
