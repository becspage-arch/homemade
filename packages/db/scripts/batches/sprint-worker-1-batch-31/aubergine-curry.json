            { "ingredientSlug": "turmeric", "amount": 0.5, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garam-masala", "amount": 1, "unit": "tsp", "prepNote": "added at the end", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chilli-green", "amount": 2, "unit": null, "prepNote": "slit lengthways", "isOptional": true, "groupLabel": null },
            { "ingredientSlug": "ghee", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "coriander-fresh", "amount": 20, "unit": "g", "prepNote": "to serve", "isOptional": false, "groupLabel": null }
