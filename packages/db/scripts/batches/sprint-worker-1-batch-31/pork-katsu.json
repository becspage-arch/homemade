        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the sauce first. Heat a splash of oil in a saucepan over medium heat. Cook the onion and carrot for 5 minutes until soft." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and garam masala. Stir for 1 minute. Pour in the stock, soy sauce, and honey. Simmer for 10 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Blend the sauce until smooth. Return to the pan. Stir in the cornflour paste and cook over medium heat until the sauce thickens. Keep warm." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the rice according to the packet. Keep warm." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Set up three shallow bowls: one with seasoned flour, one with beaten egg, one with panko crumbs." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Coat each pork steak in flour, then egg, then panko. Press the crumbs on firmly so they stick." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour 1cm of sunflower oil into the large frying pan. Heat to 175C. Fry the steaks for 3 to 4 minutes per side until deep golden and cooked through." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drain on kitchen paper for 1 minute. Slice into strips and serve over rice with the curry sauce poured alongside." }] }]
          }
        ]
      },
