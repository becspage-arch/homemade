          "items": [
            { "symptom": "Crumbs are falling off during frying.", "cause": "Pork was not patted dry before coating.", "fix": "Pat pork dry and press the crumbs on firmly." },
            { "symptom": "Crumbs are golden but pork is still pink inside.", "cause": "Oil was too hot, browning the outside too fast.", "fix": "Lower heat and fry slower; use a probe to check 72C inside." },
            { "symptom": "Sauce is too thin.", "cause": "Not enough cornflour or sauce not simmered long enough.", "fix": "Mix another teaspoon of cornflour with water and stir in." }
