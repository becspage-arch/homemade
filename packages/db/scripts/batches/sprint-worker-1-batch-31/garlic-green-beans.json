          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the wok over the highest heat until smoking. Add the sunflower oil." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the green beans in a single layer. Leave undisturbed for 2 minutes so the skin blisters. Then toss and cook for another 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and chilli flakes. Toss and stir-fry for 1 minute until fragrant." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the soy sauce. Toss to coat. Cook for 30 seconds." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from heat. Drizzle the sesame oil over the top. Serve immediately." }] }]
