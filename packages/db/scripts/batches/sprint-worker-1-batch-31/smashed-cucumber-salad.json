        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cut the cucumbers in half lengthways, then smash firmly with the flat of a large knife or a rolling pin until they crack and split." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cut the smashed cucumbers into rough 4cm pieces. Put them in a bowl and toss with 0.5 teaspoon of salt. Leave for 10 minutes. Drain off the liquid." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the dressing. Mix together the garlic, rice vinegar, soy sauce, sesame oil, and chilli flakes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour the dressing over the cucumber and toss to coat. Cover and chill for 15 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter coriander and crushed peanuts over the top just before serving." }] }]
          }
        ]
