          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss the prawns with the cumin, smoked paprika, garlic, chilli flakes, and a pinch of salt. Set aside for 5 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a wide frying pan over high heat until very hot. Add the prawns in a single layer." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook for 1 to 2 minutes per side until pink and just cooked through. Squeeze half the lime juice over the prawns in the pan." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Arrange the sliced avocado on plates. Squeeze the remaining lime juice over the avocado." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pile the prawns alongside. Scatter coriander over everything. Serve with soured cream and extra lime wedges." }] }]
          }
        ]
