        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "eggs", "amount": 6, "unit": null, "prepNote": "beaten with a pinch of salt", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cabbage-white", "amount": 300, "unit": "g", "prepNote": "finely shredded", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "carrot", "amount": 2, "unit": null, "prepNote": "cut into thin matchsticks", "isOptional": false, "groupLabel": null },
