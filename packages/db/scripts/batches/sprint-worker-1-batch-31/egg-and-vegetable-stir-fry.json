      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the wok over high heat until smoking. Add 2 tablespoons of sunflower oil. Pour in the beaten eggs." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir quickly with a spatula until just set but still soft. Remove and set aside on a plate." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the remaining oil to the wok. Add the carrot and stir-fry for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the white spring onion, garlic, and ginger. Stir for 30 seconds." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cabbage and toss over high heat for 2 minutes until just wilted but still with some bite." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the soy sauce and rice vinegar. Toss everything together. Return the scrambled egg to the wok. Toss gently to combine." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drizzle with sesame oil. Scatter the green spring onion over the top. Serve immediately with steamed rice." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Cabbage is limp and waterlogged.", "cause": "Heat was too low and it steamed rather than stir-fried.", "fix": "Use maximum heat and keep tossing throughout." },
            { "symptom": "Egg is rubbery.", "cause": "Overcooked in the first step.", "fix": "Remove eggs from the wok while they are still soft and slightly underdone." },
            { "symptom": "Dish is too salty.", "cause": "3 tbsp soy sauce is correct but the egg was already salted.", "fix": "Use only 2 tbsp soy sauce if the eggs were seasoned well." }
