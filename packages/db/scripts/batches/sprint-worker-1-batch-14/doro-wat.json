      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat ghee in the stockpot over low heat. Add diced onions." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook slowly for 20 minutes, stirring often, until very soft and golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add garlic and ginger. Cook for 5 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add both paprikas, ground coriander, cumin, cinnamon, allspice, and cloves. Stir for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add tinned tomatoes. Cook for 10 minutes until the sauce thickens." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add chicken pieces and stir to coat. Add 200ml water." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover and simmer on low heat for 30 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Prick the hard-boiled eggs all over with a fork. Nestle them into the stew." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Simmer uncovered for 10 more minutes. Serve with injera or flatbread." }] }] }
        ]
      },
