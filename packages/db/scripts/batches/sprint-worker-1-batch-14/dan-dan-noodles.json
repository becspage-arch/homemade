        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix tahini, light soy, dark soy, sesame oil, gochujang, doubanjiang, and rice vinegar in a bowl." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook noodles in a large saucepan per pack instructions. Drain, reserving a cup of cooking water." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat sunflower oil in the wok over medium-high heat. Fry garlic and ginger for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add pork mince. Cook for 5 minutes, breaking it up, until browned all over." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide sauce between 4 serving bowls." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide hot noodles between the bowls on top of the sauce." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Top with pork, sliced spring onion, and crushed peanuts." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix everything together at the table before eating." }] }] }
