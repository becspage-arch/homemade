          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss the beef with cornflour and 1 tbsp of the soy sauce. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook noodles in a large saucepan according to pack instructions. Drain and rinse with cold water." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the wok over high heat until it is smoking." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add 2 tbsp sunflower oil. Stir-fry beef for 2 minutes until browned. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add remaining oil to the wok. Fry garlic and ginger for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add pak choi and spring onion. Stir-fry for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add noodles, beef, remaining soy sauce, and oyster sauce. Toss everything together for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drizzle over sesame oil. Serve immediately." }] }] }
