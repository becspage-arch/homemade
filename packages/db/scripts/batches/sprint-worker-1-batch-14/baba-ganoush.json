            { "ingredientSlug": "tahini", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 2, "unit": "cloves", "prepNote": "unpeeled, roasted alongside", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "lemon", "amount": 2, "unit": "whole", "prepNote": "juiced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "olive-oil", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
