            { "ingredientSlug": "long-grain-rice", "amount": 200, "unit": "g", "prepNote": "rinsed", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 4, "unit": "whole", "prepNote": "3 thinly sliced for crispy topping; 1 finely diced for the base", "isOptional": false, "groupLabel": null },
