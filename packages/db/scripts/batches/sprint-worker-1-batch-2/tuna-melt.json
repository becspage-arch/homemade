      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drain the tuna very thoroughly, pressing it in the sieve to remove as much oil as possible. Mix with the mayonnaise, celery, red onion, and Dijon mustard. Season with salt and pepper."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toast the bread slices. Place on a baking tray. Spread the tuna salad generously over the toast, all the way to the edges. Top with grated cheese."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place under a hot grill for 3 to 4 minutes until the cheese is melted and bubbling and beginning to brown in spots. Eat immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Troubleshooting"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Bread is soggy under the tuna",
              "cause": "Tuna was not drained sufficiently or the tuna salad mix was too wet",
              "fix": "Press the drained tuna hard in the sieve. Use just enough mayonnaise to bind: the mix should be spreadable but not wet."
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Variations"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Closed sandwich version: spread tuna salad between two toasted slices, top with cheese, and grill. Dill pickle in the tuna salad is a popular addition. Some versions add a thin slice of tomato under the cheese."
          }
        ]
      }
    ]
