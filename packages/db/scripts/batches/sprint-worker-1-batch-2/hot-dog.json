        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Score each frankfurter with 3 shallow diagonal cuts on each side. Heat a dry frying pan over medium-high heat. Cook the frankfurters for 5 to 6 minutes, turning occasionally, until blistered and beginning to colour in places."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Toast the split buns cut-side down in the same pan for 1 minute."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place a frankfurter in each bun. Add a stripe of mustard, a stripe of ketchup, and a spoonful of raw chopped onion."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Variations"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chicago dog: sport peppers, tomato, dill pickle, celery salt, yellow mustard, relish, and chopped white onion. No ketchup. Chili dog: topped with beef chilli and grated cheddar. Corn dog: frankfurter dipped in cornbread batter and deep-fried on a stick."
          }
        ]
      }
    ]
