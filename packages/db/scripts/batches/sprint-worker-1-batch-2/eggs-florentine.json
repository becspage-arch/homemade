            },
            {
              "ingredientSlug": "lemon",
              "amount": 1,
              "unit": "each",
              "prepNote": "juice only",
              "isOptional": false,
              "groupLabel": "Eggs and hollandaise"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Method"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Make the hollandaise"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Whisk 4 egg yolks and 2 tablespoons of water in a heatproof bowl over a pan of barely simmering water until thick and pale, about 3 to 4 minutes. Remove from the heat and gradually whisk in the melted butter in a thin stream. Season with salt, white pepper, and lemon juice. Keep warm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Cook the spinach and poach the eggs"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Melt the 15 g of butter in a pan and wilt the spinach in batches. Squeeze in a clean tea towel to remove excess liquid. Season with salt, pepper, and a little nutmeg. Keep warm."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Poach the 8 whole eggs in barely simmering water with a splash of white wine vinegar, in batches of 2 to 3 at a time, for 3 minutes each. Drain on kitchen paper."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Assemble"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Place toasted muffin halves on warm plates. Top with a mound of spinach, then a poached egg. Spoon hollandaise generously over the top. Serve immediately."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Troubleshooting"
          }
        ]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "Hollandaise has split",
              "cause": "Butter added too fast, or sauce overheated",
              "fix": "Whisk a new egg yolk in a clean bowl. Gradually add the split sauce to it as if it were the butter. Add very slowly and it will often rescue."
            }
          ]
        }
      }
    ]
  }
