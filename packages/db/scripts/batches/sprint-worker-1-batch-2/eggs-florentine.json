  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Eggs Florentine follows the same method as Eggs Benedict: hollandaise first, then poached eggs, then assemble. The spinach replaces the ham as the base. Wilt the spinach, squeeze out the water thoroughly, and season it well. The spinach will sit on the muffin and forms a bed for the egg."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            {
              "ingredientSlug": "english-muffin",
              "amount": 4,
              "unit": "each",
              "prepNote": "split and toasted",
              "isOptional": false,
              "groupLabel": "Base"
            },
            {
              "ingredientSlug": "spinach",
              "amount": 400,
              "unit": "g",
              "prepNote": "fresh",
              "isOptional": false,
              "groupLabel": "Base"
            },
            {
              "ingredientSlug": "unsalted-butter",
              "amount": 215,
