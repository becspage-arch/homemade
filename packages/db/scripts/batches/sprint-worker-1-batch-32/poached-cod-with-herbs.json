      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the parsley, dill, capers, mustard, olive oil, and juice of 1 lemon into a dressing. Add the spring onion. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour the stock into the frying pan. Add the sliced lemon. Bring to a gentle simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season the cod fillets with salt and lower them into the simmering stock." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover with a lid. Poach for 8 to 10 minutes until the flesh is opaque throughout." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lift each fillet out carefully with a slotted spatula. Drain briefly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place on warm plates and spoon the herb dressing over each piece." }] }] }
        ]
      },
