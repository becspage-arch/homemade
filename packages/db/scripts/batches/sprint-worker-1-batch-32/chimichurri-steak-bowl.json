          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the rice according to the packet instructions." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the chimichurri: combine the parsley, 2 cloves crushed garlic, red wine vinegar, 80ml olive oil, oregano, chilli flakes, and lemon juice. Season with salt and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pat the steaks dry with kitchen paper. Season generously with salt on both sides." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat 20ml oil in a large frying pan over high heat until smoking." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Sear the steaks for 3 minutes per side for medium-rare. Adjust time for your preference." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rest the steaks on a board for 5 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Slice thinly against the grain." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide the rice between bowls. Top with the sliced steak and spoon over the chimichurri." }] }] }
