      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Dress the potatoes while they are still hot so they absorb the flavour of the dressing." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "potato", "amount": 800, "unit": "g", "prepNote": "waxy variety, boiled in their skins until just tender then sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "pancetta", "amount": 150, "unit": "g", "prepNote": "lardons", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 1, "unit": "medium", "prepNote": "finely diced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "dijon-mustard", "amount": 2, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": "Dressing" },
            { "ingredientSlug": "white-wine-vinegar", "amount": 4, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Dressing" },
            { "ingredientSlug": "olive-oil", "amount": 4, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Dressing" },
            { "ingredientSlug": "chives", "amount": 20, "unit": "g", "prepNote": "finely snipped", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "parsley-flat", "amount": 20, "unit": "g", "prepNote": "finely chopped", "isOptional": false, "groupLabel": null }
          ]
