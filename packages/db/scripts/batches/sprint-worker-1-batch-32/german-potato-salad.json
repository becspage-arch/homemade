      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Boil the potatoes in salted water for 18 to 20 minutes until just tender. Drain and leave until cool enough to handle, then peel and slice." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the potatoes cook, fry the pancetta in a dry frying pan over medium heat for 5 minutes until crisp. Remove with a slotted spoon." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In the same pan, soften the diced onion in the pancetta fat for 3 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Whisk together the mustard, white wine vinegar, and olive oil. Season with salt and pepper." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the warm potato slices in a large bowl. Pour over the dressing and add the softened onion." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss gently. Add the pancetta, chives, and parsley." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste and adjust the seasoning. Serve warm." }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
