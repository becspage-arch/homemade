        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a splash of oil in the stockpot over medium heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion and celery. Cook for 5 minutes until softened." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and paprika. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the carrot, potato, and shredded cabbage. Stir to mix." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the tinned tomatoes and beef stock. Add the bay leaves." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to the boil, then reduce heat and simmer for 30 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the bay leaves. Stir in the red wine vinegar and season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Ladle into bowls. Top with fresh dill and a spoonful of soured cream." }] }] }
        ]
