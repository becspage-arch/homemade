          "items": [
            { "symptom": "Rice is crunchy after 30 minutes.", "cause": "Not enough liquid or heat too low.", "fix": "Add 100ml hot water, cover, and cook 10 more minutes on low." },
            { "symptom": "Rice sticks and burns on the bottom.", "cause": "Heat too high during the covered stage.", "fix": "Place a folded tea towel under the lid to absorb steam and reduce heat." }
          ]
        }
      }
