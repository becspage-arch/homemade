        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "lamb-shoulder", "amount": 600, "unit": "g", "prepNote": "cubed into 4cm pieces", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "basmati-rice", "amount": 300, "unit": "g", "prepNote": "rinsed until water runs clear", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "carrot", "amount": 3, "unit": "medium", "prepNote": "peeled and cut into thin matchsticks", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 2, "unit": "medium", "prepNote": "finely sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 1, "unit": "head", "prepNote": "kept whole with skin on, excess outer skin removed", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cumin-seeds", "amount": 2, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
