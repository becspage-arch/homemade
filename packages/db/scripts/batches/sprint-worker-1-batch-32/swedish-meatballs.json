    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Make the meatballs small, about the size of a large marble. They brown faster and stay juicy inside." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "beef-mince", "amount": 400, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": "Meatballs" },
            { "ingredientSlug": "pork-mince", "amount": 200, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": "Meatballs" },
            { "ingredientSlug": "onion", "amount": 1, "unit": "medium", "prepNote": "grated", "isOptional": false, "groupLabel": "Meatballs" },
            { "ingredientSlug": "egg-yolks", "amount": 2, "unit": "whole", "prepNote": null, "isOptional": false, "groupLabel": "Meatballs" },
            { "ingredientSlug": "nutmeg-ground", "amount": 0.25, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": "Meatballs" },
            { "ingredientSlug": "allspice", "amount": 0.25, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": "Meatballs" },
            { "ingredientSlug": "unsalted-butter", "amount": 60, "unit": "g", "prepNote": "30g for frying meatballs, 30g for the sauce", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "plain-flour", "amount": 2, "unit": "tbsp", "prepNote": "for the sauce", "isOptional": false, "groupLabel": "Sauce" },
            { "ingredientSlug": "whole-milk", "amount": 400, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": "Sauce" },
            { "ingredientSlug": "soured-cream", "amount": 100, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": "Sauce" },
            { "ingredientSlug": "worcestershire-sauce", "amount": 1, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Sauce" },
            { "ingredientSlug": "stock-beef", "amount": 300, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": "Sauce" },
            { "ingredientSlug": "parsley-flat", "amount": 15, "unit": "g", "prepNote": "chopped, to serve", "isOptional": false, "groupLabel": null }
