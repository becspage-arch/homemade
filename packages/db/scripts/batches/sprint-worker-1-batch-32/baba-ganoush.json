      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 220C." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pierce each aubergine several times with a knife. Place them on a roasting tin." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast for 40 minutes, turning once halfway. The skins should be very dark and the flesh completely soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Leave to cool for 10 minutes. Split each aubergine and scoop out the flesh into a sieve." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Press out excess liquid with a spoon, then transfer the flesh to the blender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tahini, crushed garlic, lemon juice, olive oil, and cumin. Blend until smooth." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season with salt. Taste and add more lemon if needed." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spread onto a plate. Drizzle with olive oil and scatter over the parsley." }] }] }
        ]
      },
      {
