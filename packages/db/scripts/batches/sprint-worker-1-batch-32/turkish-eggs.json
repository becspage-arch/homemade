      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the yoghurt with the crushed garlic and lemon juice. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spread the yoghurt across four shallow bowls." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fill the frying pan with water to a depth of 5cm. Bring to a bare simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Crack each egg into a small cup, then slide gently into the water." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Poach for 3 to 4 minutes until the whites are set and yolks are still soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the eggs cook, melt the butter in a small pan over medium heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the sweet paprika, smoked paprika, and chilli flakes. Swirl for 30 seconds then remove from the heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lift the eggs from the water with a slotted spoon. Place two on each bowl of yoghurt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spoon the hot spiced butter over each bowl. Scatter with torn mint and serve at once." }] }] }
        ]
      },
      {
