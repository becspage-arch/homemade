      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 150C." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the smoked paprika, sweet paprika, cumin, oregano, and crushed garlic into a paste. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Score the pork shoulder skin several times with a sharp knife." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rub the spice paste all over the pork, pressing it into the scores." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lay the onion slices in the roasting tin. Place the pork on top." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the apple halves and pour the Worcestershire sauce around the pork. Drizzle honey over the top." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover tightly with foil. Roast for 3 hours 30 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the foil. Roast for a further 30 minutes to darken the outside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "The pork is done when a probe reads 90C or the meat pulls apart easily with two forks." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rest uncovered for 20 minutes. Pull the meat apart with two forks and serve." }] }] }
        ]
      },
