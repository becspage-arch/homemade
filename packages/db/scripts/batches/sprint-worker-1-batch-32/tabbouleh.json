        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the bulgur wheat in a saucepan. Cover with cold water by 2cm. Bring to the boil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat and simmer for 8 minutes until tender. Drain well and spread on a tray to cool." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Dice the tomato and cucumber. Slice the spring onions and chop the parsley and mint." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Combine the cooled bulgur with the parsley and mint in a large bowl." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tomato, cucumber, and spring onion." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour over the lemon juice and olive oil. Season generously with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss well, then chill for 30 minutes before serving." }] }] }
        ]
