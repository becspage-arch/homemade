          "items": [
            { "symptom": "Soured cream splits into curds.", "cause": "Heat was too high when the cream was added.", "fix": "Keep heat on low and stir constantly; reheat very gently." },
            { "symptom": "Beef is tough.", "cause": "Overcooked or cut with the grain.", "fix": "Slice against the grain and sear no longer than 2 minutes total." }
          ]
        }
      }
