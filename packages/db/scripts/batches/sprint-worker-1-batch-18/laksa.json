        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a large stockpot over medium heat. Add the red and green curry pastes and fry for 2 minutes until fragrant, stirring constantly." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the sliced chicken. Stir to coat in the paste and cook for 3 minutes until the chicken starts to turn white. Pour in the coconut milk and chicken stock." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the kaffir lime leaves, fish sauce, and palm sugar. Bring to a gentle simmer and cook for 12 minutes until the chicken is cooked through. Add the pak choi for the final 3 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide the cooked noodles between four bowls. Ladle the hot laksa broth and chicken over the noodles. Top with spring onion, crushed peanuts, and a wedge of lime." }] }]
          }
        ]
