      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix together the yoghurt, lemon juice, garlic, ginger, all the spices, and oil in a large bowl. Season with salt. Add the chicken chunks and stir to coat. Cover and chill for at least 2 hours, or overnight." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 230C. Line a baking tray with foil. Thread the chicken onto metal skewers or pre-soaked wooden skewers. Lay them across the tray so the chicken is slightly elevated." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bake for 15 minutes, then switch to the grill on high. Grill for 4 to 5 minutes until the chicken has charred edges. The internal temperature should reach 75C." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rest for 3 minutes before serving. Squeeze more lemon juice over and serve with flatbreads and fresh coriander." }] }]
          }
        ]
      },
