      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season the pork shoulder chunks with salt and pepper. Heat the olive oil in a stockpot over high heat. Brown the pork in batches until deeply coloured on all sides. Set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the onion, carrot, and celery. Cook for 10 minutes, stirring regularly, until very soft and lightly golden. This is the soffritto base." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and tomato puree. Stir and cook for 2 minutes. Pour in the red wine vinegar and let it bubble away. Add the tinned tomatoes, chicken stock, bay leaves, and rosemary. Return the pork to the pot." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to a gentle simmer, then cover and cook over very low heat for 2 to 2.5 hours until the pork is completely tender. Check occasionally and add a splash of water if it looks dry." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the bay leaves and rosemary. Use two forks to shred the pork into the sauce. Stir and taste for seasoning. Toss with cooked pasta and serve immediately." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
