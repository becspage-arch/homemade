            { "ingredientSlug": "onion", "amount": 2, "unit": "whole", "prepNote": "finely diced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 4, "unit": "cloves", "prepNote": "minced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "carrot", "amount": 2, "unit": "whole", "prepNote": "finely diced", "isOptional": false, "groupLabel": null },
