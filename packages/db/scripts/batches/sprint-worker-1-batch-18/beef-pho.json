        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place the halved onions and ginger cut-side up on a baking tray. Grill on high for 8 to 10 minutes until charred and blackened at the edges." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour the beef stock into a large stockpot. Add the charred onion and ginger, star anise, cloves, and cinnamon. Bring to a gentle simmer over medium heat. Cook for 30 minutes without boiling hard." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Strain the broth through a sieve into a clean pot. Season with fish sauce and light soy sauce. Taste and adjust. Keep at a rolling simmer." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide the cooked noodles between four deep bowls. Lay the raw sirloin slices on top. Ladle the boiling hot broth over everything. The heat of the broth cooks the beef in the bowl." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Top with spring onion, coriander, and sliced chilli. Serve lime wedges on the side. Add fish sauce and chilli to taste at the table." }] }]
          }
        ]
      },
