          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the spaghetti in a large pot of well-salted boiling water according to the packet instructions. Reserve a cup of pasta water before draining." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the pasta cooks, heat the olive oil and butter in a large pan over medium-high heat. Add the courgette and cook for 4 minutes until lightly golden. Add the garlic and cook for 1 minute." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cherry tomatoes and peas. Cook for 2 to 3 minutes until the tomatoes begin to soften. Season with salt and pepper." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the drained spaghetti to the vegetable pan. Toss well, adding a splash of pasta water to loosen. Squeeze over the lemon juice, add the lemon zest, scatter over the parmesan and basil, and toss again. Serve immediately." }] }]
          }
