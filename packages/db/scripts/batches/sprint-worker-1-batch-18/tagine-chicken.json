      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a large, heavy pot over medium-high heat. Season the chicken thighs and brown them in batches for 3 to 4 minutes per side until golden. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the onion and cook for 8 minutes until soft. Add the garlic, ginger, cumin, coriander, turmeric, and cinnamon. Stir and cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the saffron water and chicken stock. Return the chicken to the pot. Bring to a gentle simmer. Cover and cook over low heat for 35 minutes until the chicken is cooked through and very tender." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the green olives and the lemon juice. Simmer uncovered for 5 minutes to concentrate the sauce slightly. Taste and adjust seasoning. Scatter with fresh coriander and serve with couscous." }] }]
          }
        ]
      },
