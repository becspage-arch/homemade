      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season the beef shin with salt and pepper. Heat the oil in a large stockpot over high heat. Brown the beef in batches until deeply coloured on all sides, about 4 minutes per batch. Set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the onion, carrot, and celery to the same pot. Cook for 8 minutes until softened. Add the garlic and tomato puree and cook for 2 more minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the red wine vinegar and let it bubble for 1 minute. Add the tinned tomatoes, beef stock, Worcestershire sauce, allspice, bay leaves, and thyme. Return the beef to the pot. The liquid should nearly cover the meat." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to a gentle simmer. Cover tightly and cook over very low heat for 2.5 to 3 hours, until the beef is very tender and falling apart. Check every 45 minutes and add a splash of water if the sauce looks dry." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the bay leaves and thyme stalks. Taste and adjust seasoning. Serve with rice or mashed potato." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
