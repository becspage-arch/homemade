      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix together the tamarind paste, palm sugar, fish sauce, and light soy sauce in a small bowl. Stir until the sugar dissolves. Taste: it should be sour, salty, and slightly sweet." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a wok over very high heat until smoking. Add 2 tbsp of oil. Fry the garlic for 30 seconds. Add the prawns and cook for 1 to 2 minutes until pink and just cooked through. Push to one side." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the remaining oil to the wok. Pour in the beaten eggs and scramble lightly for 30 seconds. Add the drained noodles and pour the sauce over everything. Toss well with tongs over high heat for 2 to 3 minutes until the noodles are coated." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove from the heat. Toss through the spring onions. Divide into bowls. Top with crushed peanuts, chilli flakes, and lime wedges. Serve immediately." }] }]
          }
        ]
      },
