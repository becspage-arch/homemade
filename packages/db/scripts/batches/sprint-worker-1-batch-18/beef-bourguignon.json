      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss the beef chunks in the flour and season with salt and pepper. Fry the pancetta lardons in a stockpot over medium heat until lightly crisp. Remove and set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Turn the heat to high. Brown the floured beef in batches in the pancetta fat until deep golden on all sides. Do not crowd the pan. Set aside with the pancetta." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the butter, onion, carrot, and celery. Cook for 8 minutes. Add the garlic and tomato puree and cook for 2 minutes. Pour in the red wine vinegar and let it bubble for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the beef and pancetta. Add the stock, thyme, rosemary, and bay leaves. Bring to a gentle simmer. Cover and cook over very low heat for 2 to 2.5 hours, until the beef is very tender." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "About 15 minutes before serving, fry the mushrooms in a little butter in a separate pan until golden. Stir into the stew. Remove the herb stalks and bay leaves. Taste and adjust seasoning. Serve with mashed potato or crusty bread." }] }]
          }
        ]
      },
      {
