          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season the lamb chunks with salt and pepper. Place them in a large stockpot over medium-high heat with no extra oil. Brown on all sides, working in batches if needed. Set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion to the pot and cook for 5 minutes until softened. Return the lamb. Add the carrots, leeks, potatoes, bay leaves, and thyme." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the chicken stock. The liquid should just cover the ingredients. Bring to a gentle simmer, then cover and cook over low heat for 1.5 hours until the lamb is very tender." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the bay leaves and thyme stalks. Taste the broth and adjust seasoning. Stir in the chopped parsley just before serving. Ladle into deep bowls with crusty bread." }] }]
          }
        ]
      },
