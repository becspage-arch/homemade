        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a large stockpot over medium heat. Add the onion and cook for 5 minutes. Add the garlic, ginger, cumin, coriander ground, turmeric, and cinnamon. Stir and cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the lamb mince. Break it up with a spoon and cook for 5 minutes until browned all over." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes, chicken stock, and red lentils. Stir and bring to a simmer. Cook for 20 minutes, stirring occasionally, until the lentils have broken down and the soup has thickened." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the chickpeas and cook for 5 more minutes. Add the lemon juice, fresh coriander, and parsley. Taste and season with salt. Serve in deep bowls with crusty bread." }] }]
          }
        ]
      },
