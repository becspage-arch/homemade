      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place the pork in a large stockpot. Cover with the cold chicken stock. Add the onion, carrot, celery, leek, bay leaves, thyme, and cloves. Bring to a gentle simmer. Skim any foam from the surface." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Simmer gently for 45 minutes until the pork is tender. Add the mushrooms for the final 10 minutes. Remove the pork and mushrooms with a slotted spoon and set aside. Strain the cooking liquor and reserve 600ml." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melt the butter in a clean pan over medium heat. Add the flour and stir for 2 minutes. Gradually whisk in the reserved cooking liquor a ladleful at a time. Simmer for 5 minutes until thickened." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Whisk the egg yolks and cream together. Remove the sauce from the heat. Stir in the cream mixture and lemon juice. Do not let the sauce boil again. Return the pork and mushrooms to the sauce. Taste and season. Serve with rice or noodles." }] }]
          }
        ]
      },
