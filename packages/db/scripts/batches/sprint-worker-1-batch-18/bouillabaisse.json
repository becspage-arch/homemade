        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a large stockpot over medium heat. Add the onion, carrot, and celery. Cook for 8 minutes until softened. Add the garlic and fennel seeds and cook for 2 more minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes, stock, saffron water, bay leaves, and orange zest. Season with salt and pepper. Bring to a simmer and cook for 15 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cod and salmon chunks. Simmer gently for 5 minutes. Add the king prawns and cook for another 3 minutes until they are pink and just cooked through. Do not stir vigorously or the fish will break apart." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the bay leaves. Taste and adjust seasoning. Ladle into deep bowls and scatter with chopped parsley. Serve immediately with crusty bread." }] }]
          }
        ]
