      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 160C. Season the beef chuck well. Heat the oil in a large, heavy roasting tin on the hob over high heat. Brown the beef in batches until well coloured all over, about 4 to 5 minutes per batch. Set aside." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce the heat to medium. Add the onion, carrot, and celery to the tin. Cook for 6 to 8 minutes until softened. Stir in the garlic and tomato puree and cook for 2 minutes." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the red wine vinegar and let it bubble for 1 minute, scraping up any bits from the base of the tin. Add the tinned tomatoes, stock, thyme, rosemary, and bay leaves. Return the beef to the tin." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover tightly with foil. Transfer to the oven and cook for 3 hours until the beef is very tender and pulling apart at the edges. Check halfway and add a splash of water if needed." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the foil for the last 20 minutes to concentrate the sauce. Discard the herb stalks and bay leaves. Serve with creamy mashed potato or polenta." }] }]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
