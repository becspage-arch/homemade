        "attrs": {
          "items": [
            { "symptom": "Beef is still tough after 3 hours.", "cause": "Needs more time at low heat.", "fix": "Cover and cook for another 30 minutes." },
            { "symptom": "Sauce is watery.", "cause": "Not reduced enough.", "fix": "Pour sauce into a pan and reduce on the hob 10 minutes." },
            { "symptom": "Beef is dry.", "cause": "Foil removed too early.", "fix": "Next time keep the foil on for the full 3 hours." }
          ]
        }
