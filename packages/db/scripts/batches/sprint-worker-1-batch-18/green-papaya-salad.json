      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the garlic and chilli in a large pestle and mortar. Pound to a rough paste. Add the palm sugar and pound again to help it dissolve." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the green beans and tomato wedges. Bruise them lightly with a few pounds. You want them slightly crushed, not pulped." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the shredded papaya. Pour over the lime juice and fish sauce. Toss and pound lightly until the dressing coats everything. Taste and adjust: it should be sharp, salty, and a little sweet." }] }]
          },
          {
            "type": "listItem",
            "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Transfer to a serving plate. Scatter the crushed peanuts over the top. Serve immediately with sticky rice or grilled chicken." }] }]
          }
        ]
      },
