        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "cod-fillet", "amount": 600, "unit": "g", "prepNote": "very fresh, skin removed, cut into 1cm pieces", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "lime", "amount": 6, "unit": null, "prepNote": "juiced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 1, "unit": null, "prepNote": "red onion, very thinly sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chilli-red", "amount": 1, "unit": null, "prepNote": "deseeded and finely sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "coriander-fresh", "amount": 30, "unit": "g", "prepNote": "leaves and fine stems, roughly chopped", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cucumber", "amount": 0.5, "unit": null, "prepNote": "deseeded and diced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "avocado", "amount": 1, "unit": null, "prepNote": "diced, to serve", "isOptional": false, "groupLabel": "To serve" }
