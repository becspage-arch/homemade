    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Pat the halloumi slices dry with kitchen paper before coating them. Moisture is the enemy of a crisp crust. The broth should be warm but not boiling when you serve." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "halloumi", "amount": 300, "unit": "g", "prepNote": "sliced 1cm thick, patted very dry", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cornflour", "amount": 60, "unit": "g", "prepNote": "for coating", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "sunflower-oil", "amount": 400, "unit": "ml", "prepNote": "for shallow frying", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "stock-chicken", "amount": 300, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": "Broth" },
            { "ingredientSlug": "soy-sauce-light", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Broth" },
            { "ingredientSlug": "mirin", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Broth" },
            { "ingredientSlug": "sake", "amount": 1, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Broth" },
            { "ingredientSlug": "ginger-fresh", "amount": 2, "unit": "cm", "prepNote": "finely grated, to serve", "isOptional": false, "groupLabel": "To serve" },
            { "ingredientSlug": "spring-onion", "amount": 4, "unit": null, "prepNote": "finely sliced, to serve", "isOptional": false, "groupLabel": "To serve" }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Combine the stock, soy sauce, mirin, and sake in a small saucepan. Bring to a gentle simmer. Keep warm." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Press the halloumi slices between sheets of kitchen paper. Leave for 5 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Dust each slice in cornflour. Shake off the excess." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in the frying pan over medium-high heat. You need about 1.5cm depth of oil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry the halloumi slices in batches for 2 minutes per side until golden and crisp. Drain on kitchen paper." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place 3 or 4 pieces in each bowl. Pour the warm broth around them. Top with grated ginger and spring onion. Serve at once." }] }] }
        ]
      },
      {
        "type": "heading",
