            { "symptom": "Halloumi sticks to the pan", "cause": "Oil not hot enough before adding the pieces", "fix": "Wait until the oil shimmers before adding halloumi." },
            { "symptom": "Broth is too sharp", "cause": "Too much soy sauce", "fix": "Add an extra splash of mirin and taste again." }
