            { "ingredientSlug": "beef-sirloin", "amount": 500, "unit": "g", "prepNote": "partially frozen for 30 minutes, then sliced as thinly as possible", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "soy-sauce-light", "amount": 4, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Marinade" },
            { "ingredientSlug": "mirin", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Marinade" },
