        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the sauce ingredients together in a small bowl and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat a wok over high heat. Add the oil. Add the garlic and ginger. Stir for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pork mince. Break it up and stir-fry for 6 to 8 minutes until browned and cooked through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the sauce. Toss to coat. Cook for 2 minutes until the sauce has glazed the pork." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Spoon the pork into cold lettuce leaves. Top with grated carrot, cucumber, and spring onion. Serve immediately." }] }] }
