        "type": "paragraph",
        "content": [{ "type": "text", "text": "The slightly scorched bottom layer of rice is considered the best part of this dish. Do not stir once the lid goes on, and let the pot sit on low heat for the final few minutes to develop that crust." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "long-grain-rice", "amount": 300, "unit": "g", "prepNote": "rinsed until water runs clear", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chicken-thighs-boneless", "amount": 500, "unit": "g", "prepNote": "cut into 3cm chunks", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "mushrooms-chestnut", "amount": 150, "unit": "g", "prepNote": "halved", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "soy-sauce-light", "amount": 3, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "soy-sauce-dark", "amount": 1, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "oyster-sauce", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
