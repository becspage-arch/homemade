            { "ingredientSlug": "spring-onion", "amount": 4, "unit": null, "prepNote": "sliced, to serve", "isOptional": false, "groupLabel": null }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix both soy sauces, oyster sauce, sesame oil, ginger, and garlic in a bowl. Add the chicken and mushrooms. Toss to coat. Leave for 10 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the rinsed rice in the stockpot. Add 480ml of water. Bring to a boil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Once boiling, lay the marinated chicken and mushrooms over the surface of the rice. Pour any remaining marinade on top." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover tightly and reduce to the lowest heat. Cook for 18 minutes without lifting the lid." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Turn the heat up to medium for 2 minutes to develop a crust. Then take the pot off the heat. Rest for 5 minutes before serving." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter spring onion over the top. Serve straight from the pot." }] }] }
        ]
      },
      {
