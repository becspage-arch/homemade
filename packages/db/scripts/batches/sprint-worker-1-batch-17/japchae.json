      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the soy sauce, sesame oil, and honey in a bowl. Toss the beef in 1 tbsp of this dressing. Leave for 10 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Soak and then boil the noodles as directed on the pack. Drain. Cut into 15cm lengths with scissors. Toss with 1 tbsp of the dressing. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Wilt the spinach in a hot wok with a drop of oil. Season lightly. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the carrot and onion in 1 tbsp oil for 3 minutes. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the mushrooms with garlic in 1 tbsp oil for 3 minutes. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the marinated beef over high heat for 2 minutes. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Combine all the cooked components and the noodles in the wok. Add the remaining dressing and spring onion. Toss gently over low heat for 2 minutes until everything is warm and evenly coated." }] }] }
        ]
      },
