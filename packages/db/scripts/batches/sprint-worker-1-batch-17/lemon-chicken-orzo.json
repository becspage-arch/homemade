        "attrs": {
          "items": [
            { "symptom": "Orzo is sticking to the bottom", "cause": "Not stirred enough during simmering", "fix": "Stir every 2 to 3 minutes once the orzo is in." },
            { "symptom": "Dish is too dry before orzo is cooked", "cause": "Orzo absorbed liquid too fast", "fix": "Add 100ml more stock and continue simmering." },
            { "symptom": "Chicken is not cooked through", "cause": "Thighs too large or heat too low", "fix": "Check with a probe thermometer. It should read 74C." }
          ]
        }
