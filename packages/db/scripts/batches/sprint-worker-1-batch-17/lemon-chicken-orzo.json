      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season the chicken thighs well on both sides." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat 2 tbsp olive oil in the stockpot over medium-high heat. Sear the chicken skin-side down for 5 minutes until golden. Flip and cook for 3 minutes. Remove and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In the same pot, add 1 tbsp oil. Cook the onion for 4 minutes until soft. Add the garlic and thyme. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the orzo. Stir to coat in the oil for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the stock and lemon juice. Bring to a simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Nestle the chicken thighs back in. Simmer for 15 minutes, stirring occasionally, until the orzo is tender and most of the liquid has been absorbed." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the thyme sprigs. Stir in the spinach and lemon zest. Cook for 1 minute. Remove from heat." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir through the parmesan. Check seasoning. Serve straight from the pot." }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
