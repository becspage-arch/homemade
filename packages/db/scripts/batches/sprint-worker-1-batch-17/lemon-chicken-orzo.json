        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "chicken-thighs-boneless", "amount": 600, "unit": "g", "prepNote": "skin on if possible", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "pasta-dried", "amount": 300, "unit": "g", "prepNote": "orzo, or another small pasta shape", "isOptional": false, "groupLabel": null },
