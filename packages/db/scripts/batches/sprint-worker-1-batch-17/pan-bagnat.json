      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drain the tuna through a sieve. Press firmly with the back of a spoon to remove all the oil. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Whisk together the olive oil, red wine vinegar, and grated garlic. Season well." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Slice each roll or section of baguette in half horizontally. Drizzle the cut sides generously with the dressing." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Layer the base with tomato slices. Add the pepper slices, then the cucumber." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter over the tuna, anchovies, olives, and capers. Add the basil leaves." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Press the lid on firmly. Wrap tightly in cling film. Refrigerate for at least 1 hour under a weight (a heavy frying pan works well)." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Unwrap and slice in half to serve." }] }] }
        ]
      },
