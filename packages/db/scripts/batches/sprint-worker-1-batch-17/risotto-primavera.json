          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "arborio-rice", "amount": 300, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "stock-vegetable", "amount": 1200, "unit": "ml", "prepNote": "kept hot in a separate pan", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "white-wine-vinegar", "amount": 100, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "onion", "amount": 1, "unit": null, "prepNote": "finely diced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "garlic", "amount": 3, "unit": "cloves", "prepNote": "finely chopped", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "courgette", "amount": 1, "unit": null, "prepNote": "cut into small dice", "isOptional": false, "groupLabel": null },
