      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the olive oil in a wide, heavy-based saucepan over medium heat. Add the onion. Cook for 5 minutes until soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the rice. Stir for 2 minutes until the grains look translucent at the edges." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the white wine vinegar. Stir until absorbed." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the hot stock one ladle at a time. Stir and wait for each ladle to absorb before adding the next. This takes about 20 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "After 15 minutes, add the courgette and green beans with the next ladle of stock." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "When the rice is just cooked with a slight bite, stir in the peas. Cook for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Take the pan off the heat. Beat in the cold butter and parmesan. Season well. The risotto should flow slowly when the pan is tilted. Serve immediately, topped with basil." }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Risotto is stiff and gluey", "cause": "Too little liquid, or overworked at the end", "fix": "Add a splash of hot stock and stir gently to loosen." },
            { "symptom": "Rice is still chalky after 25 minutes", "cause": "Stock was not hot enough", "fix": "Keep stock at a low simmer in a separate pan throughout." },
            { "symptom": "Vegetables have lost their colour", "cause": "Added too early in the cooking", "fix": "Add green vegetables only in the last 5 minutes." }
          ]
