      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rinse the rice until the water runs clear. Put it in a saucepan with the coconut milk, stock, and ginger. Bring to a boil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Turn the heat to its lowest setting. Cover tightly. Cook for 12 minutes, then turn off the heat. Leave covered for 10 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "While the rice cooks, blend the onion, garlic, chilli flakes, and gochugaru with a splash of water to a rough paste." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in the frying pan over medium-high heat. Fry the paste for 3 to 4 minutes until fragrant and darkened." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chicken. Stir to coat in the paste. Cook for 5 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tamarind paste, palm sugar, and fish sauce. Stir well. Cook for 8 to 10 minutes until the sauce is thick and the chicken is cooked through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry the eggs in a little oil in a separate small pan to your liking." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fluff the rice with a fork. Remove the ginger. Serve the rice with sambal chicken, a fried egg, peanuts, and cucumber." }] }] }
        ]
      },
