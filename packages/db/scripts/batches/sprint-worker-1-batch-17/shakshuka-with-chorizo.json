      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in the frying pan over medium heat. Add the chorizo. Cook for 3 minutes until it releases its oil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the onion and red pepper. Cook for 6 minutes until soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, paprika, cumin, chilli flakes, and tomato puree. Stir for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes. Season well. Simmer for 10 minutes until the sauce thickens." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make 8 small wells in the sauce using the back of a spoon. Crack one egg into each well." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover the pan. Cook on low heat for 6 to 8 minutes until the whites are set but the yolks are still soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter feta and parsley over the top. Serve straight from the pan with crusty bread." }] }] }
        ]
      },
