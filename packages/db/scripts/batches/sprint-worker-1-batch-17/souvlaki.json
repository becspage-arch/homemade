            { "ingredientSlug": "cucumber", "amount": 0.5, "unit": null, "prepNote": "coarsely grated and squeezed very dry in a clean cloth", "isOptional": false, "groupLabel": "Tzatziki" },
            { "ingredientSlug": "mint", "amount": 10, "unit": "g", "prepNote": "leaves finely chopped", "isOptional": false, "groupLabel": "Tzatziki" }
