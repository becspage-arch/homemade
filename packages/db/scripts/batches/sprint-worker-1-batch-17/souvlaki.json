      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the tzatziki first. Combine the yoghurt, grated cucumber, 2 grated garlic cloves, and mint in a bowl. Season with salt. Refrigerate." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix 4 tbsp olive oil, the lemon juice and zest, remaining 2 garlic cloves, oregano, cumin, and paprika in a bowl." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pork cubes. Toss to coat. Cover and refrigerate for at least 1 hour." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Thread the pork onto 8 skewers." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat 1 tbsp olive oil in the frying pan over high heat. Cook the skewers for 10 to 12 minutes. Turn every 3 minutes until charred on each side and cooked through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve the skewers with the cold tzatziki alongside." }] }] }
        ]
      },
