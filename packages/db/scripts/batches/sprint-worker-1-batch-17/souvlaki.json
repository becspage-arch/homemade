        "type": "paragraph",
        "content": [{ "type": "text", "text": "Wooden skewers need at least 30 minutes soaking in cold water before use or they will scorch. Metal skewers need no preparation. Make the tzatziki first and refrigerate it while the pork marinates." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "pork-loin", "amount": 700, "unit": "g", "prepNote": "cut into 3cm cubes", "isOptional": false, "groupLabel": "Souvlaki" },
            { "ingredientSlug": "garlic", "amount": 4, "unit": "cloves", "prepNote": "finely grated, 2 for marinade and 2 for tzatziki", "isOptional": false, "groupLabel": "Souvlaki" },
            { "ingredientSlug": "olive-oil", "amount": 5, "unit": "tbsp", "prepNote": "4 for marinade, 1 for the pan", "isOptional": false, "groupLabel": "Souvlaki" },
            { "ingredientSlug": "lemon", "amount": 2, "unit": null, "prepNote": "juiced and zested", "isOptional": false, "groupLabel": "Souvlaki" },
            { "ingredientSlug": "oregano-dried", "amount": 2, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": "Souvlaki" },
