    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Use rice that has been cooked and left in the fridge overnight. Freshly cooked rice is too wet and will steam instead of fry. The quick-pickled cabbage can be made 30 minutes ahead for a more developed flavour." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "long-grain-rice", "amount": 300, "unit": "g", "prepNote": "cooked and cooled (about 700g cooked weight)", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "cabbage-white", "amount": 200, "unit": "g", "prepNote": "finely shredded", "isOptional": false, "groupLabel": "Quick-pickle cabbage" },
            { "ingredientSlug": "rice-vinegar", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": "Quick-pickle cabbage" },
            { "ingredientSlug": "gochugaru", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": "Quick-pickle cabbage" },
            { "ingredientSlug": "gochujang", "amount": 1, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "eggs", "amount": 4, "unit": null, "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "spring-onion", "amount": 6, "unit": null, "prepNote": "sliced", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "soy-sauce-light", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
