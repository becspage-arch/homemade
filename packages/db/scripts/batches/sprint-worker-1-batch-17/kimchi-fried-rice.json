      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss the shredded cabbage with the rice vinegar and gochugaru. Set aside for at least 10 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the wok over high heat until very hot. Add 2 tbsp oil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cold rice. Press it flat against the wok. Let it sit for 1 minute to get some colour, then stir-fry for 3 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the gochujang and soy sauce. Toss to coat the rice evenly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the pickled cabbage. Toss for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Push the rice to the sides. Add 1 tbsp oil to the centre. Crack in the eggs. Scramble loosely, then fold through the rice." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the spring onion and sesame oil. Toss once. Serve immediately." }] }] }
        ]
      },
      {
