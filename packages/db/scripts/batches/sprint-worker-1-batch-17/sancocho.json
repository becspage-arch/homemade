        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the chicken legs, stock, onion, garlic, cumin, ground coriander, and bay leaves in a stockpot. Bring to a boil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Skim any foam from the surface. Reduce to a steady simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "After 20 minutes, add the carrots and potato." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "After another 15 minutes, add the sweet potato. Continue simmering for 25 more minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lift out the chicken legs. Remove the skin and pull the meat from the bones. Return the meat to the pot. Discard the bones and bay leaves." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season the broth well. Serve in deep bowls with fresh coriander and a wedge of lime." }] }] }
        ]
