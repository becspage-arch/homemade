            { "symptom": "Goulash tastes bitter.", "cause": "Paprika was added to a hot dry pan and scorched.", "fix": "Always add paprika off the heat with liquid nearby." },
            { "symptom": "Beef is still tough at 90 minutes.", "cause": "Collagen in chuck needs a full low simmer.", "fix": "Cook for another 30 minutes with the lid on." },
            { "symptom": "Sauce is very thin.", "cause": "Lid was not on or heat too high.", "fix": "Remove lid and reduce on a medium simmer for 10 minutes." }
