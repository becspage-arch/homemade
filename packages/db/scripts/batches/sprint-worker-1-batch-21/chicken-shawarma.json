      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put all the marinade spices in a bowl with the garlic, lemon juice, and oil. Mix well." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the chicken thighs and turn to coat well. Cover and chill for at least 1 hour, or up to 24 hours." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat your oven to 220°C. Arrange the chicken in a single layer in the roasting tin. Do not overcrowd." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast for 22 to 25 minutes until deeply golden and cooked through. The edges should look slightly charred." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the sauce. Stir the yoghurt and tahini in a bowl. Add a pinch of salt and a squeeze of lemon juice." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rest the chicken for 5 minutes, then slice or shred. Serve with the tahini sauce." }] }] }
        ]
