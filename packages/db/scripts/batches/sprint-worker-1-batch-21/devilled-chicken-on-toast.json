        "type": "paragraph",
        "content": [{ "type": "text", "text": "Slice the chicken as thin as you can. Thin strips cook in 2 minutes and stay tender. Thick pieces take longer and toughen at high heat." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "What you need" }]
      },
      {
        "type": "ingredientsList",
        "attrs": {
          "defaultServings": 4,
          "items": [
            { "ingredientSlug": "unsalted-butter", "amount": 50, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chicken-thighs-boneless", "amount": 400, "unit": "g", "prepNote": "sliced into thin strips", "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "dijon-mustard", "amount": 1, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "worcestershire-sauce", "amount": 2, "unit": "tbsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "paprika-sweet", "amount": 1, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "chilli-flakes", "amount": 0.25, "unit": "tsp", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "double-cream", "amount": 100, "unit": "ml", "prepNote": null, "isOptional": false, "groupLabel": null },
            { "ingredientSlug": "lemon", "amount": 1, "unit": "whole", "prepNote": "juice only", "isOptional": false, "groupLabel": null },
