      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat your oven to 160°C." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a stockpot over high heat. Season the beef and brown in batches. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lower the heat. Add the onion, carrot and celery. Cook for 6 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and tomato puree. Stir for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return the beef to the pot. Add the stock, Worcestershire sauce, thyme and bay leaves. Bring to a simmer." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover and transfer to the oven. Cook for 2 hours." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Make the dumplings. Rub the cold butter into the flour until the mixture resembles breadcrumbs. Stir in the parsley and a good pinch of salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add just enough cold water to bring the dough together. About 5 to 6 tablespoons. Do not overwork." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the stew from the oven. Discard the thyme and bay leaves. Taste and season." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roll the dough into 8 balls. Drop them on top of the stew with space between each. Cover and return to the oven for 25 minutes." }] }] }
        ]
      },
