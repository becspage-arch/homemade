      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a wok over high heat until smoking. Add the pork mince and stir-fry for 3 minutes until cooked through." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Push the pork to one side. Add the doubanjiang and fry for 30 seconds until fragrant and the oil turns red." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic, ginger and gochugaru. Stir everything together for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the soy sauce and stock. Bring to a boil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Gently add the halloumi cubes. Simmer for 5 minutes to let them absorb the sauce." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the cornflour slurry. Simmer for 1 minute until the sauce thickens and coats everything." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Drizzle with sesame oil. Top with spring onions and serve with rice." }] }] }
        ]
      },
