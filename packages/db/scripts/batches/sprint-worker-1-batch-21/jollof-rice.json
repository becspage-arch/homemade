      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Blend the tinned tomatoes, red peppers, garlic, ginger and one roughly chopped onion until smooth. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a large saucepan over medium heat. Add the sliced onion and fry for 8 minutes until golden." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tomato puree. Stir and fry for 2 minutes until it darkens slightly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the blended tomato mixture. Add the smoked paprika, thyme and bay leaves. Bring to a boil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Simmer the sauce vigorously for 15 minutes, stirring often, until it reduces and darkens." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the stock. Bring to a boil. Add the rinsed rice and stir once." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover tightly, reduce to a low heat, and cook for 25 minutes. Do not lift the lid." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Remove the bay leaves. Fluff with a fork and serve." }] }] }
        ]
      },
      {
