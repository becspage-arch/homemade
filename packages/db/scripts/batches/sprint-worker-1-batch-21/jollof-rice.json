            { "symptom": "Jollof tastes sour.", "cause": "The tomato base was not cooked down long enough.", "fix": "Reduce sauce more in step 5 next time." },
            { "symptom": "Rice is mushy.", "cause": "Too much liquid or heat too high.", "fix": "Use less stock next time; stick to 600ml for 300g rice." }
