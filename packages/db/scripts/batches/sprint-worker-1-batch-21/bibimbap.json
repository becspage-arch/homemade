        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the rice according to packet instructions. Keep warm." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the beef mince with the soy sauce, garlic and honey. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Wilt the spinach in a dry pan over high heat for 1 minute. Squeeze out any water and toss with a drop of sesame oil. Set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "In the same pan with a little oil, stir-fry the julienned carrot for 2 minutes. Season and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry the mushrooms in a little oil for 4 minutes until golden. Season and set aside." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook the seasoned beef mince in a hot pan for 5 minutes, breaking it up as you go." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fry an egg per bowl, sunny side up." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Divide the rice between four bowls. Arrange the beef and vegetables in sections around the rice. Top with a fried egg and a spoonful of gochujang." }] }] }
        ]
      },
