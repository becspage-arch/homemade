      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Blanch the cabbage leaves in boiling salted water for 1 minute. Drain and pat dry." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Par-cook the rice for 8 minutes. Drain and cool." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mix the beef mince, rice, onion, garlic, egg yolk and paprika. Season well." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat your oven to 180°C. Mix the tinned tomatoes, tomato puree and stock in a jug. Season." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Place 2 to 3 tablespoons of filling on each cabbage leaf. Fold the sides in and roll up tightly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Arrange the rolls seam-side down in a deep baking dish. Pour the tomato sauce over and around them." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cover tightly with foil and bake for 55 to 60 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve with the sauce spooned over and soured cream on the side." }] }] }
        ]
      },
