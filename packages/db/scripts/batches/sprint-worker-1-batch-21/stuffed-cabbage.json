            { "ingredientSlug": "beef-mince", "amount": 500, "unit": "g", "prepNote": null, "isOptional": false, "groupLabel": "filling" },
            { "ingredientSlug": "long-grain-rice", "amount": 150, "unit": "g", "prepNote": "par-cooked and cooled", "isOptional": false, "groupLabel": "filling" },
