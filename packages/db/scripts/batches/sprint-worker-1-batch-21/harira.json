      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a stockpot over medium heat. Add the onion and celery. Cook for 8 minutes until soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and ginger. Cook for 1 minute, stirring." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the cumin, coriander, cinnamon and turmeric. Stir for 30 seconds." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the tomato puree and cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the tinned tomatoes, lentils, chickpeas and stock. Stir well and bring to a boil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reduce to a steady simmer. Cook uncovered for 25 to 30 minutes until the lentils have completely broken down." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the lemon juice. Taste and add salt. Ladle into bowls and top with fresh parsley and coriander." }] }] }
        ]
      },
