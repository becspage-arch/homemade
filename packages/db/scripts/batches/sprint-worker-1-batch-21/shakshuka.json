      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Method" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oil in a large frying pan over medium heat. Add the onion and peppers. Cook for 10 minutes until soft." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the garlic and chilli. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stir in the tomato puree, cumin, both paprikas and turmeric. Cook for 1 minute." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the tinned tomatoes. Bring to a simmer and cook for 8 minutes until the sauce thickens slightly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Season with salt. Use a spoon to make 6 small wells in the sauce." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Crack one egg into each well. Cover the pan with a lid or foil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cook over low heat for 5 to 8 minutes. Stop when the whites are just set but the yolks are still runny." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Crumble over feta if using and scatter with parsley. Serve straight from the pan." }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Troubleshooting" }]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Egg whites are set but yolks are already hard.", "cause": "Heat was too high or covered too long.", "fix": "Cook on very low heat and check at 5 minutes." },
            { "symptom": "Sauce is watery after adding tinned tomatoes.", "cause": "Tomatoes need time to reduce.", "fix": "Simmer uncovered for longer before adding eggs." },
            { "symptom": "Eggs spread into the sauce and lose shape.", "cause": "No wells made or sauce too thin.", "fix": "Thicken sauce first, then create clear wells." }
          ]
        }
      }
