        "type": "troubleshooter",
        "attrs": {
          "items": [
            { "symptom": "Soured cream has split and looks grainy.", "cause": "Added over high heat or while sauce was boiling.", "fix": "Stir in off the heat; reheat very gently after." },
            { "symptom": "Sauce is pale and watery.", "cause": "Not enough paprika or too much stock.", "fix": "Simmer uncovered for 5 minutes to reduce." },
            { "symptom": "Chicken is dry.", "cause": "Cooked for too long after returning to the pot.", "fix": "Check at 20 minutes; thighs need no more than 25." }
          ]
        }
