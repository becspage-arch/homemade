      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mix the yoghurt, garlic, ginger, spices, oil and salt in the bowl. Add the chicken pieces and stir to coat fully. Cover and chill for at least 1 hour."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Take the chicken out of the fridge 15 minutes before cooking."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the griddle pan over a high heat until very hot. Cook the chicken pieces in a single layer for 7 to 8 minutes without moving them."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Turn each piece and cook for a further 7 to 8 minutes until charred at the edges and cooked through. Rest for 5 minutes."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Warm the naan in a dry frying pan or directly over the gas for 30 seconds per side."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lay the chicken down the centre of each naan. Add a spoonful of yoghurt, the sliced red onion, coriander and a squeeze of lemon. Roll tightly and serve immediately."}]}]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The chicken is pale and steamed-looking rather than charred.",
              "cause": "The griddle was not hot enough, or the pieces were too close together.",
              "fix": "Heat the griddle until it smokes lightly before adding the chicken. Cook in batches if needed."
            },
            {
              "symptom": "The marinade burns on the griddle before the chicken is cooked through.",
              "cause": "The heat was too high or the yoghurt coating was very thick.",
              "fix": "Shake off excess marinade before placing on the griddle. Lower the heat slightly once charring appears."
            },
            {
              "symptom": "The chicken is dry inside.",
              "cause": "Breast meat was used instead of thigh, or the pieces were overcooked.",
              "fix": "Use boneless thighs, which stay moist under high heat. Remove from heat as soon as the juices run clear."
            }
          ]
        }
      }
    ]
  }
