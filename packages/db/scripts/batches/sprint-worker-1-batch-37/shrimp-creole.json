      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Melt the butter with the oil in a large pan over a medium heat. Add the onion, celery, and green pepper. Cook for 10 minutes until completely soft."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the garlic, paprika, cayenne, oregano, and thyme. Stir and cook for 1 minute."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the tomato puree and cook for 2 minutes, stirring constantly, until it darkens slightly."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pour in the tinned tomatoes, chicken stock, Worcestershire sauce, and bay leaves. Season with salt. Stir well."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Simmer uncovered on a medium-low heat for 20 minutes until the sauce has thickened. Remove the bay leaves."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the raw prawns. Cook for 3 to 4 minutes until they are pink and just cooked through. Do not overcook."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Taste and adjust seasoning. Serve over cooked white rice with spring onion scattered on top."}]}]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The prawns are rubbery and overcooked.",
              "cause": "They were added too early or cooked for too long.",
              "fix": "Prawns only need 3 to 4 minutes. Add them at the very end and take the pan off the heat as soon as they are all pink."
            },
            {
              "symptom": "The sauce is too thin.",
              "cause": "The heat was too low during the 20-minute reduction.",
              "fix": "Raise the heat to medium and cook uncovered for another 5 to 10 minutes, stirring often."
            },
            {
              "symptom": "The dish lacks depth.",
              "cause": "The trinity vegetables were not cooked long enough, or the tomato puree was not fried off.",
              "fix": "Fry the puree for a full 2 minutes until it smells sweet. Add an extra splash of Worcestershire sauce and taste again."
            }
          ]
        }
      }
    ]
