        "attrs": {
          "items": [
            { "symptom": "Curry tastes flat and lacks fragrance.", "cause": "Curry paste was not fried long enough.", "fix": "Fry the paste in the coconut cream for at least 2 full minutes." },
            { "symptom": "Sauce is very thin.", "cause": "Too much liquid or not enough reduction time.", "fix": "Simmer uncovered for 5 more minutes to reduce and concentrate." },
            { "symptom": "Chicken is tough.", "cause": "Overcooked or breast used instead of thighs.", "fix": "Use thighs and check doneness at 8 minutes. Do not overcook." }
          ]
