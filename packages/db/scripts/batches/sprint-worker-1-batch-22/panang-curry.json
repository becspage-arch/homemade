      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Open the coconut tin without shaking. Scoop the thick cream into the wok." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat over a medium-high heat until the cream bubbles." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the curry paste. Fry for 2 to 3 minutes, stirring constantly, until the oil splits from the paste and the paste is fragrant." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the beef slices. Stir-fry for 2 minutes." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Pour in the remaining coconut milk. Add the kaffir lime leaves." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bring to a simmer. Cook for 5 minutes until the sauce has reduced and thickened slightly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the fish sauce, palm sugar, and lime juice. Taste and adjust." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve over jasmine rice. Scatter crushed peanuts over the top." }] }] }
        ]
      },
      {
