        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Heat the oven to 200C." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Toss the cherry tomatoes, olives, capers, and garlic in a roasting tin with half the olive oil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Roast for 10 minutes until the tomatoes begin to soften and burst." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Nestle the cod portions into the tin. Drizzle over the remaining olive oil." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Lay a lemon slice on top of each piece of fish." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Return to the oven for 10 to 12 minutes until the fish is opaque and flakes easily." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Scatter over the torn basil. Serve from the tin." }] }] }
