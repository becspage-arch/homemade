        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Put the tomatoes, cucumber, pepper, and garlic in the blender." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Add the vinegar and olive oil. Season with salt." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Blend on high for 2 minutes until very smooth." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Taste. Add chilli flakes if you want a little heat. Blend again briefly." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "For a very smooth soup, pass through a sieve and discard the solids." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Transfer to a bowl or jug. Cover and refrigerate for at least 2 hours." }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Serve in cold bowls with a drizzle of olive oil." }] }] }
