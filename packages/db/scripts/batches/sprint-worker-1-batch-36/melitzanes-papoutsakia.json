      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Method"}]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heat the oven to 190C. Score the cut sides of the aubergines in a crosshatch. Brush with olive oil and season. Roast cut-side up for 25 minutes until soft and golden."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "While the aubergines roast, make the meat sauce. Heat 2 tablespoons of olive oil in a frying pan over a medium-high heat. Brown the mince for 5 minutes, breaking it up."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add the onion and garlic and cook for 4 minutes. Add the wine and let it bubble for 2 minutes. Add the tomato puree, tinned tomatoes, cinnamon and allspice. Season and simmer for 15 minutes."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Make the bechamel. Melt the butter in a saucepan over a medium heat. Add the flour and stir for 2 minutes. Gradually pour in the warm milk, whisking constantly. Cook for 5 minutes until thick. Remove from heat, stir in the egg yolk, nutmeg and half the parmesan."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Scoop a little flesh from each aubergine half to create a hollow. Chop the scooped flesh and stir it into the meat sauce."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sit the aubergines in a baking tin. Spoon the meat sauce into each shell. Top generously with bechamel. Scatter over the remaining parmesan."}]}]
          },
          {
            "type": "listItem",
            "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bake for 25 minutes until the bechamel is deep golden on top. Rest for 10 minutes before serving."}]}]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {"level": 2},
        "content": [{"type": "text", "text": "Troubleshooting"}]
      },
      {
        "type": "troubleshooter",
        "attrs": {
          "items": [
            {
              "symptom": "The aubergine shells are too soft to hold their shape.",
              "cause": "They were roasted too long before filling.",
              "fix": "Pull them from the oven while still slightly firm. They finish cooking during the second bake."
            },
            {
              "symptom": "The bechamel is lumpy.",
              "cause": "The milk was added too fast, or it was cold.",
              "fix": "Warm the milk before adding. Pour it in a thin, steady stream and whisk without stopping."
            },
            {
              "symptom": "The meat sauce is watery.",
              "cause": "It was not reduced enough.",
              "fix": "Simmer the sauce uncovered for a further 5 to 10 minutes. It should be thick enough to mound on a spoon."
            }
          ]
        }
      }
    ]
  }
