                    "text": "tr (UK) / dc (US): treble (all subsequent rows)"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Foundation row (row 1)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work 120 chainless foundation trebles in a chain from the setup ch-4. The bottom edge should measure 75 cm."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Row 2 and onward"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "turning-chain"
                }
              }
            ],
            "text": "Turning chain"
          },
          {
            "type": "text",
            "text": " of ch 3. Work 1 tr into every stitch. Tr into top of turning chain. Turn. (120 tr.)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Repeat Row 2 until piece measures 90 cm (approximately 72 rows). Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Secure both tails with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "weaving-in-ends"
                }
              }
            ],
            "text": "weaving in ends"
          },
          {
            "type": "text",
            "text": ". Block lightly with steam. The chainless foundation edge and the final row edge should look identical in weight and stretch."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Care"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Machine wash 30 degrees gentle. Dry flat."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
