            "text": "Panel (make 2)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 91 (odd number). Row 1: dc in 2nd ch from hook, * ch 1, skip 1, dc; rep to end. Row 2 onwards: ch 1, dc in first ch-1 sp, * ch 1, "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc-in-sp"
                }
              }
            ],
            "text": "dc in next ch-1 sp"
          },
          {
            "type": "text",
            "text": "; rep. Each row offsets one space. Repeat until 30 cm."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
