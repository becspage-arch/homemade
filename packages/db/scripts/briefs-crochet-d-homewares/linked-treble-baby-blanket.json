  "glossaryTerms": [
    {
      "slug": "linked-tr",
      "term": "Linked treble",
      "definition": "Before inserting the hook into the next stitch, insert it into the upper horizontal loop of the previous treble and pull up a loop. Then complete the treble normally. The extra pick-up links stitches and closes the vertical gap."
    },
    {
      "slug": "turning-chain",
      "term": "Turning chain",
      "definition": "Two chains at the start of a linked treble row (the first linked treble is taller than a regular dc but shorter than a treble)."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through stitches with the tapestry needle."
    }
  ],
