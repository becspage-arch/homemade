  "glossaryTerms": [
    {
      "slug": "colour-change-crochet",
      "term": "Colour change",
      "definition": "Pulling the new colour through the final loop of the last stitch in the old colour. The new colour begins on the next row."
    },
    {
      "slug": "turning-chain",
      "term": "Turning chain",
      "definition": "One chain at the start of each double crochet row. Does not count as a stitch."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through stitches with the tapestry needle."
    }
  ],
