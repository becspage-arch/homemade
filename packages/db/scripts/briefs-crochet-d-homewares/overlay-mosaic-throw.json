      "slug": "surface-sl-st",
      "term": "Surface slip stitch",
      "definition": "A slip stitch worked on the surface of a completed fabric by inserting the hook through the fabric from front to back, looping yarn, and pulling through. Used to add colour and texture on top of a base."
    },
    {
      "slug": "turning-chain",
      "term": "Turning chain",
      "definition": "Three chains at the start of each treble row in the base fabric."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through stitches with the tapestry needle."
    }
