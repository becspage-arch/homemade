            "text": "Turning chain"
          },
          {
            "type": "text",
            "text": " of ch 4. *Tr into next ch, ch 1, skip 1*. Repeat. Tr into last ch. Turn."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
