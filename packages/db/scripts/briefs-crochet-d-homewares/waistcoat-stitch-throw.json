          },
          {
            "type": "text",
            "text": " of ch 1. Dc into every chain (both loops). Turn. (107 dc.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Row 2 and onward"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 1. Insert hook into the V of each dc below. Complete as dc. Turn. (107 ws.)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Repeat Row 2 until piece measures 100 cm (approximately 140 rows). Fasten off."
          }
        ]
      },
