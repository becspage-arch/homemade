            "text": "Leaf (make 20)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 9 ("
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
