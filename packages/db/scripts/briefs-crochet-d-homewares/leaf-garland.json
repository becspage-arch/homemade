    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Each leaf is worked along a central "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "leaf-spine"
                }
              }
