      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Rounds 1 to 6: increase pattern. Stop at round 6 (48 dc, approximately 18 cm). BLO fold round. Work sides 10 cm. Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Large basket (24 cm diameter)"
