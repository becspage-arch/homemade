    {
      "slug": "popcorn-st",
      "term": "Popcorn stitch",
      "definition": "Work 5 tr into one stitch. Remove hook from working loop. Insert hook into the top of the first of the 5 tr, then back into the dropped loop, and draw through. Ch 1. The 5 stitches fold into a dome."
    },
    {
      "slug": "turning-chain",
      "term": "Turning chain",
      "definition": "One chain at the start of plain dc rows; two chains at the start of popcorn rows."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through stitches with the tapestry needle."
    }
  ],
