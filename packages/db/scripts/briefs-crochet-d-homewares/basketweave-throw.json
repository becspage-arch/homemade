  "glossaryTerms": [
    {
      "slug": "fptr",
      "term": "FPtr",
      "definition": "Front post treble. Work the treble around the post of the stitch below by inserting the hook from front to back to front around the post. The stitch stands forward."
    },
    {
      "slug": "bptr",
      "term": "BPtr",
      "definition": "Back post treble. Insert the hook from back to front to back around the post below. The stitch pushes to the back, creating a recessed panel."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through stitches with the tapestry needle."
    }
  ],
