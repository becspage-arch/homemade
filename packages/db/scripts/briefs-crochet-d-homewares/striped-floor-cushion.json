            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Place circles wrong sides together. Whipstitch around the edge, leaving a 20 cm gap. Insert pad or stuffing. Whipstitch the gap closed."
          }
        ]
      },
