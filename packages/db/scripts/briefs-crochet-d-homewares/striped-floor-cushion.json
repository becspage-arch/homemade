      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 1: magic ring, 6 dc. Round 2: 2 dc in each st (12 dc). Round 3: * 2 dc, 1 dc; rep (18 dc). Continue standard 6-increase rounds until the circle is 60 cm across. Change colour every 4 rounds."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
