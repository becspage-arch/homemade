      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "12 dtr x 5 rows = 10 x 10 cm in DK cotton with a 4 mm hook. The tall stitch means fewer rows; 45 rows reaches 90 cm."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
