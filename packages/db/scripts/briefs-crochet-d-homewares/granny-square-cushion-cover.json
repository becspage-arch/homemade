            "text": "granny clusters"
          },
          {
            "type": "text",
            "text": " with ch-2 corner spaces. Continue working rounds, adding one cluster per side per round. At "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "colour-change-cushion"
                }
