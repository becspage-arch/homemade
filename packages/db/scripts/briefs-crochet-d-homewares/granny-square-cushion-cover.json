                  "termSlug": "whipstitch-cushion"
                }
              }
            ],
            "text": "whipstitch join"
          },
          {
            "type": "text",
            "text": " along three sides. Insert cushion pad. Whipstitch the remaining side closed."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
