    {
      "slug": "tunisian-simple-st",
      "term": "Tunisian simple stitch",
      "definition": "Forward pass: insert hook under each vertical bar and pull up a loop (all loops held on hook). Return pass: yarn over, draw through 2 loops at a time until 1 loop remains. Abbreviated tss."
    },
    {
      "slug": "tunisian-cast-on",
      "term": "Tunisian cast-on",
      "definition": "The foundation chain for Tunisian crochet. Pull up a loop from each chain on the first forward pass to set up the initial row of loops."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through stitches with the tapestry needle."
    }
