          {
            "type": "text",
            "text": "Gauge"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "14 tss x 12 rows = 10 x 10 cm in aran with a 5 mm Tunisian hook. Tunisian gauge is tighter than regular dc in the same yarn. Swatch before starting the full foundation."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
