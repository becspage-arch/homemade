                  "termSlug": "magic-ring-mini"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ", the base grows in dc spiral rounds to 10 cm, then a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "blo-round-mini"
                }
              }
            ],
            "text": "BLO round"
          },
          {
            "type": "text",
            "text": " creates the base fold and the sides work straight up for 7 cm."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chunky cotton on a 6 mm hook makes a firm, small basket. Total yardage is around 40 m of chunky cotton."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
