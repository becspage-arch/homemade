    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a 30 cm circular base from a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring-bag"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ", then continue straight up in dc rounds for 35 cm. Make two "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc-handles"
                }
              }
            ],
            "text": "bag handles"
          },
          {
            "type": "text",
            "text": " and sew them to the top edge on opposite sides."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chunky cotton rope makes a bag strong enough for shopping. Total yarn around 400 m."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            {
              "name": "Chunky cotton yarn or rope",
              "qty": "400 m"
            },
            {
              "name": "6 mm crochet hook",
              "qty": "1"
            },
            {
              "name": "Tapestry needle",
              "qty": "1"
            },
            {
              "name": "Scissors",
              "qty": "1 pair"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Base"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Round 1: "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring-bag"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": ", 6 dc. Increase 6 dc per round until base is 30 cm (about 10 rounds). BLO fold round."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Sides"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work dc in spiral for 35 cm (about 45 rounds). Sl st to close. Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Handles (make 2)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 5. Work dc rows for 60 cm. Seam long edge into a tube. Sew each end of each "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc-handles"
                }
              }
            ],
            "text": "handle"
          },
          {
            "type": "text",
            "text": " firmly to the inside of the bag top, 8 cm from the side edges."
          }
        ]
      },
      {
        "type": "heading",
