              "qty": "1"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Panel (make 2)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 57. Work dc rows until 40 cm. Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Whipstitch three sides. Insert pad. Close remaining side."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Adding fringe"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Cut yarn in 22 cm lengths (pairs). Fold each pair in half. Insert the folded loop through an edge stitch, pass tails through loop, and pull firm. Trim to 10 cm. Repeat every other stitch along the bottom edge."
          }
        ]
      },
      {
        "type": "heading",
