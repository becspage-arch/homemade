        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Both panels are worked in rows of "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc-cushion-boho"
                }
              }
            ],
            "text": "double crochet"
          },
          {
            "type": "text",
            "text": ". The "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "tassel-fringe"
                }
              }
            ],
            "text": "tassel fringe"
          },
          {
            "type": "text",
            "text": " is added after assembly by folding 20 cm yarn lengths through every other edge stitch and knotting them close to the panel surface."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Choose a natural aran wool or cotton for tassels that hang well. Around 480 m for both panels plus 80 m for fringe on one edge."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            {
              "name": "Aran yarn, main colour",
              "qty": "480 m"
            },
            {
              "name": "Aran yarn, fringe colour (can match)",
              "qty": "80 m"
            },
