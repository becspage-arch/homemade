            "text": "oval base"
          },
          {
            "type": "text",
            "text": " worked along a 30 cm foundation chain. Each round adds 8 "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc-mat"
