  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Each "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "popcorn-cushion"
                }
              }
            ],
            "text": "popcorn"
          },
          {
            "type": "text",
            "text": " sits every 4 stitches and every 4 rows, creating a uniform raised grid. The base fabric between popcorns is "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc-plain-cushion"
                }
              }
            ],
            "text": "double crochet"
          },
          {
            "type": "text",
            "text": ". Both the front and back panels use the popcorn grid."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Aran weight yarn holds the popcorns upright without blocking. Allow around 500 m for both panels."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            {
              "name": "Aran yarn",
              "qty": "500 m"
            },
            {
              "name": "5 mm crochet hook",
              "qty": "1"
            },
            {
              "name": "Tapestry needle",
              "qty": "1"
            },
            {
              "name": "Scissors",
              "qty": "1 pair"
            },
            {
              "name": "40 cm cushion pad",
              "qty": "1"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Panel (make 2)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 55. Row 1: dc across. Row 2 (RS, set-up): ch 1, dc 2, * "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "popcorn-cushion"
                }
              }
            ],
            "text": "popcorn"
          },
          {
            "type": "text",
            "text": " in next st, dc 3; rep from * to last st, dc. Rows 3 to 5: dc across. Row 6: shift popcorns by 2 sts to offset grid. Repeat 6-row repeat until 40 cm."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Whipstitch three sides. Insert pad. Close remaining side. Popcorns should face outward on both sides."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
