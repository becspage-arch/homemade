  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Each cover starts at the narrow top of the egg from a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "magic-ring-egg"
                }
              }
            ],
            "text": "magic ring"
          },
          {
            "type": "text",
            "text": " and expands in dc to the widest point, then stays even for a few rounds before narrowing again. Use "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc2tog-egg"
                }
              }
            ],
            "text": "dc2tog"
          },
          {
            "type": "text",
            "text": " decreases to close the bottom."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Make six covers in different pastel colours, or in the same colour with different stitch details (plain, shell, rib). Slip each over an egg. Total yarn around 60 m across six colours."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            {
              "name": "Fingering yarn in 6 colours",
              "qty": "10 m each"
            },
            {
              "name": "2.5 mm crochet hook",
              "qty": "1"
