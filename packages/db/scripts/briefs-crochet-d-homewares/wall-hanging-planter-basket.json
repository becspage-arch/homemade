  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A wall hanging planter basket is 15 cm across with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "flat-back"
                }
              }
            ],
            "text": "flat back"
          },
          {
            "type": "text",
            "text": " that sits flush against a wall. The base is a standard magic ring dc circle, but the sides are worked in rows rather than rounds so one side stays flat."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chunky cotton on a 6 mm hook. A "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "hanging-loop"
                }
              }
            ],
            "text": "hanging loop"
          },
          {
            "type": "text",
            "text": " added at the top allows the basket to hang on a wall hook. Total yardage is around 80 m."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            {
              "name": "Chunky cotton yarn",
              "qty": "80 m"
            },
            {
              "name": "6 mm crochet hook",
              "qty": "1"
            },
            {
              "name": "Stitch marker",
              "qty": "1"
            },
            {
              "name": "Tapestry needle",
              "qty": "1"
            },
            {
              "name": "Scissors",
              "qty": "1 pair"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Base"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work rounds 1 to 5 of the basic round basket (magic ring, +8 dc per round) to reach approximately 15 cm. (40 dc.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Sides (rows, not rounds)"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work in rows across the front 20 stitches only. Work dc rows back and forth, turning at each end, for 10 cm (approximately 14 rows). This creates a pocket front while the back stays flat."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Joining the sides to the flat back"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work a row of dc along the side edge of the pocket rows and sl st into the edge of the base to join. Repeat on the other side."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Hanging loop"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Join yarn at the top centre back. Ch 15, sl st to the same stitch. Work dc back along the ch 15 for reinforcement. Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Secure all tails with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "weaving-in-ends"
                }
              }
            ],
            "text": "weaving in ends"
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Care"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Spot clean or machine wash 30 degrees if yarn allows. Reshape while damp."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What to try next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The mini trinket basket uses the same base in a free-standing version. Or try the handled market basket for a carrying version."
          }
        ]
      }
    ]
  }
}