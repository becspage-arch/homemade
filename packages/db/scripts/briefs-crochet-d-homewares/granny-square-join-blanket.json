  "glossaryTerms": [
    {
      "slug": "magic-ring",
      "term": "Magic ring",
      "definition": "An adjustable starting loop for in-the-round work. Pulls closed to leave no centre hole. Also called a magic circle."
    },
    {
      "slug": "jayg",
      "term": "Join-as-you-go",
      "definition": "Joining motifs on the final round of each one by replacing a corner or side chain with a slip stitch into the adjacent motif, instead of sewing motifs together afterwards."
    },
    {
      "slug": "chain-space",
      "term": "Chain space",
      "definition": "The gap formed by one or more chains, into which the next round works its clusters."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through nearby stitches with the tapestry needle so the fabric holds without knots showing."
    }
  ],
