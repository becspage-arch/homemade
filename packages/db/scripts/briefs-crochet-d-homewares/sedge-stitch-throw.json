      "slug": "double-treble",
      "term": "Double treble",
      "definition": "UK: dtr. Two yarn-overs before inserting the hook. Four draw-throughs to complete. Taller than a treble, giving the sedge cluster its lean."
    },
    {
      "slug": "htr",
      "term": "Htr",
      "definition": "Half treble. UK abbreviation. One yarn-over before inserting the hook, then all three loops pulled through at once."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through stitches with the tapestry needle."
    }
  ],
