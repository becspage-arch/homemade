    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Each snowflake works from a central ring outward through six "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "spoke-arm"
                }
              }
            ],
            "text": "arms"
          },
          {
            "type": "text",
            "text": ". Each arm ends with a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "picot-snow"
                }
              }
            ],
            "text": "picot"
          },
          {
            "type": "text",
            "text": " tip and has two side branches. Starch lightly to hold the shape."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nine snowflakes thread onto a 2 m cord with regular spacing. Fingering yarn gives delicate, airy motifs. Total yarn around 80 m."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
