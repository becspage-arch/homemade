        "attrs": {
          "heading": "Materials",
          "items": [
            {
              "name": "DK cotton yarn",
              "qty": "310 g"
            },
            {
              "name": "4 mm crochet hook",
              "qty": "1"
            },
            {
              "name": "Tapestry needle",
              "qty": "1"
            },
            {
              "name": "Scissors",
              "qty": "1 pair"
            }
          ]
        }
      },
      {
        "type": "heading",
