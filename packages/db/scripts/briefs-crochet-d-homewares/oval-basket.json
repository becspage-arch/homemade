      "slug": "oval-base",
      "term": "Oval base",
      "definition": "A foundation chain with stitches worked along both long edges and curved increases at each short end. The curve adds 4-6 stitches at each end over several rounds to build a flat oval."
    },
    {
      "slug": "dc-spiral-oval",
      "term": "Spiral rounds",
      "definition": "Continuous rounds worked without a joining slip stitch. Use a stitch marker on the first stitch of each round."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through stitches with the tapestry needle."
    }
