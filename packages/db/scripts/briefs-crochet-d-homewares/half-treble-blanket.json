    {
      "slug": "half-treble",
      "term": "Half treble",
      "definition": "A crochet stitch one step taller than a double crochet and one step shorter than a treble. UK: htr; US: hdc (half double crochet). One yarn-over before inserting the hook, then all three loops pulled through at once."
    },
    {
      "slug": "turning-chain",
      "term": "Turning chain",
      "definition": "Two chains at the start of each half treble row to match the stitch height."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through nearby stitches with the tapestry needle."
    }
  ],
