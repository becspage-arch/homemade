  "glossaryTerms": [
    {
      "slug": "fpdc",
      "term": "FPdc",
      "definition": "Front post double crochet. Insert hook from front to back to front around the post of the stitch below. The stitch raises to the front."
    },
    {
      "slug": "bpdc",
      "term": "BPdc",
      "definition": "Back post double crochet. Insert hook from back to front to back around the post below. The stitch pushes to the back, creating a recessed channel."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
