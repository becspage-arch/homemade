            ],
            "text": "7 tr in 5th st"
          },
          {
            "type": "text",
            "text": ", * skip 4, "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "anchor-dc-fan"
                }
              }
            ],
            "text": "dc"
          },
          {
            "type": "text",
            "text": ", skip 4, 7 tr in next st; rep. Row 3: ch 1, dc, * 7 tr in anchor dc of prev row, dc in centre tr of fan; rep. Alternate rows 2 and 3 until 30 cm."
          }
        ]
      },
