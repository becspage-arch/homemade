            "text": "Chain 129 (128 stitches = 64 cross pairs)."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Row 1"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "turning-chain"
                }
              }
            ],
            "text": "Turning chain"
          },
          {
            "type": "text",
            "text": " of ch 3. *Skip 1, tr into next, tr into skipped (cross pair made)*. Repeat to last stitch. Tr into last stitch. Turn. (64 cross pairs.)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Row 2 and onward"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Ch 3. *Work cross pair across every 2 stitches*. Tr into top of turning chain. Turn."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Repeat Row 2 until piece measures 100 cm. Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
