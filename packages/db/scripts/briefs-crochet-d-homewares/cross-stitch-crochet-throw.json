        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Work one round of dc (UK) around the perimeter. Secure tails with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "weaving-in-ends"
                }
              }
            ],
            "text": "weaving in ends"
          },
          {
            "type": "text",
            "text": ". Steam block to settle the cross pairs."
