  "glossaryTerms": [
    {
      "slug": "fphtr",
      "term": "FPhtr",
      "definition": "Front post half treble. Yarn over, insert hook from front to back to front around the post of the stitch below. Complete the htr. The stitch raises to the front."
    },
    {
      "slug": "bphtr",
      "term": "BPhtr",
      "definition": "Back post half treble. Yarn over, insert hook from back to front to back around the post below. The stitch pushes to the back, forming a recessed rib."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through stitches with the tapestry needle."
    }
  ],
