                }
              }
            ],
            "text": "Turning chain"
          },
          {
            "type": "text",
            "text": " of ch 1. Work 1 dc into every stitch across. Turn. Repeat for 60 rows (approximately 30 cm). Fasten off."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Finishing"
