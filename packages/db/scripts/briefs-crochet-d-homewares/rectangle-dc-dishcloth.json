        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Secure both tails with "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "weaving-in-ends"
                }
              }
            ],
            "text": "weaving in ends"
          },
          {
            "type": "text",
            "text": ". No edging needed unless the edges look uneven."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
