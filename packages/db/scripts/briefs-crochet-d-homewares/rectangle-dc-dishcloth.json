        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A rectangle dc dishcloth is 20 x 30 cm in plain "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "dc-rect"
                }
              }
            ],
            "text": "double crochet"
          },
          {
            "type": "text",
            "text": ". The longer shape covers more surface area when wiping down kitchen counters or stovetops. DK cotton on a 4 mm hook."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Total yarn needed is around 40 m. Two cloths fit in one 50 g ball of DK cotton."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            {
              "name": "DK cotton yarn",
              "qty": "40 m (about 32 g)"
            },
            {
              "name": "4 mm crochet hook",
              "qty": "1"
            },
            {
              "name": "Tapestry needle",
              "qty": "1"
            },
            {
              "name": "Scissors",
              "qty": "1 pair"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Foundation chain"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 33 (32 dc)."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Rows 1 to 60"
          }
