  "body": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The cable panel alternates "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fptr-cushion"
                }
              }
            ],
            "text": "front post trebles"
          },
          {
            "type": "text",
            "text": " on right-side rows and "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bptr-cushion"
                }
              }
            ],
            "text": "back post trebles"
          },
          {
            "type": "text",
            "text": " on wrong-side rows across a 16-stitch cable section, flanked by 12 dc stitches on each side. This creates five vertical ridges that look like knit cables."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Aran weight on a 5 mm hook gives the cables good definition. Total yarn around 480 m for both panels."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            {
              "name": "Aran yarn",
              "qty": "480 m"
            },
            {
              "name": "5 mm crochet hook",
              "qty": "1"
            },
            {
              "name": "Tapestry needle",
              "qty": "1"
            },
            {
              "name": "Scissors",
              "qty": "1 pair"
            },
            {
              "name": "40 cm cushion pad",
              "qty": "1"
            }
          ]
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Front panel"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 65. Establish pattern: 12 dc, 16 sts cable section (alternating fptr and bptr per row), 12 dc. Continue until panel measures 40 cm."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "RS rows: work "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "fptr-cushion"
                }
              }
            ],
            "text": "fptr"
          },
          {
            "type": "text",
            "text": " across cable sts. WS rows: work "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "bptr-cushion"
                }
              }
            ],
            "text": "bptr"
          },
          {
            "type": "text",
            "text": " across cable sts. Dc sections work plain on every row."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Back panel"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Chain 65. Work plain dc rows until 40 cm."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Assembly"
          }
