        "content": [
          {
            "type": "text",
            "text": "A picnic storage basket is 30 x 20 cm and 15 cm tall. The "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "oval-base3"
                }
              }
            ],
            "text": "oval base"
          },
          {
            "type": "text",
            "text": " starts from a 10 cm foundation chain and expands over 5 rounds. A "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "glossaryTooltip",
                "attrs": {
                  "termSlug": "blo-picnic"
                }
              }
            ],
            "text": "BLO fold round"
          },
          {
            "type": "text",
            "text": " marks the base edge, then the sides work straight up for 15 cm."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Super-chunky rope on a 10 mm hook. Total yardage is around 160 m."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "What you need"
          }
        ]
      },
      {
        "type": "suppliesCard",
        "attrs": {
          "heading": "Materials",
          "items": [
            {
              "name": "Super-chunky cotton rope",
              "qty": "160 m"
            },
            {
              "name": "10 mm crochet hook",
              "qty": "1"
