  "glossaryTerms": [
    {
      "slug": "star-st",
      "term": "Star stitch",
      "definition": "Pull up 5 loops: from the previous eye, the next 3 stitches, and one chain ahead. Draw yarn through all 5 loops plus ch 1 (the new eye). The five gathered loops form a star shape."
    },
    {
      "slug": "star-eye",
      "term": "Star eye",
      "definition": "The chain stitch at the centre of each completed star, used as the starting point for the next star's first loop."
    },
    {
      "slug": "weaving-in-ends",
      "term": "Weaving in ends",
      "definition": "Threading yarn tails through stitches with the tapestry needle."
    }
  ],
