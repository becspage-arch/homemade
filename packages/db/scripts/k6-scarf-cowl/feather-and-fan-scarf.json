  "glossaryTerms": [
    {
      "slug": "feather-and-fan",
      "term": "Feather and fan",
      "definition": "A traditional Shetland lace stitch worked in a four-row repeat. The pattern row groups three double decreases (K2tog) at the start of each repeat, six yarn-overs in the middle, and three SSK decreases at the end, producing a scalloped wave that fans out and draws in alternately across the row. Also called Old Shale or Wave stitch."
    },
    {
      "slug": "yarn-over",
      "term": "Yarn over (YO)",
      "definition": "Wrapping the yarn over the needle before the next stitch to create a new stitch and a small eyelet hole."
    },
    {
      "slug": "k2tog",
      "term": "K2tog",
      "definition": "Knit two stitches together as one. A right-leaning decrease."
    },
    {
      "slug": "ssk",
      "term": "SSK",
      "definition": "Slip, slip, knit. A left-leaning decrease made by slipping two stitches knitwise then knitting them together through the back loops."
    },
    {
      "slug": "blocking",
      "term": "Blocking",
      "definition": "Wetting and pinning the finished lace piece to open the pattern and set the dimensions."
    }
  ],
