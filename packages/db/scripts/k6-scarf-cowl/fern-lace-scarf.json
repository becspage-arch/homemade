  "glossaryTerms": [
    {
      "slug": "yarn-over",
      "term": "Yarn over (YO)",
      "definition": "Wrapping the yarn over the needle before the next stitch to create a new stitch and a small hole."
    },
    {
      "slug": "k2tog",
      "term": "K2tog",
      "definition": "Knit two stitches together as one. A right-leaning decrease."
    },
    {
      "slug": "ssk",
      "term": "SSK",
      "definition": "Slip, slip, knit. A left-leaning decrease. Slip two stitches knitwise, one at a time, then knit them together through the back loops."
    },
    {
      "slug": "blocking",
      "term": "Blocking",
      "definition": "Wetting and pinning the finished lace to open the pattern and set the dimensions."
    }
  ],
