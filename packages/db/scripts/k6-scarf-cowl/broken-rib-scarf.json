  "glossaryTerms": [
    {
      "slug": "broken-rib-lace",
      "term": "Broken rib lace",
      "definition": "A knitting stitch pattern that alternates two rows of 1x1 rib with an eyelet row (YO, K2tog repeat) and a purl row. The rib columns appear to be interrupted by horizontal rows of small holes."
    },
    {
      "slug": "yarn-over",
      "term": "Yarn over (YO)",
      "definition": "Wrapping the yarn over the needle before the next stitch to create a new stitch and a small hole."
    },
    {
      "slug": "k2tog",
      "term": "K2tog",
      "definition": "Knit two stitches together as one, a right-leaning decrease."
    },
    {
      "slug": "blocking",
      "term": "Blocking",
      "definition": "Wetting and pinning the finished lace to open the eyelets and set the dimensions."
    }
  ],
