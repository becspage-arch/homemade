  "glossaryTerms": [
    {
      "slug": "basketweave-stitch",
      "term": "Basketweave stitch",
      "definition": "A knitting stitch pattern that uses alternating blocks of knit and purl squares to produce a fabric that resembles woven basketwork. Worked in a repeat of six stitches and six (or twelve) rows, shifting the block positions halfway through."
    },
    {
      "slug": "long-tail-cast-on",
      "term": "Long-tail cast-on",
      "definition": "A cast-on method using the tail and working yarn together to form an elastic, neat edge."
    }
  ],
  "techniqueSlugs": [
    "long-tail-cast-on",
