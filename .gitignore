# Local Claude scratch / user-local settings
.claude/extracted/
.claude/scratch/
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/tmp/

# Intermediate checkpoint files written by one-off fixup scripts in
# packages/db/scripts. Canonical records live in the database (AuditLog
# rows) — these JSONs are recovery state if a long script is interrupted
# mid-run, not committed artefacts.
docs/hero-fill-progress.json
docs/tricolon-fixup-progress.json

# qc-fix pre-fix body snapshots — written by the qc-fix-batch cron each
# fire. Recovery state only; recoverable from Tutorial.revisedFrom in the
# DB. Daily directories pile up and would bloat the repo.
docs/qc-fixes-*/

# Caches
.cache/
.eslintcache
*.tsbuildinfo

# Capacitor mobile wrapper — native build artefacts
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/local.properties
apps/mobile/android/.idea/
apps/mobile/android/captures/
apps/mobile/ios/App/build/
apps/mobile/ios/App/Pods/
apps/mobile/ios/App/App.xcworkspace/xcuserdata/
apps/mobile/ios/.build/
apps/mobile/ios/DerivedData/
apps/mobile/ios/App/App/public/
apps/mobile/android/app/src/main/assets/public/

# Generated App Store / Play Store marketing screenshots. Re-runnable via
# `pnpm screenshots` against the live site.
apps/mobile/marketing/screenshots/

# S-8b autonomous AI product-shot worker — intermediate PNG dumps before commit to R2.
apps/web/scripts/s8b-out/
apps/web/scripts/s8b-test-output/

# S-8a sewing hero-flat spike output. Re-runnable via:
#   pnpm --filter @homemade/web exec tsx scripts/s8a-spike.ts
apps/web/scripts/s8a-spike-output/

# S-8c Flux garment-flat worker output. Re-runnable via the worker loop
# (scripts/_s8c-test-generate.ts + judging + _s8c-upload-passes.ts).
apps/web/scripts/s8c-test-output/

# Hero pipeline local image outputs (not committed)
packages/db/scripts/cal-out/
packages/db/scripts/hero-out/

# per-row rebuild scratch (qc rebuild sessions)
packages/db/docs/rebuild-work/

# Loom render engine scratch output (proof PNGs, scene JSON, heroes)
.loom-scratch/
