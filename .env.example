# Splash page guard — set to anything not-empty in production
SPLASH_PASSWORD=

# Neon (Postgres)
DATABASE_URL=
# Direct (non-pooled) connection for Prisma migrations.
# Same database as DATABASE_URL but using the host WITHOUT the -pooler suffix.
# e.g. ep-xxx.eu-west-2.aws.neon.tech instead of ep-xxx-pooler.eu-west-2.aws.neon.tech
DIRECT_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AWS (used by GitHub Actions, not by the running app)
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Cloudflare (used by infra scripts, not by the running app)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
